+++ src/chrome/browser/ui/views/omnibox/arcium_command_bar_material.cc
@@ -0,0 +1,119 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license found in the LICENSE file.
+
+#include "chrome/browser/ui/views/omnibox/arcium_command_bar_material.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "build/build_config.h"
+#include "chrome/browser/ui/helium/arcium_appearance_prefs.h"
+#include "components/prefs/pref_service.h"
+#include "ui/views/widget/widget.h"
+
+namespace arcium {
+
+std::unique_ptr<CommandBarNativeBackground> CreateCommandBarNativeBackground(
+    views::Widget*,
+    base::RepeatingClosure) {
+  return nullptr;
+}
+
+CommandBarMaterial::CommandBarMaterial(
+    views::Widget* widget,
+    PrefService* prefs,
+    base::RepeatingCallback<Clip()> clip_provider,
+    base::RepeatingCallback<void(bool)> paint_changed,
+    std::unique_ptr<CommandBarNativeBackground> native_background)
+    : widget_(widget),
+      prefs_(prefs),
+      clip_provider_(std::move(clip_provider)),
+      paint_changed_(std::move(paint_changed)),
+      native_background_(std::move(native_background)) {
+  widget_->AddObserver(this);
+  if (!native_background_) {
+    native_background_ = CreateCommandBarNativeBackground(
+        widget_, base::BindRepeating(&CommandBarMaterial::Refresh,
+                                     weak_factory_.GetWeakPtr()));
+  }
+  if (prefs_) {
+    pref_registrar_.Init(prefs_);
+    for (const char* name :
+         {kCommandBarAppearancePref, helium::kArciumChromeAppearancePref}) {
+      if (prefs_->FindPreference(name)) {
+        pref_registrar_.Add(name,
+                            base::BindRepeating(&CommandBarMaterial::Refresh,
+                                                weak_factory_.GetWeakPtr()));
+      }
+    }
+  }
+}
+
+CommandBarMaterial::~CommandBarMaterial() {
+  weak_factory_.InvalidateWeakPtrs();
+  pref_registrar_.Reset();
+  if (widget_) {
+    widget_->RemoveObserver(this);
+  }
+  widget_ = nullptr;
+  native_background_.reset();
+}
+
+void CommandBarMaterial::Refresh() {
+  if (!widget_) {
+    return;
+  }
+  const bool requested = prefs_ &&
+                         prefs_->FindPreference(kCommandBarAppearancePref) &&
+                         prefs_->GetInteger(kCommandBarAppearancePref) ==
+                             kCommandBarAppearanceGlass;
+  helium::GlassSurfaceConfiguration configuration =
+      helium::DefaultGlassSurfaceConfiguration();
+  if (prefs_ && prefs_->FindPreference(helium::kArciumChromeAppearancePref)) {
+    configuration = helium::ReadGlassSurfaceConfiguration(prefs_);
+  }
+  if (requested) {
+    // The command bar enables its own surface using the saved window style.
+    // Keep the profile's window effects setting unchanged.
+    configuration.enabled = true;
+  }
+
+  const Clip clip = clip_provider_.Run();
+  if (native_background_) {
+    native_background_->SetContour(clip.contour);
+  }
+  gfx::Rect bounds(widget_->GetWindowBoundsInScreen().size());
+  bounds.Inset(clip.insets);
+  const bool native_material =
+      native_background_ &&
+      native_background_->Update(requested, configuration, bounds,
+                                 clip.corner_radii);
+  if (!has_painted_ || uses_native_material_ != native_material) {
+    has_painted_ = true;
+    uses_native_material_ = native_material;
+    paint_changed_.Run(uses_native_material_);
+  }
+}
+
+void CommandBarMaterial::OnWidgetBoundsChanged(views::Widget* widget,
+                                               const gfx::Rect& new_bounds) {
+  Refresh();
+}
+
+void CommandBarMaterial::OnWidgetThemeChanged(views::Widget* widget) {
+  has_painted_ = false;
+  Refresh();
+}
+
+void CommandBarMaterial::OnWidgetDestroying(views::Widget* widget) {
+  weak_factory_.InvalidateWeakPtrs();
+  pref_registrar_.Reset();
+  widget_->RemoveObserver(this);
+  widget_ = nullptr;
+  prefs_ = nullptr;
+  uses_native_material_ = false;
+  native_background_.reset();
+}
+
+}  // namespace arcium
