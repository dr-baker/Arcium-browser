+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_OMNIBOX_ARCIUM_COMMAND_BAR_MATERIAL_H_
+#define CHROME_BROWSER_UI_VIEWS_OMNIBOX_ARCIUM_COMMAND_BAR_MATERIAL_H_
+
+#include <memory>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/views/helium/glass_surface_configuration.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "third_party/skia/include/core/SkPath.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/rounded_corners_f.h"
+#include "ui/views/widget/widget_observer.h"
+
+class PrefService;
+
+namespace views {
+class Widget;
+}
+
+namespace arcium {
+
+// A widget-owned native background. The platform implementation uses the
+// browser's glass resolver and factory; unsupported platforms return null.
+class CommandBarNativeBackground {
+ public:
+  virtual ~CommandBarNativeBackground() = default;
+  virtual void SetContour(const SkPath& contour) {}
+  virtual bool Update(bool requested,
+                      const helium::GlassSurfaceConfiguration& configuration,
+                      const gfx::Rect& bounds,
+                      const gfx::RoundedCornersF& corner_radii) = 0;
+};
+
+std::unique_ptr<CommandBarNativeBackground> CreateCommandBarNativeBackground(
+    views::Widget* widget,
+    base::RepeatingClosure appearance_changed);
+
+// Search and results use the same observer and material implementation, with
+// their own widget-local clipping. Changes affect paint without rebuilding
+// the input or results, so focus, query and selection survive live edits.
+class CommandBarMaterial : public views::WidgetObserver {
+ public:
+  struct Clip {
+    gfx::Insets insets;
+    gfx::RoundedCornersF corner_radii;
+    // Empty preserves the rounded-rectangle policy for existing consumers.
+    SkPath contour;
+  };
+
+  CommandBarMaterial(
+      views::Widget* widget,
+      PrefService* prefs,
+      base::RepeatingCallback<Clip()> clip_provider,
+      base::RepeatingCallback<void(bool)> paint_changed,
+      std::unique_ptr<CommandBarNativeBackground> native_background = nullptr);
+  CommandBarMaterial(const CommandBarMaterial&) = delete;
+  CommandBarMaterial& operator=(const CommandBarMaterial&) = delete;
+  ~CommandBarMaterial() override;
+
+  // Clips are read from the actual Views painting geometry. The results
+  // clip excludes the location-bar cutout, avoiding a second native blur.
+  void Refresh();
+  // True when the shared native profile decoration is installed. A configured
+  // solid material can also need transparent Views for its color and grain.
+  bool uses_native_material() const { return uses_native_material_; }
+
+  // views::WidgetObserver:
+  void OnWidgetBoundsChanged(views::Widget* widget,
+                             const gfx::Rect& new_bounds) override;
+  void OnWidgetThemeChanged(views::Widget* widget) override;
+  void OnWidgetDestroying(views::Widget* widget) override;
+
+ private:
+  raw_ptr<views::Widget> widget_;
+  raw_ptr<PrefService> prefs_;
+  base::RepeatingCallback<Clip()> clip_provider_;
+  base::RepeatingCallback<void(bool)> paint_changed_;
+  PrefChangeRegistrar pref_registrar_;
+  std::unique_ptr<CommandBarNativeBackground> native_background_;
+  bool has_painted_ = false;
+  bool uses_native_material_ = false;
+  base::WeakPtrFactory<CommandBarMaterial> weak_factory_{this};
+};
+
+}  // namespace arcium
+
+#endif  // CHROME_BROWSER_UI_VIEWS_OMNIBOX_ARCIUM_COMMAND_BAR_MATERIAL_H_
