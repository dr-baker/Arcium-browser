@@ -0,0 +1,256 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license found in the LICENSE file.
+
+#include "chrome/browser/ui/views/omnibox/arcium_command_bar_material.h"
+
+#include "base/functional/bind.h"
+#include "chrome/browser/ui/helium/arcium_appearance_prefs.h"
+#include "chrome/browser/ui/views/helium/glass_surface.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/gfx/range/range.h"
+#include "ui/views/controls/textfield/textfield.h"
+#include "ui/views/test/views_test_base.h"
+#include "ui/views/widget/widget.h"
+
+namespace arcium {
+namespace {
+
+class TestNativeBackground : public CommandBarNativeBackground {
+ public:
+  explicit TestNativeBackground(bool* destroyed) : destroyed_(destroyed) {}
+  ~TestNativeBackground() override { *destroyed_ = true; }
+
+  bool Update(bool requested,
+              const helium::GlassSurfaceConfiguration& configuration,
+              const gfx::Rect& bounds,
+              const gfx::RoundedCornersF& corner_radii) override {
+    ++updates;
+    last_requested = requested;
+    last_configuration = configuration;
+    last_bounds = bounds;
+    last_corner_radii = corner_radii;
+    return requested && available;
+  }
+
+  bool available = true;
+  bool last_requested = false;
+  int updates = 0;
+  helium::GlassSurfaceConfiguration last_configuration;
+  gfx::Rect last_bounds;
+  gfx::RoundedCornersF last_corner_radii;
+
+ private:
+  raw_ptr<bool> destroyed_;
+};
+
+class CommandBarMaterialTest : public views::ViewsTestBase {
+ public:
+  void SetUp() override {
+    views::ViewsTestBase::SetUp();
+    prefs_.registry()->RegisterIntegerPref(kCommandBarAppearancePref,
+                                           kCommandBarAppearanceSolid);
+    prefs_.registry()->RegisterDictionaryPref(
+        helium::kArciumChromeAppearancePref,
+        helium::SerializeGlassSurfaceConfiguration(
+            helium::DefaultGlassSurfaceConfiguration()));
+  }
+
+  std::unique_ptr<views::Widget> CreateWidget() {
+    auto widget = std::make_unique<views::Widget>();
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_POPUP);
+    params.context = GetContext();
+    params.bounds = gfx::Rect(0, 0, 400, 300);
+    widget->Init(std::move(params));
+    return widget;
+  }
+
+ protected:
+  TestingPrefServiceSimple prefs_;
+};
+
+TEST_F(CommandBarMaterialTest, DefaultAndUnknownChoicesKeepAnOpaquePanel) {
+  auto widget = CreateWidget();
+  bool destroyed = false;
+  auto background = std::make_unique<TestNativeBackground>(&destroyed);
+  auto* native = background.get();
+  bool paints_native = true;
+  CommandBarMaterial material(
+      widget.get(), &prefs_,
+      base::BindRepeating([] { return CommandBarMaterial::Clip{}; }),
+      base::BindRepeating([](bool* painted, bool value) { *painted = value; },
+                          &paints_native),
+      std::move(background));
+  material.Refresh();
+  EXPECT_FALSE(paints_native);
+  EXPECT_FALSE(native->last_requested);
+
+  for (int invalid : {-1, 2, 99}) {
+    prefs_.SetInteger(kCommandBarAppearancePref, invalid);
+    EXPECT_FALSE(material.uses_native_material());
+    EXPECT_FALSE(native->last_requested);
+  }
+}
+
+TEST_F(CommandBarMaterialTest, LiveChangesPreserveFocusQueryAndSelection) {
+  auto widget = CreateWidget();
+  auto* input = widget->SetContentsView(std::make_unique<views::Textfield>());
+  input->SetText(u"saved project");
+  widget->Show();
+  input->RequestFocus();
+  input->SetSelectedRange(gfx::Range(2, 8));
+  const gfx::Rect original_bounds = widget->GetWindowBoundsInScreen();
+  const gfx::Range original_selection = input->GetSelectedRange();
+
+  bool destroyed = false;
+  auto background = std::make_unique<TestNativeBackground>(&destroyed);
+  auto* native = background.get();
+  CommandBarMaterial material(
+      widget.get(), &prefs_,
+      base::BindRepeating([] { return CommandBarMaterial::Clip{}; }),
+      base::BindRepeating([](bool) {}), std::move(background));
+  material.Refresh();
+  prefs_.SetInteger(kCommandBarAppearancePref, kCommandBarAppearanceGlass);
+  EXPECT_TRUE(material.uses_native_material());
+  {
+    ScopedDictPrefUpdate update(&prefs_, helium::kArciumChromeAppearancePref);
+    update->Set(helium::kGlassAppearanceGrainKey, 0.03);
+    update->Set(helium::kGlassAppearanceMaterialOpacityKey, 0.7);
+  }
+  EXPECT_DOUBLE_EQ(native->last_configuration.grain, 0.03);
+  EXPECT_DOUBLE_EQ(native->last_configuration.material_opacity, 0.7);
+  prefs_.SetInteger(kCommandBarAppearancePref, kCommandBarAppearanceSolid);
+  EXPECT_FALSE(material.uses_native_material());
+
+  EXPECT_EQ(input->GetText(), u"saved project");
+  EXPECT_TRUE(input->HasFocus());
+  EXPECT_EQ(input->GetSelectedRange(), original_selection);
+  EXPECT_EQ(widget->GetWindowBoundsInScreen(), original_bounds);
+}
+
+TEST_F(CommandBarMaterialTest, GlassUsesSavedStyleWithWindowEffectsDisabled) {
+  auto saved_configuration = helium::DefaultGlassSurfaceConfiguration();
+  saved_configuration.enabled = false;
+  saved_configuration.material = helium::GlassSurfaceMaterial::kFrosted;
+  saved_configuration.frosted_style = helium::GlassSurfaceFrostedStyle::kMenu;
+  saved_configuration.material_opacity = 0.72;
+  saved_configuration.grain = 0.03;
+  prefs_.SetDict(helium::kArciumChromeAppearancePref,
+                 helium::SerializeGlassSurfaceConfiguration(
+                     saved_configuration));
+  saved_configuration = helium::ReadGlassSurfaceConfiguration(&prefs_);
+  const auto saved_pref =
+      prefs_.GetDict(helium::kArciumChromeAppearancePref).Clone();
+
+  auto widget = CreateWidget();
+  bool destroyed = false;
+  auto background = std::make_unique<TestNativeBackground>(&destroyed);
+  auto* native = background.get();
+  CommandBarMaterial material(
+      widget.get(), &prefs_,
+      base::BindRepeating([] { return CommandBarMaterial::Clip{}; }),
+      base::BindRepeating([](bool) {}), std::move(background));
+  material.Refresh();
+  EXPECT_FALSE(native->last_configuration.enabled);
+  prefs_.SetInteger(kCommandBarAppearancePref, kCommandBarAppearanceGlass);
+
+  auto local_configuration = saved_configuration;
+  local_configuration.enabled = true;
+  EXPECT_EQ(native->last_configuration, local_configuration);
+  EXPECT_TRUE(material.uses_native_material());
+  const auto resolution = helium::ResolveGlassSurfaceConfiguration(
+      native->last_configuration, helium::GlassBackend::kAuto,
+      /*native_liquid_glass=*/false, /*native_frosted=*/true,
+      /*reduce_transparency=*/false);
+  EXPECT_EQ(resolution.active, helium::GlassSurfaceMaterial::kFrosted);
+  EXPECT_TRUE(resolution.paints_chrome_transparent);
+  const auto reduced_transparency = helium::ResolveGlassSurfaceConfiguration(
+      native->last_configuration, helium::GlassBackend::kAuto,
+      /*native_liquid_glass=*/false, /*native_frosted=*/true,
+      /*reduce_transparency=*/true);
+  EXPECT_FALSE(reduced_transparency.paints_chrome_transparent);
+  const auto opaque_override = helium::ResolveGlassSurfaceConfiguration(
+      native->last_configuration, helium::GlassBackend::kOpaque,
+      /*native_liquid_glass=*/false, /*native_frosted=*/true,
+      /*reduce_transparency=*/false);
+  EXPECT_FALSE(opaque_override.paints_chrome_transparent);
+  EXPECT_EQ(prefs_.GetDict(helium::kArciumChromeAppearancePref), saved_pref);
+  EXPECT_EQ(helium::ReadGlassSurfaceConfiguration(&prefs_), saved_configuration);
+
+  prefs_.SetInteger(kCommandBarAppearancePref, kCommandBarAppearanceSolid);
+  EXPECT_FALSE(material.uses_native_material());
+  EXPECT_FALSE(native->last_configuration.enabled);
+  EXPECT_EQ(prefs_.GetDict(helium::kArciumChromeAppearancePref), saved_pref);
+  EXPECT_EQ(helium::ReadGlassSurfaceConfiguration(&prefs_), saved_configuration);
+}
+
+TEST_F(CommandBarMaterialTest, UnavailableNativeMaterialPreservesSavedChoice) {
+  auto widget = CreateWidget();
+  bool destroyed = false;
+  auto background = std::make_unique<TestNativeBackground>(&destroyed);
+  auto* native = background.get();
+  native->available = false;
+  CommandBarMaterial material(
+      widget.get(), &prefs_,
+      base::BindRepeating([] { return CommandBarMaterial::Clip{}; }),
+      base::BindRepeating([](bool) {}), std::move(background));
+  prefs_.SetInteger(kCommandBarAppearancePref, kCommandBarAppearanceGlass);
+  EXPECT_FALSE(material.uses_native_material());
+  EXPECT_EQ(prefs_.GetInteger(kCommandBarAppearancePref),
+            kCommandBarAppearanceGlass);
+  native->available = true;
+  material.Refresh();
+  EXPECT_TRUE(material.uses_native_material());
+}
+
+TEST_F(CommandBarMaterialTest, ClipTracksResultCutoutBoundsAndPaintRadius) {
+  auto widget = CreateWidget();
+  bool destroyed = false;
+  auto background = std::make_unique<TestNativeBackground>(&destroyed);
+  auto* native = background.get();
+  float paint_radius = 12.0f;
+  CommandBarMaterial material(
+      widget.get(), &prefs_,
+      base::BindRepeating(
+          [](float* radius) {
+            return CommandBarMaterial::Clip{
+                gfx::Insets::TLBR(45, 6, 6, 6),
+                gfx::RoundedCornersF(0, 0, *radius, *radius)};
+          },
+          &paint_radius),
+      base::BindRepeating([](bool) {}), std::move(background));
+  prefs_.SetInteger(kCommandBarAppearancePref, kCommandBarAppearanceGlass);
+  EXPECT_EQ(native->last_bounds, gfx::Rect(6, 45, 388, 249));
+  paint_radius = 9.6f;
+  widget->SetBounds(gfx::Rect(0, 0, 300, 220));
+  EXPECT_EQ(native->last_bounds, gfx::Rect(6, 45, 288, 169));
+  EXPECT_EQ(native->last_corner_radii,
+            gfx::RoundedCornersF(0, 0, paint_radius, paint_radius));
+}
+
+TEST_F(CommandBarMaterialTest, WidgetTeardownDetachesNativeAndPrefObservers) {
+  auto widget = CreateWidget();
+  bool destroyed = false;
+  int paints = 0;
+  CommandBarMaterial material(
+      widget.get(), &prefs_,
+      base::BindRepeating([] { return CommandBarMaterial::Clip{}; }),
+      base::BindRepeating([](int* paints, bool) { ++*paints; }, &paints),
+      std::make_unique<TestNativeBackground>(&destroyed));
+  material.Refresh();
+  widget->CloseNow();
+  EXPECT_TRUE(destroyed);
+  EXPECT_FALSE(material.uses_native_material());
+  const int paints_before = paints;
+  prefs_.SetInteger(kCommandBarAppearancePref, kCommandBarAppearanceGlass);
+  material.Refresh();
+  EXPECT_EQ(paints, paints_before);
+}
+
