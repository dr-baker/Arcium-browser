+bool HeliumSpaceService::MovePin(Browser* browser,
+                                 std::string_view id,
+                                 std::string_view parent_id,
+                                 std::string_view before_id) {
+  const std::string source_space_id(GetSpaceIdForBrowser(browser));
+  return MovePinInSpace(browser, source_space_id, id, parent_id, before_id);
+}
+
+bool HeliumSpaceService::ToggleFolderCollapsed(Browser* browser,
+                                               PersistentRecordKind kind,
+                                               std::string_view folder_id) {
+  if (!IsEligibleBrowser(browser)) {
+    return false;
+  }
+  if (kind == PersistentRecordKind::kFavorite) {
+    if (PersistentFolder* folder =
+            PersistentItemCodec::FindFolder(local_favorites_, folder_id)) {
+      folder->collapsed = !folder->collapsed;
+      profile_->GetPrefs()->SetList(
+          kHeliumFavoritesPref, PersistentItemCodec::Encode(local_favorites_));
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&HeliumSpaceService::NotifyItemsChanged,
+                                    weak_factory_.GetWeakPtr(),
+                                    PersistentItemChange::Favorites()));
+      return true;
+    }
+
+    HeliumSpace* space = GetSpaceById(GetSpaceIdForBrowser(browser));
+    if (!space || space->source_profile().empty()) {
+      return false;
+    }
+    ScopedDictPrefUpdate favorites_update(profile_->GetPrefs(),
+                                          kHeliumArcFavoritesByProfilePref);
+    base::ListValue* encoded =
+        favorites_update->FindList(space->source_profile());
+    auto favorites =
+        encoded ? PersistentItemCodec::Decode(*encoded, false) : std::nullopt;
+    PersistentFolder* folder =
+        favorites ? PersistentItemCodec::FindFolder(*favorites, folder_id)
+                  : nullptr;
+    if (!folder) {
+      return false;
+    }
+    folder->collapsed = !folder->collapsed;
+    favorites_update->Set(space->source_profile(),
+                          PersistentItemCodec::Encode(*favorites));
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&HeliumSpaceService::NotifyItemsChanged,
+                                  weak_factory_.GetWeakPtr(),
+                                  PersistentItemChange::Global()));
+    return true;
+  }
+
+  HeliumSpace* space = GetSpaceById(GetSpaceIdForBrowser(browser));
+  if (!space || !space->ToggleFolderCollapsed(folder_id)) {
+    return false;
+  }
+  // The notification rebuilds the virtual row tree. Defer it until the
+  // pressed row's input callback unwinds so the view cannot be destroyed and
+  // replaced underneath the same mouse event.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&HeliumSpaceService::NotifyItemsChanged,
+                                weak_factory_.GetWeakPtr(),
+                                PersistentItemChange::Space(space->id())));
+  return true;
+}
+
+bool HeliumSpaceService::TogglePinFolderCollapsedInSpace(
+    Browser* context_browser,
+    std::string_view source_space_id,
+    std::string_view folder_id) {
+  if (!IsEligibleBrowser(context_browser) || source_space_id.empty()) {
+    return false;
+  }
+  const std::string space_id(source_space_id);
+  const base::WeakPtr<HeliumSpaceService> service = weak_factory_.GetWeakPtr();
+  HeliumSpace* space = GetSpaceById(space_id);
+  if (!space || !space->ToggleFolderCollapsed(folder_id)) {
+    return false;
+  }
+  if (service) {
+    service->NotifyItemsChanged(PersistentItemChange::Space(space_id));
+  }
+  return true;
+}
+
+bool HeliumSpaceService::ReplacePersistentItemHome(tabs::TabInterface* tab) {
+  if (!tab || !tab->GetContents()) {
+    return false;
+  }
+  const GURL url = tab->GetContents()->GetLastCommittedURL();
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  std::u16string title = tab->GetContents()->GetTitle();
+  if (title.empty()) {
+    title = base::UTF8ToUTF16(url.host());
+  }
+  LiveAssociation* association = FindLiveAssociation(tab);
+  if (!association) {
+    return false;
+  }
+  BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+  Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  bool updated = false;
+  if (association->kind == PersistentRecordKind::kFavorite) {
+    updated = MutateFavoriteHome(browser, association->item_id, url, title);
+  } else if (HeliumSpace* space = GetSpaceById(GetSpaceIdForBrowser(browser))) {
+    updated = space->UpdatePinHome(association->item_id, url, title);
+  }
+  if (!updated) {
+    return false;
+  }
+  SeedAnchoredHome(
+      tab,
+      PersistentLink{.id = association->item_id, .title = title, .url = url});
+  NotifyItemsChanged(ChangeForItem(browser, association->kind));
+  return true;
+}
+
+bool HeliumSpaceService::RemovePersistentItem(tabs::TabInterface* tab) {
+  LiveAssociation* association = FindLiveAssociation(tab);
+  if (!association) {
+    return false;
+  }
+  BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+  Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  return RemovePersistentItem(browser, association->kind, association->item_id);
+}
+
+bool HeliumSpaceService::RemovePersistentItem(Browser* browser,
+                                              PersistentRecordKind kind,
+                                              std::string_view id) {
+  if (kind == PersistentRecordKind::kPin) {
+    return RemovePersistentItemInSpace(browser, GetSpaceIdForBrowser(browser),
+                                       id);
+  }
+  std::optional<PersistentLink> item = ResolveItem(browser, kind, id);
+  if (!item) {
+    return false;
+  }
+  const std::string key = ItemKey(browser, kind, id);
+  tabs::TabInterface* live_tab = GetLiveTabForPersistentItem(browser, kind, id);
+  if (live_tab && (live_tab->IsSplit() || live_tab->GetGroup())) {
+    return false;
+  }
+  bool removed = false;
+  if (kind == PersistentRecordKind::kFavorite) {
+    removed = RemoveFavoriteRecord(browser, id);
+  } else if (HeliumSpace* space = GetSpaceById(GetSpaceIdForBrowser(browser))) {
+    removed = space->RemovePin(id);
+  }
+  if (!removed) {
+    return false;
+  }
+  DisassociateLiveTab(live_tab);
+  lifecycle_.Forget(key);
+  RegisterDormantItems();
+  PersistentItemChange change = ChangeForItem(browser, kind);
+  // Defer the view rebuild. Dormant Remove runs from a menu owned by the
+  // tile being deleted; destroying that view inside ExecuteCommand is unsafe.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&HeliumSpaceService::NotifyItemsChanged,
+                                weak_factory_.GetWeakPtr(), std::move(change)));
+  return true;
+}
+
+bool HeliumSpaceService::RemovePersistentItemInSpace(
+    Browser* context_browser,
+    std::string_view source_space_id,
+    std::string_view id) {
+  if (!IsEligibleBrowser(context_browser) || source_space_id.empty() ||
+      id.empty()) {
+    return false;
+  }
+  const std::string space_id(source_space_id);
+  const std::string item_id(id);
+  HeliumSpace* space = GetSpaceById(space_id);
+  if (!space || !ResolvePinInSpace(space_id, item_id) ||
+      !CanRelocatePinNodeInSpace(space_id, item_id)) {
+    return false;
+  }
+  const std::string key =
+      ItemKeyForSpace(PersistentRecordKind::kPin, space_id, item_id);
+  const auto state = lifecycle_.GetState(key);
+  if (state && (*state == PersistentItemLifecycle::State::kMaterializing ||
+                *state == PersistentItemLifecycle::State::kClosing)) {
+    return false;
+  }
+  const auto token = lifecycle_.GetLiveTab(key);
+  std::optional<tabs::TabHandle> live_tab_handle;
+  if (token) {
+    const auto association = live_associations_.find(*token);
+    if (live_pin_space_transfers_.contains(*token) ||
+        association == live_associations_.end() ||
+        association->second->key != key ||
+        association->second->space_id != space_id ||
+        !association->second->tab) {
+      return false;
+    }
+    tabs::TabInterface* live_tab = association->second->tab;
+    BrowserWindowInterface* window = live_tab->GetBrowserWindowInterface();
+    Browser* owner = window ? window->GetBrowserForMigrationOnly() : nullptr;
+    if (!IsEligibleBrowser(owner) ||
+        GetExplicitSpaceIdForBrowser(owner) != space_id ||
+        !IsLiveTabInExpectedCollection(PersistentRecordKind::kPin, live_tab)) {
+      return false;
+    }
+    live_tab_handle = live_tab->GetHandle();
+  }
+  const base::WeakPtr<HeliumSpaceService> service = weak_factory_.GetWeakPtr();
+  if (!space->RemovePin(item_id)) {
+    return false;
+  }
+  if (!service) {
+    return true;
+  }
+  service->DisassociateLiveTab(live_tab_handle ? live_tab_handle->Get()
+                                               : nullptr);
+  if (!service) {
+    return true;
+  }
+  service->lifecycle_.Forget(key);
+  service->RegisterDormantItems();
+  if (!service) {
+    return true;
+  }
+  // Menus can own the row being removed. Publish after their callbacks unwind.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&HeliumSpaceService::NotifyItemsChanged, service,
+                     PersistentItemChange::Space(space_id)));
+  return true;
+}
+
+void HeliumSpaceService::PersistLocalFavorites() {
+  profile_->GetPrefs()->SetList(kHeliumFavoritesPref,
+                                PersistentItemCodec::Encode(local_favorites_));
+}
+
+bool HeliumSpaceService::MutateFavoriteHome(Browser* browser,
+                                            std::string_view id,
+                                            GURL url,
+                                            std::u16string title) {
+  if (PersistentItemCodec::UpdateLinkHome(local_favorites_, id, url, title)) {
+    PersistLocalFavorites();
+    return true;
+  }
+  HeliumSpace* space = GetSpaceById(GetSpaceIdForBrowser(browser));
+  if (!space || space->source_profile().empty()) {
+    return false;
+  }
+  ScopedDictPrefUpdate favorites_update(profile_->GetPrefs(),
+                                        kHeliumArcFavoritesByProfilePref);
+  base::ListValue* encoded =
+      favorites_update->FindList(space->source_profile());
+  auto favorites =
+      encoded ? PersistentItemCodec::Decode(*encoded, false) : std::nullopt;
+  if (!favorites || !PersistentItemCodec::UpdateLinkHome(
+                        *favorites, id, std::move(url), std::move(title))) {
+    return false;
+  }
+  favorites_update->Set(space->source_profile(),
+                        PersistentItemCodec::Encode(*favorites));
+  return true;
+}
+
+bool HeliumSpaceService::RemoveFavoriteRecord(Browser* browser,
+                                              std::string_view id) {
+  if (PersistentItemCodec::RemoveNode(local_favorites_, id)) {
+    PersistLocalFavorites();
+    return true;
+  }
+  HeliumSpace* space = GetSpaceById(GetSpaceIdForBrowser(browser));
+  if (!space || space->source_profile().empty()) {
+    return false;
+  }
+  ScopedDictPrefUpdate favorites_update(profile_->GetPrefs(),
+                                        kHeliumArcFavoritesByProfilePref);
+  base::ListValue* encoded =
+      favorites_update->FindList(space->source_profile());
+  auto favorites =
+      encoded ? PersistentItemCodec::Decode(*encoded, false) : std::nullopt;
+  if (!favorites || !PersistentItemCodec::RemoveNode(*favorites, id)) {
+    return false;
+  }
+  favorites_update->Set(space->source_profile(),
+                        PersistentItemCodec::Encode(*favorites));
+  return true;
+}
+
+void HeliumSpaceService::DisassociateLiveTab(tabs::TabInterface* tab) {
+  LiveAssociation* association = FindLiveAssociation(tab);
+  if (!association) {
+    return;
+  }
+  const uint64_t token = association->token;
+  const std::string key = association->key;
+  const tabs::TabHandle tab_handle = tab->GetHandle();
+  const base::WeakPtr<HeliumSpaceService> service = weak_factory_.GetWeakPtr();
+  if (TabUIHelper* helper = TabUIHelper::From(tab)) {
+    helper->ClearAnchoredPinnedTabHome();
+  }
+  if (!service) {
+    return;
+  }
+  tab = tab_handle.Get();
+  association = service->FindLiveAssociation(tab);
+  if (!tab || !association || association->token != token ||
+      association->key != key) {
+    // Deletion observers or a reentrant owner mutation completed this work.
+    return;
+  }
+  BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+  TabStripModel* model = window ? window->GetTabStripModel() : nullptr;
+  if (SessionService* sessions =
+          SessionServiceFactory::GetForProfile(service->profile_)) {
+    if (window) {
+      sessions->AddTabExtraData(
+          window->GetSessionID(),
+          sessions::SessionTabHelper::IdForTab(tab->GetContents()),
+          kHeliumPersistentItemTabExtraDataKey, std::string());
+    }
+  }
+  service->lifecycle_.BeginClose(token);
+  service->EraseLiveAssociation(token);
+  service->lifecycle_.CompleteClose(token);
+  if (!model) {
+    return;
+  }
+  if (tab->IsPinned()) {
+    const int index = model->GetIndexOfTab(tab);
+    if (index != TabStripModel::kNoTab) {
+      model->SetTabPinned(index, false);
+    }
+  } else if (const tabs::TabStripCollection* strip =
+                 model->Root() ? static_cast<const tabs::TabStripCollection*>(
+                                     model->Root())
+                               : nullptr;
+             strip && strip->IsPinTab(tab)) {
+    model->MoveTabFromPin(tab);
+  }
+}
+
+void HeliumSpaceService::LoadPersistentItemUsage() {
+  persistent_item_usage_.clear();
+  const base::DictValue& encoded =
+      profile_->GetPrefs()->GetDict(kHeliumPersistentItemUsagePref);
+  const base::Time now = base::Time::Now();
+  for (const auto [key, value] : encoded) {
+    if ((!key.starts_with("f:") && !key.starts_with("p:")) ||
+        key.size() <= 2u) {
+      continue;
+    }
+    const base::DictValue* entry = value.GetIfDict();
+    if (!entry) {
+      continue;
+    }
+    const int count = entry->FindInt(kUsageCountKey).value_or(0);
+    const std::string* encoded_timestamp = entry->FindString(kUsageLastUsedKey);
+    int64_t raw_timestamp = 0;
+    if (count <= 0 || !encoded_timestamp ||
+        !base::StringToInt64(*encoded_timestamp, &raw_timestamp) ||
+        raw_timestamp <= 0) {
+      continue;
+    }
+    base::Time last_used = base::Time::FromInternalValue(raw_timestamp);
+    if (last_used.is_null()) {
+      continue;
+    }
+    if (last_used > now) {
+      last_used = now;
+    }
+    persistent_item_usage_.emplace(
+        key, UsageEntry{.count = std::min(count, kMaxPersistentItemUseCount),
+                        .last_used = last_used});
+  }
+  PersistPersistentItemUsage();
+}
+
+void HeliumSpaceService::PersistPersistentItemUsage() {
+  base::DictValue encoded;
+  for (const auto& [key, entry] : persistent_item_usage_) {
+    base::DictValue value;
+    value.Set(kUsageCountKey,
+              std::min(entry.count, kMaxPersistentItemUseCount));
+    value.Set(kUsageLastUsedKey,
+              base::NumberToString(entry.last_used.ToInternalValue()));
+    encoded.Set(key, std::move(value));
+  }
+  profile_->GetPrefs()->SetDict(kHeliumPersistentItemUsagePref,
+                                std::move(encoded));
+}
+
+void HeliumSpaceService::PrunePersistentItemUsage(
+    const std::set<std::string>& durable_keys) {
+  bool changed = false;
+  for (auto it = persistent_item_usage_.begin();
+       it != persistent_item_usage_.end();) {
+    if (!durable_keys.contains(it->first) || it->second.count <= 0 ||
+        it->second.last_used.is_null()) {
+      it = persistent_item_usage_.erase(it);
+      changed = true;
+      continue;
+    }
+    const int capped_count =
+        std::min(it->second.count, kMaxPersistentItemUseCount);
+    if (capped_count != it->second.count) {
+      it->second.count = capped_count;
+      changed = true;
+    }
+    const base::Time now = base::Time::Now();
+    if (it->second.last_used > now) {
+      it->second.last_used = now;
+      changed = true;
+    }
+    ++it;
+  }
+
+  if (persistent_item_usage_.size() > kMaxPersistentItemUsageEntries) {
+    std::vector<std::string> keys;
+    keys.reserve(persistent_item_usage_.size());
+    for (const auto& [key, entry] : persistent_item_usage_) {
+      static_cast<void>(entry);
+      keys.push_back(key);
+    }
+    std::ranges::sort(
+        keys, [this](const std::string& lhs, const std::string& rhs) {
+          const base::Time lhs_time = persistent_item_usage_.at(lhs).last_used;
+          const base::Time rhs_time = persistent_item_usage_.at(rhs).last_used;
+          return lhs_time == rhs_time ? lhs < rhs : lhs_time > rhs_time;
+        });
+    for (size_t index = kMaxPersistentItemUsageEntries; index < keys.size();
+         ++index) {
+      persistent_item_usage_.erase(keys[index]);
+    }
+    changed = true;
+  }
+  if (changed) {
+    PersistPersistentItemUsage();
+  }
+}
+
+void HeliumSpaceService::RecordPersistentItemUsage(std::string_view key) {
+  if (key.empty()) {
+    return;
+  }
+  UsageEntry& entry = persistent_item_usage_[std::string(key)];
+  entry.count = entry.count >= kMaxPersistentItemUseCount
+                    ? kMaxPersistentItemUseCount
+                    : entry.count + 1;
+  entry.last_used = base::Time::Now();
+  PersistPersistentItemUsage();
+}
