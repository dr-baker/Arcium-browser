+TEST_F(HeliumSpaceServiceTest,
+       DeletedLivePinBecomesDormantAndCanMaterializeAgain) {
+  auto [id, pin_tab] = AddLivePin();
+  ASSERT_TRUE(pin_tab);
+  TabStripModel* model = browser()->tab_strip_model();
+  const int index = model->GetIndexOfTab(pin_tab);
+  ASSERT_NE(TabStripModel::kNoTab, index);
+  PersistentRemovalObserver observer(model, service_, pin_tab);
+
+  model->DetachAndDeleteWebContentsAt(index);
+
+  EXPECT_TRUE(observer.saw_removal());
+  EXPECT_TRUE(observer.association_was_cleared());
+  EXPECT_EQ(nullptr, service_->GetLiveTabForPersistentItem(
+                         browser(), PersistentRecordKind::kPin, id));
+
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(service_->IsPersistentItemLive(
+      browser(), PersistentRecordKind::kPin, id));
+  EXPECT_NE(nullptr, PersistentItemCodec::FindLink(space_->pins(), id));
+
+  ASSERT_TRUE(service_->ActivatePersistentItem(
+      browser(), PersistentRecordKind::kPin, id));
+  tabs::TabInterface* rematerialized =
+      service_->GetLiveTabForPersistentItem(
+          browser(), PersistentRecordKind::kPin, id);
+  ASSERT_TRUE(rematerialized);
+  EXPECT_EQ(id, service_->GetPersistentItemId(rematerialized));
+  EXPECT_TRUE(service_->IsPersistentItemLive(
+      browser(), PersistentRecordKind::kPin, id));
+}
+
+TEST_F(HeliumSpaceServiceTest,
+       LivePinReturningBeforeDeferredCloseRemainsAssociated) {
+  auto [id, pin_tab] = AddLivePin();
+  ASSERT_TRUE(pin_tab);
+  TabStripModel* model = browser()->tab_strip_model();
+  auto* strip = static_cast<tabs::TabStripCollection*>(
+      const_cast<tabs::TabCollection*>(model->Root()));
+  ASSERT_TRUE(strip->IsPinTab(pin_tab));
+
+  model->MoveTabFromPin(pin_tab);
+  ASSERT_FALSE(strip->IsPinTab(pin_tab));
+  model->MoveTabToPin(pin_tab);
+  ASSERT_TRUE(strip->IsPinTab(pin_tab));
+
+  base::RunLoop().RunUntilIdle();
+
+  EXPECT_EQ(pin_tab, service_->GetLiveTabForPersistentItem(
+                         browser(), PersistentRecordKind::kPin, id));
+  EXPECT_TRUE(service_->IsPersistentItemLive(
+      browser(), PersistentRecordKind::kPin, id));
+  EXPECT_EQ(id, service_->GetPersistentItemId(pin_tab));
+}
+
+TEST_F(HeliumSpaceServiceTest,
+       LivePinActivationChangeUsesAssociationSpace) {
+  auto [id, pin_tab] = AddLivePin();
+  ASSERT_TRUE(pin_tab);
+  HeliumSpace* other_space =
+      service_->GetOrCreateSpace("other-space", u"Other Space");
+  ASSERT_TRUE(other_space);
+  std::unique_ptr<Browser> other_browser =
+      CreateBrowser(profile(), Browser::TYPE_NORMAL, /*hosted_app=*/false);
+  ASSERT_TRUE(other_browser);
+  service_->SetSpaceForBrowser(other_browser.get(), other_space->id());
+  AddTab(other_browser.get(), GURL("https://other-space.test/"));
+
+  std::vector<PersistentItemChange> changes;
+  base::CallbackListSubscription subscription =
+      service_->RegisterItemsChanged(base::BindLambdaForTesting(
+          [&changes](const PersistentItemChange& change) {
+            changes.push_back(change);
+          }));
+
+  TabStripModel* source_model = browser()->tab_strip_model();
+  const int source_index = source_model->GetIndexOfTab(pin_tab);
+  ASSERT_NE(TabStripModel::kNoTab, source_index);
+  std::unique_ptr<tabs::TabModel> detached_pin =
+      source_model->DetachTabAtForInsertion(source_index);
+  TabStripModel* target_model = other_browser->tab_strip_model();
+  const int target_index = target_model->InsertDetachedTabAt(
+      target_model->count(), std::move(detached_pin), AddTabTypes::ADD_NONE);
+  target_model->ActivateTabAt(target_index);
+
+  base::RunLoop().RunUntilIdle();
+
+  bool saw_association_space = false;
+  for (const PersistentItemChange& change : changes) {
+    if (change.scope() != PersistentItemChangeScope::kSpace) {
+      continue;
+    }
+    saw_association_space |= change.space_id() == space_->id();
+    EXPECT_NE(other_space->id(), change.space_id());
+  }
+  EXPECT_TRUE(saw_association_space);
+}
