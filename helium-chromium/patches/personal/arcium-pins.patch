@@ -0,0 +1,160 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_SIDEBAR_DRAG_TRANSACTION_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_SIDEBAR_DRAG_TRANSACTION_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+
+namespace helium {
+
+// Strong, opaque identity tokens prevent a browser identity from being used as
+// a Space identity (and vice versa). Their values are owned by the controller.
+struct SidebarSpaceToken {
+  uint64_t value = 0;
+  bool operator==(const SidebarSpaceToken&) const = default;
+};
+
+struct SidebarBrowserToken {
+  uint64_t value = 0;
+  bool operator==(const SidebarBrowserToken&) const = default;
+};
+
+struct SidebarDragContext {
+  SidebarSpaceToken space;
+  SidebarBrowserToken browser;
+  bool operator==(const SidebarDragContext&) const = default;
+};
+
+enum class SidebarItemKind {
+  kTab,
+  kPin,
+  kFolder,
+};
+
+enum class SidebarSection {
+  kPins,
+  kTabs,
+};
+
+// A placement is expressed after logically removing the source item. An empty
+// parent_id identifies the section root. An empty before_id appends to the
+// parent.
+struct SidebarItemPlacement {
+  SidebarSection section = SidebarSection::kTabs;
+  std::string parent_id;
+  std::string before_id;
+  bool operator==(const SidebarItemPlacement&) const = default;
+};
+
+// This identity is stable for one pointer gesture. It intentionally contains
+// no view, TabInterface, or WebContents identity.
+struct SidebarDragSource {
+  std::string item_id;
+  SidebarItemKind kind = SidebarItemKind::kTab;
+  SidebarDragContext context;
+  SidebarItemPlacement placement;
+  bool operator==(const SidebarDragSource&) const = default;
+};
+
+struct SidebarDropIntent {
+  SidebarDragContext context;
+  SidebarItemPlacement placement;
+  bool operator==(const SidebarDropIntent&) const = default;
+};
+
+enum class SidebarDragAction {
+  kNone,
+  kReorder,
+  kReparent,
+  kPin,
+  kUnpin,
+};
+
+// The controller constructs this snapshot immediately before Commit(). The
+// transaction uses it only for validation and never mutates its source model.
+struct SidebarDragRevalidation {
+  // A missing source means it disappeared during the gesture.
+  std::optional<SidebarDragSource> source;
+
+  // The currently active destination identities. These must still match the
+  // preview intent and the source context.
+  SidebarDragContext target_context;
+
+  // Compatibility is supplied explicitly from the current projection. In
+  // particular, a folder cannot cross the section boundary unless the
+  // controller marks the target section as accepting it.
+  bool target_section_accepts_source = false;
+  bool target_parent_accepts_source = false;
+
+  // The root parent and append position need no ID lookup. These inputs apply
+  // when the corresponding destination IDs are non-empty.
+  bool target_parent_exists = true;
+  bool before_id_is_direct_child = false;
+
+  // Set after checking the current folder tree, rather than relying on the
+  // tree that existed when the drag began.
+  bool target_parent_is_source_or_descendant = false;
+};
+
+struct SidebarDragCommand {
+  SidebarDragAction action = SidebarDragAction::kNone;
+  SidebarDragSource source;
+  SidebarDropIntent target;
+  bool operator==(const SidebarDragCommand&) const = default;
+};
+
+enum class SidebarDragOutcome {
+  kCommitted,
+  kCancelled,
+  kNoOp,
+  kRejectedFinished,
+  kRejectedNoPreview,
+  kRejectedContextMismatch,
+  kRejectedSourceMissing,
+  kRejectedSourceChanged,
+  kRejectedInvalidTarget,
+  kRejectedFolderCycle,
+};
+
+struct SidebarDragResult {
+  SidebarDragOutcome outcome = SidebarDragOutcome::kRejectedNoPreview;
+  std::optional<SidebarDragCommand> command;
+  bool operator==(const SidebarDragResult&) const = default;
+};
+
+// Models one sidebar drag from its stable source through any number of preview
+// updates to exactly one terminal cancel, no-op, rejection, or semantic
+// command. Executing a command remains the controller's responsibility.
+class SidebarDragTransaction {
+ public:
+  explicit SidebarDragTransaction(SidebarDragSource source);
+  ~SidebarDragTransaction();
+
+  SidebarDragTransaction(const SidebarDragTransaction&) = delete;
+  SidebarDragTransaction& operator=(const SidebarDragTransaction&) = delete;
+
+  bool UpdatePreview(SidebarDropIntent intent);
+  bool is_active() const { return active_; }
+  bool has_preview() const { return preview_.has_value(); }
+  SidebarDragAction preview_action() const;
+
+  SidebarDragResult Cancel();
+  SidebarDragResult Commit(const SidebarDragRevalidation& revalidation);
+
+ private:
+  static SidebarDragAction ClassifyAction(const SidebarItemPlacement& source,
+                                          const SidebarItemPlacement& target);
+  SidebarDragResult Finish(SidebarDragOutcome outcome);
+
+  const SidebarDragSource source_;
+  std::optional<SidebarDropIntent> preview_;
+  bool active_ = true;
+};
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_SIDEBAR_DRAG_TRANSACTION_H_
