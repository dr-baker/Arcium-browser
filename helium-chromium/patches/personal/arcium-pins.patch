+
+SidebarNativeTabContext Context(int browser_session_id = 12,
+                                std::string space_id = "space-a") {
+  return {.browser_session_id = browser_session_id,
+          .space_id = std::move(space_id)};
+}
+
+SidebarNativeTabPinIntent Intent(
+    SidebarNativeTabContext context = Context(),
+    std::string parent_id = "folder",
+    std::string before_id = "next") {
+  return {.context = std::move(context),
+          .placement = {.section = SidebarSection::kPins,
+                        .parent_id = std::move(parent_id),
+                        .before_id = std::move(before_id)}};
+}
+
+TEST(SidebarNativeTabDragSessionTest, CommitsSameWindowSameSpacePinDrop) {
+  SidebarNativeTabDragSession session(Context(), true);
+  ASSERT_TRUE(session.UpdatePinIntent(Intent()));
+
+  const auto command = session.Complete(true, Context(), true);
+
+  ASSERT_TRUE(command);
+  EXPECT_EQ(command->source_context, Context());
+  EXPECT_EQ(command->placement, Intent().placement);
+}
+
+TEST(SidebarNativeTabDragSessionTest, ClearIntentMakesDropANoOp) {
+  SidebarNativeTabDragSession session(Context(), true);
+  ASSERT_TRUE(session.UpdatePinIntent(Intent()));
+  session.ClearIntent();
+
+  EXPECT_FALSE(session.Complete(true, Context(), true));
+}
+
+TEST(SidebarNativeTabDragSessionTest, RejectsDifferentBrowserOrSpace) {
+  SidebarNativeTabDragSession session(Context(), true);
+
+  EXPECT_FALSE(session.UpdatePinIntent(Intent(Context(13))));
+  EXPECT_FALSE(session.UpdatePinIntent(Intent(Context(12, "space-b"))));
+  EXPECT_FALSE(session.has_intent());
+}
+
+TEST(SidebarNativeTabDragSessionTest, DetachInvalidatesEntireSession) {
+  SidebarNativeTabDragSession session(Context(), true);
+  ASSERT_TRUE(session.UpdatePinIntent(Intent()));
+  session.Invalidate();
+
+  EXPECT_TRUE(session.invalidated());
+  EXPECT_FALSE(session.UpdatePinIntent(Intent()));
+  EXPECT_FALSE(session.Complete(true, Context(), true));
+}
+
+TEST(SidebarNativeTabDragSessionTest, RejectsFinalContextTransfer) {
+  SidebarNativeTabDragSession different_window(Context(), true);
+  ASSERT_TRUE(different_window.UpdatePinIntent(Intent()));
+  EXPECT_FALSE(different_window.Complete(true, Context(13), true));
+
+  SidebarNativeTabDragSession different_space(Context(), true);
+  ASSERT_TRUE(different_space.UpdatePinIntent(Intent()));
+  EXPECT_FALSE(
+      different_space.Complete(true, Context(12, "space-b"), true));
+}
+
+TEST(SidebarNativeTabDragSessionTest, RejectsCancelledAndIneligibleDrops) {
+  SidebarNativeTabDragSession cancelled(Context(), true);
+  ASSERT_TRUE(cancelled.UpdatePinIntent(Intent()));
+  EXPECT_FALSE(cancelled.Complete(false, Context(), true));
+
+  SidebarNativeTabDragSession multi(Context(), false);
+  EXPECT_FALSE(multi.UpdatePinIntent(Intent()));
+  EXPECT_FALSE(multi.Complete(true, Context(), true));
+
+  SidebarNativeTabDragSession changed(Context(), true);
+  ASSERT_TRUE(changed.UpdatePinIntent(Intent()));
+  EXPECT_FALSE(changed.Complete(true, Context(), false));
+}
+
+TEST(SidebarNativeTabDragSessionTest, CompletionIsTerminal) {
+  SidebarNativeTabDragSession session(Context(), true);
+  ASSERT_TRUE(session.UpdatePinIntent(Intent()));
+  ASSERT_TRUE(session.Complete(true, Context(), true));
+
+  EXPECT_FALSE(session.UpdatePinIntent(Intent()));
+  EXPECT_FALSE(session.Complete(true, Context(), true));
+}
+
+TEST(SidebarNativeTabDragSessionTest,
+     EligibleSessionDefersImmediateWholeWindowDrag) {
+  SidebarNativeTabDragSession eligible(Context(), true);
+  EXPECT_FALSE(ShouldStartWholeWindowDragImmediately(true, &eligible));
+
+  SidebarNativeTabDragSession ineligible(Context(), false);
+  EXPECT_TRUE(ShouldStartWholeWindowDragImmediately(true, &ineligible));
+  EXPECT_TRUE(ShouldStartWholeWindowDragImmediately(true, nullptr));
+  EXPECT_FALSE(ShouldStartWholeWindowDragImmediately(false, nullptr));
+}
+
+}  // namespace
+}  // namespace helium
