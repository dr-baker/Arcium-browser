+class PersistentFolderRow : public views::LabelButton {
+  METADATA_HEADER(PersistentFolderRow, views::LabelButton)
+
+ public:
+  using BeginDragCallback =
+      base::RepeatingCallback<bool(views::View&,
+                                   std::string,
+                                   const ui::MouseEvent&,
+                                   const ui::MouseEvent&)>;
+  using UpdateDragCallback =
+      base::RepeatingCallback<void(views::View&, const ui::MouseEvent&)>;
+  using CancelDragCallback = base::RepeatingCallback<void(views::View&)>;
+
+  PersistentFolderRow(views::Button::PressedCallback callback,
+                      std::u16string_view text,
+                      std::string stable_id,
+                      BeginDragCallback begin_drag,
+                      UpdateDragCallback update_drag,
+                      UpdateDragCallback end_drag,
+                      CancelDragCallback cancel_drag)
+      : LabelButton(std::move(callback), text),
+        stable_id_(std::move(stable_id)),
+        begin_drag_(std::move(begin_drag)),
+        update_drag_(std::move(update_drag)),
+        end_drag_(std::move(end_drag)),
+        cancel_drag_(std::move(cancel_drag)) {
+    // The vertical tab collection paints through a translucent compositor
+    // layer. Virtual rows have no opaque background of their own, so use
+    // grayscale antialiasing like other labels in translucent browser chrome.
+    label()->SetSkipSubpixelRenderingOpacityCheck(true);
+  }
+
+  void SetFolderState(std::u16string title, bool collapsed) {
+    title_ = std::move(title);
+    collapsed_ = collapsed;
+    SetTooltipText(title_);
+    SetImageModel(views::Button::STATE_NORMAL,
+                  ui::ImageModel::FromVectorIcon(
+                      collapsed_ ? vector_icons::kFolderFlippableIcon
+                                 : vector_icons::kFolderOpenIcon,
+                      ui::kColorIcon, kFolderIconSize));
+    GetViewAccessibility().SetName(title_);
+    if (collapsed_) {
+      GetViewAccessibility().SetIsCollapsed();
+    } else {
+      GetViewAccessibility().SetIsExpanded();
+    }
+  }
+
+  void UpdatePresentation(bool compact) {
+    SetText(compact ? std::u16string() : title_);
+    SetHorizontalAlignment(compact ? gfx::ALIGN_CENTER : gfx::ALIGN_LEFT);
+    SetImageLabelSpacing(8);
+  }
+
+  void SetDropTarget(bool drop_target) {
+    SetState(drop_target ? STATE_HOVERED : STATE_NORMAL);
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (event.IsOnlyLeftMouseButton()) {
+      drag_start_event_ = std::make_unique<ui::MouseEvent>(event);
+      dragging_ = false;
+    }
+    return views::LabelButton::OnMousePressed(event);
+  }
+
+  bool OnMouseDragged(const ui::MouseEvent& event) override {
+    if (drag_start_event_) {
+      if (!dragging_ && ExceededDragThreshold(event.location() -
+                                              drag_start_event_->location())) {
+        dragging_ =
+            begin_drag_.Run(*this, stable_id_, *drag_start_event_, event);
+      } else if (dragging_) {
+        update_drag_.Run(*this, event);
+      }
+    }
+    return dragging_ || views::LabelButton::OnMouseDragged(event);
+  }
+
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    if (dragging_) {
+      end_drag_.Run(*this, event);
+      dragging_ = false;
+      drag_start_event_.reset();
+      SetState(STATE_NORMAL);
+      return;
+    }
+    drag_start_event_.reset();
+    views::LabelButton::OnMouseReleased(event);
+  }
+
+  void OnMouseCaptureLost() override {
+    const bool was_dragging = dragging_;
+    dragging_ = false;
+    drag_start_event_.reset();
+    views::LabelButton::OnMouseCaptureLost();
+    if (was_dragging) {
+      cancel_drag_.Run(*this);
+    }
+  }
+
+ private:
+  const std::string stable_id_;
+  std::u16string title_;
+  bool collapsed_ = false;
+  BeginDragCallback begin_drag_;
+  UpdateDragCallback update_drag_;
+  UpdateDragCallback end_drag_;
+  CancelDragCallback cancel_drag_;
+  std::unique_ptr<ui::MouseEvent> drag_start_event_;
+  bool dragging_ = false;
+};
