+    space_service_->RemovePersistentItem(browser, kind, id);
+  }
+}
+
+void PinTabContainerView::FavoritePersistentItem(
+    helium::PersistentRecordKind kind,
+    std::string id,
+    std::string source_space_id) {
+  if (kind != helium::PersistentRecordKind::kPin || !collection_node_ ||
+      !collection_node_->GetController() || !space_service_) {
