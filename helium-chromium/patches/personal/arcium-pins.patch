+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_persistent_item_model.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+PersistentNode Link(std::string id, std::string url) {
+  return {.data = PersistentLink{
+              .id = std::move(id), .title = u"Link", .url = GURL(url)}};
+}
+
+PersistentNodes Tree() {
+  return {Link("top", "https://top.test/"),
+          {.data = PersistentFolder{
+               .id = "outer",
+               .title = u"Outer",
+               .collapsed = true,
+               .children = {Link("nested", "https://nested.test/"),
+                            {.data = PersistentFolder{.id = "empty",
+                                                      .title = u"Empty"}}}}}};
+}
+
+TEST(PersistentItemClosePolicyTest, DurableItemAlwaysClosesToDormant) {
+  EXPECT_EQ(PersistentItemCloseAction::kClose,
+            GetPersistentItemCloseAction(/*has_durable_record=*/true,
+                                         /*is_away_from_home=*/true));
+  EXPECT_EQ(PersistentItemCloseAction::kClose,
+            GetPersistentItemCloseAction(/*has_durable_record=*/true,
+                                         /*is_away_from_home=*/false));
+}
+
+TEST(PersistentItemClosePolicyTest, LegacyAnchorStaysLiveAtHome) {
+  EXPECT_EQ(PersistentItemCloseAction::kReturnHome,
+            GetPersistentItemCloseAction(/*has_durable_record=*/false,
+                                         /*is_away_from_home=*/true));
+  EXPECT_EQ(PersistentItemCloseAction::kKeepOpen,
+            GetPersistentItemCloseAction(/*has_durable_record=*/false,
+                                         /*is_away_from_home=*/false));
+}
+
+TEST(PersistentItemCodecTest, ExactRoundTripPreservesTreeStateAndOrder) {
+  PersistentNodes original = Tree();
+  auto decoded =
+      PersistentItemCodec::Decode(PersistentItemCodec::Encode(original), true);
+  ASSERT_TRUE(decoded);
+  EXPECT_EQ(original, *decoded);
+  const PersistentFolder* outer =
+      PersistentItemCodec::FindFolder(*decoded, "outer");
+  ASSERT_TRUE(outer);
+  EXPECT_TRUE(outer->collapsed);
+  EXPECT_EQ(2u, outer->children.size());
+  EXPECT_TRUE(PersistentItemCodec::FindFolder(*decoded, "empty"));
+}
+
+TEST(PersistentItemCodecTest, RejectsFoldersDuplicatesAndBlankHomes) {
+  EXPECT_FALSE(
+      PersistentItemCodec::Decode(PersistentItemCodec::Encode(Tree()), false));
+  PersistentNodes duplicates = {Link("same", "https://one.test/"),
+                                Link("same", "https://two.test/")};
+  EXPECT_FALSE(PersistentItemCodec::Decode(
+      PersistentItemCodec::Encode(duplicates), true));
+  EXPECT_FALSE(PersistentItemCodec::Decode(
+      PersistentItemCodec::Encode({Link("blank", "about:blank")}), false));
+}
+
+TEST(PersistentItemLifecycleTest, CloseReturnsLiveItemToDormantForReopen) {
+  PersistentItemLifecycle lifecycle;
+  ASSERT_TRUE(lifecycle.AddDormant("pin"));
+  EXPECT_EQ(PersistentItemLifecycle::ActivationAction::kMaterialize,
+            lifecycle.BeginActivation("pin").action);
+  ASSERT_TRUE(lifecycle.DidMaterialize("pin", 41));
+  EXPECT_EQ(41u, lifecycle.BeginActivation("pin").live_tab);
+  ASSERT_EQ(std::optional<std::string>("pin"), lifecycle.BeginClose(41));
+  EXPECT_EQ(PersistentItemLifecycle::State::kClosing,
+            lifecycle.GetState("pin"));
+  ASSERT_TRUE(lifecycle.CompleteClose(41));
+  EXPECT_EQ(PersistentItemLifecycle::State::kDormant,
+            lifecycle.GetState("pin"));
+  EXPECT_EQ(PersistentItemLifecycle::ActivationAction::kMaterialize,
+            lifecycle.BeginActivation("pin").action);
+}
+
+TEST(PersistentItemLifecycleTest, CancelledCloseReturnsToSameLiveInstance) {
+  PersistentItemLifecycle lifecycle;
+  ASSERT_TRUE(lifecycle.AddDormant("pin"));
+  ASSERT_EQ(PersistentItemLifecycle::ActivationAction::kMaterialize,
+            lifecycle.BeginActivation("pin").action);
+  ASSERT_TRUE(lifecycle.DidMaterialize("pin", 41));
+
+  ASSERT_EQ(std::optional<std::string>("pin"), lifecycle.BeginClose(41));
+  ASSERT_TRUE(lifecycle.CancelClose(41));
+  EXPECT_EQ(PersistentItemLifecycle::State::kLive, lifecycle.GetState("pin"));
+  EXPECT_EQ(std::optional<uint64_t>(41), lifecycle.GetLiveTab("pin"));
+  EXPECT_EQ(std::optional<std::string_view>("pin"),
+            lifecycle.GetItemForLiveTab(41));
+  EXPECT_EQ(PersistentItemLifecycle::ActivationAction::kActivateExisting,
+            lifecycle.BeginActivation("pin").action);
+
+  // A later confirmed close begins a fresh transition and can complete.
+  ASSERT_EQ(std::optional<std::string>("pin"), lifecycle.BeginClose(41));
+  ASSERT_TRUE(lifecycle.CompleteClose(41));
+  EXPECT_EQ(PersistentItemLifecycle::State::kDormant,
+            lifecycle.GetState("pin"));
+}
+
+TEST(PersistentItemLifecycleTest, CancelCloseRejectsOtherStatesAndTokens) {
+  PersistentItemLifecycle lifecycle;
+  ASSERT_TRUE(lifecycle.AddDormant("pin"));
+  EXPECT_FALSE(lifecycle.CancelClose(41));
+  lifecycle.BeginActivation("pin");
+  ASSERT_TRUE(lifecycle.DidMaterialize("pin", 41));
+  EXPECT_FALSE(lifecycle.CancelClose(41));
+  EXPECT_FALSE(lifecycle.CancelClose(99));
+  ASSERT_TRUE(lifecycle.BeginClose(41));
+  ASSERT_TRUE(lifecycle.CompleteClose(41));
+  EXPECT_FALSE(lifecycle.CancelClose(41));
+}
+
+TEST(PersistentItemLifecycleTest, RejectsDuplicateAndOutOfOrderTransitions) {
+  PersistentItemLifecycle lifecycle;
+  ASSERT_TRUE(lifecycle.AddDormant("first"));
+  ASSERT_TRUE(lifecycle.AddDormant("second"));
+  EXPECT_FALSE(lifecycle.DidMaterialize("first", 1));
+  lifecycle.BeginActivation("first");
+  ASSERT_TRUE(lifecycle.DidMaterialize("first", 1));
+  lifecycle.BeginActivation("second");
+  EXPECT_FALSE(lifecycle.DidMaterialize("second", 1));
+  EXPECT_EQ(PersistentItemLifecycle::ActivationAction::kWaitForTransition,
+            lifecycle.BeginActivation("second").action);
+}
+
+TEST(PersistentItemLifecycleTest, RestoredAssociationCanBeForgotten) {
+  PersistentItemLifecycle lifecycle;
+  ASSERT_TRUE(lifecycle.AddDormant("favorite"));
+  ASSERT_TRUE(lifecycle.RestoreLive("favorite", 9));
+  EXPECT_EQ(std::optional<std::string_view>("favorite"),
+            lifecycle.GetItemForLiveTab(9));
+  EXPECT_TRUE(lifecycle.Forget("favorite"));
+  EXPECT_FALSE(lifecycle.GetItemForLiveTab(9));
+}
+
+TEST(PersistentItemLifecycleTest, RekeyPreservesLiveAssociation) {
+  PersistentItemLifecycle lifecycle;
+  ASSERT_TRUE(lifecycle.AddDormant("pin"));
+  ASSERT_TRUE(lifecycle.RestoreLive("pin", 41));
+
+  EXPECT_TRUE(lifecycle.Rekey("pin", "favorite"));
+  EXPECT_FALSE(lifecycle.GetState("pin"));
+  EXPECT_EQ(PersistentItemLifecycle::State::kLive,
+            lifecycle.GetState("favorite"));
+  EXPECT_EQ(41u, lifecycle.GetLiveTab("favorite"));
+  EXPECT_EQ(std::optional<std::string_view>("favorite"),
+            lifecycle.GetItemForLiveTab(41));
+
+  ASSERT_TRUE(lifecycle.AddDormant("occupied"));
+  EXPECT_FALSE(lifecycle.Rekey("favorite", "occupied"));
+  EXPECT_EQ(PersistentItemLifecycle::State::kLive,
+            lifecycle.GetState("favorite"));
+  EXPECT_EQ(41u, lifecycle.GetLiveTab("favorite"));
+}
+
+TEST(PersistentItemLifecycleTest, ReconcileForgetsRemovedDurableItems) {
+  PersistentItemLifecycle lifecycle;
+  ASSERT_TRUE(lifecycle.AddDormant("kept"));
+  ASSERT_TRUE(lifecycle.AddDormant("removed"));
+  ASSERT_EQ(PersistentItemLifecycle::ActivationAction::kMaterialize,
+            lifecycle.BeginActivation("removed").action);
+  ASSERT_TRUE(lifecycle.DidMaterialize("removed", 7));
+
+  lifecycle.RetainOnly({"kept"});
+
+  EXPECT_EQ(PersistentItemLifecycle::State::kDormant,
+            lifecycle.GetState("kept"));
+  EXPECT_FALSE(lifecycle.GetState("removed"));
+  EXPECT_FALSE(lifecycle.GetItemForLiveTab(7));
+}
+
+TEST(PersistentItemCodecTest, UpdateAndRemovePreserveNestedOrder) {
+  PersistentNodes nodes = Tree();
+  ASSERT_TRUE(PersistentItemCodec::UpdateLinkHome(
+      nodes, "nested", GURL("https://updated.test/path"), u"Updated"));
+  const PersistentLink* nested = PersistentItemCodec::FindLink(nodes, "nested");
+  ASSERT_TRUE(nested);
+  EXPECT_EQ(GURL("https://updated.test/path"), nested->url);
+  EXPECT_EQ(u"Updated", nested->title);
+
+  ASSERT_TRUE(PersistentItemCodec::RemoveNode(nodes, "nested"));
+  EXPECT_FALSE(PersistentItemCodec::FindLink(nodes, "nested"));
+  const PersistentFolder* outer =
+      PersistentItemCodec::FindFolder(nodes, "outer");
+  ASSERT_TRUE(outer);
+  EXPECT_EQ(1u, outer->children.size());
+  EXPECT_TRUE(PersistentItemCodec::FindLink(nodes, "top"));
+}
+
+TEST(PersistentItemCodecTest, MoveNodeSupportsNestedFoldersAndTreePositions) {
+  PersistentNodes nodes = Tree();
+  nodes.push_back(Link("last", "https://last.test/"));
+
+  ASSERT_TRUE(PersistentItemCodec::MoveNode(nodes, "last", "empty", {}));
+  const PersistentFolder* empty =
+      PersistentItemCodec::FindFolder(nodes, "empty");
+  ASSERT_TRUE(empty);
+  ASSERT_EQ(1u, empty->children.size());
+  EXPECT_EQ("last", std::get<PersistentLink>(empty->children[0].data).id);
+
+  ASSERT_TRUE(PersistentItemCodec::MoveNode(nodes, "empty", {}, "outer"));
+  ASSERT_EQ(3u, nodes.size());
+  EXPECT_EQ("empty", std::get<PersistentFolder>(nodes[1].data).id);
+  EXPECT_EQ("outer", std::get<PersistentFolder>(nodes[2].data).id);
+  EXPECT_TRUE(PersistentItemCodec::FindLink(nodes, "last"));
+}
+
+TEST(PersistentItemCodecTest, MoveNodeMovesWholeFolderSubtrees) {
+  PersistentNodes nodes = Tree();
+  nodes.push_back(
+      {.data = PersistentFolder{.id = "destination", .title = u"Destination"}});
+
+  ASSERT_TRUE(PersistentItemCodec::MoveNode(nodes, "outer", "destination", {}));
+  const PersistentFolder* destination =
+      PersistentItemCodec::FindFolder(nodes, "destination");
+  ASSERT_TRUE(destination);
+  ASSERT_EQ(1u, destination->children.size());
+  EXPECT_EQ("outer",
+            std::get<PersistentFolder>(destination->children[0].data).id);
+  EXPECT_TRUE(PersistentItemCodec::FindLink(nodes, "nested"));
+  EXPECT_TRUE(PersistentItemCodec::FindFolder(nodes, "empty"));
+
+  ASSERT_TRUE(PersistentItemCodec::MoveNode(nodes, "empty", {}, "top"));
+  ASSERT_EQ(3u, nodes.size());
+  EXPECT_EQ("empty", std::get<PersistentFolder>(nodes.front().data).id);
+}
+
+TEST(PersistentItemCodecTest, MoveNodeRejectsCyclesAndForeignBeforeIds) {
+  PersistentNodes nodes = Tree();
+  const PersistentNodes original = nodes;
+
+  EXPECT_FALSE(PersistentItemCodec::MoveNode(nodes, "outer", "empty", {}));
+  EXPECT_FALSE(PersistentItemCodec::MoveNode(nodes, "outer", "outer", {}));
+  EXPECT_FALSE(PersistentItemCodec::MoveNode(nodes, "top", "outer", "top"));
+  EXPECT_FALSE(PersistentItemCodec::MoveNode(nodes, "top", {}, "nested"));
+  EXPECT_EQ(original, nodes);
+}
+
+TEST(PersistentLiveCollectionTest, FavoritesUsePinnedGridAndPinsUsePinList) {
+  EXPECT_EQ(PersistentLiveCollection::kPinnedGrid,
+            LiveCollectionForKind(PersistentRecordKind::kFavorite));
+  EXPECT_EQ(PersistentLiveCollection::kPinList,
+            LiveCollectionForKind(PersistentRecordKind::kPin));
+}
+
+TEST(AnchoredNavigationPolicyTest, OrdinaryCrossSiteLinksMayDivert) {
+  const GURL home("https://home.test/");
+  const GURL away("https://away.test/");
+  EXPECT_TRUE(ShouldUseOptionalNavigationForAnchoredItem(
+      PersistentNavigationDisposition::kCurrentTab, true, true, home, away));
+  EXPECT_FALSE(ShouldUseOptionalNavigationForAnchoredItem(
+      PersistentNavigationDisposition::kCurrentTab, true, true, home, home));
+  EXPECT_FALSE(ShouldUseOptionalNavigationForAnchoredItem(
+      PersistentNavigationDisposition::kCurrentTab, true, true, home,
+      GURL("https://home.test/#section")));
+  EXPECT_FALSE(ShouldUseOptionalNavigationForAnchoredItem(
+      PersistentNavigationDisposition::kCurrentTab, true, true, home,
+      GURL("https://docs.home.test/guide?step=2")));
+  EXPECT_TRUE(ShouldUseOptionalNavigationForAnchoredItem(
+      PersistentNavigationDisposition::kPageRequestedNewTarget, true, true,
+      home, away));
+  EXPECT_FALSE(ShouldUseOptionalNavigationForAnchoredItem(
+      PersistentNavigationDisposition::kExplicitNewTarget, true, true, home,
+      away));
+  EXPECT_FALSE(ShouldUseOptionalNavigationForAnchoredItem(
+      PersistentNavigationDisposition::kCurrentTab, false, true, home, away));
+  EXPECT_FALSE(ShouldUseOptionalNavigationForAnchoredItem(
+      PersistentNavigationDisposition::kCurrentTab, true, false, home, away));
+}
+
+TEST(PersistentGridPackingTest,
+     PacksDisplayedSlotsThenHiddenHomeTilesInModelOrder) {
+  const std::vector<PersistentGridSlot> dormant = {
+      {.id = "a"}, {.id = "b"}, {.id = "c"}};
+  EXPECT_EQ((std::vector<PersistentGridChild>{
+                {.id = "a", .kind = PersistentGridChildKind::kHomeTile},
+                {.id = "b", .kind = PersistentGridChildKind::kHomeTile},
+                {.id = "c", .kind = PersistentGridChildKind::kHomeTile}}),
+            PackPersistentGridChildren(dormant));
+
+  const std::vector<PersistentGridSlot> mixed = {{.id = "a", .live = true},
+                                                 {.id = "b"},
+                                                 {.id = "c", .live = true},
+                                                 {.id = "d"}};
+  EXPECT_EQ((std::vector<PersistentGridChild>{
+                {.id = "a", .kind = PersistentGridChildKind::kLiveTab},
+                {.id = "b", .kind = PersistentGridChildKind::kHomeTile},
+                {.id = "c", .kind = PersistentGridChildKind::kLiveTab},
+                {.id = "d", .kind = PersistentGridChildKind::kHomeTile},
+                {.id = "a", .kind = PersistentGridChildKind::kHomeTile},
+                {.id = "c", .kind = PersistentGridChildKind::kHomeTile}}),
+            PackPersistentGridChildren(mixed));
+
+  const std::vector<PersistentGridSlot> restored = {
+      {.id = "a"}, {.id = "b"}, {.id = "c"}, {.id = "d"}};
+  EXPECT_EQ((std::vector<PersistentGridChild>{
+                {.id = "a", .kind = PersistentGridChildKind::kHomeTile},
+                {.id = "b", .kind = PersistentGridChildKind::kHomeTile},
+                {.id = "c", .kind = PersistentGridChildKind::kHomeTile},
+                {.id = "d", .kind = PersistentGridChildKind::kHomeTile}}),
+            PackPersistentGridChildren(restored));
+}
+
+}  // namespace
+}  // namespace helium
