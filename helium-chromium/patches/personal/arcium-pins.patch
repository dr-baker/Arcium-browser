+class PersistentActivationObserver : public TabStripModelObserver {
+ public:
+  PersistentActivationObserver(TabStripModel* model,
+                               HeliumSpaceService* service)
+      : model_(model), service_(service) {
+    model_->AddObserver(this);
+  }
+
+  ~PersistentActivationObserver() override { model_->RemoveObserver(this); }
+
+  void OnTabStripModelChanged(
+      TabStripModel*,
+      const TabStripModelChange&,
+      const TabStripSelectionChange& selection) override {
+    if (!selection.active_tab_changed() || !selection.new_tab) {
+      return;
+    }
+    saw_activation_ = true;
+    was_persistent_at_activation_ =
+        service_->IsPersistentItemTab(selection.new_tab);
+  }
+
+  bool saw_activation() const { return saw_activation_; }
+  bool was_persistent_at_activation() const {
+    return was_persistent_at_activation_;
+  }
+
+ private:
+  raw_ptr<TabStripModel> model_;
+  raw_ptr<HeliumSpaceService> service_;
+  bool saw_activation_ = false;
+  bool was_persistent_at_activation_ = false;
+};
+
+class PersistentRemovalObserver : public TabStripModelObserver {
+ public:
+  PersistentRemovalObserver(TabStripModel* model,
+                            HeliumSpaceService* service,
+                            tabs::TabInterface* target)
+      : model_(model), service_(service), target_(target) {
+    model_->AddObserver(this);
+  }
+
+  ~PersistentRemovalObserver() override { model_->RemoveObserver(this); }
+
+  void OnTabStripModelChanged(
+      TabStripModel*,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange&) override {
+    if (change.type() != TabStripModelChange::kRemoved) {
+      return;
+    }
+    const TabStripModelChange::Remove* remove = change.GetRemove();
+    ASSERT_TRUE(remove);
+    for (const TabStripModelChange::RemovedTab& removed : remove->contents) {
+      if (removed.tab != target_) {
+        continue;
+      }
+      saw_removal_ = true;
+      association_was_cleared_ =
+          !service_->GetPersistentItemKind(removed.tab) &&
+          !service_->GetPersistentItemId(removed.tab);
+      target_ = nullptr;
+      return;
+    }
+  }
+
+  bool saw_removal() const { return saw_removal_; }
+  bool association_was_cleared() const { return association_was_cleared_; }
+
+ private:
+  raw_ptr<TabStripModel> model_;
+  raw_ptr<HeliumSpaceService> service_;
+  raw_ptr<tabs::TabInterface> target_;
+  bool saw_removal_ = false;
+  bool association_was_cleared_ = false;
+};
