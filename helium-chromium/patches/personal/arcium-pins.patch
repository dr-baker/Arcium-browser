+#ifndef COMPONENTS_TABS_PUBLIC_FOLDER_TAB_COLLECTION_H_
+#define COMPONENTS_TABS_PUBLIC_FOLDER_TAB_COLLECTION_H_
+
+#include <string>
+
+#include "components/tabs/public/tab_collection.h"
+
+namespace tabs {
+
+// Nested folder under a PinTabCollection (or another folder). Not a
+// Chromium tab group — folders exist only in the persistent section.
+class FolderTabCollection : public TabCollection {
+ public:
+  explicit FolderTabCollection(std::u16string title);
+  ~FolderTabCollection() override;
+  FolderTabCollection(const FolderTabCollection&) = delete;
+  FolderTabCollection& operator=(const FolderTabCollection&) = delete;
+
+  const std::u16string& title() const { return title_; }
+  void SetTitle(std::u16string title) { title_ = std::move(title); }
+
+  bool collapsed() const { return collapsed_; }
+  void SetCollapsed(bool collapsed) { collapsed_ = collapsed; }
+
+  void SetProvenance(std::string source,
+                     std::string collection_id,
+                     std::string item_id) {
+    provenance_source_ = std::move(source);
+    provenance_collection_id_ = std::move(collection_id);
+    provenance_item_id_ = std::move(item_id);
+  }
+  const std::string& provenance_source() const { return provenance_source_; }
+  const std::string& provenance_collection_id() const {
+    return provenance_collection_id_;
+  }
+  const std::string& provenance_item_id() const {
+    return provenance_item_id_;
+  }
+
+ private:
+  std::u16string title_;
+  bool collapsed_ = false;
+  std::string provenance_source_;
+  std::string provenance_collection_id_;
+  std::string provenance_item_id_;
+};
+
+}  // namespace tabs
+
+#endif  // COMPONENTS_TABS_PUBLIC_FOLDER_TAB_COLLECTION_H_
