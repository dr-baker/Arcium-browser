+ui::ImageModel MakeMonogramFavicon(const GURL& url) {
+  const float scale = ui::GetScaleForMaxSupportedResourceScaleFactor();
+  const int pixel_size = std::max(
+      kIconDesignWidth, static_cast<int>(std::ceil(kIconDesignWidth * scale)));
+  gfx::ImageSkia image = gfx::ImageSkia::CreateFromBitmap(
+      favicon::GenerateMonogramFavicon(url, pixel_size, pixel_size), scale);
+  image.EnsureRepsForSupportedScales();
+  return ui::ImageModel::FromImageSkia(image);
+}
