Index: src/chrome/browser/ui/helium/helium_favorites_and_pins.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/helium_favorites_and_pins.cc
@@ -0,0 +1,473 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_favorites_and_pins.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/feature_list.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "chrome/browser/ui/arcium/optional_navigation.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/helium/helium_space_service.h"
+#include "chrome/browser/ui/helium/helium_space_service_factory.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/tab_ui_helper.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "components/tabs/public/tab_collection.h"
+#include "components/tabs/public/tab_interface.h"
+#include "components/tabs/public/tab_strip_collection.h"
+#include "components/tabs/public/temporary_tab.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/common/referrer.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace helium {
+
+BASE_FEATURE(kHeliumFavoritesAndPins,
+             "HeliumFavoritesAndPins",
+             base::FEATURE_ENABLED_BY_DEFAULT);
+
+namespace {
+
+constexpr char kAnchorURLKey[] = "helium.favorites_and_pins.anchor_url";
+constexpr char kAnchorTitleKey[] = "helium.favorites_and_pins.anchor_title";
+
+HeliumSpaceService* GetSpaceService(const tabs::TabInterface* tab) {
+  return tab ? HeliumSpaceServiceFactory::GetForProfile(tab->GetProfile())
+             : nullptr;
+}
+
+bool IsHTTPOrHTTPS(const GURL& url) {
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS();
+}
+
+bool IsEligibleTabContext(const tabs::TabInterface* tab) {
+  const Profile* const profile = tab ? tab->GetProfile() : nullptr;
+  const BrowserWindowInterface* const browser =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  return profile && browser &&
+         !tabs::TemporaryTab::IsTemporary(tab->GetContents()) &&
+         browser->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+         !profile->IsOffTheRecord() && !profile->IsGuestSession();
+}
+
+// Persistent folders are allowed (they are not Chromium tab groups). Splits
+// remain ineligible for anchored favorite/pin membership.
+bool IsStandaloneTab(const tabs::TabInterface* tab) {
+  return tab && !tab->IsSplit() && !tab->GetGroup().has_value();
+}
+
+TabUIHelper* GetTabUIHelper(tabs::TabInterface* tab) {
+  return tab ? TabUIHelper::From(tab) : nullptr;
+}
+
+const TabUIHelper* GetTabUIHelper(const tabs::TabInterface* tab) {
+  return tab ? TabUIHelper::From(tab) : nullptr;
+}
+
+tabs::TabStripCollection* GetTabStripCollection(tabs::TabInterface* tab) {
+  BrowserWindowInterface* const browser =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  TabStripModel* const model = browser ? browser->GetTabStripModel() : nullptr;
+  if (!model || !model->Root()) {
+    return nullptr;
+  }
+  return static_cast<tabs::TabStripCollection*>(
+      const_cast<tabs::TabCollection*>(model->Root()));
+}
+
+const tabs::TabStripCollection* GetTabStripCollection(
+    const tabs::TabInterface* tab) {
+  return GetTabStripCollection(const_cast<tabs::TabInterface*>(tab));
+}
+
+bool HasHomeMetadata(const tabs::TabInterface* tab) {
+  const TabUIHelper* const helper = GetTabUIHelper(tab);
+  return helper && helper->HasAnchoredPinnedTabHome();
+}
+
+content::OpenURLParams OpenURLParamsFromNavigateParams(
+    const NavigateParams& params) {
+  content::OpenURLParams open_url_params(
+      params.url, params.referrer, params.disposition, params.transition,
+      params.is_renderer_initiated, params.started_from_context_menu);
+  open_url_params.initiator_frame_token = params.initiator_frame_token;
+  open_url_params.initiator_process_id = params.initiator_process_id;
+  open_url_params.initiator_origin = params.initiator_origin;
+  open_url_params.initiator_base_url = params.initiator_base_url;
+  open_url_params.initiator_navigation_state =
+      params.initiator_navigation_state;
+  open_url_params.source_site_instance = params.source_site_instance;
+  open_url_params.redirect_chain = params.redirect_chain;
+  open_url_params.post_data = params.post_data;
+  open_url_params.extra_headers = params.extra_headers;
+  open_url_params.frame_tree_node_id = params.frame_tree_node_id;
+  open_url_params.user_gesture = params.user_gesture;
+  open_url_params.started_by_ad = params.started_by_ad;
+  open_url_params.should_replace_current_entry =
+      params.should_replace_current_entry;
+  open_url_params.blob_url_loader_factory = params.blob_url_loader_factory;
+  open_url_params.is_service_worker_open_window =
+      params.is_service_worker_open_window;
+  open_url_params.href_translate = params.href_translate;
+  open_url_params.reload_type = params.reload_type;
+  open_url_params.impression = params.impression;
+  open_url_params.internal_scroll_to_text_fragment =
+      params.internal_scroll_to_text_fragment;
+  return open_url_params;
+}
+
+void PersistAnchoredPinnedTabExtraData(tabs::TabInterface* tab) {
+  if (!tab) {
+    return;
+  }
+
+  SessionService* const session_service =
+      SessionServiceFactory::GetForProfile(tab->GetProfile());
+  content::WebContents* const contents = tab->GetContents();
+  if (!session_service || !contents) {
+    return;
+  }
+
+  const SessionID window_id =
+      sessions::SessionTabHelper::IdForWindowContainingTab(contents);
+  const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+  if (!window_id.is_valid() || !tab_id.is_valid()) {
+    return;
+  }
+
+  const TabUIHelper* const helper = GetTabUIHelper(tab);
+  const bool has_home = helper && helper->HasAnchoredPinnedTabHome();
+  session_service->AddTabExtraData(
+      window_id, tab_id, kAnchorURLKey,
+      has_home ? helper->anchored_pinned_tab_home_url().spec() : std::string());
+  session_service->AddTabExtraData(
+      window_id, tab_id, kAnchorTitleKey,
+      has_home ? base::UTF16ToUTF8(helper->anchored_pinned_tab_home_title())
+               : std::string());
+}
+
+}  // namespace
+
+bool IsHeliumFavoritesAndPinsEnabled() {
+  return base::FeatureList::IsEnabled(kHeliumFavoritesAndPins);
+}
+
+bool IsPinTab(const tabs::TabInterface* tab) {
+  if (!IsHeliumFavoritesAndPinsEnabled() || !IsEligibleTabContext(tab)) {
+    return false;
+  }
+  const tabs::TabStripCollection* const strip = GetTabStripCollection(tab);
+  return strip && strip->IsPinTab(tab);
+}
+
+bool IsFavoriteTab(const tabs::TabInterface* tab) {
+  HeliumSpaceService* service = GetSpaceService(tab);
+  return service &&
+         service->GetPersistentItemKind(tab) == PersistentRecordKind::kFavorite;
+}
+
+bool IsPersistentItemTab(const tabs::TabInterface* tab) {
+  HeliumSpaceService* service = GetSpaceService(tab);
+  return service && service->IsPersistentItemTab(tab);
+}
+
+void SetPersistentItemTabDragInProgress(tabs::TabInterface* tab,
+                                        bool in_progress) {
+  if (HeliumSpaceService* service = GetSpaceService(tab)) {
+    service->SetPersistentItemDragInProgress(tab, in_progress);
+  }
+}
+
+bool IsAnchoredTab(const tabs::TabInterface* tab) {
+  if (!IsHeliumFavoritesAndPinsEnabled() || !IsEligibleTabContext(tab) ||
+      !IsStandaloneTab(tab)) {
+    return false;
+  }
+  if (IsPersistentItemTab(tab)) {
+    return true;
+  }
+  return HasHomeMetadata(tab) && (tab->IsPinned() || IsPinTab(tab));
+}
+
+bool IsAnchoredTabAwayFromHome(const tabs::TabInterface* tab) {
+  if (!IsAnchoredTab(tab)) {
+    return false;
+  }
+  const TabUIHelper* const helper = GetTabUIHelper(tab);
+  const GURL current_url = tab->GetContents()->GetLastCommittedURL();
+  return current_url.is_valid() &&
+         current_url.GetWithoutRef() !=
+             helper->anchored_pinned_tab_home_url().GetWithoutRef();
+}
+
+bool IsAnchoredPinnedTab(const tabs::TabInterface* tab) {
+  return IsAnchoredTab(tab);
+}
+
+bool IsAnchoredPinnedTabAwayFromHome(const tabs::TabInterface* tab) {
+  return IsAnchoredTabAwayFromHome(tab);
+}
+
+bool CanMakePin(const tabs::TabInterface* tab) {
+  if (!IsHeliumFavoritesAndPinsEnabled() || !IsEligibleTabContext(tab) ||
+      !IsStandaloneTab(tab) || tab->IsPinned()) {
+    return false;
+  }
+  HeliumSpaceService* service = GetSpaceService(tab);
+  return (!service || !service->IsPersistentItemTab(tab)) &&
+         IsHTTPOrHTTPS(tab->GetContents()->GetLastCommittedURL());
+}
+
+bool CanMakeFavorite(const tabs::TabInterface* tab) {
+  if (!IsHeliumFavoritesAndPinsEnabled() || !IsEligibleTabContext(tab) ||
+      !IsStandaloneTab(tab)) {
+    return false;
+  }
+  HeliumSpaceService* service = GetSpaceService(tab);
+  const std::optional<PersistentRecordKind> kind =
+      service ? service->GetPersistentItemKind(tab) : std::nullopt;
+  return kind == PersistentRecordKind::kPin ||
+         (!kind && IsHTTPOrHTTPS(tab->GetContents()->GetLastCommittedURL()));
+}
+
+bool MakeFavorite(tabs::TabInterface* tab) {
+  if (!CanMakeFavorite(tab)) {
+    return false;
+  }
+  HeliumSpaceService* service = GetSpaceService(tab);
+  if (!service) {
+    return false;
+  }
+  if (service->GetPersistentItemKind(tab) == PersistentRecordKind::kPin) {
+    BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+    Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+    const std::optional<std::string> id = service->GetPersistentItemId(tab);
+    return browser && id &&
+           service->PromotePinToFavorite(
+               browser, service->GetSpaceIdForBrowser(browser), *id);
+  }
+  return service->AddFavoriteFromTab(tab);
+}
+
+bool MakePin(tabs::TabInterface* tab) {
+  if (!CanMakePin(tab)) {
+    return false;
+  }
+  HeliumSpaceService* service = GetSpaceService(tab);
+  return service && service->AddPinFromTab(tab);
+}
+
+bool CreatePinFolder(tabs::TabInterface* tab) {
+  HeliumSpaceService* service = GetSpaceService(tab);
+  return service && service->CreatePinFolderForTab(tab);
+}
+
+bool GetAnchoredPinnedTabHome(const tabs::TabInterface* tab,
+                              GURL* home_url,
+                              std::u16string* home_title) {
+  if (!home_url || !home_title || !IsAnchoredTab(tab)) {
+    return false;
+  }
+
+  const TabUIHelper* const helper = GetTabUIHelper(tab);
+  if (helper && helper->HasAnchoredPinnedTabHome()) {
+    *home_url = helper->anchored_pinned_tab_home_url();
+    *home_title = helper->anchored_pinned_tab_home_title();
+    return true;
+  }
+  HeliumSpaceService* service = GetSpaceService(tab);
+  return service && service->GetPersistentItemHome(tab, home_url, home_title);
+}
+
+void RestoreAnchoredPinnedTabHome(tabs::TabInterface* tab,
+                                  GURL home_url,
+                                  std::u16string home_title) {
+  TabUIHelper* const helper = GetTabUIHelper(tab);
+  const Profile* const profile = tab ? tab->GetProfile() : nullptr;
+  if (!helper || !IsHeliumFavoritesAndPinsEnabled() || !profile ||
+      profile->IsOffTheRecord() || profile->IsGuestSession() ||
+      !IsStandaloneTab(tab) || !IsHTTPOrHTTPS(home_url)) {
+    return;
+  }
+
+  if (home_title.empty()) {
+    home_title = base::UTF8ToUTF16(home_url.host());
+  }
+  helper->SetAnchoredPinnedTabHome(std::move(home_url), std::move(home_title));
+}
+
+void ResetAnchoredPinnedTab(tabs::TabInterface* tab) {
+  ReturnAnchoredPinnedTabHome(tab);
+}
+
+void ReturnAnchoredPinnedTabHome(tabs::TabInterface* tab) {
+  if (!IsAnchoredTab(tab)) {
+    return;
+  }
+
+  GURL home_url;
+  std::u16string home_title;
+  if (!GetAnchoredPinnedTabHome(tab, &home_url, &home_title)) {
+    return;
+  }
+  content::NavigationController::LoadURLParams params(home_url);
+  params.transition_type = ui::PAGE_TRANSITION_AUTO_BOOKMARK;
+  params.has_user_gesture = true;
+  params.should_replace_current_entry = true;
+  params.should_clear_history_list = true;
+  tab->GetContents()->GetController().LoadURLWithParams(params);
+}
+
+void ReplaceAnchoredPinnedTabHome(tabs::TabInterface* tab) {
+  if (!IsAnchoredTab(tab)) {
+    return;
+  }
+
+  const GURL current_url = tab->GetContents()->GetLastCommittedURL();
+  if (!IsHTTPOrHTTPS(current_url)) {
+    return;
+  }
+
+  if (HeliumSpaceService* service = GetSpaceService(tab);
+      service && service->ReplacePersistentItemHome(tab)) {
+    PersistAnchoredPinnedTabExtraData(tab);
+    return;
+  }
+
+  TabUIHelper* const helper = GetTabUIHelper(tab);
+  std::u16string title = helper->GetTitle();
+  if (title.empty()) {
+    title = base::UTF8ToUTF16(current_url.host());
+  }
+  helper->SetAnchoredPinnedTabHome(current_url, std::move(title));
+  PersistAnchoredPinnedTabExtraData(tab);
+}
+
+void RemoveAnchoredPinnedTab(tabs::TabInterface* tab) {
+  if (!tab) {
+    return;
+  }
+  if (HeliumSpaceService* service = GetSpaceService(tab);
+      service && service->RemovePersistentItem(tab)) {
+    return;
+  }
+  if (TabUIHelper* const helper = GetTabUIHelper(tab)) {
+    helper->ClearAnchoredPinnedTabHome();
+    PersistAnchoredPinnedTabExtraData(tab);
+  }
+  if (IsPinTab(tab)) {
+    if (tabs::TabStripCollection* const strip = GetTabStripCollection(tab)) {
+      strip->MoveTabFromPin(tab);
+    }
+  }
+}
+
+void AddAnchoredPinnedTabExtraData(
+    const tabs::TabInterface* tab,
+    std::map<std::string, std::string>* extra_data) {
+  if (!extra_data || !IsAnchoredTab(tab)) {
+    return;
+  }
+
+  const TabUIHelper* const helper = GetTabUIHelper(tab);
+  extra_data->insert_or_assign(kAnchorURLKey,
+                               helper->anchored_pinned_tab_home_url().spec());
+  extra_data->insert_or_assign(
+      kAnchorTitleKey,
+      base::UTF16ToUTF8(helper->anchored_pinned_tab_home_title()));
+}
+
+void RestoreAnchoredPinnedTabExtraData(
+    tabs::TabInterface* tab,
+    const std::map<std::string, std::string>& extra_data) {
+  TabUIHelper* const helper = GetTabUIHelper(tab);
+  if (helper) {
+    helper->ClearAnchoredPinnedTabHome();
+  }
+
+  // The normalized model and its stable session key own restoration. Never
+  // reconstruct legacy native/fake pinned tabs from anchored metadata.
+  if (IsHeliumFavoritesAndPinsEnabled()) {
+    return;
+  }
+
+  const Profile* const profile = tab ? tab->GetProfile() : nullptr;
+  if (!helper || !profile || profile->IsOffTheRecord() ||
+      profile->IsGuestSession() || !IsStandaloneTab(tab)) {
+    return;
+  }
+
+  const auto url_it = extra_data.find(kAnchorURLKey);
+  const auto title_it = extra_data.find(kAnchorTitleKey);
+  if (url_it == extra_data.end() || title_it == extra_data.end()) {
+    return;
+  }
+
+  const GURL home_url(url_it->second);
+  if (!IsHTTPOrHTTPS(home_url)) {
+    return;
+  }
+
+  RestoreAnchoredPinnedTabHome(tab, home_url,
+                               base::UTF8ToUTF16(title_it->second));
+
+  // Place restored anchored tabs that are not native pins into the pins
+  // section.
+  if (tab && !tab->IsPinned()) {
+    if (tabs::TabStripCollection* const strip = GetTabStripCollection(tab)) {
+      if (!strip->IsPinTab(tab)) {
+        strip->MoveTabToPin(tab);
+      }
+    }
+  }
+}
+
+bool MaybeConvertAnchoredFavoriteOrPinNavigation(NavigateParams* params) {
+  if (!params || !IsHeliumFavoritesAndPinsEnabled()) {
+    return false;
+  }
+  content::WebContents* source = params->source_contents;
+  tabs::TabInterface* tab =
+      source ? tabs::TabInterface::MaybeGetFromContents(source) : nullptr;
+  GURL home_url;
+  std::u16string home_title;
+  const bool is_link_transition = ui::PageTransitionCoreTypeIs(
+      params->transition, ui::PAGE_TRANSITION_LINK);
+  PersistentNavigationDisposition disposition =
+      PersistentNavigationDisposition::kExplicitNewTarget;
+  if (params->disposition == WindowOpenDisposition::CURRENT_TAB) {
+    disposition = PersistentNavigationDisposition::kCurrentTab;
+  } else if (params->disposition == WindowOpenDisposition::NEW_FOREGROUND_TAB &&
+             params->is_renderer_initiated && params->user_gesture &&
+             !params->started_from_context_menu) {
+    // Page-authored target=_blank links are ordinary clicks. Command-click,
+    // context-menu actions, and browser commands remain explicit overrides.
+    disposition = PersistentNavigationDisposition::kPageRequestedNewTarget;
+  }
+  if (!ShouldUseOptionalNavigationForAnchoredItem(
+          disposition, is_link_transition,
+          GetAnchoredPinnedTabHome(tab, &home_url, &home_title), home_url,
+          params->url)) {
+    return false;
+  }
+  Profile* profile = tab->GetProfile();
+  if (!arcium::MaybeHandleOptionalNavigation(
+          profile, OpenURLParamsFromNavigateParams(*params))) {
+    return false;
+  }
+  params->disposition = WindowOpenDisposition::IGNORE_ACTION;
+  return true;
+}
+
+}  // namespace helium
