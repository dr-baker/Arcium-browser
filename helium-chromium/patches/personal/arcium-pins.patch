+PersistentNode Pin(std::string id) {
+  return {.data = PersistentLink{.id = std::move(id),
+                                 .title = u"Pin",
+                                 .url = GURL("https://pin.test/")}};
+}
+
+PersistentNode Folder(std::string id,
+                      PersistentNodes children,
+                      bool collapsed = false) {
+  return {.data = PersistentFolder{.id = std::move(id),
+                                   .title = u"Folder",
+                                   .collapsed = collapsed,
+                                   .children = std::move(children)}};
+}
+
+PersistentNodes PinTree(bool collapsed = false, bool inner_collapsed = false) {
+  PersistentNodes inner_children;
+  inner_children.push_back(Pin("deep"));
+  PersistentNodes outer_children;
+  outer_children.push_back(Pin("first"));
+  outer_children.push_back(
+      Folder("inner", std::move(inner_children), inner_collapsed));
+  outer_children.push_back(Pin("last"));
+
+  PersistentNodes result;
+  result.push_back(Pin("top"));
+  result.push_back(Folder("outer", std::move(outer_children), collapsed));
+  result.push_back(Pin("tail"));
+  return result;
+}
+
+SidebarPinKey Key(std::string item_id, std::string space_id = "space-a") {
+  return {.space_id = std::move(space_id), .item_id = std::move(item_id)};
+}
+
+SidebarPinDropTarget Drop(std::string item_id,
+                          SidebarPinDropPosition position) {
+  return {.key = Key(std::move(item_id)), .position = position};
+}
+
+TEST(HeliumSidebarPinProjectionTest, FlattensNestedFoldersInTreeOrder) {
+  HeliumSidebarPinProjection projection("space-a", PinTree());
