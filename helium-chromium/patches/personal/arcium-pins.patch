+
+bool WrapLinkInFolder(PersistentNodes* nodes,
+                      std::string_view link_id,
+                      std::string folder_id,
+                      std::u16string folder_title) {
+  for (PersistentNode& node : *nodes) {
+    if (auto* link = std::get_if<PersistentLink>(&node.data)) {
+      if (link->id != link_id) {
+        continue;
+      }
+      PersistentNodes children;
+      children.push_back(std::move(node));
+      node.data = PersistentFolder{.id = std::move(folder_id),
+                                   .title = std::move(folder_title),
+                                   .collapsed = false,
+                                   .children = std::move(children)};
+      return true;
+    }
+    auto* folder = std::get_if<PersistentFolder>(&node.data);
+    if (folder &&
+        WrapLinkInFolder(&folder->children, link_id, folder_id, folder_title)) {
+      return true;
+    }
+  }
+  return false;
+}
