+bool IsEligibleOrdinaryTab(const tabs::TabInterface* tab) {
+  if (!tab || tab->IsPinned() || tab->IsSplit() || tab->GetGroup() ||
+      helium::IsPersistentItemTab(tab) || !tab->GetContents() ||
+      !tab->GetContents()->GetLastCommittedURL().SchemeIsHTTPOrHTTPS()) {
+    return false;
