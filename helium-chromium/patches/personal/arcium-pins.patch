+void AppendDormantPersistentItemMenuItems(ui::SimpleMenuModel* model,
+                                          bool is_pin) {
+  CHECK(model);
+  model->AddItem(static_cast<int>(PersistentItemMenuCommand::kOpen),
+                 l10n_util::GetStringUTF16(IDS_HISTORY_OPEN));
+  if (is_pin) {
+    model->AddItem(static_cast<int>(PersistentItemMenuCommand::kFavorite),
+                   l10n_util::GetStringUTF16(IDS_TAB_CXMENU_PIN_TAB));
+  }
+  model->AddItem(static_cast<int>(PersistentItemMenuCommand::kRemove),
+                 l10n_util::GetStringUTF16(
+                     is_pin ? IDS_TAB_CXMENU_REMOVE_PIN
+                            : IDS_TAB_CXMENU_UNPIN_TAB));
+}
