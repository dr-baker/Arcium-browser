+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/page_transition_types.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+using content::NavigationThrottle;
+using ::testing::Return;
+
+namespace helium {
+namespace {
+
+constexpr char kHome[] = "https://home.test/";
+constexpr char kAway[] = "https://away.test/away";
+constexpr char kHomeFragment[] = "https://home.test/#section";
+constexpr char kReferrer[] = "https://source.test/page";
+
+class HeliumAnchoredNavigationThrottleTest
+    : public ChromeRenderViewHostTestHarness {
+ public:
+  void SetUp() override {
+    ChromeRenderViewHostTestHarness::SetUp();
+    handle_ = std::make_unique<content::MockNavigationHandle>(
+        GURL(kAway), web_contents()->GetPrimaryMainFrame());
+    handle_->set_is_renderer_initiated(true);
+    handle_->set_is_in_primary_main_frame(true);
+    handle_->set_page_transition(ui::PAGE_TRANSITION_LINK);
+    handle_->set_is_form_submission(false);
+    handle_->set_is_same_document(false);
+    handle_->set_reload_type(content::ReloadType::NONE);
+    handle_->set_redirect_chain({GURL(kAway)});
+    handle_->SetReferrer(blink::mojom::Referrer::New(
+        GURL(kReferrer), network::mojom::ReferrerPolicy::kStrictOrigin));
+    handle_->set_initiator_origin(
+        url::Origin::Create(GURL("https://source.test")));
+    ON_CALL(*handle_, HasUserGesture()).WillByDefault(Return(true));
+    ON_CALL(*handle_, WasInitiatedByLinkClick()).WillByDefault(Return(true));
+    registry_ = std::make_unique<content::MockNavigationThrottleRegistry>(
+        handle_.get(),
+        content::MockNavigationThrottleRegistry::RegistrationMode::kHold);
+  }
+
+  void TearDown() override {
+    throttle_.reset();
+    registry_.reset();
+    handle_.reset();
+    ChromeRenderViewHostTestHarness::TearDown();
+  }
+
+ protected:
+  HeliumAnchoredNavigationThrottle::Dependencies MakeDependencies(
+      bool is_anchored,
+      bool open_succeeds) {
+    HeliumAnchoredNavigationThrottle::Dependencies deps;
+    deps.resolve_anchored_home = base::BindRepeating(
+        [](bool is_anchored, const GURL& home, Profile* profile,
+           content::WebContents*, GURL* home_url, Profile** out_profile) {
+          if (!is_anchored) {
+            return false;
+          }
+          *home_url = home;
+          *out_profile = profile;
+          return true;
+        },
+        is_anchored, GURL(kHome), profile());
+    deps.open_optional_navigation = base::BindRepeating(
+        [](int* open_count, std::optional<content::OpenURLParams>* last_params,
+           bool* open_succeeds, Profile*,
+           const content::OpenURLParams& params) {
+          ++*open_count;
+          *last_params = params;
+          return *open_succeeds;
+        },
+        &open_count_, &last_params_, &open_succeeds_);
+    open_succeeds_ = open_succeeds;
+    return deps;
+  }
+
+  HeliumAnchoredNavigationThrottle* CreateThrottle(bool is_anchored = true,
+                                                   bool open_succeeds = true) {
+    throttle_ = std::make_unique<HeliumAnchoredNavigationThrottle>(
+        *registry_, MakeDependencies(is_anchored, open_succeeds));
+    return throttle_.get();
+  }
+
+  int open_count_ = 0;
+  std::optional<content::OpenURLParams> last_params_;
+  bool open_succeeds_ = true;
+  std::unique_ptr<content::MockNavigationHandle> handle_;
+  std::unique_ptr<content::MockNavigationThrottleRegistry> registry_;
+  std::unique_ptr<HeliumAnchoredNavigationThrottle> throttle_;
+};
+
+TEST_F(HeliumAnchoredNavigationThrottleTest,
+       DivertsRendererLinkAwayFromHomeOnce) {
+  HeliumAnchoredNavigationThrottle* throttle = CreateThrottle();
+  EXPECT_EQ(NavigationThrottle::CANCEL_AND_IGNORE,
+            throttle->WillStartRequest().action());
+  EXPECT_EQ(1, open_count_);
+  ASSERT_TRUE(last_params_.has_value());
+  EXPECT_EQ(GURL(kAway), last_params_->url);
+  EXPECT_EQ(GURL(kReferrer), last_params_->referrer.url);
+  ASSERT_TRUE(last_params_->initiator_origin.has_value());
+  EXPECT_EQ(url::Origin::Create(GURL("https://source.test")),
+            *last_params_->initiator_origin);
+  EXPECT_TRUE(last_params_->is_renderer_initiated);
+  EXPECT_TRUE(last_params_->user_gesture);
+  EXPECT_FALSE(last_params_->started_from_context_menu);
+
+  handle_->set_url(GURL("https://away.test/redirected"));
+  EXPECT_EQ(NavigationThrottle::PROCEED,
+            throttle->WillRedirectRequest().action());
+  EXPECT_EQ(1, open_count_);
+}
+
+TEST_F(HeliumAnchoredNavigationThrottleTest, PopupFailureFallsBackToSameTab) {
+  HeliumAnchoredNavigationThrottle* throttle =
+      CreateThrottle(/*is_anchored=*/true, /*open_succeeds=*/false);
+  EXPECT_EQ(NavigationThrottle::PROCEED, throttle->WillStartRequest().action());
+  EXPECT_EQ(1, open_count_);
+}
+
+TEST_F(HeliumAnchoredNavigationThrottleTest, UnanchoredTabBypass) {
+  HeliumAnchoredNavigationThrottle* throttle =
+      CreateThrottle(/*is_anchored=*/false);
+  EXPECT_EQ(NavigationThrottle::PROCEED, throttle->WillStartRequest().action());
+  EXPECT_EQ(0, open_count_);
+}
+
