+TEST_P(SavedSourceSplitTest,
+       NonadjacentSavedSiblingsKeepInterveningTabAndAssociations) {
+  auto* source = AddSavedSource();
+  const auto source_state = CaptureSavedSource(source);
+  std::string folder_id;
+  if (GetParam() == SavedSourceKind::kFolderPin) {
+    const auto* folder =
+        std::get_if<PersistentFolder>(&space_->pins().front().data);
+    ASSERT_TRUE(folder);
+    folder_id = folder->id;
+  }
+
+  auto save_sibling = [this](tabs::TabInterface* tab) {
+    const bool saved = GetParam() == SavedSourceKind::kFavorite
+                           ? MakeFavorite(tab)
+                           : MakePin(tab);
+    EXPECT_TRUE(saved);
+    tab->GetContents()->SetUserData(&kUnsavedPageStateKey,
+                                    std::make_unique<UnsavedPageState>());
+  };
+  auto* intervening = AddOrdinaryTab("https://intervening.test/");
+  save_sibling(intervening);
+  auto* target = AddOrdinaryTab("https://same-parent.test/");
+  save_sibling(target);
+
+  tabs::TabCollection* parent = source_state.parent.Get();
+  ASSERT_TRUE(parent);
+  const std::vector<tabs::TabInterface*> siblings = {source, intervening,
+                                                     target};
+  for (size_t i = 0; i < siblings.size(); ++i) {
+    auto* tab = siblings[i];
+    if (GetParam() == SavedSourceKind::kFavorite) {
+      model()->MoveWebContentsAt(model()->GetIndexOfTab(tab),
+                                 static_cast<int>(i), false);
+    } else {
+      if (!folder_id.empty() && tab != source) {
+        const auto item_id = service_->GetPersistentItemId(tab);
+        ASSERT_TRUE(item_id);
+        ASSERT_TRUE(service_->MovePinInSpace(browser(), space_->id(), *item_id,
+                                             folder_id, {}));
+      }
+      model()->MoveTabToPinCollection(tab, parent, i);
+    }
+    ASSERT_EQ(parent, tab->GetParentCollection());
+    ASSERT_EQ(i, parent->GetIndexOfTab(tab));
+  }
+
+  const auto intervening_state = CaptureSavedSource(intervening);
+  const auto target_state = CaptureSavedSource(target);
+  const auto pins = space_->pins();
+  const auto favorites = service_->GetFavoritesForBrowser(browser());
+  const int count = model()->count();
+  model()->ActivateTabAt(model()->GetIndexOfTab(source));
+  const auto id = model()->AddToNewSplit(
+      {model()->GetIndexOfTab(target)}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kToolbarButton);
+  base::RunLoop().RunUntilIdle();
+
+  ASSERT_TRUE(model()->ContainsSplit(id));
+  EXPECT_EQ((std::vector<tabs::TabInterface*>{source, target}),
+            model()->GetSplitData(id)->ListTabs());
+  EXPECT_EQ(parent, source->GetParentCollection()->GetParentCollection());
+  EXPECT_FALSE(intervening->IsSplit());
+  EXPECT_EQ(parent, intervening->GetParentCollection());
+  EXPECT_EQ(count, model()->count());
+  EXPECT_EQ(pins, space_->pins());
+  EXPECT_EQ(favorites, service_->GetFavoritesForBrowser(browser()));
+  ExpectSavedSource(source_state);
+  ExpectSavedSource(target_state);
+  ExpectSavedSource(intervening_state);
+
+  model()->RemoveSplit(id);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(count, model()->count());
+  EXPECT_FALSE(source->IsSplit());
+  EXPECT_FALSE(target->IsSplit());
+  EXPECT_FALSE(intervening->IsSplit());
+  EXPECT_EQ(pins, space_->pins());
+  EXPECT_EQ(favorites, service_->GetFavoritesForBrowser(browser()));
+  ExpectSavedSource(source_state);
+  ExpectSavedSource(target_state);
+  ExpectSavedSource(intervening_state);
+}
