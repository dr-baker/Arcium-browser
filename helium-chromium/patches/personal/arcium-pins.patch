+
+bool HeliumSpaceService::CanRelocatePinNodeInSpace(std::string_view space_id,
+                                                   std::string_view id) const {
+  auto* self = const_cast<HeliumSpaceService*>(this);
+  HeliumSpace* space = self->GetSpaceById(space_id);
+  if (!space) {
+    return false;
+  }
+  auto can_relocate_link = [&](std::string_view link_id) {
+    const std::string key =
+        ItemKeyForSpace(PersistentRecordKind::kPin, space_id, link_id);
+    const auto state = lifecycle_.GetState(key);
+    if (state && (*state == PersistentItemLifecycle::State::kMaterializing ||
+                  *state == PersistentItemLifecycle::State::kClosing)) {
+      return false;
+    }
+    const auto token = lifecycle_.GetLiveTab(key);
+    if (!token) {
+      return !state || *state == PersistentItemLifecycle::State::kDormant;
+    }
+    const auto association = live_associations_.find(*token);
+    const tabs::TabInterface* tab = association == live_associations_.end()
+                                        ? nullptr
+                                        : association->second->tab.get();
+    const BrowserWindowInterface* window =
+        tab ? tab->GetBrowserWindowInterface() : nullptr;
+    Browser* browser =
+        window ? const_cast<Browser*>(window->GetBrowserForMigrationOnly())
+               : nullptr;
+    return tab && !live_pin_space_transfers_.contains(*token) &&
+           association->second->key == key &&
+           association->second->kind == PersistentRecordKind::kPin &&
+           association->second->space_id == space_id &&
+           association->second->item_id == link_id &&
+           FindLiveAssociation(tab) == association->second.get() &&
+           tab->GetProfile() == profile_ && !tab->IsSplit() &&
+           !tab->GetGroup() && IsEligibleBrowser(browser) &&
+           !browser->IsAttemptingToCloseBrowser() &&
+           GetExplicitSpaceIdForBrowser(browser) == space_id &&
+           IsLiveTabInExpectedCollection(PersistentRecordKind::kPin, tab);
+  };
+  if (const PersistentLink* link =
+          PersistentItemCodec::FindLink(space->pins(), id)) {
+    return can_relocate_link(link->id);
+  }
+  const PersistentFolder* folder =
+      PersistentItemCodec::FindFolder(space->pins(), id);
+  if (!folder) {
+    return false;
+  }
+  auto can_relocate_children = [&](auto&& visit,
+                                   const PersistentNodes& children) -> bool {
+    for (const PersistentNode& node : children) {
+      if (const auto* link = std::get_if<PersistentLink>(&node.data)) {
+        if (!can_relocate_link(link->id)) {
+          return false;
+        }
+      } else if (!visit(visit,
+                        std::get<PersistentFolder>(node.data).children)) {
+        return false;
+      }
+    }
+    return true;
+  };
+  return can_relocate_children(can_relocate_children, folder->children);
+}
+
+HeliumSpace* HeliumSpaceService::ResolvePinOwner(Browser* browser,
+                                                 std::string_view id) const {
+  if (!IsEligibleBrowser(browser)) {
+    return nullptr;
+  }
+  auto* self = const_cast<HeliumSpaceService*>(this);
+  const std::string current_space_id(GetSpaceIdForBrowser(browser));
+  if (HeliumSpace* current_space = self->GetSpaceById(current_space_id);
+      current_space && ResolvePinInSpace(current_space_id, id)) {
+    return current_space;
+  }
+
+  // Commands are dispatched from the currently visible browser, but the
+  // omnibox also exposes Pins owned by other Spaces. Resolve those commands
+  // by identity when there is exactly one possible owner; duplicate IDs stay
+  // rejected rather than mutating the wrong Space.
+  HeliumSpace* owner = nullptr;
+  for (const auto& space : spaces_) {
+    if (space->id() == current_space_id ||
+        !ResolvePinInSpace(space->id(), id)) {
+      continue;
+    }
+    if (owner) {
+      return nullptr;
+    }
+    owner = space.get();
+  }
+  return owner;
+}
+
+bool HeliumSpaceService::ActivatePersistentItem(Browser* browser,
+                                                PersistentRecordKind kind,
+                                                std::string_view id) {
+  if (!IsEligibleBrowser(browser)) {
+    return false;
+  }
+  std::optional<PersistentLink> item = ResolveItem(browser, kind, id);
+  if (!item) {
+    return false;
+  }
+  const std::string key = ItemKey(browser, kind, id);
+  auto decision = lifecycle_.BeginActivation(key);
+  if (decision.action ==
+      PersistentItemLifecycle::ActivationAction::kActivateExisting) {
+    auto association = live_associations_.find(*decision.live_tab);
+    tabs::TabInterface* live_tab = association == live_associations_.end()
+                                       ? nullptr
+                                       : association->second->tab.get();
+    BrowserWindowInterface* window =
+        live_tab ? live_tab->GetBrowserWindowInterface() : nullptr;
+    Browser* live_browser =
+        window ? window->GetBrowserForMigrationOnly() : nullptr;
+    const int index =
+        live_browser && live_tab
+            ? live_browser->tab_strip_model()->GetIndexOfTab(live_tab)
+            : -1;
+    if (index >= 0) {
+      live_browser->window()->Show();
+      live_browser->tab_strip_model()->ActivateTabAt(index);
+      RecordPersistentItemUsage(key);
+      NotifyItemsChanged(ChangeForItem(browser, kind));
+      return true;
+    }
+    // Heal a stale association instead of permanently wedging the durable
+    // item in kLive. This path is outside observer teardown callbacks.
+    lifecycle_.BeginClose(*decision.live_tab);
+    EraseLiveAssociation(*decision.live_tab);
+    lifecycle_.CompleteClose(*decision.live_tab);
+    decision = lifecycle_.BeginActivation(key);
+  }
+  if (decision.action !=
+      PersistentItemLifecycle::ActivationAction::kMaterialize) {
+    return false;
+  }
+
+  content::WebContents* contents =
+      chrome::AddAndReturnTabAt(browser, item->url, -1, false);
+  tabs::TabInterface* tab = tabs::TabInterface::MaybeGetFromContents(contents);
+  if (!tab || !AssociateLiveTab(key, kind, id, tab)) {
+    lifecycle_.CancelMaterialization(key);
+    return false;
+  }
+
+  const int index = browser->tab_strip_model()->GetIndexOfTab(tab);
+  CHECK_NE(TabStripModel::kNoTab, index);
+  browser->tab_strip_model()->ActivateTabAt(index);
+  RecordPersistentItemUsage(key);
+  NotifyItemsChanged(ChangeForItem(browser, kind));
+  return true;
+}
