+      presentation_mode_(presentation_mode),
+      tab_style_(TabStyle::Get()),
+      icon_(AddChildView(std::make_unique<TabIcon>())),
+      title_(AddChildView(std::make_unique<TabTitle>())),
+      close_button_(AddChildView(std::make_unique<TabCloseButton>(
+          base::BindRepeating(&PersistentTabView::CloseButtonPressed,
+                              base::Unretained(this)),
+          base::BindRepeating([](views::View*, const ui::MouseEvent&) {})))),
+      remove_callback_(std::move(remove_callback)),
+      favorite_callback_(std::move(favorite_callback)),
+      drag_delegate_(drag_delegate),
+      url_(std::move(url)) {
+  CHECK(profile_);
+
+  SetNotifyEnterExitOnChild(true);
+  SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+  SetTooltipText(title);
+  set_context_menu_controller(this);
+
+  views::FocusRing::Install(this);
+  views::FocusRing::Get(this)->SetOutsetFocusRingDisabled(true);
+  views::InstallRoundRectHighlightPathGenerator(
+      this, gfx::Insets(),
+      GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius));
+
+  GetViewAccessibility().SetRole(ax::mojom::Role::kTab);
+  GetViewAccessibility().SetName(title);
+
+  title_->SetText(std::move(title));
+  title_->SetVisible(presentation_mode_ != PresentationMode::kCompactGrid);
+  close_button_->SetVisible(false);
+  SetFavicon(
+      favicon::GetDefaultFaviconModel(kColorTabBackgroundActiveFrameActive),
+      PersistentFaviconState::kPlaceholder);
+  if (history::HistoryService* history_service =
+          HistoryServiceFactory::GetForProfile(
+              profile_, ServiceAccessType::EXPLICIT_ACCESS)) {
+    favicons_changed_subscription_ =
+        history_service->AddFaviconsChangedCallback(
+            base::BindRepeating(&PersistentTabView::OnFaviconsChanged,
+                                weak_ptr_factory_.GetWeakPtr()));
+  }
+  LoadFavicon();
+  UpdateColors();
+}
