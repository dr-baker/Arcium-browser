+
+bool PinTabContainerView::BeginPersistentTreeDrag(
+    views::View& row,
+    std::string id,
+    const ui::MouseEvent& press_event,
+    const ui::MouseEvent& drag_event) {
+  if (!collection_node_ || !space_service_ || id.empty() ||
+      persistent_drag_view_) {
+    return UseSidebarProjection();
+  }
+  persistent_drag_view_ = &row;
+  persistent_drag_id_ = std::move(id);
+  if (UseSidebarProjection()) {
+    BeginPersistentDragPresentation(row, press_event);
+    BrowserView* browser_view =
+        collection_node_->GetController()
+            ? collection_node_->GetController()->GetBrowserView()
+            : nullptr;
+    Browser* browser = browser_view ? browser_view->browser() : nullptr;
+    sidebar_drag_browser_ = browser;
+    sidebar_drag_space_id_ =
+        browser ? std::string(space_service_->GetSpaceIdForBrowser(browser))
+                : std::string();
+    sidebar_drag_over_pins_ = false;
+    sidebar_drag_over_tabs_ = false;
+    sidebar_tab_drop_before_.reset();
+    sidebar_drop_target_.reset();
+    sidebar_preview_placement_.reset();
+
+    const auto row_space = row_space_ids_.find(&row);
+    if (browser && row_space != row_space_ids_.end() &&
+        row_space->second == sidebar_drag_space_id_ && sidebar_projection_ &&
+        sidebar_projection_->valid() &&
+        sidebar_projection_->space_id() == sidebar_drag_space_id_) {
+      const helium::SidebarPinKey source_key{
+          .space_id = sidebar_drag_space_id_,
+          .item_id = persistent_drag_id_,
+      };
+      const helium::SidebarPinRow* source_row =
+          sidebar_projection_->FindVisibleRow(source_key);
+      std::optional<helium::SidebarItemPlacement> placement =
+          GetSidebarItemPlacement(*sidebar_projection_, persistent_drag_id_);
+      if (source_row && placement) {
+        const helium::SidebarDragContext context =
+            GetSidebarDragContext(browser);
+        sidebar_drag_transaction_ =
+            std::make_unique<helium::SidebarDragTransaction>(
+                helium::SidebarDragSource{
+                    .item_id = persistent_drag_id_,
+                    .kind =
+                        source_row->kind == helium::SidebarPinRowKind::kFolder
+                            ? helium::SidebarItemKind::kFolder
+                            : helium::SidebarItemKind::kPin,
+                    .context = context,
+                    .placement = *placement,
+                });
+      }
+    }
+    if (TabStripView* tab_strip = GetTabStripView(this)) {
+      tab_strip->SetMainTabsDropPreview();
+    }
+    UpdatePersistentTreeDrag(row, drag_event);
+    // Crossing the drag threshold always consumes the click, including when
+    // a concurrent model change makes the transaction invalid.
+    return true;
+  }
+  const auto row_space = row_space_ids_.find(&row);
+  persistent_drag_space_id_ =
+      row_space != row_space_ids_.end() ? row_space->second : std::string();
+  persistent_drag_over_tabs_ = false;
+  persistent_tab_drop_before_.reset();
+  if (TabStripView* tab_strip = GetTabStripView(this)) {
+    tab_strip->SetMainTabsDropPreview();
+  }
+  UpdatePersistentTreeDrag(row, drag_event);
+  return true;
+}
+
+void PinTabContainerView::UpdatePersistentTreeDrag(
+    views::View& row,
+    const ui::MouseEvent& event) {
+  if (persistent_drag_view_ != &row || persistent_drag_id_.empty()) {
+    return;
+  }
+  gfx::Point point_in_screen = event.location();
+  views::View::ConvertPointToScreen(&row, &point_in_screen);
+  UpdatePersistentDragPresentation(point_in_screen);
+  TabStripView* tab_strip = GetTabStripView(this);
+  if (UseSidebarProjection()) {
+    BrowserView* browser_view =
+        collection_node_ && collection_node_->GetController()
+            ? collection_node_->GetController()->GetBrowserView()
+            : nullptr;
+    Browser* browser = browser_view ? browser_view->browser() : nullptr;
+    const bool context_matches =
+        browser && browser == sidebar_drag_browser_ &&
+        space_service_->GetSpaceIdForBrowser(browser) == sidebar_drag_space_id_;
+    if (!context_matches || !sidebar_drag_transaction_ ||
+        !sidebar_drag_transaction_->is_active() || !tab_strip) {
+      sidebar_drag_over_pins_ = false;
+      sidebar_drag_over_tabs_ = false;
+      sidebar_tab_drop_before_.reset();
+      sidebar_drop_target_.reset();
+      sidebar_preview_placement_.reset();
+      if (tab_strip) {
+        tab_strip->GetUnpinnedTabsContainer()
+            ->ClearPersistentTabDragPreview();
+      }
+      ClearPersistentTabDragPreview();
+      RestoreSidebarProjectionOrder();
+      return;
+    }
+
+    UnpinnedTabContainerView* ordinary =
+        tab_strip->GetUnpinnedTabsContainer();
+    if (!tab_strip->IsPointInPinsRegion(point_in_screen)) {
+      const bool is_folder = row_is_folders_.contains(&row) &&
+                             row_is_folders_.at(&row);
+      BaseTabStripRegionView* region =
+          views::AsViewClass<BaseTabStripRegionView>(tab_strip->parent());
+      if (is_folder || !ordinary || !region ||
+          !region->IsPointInOrdinaryTabDropRegion(point_in_screen)) {
+        sidebar_drag_over_pins_ = false;
+        sidebar_drag_over_tabs_ = false;
+        sidebar_tab_drop_before_.reset();
+        sidebar_drop_target_.reset();
+        sidebar_preview_placement_.reset();
+        if (ordinary) {
+          ordinary->ClearPersistentTabDragPreview();
+        }
+        ClearPersistentTabDragPreview();
+        RestoreSidebarProjectionOrder();
+        return;
+      }
+
+      tabs::TabInterface* before_tab =
+          ordinary->GetTabBeforePersistentDrop(point_in_screen);
+      sidebar_tab_drop_before_ =
+          before_tab ? std::optional(before_tab->GetHandle()) : std::nullopt;
+      helium::SidebarItemPlacement placement{
+          .section = helium::SidebarSection::kTabs,
+          .before_id = before_tab
+                           ? base::NumberToString(
+                                 before_tab->GetHandle().raw_value())
+                           : std::string(),
+      };
+      sidebar_drag_transaction_->UpdatePreview(
+          {.context = GetSidebarDragContext(browser), .placement = placement});
+      sidebar_drag_over_pins_ = false;
+      sidebar_drag_over_tabs_ = true;
+      sidebar_drop_target_.reset();
+      sidebar_preview_placement_ = placement;
+      ClearPersistentTabDragPreview();
+      RestoreSidebarProjectionOrder();
+      ordinary->UpdatePersistentTabDragPreview(point_in_screen);
+      return;
+    }
+
+    ordinary->ClearPersistentTabDragPreview();
+    sidebar_drag_over_tabs_ = false;
+    sidebar_tab_drop_before_.reset();
+
+    std::optional<helium::SidebarPinDropTarget> target =
+        GetSidebarPinDropTarget(point_in_screen);
+    helium::SidebarPinMoveIntent move = helium::ResolveSidebarPinDrop(
+        *sidebar_projection_,
+        {.space_id = sidebar_drag_space_id_, .item_id = persistent_drag_id_},
+        target);
+    if (!target ||
+        (move.result != helium::SidebarPinMoveIntent::Result::kMove &&
+         move.result != helium::SidebarPinMoveIntent::Result::kNoOp)) {
+      sidebar_drag_over_pins_ = false;
+      sidebar_drag_over_tabs_ = false;
+      sidebar_tab_drop_before_.reset();
+      sidebar_drop_target_.reset();
+      sidebar_preview_placement_.reset();
+      ClearPersistentTabDragPreview();
+      RestoreSidebarProjectionOrder();
+      return;
+    }
+
+    std::optional<helium::SidebarItemPlacement> placement;
+    if (move.result == helium::SidebarPinMoveIntent::Result::kMove) {
+      placement = helium::SidebarItemPlacement{
+          .section = helium::SidebarSection::kPins,
+          .parent_id = move.parent ? move.parent->item_id : std::string(),
+          .before_id = move.before ? move.before->item_id : std::string(),
+      };
+    } else {
+      placement =
+          GetSidebarItemPlacement(*sidebar_projection_, persistent_drag_id_);
+    }
+    if (!placement) {
+      sidebar_drag_over_pins_ = false;
+      sidebar_drag_over_tabs_ = false;
+      sidebar_tab_drop_before_.reset();
+      sidebar_drop_target_.reset();
+      sidebar_preview_placement_.reset();
+      ClearPersistentTabDragPreview();
+      RestoreSidebarProjectionOrder();
+      return;
+    }
+
+    if (sidebar_drag_over_pins_ &&
+        sidebar_preview_placement_ == *placement) {
+      // Pointer motion within one semantic slot should move only the floating
+      // source presentation. Rebuilding the same projection on every mouse
+      // event adds work without changing any surrounding-row target bounds.
+      sidebar_drop_target_ = std::move(target);
+      return;
+    }
+
+    const helium::SidebarDragContext context = GetSidebarDragContext(browser);
+    sidebar_drag_transaction_->UpdatePreview(
+        {.context = context, .placement = *placement});
+    sidebar_drag_over_pins_ = true;
+    sidebar_drop_target_ = std::move(target);
+    sidebar_preview_placement_ = *placement;
+    UpdatePersistentFolderDropHighlight(
+        {.target = PersistentTabDropTarget::kPin,
+         .parent_id = placement->parent_id,
+         .before_id = placement->before_id});
+    ApplySidebarMovePreview(move);
+    return;
+  }
+  auto* ordinary = tab_strip ? tab_strip->GetUnpinnedTabsContainer() : nullptr;
+  if (tab_strip && !tab_strip->IsPointInPinsRegion(point_in_screen)) {
+    BaseTabStripRegionView* region =
+        views::AsViewClass<BaseTabStripRegionView>(tab_strip->parent());
+    if (!ordinary || !region ||
+        !region->IsPointInOrdinaryTabDropRegion(point_in_screen)) {
+      persistent_drag_location_ = {.target = PersistentTabDropTarget::kTab};
+      persistent_drag_over_tabs_ = false;
+      persistent_tab_drop_before_.reset();
+      ClearPersistentTabDragPreview();
+      if (ordinary) {
+        ordinary->ClearPersistentTabDragPreview();
+      }
+      return;
+    }
+    persistent_drag_location_ = {.target = PersistentTabDropTarget::kTab};
+    tabs::TabInterface* before_tab =
+        ordinary->GetTabBeforePersistentDrop(point_in_screen);
+    persistent_tab_drop_before_ =
+        before_tab ? std::optional(before_tab->GetHandle()) : std::nullopt;
+    persistent_drag_over_tabs_ = true;
+    ClearPersistentTabDragPreview();
+    ordinary->UpdatePersistentTabDragPreview(point_in_screen);
+    return;
+  }
+  persistent_drag_over_tabs_ = false;
+  persistent_tab_drop_before_.reset();
+  if (ordinary) {
+    ordinary->ClearPersistentTabDragPreview();
+  }
+  persistent_drag_location_ =
+      GetPersistentDropLocation(persistent_drag_id_, point_in_screen);
+  UpdatePersistentTabDragPreview(point_in_screen);
+}
+
+void PinTabContainerView::EndPersistentTreeDrag(views::View& row,
+                                                const ui::MouseEvent& event) {
+  if (persistent_drag_view_ != &row || persistent_drag_id_.empty()) {
+    return;
+  }
+  UpdatePersistentTreeDrag(row, event);
+  if (UseSidebarProjection()) {
+    BrowserView* browser_view =
+        collection_node_ && collection_node_->GetController()
+            ? collection_node_->GetController()->GetBrowserView()
+            : nullptr;
+    Browser* browser = browser_view ? browser_view->browser() : nullptr;
+    std::unique_ptr<helium::SidebarDragTransaction> transaction =
+        std::move(sidebar_drag_transaction_);
+    std::optional<helium::SidebarDragCommand> command;
+    const std::optional<tabs::TabHandle> tab_drop_before =
+        sidebar_tab_drop_before_;
+
+    if (transaction && transaction->is_active() &&
+        (sidebar_drag_over_pins_ || sidebar_drag_over_tabs_) &&
+        sidebar_preview_placement_ && browser &&
+        browser == sidebar_drag_browser_ &&
+        space_service_->GetSpaceIdForBrowser(browser) ==
+            sidebar_drag_space_id_) {
+      std::unique_ptr<helium::HeliumSidebarPinProjection> fresh_projection =
+          BuildSidebarProjection(browser);
+      if (fresh_projection) {
+        std::optional<helium::SidebarItemPlacement> fresh_target;
+        if (sidebar_drag_over_pins_ && sidebar_drop_target_) {
+          const helium::SidebarPinMoveIntent fresh_move =
+              helium::ResolveSidebarPinDrop(
+                  *fresh_projection,
+                  {.space_id = sidebar_drag_space_id_,
+                   .item_id = persistent_drag_id_},
+                  sidebar_drop_target_);
+          if (fresh_move.result ==
+              helium::SidebarPinMoveIntent::Result::kMove) {
+            fresh_target = helium::SidebarItemPlacement{
+                .section = helium::SidebarSection::kPins,
+                .parent_id = fresh_move.parent ? fresh_move.parent->item_id
+                                               : std::string(),
+                .before_id = fresh_move.before ? fresh_move.before->item_id
+                                               : std::string(),
+            };
+          } else if (fresh_move.result ==
+                     helium::SidebarPinMoveIntent::Result::kNoOp) {
+            fresh_target = GetSidebarItemPlacement(
+                *fresh_projection, persistent_drag_id_);
+          }
+        } else if (sidebar_drag_over_tabs_) {
+          tabs::TabInterface* before_tab =
+              tab_drop_before ? tab_drop_before->Get() : nullptr;
+          BrowserWindowInterface* before_window =
+              before_tab ? before_tab->GetBrowserWindowInterface() : nullptr;
+          if (!tab_drop_before ||
+              (before_tab && before_window &&
+               before_window->GetBrowserForMigrationOnly() == browser)) {
+            fresh_target = helium::SidebarItemPlacement{
+                .section = helium::SidebarSection::kTabs,
+                .before_id = before_tab
+                                 ? base::NumberToString(
+                                       before_tab->GetHandle().raw_value())
+                                 : std::string(),
+            };
+          }
+        }
+        std::optional<helium::SidebarItemPlacement> fresh_source =
+            GetSidebarItemPlacement(*fresh_projection, persistent_drag_id_);
+        const helium::SidebarPinRow* fresh_source_row =
+            fresh_projection->FindVisibleRow(
+                {.space_id = sidebar_drag_space_id_,
+                 .item_id = persistent_drag_id_});
+        const helium::SidebarDragContext context =
+            GetSidebarDragContext(browser);
+        helium::SidebarDragRevalidation revalidation{
+            .target_context = context,
+            .target_section_accepts_source =
+                fresh_target.has_value() &&
+                fresh_target == sidebar_preview_placement_ &&
+                (sidebar_drag_over_pins_ ||
+                 (fresh_source_row &&
+                  fresh_source_row->kind ==
+                      helium::SidebarPinRowKind::kPin)),
+            .target_parent_accepts_source = fresh_target.has_value(),
+            .target_parent_exists = fresh_target.has_value(),
+            .before_id_is_direct_child =
+                fresh_target.has_value() &&
+                (fresh_target->before_id.empty() ||
+                 sidebar_drag_over_pins_ || tab_drop_before.has_value()),
+            .target_parent_is_source_or_descendant = false,
+        };
+        if (fresh_source && fresh_source_row) {
+          revalidation.source = helium::SidebarDragSource{
+              .item_id = persistent_drag_id_,
+              .kind =
+                  fresh_source_row->kind == helium::SidebarPinRowKind::kFolder
+                      ? helium::SidebarItemKind::kFolder
+                      : helium::SidebarItemKind::kPin,
+              .context = context,
+              .placement = *fresh_source,
+          };
+        }
+        helium::SidebarDragResult result = transaction->Commit(revalidation);
+        if (result.outcome == helium::SidebarDragOutcome::kCommitted) {
+          command = std::move(result.command);
+        }
+      } else {
+        transaction->Cancel();
+      }
+    } else if (transaction && transaction->is_active()) {
+      transaction->Cancel();
+    }
+
+    const std::string id = std::exchange(persistent_drag_id_, std::string());
+    const std::string source_space_id = sidebar_drag_space_id_;
+    ClearPersistentDragPresentation();
+    persistent_drag_view_ = nullptr;
+    sidebar_drag_browser_ = nullptr;
+    sidebar_drag_space_id_.clear();
+    sidebar_drag_over_pins_ = false;
+    sidebar_drag_over_tabs_ = false;
+    sidebar_tab_drop_before_.reset();
+    sidebar_drop_target_.reset();
+    sidebar_preview_placement_.reset();
+    if (TabStripView* current_tab_strip = GetTabStripView(this)) {
+      current_tab_strip->GetUnpinnedTabsContainer()
+          ->ClearPersistentTabDragPreview();
+      current_tab_strip->ClearMainTabsDropPreview();
+    }
+    ClearPersistentTabDragPreview();
+
+    if (command && (command->action == helium::SidebarDragAction::kReorder ||
+                    command->action == helium::SidebarDragAction::kReparent)) {
+      if (!space_service_->MovePinInSpace(
+              browser, source_space_id, id, command->target.placement.parent_id,
+              command->target.placement.before_id)) {
+        RestoreSidebarProjectionOrder();
+      }
+    } else if (command &&
+               command->action == helium::SidebarDragAction::kUnpin) {
+      if (!space_service_->ConvertPinToTabInSpace(
+              browser, source_space_id, id, tab_drop_before)) {
+        RestoreSidebarProjectionOrder();
+      }
+    } else {
+      RestoreSidebarProjectionOrder();
+    }
+    ScheduleReconcilePersistentRows();
+    return;
+  }
+  BrowserView* browser_view =
+      collection_node_ && collection_node_->GetController()
+          ? collection_node_->GetController()->GetBrowserView()
+          : nullptr;
+  Browser* browser = browser_view ? browser_view->browser() : nullptr;
+  const std::string id = std::exchange(persistent_drag_id_, std::string());
+  const std::string source_space_id =
+      std::exchange(persistent_drag_space_id_, std::string());
+  persistent_drag_view_ = nullptr;
+  const PersistentTabDropLocation location = persistent_drag_location_;
+  persistent_drag_location_ = {};
+  const bool drop_into_tabs = std::exchange(persistent_drag_over_tabs_, false);
+  const std::optional<tabs::TabHandle> tab_drop_before =
+      std::exchange(persistent_tab_drop_before_, std::nullopt);
+  const bool is_folder =
+      row_is_folders_.contains(&row) && row_is_folders_.at(&row);
+  if (browser && drop_into_tabs &&
+      location.target == PersistentTabDropTarget::kTab && !is_folder) {
+    space_service_->ConvertPinToTabInSpace(browser, source_space_id, id,
+                                           tab_drop_before);
+  } else if (browser && location.target == PersistentTabDropTarget::kPin) {
+    space_service_->MovePinInSpace(browser, source_space_id, id,
+                                   location.parent_id, location.before_id);
+  }
+  if (TabStripView* tab_strip = GetTabStripView(this)) {
+    tab_strip->GetUnpinnedTabsContainer()->ClearPersistentTabDragPreview();
+    tab_strip->ClearMainTabsDropPreview();
+  }
+  ClearPersistentTabDragPreview();
+  ScheduleReconcilePersistentRows();
+}
+
+void PinTabContainerView::CancelPersistentTreeDrag(views::View& row) {
+  if (persistent_drag_view_ != &row) {
+    return;
+  }
+  if (UseSidebarProjection()) {
+    if (sidebar_drag_transaction_ && sidebar_drag_transaction_->is_active()) {
+      sidebar_drag_transaction_->Cancel();
+    }
+    sidebar_drag_transaction_.reset();
+    sidebar_drop_target_.reset();
+    sidebar_preview_placement_.reset();
+    sidebar_drag_browser_ = nullptr;
+    sidebar_drag_space_id_.clear();
+    sidebar_drag_over_pins_ = false;
+    sidebar_drag_over_tabs_ = false;
+    sidebar_tab_drop_before_.reset();
+    ClearPersistentDragPresentation();
+    persistent_drag_view_ = nullptr;
+    persistent_drag_id_.clear();
+    persistent_drag_location_ = {};
+    if (TabStripView* tab_strip = GetTabStripView(this)) {
+      tab_strip->GetUnpinnedTabsContainer()
+          ->ClearPersistentTabDragPreview();
+      tab_strip->ClearMainTabsDropPreview();
+    }
+    ClearPersistentTabDragPreview();
+    RestoreSidebarProjectionOrder();
+    ScheduleReconcilePersistentRows();
+    return;
+  }
+  persistent_drag_view_ = nullptr;
+  persistent_drag_id_.clear();
+  persistent_drag_space_id_.clear();
+  persistent_drag_location_ = {};
+  persistent_drag_over_tabs_ = false;
+  persistent_tab_drop_before_.reset();
+  if (TabStripView* tab_strip = GetTabStripView(this)) {
+    tab_strip->GetUnpinnedTabsContainer()->ClearPersistentTabDragPreview();
+    tab_strip->ClearMainTabsDropPreview();
+  }
+  ClearPersistentTabDragPreview();
+  ScheduleReconcilePersistentRows();
+}
+
+std::string PinTabContainerView::GetPersistentIdForView(
+    const views::View& view) const {
+  if (const auto known = row_ids_.find(&view); known != row_ids_.end()) {
+    return known->second;
+  }
+  if (const auto* row = views::AsViewClass<PersistentTabView>(&view)) {
+    return row->stable_id();
+  }
+  const auto* tab_view = views::AsViewClass<TabView>(&view);
+  const tabs::TabInterface* tab =
+      tab_view ? std::get<const tabs::TabInterface*>(
+                     tab_view->collection_node()->GetNodeData())
+               : nullptr;
+  const std::optional<std::string> id =
+      space_service_ ? space_service_->GetPersistentItemId(tab) : std::nullopt;
+  return id.value_or(std::string());
+}
+
+PersistentTabDropLocation PinTabContainerView::GetPersistentDropLocationForDrag(
+    const gfx::Point& point_in_screen) const {
+  if (UseSidebarProjection() && sidebar_projection_) {
+    const std::optional<helium::SidebarPinPlacement> placement =
+        helium::ResolveSidebarPinInsertion(
+            *sidebar_projection_, GetSidebarPinDropTarget(point_in_screen));
+    if (!placement) {
+      return {.target = PersistentTabDropTarget::kTab};
+    }
+    return {
+        .target = PersistentTabDropTarget::kPin,
+        .parent_id =
+            placement->parent ? placement->parent->item_id : std::string(),
+        .before_id =
+            placement->before ? placement->before->item_id : std::string(),
+    };
+  }
+  std::string source_id;
+  for (const views::View* child : children()) {
+    if (GetDragHandler().IsViewDragging(*child)) {
+      source_id = GetPersistentIdForView(*child);
+      break;
+    }
+  }
+  return GetPersistentDropLocation(source_id, point_in_screen);
+}
+
+void PinTabContainerView::UpdatePersistentTabDragPreview(
+    const gfx::Point& point_in_screen) {
+  if (UseSidebarProjection()) {
+    const PersistentTabDropLocation location =
+        GetPersistentDropLocationForDrag(point_in_screen);
+    if (location.target != PersistentTabDropTarget::kPin) {
+      ClearPersistentTabDragPreview();
+      return;
+    }
+    UpdatePersistentFolderDropHighlight(location);
+    size_t insertion_index = children().size();
+    if (!location.before_id.empty()) {
+      for (size_t index = 0; index < children().size(); ++index) {
+        const auto id = row_ids_.find(children()[index]);
+        if (id != row_ids_.end() && id->second == location.before_id) {
+          insertion_index = index;
+          break;
+        }
+      }
+    } else if (!location.parent_id.empty()) {
+      for (size_t index = 0; index < children().size(); ++index) {
+        const auto id = row_ids_.find(children()[index]);
+        if (id == row_ids_.end() || id->second != location.parent_id) {
+          continue;
+        }
+        const int parent_depth = row_depths_.at(children()[index]);
+        insertion_index = index + 1;
+        while (insertion_index < children().size() &&
+               row_depths_.contains(children()[insertion_index]) &&
+               row_depths_.at(children()[insertion_index]) > parent_depth) {
+          ++insertion_index;
+        }
+        break;
+      }
+    }
+    if (external_drop_index_ != insertion_index) {
+      external_drop_index_ = insertion_index;
+      InvalidateLayout();
+    }
+    return;
+  }
+  if (!IsHandlingDrag() && !persistent_drag_view_) {
+    return;
+  }
+
+  views::View* dragged_view = persistent_drag_view_;
+  size_t current_index = 0;
+  if (!dragged_view) {
+    for (size_t index = 0; index < children().size(); ++index) {
+      if (GetDragHandler().IsViewDragging(*children()[index])) {
+        dragged_view = children()[index];
+        current_index = index;
+        break;
+      }
+    }
+  } else {
+    current_index = GetIndexOf(dragged_view).value_or(0);
+  }
+  if (!dragged_view) {
+    const PersistentTabDropLocation location =
+        GetPersistentDropLocation({}, point_in_screen);
+    UpdatePersistentFolderDropHighlight(location);
+    size_t insertion_index = children().size();
+    if (!location.before_id.empty()) {
+      for (size_t index = 0; index < children().size(); ++index) {
+        const auto id = row_ids_.find(children()[index]);
+        if (id != row_ids_.end() && id->second == location.before_id) {
+          insertion_index = index;
+          break;
+        }
+      }
+    } else if (!location.parent_id.empty()) {
+      for (size_t index = 0; index < children().size(); ++index) {
+        const auto id = row_ids_.find(children()[index]);
+        if (id == row_ids_.end() || id->second != location.parent_id) {
+          continue;
+        }
+        const int parent_depth = row_depths_.at(children()[index]);
+        insertion_index = index + 1;
+        while (insertion_index < children().size() &&
+               row_depths_.contains(children()[insertion_index]) &&
+               row_depths_.at(children()[insertion_index]) > parent_depth) {
+          ++insertion_index;
+        }
+        break;
+      }
+    }
+    if (external_drop_index_ != insertion_index) {
+      external_drop_index_ = insertion_index;
+      InvalidateLayout();
+    }
+    return;
+  }
+
+  if (external_drop_index_) {
+    external_drop_index_.reset();
+    InvalidateLayout();
+  }
+
+  const auto source_id = row_ids_.find(dragged_view);
+  if (source_id != row_ids_.end()) {
+    const PersistentTabDropLocation location =
+        GetPersistentDropLocation(source_id->second, point_in_screen);
+    UpdatePersistentFolderDropHighlight(location);
+    // Chromium owns live TabViews during a native drag and supplies their
+    // animation. Manual child reordering is reserved for virtual rows, which
+    // have no TabCollectionNode and therefore no native drag presentation.
+    if (!persistent_drag_view_) {
+      return;
+    }
+    size_t insertion_index = children().size();
+    if (!location.before_id.empty()) {
+      for (size_t index = 0; index < children().size(); ++index) {
+        const auto id = row_ids_.find(children()[index]);
+        if (id != row_ids_.end() && id->second == location.before_id) {
+          insertion_index = index;
+          break;
+        }
+      }
+    } else if (!location.parent_id.empty()) {
+      for (size_t index = 0; index < children().size(); ++index) {
+        const auto id = row_ids_.find(children()[index]);
+        if (id == row_ids_.end() || id->second != location.parent_id) {
+          continue;
+        }
+        const int parent_depth = row_depths_.at(children()[index]);
+        insertion_index = index + 1;
+        while (insertion_index < children().size() &&
+               row_depths_.contains(children()[insertion_index]) &&
+               row_depths_.at(children()[insertion_index]) > parent_depth) {
+          ++insertion_index;
+        }
+        break;
+      }
+    }
+
+    const int source_depth = row_depths_.at(dragged_view);
+    size_t block_end = current_index + 1;
+    if (row_is_folders_.at(dragged_view)) {
+      while (block_end < children().size() &&
+             row_depths_.contains(children()[block_end]) &&
+             row_depths_.at(children()[block_end]) > source_depth) {
+        ++block_end;
+      }
+    }
+    if (insertion_index >= current_index && insertion_index <= block_end) {
+      return;
+    }
+    std::vector<views::View*> block(children().begin() + current_index,
+                                    children().begin() + block_end);
+    if (insertion_index > block_end) {
+      insertion_index -= block.size();
+    }
+    int target_depth = 0;
+    if (!location.parent_id.empty()) {
+      for (const auto& [view, id] : row_ids_) {
+        if (id == location.parent_id) {
+          target_depth = row_depths_.at(view) + 1;
+          break;
+        }
+      }
+    }
+    const int depth_delta = target_depth - source_depth;
+    for (size_t offset = 0; offset < block.size(); ++offset) {
+      row_depths_[block[offset]] += depth_delta;
+      ReorderChildView(block[offset], insertion_index + offset);
+    }
+    InvalidateLayout();
+    return;
+  }
+
+  size_t insertion_index = children().size();
+  for (size_t index = 0; index < children().size(); ++index) {
+    const views::View* child = children()[index];
+    if (child == dragged_view || !child->GetVisible()) {
+      continue;
+    }
+    if (point_in_screen.y() < child->GetBoundsInScreen().CenterPoint().y()) {
+      insertion_index = index;
+      break;
+    }
+  }
+  if (insertion_index > current_index) {
+    --insertion_index;
+  }
+  insertion_index = std::min(insertion_index, children().size() - 1);
+  if (insertion_index == current_index) {
+    return;
+  }
+  ReorderChildView(dragged_view, insertion_index);
+  InvalidateLayout();
+}
+
+void PinTabContainerView::OnTabDragPresentationEnded() {
+  if (TabStripView* tab_strip = GetTabStripView(this)) {
+    if (auto* region =
+            views::AsViewClass<BaseTabStripRegionView>(tab_strip->parent())) {
+      region->ClearTabDragBoundaryPresentation();
+    }
+  }
+  ScheduleReconcilePersistentRows();
+}
+
+void PinTabContainerView::ClearPersistentTabDragPreview() {
+  if (auto* folder =
+          views::AsViewClass<PersistentFolderRow>(folder_drop_highlight_)) {
+    folder->SetDropTarget(false);
+  }
+  folder_drop_highlight_ = nullptr;
+  if (external_drop_index_) {
+    external_drop_index_.reset();
+    InvalidateLayout();
+  }
+}
+
+void PinTabContainerView::UpdatePersistentFolderDropHighlight(
+    const PersistentTabDropLocation& location) {
+  views::View* highlighted_folder = nullptr;
+  if (!location.parent_id.empty()) {
+    for (views::View* view : children()) {
+      if (row_ids_.contains(view) && row_ids_.at(view) == location.parent_id &&
+          row_is_folders_.at(view)) {
+        highlighted_folder = view;
+        break;
+      }
+    }
+  }
+  if (folder_drop_highlight_ == highlighted_folder) {
+    return;
+  }
+  ClearPersistentTabDragPreview();
+  folder_drop_highlight_ = highlighted_folder;
+  if (auto* folder =
+          views::AsViewClass<PersistentFolderRow>(highlighted_folder)) {
+    folder->SetDropTarget(true);
+  }
+}
+
+PersistentTabDropLocation PinTabContainerView::GetPersistentDropLocation(
+    std::string_view source_id,
+    const gfx::Point& point_in_screen) const {
+  PersistentTabDropLocation location;
+  location.target = PersistentTabDropTarget::kPin;
+  std::vector<const views::View*> visible;
+  std::optional<int> skipped_subtree_depth;
+  for (const views::View* child : children()) {
+    if (!child->GetVisible() || !row_ids_.contains(child)) {
+      continue;
+    }
+    const int depth = row_depths_.at(child);
+    if (row_ids_.at(child) == source_id) {
+      skipped_subtree_depth = depth;
+      continue;
+    }
+    if (skipped_subtree_depth) {
+      if (depth > *skipped_subtree_depth) {
+        continue;
+      }
+      skipped_subtree_depth.reset();
+    }
+    visible.push_back(child);
+  }
+  for (size_t index = 0; index < visible.size(); ++index) {
+    const views::View* child = visible[index];
+    const gfx::Rect bounds = child->GetBoundsInScreen();
+    if (point_in_screen.y() < bounds.y()) {
+      location.parent_id = row_parent_ids_.at(child);
+      location.before_id = row_ids_.at(child);
+      return location;
+    }
+    if (point_in_screen.y() >= bounds.bottom()) {
+      continue;
+    }
+    const bool folder = row_is_folders_.at(child);
+    const int relative_y = point_in_screen.y() - bounds.y();
+    const bool middle_zone = relative_y >= bounds.height() / 3 &&
+                             relative_y < bounds.height() * 2 / 3;
+    const bool indented_zone =
+        point_in_screen.x() >= bounds.x() + std::max(48, bounds.width() / 3);
+    const bool inside_folder =
+        folder &&
+        (middle_zone || (indented_zone && relative_y >= bounds.height() / 6 &&
+                         relative_y < bounds.height() * 5 / 6));
+    if (inside_folder) {
+      location.parent_id = row_ids_.at(child);
+      return location;
+    }
+    location.parent_id = row_parent_ids_.at(child);
+    if (relative_y < bounds.height() / 2) {
+      location.before_id = row_ids_.at(child);
+      return location;
+    }
+    const int depth = row_depths_.at(child);
+    for (size_t next = index + 1; next < visible.size(); ++next) {
+      if (row_depths_.at(visible[next]) <= depth) {
+        if (row_depths_.at(visible[next]) == depth) {
+          location.before_id = row_ids_.at(visible[next]);
+        }
+        return location;
+      }
+    }
+    return location;
+  }
+  return location;
+}
+
+void PinTabContainerView::ToggleFolder(helium::PersistentRecordKind kind,
+                                       std::string id,
+                                       std::string source_space_id) {
+  if (!collection_node_ || !collection_node_->GetController() ||
+      !space_service_) {
+    return;
+  }
+  BrowserView* browser_view =
+      collection_node_->GetController()->GetBrowserView();
+  if (browser_view && space_service_) {
+    Browser* browser = browser_view->browser();
+    if (UseSidebarProjection() &&
+        space_service_->GetSpaceIdForBrowser(browser) != source_space_id) {
+      return;
+    }
+    space_service_->ToggleFolderCollapsed(browser, kind, id);
+  }
+}
+
+views::ScrollView* PinTabContainerView::GetScrollViewForContainer() const {
+  return GetAncestorScrollView(const_cast<PinTabContainerView*>(this));
+}
+
+void PinTabContainerView::UpdateTargetLayoutForDrag(
+    const std::vector<const views::View*>& views_to_snap) {
+  if (UseSidebarProjection()) {
+    return;
+  }
+  layout_manager_->ResetViewsToTargetLayout(views_to_snap);
+}
+const views::ProposedLayout& PinTabContainerView::GetLayoutForDrag() const {
+  return layout_manager_->target_layout();
+}
+
+DraggedTabsContainer& PinTabContainerView::GetTabDragTarget(
+    const gfx::Point& point_in_screen) {
+  if (UseSidebarProjection()) {
+    // Ordinary tabs remain in Chromium's native drag context until tab-to-Pin
+    // conversion has its own commit transaction.
+    if (TabStripView* tab_strip = GetTabStripView(this)) {
+      if (UnpinnedTabContainerView* ordinary =
+              tab_strip->GetUnpinnedTabsContainer()) {
+        return *ordinary;
+      }
+    }
+  }
+  return *this;
+}
+
+const TabCollectionNode* PinTabContainerView::GetCollectionNodeFromView(
+    const views::View& view) const {
+  if (auto* tab_view = views::AsViewClass<TabView>(&view)) {
+    return tab_view->collection_node();
+  } else if (auto* group_view = views::AsViewClass<TabGroupView>(&view)) {
+    return group_view->collection_node();
+  } else if (auto* split_tab_view = views::AsViewClass<SplitTabView>(&view)) {
+    return split_tab_view->collection_node();
+  }
+  return nullptr;
+}
