+  BrowserWindowInterface* window = BrowserWindowInterface::FromSessionID(
+      SessionID::FromSerializedValue(
+          command.source_context.browser_session_id));
+  Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  tabs::TabInterface* tab =
+      tabs::TabInterface::MaybeGetFromContents(contents.get());
+  if (!browser || !tab || tab->GetBrowserWindowInterface() != window ||
