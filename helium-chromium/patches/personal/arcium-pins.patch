+
+std::unique_ptr<helium::HeliumSidebarPinProjection>
+PinTabContainerView::BuildSidebarProjection(Browser* browser) const {
+  if (!browser || !space_service_) {
+    return nullptr;
+  }
+  const std::string space_id(space_service_->GetSpaceIdForBrowser(browser));
+  helium::HeliumSpace* space = space_service_->GetSpaceById(space_id);
+  if (!space) {
+    return nullptr;
+  }
+
+  helium::HeliumSidebarPinProjection::LiveBindings live_bindings;
+  std::optional<helium::SidebarPinKey> active_item;
+  std::function<void(const helium::PersistentNodes&)> collect_live_bindings;
+  collect_live_bindings = [&](const helium::PersistentNodes& nodes) {
+    for (const helium::PersistentNode& node : nodes) {
+      if (const auto* link = std::get_if<helium::PersistentLink>(&node.data)) {
+        if (tabs::TabInterface* live =
+                space_service_->GetLiveTabForPersistentItem(
+                    browser, helium::PersistentRecordKind::kPin, link->id)) {
+          live_bindings.emplace(link->id, live->GetHandle().raw_value());
+        }
+        if (space_service_->IsPersistentItemActive(
+                browser, helium::PersistentRecordKind::kPin, link->id)) {
+          active_item =
+              helium::SidebarPinKey{.space_id = space_id, .item_id = link->id};
+        }
+      } else {
+        collect_live_bindings(
+            std::get<helium::PersistentFolder>(node.data).children);
+      }
+    }
+  };
+  collect_live_bindings(space->pins());
+
+  auto projection = std::make_unique<helium::HeliumSidebarPinProjection>(
+      space_id, space->pins(), live_bindings, active_item);
+  if (!projection->valid()) {
+    return nullptr;
+  }
+  return projection;
+}
