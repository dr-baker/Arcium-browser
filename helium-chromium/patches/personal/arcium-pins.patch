+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_PERSISTENT_ITEM_MODEL_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_PERSISTENT_ITEM_MODEL_H_
+
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <set>
+#include <string>
+#include <string_view>
+#include <variant>
+#include <vector>
+
+#include "base/values.h"
+#include "url/gurl.h"
+
+namespace helium {
+
+enum class PersistentRecordKind { kFavorite, kPin };
+
+// Live Favorites occupy the native PINNED grid. Live Pins occupy the PIN list.
+enum class PersistentLiveCollection { kPinnedGrid, kPinList };
+
+PersistentLiveCollection LiveCollectionForKind(PersistentRecordKind kind);
+
+// Closing an anchored tab has different product meaning depending on whether
+// a durable home row can represent the item after its live tab disappears.
+enum class PersistentItemCloseAction { kClose, kReturnHome, kKeepOpen };
+
+PersistentItemCloseAction GetPersistentItemCloseAction(bool has_durable_record,
+                                                       bool is_away_from_home);
+
+// Current-tab and plain page-authored link navigations may use an installed
+// optional handler. Explicit new-tab/window actions stay on Chromium's normal
+// navigation path.
+enum class PersistentNavigationDisposition {
+  kCurrentTab,
+  kPageRequestedNewTarget,
+  kExplicitNewTarget
+};
+
+bool ShouldUseOptionalNavigationForAnchoredItem(
+    PersistentNavigationDisposition disposition,
+    bool is_link_transition,
+    bool is_anchored_live_item,
+    const GURL& home_url,
+    const GURL& target_url);
+
+// Compact Favorite grid children: displayed slots stay in model order at the
+// front, then hidden home tiles for live replacements, also in model order.
+enum class PersistentGridChildKind { kLiveTab, kHomeTile };
+
+struct PersistentGridSlot {
+  std::string id;
+  bool live = false;
+  bool operator==(const PersistentGridSlot&) const = default;
+};
+
+struct PersistentGridChild {
+  std::string id;
+  PersistentGridChildKind kind = PersistentGridChildKind::kHomeTile;
+  bool operator==(const PersistentGridChild&) const = default;
+};
+
+std::vector<PersistentGridChild> PackPersistentGridChildren(
+    const std::vector<PersistentGridSlot>& slots);
+
+struct PersistentLink {
+  std::string id;
+  std::u16string title;
+  GURL url;
+  bool operator==(const PersistentLink&) const = default;
+};
+
+struct PersistentNode;
+
+struct PersistentFolder {
+  std::string id;
+  std::u16string title;
+  bool collapsed = false;
+  std::vector<PersistentNode> children;
+  bool operator==(const PersistentFolder&) const = default;
+};
+
+struct PersistentNode {
+  std::variant<PersistentLink, PersistentFolder> data;
+  bool operator==(const PersistentNode&) const = default;
+};
+
+using PersistentNodes = std::vector<PersistentNode>;
+
+class PersistentItemCodec {
+ public:
+  static base::ListValue Encode(const PersistentNodes& nodes);
+  static std::optional<PersistentNodes> Decode(const base::ListValue& values,
+                                               bool allow_folders);
+  static const PersistentLink* FindLink(const PersistentNodes& nodes,
+                                        std::string_view id);
+  static PersistentLink* FindLink(PersistentNodes& nodes, std::string_view id);
+  static const PersistentFolder* FindFolder(const PersistentNodes& nodes,
+                                            std::string_view id);
+  static PersistentFolder* FindFolder(PersistentNodes& nodes,
+                                      std::string_view id);
+  static bool UpdateLinkHome(PersistentNodes& nodes,
+                             std::string_view id,
+                             GURL url,
+                             std::u16string title);
+  static bool RemoveNode(PersistentNodes& nodes, std::string_view id);
+  // Moves a link or folder to a tree position. An empty parent is the root;
+  // an empty before-id appends to that parent. Folder cycles and before-ids
+  // outside the selected parent are rejected.
+  static bool MoveNode(PersistentNodes& nodes,
+                       std::string_view id,
+                       std::string_view parent_id,
+                       std::string_view before_id);
+};
+
+// Pure lifecycle state. Opaque tokens keep durable records independent from
+// TabInterface and WebContents lifetime.
+class PersistentItemLifecycle {
+ public:
+  using LiveTabToken = uint64_t;
+  enum class State { kDormant, kMaterializing, kLive, kClosing };
+  enum class ActivationAction {
+    kUnknownItem,
+    kMaterialize,
+    kActivateExisting,
+    kWaitForTransition
+  };
+  struct ActivationDecision {
+    ActivationAction action = ActivationAction::kUnknownItem;
+    std::optional<LiveTabToken> live_tab;
+    bool operator==(const ActivationDecision&) const = default;
+  };
+
+  bool AddDormant(std::string id);
+  bool Forget(std::string_view id);
+  // Replaces one durable identity without changing its lifecycle state or
+  // live-tab token. The destination must not already exist.
+  bool Rekey(std::string_view old_id, std::string new_id);
+  void RetainOnly(const std::set<std::string>& ids);
+  ActivationDecision BeginActivation(std::string_view id);
+  bool DidMaterialize(std::string_view id, LiveTabToken live_tab);
+  bool CancelMaterialization(std::string_view id);
+  bool RestoreLive(std::string_view id, LiveTabToken live_tab);
+  std::optional<std::string> BeginClose(LiveTabToken live_tab);
+  // A requested close can be vetoed by before-unload. Preserve the live-tab
+  // association while returning that in-flight close to its live state.
+  bool CancelClose(LiveTabToken live_tab);
+  bool CompleteClose(LiveTabToken live_tab);
+  std::optional<State> GetState(std::string_view id) const;
+  std::optional<LiveTabToken> GetLiveTab(std::string_view id) const;
+  std::optional<std::string_view> GetItemForLiveTab(
+      LiveTabToken live_tab) const;
+
+ private:
+  struct Entry {
+    State state = State::kDormant;
+    std::optional<LiveTabToken> live_tab;
+  };
+  std::map<std::string, Entry, std::less<>> entries_;
+  std::map<LiveTabToken, std::string> items_by_live_tab_;
+};
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_PERSISTENT_ITEM_MODEL_H_
