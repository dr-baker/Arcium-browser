+          std::make_unique<views::DelegatingLayoutManager>(this),
+          /*delegate=*/*this,
+          /*animation_axis=*/
+          TabCollectionAnimatingLayoutManager::AnimationAxis::kVertical,
+          /*animate_host_size=*/true));
+  SetEventTargeter(std::make_unique<views::ViewTargeter>(
+      std::make_unique<PinTabContainerViewTargeter>(this)));
+
+  collection_node->set_remove_child_from_node(base::BindRepeating(
+      &PinTabContainerView::RemoveCollectionChild, base::Unretained(this)));
+  collection_node->set_attach_child_to_node(base::BindRepeating(
+      &PinTabContainerView::AttachCollectionChild, base::Unretained(this)));
+
+  node_destroyed_subscription_ =
+      collection_node_->RegisterWillDestroyCallback(base::BindOnce(
+          &PinTabContainerView::ResetCollectionNode, base::Unretained(this)));
+
+  if (BrowserView* browser_view =
+          collection_node_->GetController()->GetBrowserView()) {
+    if (UseSidebarProjection()) {
+      observed_tab_strip_model_ = browser_view->browser()->tab_strip_model();
+      observed_tab_strip_model_->AddObserver(this);
+    }
+    space_service_ = helium::HeliumSpaceServiceFactory::GetForProfile(
+        browser_view->GetProfile());
+    if (space_service_) {
+      items_changed_subscription_ =
+          space_service_->RegisterItemsChanged(base::BindRepeating(
+              &PinTabContainerView::OnPersistentItemsChanged,
+              base::Unretained(this)));
+      ReconcilePersistentRows();
+    }
+  }
+
+  if (auto* controller = collection_node_->GetController()) {
+    if (auto* state_controller = controller->GetStateController()) {
+      collapse_state_subscription_ =
+          state_controller->RegisterOnCollapseChanged(
+              base::BindRepeating(&PinTabContainerView::OnCollapseStateChanged,
+                                  base::Unretained(this)));
+    }
+  }
