+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_SIDEBAR_NATIVE_TAB_DRAG_SESSION_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_SIDEBAR_NATIVE_TAB_DRAG_SESSION_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+
+#include "chrome/browser/ui/helium/helium_sidebar_drag_transaction.h"
+
+namespace helium {
+
+// A concrete browser and Space identity captured before Chromium starts moving
+// any tab or view. SessionID values are process-session identities, while the
+// Space id is durable profile data.
+struct SidebarNativeTabContext {
+  int32_t browser_session_id = 0;
+  std::string space_id;
+
+  bool valid() const { return browser_session_id > 0 && !space_id.empty(); }
+  bool operator==(const SidebarNativeTabContext&) const = default;
+};
+
+struct SidebarNativeTabPinIntent {
+  SidebarNativeTabContext context;
+  SidebarItemPlacement placement;
+
+  bool operator==(const SidebarNativeTabPinIntent&) const = default;
+};
+
+struct SidebarNativeTabPinCommand {
+  SidebarNativeTabContext source_context;
+  SidebarItemPlacement placement;
+
+  bool operator==(const SidebarNativeTabPinCommand&) const = default;
+};
+
+// Owns the value-only Pin intent for one ordinary native-tab drag. Chromium
+// continues to own and animate the TabView in its ordinary tab container.
+class SidebarNativeTabDragSession {
+ public:
+  SidebarNativeTabDragSession(SidebarNativeTabContext source_context,
+                              bool source_is_single_eligible_tab);
+  ~SidebarNativeTabDragSession();
+
+  SidebarNativeTabDragSession(const SidebarNativeTabDragSession&) = delete;
+  SidebarNativeTabDragSession& operator=(const SidebarNativeTabDragSession&) =
+      delete;
+
+  bool UpdatePinIntent(SidebarNativeTabPinIntent intent);
+  void ClearIntent();
+  void Invalidate();
+
+  std::optional<SidebarNativeTabPinCommand> Complete(
+      bool successful_drop,
+      const SidebarNativeTabContext& final_context,
+      bool source_is_still_single_eligible_tab);
+
+  bool active() const { return active_; }
+  bool has_intent() const { return intent_.has_value(); }
+  bool invalidated() const { return invalidated_; }
+  bool accepts_intent() const {
+    return active_ && !invalidated_ && source_was_single_eligible_tab_ &&
+           source_context_.valid();
+  }
+  const SidebarNativeTabContext& source_context() const {
+    return source_context_;
+  }
+
+ private:
+  const SidebarNativeTabContext source_context_;
+  const bool source_was_single_eligible_tab_;
+  std::optional<SidebarNativeTabPinIntent> intent_;
+  bool active_ = true;
+  bool invalidated_ = false;
+};
+
+// An eligible sidebar conversion must begin as a native tab drag even when it
+// is the only tab in the window. The pointer cannot express a Pin destination
+// until after Chromium's initial drag threshold has been crossed. If it later
+// leaves the sidebar, the native drag path still promotes it to a whole-window
+// drag.
+bool ShouldStartWholeWindowDragImmediately(
+    bool is_dragging_every_tab,
+    const SidebarNativeTabDragSession* sidebar_session);
+
+}  // namespace helium
