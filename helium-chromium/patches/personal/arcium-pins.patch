+  EXPECT_EQ(Key("top"), projection.rows()[0].key);
+  EXPECT_EQ(Key("outer"), projection.rows()[1].key);
+  EXPECT_EQ(SidebarPinRowKind::kFolder, projection.rows()[1].kind);
+  EXPECT_EQ(0u, projection.rows()[1].depth);
+  EXPECT_EQ(Key("first"), projection.rows()[2].key);
+  EXPECT_EQ(1u, projection.rows()[2].depth);
+  EXPECT_EQ(std::optional(Key("outer")), projection.rows()[2].parent);
+  EXPECT_EQ(Key("inner"), projection.rows()[3].key);
+  EXPECT_EQ(Key("deep"), projection.rows()[4].key);
+  EXPECT_EQ(2u, projection.rows()[4].depth);
+  EXPECT_EQ(std::optional(Key("inner")), projection.rows()[4].parent);
+  EXPECT_EQ(Key("last"), projection.rows()[5].key);
+  EXPECT_EQ(Key("tail"), projection.rows()[6].key);
+}
