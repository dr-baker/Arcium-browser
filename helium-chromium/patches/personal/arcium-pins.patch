+TEST_P(SavedSourceSplitTest, RestoreRebuildsAffinityAndTransientCleanup) {
+  auto* original_source = AddSavedSource();
+  const auto original_state = CaptureSavedSource(original_source);
+  std::map<std::string, std::string> extra_data;
