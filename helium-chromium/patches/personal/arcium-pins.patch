+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_sidebar_pin_projection.h"
+
+#include <algorithm>
+#include <functional>
+#include <utility>
+
+#include "base/strings/utf_string_conversions.h"
+
+namespace helium {
+namespace {
+
+std::string_view NodeId(const PersistentNode& node) {
+  if (const auto* link = std::get_if<PersistentLink>(&node.data)) {
+    return link->id;
+  }
+  return std::get<PersistentFolder>(node.data).id;
+}
+
+SidebarPinKey MakeKey(std::string_view space_id, std::string_view item_id) {
+  return {.space_id = std::string(space_id), .item_id = std::string(item_id)};
+}
+
+SidebarPinMoveIntent MakeIntent(SidebarPinMoveIntent::Result result,
+                                const SidebarPinKey& source) {
+  return {.result = result, .source = source};
+}
+
+std::u16string LinkTitle(const PersistentLink& link) {
+  return link.title.empty() ? base::UTF8ToUTF16(link.url.host()) : link.title;
+}
+
+bool HasActiveDescendant(const PersistentNode& node,
+                         const std::optional<std::string>& active_item_id) {
+  if (const auto* link = std::get_if<PersistentLink>(&node.data)) {
+    return active_item_id && link->id == *active_item_id;
+  }
+  for (const PersistentNode& child :
+       std::get<PersistentFolder>(node.data).children) {
+    if (HasActiveDescendant(child, active_item_id)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+HeliumSidebarPinProjection::HeliumSidebarPinProjection(
+    std::string space_id,
+    const PersistentNodes& pins,
+    const LiveBindings& live_bindings,
+    std::optional<SidebarPinKey> active_item)
+    : space_id_(std::move(space_id)) {
+  if (space_id_.empty()) {
+    valid_ = false;
+    return;
+  }
+  if (active_item) {
+    if (active_item->space_id != space_id_ || active_item->item_id.empty()) {
+      valid_ = false;
+      return;
+    }
+    active_item_id_ = std::move(active_item->item_id);
+  }
+  root_ids_.reserve(pins.size());
+  for (const PersistentNode& node : pins) {
+    root_ids_.emplace_back(NodeId(node));
+  }
+  AppendNodes(pins, std::nullopt, 0, false, live_bindings);
+  if (valid_ && active_item_id_) {
+    const auto active = nodes_.find(*active_item_id_);
+    valid_ = active != nodes_.end() &&
+             active->second.kind == SidebarPinRowKind::kPin;
+  }
+  if (!valid_) {
+    rows_.clear();
+    nodes_.clear();
+    root_ids_.clear();
+  }
+}
+
+HeliumSidebarPinProjection::HeliumSidebarPinProjection(
+    const HeliumSidebarPinProjection&) = default;
+HeliumSidebarPinProjection& HeliumSidebarPinProjection::operator=(
+    const HeliumSidebarPinProjection&) = default;
+HeliumSidebarPinProjection::~HeliumSidebarPinProjection() = default;
+
+const SidebarPinRow* HeliumSidebarPinProjection::FindVisibleRow(
+    const SidebarPinKey& key) const {
+  if (!valid_ || key.space_id != space_id_) {
+    return nullptr;
+  }
+  const auto row = std::ranges::find(rows_, key, &SidebarPinRow::key);
+  return row == rows_.end() ? nullptr : &*row;
+}
+
+std::optional<SidebarPinPlacement>
+HeliumSidebarPinProjection::GetDurablePlacement(
+    const SidebarPinKey& key) const {
+  const NodeMetadata* node = FindNode(key);
+  if (!node) {
+    return std::nullopt;
+  }
+
+  const std::vector<std::string>* siblings = nullptr;
+  SidebarPinPlacement placement;
+  if (node->parent_id) {
+    const auto parent = nodes_.find(*node->parent_id);
+    if (parent == nodes_.end() ||
+        parent->second.kind != SidebarPinRowKind::kFolder) {
+      return std::nullopt;
+    }
+    siblings = &parent->second.child_ids;
+    placement.parent = MakeKey(space_id_, *node->parent_id);
+  } else {
+    siblings = &root_ids_;
+  }
+  if (node->sibling_index >= siblings->size() ||
+      (*siblings)[node->sibling_index] != key.item_id) {
+    return std::nullopt;
+  }
+  if (node->sibling_index + 1 < siblings->size()) {
+    placement.before = MakeKey(space_id_, (*siblings)[node->sibling_index + 1]);
+  }
+  return placement;
+}
+
+void HeliumSidebarPinProjection::AppendNodes(
+    const PersistentNodes& nodes,
+    std::optional<std::string_view> parent_id,
+    size_t depth,
+    bool only_active,
+    const LiveBindings& live_bindings) {
+  if (!valid_) {
+    return;
+  }
+  if (parent_id) {
+    const auto parent = nodes_.find(*parent_id);
+    if (parent == nodes_.end() ||
+        parent->second.kind != SidebarPinRowKind::kFolder) {
+      valid_ = false;
+      return;
+    }
+  }
+  for (size_t index = 0; index < nodes.size(); ++index) {
+    const PersistentNode& node = nodes[index];
+    const std::string id(NodeId(node));
+    if (id.empty() || nodes_.contains(id)) {
+      valid_ = false;
+      return;
+    }
+    const auto* folder = std::get_if<PersistentFolder>(&node.data);
+    const auto* link = std::get_if<PersistentLink>(&node.data);
+    const auto binding = live_bindings.find(id);
+    const bool selected = active_item_id_ && id == *active_item_id_;
+
+    NodeMetadata metadata{
+        .kind = folder ? SidebarPinRowKind::kFolder : SidebarPinRowKind::kPin,
+        .parent_id =
+            parent_id ? std::optional<std::string>(*parent_id) : std::nullopt,
+        .sibling_index = index,
+        .collapsed = folder && folder->collapsed,
+        .selected = selected,
+        .live_tab_handle = !folder && binding != live_bindings.end()
+                               ? std::optional<int32_t>(binding->second)
+                               : std::nullopt,
+        .title = folder ? folder->title : LinkTitle(*link),
+        .url = link ? link->url : GURL(),
+    };
+    if (folder) {
+      metadata.child_ids.reserve(folder->children.size());
+      for (const PersistentNode& child : folder->children) {
+        metadata.child_ids.emplace_back(NodeId(child));
+      }
+    }
+    nodes_.emplace(id, std::move(metadata));
+
+    if (!only_active || HasActiveDescendant(node, active_item_id_)) {
+      SidebarPinRow row{
+          .key = MakeKey(space_id_, id),
+          .kind = folder ? SidebarPinRowKind::kFolder : SidebarPinRowKind::kPin,
+          .depth = depth,
+          .parent = parent_id ? std::optional<SidebarPinKey>(
+                                    MakeKey(space_id_, *parent_id))
+                              : std::nullopt,
+          .collapsed = folder && folder->collapsed,
+          .selected = selected,
+          .title = folder ? folder->title : LinkTitle(*link),
+          .url = link ? link->url : GURL(),
+      };
+      row.live_tab_handle = !folder && binding != live_bindings.end()
+                                ? std::optional<int32_t>(binding->second)
+                                : std::nullopt;
+      rows_.push_back(std::move(row));
+    }
+
+    if (folder) {
+      AppendNodes(folder->children, id, depth + 1,
+                  only_active || folder->collapsed, live_bindings);
+      if (!valid_) {
+        return;
+      }
+    }
+  }
+}
+
+const HeliumSidebarPinProjection::NodeMetadata*
+HeliumSidebarPinProjection::FindNode(const SidebarPinKey& key) const {
+  if (!valid_ || key.space_id != space_id_) {
+    return nullptr;
+  }
+  const auto found = nodes_.find(key.item_id);
+  return found == nodes_.end() ? nullptr : &found->second;
+}
+
+SidebarPinMoveIntent ResolveSidebarPinDrop(
+    const HeliumSidebarPinProjection& projection,
+    const SidebarPinKey& source,
+    const std::optional<SidebarPinDropTarget>& target) {
+  if (!projection.valid_) {
+    return MakeIntent(SidebarPinMoveIntent::Result::kInvalid, source);
+  }
+  if (!target) {
+    return MakeIntent(SidebarPinMoveIntent::Result::kCancel, source);
+  }
+  const HeliumSidebarPinProjection::NodeMetadata* source_node =
+      projection.FindNode(source);
+  if (!source_node || !projection.FindVisibleRow(source)) {
+    return MakeIntent(SidebarPinMoveIntent::Result::kInvalid, source);
+  }
+
+  const HeliumSidebarPinProjection::NodeMetadata* target_node =
+      projection.FindNode(target->key);
+  if (!target_node || !projection.FindVisibleRow(target->key)) {
+    return MakeIntent(SidebarPinMoveIntent::Result::kInvalid, source);
+  }
+  if (target->position == SidebarPinDropPosition::kInside &&
+      target_node->kind != SidebarPinRowKind::kFolder) {
+    return MakeIntent(SidebarPinMoveIntent::Result::kInvalid, source);
+  }
+
+  std::optional<std::string> destination_parent_id;
+  size_t insertion_index = 0;
+  const std::vector<std::string>* destination_siblings = nullptr;
+  if (target->position == SidebarPinDropPosition::kInside) {
+    destination_parent_id = target->key.item_id;
+    destination_siblings = &target_node->child_ids;
+    insertion_index = destination_siblings->size();
+  } else {
+    destination_parent_id = target_node->parent_id;
+    if (destination_parent_id) {
+      const auto parent = projection.nodes_.find(*destination_parent_id);
+      if (parent == projection.nodes_.end() ||
+          parent->second.kind != SidebarPinRowKind::kFolder) {
+        return MakeIntent(SidebarPinMoveIntent::Result::kInvalid, source);
+      }
+      destination_siblings = &parent->second.child_ids;
+    } else {
+      destination_siblings = &projection.root_ids_;
+    }
+    insertion_index = target_node->sibling_index;
+    if (target->position == SidebarPinDropPosition::kAfter) {
+      ++insertion_index;
+    }
+  }
+
+  // A folder cannot be made a child of itself or any node in its subtree.
+  for (std::optional<std::string> ancestor = destination_parent_id; ancestor;) {
+    if (*ancestor == source.item_id) {
+      return MakeIntent(SidebarPinMoveIntent::Result::kInvalid, source);
+    }
+    const auto ancestor_node = projection.nodes_.find(*ancestor);
+    if (ancestor_node == projection.nodes_.end() ||
+        ancestor_node->second.kind != SidebarPinRowKind::kFolder) {
+      return MakeIntent(SidebarPinMoveIntent::Result::kInvalid, source);
+    }
+    ancestor = ancestor_node->second.parent_id;
+  }
+
+  const bool same_parent = source_node->parent_id == destination_parent_id;
+  if (same_parent && source_node->sibling_index < insertion_index) {
+    --insertion_index;
+  }
+  if (same_parent && insertion_index == source_node->sibling_index) {
+    return MakeIntent(SidebarPinMoveIntent::Result::kNoOp, source);
+  }
+
+  std::vector<std::string> siblings_without_source;
+  siblings_without_source.reserve(destination_siblings->size());
+  for (const std::string& id : *destination_siblings) {
+    if (id != source.item_id) {
+      siblings_without_source.push_back(id);
+    }
+  }
+  if (insertion_index > siblings_without_source.size()) {
+    return MakeIntent(SidebarPinMoveIntent::Result::kInvalid, source);
+  }
+
+  SidebarPinMoveIntent intent =
+      MakeIntent(SidebarPinMoveIntent::Result::kMove, source);
+  if (destination_parent_id) {
+    intent.parent = MakeKey(projection.space_id_, *destination_parent_id);
+  }
+  if (insertion_index < siblings_without_source.size()) {
+    intent.before =
+        MakeKey(projection.space_id_, siblings_without_source[insertion_index]);
+  }
+  return intent;
+}
+
+std::optional<SidebarPinPlacement> ResolveSidebarPinInsertion(
+    const HeliumSidebarPinProjection& projection,
+    const std::optional<SidebarPinDropTarget>& target) {
+  if (!projection.valid()) {
+    return std::nullopt;
+  }
+  if (!target) {
+    return SidebarPinPlacement{};
+  }
+  const SidebarPinRow* target_row = projection.FindVisibleRow(target->key);
+  if (!target_row) {
+    return std::nullopt;
+  }
+  if (target->position == SidebarPinDropPosition::kInside) {
+    if (target_row->kind != SidebarPinRowKind::kFolder) {
+      return std::nullopt;
+    }
+    return SidebarPinPlacement{.parent = target->key};
+  }
+
+  std::optional<SidebarPinPlacement> target_placement =
+      projection.GetDurablePlacement(target->key);
+  if (!target_placement) {
+    return std::nullopt;
+  }
+  if (target->position == SidebarPinDropPosition::kBefore) {
+    target_placement->before = target->key;
+  }
+  return target_placement;
+}
+
+std::optional<std::vector<SidebarPinRow>> PreviewSidebarPinMove(
+    const HeliumSidebarPinProjection& projection,
+    const SidebarPinMoveIntent& intent) {
+  if (!projection.valid_ ||
+      (intent.result != SidebarPinMoveIntent::Result::kMove &&
+       intent.result != SidebarPinMoveIntent::Result::kNoOp)) {
+    return std::nullopt;
+  }
+  const HeliumSidebarPinProjection::NodeMetadata* source_node =
+      projection.FindNode(intent.source);
+  if (!source_node || !projection.FindVisibleRow(intent.source)) {
+    return std::nullopt;
+  }
+  if (intent.result == SidebarPinMoveIntent::Result::kNoOp) {
+    if (intent.parent || intent.before) {
+      return std::nullopt;
+    }
+    return projection.rows_;
+  }
+
+  if ((intent.parent && intent.parent->space_id != projection.space_id_) ||
+      (intent.before && intent.before->space_id != projection.space_id_)) {
+    return std::nullopt;
+  }
+
+  const std::optional<std::string> destination_parent_id =
+      intent.parent ? std::optional<std::string>(intent.parent->item_id)
+                    : std::nullopt;
+  if (destination_parent_id) {
+    const auto parent = projection.nodes_.find(*destination_parent_id);
+    if (parent == projection.nodes_.end() ||
+        parent->second.kind != SidebarPinRowKind::kFolder) {
+      return std::nullopt;
+    }
+  }
+  for (std::optional<std::string> ancestor = destination_parent_id; ancestor;) {
+    if (*ancestor == intent.source.item_id) {
+      return std::nullopt;
+    }
+    const auto ancestor_node = projection.nodes_.find(*ancestor);
+    if (ancestor_node == projection.nodes_.end() ||
+        ancestor_node->second.kind != SidebarPinRowKind::kFolder) {
+      return std::nullopt;
+    }
+    ancestor = ancestor_node->second.parent_id;
+  }
+
+  std::map<std::string, std::vector<std::string>, std::less<>> children;
+  children.emplace("", projection.root_ids_);
+  for (const auto& [id, node] : projection.nodes_) {
+    if (node.kind == SidebarPinRowKind::kFolder) {
+      children.emplace(id, node.child_ids);
+    }
+  }
+
+  const std::string source_parent_id =
+      source_node->parent_id.value_or(std::string());
+  auto source_siblings = children.find(source_parent_id);
+  if (source_siblings == children.end()) {
+    return std::nullopt;
+  }
+  const auto source_position =
+      std::ranges::find(source_siblings->second, intent.source.item_id);
+  if (source_position == source_siblings->second.end()) {
+    return std::nullopt;
+  }
+  source_siblings->second.erase(source_position);
+
+  auto destination_siblings =
+      children.find(destination_parent_id.value_or(std::string()));
+  if (destination_siblings == children.end()) {
+    return std::nullopt;
+  }
+  auto insertion_position = destination_siblings->second.end();
+  if (intent.before) {
+    if (intent.before->item_id == intent.source.item_id) {
+      return std::nullopt;
+    }
+    insertion_position =
+        std::ranges::find(destination_siblings->second, intent.before->item_id);
+    if (insertion_position == destination_siblings->second.end()) {
+      return std::nullopt;
+    }
+  }
+  destination_siblings->second.insert(insertion_position,
+                                      intent.source.item_id);
+
+  bool preview_valid = true;
+  std::function<bool(std::string_view)> has_active_descendant =
+      [&](std::string_view id) {
+        const auto node = projection.nodes_.find(id);
+        if (node == projection.nodes_.end()) {
+          preview_valid = false;
+          return false;
+        }
+        if (node->second.kind == SidebarPinRowKind::kPin) {
+          return projection.active_item_id_ &&
+                 id == *projection.active_item_id_;
+        }
+        const auto child_ids = children.find(id);
+        if (child_ids == children.end()) {
+          preview_valid = false;
+          return false;
+        }
+        for (const std::string& child_id : child_ids->second) {
+          if (has_active_descendant(child_id)) {
+            return true;
+          }
+        }
+        return false;
+      };
+
+  std::vector<SidebarPinRow> preview_rows;
+  std::function<void(std::string_view, size_t, bool)> append_rows =
+      [&](std::string_view parent_id, size_t depth, bool only_active) {
+        const auto siblings = children.find(parent_id);
+        if (siblings == children.end()) {
+          preview_valid = false;
+          return;
+        }
+        for (const std::string& id : siblings->second) {
+          const auto node = projection.nodes_.find(id);
+          if (node == projection.nodes_.end()) {
+            preview_valid = false;
+            return;
+          }
+          if (only_active && !has_active_descendant(id)) {
+            continue;
+          }
+          preview_rows.push_back(SidebarPinRow{
+              .key = MakeKey(projection.space_id_, id),
+              .kind = node->second.kind,
+              .depth = depth,
+              .parent = parent_id.empty()
+                            ? std::nullopt
+                            : std::optional<SidebarPinKey>(
+                                  MakeKey(projection.space_id_, parent_id)),
+              .collapsed = node->second.collapsed,
+              .selected = node->second.selected,
+              .live_tab_handle = node->second.live_tab_handle,
+              .title = node->second.title,
+              .url = node->second.url,
+          });
+          if (node->second.kind == SidebarPinRowKind::kFolder) {
+            append_rows(id, depth + 1, only_active || node->second.collapsed);
+            if (!preview_valid) {
+              return;
+            }
+          }
+        }
+      };
+  append_rows("", 0, false);
+  if (!preview_valid) {
+    return std::nullopt;
+  }
+  return preview_rows;
+}
+
+}  // namespace helium
