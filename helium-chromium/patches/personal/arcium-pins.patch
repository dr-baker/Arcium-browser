+  source->GetContents()->SetUserData(&kUnsavedPageStateKey,
+                                     std::make_unique<UnsavedPageState>());
+  const auto restored_state = CaptureSavedSource(source);
+  auto* companion = AddOrdinaryTab("https://destination.test/copy");
+  auto* companion_contents = companion->GetContents();
+  const auto id = split_tabs::SplitTabId::GenerateNew();
+  std::vector<int> indices = {model()->GetIndexOfTab(companion),
+                              model()->GetIndexOfTab(source)};
+  std::ranges::sort(indices);
+  const split_tabs::SplitTabVisualData visuals(
+      split_tabs::SplitTabLayout::kStacked, 0.4);
+  model()->RestoreSplit(id, indices, visuals);
+  ASSERT_TRUE(model()->ContainsSplit(id));
+  EXPECT_EQ(visuals, *model()->GetSplitData(id)->visual_data());
+  ExpectSavedSource(restored_state);
+  EXPECT_EQ(original_state.link, restored_state.link);
+  model()->RemoveSplit(id);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(companion_contents, companion->GetContents());
+  ExpectOrdinary(companion);
+  ExpectSavedSource(restored_state);
+}
+
+TEST_P(SavedSourceSplitTest, SavedContextSplitAllowsSelfAndOrdinaryTarget) {
+  auto* source = AddSavedSource();
+  EXPECT_TRUE(model()->IsContextMenuCommandEnabled(
+      model()->GetIndexOfTab(source), TabStripModel::CommandAddToSplit));
+  auto* companion = AddOrdinaryTab("https://destination.test/copy");
+  model()->ActivateTabAt(model()->GetIndexOfTab(source));
+  EXPECT_TRUE(model()->IsContextMenuCommandEnabled(
+      model()->GetIndexOfTab(companion), TabStripModel::CommandAddToSplit));
+}
+
+TEST_P(SavedSourceSplitTest, DifferentSavedParentsAreRejectedAtomically) {
+  auto* source = AddSavedSource();
+  const auto source_state = CaptureSavedSource(source);
+  auto* target = AddSavedTargetInDifferentParent();
+  const auto target_state = CaptureSavedSource(target);
+  model()->ActivateTabAt(model()->GetIndexOfTab(source));
+  const int count = model()->count();
+  EXPECT_FALSE(model()->IsContextMenuCommandEnabled(
+      model()->GetIndexOfTab(target), TabStripModel::CommandAddToSplit));
+  const auto rejected_id = model()->AddToNewSplit(
+      {model()->GetIndexOfTab(target)}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kToolbarButton);
+  EXPECT_FALSE(model()->ContainsSplit(rejected_id));
+  EXPECT_EQ(count, model()->count());
+  EXPECT_EQ(source, model()->GetActiveTab());
+  ExpectSavedSource(source_state);
+  ExpectSavedSource(target_state);
+
+  tabs::TabInterface* companion;
+  const auto id = SplitWithCopy(source, &companion);
+  ASSERT_TRUE(model()->ContainsSplit(id));
+  const int split_count = model()->count();
+  model()->UpdateTabInSplit(companion, model()->GetIndexOfTab(target),
+                            TabStripModel::SplitUpdateType::kReplace);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(split_count, model()->count());
+  EXPECT_EQ(id, source->GetSplit());
+  EXPECT_EQ(id, companion->GetSplit());
+  EXPECT_FALSE(target->IsSplit());
+  ExpectSavedSource(source_state);
+  ExpectSavedSource(target_state);
+}
+
+TEST_P(SavedSourceSplitTest,
+       IncomingSplitMemberIsRejectedWithoutChangingSource) {
+  auto* source = AddSavedSource();
+  const auto state = CaptureSavedSource(source);
+  tabs::TabInterface* companion;
+  const auto id = SplitWithCopy(source, &companion);
+  ASSERT_TRUE(model()->ContainsSplit(id));
+  auto* other_a = AddOrdinaryTab("https://other-a.test/");
+  auto* other_b = AddOrdinaryTab("https://other-b.test/");
+  const auto other_id = model()->AddToNewSplit(
+      {model()->GetIndexOfTab(other_a)}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kToolbarButton);
+  ASSERT_EQ(other_id, other_b->GetSplit());
+  model()->ActivateTabAt(model()->GetIndexOfTab(source));
+  model()->UpdateTabInSplit(companion, model()->GetIndexOfTab(other_a),
+                            TabStripModel::SplitUpdateType::kReplace);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(id, source->GetSplit());
+  EXPECT_EQ(id, companion->GetSplit());
+  EXPECT_EQ(other_id, other_a->GetSplit());
+  EXPECT_EQ(other_id, other_b->GetSplit());
+  ExpectSavedSource(state);
+}
+
+INSTANTIATE_TEST_SUITE_P(
+    SavedSourceKinds,
+    SavedSourceSplitTest,
+    testing::Values(SavedSourceKind::kRootPin,
+                    SavedSourceKind::kFolderPin,
+                    SavedSourceKind::kFavorite),
+    [](const testing::TestParamInfo<SavedSourceKind>& info) {
+      if (info.param == SavedSourceKind::kRootPin) {
+        return "RootPin";
+      }
+      return info.param == SavedSourceKind::kFolderPin ? "FolderPin"
+                                                       : "Favorite";
+    });
+
+}  // namespace
+}  // namespace helium
