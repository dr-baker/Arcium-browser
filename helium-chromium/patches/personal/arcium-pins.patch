+  ASSERT_TRUE(before_tab);
+  tabs::TabCollection* original_parent =
+      const_cast<tabs::TabCollection*>(pin_tab->GetParentCollection());
+  ASSERT_TRUE(original_parent);
+  const std::optional<size_t> original_index =
+      original_parent->GetIndexOfTab(pin_tab);
+  ASSERT_TRUE(original_index);
+  const PersistentNodes original_pins = space_->pins();
+  const base::ListValue original_pref =
+      profile()->GetPrefs()->GetList(kHeliumSpacesPref).Clone();
+
+  service_->SetPinToTabConversionHookForTesting(
+      base::BindLambdaForTesting([&](PinToTabConversionPhaseForTesting phase) {
+        if (phase != PinToTabConversionPhaseForTesting::kAfterPlacement) {
+          return;
+        }
+        TabStripModel* model = browser()->tab_strip_model();
+        const int source = model->GetIndexOfTab(pin_tab);
+        ASSERT_NE(TabStripModel::kNoTab, source);
+        model->MoveWebContentsAt(source, model->count() - 1,
+                                 /*select_after_move=*/false,
+                                 /*group=*/std::nullopt);
+      }));
+
+  EXPECT_FALSE(service_->ConvertPinToTabInSpace(browser(), space_->id(), id,
+                                                before_tab->GetHandle()));
+  service_->SetPinToTabConversionHookForTesting({});
+  ExpectLivePinRestored(id, pin_tab, original_parent, *original_index,
+                        original_pins, original_pref);
+  base::RunLoop().RunUntilIdle();
+  ExpectLivePinRestored(id, pin_tab, original_parent, *original_index,
+                        original_pins, original_pref);
+}
