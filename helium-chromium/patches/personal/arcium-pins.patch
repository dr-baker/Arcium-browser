+
+bool HeliumSpaceService::PromotePinToFavorite(Browser* browser,
+                                              std::string_view source_space_id,
+                                              std::string_view id) {
+  if (!IsEligibleBrowser(browser) || source_space_id.empty() || id.empty() ||
+      GetSpaceIdForBrowser(browser) != source_space_id) {
+    return false;
+  }
+  HeliumSpace* space = GetSpaceById(source_space_id);
+  const std::optional<PersistentLink> pin =
+      ResolvePinInSpace(source_space_id, id);
+  if (!space || !pin) {
+    return false;
+  }
+  if (!CanRelocatePinNodeInSpace(source_space_id, id)) {
+    return false;
+  }
+
+  const std::string pin_key =
+      ItemKeyForSpace(PersistentRecordKind::kPin, source_space_id, id);
+  const std::optional<PersistentItemLifecycle::State> pin_state =
+      lifecycle_.GetState(pin_key);
+  if (!pin_state ||
+      *pin_state == PersistentItemLifecycle::State::kMaterializing ||
+      *pin_state == PersistentItemLifecycle::State::kClosing) {
+    return false;
+  }
+
+  const std::optional<uint64_t> live_token = lifecycle_.GetLiveTab(pin_key);
+  LiveAssociation* live_association = nullptr;
+  tabs::TabInterface* live_tab = nullptr;
+  if (live_token) {
+    const auto association = live_associations_.find(*live_token);
+    if (association == live_associations_.end() ||
+        association->second->kind != PersistentRecordKind::kPin ||
+        association->second->item_id != id || !association->second->tab ||
+        !IsLiveTabInExpectedCollection(PersistentRecordKind::kPin,
+                                       association->second->tab)) {
+      return false;
+    }
+    live_association = association->second.get();
+    live_tab = live_association->tab;
+  }
+
+  PersistentNodes staged_pins = space->pins();
+  if (!PersistentItemCodec::RemoveNode(staged_pins, id)) {
+    return false;
+  }
+  PersistentLink favorite = *pin;
+  do {
+    favorite.id = NewId();
+  } while (
+      ResolveItem(browser, PersistentRecordKind::kFavorite, favorite.id) ||
+      lifecycle_.GetState(ItemKeyForSpace(PersistentRecordKind::kFavorite,
+                                          std::string_view(), favorite.id)));
+  PersistentNodes staged_favorites = local_favorites_;
+  staged_favorites.push_back(PersistentNode{.data = favorite});
+  const std::string favorite_key = ItemKeyForSpace(
+      PersistentRecordKind::kFavorite, std::string_view(), favorite.id);
+
+  if (!lifecycle_.Rekey(pin_key, favorite_key)) {
+    return false;
+  }
+
+  space->SetPins(std::move(staged_pins));
+  local_favorites_ = std::move(staged_favorites);
+  PersistLocalFavorites();
+  if (const auto usage = persistent_item_usage_.find(pin_key);
+      usage != persistent_item_usage_.end()) {
+    persistent_item_usage_.insert_or_assign(favorite_key, usage->second);
+    persistent_item_usage_.erase(usage);
+    PersistPersistentItemUsage();
+  }
+
+  if (live_association && live_tab) {
+    live_association->key = favorite_key;
+    live_association->kind = PersistentRecordKind::kFavorite;
+    live_association->item_id = favorite.id;
+    live_association->space_id.clear();
+    SeedAnchoredHome(live_tab, favorite);
+    if (SessionService* sessions =
+            SessionServiceFactory::GetForProfile(profile_)) {
+      BrowserWindowInterface* window = live_tab->GetBrowserWindowInterface();
+      if (window) {
+        sessions->AddTabExtraData(
+            window->GetSessionID(),
+            sessions::SessionTabHelper::IdForTab(live_tab->GetContents()),
+            kHeliumPersistentItemTabExtraDataKey, favorite_key);
+      }
+    }
+    persistent_item_drags_.insert(live_tab);
+    MoveLiveTabToPersistentRegion(PersistentRecordKind::kFavorite, live_tab);
+    persistent_item_drags_.erase(live_tab);
+  }
+
+  NotifyItemsChanged(
+      PersistentItemChange::Space(std::string(source_space_id)));
+  NotifyItemsChanged(PersistentItemChange::Favorites());
+  return true;
+}
+
+bool HeliumSpaceService::CreatePinFolderForTab(tabs::TabInterface* tab) {
+  LiveAssociation* association = FindLiveAssociation(tab);
+  if (!association || association->kind != PersistentRecordKind::kPin) {
+    return false;
+  }
+  if (!CanRelocatePinNodeInSpace(association->space_id, association->item_id)) {
+    return false;
+  }
+  BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+  Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  HeliumSpace* space =
+      browser ? GetSpaceById(GetSpaceIdForBrowser(browser)) : nullptr;
+  if (!space) {
+    return false;
+  }
+  PersistentNodes pins = space->pins();
+  if (!WrapLinkInFolder(&pins, association->item_id, NewId(), u"Folder")) {
+    return false;
+  }
+  space->SetPins(std::move(pins));
+  NotifyItemsChanged(PersistentItemChange::Space(space->id()));
+  return true;
+}
+
+bool HeliumSpaceService::AddFromTab(tabs::TabInterface* tab,
+                                    PersistentRecordKind kind) {
+  if (!tab || tabs::TemporaryTab::IsTemporary(tab->GetContents()) ||
+      tab->GetProfile() != profile_ || profile_->IsOffTheRecord() ||
+      profile_->IsGuestSession() || IsPersistentItemTab(tab) ||
+      tab->IsSplit() || tab->GetGroup().has_value()) {
+    return false;
+  }
+  BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+  Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  const GURL url = tab->GetContents()->GetLastCommittedURL();
+  if (!browser || !url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  PersistentLink link{
+      .id = NewId(), .title = tab->GetContents()->GetTitle(), .url = url};
+  const std::string key = ItemKey(browser, kind, link.id);
+  if (kind == PersistentRecordKind::kFavorite) {
+    local_favorites_.push_back(PersistentNode{.data = link});
+    profile_->GetPrefs()->SetList(
+        kHeliumFavoritesPref, PersistentItemCodec::Encode(local_favorites_));
+  } else {
+    HeliumSpace* space = GetSpaceById(GetSpaceIdForBrowser(browser));
+    if (!space) {
+      return false;
+    }
+    space->AppendPin(link);
+  }
+  lifecycle_.AddDormant(key);
+  if (!AssociateLiveTab(key, kind, link.id, tab)) {
+    // The durable record remains valid even if the existing tab cannot be
+    // associated. Its next activation will materialize from the stored URL.
+    NotifyItemsChanged(ChangeForItem(browser, kind));
+    return true;
+  }
+  NotifyItemsChanged(ChangeForItem(browser, kind));
+  return true;
+}
