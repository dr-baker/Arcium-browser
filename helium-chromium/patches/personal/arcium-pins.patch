+void UnpinnedTabContainerView::UpdatePersistentTabDragPreview(
+    const gfx::Point& point_in_screen) {
+  const std::vector<views::View*> children =
+      collection_node_ ? collection_node_->GetDirectChildren()
+                       : std::vector<views::View*>();
+  size_t insertion_index = children.size();
+  tabs::TabInterface* before_tab =
+      GetTabBeforePersistentDrop(point_in_screen);
+  if (before_tab) {
+    for (size_t index = 0; index < children.size(); ++index) {
+      TabView* tab_view = views::AsViewClass<TabView>(children[index]);
+      if (!tab_view) {
+        continue;
+      }
+      tabs::ConstChildPtr node_data =
+          tab_view->collection_node()->GetNodeData();
+      const auto* tab = std::get_if<const tabs::TabInterface*>(&node_data);
+      if (tab && *tab == before_tab) {
+        insertion_index = index;
+        break;
+      }
+    }
+  }
+  if (external_drop_index_ == insertion_index) {
+    return;
+  }
+  external_drop_index_ = insertion_index;
+  InvalidateLayout();
+}
+
+void UnpinnedTabContainerView::ClearPersistentTabDragPreview() {
+  if (!external_drop_index_) {
+    return;
+  }
+  external_drop_index_.reset();
+  InvalidateLayout();
+}
+
+tabs::TabInterface* UnpinnedTabContainerView::GetTabBeforePersistentDrop(
+    const gfx::Point& point_in_screen) {
+  BrowserView* browser_view =
+      collection_node_ && collection_node_->GetController()
+          ? collection_node_->GetController()->GetBrowserView()
+          : nullptr;
+  Browser* browser = browser_view ? browser_view->browser() : nullptr;
+  TabStripModel* model = browser ? browser->tab_strip_model() : nullptr;
+  if (!model) {
+    return nullptr;
+  }
+
+  const gfx::Point point_in_container =
+      views::View::ConvertPointFromScreen(this, point_in_screen);
+  const std::optional<BrowserRootView::DropIndex> drop =
+      GetLinkDropIndex(point_in_container);
+  if (!drop || drop->index < model->IndexOfFirstUnpinnedTab()) {
+    return nullptr;
+  }
+  const auto* strip =
+      model->Root()
+          ? static_cast<const tabs::TabStripCollection*>(model->Root())
+          : nullptr;
+  helium::HeliumSpaceService* service =
+      helium::HeliumSpaceServiceFactory::GetForProfile(browser->profile());
+  if (!strip || !service) {
+    return nullptr;
+  }
+  for (int index = drop->index; index < model->count(); ++index) {
+    tabs::TabInterface* candidate = model->GetTabAtIndex(index);
+    BrowserWindowInterface* candidate_window =
+        candidate ? candidate->GetBrowserWindowInterface() : nullptr;
+    if (!candidate || candidate->GetProfile() != browser->profile() ||
+        candidate->IsPinned() || candidate->IsSplit() ||
+        candidate->GetGroup().has_value() ||
+        service->IsPersistentItemTab(candidate) || strip->IsPinTab(candidate) ||
+        !candidate_window ||
+        candidate_window->GetBrowserForMigrationOnly() != browser ||
+        candidate_window->GetTabStripModel() != model) {
+      continue;
+    }
+    return candidate;
+  }
+  return nullptr;
 }
 
