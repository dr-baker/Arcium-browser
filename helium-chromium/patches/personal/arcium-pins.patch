+}
+
+bool HeliumSpaceService::GetPersistentItemHome(
+    const tabs::TabInterface* tab,
+    GURL* home_url,
+    std::u16string* home_title) const {
+  if (!tab || !home_url || !home_title) {
+    return false;
+  }
+  const LiveAssociation* association = FindLiveAssociation(tab);
+  if (!association) {
+    return false;
+  }
+  const BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+  // ResolveItem only inspects browser identity and profile state. Preserve
+  // its established API while entering from a const TabInterface observer.
+  Browser* browser =
+      window ? const_cast<Browser*>(window->GetBrowserForMigrationOnly())
+             : nullptr;
+  std::optional<PersistentLink> item =
+      ResolveItem(browser, association->kind, association->item_id);
+  if (!item) {
+    return false;
+  }
+  *home_url = item->url;
+  *home_title = item->title;
+  return true;
+}
+
+bool HeliumSpaceService::AssociateLiveTab(std::string key,
+                                          PersistentRecordKind kind,
+                                          std::string_view id,
+                                          tabs::TabInterface* tab) {
+  if (!tab || tabs::TemporaryTab::IsTemporary(tab->GetContents()) ||
+      live_token_by_tab_.contains(tab)) {
+    return false;
+  }
+  BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+  Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  const std::string space_id =
+      kind == PersistentRecordKind::kPin
+          ? std::string(GetSpaceIdForBrowser(browser))
+          : std::string();
+  if (kind == PersistentRecordKind::kPin && space_id.empty()) {
+    return false;
+  }
+  const uint64_t token = next_live_token_++;
+  auto association = std::make_unique<LiveAssociation>(
+      token, key, kind, std::string(id), space_id, tab);
+  association->will_detach_subscription = tab->RegisterWillDetach(
+      base::BindRepeating(&HeliumSpaceService::OnLiveTabWillDetach,
+                          weak_factory_.GetWeakPtr(), token));
+  association->did_insert_subscription = tab->RegisterDidInsert(
+      base::BindRepeating(&HeliumSpaceService::OnLiveTabDidInsert,
+                          weak_factory_.GetWeakPtr(), token));
+  association->did_activate_subscription = tab->RegisterDidActivate(
+      base::BindRepeating(&HeliumSpaceService::OnLiveTabActivationChanged,
+                          weak_factory_.GetWeakPtr()));
+  association->will_deactivate_subscription = tab->RegisterWillDeactivate(
+      base::BindRepeating(&HeliumSpaceService::OnLiveTabActivationChanged,
+                          weak_factory_.GetWeakPtr()));
+  if (lifecycle_.GetState(key) == PersistentItemLifecycle::State::kMaterializing
+          ? !lifecycle_.DidMaterialize(key, token)
+          : !lifecycle_.RestoreLive(key, token)) {
+    return false;
+  }
+  const bool inserted_association =
+      live_associations_.emplace(token, std::move(association)).second;
+  CHECK(inserted_association);
+  const bool inserted_tab_token = live_token_by_tab_.emplace(tab, token).second;
+  CHECK(inserted_tab_token);
+  if (SessionService* sessions =
+          SessionServiceFactory::GetForProfile(profile_)) {
+    if (window) {
+      sessions->AddTabExtraData(
+          window->GetSessionID(),
+          sessions::SessionTabHelper::IdForTab(tab->GetContents()),
+          kHeliumPersistentItemTabExtraDataKey, key);
+    }
+  }
+  if (std::optional<PersistentLink> item = ResolveItem(browser, kind, id)) {
+    SeedAnchoredHome(tab, *item);
+  }
+  // Register ownership before moving the native view so synchronous
+  // collection observers can recognize it as the live persistent instance.
+  MoveLiveTabToPersistentRegion(kind, tab);
+  return true;
+}
+
+HeliumSpaceService::LiveAssociation*
+HeliumSpaceService::FindLiveAssociation(tabs::TabInterface* tab) {
+  if (!tab) {
+    return nullptr;
+  }
+  const auto token = live_token_by_tab_.find(tab);
+  if (token == live_token_by_tab_.end()) {
+    return nullptr;
+  }
+  const auto association = live_associations_.find(token->second);
+  return association != live_associations_.end() &&
+                 association->second->tab == tab
+             ? association->second.get()
+             : nullptr;
+}
+
+const HeliumSpaceService::LiveAssociation*
+HeliumSpaceService::FindLiveAssociation(const tabs::TabInterface* tab) const {
+  return const_cast<HeliumSpaceService*>(this)->FindLiveAssociation(
+      const_cast<tabs::TabInterface*>(tab));
+}
+
+void HeliumSpaceService::EraseLiveAssociation(uint64_t token) {
+  const auto association = live_associations_.find(token);
+  if (association == live_associations_.end()) {
+    return;
+  }
+  if (tabs::TabInterface* tab = association->second->tab) {
+    const auto tab_token = live_token_by_tab_.find(tab);
+    if (tab_token != live_token_by_tab_.end() && tab_token->second == token) {
+      live_token_by_tab_.erase(tab_token);
+    }
+  }
+  live_associations_.erase(association);
+}
+
+void HeliumSpaceService::MoveLiveTabToPersistentRegion(
+    PersistentRecordKind kind,
+    tabs::TabInterface* tab) {
+  BrowserWindowInterface* window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  TabStripModel* model = window ? window->GetTabStripModel() : nullptr;
+  if (!model) {
+    return;
+  }
+  if (LiveCollectionForKind(kind) == PersistentLiveCollection::kPinnedGrid) {
+    model->SetTabPinned(model->GetIndexOfTab(tab), true);
+  } else {
+    model->MoveTabToPin(tab);
+  }
+}
+
+void HeliumSpaceService::SeedAnchoredHome(tabs::TabInterface* tab,
+                                          const PersistentLink& item) {
+  TabUIHelper* helper = TabUIHelper::From(tab);
+  if (!helper) {
+    return;
+  }
+  if (!item.url.SchemeIsHTTPOrHTTPS()) {
+    helper->ClearAnchoredPinnedTabHome();
+    return;
+  }
+  std::u16string title = item.title;
+  if (title.empty()) {
+    title = base::UTF8ToUTF16(item.url.host());
+  }
+  helper->SetAnchoredPinnedTabHome(item.url, std::move(title));
+}
+
+void HeliumSpaceService::OnLiveTabWillDetach(
+    uint64_t token,
+    tabs::TabInterface* tab,
+    tabs::TabInterface::DetachReason reason) {
+  persistent_item_drags_.erase(tab);
+  if (reason != tabs::TabInterface::DetachReason::kDelete) {
+    return;
+  }
+  lifecycle_.BeginClose(token);
+  // TabStripModel emits WillDetach before it knows whether a before-unload
+  // handler will permit the close. A confirmed removal is completed from the
+  // model observer; if no removal follows, restore the still-associated row.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&HeliumSpaceService::CancelLiveTabCloseIfStillAssociated,
+                     weak_factory_.GetWeakPtr(), token));
+}
+
+void HeliumSpaceService::OnLiveTabDidInsert(uint64_t token,
+                                            tabs::TabInterface* tab) {
+  auto association = live_associations_.find(token);
+  if (association == live_associations_.end()) {
+    return;
+  }
+  if (persistent_item_drags_.contains(tab) ||
+      live_pin_space_transfers_.contains(token)) {
+    return;
+  }
+  BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+  Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  if (IsItemKeyVisibleInBrowser(browser, association->second->key) &&
+      IsLiveTabInExpectedCollection(association->second->kind, tab)) {
+    return;
+  }
+  // Moving a live instance out of its collection, Space, or window leaves the
+  // ordinary tab in place and returns only the persistent association to
+  // dormant. Defer subscription destruction until the insertion callback
+  // unwinds.
+  lifecycle_.BeginClose(token);
+  const PersistentItemChange change = ChangeForAssociation(*association->second);
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          &HeliumSpaceService::CompleteLiveTabCloseIfStillInvalid,
+          weak_factory_.GetWeakPtr(), token, change));
+}
+
+void HeliumSpaceService::SetPersistentItemDragInProgress(
+    tabs::TabInterface* tab,
+    bool in_progress) {
+  if (!tab) {
+    return;
+  }
+  if (in_progress) {
+    persistent_item_drags_.insert(tab);
+  } else {
+    persistent_item_drags_.erase(tab);
+  }
+}
+
+bool HeliumSpaceService::IsLiveTabInExpectedCollection(
+    PersistentRecordKind kind,
+    const tabs::TabInterface* tab) const {
+  if (!tab) {
+    return false;
+  }
+  if (LiveCollectionForKind(kind) == PersistentLiveCollection::kPinnedGrid) {
+    return tab->IsPinned();
+  }
+  const tabs::TabStripCollection* strip = nullptr;
+  if (const BrowserWindowInterface* window = tab->GetBrowserWindowInterface()) {
+    if (const TabStripModel* model = window->GetTabStripModel();
+        model && model->Root()) {
+      strip = static_cast<const tabs::TabStripCollection*>(model->Root());
+    }
+  }
+  return strip && strip->IsPinTab(tab);
+}
+
+void HeliumSpaceService::OnLiveTabActivationChanged(tabs::TabInterface* tab) {
+  // WillDeactivate runs before TabInterface flips its active state. Rebuild
+  // after the observer callback so collapsed folders expose only the item
+  // that is actually active once the selection transition has completed.
+  const LiveAssociation* association = FindLiveAssociation(tab);
+  if (association && live_pin_space_transfers_.contains(association->token)) {
+    return;
+  }
+  PersistentItemChange change =
+      association ? ChangeForAssociation(*association)
+                  : PersistentItemChange::Global();
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&HeliumSpaceService::NotifyItemsChanged,
+                                weak_factory_.GetWeakPtr(), std::move(change)));
+}
+
+void HeliumSpaceService::CancelLiveTabCloseIfStillAssociated(uint64_t token) {
+  auto association = live_associations_.find(token);
+  if (association == live_associations_.end() || !association->second->tab ||
+      !lifecycle_.CancelClose(token)) {
+    return;
+  }
+  NotifyItemsChanged(ChangeForAssociation(*association->second));
+}
+
+void HeliumSpaceService::CompleteLiveTabCloseIfStillInvalid(
+    uint64_t token,
+    PersistentItemChange change) {
+  auto association = live_associations_.find(token);
+  if (association == live_associations_.end()) {
+    return;
+  }
+  tabs::TabInterface* tab = association->second->tab;
+  BrowserWindowInterface* window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  if (tab &&
+      IsItemKeyVisibleInBrowser(browser, association->second->key) &&
+      IsLiveTabInExpectedCollection(association->second->kind, tab)) {
+    if (lifecycle_.CancelClose(token)) {
+      NotifyItemsChanged(ChangeForAssociation(*association->second));
+    }
+    return;
+  }
+  CompleteLiveTabClose(token, std::move(change));
+}
+
+void HeliumSpaceService::CompleteLiveTabClose(uint64_t token,
+                                              PersistentItemChange change) {
+  lifecycle_.CompleteClose(token);
+  EraseLiveAssociation(token);
+  NotifyItemsChanged(std::move(change));
+}
+
+bool HeliumSpaceService::IsPersistentItemLive(Browser* browser,
+                                              PersistentRecordKind kind,
+                                              std::string_view id) const {
+  const auto state = lifecycle_.GetState(ItemKey(browser, kind, id));
+  return state && (*state == PersistentItemLifecycle::State::kLive ||
+                   *state == PersistentItemLifecycle::State::kClosing);
+}
+
+tabs::TabInterface* HeliumSpaceService::GetLiveTabForPersistentItem(
+    Browser* browser,
+    PersistentRecordKind kind,
+    std::string_view id) const {
+  const auto token = lifecycle_.GetLiveTab(ItemKey(browser, kind, id));
+  if (!token) {
+    return nullptr;
+  }
+  const auto association = live_associations_.find(*token);
+  tabs::TabInterface* tab = association == live_associations_.end()
+                                ? nullptr
+                                : association->second->tab.get();
+  BrowserWindowInterface* window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  return tab && window && window->GetBrowserForMigrationOnly() == browser
+             ? tab
+             : nullptr;
+}
+
+bool HeliumSpaceService::IsPersistentItemActive(Browser* browser,
+                                                PersistentRecordKind kind,
+                                                std::string_view id) const {
+  const auto token = lifecycle_.GetLiveTab(ItemKey(browser, kind, id));
+  if (!token) {
+    return false;
+  }
+  const auto association = live_associations_.find(*token);
+  return association != live_associations_.end() && association->second->tab &&
+         association->second->tab->GetBrowserWindowInterface() &&
+         association->second->tab->GetBrowserWindowInterface()
+                 ->GetBrowserForMigrationOnly() == browser &&
+         association->second->tab->IsActivated();
+}
+
+bool HeliumSpaceService::CloseLiveInstanceForKey(std::string_view key,
+                                                 bool close_tab) {
+  const auto token = lifecycle_.GetLiveTab(key);
+  if (!token || live_pin_space_transfers_.contains(*token)) {
+    return false;
+  }
+  auto association = live_associations_.find(*token);
+  if (association == live_associations_.end() || !association->second->tab) {
+    lifecycle_.BeginClose(*token);
+    lifecycle_.CompleteClose(*token);
+    return true;
+  }
+
+  tabs::TabInterface* tab = association->second->tab.get();
+  BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+  TabStripModel* model = window ? window->GetTabStripModel() : nullptr;
+  const int index = model ? model->GetIndexOfTab(tab) : TabStripModel::kNoTab;
+  if (!close_tab) {
+    if (TabUIHelper* helper = TabUIHelper::From(tab)) {
+      helper->ClearAnchoredPinnedTabHome();
+    }
+    const PersistentItemChange change =
+        ChangeForAssociation(*association->second);
+    lifecycle_.BeginClose(*token);
+    EraseLiveAssociation(*token);
+    lifecycle_.CompleteClose(*token);
+    NotifyItemsChanged(change);
+    return true;
+  }
+  if (!model || index == TabStripModel::kNoTab) {
+    const PersistentItemChange change =
+        ChangeForAssociation(*association->second);
+    lifecycle_.BeginClose(*token);
+    EraseLiveAssociation(*token);
+    lifecycle_.CompleteClose(*token);
+    NotifyItemsChanged(change);
+    return true;
+  }
+
+  model->CloseWebContentsAt(index, TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  return true;
+}
+
+bool HeliumSpaceService::ClosePersistentItemInstance(
+    Browser* browser,
+    PersistentRecordKind kind,
+    std::string_view id,
+    std::string_view source_space_id) {
+  if (!IsEligibleBrowser(browser)) {
+    return false;
+  }
+  if (kind == PersistentRecordKind::kFavorite) {
+    if (!ResolveItem(browser, kind, id)) {
+      return false;
+    }
+    return CloseLiveInstanceForKey(ItemKey(browser, kind, id), true);
+  }
+  if (source_space_id.empty() || !ResolvePinInSpace(source_space_id, id)) {
+    return false;
+  }
+  return CloseLiveInstanceForKey(
+      ItemKeyForSpace(PersistentRecordKind::kPin, source_space_id, id), true);
+}
+
+bool HeliumSpaceService::ReturnPersistentItemHome(
+    Browser* browser,
+    PersistentRecordKind kind,
+    std::string_view id,
+    std::string_view source_space_id) {
+  if (!IsEligibleBrowser(browser)) {
+    return false;
+  }
+  std::string key;
+  if (kind == PersistentRecordKind::kFavorite) {
+    if (!ResolveItem(browser, kind, id)) {
+      return false;
+    }
+    key = ItemKey(browser, kind, id);
+  } else {
+    if (source_space_id.empty() || !ResolvePinInSpace(source_space_id, id)) {
+      return false;
+    }
+    key = ItemKeyForSpace(PersistentRecordKind::kPin, source_space_id, id);
+  }
+  const auto token = lifecycle_.GetLiveTab(key);
+  if (!token || live_pin_space_transfers_.contains(*token)) {
+    return false;
+  }
+  const auto association = live_associations_.find(*token);
+  if (association == live_associations_.end() || !association->second->tab) {
+    return false;
+  }
+  ResetAnchoredPinnedTab(association->second->tab.get());
+  NotifyItemsChanged(
+      kind == PersistentRecordKind::kFavorite
+          ? PersistentItemChange::Favorites()
+          : PersistentItemChange::Space(std::string(source_space_id)));
+  return true;
+}
+
+HeliumSpaceService::ScopedTabStripEmptyCloseDeferral::
+    ScopedTabStripEmptyCloseDeferral(HeliumSpaceService* service,
+                                     Browser* browser)
+    : service_(service->weak_factory_.GetWeakPtr()),
+      browser_session_id_(browser->session_id()) {
+  auto& state = service->empty_tab_strip_close_deferrals_[browser_session_id_];
+  state.browser = browser->AsWeakPtr();
+  ++state.depth;
+}
+
+HeliumSpaceService::ScopedTabStripEmptyCloseDeferral::
+    ~ScopedTabStripEmptyCloseDeferral() {
+  if (!service_) {
+    return;
+  }
+  const auto state =
+      service_->empty_tab_strip_close_deferrals_.find(browser_session_id_);
+  if (state == service_->empty_tab_strip_close_deferrals_.end()) {
+    // The original frame was explicitly destroyed during a transfer.
+    return;
+  }
+  CHECK_GT(state->second.depth, 0u);
+  if (--state->second.depth != 0) {
+    return;
+  }
+  const base::WeakPtr<Browser> browser = state->second.browser;
+  const bool had_pending_close = state->second.pending_close;
+  service_->empty_tab_strip_close_deferrals_.erase(state);
+  if (had_pending_close && browser && browser->tab_strip_model()->empty()) {
+    // Closing may destroy either owner. No member access follows this call.
+    browser->TabStripEmpty();
+  }
+}
+
+void HeliumSpaceService::ScopedTabStripEmptyCloseDeferral::
+    CancelPendingClose() {
+  if (!service_) {
+    return;
+  }
+  const auto state =
+      service_->empty_tab_strip_close_deferrals_.find(browser_session_id_);
+  if (state != service_->empty_tab_strip_close_deferrals_.end()) {
+    state->second.pending_close = false;
+  }
+}
+
+bool HeliumSpaceService::ShouldDeferEmptyTabStripClose(Browser* browser) {
+  if (!browser) {
+    return false;
+  }
+  HeliumSpaceService* service =
+      HeliumSpaceServiceFactory::GetForProfileIfExists(browser->profile());
+  if (!service) {
+    return false;
+  }
+  const auto state =
+      service->empty_tab_strip_close_deferrals_.find(browser->session_id());
+  if (state == service->empty_tab_strip_close_deferrals_.end() ||
+      state->second.depth == 0 || state->second.browser.get() != browser) {
+    return false;
+  }
+  state->second.pending_close = true;
+  return true;
+}
+
+
+bool HeliumSpaceService::MovePinToSpace(Browser* browser,
+                                        std::string_view id,
+                                        std::string_view source_space_id,
+                                        std::string_view target_space_id) {
+  if (!IsEligibleBrowser(browser) || id.empty() || source_space_id.empty() ||
+      target_space_id.empty() || source_space_id == target_space_id ||
+      !live_pin_space_transfers_.empty()) {
+    return false;
+  }
+  // Callers commonly pass strings borrowed from the durable model. Native
+  // callbacks can replace that model while the transaction is in progress.
+  const std::string item_id(id);
+  const std::string source_id(source_space_id);
+  const std::string target_id(target_space_id);
+  HeliumSpace* source_space = GetSpaceById(source_id);
+  HeliumSpace* target_space = GetSpaceById(target_id);
+  const std::optional<PersistentLink> link =
+      ResolvePinInSpace(source_id, item_id);
+  if (!source_space || !target_space || !link ||
+      HasNodeId(target_space->pins(), item_id)) {
+    return false;
+  }
+  const std::string old_key =
+      ItemKeyForSpace(PersistentRecordKind::kPin, source_id, item_id);
+  const std::string new_key =
+      ItemKeyForSpace(PersistentRecordKind::kPin, target_id, item_id);
+  const auto state = lifecycle_.GetState(old_key);
+  if ((state && (*state == PersistentItemLifecycle::State::kMaterializing ||
+                 *state == PersistentItemLifecycle::State::kClosing)) ||
+      lifecycle_.GetState(new_key)) {
+    return false;
+  }
+
+  const PersistentNodes original_source_pins = source_space->pins();
+  const PersistentNodes original_target_pins = target_space->pins();
+  PersistentNodes staged_source_pins = original_source_pins;
+  PersistentNodes staged_target_pins = original_target_pins;
+  if (!PersistentItemCodec::RemoveNode(staged_source_pins, item_id)) {
+    return false;
+  }
+  staged_target_pins.push_back(PersistentNode{.data = *link});
+  const base::ListValue original_spaces_pref =
+      profile_->GetPrefs()->GetList(kHeliumSpacesPref).Clone();
+  base::ListValue staged_spaces_pref = original_spaces_pref.Clone();
+  size_t source_records = 0;
+  size_t target_records = 0;
+  for (base::Value& value : staged_spaces_pref) {
+    base::DictValue* record = value.GetIfDict();
+    const std::string* record_id = record ? record->FindString("id") : nullptr;
+    if (record_id && *record_id == source_id) {
+      record->Set("pins", PersistentItemCodec::Encode(staged_source_pins));
+      ++source_records;
+    } else if (record_id && *record_id == target_id) {
+      record->Set("pins", PersistentItemCodec::Encode(staged_target_pins));
+      ++target_records;
+    }
+  }
+  if (source_records != 1 || target_records != 1) {
+    return false;
+  }
+  if (!state && !lifecycle_.AddDormant(old_key)) {
+    return false;
+  }
+
+  const base::WeakPtr<HeliumSpaceService> service = weak_factory_.GetWeakPtr();
+  const base::WeakPtr<Browser> context_browser = browser->AsWeakPtr();
+  auto durable_model_is_unchanged = [&]() {
+    if (!service || !context_browser ||
+        !service->IsEligibleBrowser(context_browser.get()) ||
+        service->profile_->ShutdownStarted() ||
+        browser_shutdown::IsTryingToQuit() ||
+        browser_shutdown::HasShutdownStarted()) {
+      return false;
+    }
+    HeliumSpace* current_source = service->GetSpaceById(source_id);
+    HeliumSpace* current_target = service->GetSpaceById(target_id);
+    return current_source && current_target &&
+           current_source->pins() == original_source_pins &&
+           current_target->pins() == original_target_pins &&
+           service->profile_->GetPrefs()->GetList(kHeliumSpacesPref) ==
+               original_spaces_pref;
+  };
+  auto commit_durable_move = [&]() {
+    HeliumSpace* current_source = service->GetSpaceById(source_id);
+    HeliumSpace* current_target = service->GetSpaceById(target_id);
+    current_source->SetPinsWithoutPersist(std::move(staged_source_pins));
+    current_target->SetPinsWithoutPersist(std::move(staged_target_pins));
+    bool moved_usage = false;
+    if (const auto usage = service->persistent_item_usage_.find(old_key);
+        usage != service->persistent_item_usage_.end()) {
+      service->persistent_item_usage_.insert_or_assign(new_key, usage->second);
+      service->persistent_item_usage_.erase(usage);
+      moved_usage = true;
+    }
+    // Both in-memory trees and the qualified live key are ready before a
+    // preference observer can see the move.
+    service->profile_->GetPrefs()->SetList(kHeliumSpacesPref,
+                                           std::move(staged_spaces_pref));
+    if (!service) {
+      return;
+    }
+    if (moved_usage) {
+      service->PersistPersistentItemUsage();
+    }
+    if (!service) {
+      return;
+    }
+    service->NotifyItemsChanged(PersistentItemChange::Space(source_id));
+    if (service) {
+      service->NotifyItemsChanged(PersistentItemChange::Space(target_id));
+    }
+  };
+
+  const std::optional<uint64_t> token = lifecycle_.GetLiveTab(old_key);
+  if (!token) {
+    if (state && *state != PersistentItemLifecycle::State::kDormant) {
+      return false;
+    }
+    if (!lifecycle_.Rekey(old_key, new_key)) {
+      return false;
+    }
+    commit_durable_move();
+    return true;
+  }
+  const auto association = live_associations_.find(*token);
+  tabs::TabInterface* tab = association == live_associations_.end()
+                                ? nullptr
+                                : association->second->tab.get();
+  BrowserWindowInterface* source_window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  Browser* source_browser =
+      source_window ? source_window->GetBrowserForMigrationOnly() : nullptr;
+  if (!tab || !IsEligibleBrowser(source_browser) ||
+      source_browser->IsAttemptingToCloseBrowser() ||
+      GetExplicitSpaceIdForBrowser(source_browser) != source_id ||
+      association->second->key != old_key ||
+      association->second->space_id != source_id ||
+      association->second->item_id != item_id ||
+      association->second->kind != PersistentRecordKind::kPin ||
+      FindLiveAssociation(tab) != association->second.get() ||
+      live_pin_space_transfers_.contains(*token) ||
+      tab->GetProfile() != profile_ || tab->IsSplit() || tab->GetGroup() ||
+      tabs::TemporaryTab::IsTemporary(tab->GetContents()) ||
+      !IsLiveTabInExpectedCollection(PersistentRecordKind::kPin, tab)) {
+    return false;
+  }
+  const tabs::TabHandle tab_handle = tab->GetHandle();
+  const base::WeakPtr<Browser> source_browser_weak =
+      source_browser->AsWeakPtr();
+  TabStripModel* source_model = source_browser->tab_strip_model();
+  const int original_tab_index = source_model->GetIndexOfTab(tab);
+  tabs::TabCollection* original_parent =
+      const_cast<tabs::TabCollection*>(tab->GetParentCollection());
+  const auto original_parent_index =
+      original_parent ? original_parent->GetIndexOfTab(tab) : std::nullopt;
+  if (original_tab_index == TabStripModel::kNoTab || !original_parent_index) {
+    return false;
+  }
+  const tabs::TabCollectionHandle original_parent_handle =
+      original_parent->GetHandle();
+  const PinTransferSelection source_selection(source_model);
+  const bool follows_sole_page = source_model->count() == 1 &&
+                                 tab->IsActivated() &&
+                                 source_browser == browser;
+
+  live_pin_space_transfers_.insert(*token);
+  base::ScopedClosureRunner end_transfer(base::BindOnce(
+      [](base::WeakPtr<HeliumSpaceService> owner, uint64_t live_token) {
+        if (owner) {
+          owner->live_pin_space_transfers_.erase(live_token);
+          const auto live = owner->live_associations_.find(live_token);
+          if (live != owner->live_associations_.end() && live->second->tab) {
+            owner->OnLiveTabDidInsert(live_token, live->second->tab);
+          }
+        }
+      },
+      service, *token));
+  auto browser_is_in_space = [&](const base::WeakPtr<Browser>& candidate,
+                                 const std::string& space_id) {
+    return service && candidate &&
+           service->IsEligibleBrowser(candidate.get()) &&
+           !candidate->IsAttemptingToCloseBrowser() &&
+           service->GetExplicitSpaceIdForBrowser(candidate.get()) == space_id &&
+           candidate->tab_strip_model()->Root();
+  };
+  auto find_browser = [&](const std::string& space_id) {
+    base::WeakPtr<Browser> result;
+    if (!service) {
+      return result;
+    }
+    ProfileBrowserCollection::GetForProfile(service->profile_)
+        ->ForEach(
+            [&](BrowserWindowInterface* window) {
+              Browser* candidate = window->GetBrowserForMigrationOnly();
+              if (candidate &&
+                  browser_is_in_space(candidate->AsWeakPtr(), space_id)) {
+                result = candidate->AsWeakPtr();
+                return false;
+              }
+              return true;
+            },
+            BrowserCollection::Order::kActivation);
+    return result;
+  };
+  auto create_browser = [&](const std::string& space_id) {
+    base::WeakPtr<Browser> result;
+    if (!service || service->profile_->ShutdownStarted() ||
+        browser_shutdown::IsTryingToQuit() ||
+        browser_shutdown::HasShutdownStarted() ||
+        Browser::GetCreationStatusForProfile(service->profile_) !=
+            Browser::CreationStatus::kOk) {
+      return result;
+    }
+    Browser* created = nullptr;
+    if (service->pin_space_transfer_browser_factory_for_testing_) {
+      auto factory = service->pin_space_transfer_browser_factory_for_testing_;
+      created = factory.Run(space_id);
+    } else {
+      Browser::CreateParams params(Browser::TYPE_NORMAL, service->profile_,
+                                   true);
+      params.should_trigger_session_restore = false;
+      created = Browser::Create(params);
+    }
+    if (!service || !created || created == source_browser_weak.get() ||
+        !service->IsEligibleBrowser(created) ||
+        created->IsAttemptingToCloseBrowser()) {
+      return result;
+    }
+    if (service->profile_->ShutdownStarted() ||
+        browser_shutdown::IsTryingToQuit() ||
+        browser_shutdown::HasShutdownStarted() ||
+        Browser::GetCreationStatusForProfile(service->profile_) !=
+            Browser::CreationStatus::kOk) {
+      if (created->tab_strip_model()->empty()) {
+        created->window()->Close();
+      }
+      return result;
+    }
+    result = created->AsWeakPtr();
+    service->SetSpaceForBrowser(created, space_id);
+    return result;
+  };
+  base::WeakPtr<Browser> target_browser_weak = find_browser(target_id);
+  const bool created_target = !target_browser_weak;
+  if (created_target) {
+    target_browser_weak = create_browser(target_id);
+  }
+  if (!browser_is_in_space(source_browser_weak, source_id) ||
+      !browser_is_in_space(target_browser_weak, target_id) ||
+      source_browser_weak.get() == target_browser_weak.get() ||
+      !durable_model_is_unchanged()) {
+    if (created_target && target_browser_weak &&
+        target_browser_weak->tab_strip_model()->empty()) {
+      target_browser_weak->window()->Close();
+    }
+    return false;
+  }
+  source_model = source_browser_weak->tab_strip_model();
+  TabStripModel* target_model = target_browser_weak->tab_strip_model();
+  const PinTransferSelection target_selection(target_model);
+  const bool target_was_empty = target_model->empty();
+  // Declare cleanup before the guards so close deferral has already unwound
+  // when an unused newly created destination is closed.
+  base::ScopedClosureRunner cleanup_created_target(base::BindOnce(
+      [](base::WeakPtr<Browser> target, bool was_created) {
+        if (was_created && target && target->tab_strip_model()->empty()) {
+          target->window()->Close();
+        }
+      },
+      target_browser_weak, created_target));
+  ScopedTabStripEmptyCloseDeferral source_close_deferral(
+      service.get(), source_browser_weak.get());
+  ScopedTabStripEmptyCloseDeferral target_close_deferral(
+      service.get(), target_browser_weak.get());
+  std::unique_ptr<tabs::TabModel> detached;
+  base::ScopedClosureRunner retire_unplaced_pin(base::BindOnce(
+      [](std::unique_ptr<tabs::TabModel>* detached_tab,
+         base::WeakPtr<HeliumSpaceService> owner, uint64_t live_token,
+         std::string owner_space_id) {
+        if (*detached_tab && owner) {
+          owner->lifecycle_.BeginClose(live_token);
+          owner->EraseLiveAssociation(live_token);
+          owner->lifecycle_.CompleteClose(live_token);
+          owner->NotifyItemsChanged(
+              PersistentItemChange::Space(std::move(owner_space_id)));
+        }
+      },
+      base::Unretained(&detached), service, *token, source_id));
+
+  auto rollback = [&]() {
+    tabs::TabInterface* current_tab = tab_handle.Get();
+    if (!service || !current_tab) {
+      return;
+    }
+    base::WeakPtr<Browser> rollback_browser = source_browser_weak;
+    if (!browser_is_in_space(rollback_browser, source_id)) {
+      // An explicit frame destruction is outside empty-strip close deferral.
+      // Keep the owned page in its original Space, without recreating content.
+      HeliumSpace* owner = service->GetSpaceById(source_id);
+      rollback_browser = find_browser(source_id);
+      if (!rollback_browser && owner) {
+        rollback_browser = create_browser(source_id);
+      }
+    }
+    if (!browser_is_in_space(rollback_browser, source_id)) {
+      // Profile teardown must not resurrect a frame. Destroy only the owned
+      // detached tab, after removing its borrowed association.
+      return;
+    }
+    TabStripModel* rollback_model = rollback_browser->tab_strip_model();
+    if (!detached) {
+      BrowserWindowInterface* current_window =
+          current_tab->GetBrowserWindowInterface();
+      TabStripModel* current_model =
+          current_window ? current_window->GetTabStripModel() : nullptr;
+      const int current_index = current_model
+                                    ? current_model->GetIndexOfTab(current_tab)
+                                    : TabStripModel::kNoTab;
+      if (!current_model || current_index == TabStripModel::kNoTab ||
+          current_tab->IsSplit() || current_tab->GetGroup()) {
+        return;
+      }
+      if (current_model != rollback_model) {
+        detached = current_model->DetachTabAtForInsertion(current_index);
+        if (!service || !rollback_browser) {
+          return;
+        }
+      }
+    }
+    if (detached) {
+      rollback_model->InsertDetachedTabAt(
+          original_tab_index, std::move(detached), AddTabTypes::ADD_NONE);
+    }
+    current_tab = tab_handle.Get();
+    if (!service || !rollback_browser || !current_tab ||
+        !rollback_browser->tab_strip_model()->Root() ||
+        rollback_browser->tab_strip_model()->GetIndexOfTab(current_tab) ==
+            TabStripModel::kNoTab) {
+      return;
+    }
+    auto* strip = static_cast<tabs::TabStripCollection*>(
+        const_cast<tabs::TabCollection*>(rollback_model->Root()));
+    tabs::TabCollection* parent = original_parent_handle.Get();
+    const tabs::TabCollection* ancestor = parent;
+    while (ancestor && ancestor != strip->pin_collection()) {
+      ancestor = ancestor->GetParentCollection();
+    }
+    if (!ancestor) {
+      parent = strip->pin_collection();
+    }
+    rollback_model->MoveTabToPinCollection(
+        current_tab, parent,
+        std::min(*original_parent_index, parent->ChildCount()));
+    if (!service || !rollback_browser) {
+      return;
+    }
+    source_selection.Restore(rollback_browser->tab_strip_model());
+    if (!service || !rollback_browser) {
+      return;
+    }
+    if (target_browser_weak && !target_was_empty) {
+      target_selection.Restore(target_browser_weak->tab_strip_model());
+    }
+    target_close_deferral.CancelPendingClose();
+    if (service && rollback_browser.get() != source_browser_weak.get()) {
+      service->NotifyItemsChanged(PersistentItemChange::Space(source_id));
+    }
+    if (!source_browser_weak && follows_sole_page && rollback_browser) {
+      rollback_browser->window()->Show();
+    }
+  };
+  auto live_placement_is_valid = [&](bool require_destination = false) {
+    if (!browser_is_in_space(source_browser_weak, source_id) ||
+        !browser_is_in_space(target_browser_weak, target_id) ||
+        !durable_model_is_unchanged()) {
+      return false;
+    }
+    tabs::TabInterface* current_tab = tab_handle.Get();
+    const auto current_association = service->live_associations_.find(*token);
+    if (require_destination) {
+      BrowserWindowInterface* window =
+          current_tab ? current_tab->GetBrowserWindowInterface() : nullptr;
+      if (!window ||
+          window->GetBrowserForMigrationOnly() != target_browser_weak.get() ||
+          window->GetTabStripModel() !=
+              target_browser_weak->tab_strip_model() ||
+          target_browser_weak->tab_strip_model()->GetIndexOfTab(current_tab) ==
+              TabStripModel::kNoTab) {
+        return false;
+      }
+    }
+    return current_tab && current_tab->GetProfile() == service->profile_ &&
+           !current_tab->IsSplit() && !current_tab->GetGroup() &&
+           current_association != service->live_associations_.end() &&
+           current_association->second->tab == current_tab &&
+           current_association->second->key == old_key &&
+           current_association->second->kind == PersistentRecordKind::kPin &&
+           current_association->second->space_id == source_id &&
+           current_association->second->item_id == item_id &&
+           service->FindLiveAssociation(current_tab) ==
+               current_association->second.get() &&
+           service->lifecycle_.GetState(old_key) ==
+               PersistentItemLifecycle::State::kLive &&
+           !service->lifecycle_.GetState(new_key);
+  };
+
+  if (!live_placement_is_valid() || !tab_handle.Get() ||
+      source_model->GetIndexOfTab(tab_handle.Get()) != original_tab_index ||
+      !service->IsLiveTabInExpectedCollection(PersistentRecordKind::kPin,
+                                              tab_handle.Get())) {
+    return false;
+  }
+  detached = source_model->DetachTabAtForInsertion(original_tab_index);
+  if (service && service->pin_space_transfer_hook_for_testing_) {
+    auto hook = service->pin_space_transfer_hook_for_testing_;
+    hook.Run(PinSpaceTransferPhaseForTesting::kAfterDetach);
+  }
+  if (!detached || !live_placement_is_valid()) {
+    rollback();
+    return false;
+  }
+  target_model->InsertDetachedTabAt(target_model->count(), std::move(detached),
+                                    AddTabTypes::ADD_NONE);
+  if (!live_placement_is_valid(/*require_destination=*/true) ||
+      target_browser_weak->tab_strip_model()->GetIndexOfTab(tab_handle.Get()) ==
+          TabStripModel::kNoTab) {
+    rollback();
+    return false;
+  }
+  service->MoveLiveTabToPersistentRegion(PersistentRecordKind::kPin,
+                                         tab_handle.Get());
+  if (service && service->pin_space_transfer_hook_for_testing_) {
+    auto hook = service->pin_space_transfer_hook_for_testing_;
+    hook.Run(PinSpaceTransferPhaseForTesting::kAfterPlacement);
+  }
+  if (!live_placement_is_valid(/*require_destination=*/true) ||
+      !service->IsLiveTabInExpectedCollection(PersistentRecordKind::kPin,
+                                              tab_handle.Get())) {
+    rollback();
+    return false;
+  }
+  // Anchored-home changes can synchronously close a tab or shut down its
+  // service through TabUIChange callbacks. Keep the old qualified identity
+  // until that notification has returned and placement is still valid.
+  service->SeedAnchoredHome(tab_handle.Get(), *link);
+  if (!live_placement_is_valid(/*require_destination=*/true) ||
+      !service->IsLiveTabInExpectedCollection(PersistentRecordKind::kPin,
+                                              tab_handle.Get())) {
+    rollback();
+    return false;
+  }
+  if (follows_sole_page) {
+    // Follow the transferred page before the source's deferred close is
+    // released. Other moves preserve the destination's selected tab.
+    const int index =
+        target_browser_weak->tab_strip_model()->GetIndexOfTab(tab_handle.Get());
+    target_browser_weak->tab_strip_model()->ActivateTabAt(index);
+    if (!live_placement_is_valid(/*require_destination=*/true)) {
+      rollback();
+      return false;
+    }
+  }
+  if (!service->lifecycle_.Rekey(old_key, new_key)) {
+    rollback();
+    return false;
+  }
+  LiveAssociation* moved = service->FindLiveAssociation(tab_handle.Get());
+  moved->key = new_key;
+  moved->space_id = target_id;
+  if (SessionService* sessions =
+          SessionServiceFactory::GetForProfile(service->profile_)) {
+    sessions->AddTabExtraData(
+        target_browser_weak->session_id(),
+        sessions::SessionTabHelper::IdForTab(tab_handle.Get()->GetContents()),
+        kHeliumPersistentItemTabExtraDataKey, new_key);
+  }
+  commit_durable_move();
+  cleanup_created_target.Release();
+  if (follows_sole_page && service && target_browser_weak) {
+    service->SetActiveSpace(target_id);
+    if (service && target_browser_weak && tab_handle.Get()) {
+      target_browser_weak->window()->Show();
+      if (service && target_browser_weak && tab_handle.Get()) {
+        target_browser_weak->window()->Activate();
+      }
+    }
+  }
+  return true;
+}
+
+void HeliumSpaceService::SetPinSpaceTransferHookForTesting(
+    base::RepeatingCallback<void(PinSpaceTransferPhaseForTesting)> hook) {
+  pin_space_transfer_hook_for_testing_ = std::move(hook);
+}
+
+void HeliumSpaceService::SetPinSpaceTransferBrowserFactoryForTesting(
+    base::RepeatingCallback<Browser*(std::string_view)> factory) {
+  pin_space_transfer_browser_factory_for_testing_ = std::move(factory);
+}
+
+bool HeliumSpaceService::MovePinInSpace(Browser* browser,
+                                        std::string_view source_space_id,
+                                        std::string_view id,
+                                        std::string_view parent_id,
+                                        std::string_view before_id) {
+  if (!IsEligibleBrowser(browser) || source_space_id.empty()) {
+    return false;
+  }
+  const std::string space_id(source_space_id);
+  const base::WeakPtr<HeliumSpaceService> service = weak_factory_.GetWeakPtr();
+  HeliumSpace* space = GetSpaceById(space_id);
+  const std::string key =
+      ItemKeyForSpace(PersistentRecordKind::kPin, space_id, id);
+  const auto token = lifecycle_.GetLiveTab(key);
+  if (!space || !CanRelocatePinNodeInSpace(space_id, id) ||
+      (token && live_pin_space_transfers_.contains(*token)) ||
+      !space->MovePin(id, parent_id, before_id)) {
+    return false;
+  }
+  if (service) {
+    service->NotifyItemsChanged(PersistentItemChange::Space(space_id));
+  }
+  return true;
+}
+
+std::optional<std::string> HeliumSpaceService::ConvertTabToPinInSpace(
+    Browser* browser,
+    std::string_view source_space_id,
+    tabs::TabInterface* tab,
+    std::string_view parent_id,
+    std::string_view before_id) {
+  if (!IsEligibleBrowser(browser) || source_space_id.empty() || !tab ||
+      GetSpaceIdForBrowser(browser) != source_space_id ||
+      tab->GetProfile() != profile_ || profile_->IsOffTheRecord() ||
+      profile_->IsGuestSession() || IsPersistentItemTab(tab) ||
+      tab->IsPinned() || tab->IsSplit() || tab->GetGroup().has_value()) {
+    return std::nullopt;
+  }
+  BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+  TabStripModel* model = window ? window->GetTabStripModel() : nullptr;
+  const tabs::TabStripCollection* strip =
+      model && model->Root()
+          ? static_cast<const tabs::TabStripCollection*>(model->Root())
+          : nullptr;
+  if (!window || window->GetBrowserForMigrationOnly() != browser || !model ||
+      !strip || model->GetIndexOfTab(tab) == TabStripModel::kNoTab ||
+      strip->IsPinTab(tab) || !tab->GetContents() ||
+      tabs::TemporaryTab::IsTemporary(tab->GetContents())) {
+    return std::nullopt;
+  }
+  const GURL url = tab->GetContents()->GetLastCommittedURL();
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return std::nullopt;
+  }
+  HeliumSpace* space = GetSpaceById(source_space_id);
+  if (!space) {
+    return std::nullopt;
+  }
+
+  std::string id;
+  do {
+    id = NewId();
+  } while (PersistentItemCodec::FindLink(space->pins(), id) ||
+           PersistentItemCodec::FindFolder(space->pins(), id) ||
+           lifecycle_.GetState(ItemKeyForSpace(PersistentRecordKind::kPin,
+                                               source_space_id, id)));
+  std::u16string title = tab->GetContents()->GetTitle();
+  if (title.empty()) {
+    title = base::UTF8ToUTF16(url.host());
+  }
+  const PersistentNodes original_pins = space->pins();
+  PersistentNodes staged_pins = original_pins;
+  if (!StageInsertedPin(
+          &staged_pins,
+          PersistentLink{.id = id, .title = std::move(title), .url = url},
+          parent_id, before_id)) {
+    return std::nullopt;
+  }
+
+  const std::string key =
+      ItemKeyForSpace(PersistentRecordKind::kPin, source_space_id, id);
+  space->SetPins(std::move(staged_pins));
+  if (!lifecycle_.AddDormant(key)) {
+    space->SetPins(original_pins);
+    return std::nullopt;
+  }
+  if (!AssociateLiveTab(key, PersistentRecordKind::kPin, id, tab)) {
+    lifecycle_.Forget(key);
+    space->SetPins(original_pins);
+    return std::nullopt;
+  }
+  NotifyItemsChanged(PersistentItemChange::Space(
+      std::string(source_space_id)));
+  return id;
+}
+
+bool HeliumSpaceService::ConvertPinToTabInSpace(
+    Browser* browser,
+    std::string_view source_space_id,
+    std::string_view id,
+    std::optional<tabs::TabHandle> before_tab_handle) {
+  if (!IsEligibleBrowser(browser) || source_space_id.empty() || id.empty() ||
+      GetSpaceIdForBrowser(browser) != source_space_id) {
+    return false;
+  }
+  HeliumSpace* space = GetSpaceById(source_space_id);
+  const std::optional<PersistentLink> link =
+      ResolvePinInSpace(source_space_id, id);
+  TabStripModel* model = browser->tab_strip_model();
+  if (!space || !link || !model || !model->Root() ||
+      !CanRelocatePinNodeInSpace(source_space_id, id)) {
+    return false;
+  }
+  const auto* strip =
+      static_cast<const tabs::TabStripCollection*>(model->Root());
+  tabs::TabInterface* before_tab =
+      before_tab_handle ? before_tab_handle->Get() : nullptr;
+
+  auto is_stable_ordinary_tab = [&](tabs::TabInterface* candidate) {
+    if (!candidate || candidate->GetProfile() != profile_ ||
+        candidate->IsPinned() || candidate->IsSplit() ||
+        candidate->GetGroup().has_value() || IsPersistentItemTab(candidate) ||
+        strip->IsPinTab(candidate)) {
+      return false;
+    }
+    BrowserWindowInterface* candidate_window =
+        candidate->GetBrowserWindowInterface();
+    return candidate_window &&
+           candidate_window->GetBrowserForMigrationOnly() == browser &&
+           candidate_window->GetTabStripModel() == model &&
+           model->GetIndexOfTab(candidate) != TabStripModel::kNoTab;
+  };
+  if (before_tab_handle && !is_stable_ordinary_tab(before_tab)) {
+    return false;
+  }
+
+  const std::string key =
+      ItemKeyForSpace(PersistentRecordKind::kPin, source_space_id, id);
+  const auto state = lifecycle_.GetState(key);
+  if (!state || *state == PersistentItemLifecycle::State::kMaterializing ||
+      *state == PersistentItemLifecycle::State::kClosing) {
+    return false;
+  }
+  tabs::TabInterface* live_tab =
+      GetLiveTabForPersistentItem(browser, PersistentRecordKind::kPin, id);
+  if (*state == PersistentItemLifecycle::State::kLive && !live_tab) {
+    return false;
+  }
+
+  PersistentNodes staged_pins = space->pins();
+  if (!PersistentItemCodec::RemoveNode(staged_pins, id)) {
+    return false;
+  }
+
+  if (live_tab) {
+    if (!IsLiveTabInExpectedCollection(PersistentRecordKind::kPin, live_tab)) {
+      return false;
+    }
+
+    tabs::TabCollection* original_parent =
+        const_cast<tabs::TabCollection*>(live_tab->GetParentCollection());
+    const std::optional<size_t> original_direct_index =
+        original_parent ? original_parent->GetIndexOfTab(live_tab)
+                        : std::nullopt;
+    if (!original_parent || !original_direct_index) {
+      return false;
+    }
+    const tabs::TabCollectionHandle original_parent_handle =
+        original_parent->GetHandle();
+    const tabs::TabHandle live_tab_handle = live_tab->GetHandle();
+    tabs::TabInterface* const transaction_tab = live_tab;
+
+    // Keep the association and durable record intact while the native tab is
+    // moved. Synchronous collection observers may invalidate the destination;
+    // suppress normal drag-detach handling until this transaction either
+    // commits or restores the original Pin collection position.
+    persistent_item_drags_.insert(transaction_tab);
+    auto end_transaction = [&]() {
+      persistent_item_drags_.erase(transaction_tab);
+    };
+    auto is_in_pin_tree = [](const tabs::TabCollection* collection,
+                             const tabs::TabStripCollection* owner) {
+      while (collection && collection != owner) {
+        if (collection == owner->pin_collection()) {
+          return true;
+        }
+        collection = collection->GetParentCollection();
+      }
+      return false;
+    };
+    auto restore_live_pin = [&]() {
+      tabs::TabInterface* rollback_tab = live_tab_handle.Get();
+      if (!rollback_tab) {
+        // Deletion observers own lifecycle cleanup. There is no ordinary tab
+        // left behind to conflict with the durable Pin.
+        return true;
+      }
+      BrowserWindowInterface* rollback_window =
+          rollback_tab->GetBrowserWindowInterface();
+      TabStripModel* rollback_model =
+          rollback_window ? rollback_window->GetTabStripModel() : nullptr;
+      Browser* rollback_browser =
+          rollback_window ? rollback_window->GetBrowserForMigrationOnly()
+                          : nullptr;
+      if (rollback_model != model || rollback_browser != browser ||
+          GetSpaceIdForBrowser(rollback_browser) != source_space_id) {
+        // A Pin cannot retain a live association after crossing its owning
+        // browser or Space boundary. Dematerialize it instead of moving the
+        // source Space's Pin into another browser's native collection.
+        DisassociateLiveTab(rollback_tab);
+        if (rollback_model) {
+          const int rollback_tab_index =
+              rollback_model->GetIndexOfTab(rollback_tab);
+          if (rollback_tab_index != TabStripModel::kNoTab) {
+            rollback_model->DetachAndDeleteWebContentsAt(rollback_tab_index);
+          }
+        }
+        RegisterDormantItems();
+        NotifyItemsChanged(PersistentItemChange::Space(
+            std::string(source_space_id)));
+        return true;
+      }
+      if (!rollback_model->Root() ||
+          rollback_model->GetIndexOfTab(rollback_tab) ==
+              TabStripModel::kNoTab) {
+        // A tearing-down or detached tab is not currently placed in this
+        // model. Its association remains intact until normal detach cleanup.
+        return true;
+      }
+      auto* rollback_strip = static_cast<tabs::TabStripCollection*>(
+          const_cast<tabs::TabCollection*>(rollback_model->Root()));
+      tabs::TabCollection* rollback_parent = original_parent_handle.Get();
+      size_t rollback_index = *original_direct_index;
+      if (!rollback_parent ||
+          !is_in_pin_tree(rollback_parent, rollback_strip)) {
+        // A synchronous observer may have removed an emptied folder. Root
+        // placement preserves the association until projection reconciliation
+        // restores the durable nesting.
+        rollback_parent = rollback_strip->pin_collection();
+        rollback_index = rollback_parent->ChildCount();
+      } else {
+        rollback_index =
+            std::min(rollback_index, rollback_parent->ChildCount());
+      }
+      tabs::TabCollection* current_parent =
+          const_cast<tabs::TabCollection*>(rollback_tab->GetParentCollection());
+      const std::optional<size_t> current_index =
+          current_parent ? current_parent->GetIndexOfTab(rollback_tab)
+                         : std::nullopt;
+      if (!rollback_strip->IsPinTab(rollback_tab) ||
+          current_parent != rollback_parent || !current_index ||
+          *current_index != rollback_index) {
+        rollback_model->MoveTabToPinCollection(rollback_tab, rollback_parent,
+                                               rollback_index);
+      }
+      return IsPersistentItemTab(rollback_tab) &&
+             rollback_strip->IsPinTab(rollback_tab);
+    };
+
+    model->MoveTabFromPin(live_tab);
+    if (pin_to_tab_conversion_hook_for_testing_) {
+      pin_to_tab_conversion_hook_for_testing_.Run(
+          PinToTabConversionPhaseForTesting::kAfterUnpin);
+    }
+    live_tab = live_tab_handle.Get();
+    before_tab = before_tab_handle ? before_tab_handle->Get() : nullptr;
+    BrowserWindowInterface* live_window =
+        live_tab ? live_tab->GetBrowserWindowInterface() : nullptr;
+    const int source_index =
+        live_tab ? model->GetIndexOfTab(live_tab) : TabStripModel::kNoTab;
+    if (!live_tab || !live_window ||
+        live_window->GetBrowserForMigrationOnly() != browser ||
+        live_window->GetTabStripModel() != model ||
+        source_index == TabStripModel::kNoTab ||
+        (before_tab_handle && !is_stable_ordinary_tab(before_tab))) {
+      const bool restored = restore_live_pin();
+      end_transaction();
+      if (!restored) {
+        NotifyItemsChanged(PersistentItemChange::Space(
+            std::string(source_space_id)));
+      }
+      return false;
+    }
+    int destination = model->count() - 1;
+    if (before_tab) {
+      destination = model->GetIndexOfTab(before_tab);
+      if (source_index < destination) {
+        --destination;
+      }
+    }
+    model->MoveWebContentsAt(source_index, destination,
+                             /*select_after_move=*/false,
+                             /*group=*/std::nullopt);
+    if (pin_to_tab_conversion_hook_for_testing_) {
+      pin_to_tab_conversion_hook_for_testing_.Run(
+          PinToTabConversionPhaseForTesting::kAfterPlacement);
+    }
+    before_tab = before_tab_handle ? before_tab_handle->Get() : nullptr;
+    const int final_index = model->GetIndexOfTab(live_tab);
+    const int final_before_index = before_tab_handle && before_tab
+                                       ? model->GetIndexOfTab(before_tab)
+                                       : TabStripModel::kNoTab;
+    const bool moved_to_target = before_tab_handle
+                                     ? final_index != TabStripModel::kNoTab &&
+                                           is_stable_ordinary_tab(before_tab) &&
+                                           final_index + 1 == final_before_index
+                                     : final_index != TabStripModel::kNoTab &&
+                                           final_index == model->count() - 1;
+    if (!moved_to_target) {
+      const bool restored = restore_live_pin();
+      end_transaction();
+      if (!restored) {
+        NotifyItemsChanged(PersistentItemChange::Space(
+            std::string(source_space_id)));
+      }
+      return false;
+    }
+
+    // Nothing after this point can fail. Drop the association only after the
+    // native move is known-good, then remove the durable record exactly once.
+    CHECK(IsPersistentItemTab(live_tab));
+    DisassociateLiveTab(live_tab);
+    end_transaction();
+  } else {
+    const int destination = before_tab ? model->GetIndexOfTab(before_tab) : -1;
+    content::WebContents* contents = chrome::AddAndReturnTabAt(
+        browser, link->url, destination, /*foreground=*/false);
+    tabs::TabInterface* created_tab =
+        contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+    tabs::TabInterface* current_before_tab =
+        before_tab_handle ? before_tab_handle->Get() : nullptr;
+    const int created_index =
+        created_tab ? model->GetIndexOfTab(created_tab) : TabStripModel::kNoTab;
+    const int current_before_index =
+        before_tab_handle && current_before_tab
+            ? model->GetIndexOfTab(current_before_tab)
+            : TabStripModel::kNoTab;
+    const bool inserted_at_target =
+        before_tab_handle ? is_stable_ordinary_tab(current_before_tab) &&
+                                created_index + 1 == current_before_index
+                          : created_index == model->count() - 1;
+    if (!created_tab || !is_stable_ordinary_tab(created_tab) ||
+        !inserted_at_target) {
+      if (created_index != TabStripModel::kNoTab) {
+        model->DetachAndDeleteWebContentsAt(created_index);
+      }
+      return false;
+    }
+  }
+
+  space->SetPins(std::move(staged_pins));
+  RegisterDormantItems();
+  NotifyItemsChanged(PersistentItemChange::Space(
+      std::string(source_space_id)));
+  return true;
+}
+
+void HeliumSpaceService::SetPinToTabConversionHookForTesting(
+    base::RepeatingCallback<void(PinToTabConversionPhaseForTesting)> hook) {
+  pin_to_tab_conversion_hook_for_testing_ = std::move(hook);
+}
