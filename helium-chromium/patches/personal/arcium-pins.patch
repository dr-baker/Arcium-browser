+void HeliumSpaceService::LoadAndMigrateFavorites() {
+  PrefService* prefs = profile_->GetPrefs();
+  const base::ListValue& encoded_favorites =
+      prefs->GetList(kHeliumFavoritesPref);
+  const auto decoded_favorites =
+      PersistentItemCodec::Decode(encoded_favorites, false);
+  if (decoded_favorites) {
+    local_favorites_ = *decoded_favorites;
+  }
+  if (decoded_favorites && encoded_favorites.empty()) {
+    // An empty normalized collection is the initial migration state. Import
+    // native pinned tabs once, then clear their legacy durable store below.
+    for (const StartupTab& tab : PinnedTabCodec::ReadPinnedTabs(profile_)) {
+      if (tab.url.is_valid() && !tab.url.is_empty() &&
+          tab.url.spec() != "about:blank") {
+        local_favorites_.push_back(
+            PersistentNode{.data = LinkFromStartupTab(tab)});
+      }
+    }
+  }
+  if (decoded_favorites) {
+    prefs->SetList(kHeliumFavoritesPref,
+                   PersistentItemCodec::Encode(local_favorites_));
+  }
+
+  base::DictValue imported =
+      prefs->GetDict(kHeliumArcFavoritesByProfilePref).Clone();
+  for (auto [profile_name, value] : imported) {
+    base::ListValue* list = value.GetIfList();
+    if (!list || PersistentItemCodec::Decode(*list, false) ||
+        !IsLegacyPinnedTabList(*list)) {
+      continue;
+    }
+    PersistentNodes converted;
+    for (const StartupTab& tab : PinnedTabCodec::DecodeTabs(*list)) {
+      PersistentLink link = LinkFromStartupTab(tab);
+      if (!link.id.starts_with("arc:")) {
+        link.id = ImportedId(profile_name, "favorite", link.id);
+      }
+      converted.push_back(PersistentNode{.data = std::move(link)});
+    }
+    *list = PersistentItemCodec::Encode(converted);
+  }
+  prefs->SetDict(kHeliumArcFavoritesByProfilePref, std::move(imported));
+
+  // Native pinned-tab restoration must never rematerialize durable Favorites.
+  PinnedTabCodec::WritePinnedTabs(profile_, {});
+}
 
