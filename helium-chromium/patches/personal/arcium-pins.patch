+
+views::ProposedLayout PinTabContainerView::CalculateProposedLayout(
+    const views::SizeBounds& size_bounds) const {
+  views::ProposedLayout layouts;
+  const bool stable_sidebar = UseSidebarProjection();
+  int width = 0;
+  int height = 0;
+  // Apply horizontal padding immediately at start of collapse animation by
+  // including collapsing state.
+  const int horizontal_padding =
+      GetLayoutConstant(LayoutConstant::kVerticalTabStripHorizontalPadding);
+  const bool is_compact = IsCompactSidebar();
+  std::vector<views::View*> children;
+  if (stable_sidebar && sidebar_preview_active_) {
+    children.reserve(this->children().size());
+    for (views::View* row : sidebar_preview_order_) {
+      children.push_back(row);
+    }
+    for (views::View* child : this->children()) {
+      if (!std::ranges::contains(children, child)) {
+        children.push_back(child);
+      }
+    }
+  } else {
+    children.assign(this->children().begin(), this->children().end());
+  }
+
+  // Layout children in order. Children will have their preferred height and
+  // fill available width.
+  bool has_flow_child = false;
+  const bool leaving_section =
+      IsHandlingDrag() && GetDragHandler().GetPersistentTabDropTarget() !=
+                              PersistentTabDropTarget::kPin;
+  for (size_t child_index = 0; child_index < children.size(); ++child_index) {
+    views::View* child = children[child_index];
+    if (external_drop_index_ && *external_drop_index_ == child_index) {
+      height += GetLayoutConstant(LayoutConstant::kVerticalTabHeight) +
+                kTabVerticalPadding;
+    }
+    const bool preview_visible = !sidebar_preview_active_ ||
+                                 sidebar_preview_visible_rows_.contains(child);
+    const bool child_visible =
+        stable_sidebar ? row_ids_.contains(child) && preview_visible
+                       : child->GetVisible() && preview_visible;
+    if (!child_visible) {
+      layouts.child_layouts.emplace_back(child, false, child->bounds());
+      continue;
+    }
+    // The leading inset should not be applied for tab groups when the tab strip
+    // is collapsed since the group color line is drawn in that space.
+    const auto& depths =
+        !sidebar_preview_active_ ? row_depths_ : sidebar_preview_depths_;
+    const auto depth = depths.find(child);
+    int x = horizontal_padding + (is_compact || depth == depths.end()
+                                      ? 0
+                                      : depth->second * kPersistentDepthIndent);
+    views::SizeBounds child_size_bounds =
+        views::SizeBounds(size_bounds.width().is_bounded()
+                              ? (size_bounds.width() - (x + horizontal_padding))
+                              : size_bounds.width(),
+                          {});
+    gfx::Rect bounds = gfx::Rect(child->GetPreferredSize(child_size_bounds));
+    bounds.set_x(x);
+
+    const PersistentDragPresentation::Entry* persistent_drag_entry = nullptr;
+    if (persistent_drag_presentation_) {
+      const auto entry = std::ranges::find_if(
+          persistent_drag_presentation_->entries,
+          [child](const PersistentDragPresentation::Entry& entry) {
+            return entry.view == child;
+          });
+      if (entry != persistent_drag_presentation_->entries.end()) {
+        persistent_drag_entry = &*entry;
+      }
+    }
+    const int flow_height = bounds.height();
+
+    auto drag_data = GetVisualDataForDraggedView(*child);
+    CHECK(!drag_data || !drag_data->should_hide);
+    if (persistent_drag_entry) {
+      // Persistent rows use a compositor transform while the projected order
+      // reserves their destination slots. Keeping their base bounds fixed
+      // prevents layout animation from fighting pointer motion.
+      bounds = persistent_drag_entry->source_bounds;
+    } else {
+      bounds.set_y(drag_data ? drag_data->offset.y() : height);
+    }
+
+    // If width is bounded, child views should respect the width constraints and
+    // take up the available width excluding trailing horizontal padding.
+    if (size_bounds.width().is_bounded()) {
+      bounds.set_width(size_bounds.width().value() - bounds.x() -
+                       horizontal_padding);
+    }
+    layouts.child_layouts.emplace_back(child, true, bounds);
+    const bool persistent_row_leaving =
+        persistent_drag_entry && sidebar_drag_over_tabs_;
+    if (!(drag_data && leaving_section) && !persistent_row_leaving) {
+      height += flow_height + kTabVerticalPadding;
+      has_flow_child = true;
+    }
+    width = std::max(width, bounds.width() + bounds.x());
+  }
+  // Remove excess padding if needed.
+  if (has_flow_child) {
+    height -= kTabVerticalPadding;
+  }
+  if (external_drop_index_ && *external_drop_index_ >= children.size()) {
+    height += GetLayoutConstant(LayoutConstant::kVerticalTabHeight) +
+              (has_flow_child ? kTabVerticalPadding : 0);
+  }
+
+  // A transformed live row may cross the semantic Pin/tab boundary, but its
+  // source renderer must not move that boundary by growing around the drag.
+  layouts.host_size = gfx::Size(width, height);
+  return layouts;
+}
+
+gfx::Size PinTabContainerView::GetMinimumSize() const {
+  if (!collection_node_) {
+    return gfx::Size();
+  }
+
+  // The minimum size should be enough to show a tab and a half, if needed.
+  const int num_children = static_cast<int>(std::ranges::count_if(
+      children(),
+      [](const views::View* child) { return child->GetVisible(); }));
+  const int min_height =
+      base::ClampCeil(GetLayoutConstant(LayoutConstant::kVerticalTabHeight) *
+                      std::min(1.5f, static_cast<float>(num_children))) +
+      (num_children > 1 ? kTabVerticalPadding : 0);
+  return gfx::Size(GetLayoutConstant(LayoutConstant::kVerticalTabMinWidth),
+                   min_height);
+}
+
+views::View* PinTabContainerView::AddChildWithoutAnimation(
+    std::unique_ptr<views::View> child) {
+  views::View* added_child = AddChildView(std::move(child));
+  if (UseSidebarProjection() && IsCollectionOwnedChild(*added_child)) {
+    added_child->SetVisible(false);
+  }
+  if (auto* tab_view = views::AsViewClass<TabView>(added_child)) {
+    tabs::ConstChildPtr node_data = tab_view->collection_node()->GetNodeData();
+    const auto* tab = std::get_if<const tabs::TabInterface*>(&node_data);
+    if (tab && space_service_ && space_service_->IsPersistentItemTab(*tab)) {
+      // Reconciliation will reveal this native row at the durable record's
+      // exact location. Keep it hidden during the synchronous collection move
+      // so activation never flashes a duplicate row at the container edge.
+      added_child->SetVisible(false);
+    }
+  }
+  if (added_child->layer()) {
+    // The source collection may have created a temporary translucent layer
+    // for its add/reparent animation. This path intentionally skips that
+    // animation, so remove the layer just as the animation manager does when
+    // an animation completes. Leaving it attached violates Label's opaque
+    // text-painting invariant once the Pins scroll view becomes visible.
+    added_child->DestroyLayer();
+  }
+  if (!UseSidebarProjection()) {
+    layout_manager_->ResetViewsToTargetLayout({added_child});
+  }
+  return added_child;
+}
+
+views::View* PinTabContainerView::GetVisibleRowForTab(
+    const tabs::TabInterface& tab) const {
+  if (!UseSidebarProjection() || !space_service_ || !collection_node_ ||
+      !collection_node_->GetController()) {
+    return nullptr;
+  }
+
+  const std::optional<helium::PersistentRecordKind> kind =
+      space_service_->GetPersistentItemKind(&tab);
+  const std::optional<std::string> id =
+      space_service_->GetPersistentItemId(&tab);
+  BrowserView* const browser_view =
+      collection_node_->GetController()->GetBrowserView();
+  Browser* const browser = browser_view ? browser_view->browser() : nullptr;
+  if (!kind || !id || !browser) {
+    return nullptr;
+  }
+
+  const std::string key = PersistentLinkKey(
+      *kind, space_service_->GetSpaceIdForBrowser(browser), *id);
+  const auto row = persistent_rows_.find(key);
+  return row != persistent_rows_.end() && row->second->GetVisible()
+             ? row->second.get()
+             : nullptr;
+}
+
+std::optional<BrowserRootView::DropIndex> PinTabContainerView::GetLinkDropIndex(
+    const gfx::Point& loc_in_container) {
+  // Persistent Favorites and Pins are model records, not collection nodes.
+  // Link drops cannot create legacy tab-backed pins in this virtual region.
+  return std::nullopt;
+}
+
+bool PinTabContainerView::IsDragging() const {
+  if (persistent_drag_view_) {
+    return true;
+  }
+  if (!collection_node_ || !collection_node_->GetController()) {
+    return false;
+  }
+  return GetDragHandler().IsDragging();
+}
+
+bool PinTabContainerView::IsViewDragging(const views::View& child_view) const {
+  if (IsPersistentDragPresentationView(child_view)) {
+    return true;
+  }
+  if (!collection_node_ || !collection_node_->GetController()) {
+    return false;
+  }
+  return GetDragHandler().IsViewDragging(child_view);
+}
+
+bool PinTabContainerView::ShouldAnimateOpacityForAddAndRemove(
+    const views::View& child_view) const {
+  // Only animate opacity for tab views.
+  return views::IsViewClass<TabView>(&child_view);
+}
+
+bool PinTabContainerView::ShouldSnapToTarget(
+    const views::View& child_view) const {
+  return views::IsViewClass<SplitTabView>(&child_view);
+}
+
+void PinTabContainerView::ResetCollectionNode() {
+  ClearPersistentDragPresentation();
+  if (!UseSidebarProjection()) {
+    if (TabStripView* tab_strip = GetTabStripView(this)) {
+      tab_strip->CancelPersistentRowReplacement();
+    }
+  }
+  pending_replacement_key_.reset();
+  sidebar_projection_.reset();
+  sidebar_drag_transaction_.reset();
+  sidebar_drop_target_.reset();
+  sidebar_preview_placement_.reset();
+  sidebar_preview_order_.clear();
+  sidebar_preview_depths_.clear();
+  sidebar_preview_visible_rows_.clear();
+  sidebar_preview_active_ = false;
+  sidebar_drag_browser_ = nullptr;
+  sidebar_drag_space_id_.clear();
+  sidebar_drag_over_pins_ = false;
+  sidebar_context_controller_identity_ = 0;
+  sidebar_context_space_id_.clear();
+  ++sidebar_context_generation_;
+  CHECK_NE(sidebar_context_generation_, 0u);
+  persistent_drag_view_ = nullptr;
+  persistent_drag_id_.clear();
+  persistent_drag_space_id_.clear();
+  persistent_drag_location_ = {};
+  persistent_drag_over_tabs_ = false;
+  persistent_tab_drop_before_.reset();
+  ClearPersistentTabDragPreview();
+  row_depths_.clear();
+  row_ids_.clear();
+  row_parent_ids_.clear();
+  row_space_ids_.clear();
+  row_is_folders_.clear();
+  folder_connectors_.clear();
+  collapse_state_subscription_ = {};
+  items_changed_subscription_ = {};
+  if (observed_tab_strip_model_) {
+    observed_tab_strip_model_->RemoveObserver(this);
+    observed_tab_strip_model_ = nullptr;
+  }
+  collection_node_ = nullptr;
+  space_service_ = nullptr;
+}
+
+void PinTabContainerView::OnPersistentItemsChanged(
+    const helium::PersistentItemChange& change) {
+  if (!collection_node_ || !space_service_) {
+    return;
+  }
+  auto* controller = collection_node_->GetController();
+  BrowserView* browser_view =
+      controller ? controller->GetBrowserView() : nullptr;
+  Browser* browser = browser_view ? browser_view->browser() : nullptr;
+  if (!browser ||
+      !change.AffectsPins(space_service_->GetSpaceIdForBrowser(browser),
+                          browser->session_id())) {
+    return;
+  }
+  ScheduleReconcilePersistentRows();
+}
+
+void PinTabContainerView::ScheduleReconcilePersistentRows() {
+  if (reconcile_scheduled_) {
+    return;
+  }
+  reconcile_scheduled_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&PinTabContainerView::ReconcilePersistentRows,
+                                weak_ptr_factory_.GetWeakPtr()));
+}
+
+void PinTabContainerView::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange&,
+    const TabStripSelectionChange& selection) {
+  if (UseSidebarProjection() && tab_strip_model == observed_tab_strip_model_ &&
+      selection.active_tab_changed()) {
+    ScheduleReconcilePersistentRows();
+  }
+}
+
+void PinTabContainerView::OnTabChangedAt(tabs::TabInterface* tab,
+                                         int,
+                                         TabChangeType change_type) {
+  if (UseSidebarProjection() && space_service_ && tab &&
+      space_service_->IsPersistentItemTab(tab) &&
+      (change_type == TabChangeType::kAll ||
+       change_type == TabChangeType::kLoadingOnly)) {
+    ScheduleReconcilePersistentRows();
+  }
+}
+
+void PinTabContainerView::OnTabStripModelDestroyed(
+    TabStripModel* tab_strip_model) {
+  if (tab_strip_model == observed_tab_strip_model_) {
+    observed_tab_strip_model_ = nullptr;
+  }
+}
+
+void PinTabContainerView::RemoveCollectionChild(views::View* child) {
+  row_depths_.erase(child);
+  row_ids_.erase(child);
+  row_parent_ids_.erase(child);
+  row_space_ids_.erase(child);
+  row_is_folders_.erase(child);
+  folder_connectors_.clear();
+  if (UseSidebarProjection()) {
+    // Native Pin views are never presentation rows in projection mode. Their
+    // normal close animation makes the removed view a temporary layout child;
+    // once its collection node is gone, that can expose it below the durable
+    // Pin tree as a ghost ordinary tab. Destroy the hidden implementation view
+    // at the confirmed model-removal boundary. Ordinary tab containers retain
+    // Chromium's native close animation.
+    child->SetVisible(false);
+    RemoveChildViewT(child);
+    ScheduleReconcilePersistentRows();
+    return;
+  }
+  layout_manager_->AnimateAndDestroyChildView(child);
+}
+
+void PinTabContainerView::AttachCollectionChild(
+    std::unique_ptr<views::View> child,
+    const gfx::Rect& previous_bounds_in_screen) {
+  if (!UseSidebarProjection()) {
+    layout_manager_->AnimateAndReparentView(std::move(child),
+                                           previous_bounds_in_screen);
+    return;
+  }
+
+  // The durable projection owns every visible Pin row. Native TabViews remain
+  // hidden implementation details and must not inherit transfer-animation
+  // state that could briefly make them visible outside the projection.
+  AddChildWithoutAnimation(std::move(child));
+  ScheduleReconcilePersistentRows();
+}
+
+bool PinTabContainerView::IsCollectionOwnedChild(
+    const views::View& child) const {
+  if (!collection_node_) {
+    return false;
+  }
+  return std::ranges::any_of(
+      collection_node_->children(),
+      [&](const auto& child_node) { return child_node->view() == &child; });
+}
+
+bool PinTabContainerView::IsCompactSidebar() const {
+  return GetTabStripCollapseState() !=
+         tabs::VerticalTabStripCollapseState::kExpanded;
+}
+
+void PinTabContainerView::OnCollapseStateChanged(
+    tabs::VerticalTabStripCollapseState collapse_state) {
+  UpdatePersistentRowPresentation(
+      collapse_state != tabs::VerticalTabStripCollapseState::kExpanded);
+  InvalidateLayout();
+  PreferredSizeChanged();
+  SchedulePaint();
+}
+
+void PinTabContainerView::UpdatePersistentRowPresentation(bool compact) {
+  for (const auto& entry : persistent_rows_) {
+    auto* folder_row = views::AsViewClass<PersistentFolderRow>(entry.second);
+    if (folder_row) {
+      folder_row->UpdatePresentation(compact);
+    }
+  }
+}
+
+void PinTabContainerView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+
+  if (sidebar_preview_active_ || !IsCompactSidebar() ||
+      folder_connectors_.empty() || width() < 3 || !GetColorProvider()) {
+    return;
+  }
+
+  cc::PaintFlags flags;
+  flags.setStyle(cc::PaintFlags::kFill_Style);
+  flags.setColor(SkColorSetA(
+      GetColorProvider()->GetColor(ui::kColorSysOnSurfaceSubtle), 128));
+
+  for (const PersistentFolderConnector& connector : folder_connectors_) {
+    if (!connector.folder || !connector.last_descendant ||
+        !connector.folder->GetVisible() ||
+        !connector.last_descendant->GetVisible()) {
+      continue;
+    }
+
+    const gfx::Rect folder_bounds = connector.folder->bounds();
+    const gfx::Rect last_descendant_bounds =
+        connector.last_descendant->bounds();
+    const int start_y = folder_bounds.CenterPoint().y();
+    const int end_y = last_descendant_bounds.CenterPoint().y();
+    if (end_y <= start_y) {
+      continue;
+    }
+
+    const int center_x = folder_bounds.CenterPoint().x();
+    const int lane = std::clamp(connector.depth, 0, kConnectorMaxLane);
+    const int line_x =
+        std::clamp(center_x - kConnectorLeadingInset + lane * kConnectorLaneGap,
+                   1, width() - 2);
+    canvas->DrawRect(gfx::Rect(line_x, start_y, 1, end_y - start_y + 1), flags);
+    const int folder_elbow_end = std::max(line_x, center_x - kConnectorIconGap);
+    canvas->DrawRect(
+        gfx::Rect(line_x, start_y, folder_elbow_end - line_x + 1, 1), flags);
+
+    // Branch only to immediate children. Nested folder connectors provide the
+    // next level without turning the compact rail into a mesh of lines.
+    bool in_range = false;
+    for (views::View* child : children()) {
+      if (child == connector.folder) {
+        in_range = true;
+        continue;
+      }
+      if (!in_range) {
+        continue;
+      }
+
+      const auto depth = row_depths_.find(child);
+      if (depth != row_depths_.end() && depth->second == connector.depth + 1 &&
+          child->GetVisible()) {
+        const int child_center_y = child->bounds().CenterPoint().y();
+        const int branch_end = std::max(
+            line_x, child->bounds().CenterPoint().x() - kConnectorIconGap);
+        canvas->DrawRect(
+            gfx::Rect(line_x, child_center_y, branch_end - line_x + 1, 1),
+            flags);
+      }
+
+      if (child == connector.last_descendant) {
+        break;
+      }
+    }
+  }
+}
+
+void PinTabContainerView::ReconcilePersistentRows() {
+  reconcile_scheduled_ = false;
+  if (!collection_node_ || !space_service_) {
+    return;
+  }
+  BrowserView* browser_view =
+      collection_node_->GetController()->GetBrowserView();
+  Browser* browser = browser_view ? browser_view->browser() : nullptr;
+  if (!browser) {
+    return;
+  }
+  const bool stable_sidebar = UseSidebarProjection();
+  if (stable_sidebar &&
+      (persistent_drag_view_ || GetDragHandler().IsDragging())) {
+    return;
+  }
+  if (stable_sidebar) {
+    RestoreSidebarProjectionOrder();
+  }
+
+  // A live TabView stays owned by its TabCollectionNode. Hide associated
+  // native rows first, then reveal only those represented by the flattened
+  // durable tree below. This keeps inactive descendants of collapsed folders
+  // from leaking out at the end of the list.
+  for (const auto& child_node : collection_node_->children()) {
+    if (stable_sidebar) {
+      if (child_node->view()) {
+        child_node->view()->SetVisible(false);
+      }
+      continue;
+    }
+    tabs::ConstChildPtr node_data = child_node->GetNodeData();
+    const auto* tab = std::get_if<const tabs::TabInterface*>(&node_data);
+    if (tab && space_service_->IsPersistentItemTab(*tab) &&
+        child_node->view()) {
+      child_node->view()->SetVisible(false);
+    }
+  }
+
+  const std::string space_id(space_service_->GetSpaceIdForBrowser(browser));
+  const uintptr_t controller_identity =
+      reinterpret_cast<uintptr_t>(collection_node_->GetController());
+  if (stable_sidebar &&
+      (sidebar_context_controller_identity_ != controller_identity ||
+       sidebar_context_space_id_ != space_id)) {
+    sidebar_context_controller_identity_ = controller_identity;
+    sidebar_context_space_id_ = space_id;
+    ++sidebar_context_generation_;
+    CHECK_NE(sidebar_context_generation_, 0u);
+  }
+  auto projection = BuildSidebarProjection(browser);
+  if (!projection || !projection->valid()) {
+    sidebar_projection_.reset();
+    row_depths_.clear();
+    row_ids_.clear();
+    row_parent_ids_.clear();
+    row_space_ids_.clear();
+    row_is_folders_.clear();
+    folder_connectors_.clear();
+    for (const auto& [key, row] : persistent_rows_) {
+      row->SetVisible(false);
+    }
+    InvalidateLayout();
+    PreferredSizeChanged();
+    return;
+  }
+  const helium::HeliumSidebarPinProjection* row_projection = projection.get();
+  if (stable_sidebar) {
+    sidebar_projection_ = std::move(projection);
+    row_projection = sidebar_projection_.get();
+  } else {
+    sidebar_projection_.reset();
+  }
+
+  std::set<std::string, std::less<>> desired_keys;
+  std::vector<views::View*> displayed_rows;
+  std::vector<int> displayed_depths;
+  std::vector<bool> displayed_folders;
+  std::vector<bool> displayed_collapsed;
+  const size_t row_count = row_projection->rows().size();
+  displayed_rows.reserve(row_count);
+  displayed_depths.reserve(row_count);
+  displayed_folders.reserve(row_count);
+  displayed_collapsed.reserve(row_count);
+  size_t target_index = 0;
+  views::View* replacement_native_row = nullptr;
+  auto reconcile_row =
+      [&](const std::string& key, std::string_view id,
+          helium::PersistentRecordKind kind, int depth,
+          std::string_view parent_id, bool folder, bool collapsed,
+          bool selected, tabs::TabInterface* live_tab,
+          const std::u16string& title, const GURL& url) {
+    const std::string item_id(id);
+    desired_keys.insert(key);
+    views::View* row = nullptr;
+    const auto existing = persistent_rows_.find(key);
+    if (existing != persistent_rows_.end()) {
+      row = existing->second;
+    } else if (folder) {
+      auto folder_row = std::make_unique<PersistentFolderRow>(
+          base::BindRepeating(&PinTabContainerView::ToggleFolder,
+                              weak_ptr_factory_.GetWeakPtr(), kind, item_id,
+                              space_id),
+          title, item_id,
+          base::BindRepeating(&PinTabContainerView::BeginPersistentFolderDrag,
+                              base::Unretained(this)),
+          base::BindRepeating(&PinTabContainerView::UpdatePersistentFolderDrag,
+                              weak_ptr_factory_.GetWeakPtr()),
+          base::BindRepeating(&PinTabContainerView::EndPersistentFolderDrag,
+                              weak_ptr_factory_.GetWeakPtr()),
+          base::BindRepeating(&PinTabContainerView::CancelPersistentTreeDrag,
+                              weak_ptr_factory_.GetWeakPtr()));
+      folder_row->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      row = AddChildWithoutAnimation(std::move(folder_row));
+      persistent_rows_.emplace(key, row);
+    } else {
+      auto link_row = std::make_unique<PersistentTabView>(
+          browser_view->GetProfile(), item_id, title, url,
+          PersistentTabView::PresentationMode::kFullRow,
+          base::BindRepeating(&PinTabContainerView::ActivatePersistentItem,
+                              weak_ptr_factory_.GetWeakPtr(), kind, item_id,
+                              space_id),
+          base::BindRepeating(&PinTabContainerView::RemovePersistentItem,
+                              weak_ptr_factory_.GetWeakPtr(), kind, item_id,
+                              space_id),
+          base::BindRepeating(&PinTabContainerView::FavoritePersistentItem,
+                              weak_ptr_factory_.GetWeakPtr(), kind, item_id,
+                              space_id),
+          this);
+      row = AddChildWithoutAnimation(std::move(link_row));
+      persistent_rows_.emplace(key, row);
+    }
+
+    if (folder) {
+      auto* folder_row = views::AsViewClass<views::LabelButton>(row);
+      CHECK(folder_row);
+      auto* persistent_folder_row =
+          views::AsViewClass<PersistentFolderRow>(folder_row);
+      CHECK(persistent_folder_row);
+      persistent_folder_row->SetFolderState(title, collapsed);
+    } else {
+      auto* link_row = views::AsViewClass<PersistentTabView>(row);
+      CHECK(link_row);
+      if (stable_sidebar) {
+        PersistentTabView::PresentationState presentation{
+            .live = live_tab != nullptr,
+            .selected = selected,
+            .network_state = live_tab
+                                 ? tabs::TabNetworkStateForWebContents(
+                                       live_tab->GetContents())
+                                 : tabs::TabNetworkState::kNone,
+        };
+        if (live_tab) {
+          presentation.dematerialize_callback = base::BindRepeating(
+              [](base::WeakPtr<PinTabContainerView> container,
+                 helium::PersistentRecordKind kind, const std::string& id,
+                 const std::string& source_space_id) {
+                return container && container->DematerializePersistentItem(
+                                        kind, id, source_space_id);
+              },
+              weak_ptr_factory_.GetWeakPtr(), kind, item_id, space_id);
+        }
+        link_row->UpdatePresentation(title, url, std::move(presentation));
+      } else {
+        link_row->Update(title, url, selected);
+      }
+    }
+
+    TabView* live_tab_view = nullptr;
+    if (!stable_sidebar && live_tab) {
+      TabCollectionNode* live_node =
+          collection_node_->GetNodeForHandle(live_tab->GetHandle());
+      live_tab_view =
+          live_node ? views::AsViewClass<TabView>(live_node->view()) : nullptr;
+      if (live_tab_view && live_tab_view->parent() != this) {
+        live_tab_view = nullptr;
+      }
+    }
+
+    row->SetVisible(stable_sidebar || !live_tab_view);
+    views::View* displayed_row =
+        stable_sidebar || !live_tab_view ? row : live_tab_view;
+    DCHECK(!stable_sidebar || !IsCollectionOwnedChild(*displayed_row));
+    displayed_row->SetVisible(true);
+    row_depths_[displayed_row] = depth;
+    row_ids_[displayed_row] = item_id;
+    row_parent_ids_[displayed_row] = std::string(parent_id);
+    row_space_ids_[displayed_row] = space_id;
+    row_is_folders_[displayed_row] = folder;
+    displayed_rows.push_back(displayed_row);
+    displayed_depths.push_back(depth);
+    displayed_folders.push_back(folder);
+    displayed_collapsed.push_back(collapsed);
+    ReorderChildView(displayed_row, target_index++);
+    if (!stable_sidebar && pending_replacement_key_ == key && live_tab_view) {
+      replacement_native_row = live_tab_view;
+    }
+  };
+
+  for (const helium::SidebarPinRow& row : row_projection->rows()) {
+    CHECK_EQ(row.key.space_id, space_id);
+    const bool folder = row.kind == helium::SidebarPinRowKind::kFolder;
+    tabs::TabInterface* live_tab =
+        row.live_tab_handle ? tabs::TabHandle(*row.live_tab_handle).Get()
+                            : nullptr;
+    reconcile_row(folder ? PersistentFolderKey(
+                               helium::PersistentRecordKind::kPin, space_id,
+                               row.key.item_id)
+                         : PersistentLinkKey(
+                               helium::PersistentRecordKind::kPin, space_id,
+                               row.key.item_id),
+                  row.key.item_id, helium::PersistentRecordKind::kPin,
+                  static_cast<int>(row.depth),
+                  row.parent ? row.parent->item_id : std::string(), folder,
+                  row.collapsed, row.selected, live_tab, row.title, row.url);
+  }
+
+  for (auto it = persistent_rows_.begin(); it != persistent_rows_.end();) {
+    if (desired_keys.contains(it->first)) {
+      ++it;
+      continue;
+    }
+    views::View* stale_row = it->second;
+    if (persistent_drag_view_ == stale_row) {
+      CancelPersistentTreeDrag(*stale_row);
+    }
+    row_depths_.erase(stale_row);
+    row_ids_.erase(stale_row);
+    row_parent_ids_.erase(stale_row);
+    row_space_ids_.erase(stale_row);
+    row_is_folders_.erase(stale_row);
+    RemoveChildViewT(stale_row);
+    it = persistent_rows_.erase(it);
+  }
+
+  UpdatePersistentRowPresentation(IsCompactSidebar());
+
+  folder_connectors_.clear();
+  for (size_t index = 0; index < displayed_rows.size(); ++index) {
+    if (!displayed_folders[index] || displayed_collapsed[index]) {
+      continue;
+    }
+    size_t last_descendant = index;
+    while (last_descendant + 1 < displayed_rows.size() &&
+           displayed_depths[last_descendant + 1] > displayed_depths[index]) {
+      ++last_descendant;
+    }
+    if (last_descendant > index && last_descendant < displayed_rows.size()) {
+      folder_connectors_.push_back({displayed_rows[index],
+                                    displayed_rows[last_descendant],
+                                    displayed_depths[index]});
+    }
+  }
+
+  if (!stable_sidebar) {
+    std::vector<const views::View*> views_to_snap(children().begin(),
+                                                  children().end());
+    layout_manager_->ResetViewsToTargetLayout(views_to_snap);
+  }
+  InvalidateLayout();
+  PreferredSizeChanged();
+
+  if (!stable_sidebar && pending_replacement_key_) {
+    if (TabStripView* tab_strip = GetTabStripView(this)) {
+      if (replacement_native_row) {
+        tab_strip->CompletePersistentRowReplacement(replacement_native_row);
+      } else {
+        tab_strip->CancelPersistentRowReplacement();
+      }
+    }
+    pending_replacement_key_.reset();
+  }
+}
+
+void PinTabContainerView::ActivatePersistentItem(
+    helium::PersistentRecordKind kind,
+    std::string id,
+    std::string source_space_id) {
+  if (!collection_node_ || !collection_node_->GetController() ||
+      !space_service_) {
+    return;
+  }
+  BrowserView* browser_view =
+      collection_node_->GetController()->GetBrowserView();
+  if (browser_view && space_service_) {
+    Browser* browser = browser_view->browser();
+    if (UseSidebarProjection() &&
+        space_service_->GetSpaceIdForBrowser(browser) != source_space_id) {
+      return;
+    }
+    if (UseSidebarProjection()) {
+      space_service_->ActivatePersistentItem(browser, kind, id);
+      return;
+    }
+    const std::string key = PersistentLinkKey(
+        kind, space_service_->GetSpaceIdForBrowser(browser), id);
+    const auto row = persistent_rows_.find(key);
+    TabStripView* tab_strip = GetTabStripView(this);
+    if (row != persistent_rows_.end() && tab_strip) {
+      tab_strip->BeginPersistentRowReplacement(row->second);
+      pending_replacement_key_ = key;
+    }
+    if (!space_service_->ActivatePersistentItem(browser_view->browser(), kind,
+                                                id)) {
+      if (tab_strip) {
+        tab_strip->CancelPersistentRowReplacement();
+      }
+      pending_replacement_key_.reset();
+    }
+  }
+}
+
+bool PinTabContainerView::DematerializePersistentItem(
+    helium::PersistentRecordKind kind,
+    std::string id,
+    std::string source_space_id) {
+  if (!UseSidebarProjection() || !collection_node_ ||
+      !collection_node_->GetController() || !space_service_) {
+    return false;
+  }
+  BrowserView* browser_view =
+      collection_node_->GetController()->GetBrowserView();
+  Browser* browser = browser_view ? browser_view->browser() : nullptr;
+  if (!browser ||
+      space_service_->GetSpaceIdForBrowser(browser) != source_space_id) {
+    return false;
+  }
+  return space_service_->ClosePersistentItemInstance(browser, kind, id,
+                                                     source_space_id);
+}
+
+void PinTabContainerView::RemovePersistentItem(
+    helium::PersistentRecordKind kind,
+    std::string id,
+    std::string source_space_id) {
+  if (!collection_node_ || !collection_node_->GetController() ||
+      !space_service_) {
+    return;
