+      model()->GetIndexOfTab(original_source));
+  base::RunLoop().RunUntilIdle();
+  ASSERT_FALSE(original_state.handle.Get());
+
+  // Match session restoration order: restore each saved association and native
+  // placement before restoring its split. The companion has no runtime marker.
+  auto* source = AddOrdinaryTab("https://saved.test/edit");
+  ASSERT_TRUE(service_->RestorePersistentItemFromSession(source, extra_data));
+  if (GetParam() == SavedSourceKind::kFolderPin) {
+    PlacePinInDurableFolder(source);
