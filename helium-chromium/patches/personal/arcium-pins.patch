+std::string MakeItemKeyForSpace(PersistentRecordKind kind,
+                                std::string_view space_id,
+                                std::string_view id) {
+  if (kind == PersistentRecordKind::kFavorite) {
+    return base::StrCat({"f:", id});
+  }
+  return base::StrCat({"p:", space_id, ":", id});
+}
+
+template <typename UsageMap>
+void AppendOmniboxItems(const PersistentNodes& nodes,
+                        PersistentRecordKind kind,
+                        std::string_view space_id,
+                        std::u16string_view space_name,
+                        OmniboxItemTier tier,
+                        const UsageMap& usage,
+                        const PersistentItemLifecycle& lifecycle,
+                        std::vector<std::u16string> folder_path,
+                        std::vector<PersistentOmniboxItem>* items) {
+  for (const PersistentNode& node : nodes) {
+    if (const auto* link = std::get_if<PersistentLink>(&node.data)) {
+      const std::string key = MakeItemKeyForSpace(kind, space_id, link->id);
+      PersistentOmniboxItem item;
+      item.kind = kind;
+      item.id = link->id;
+      item.space_id = std::string(space_id);
+      item.space_name = std::u16string(space_name);
+      item.folder_path = folder_path;
+      item.title = link->title;
+      item.url = link->url;
+      item.tier = tier;
+      const auto state = lifecycle.GetState(key);
+      item.is_live =
+          state && (*state == PersistentItemLifecycle::State::kLive ||
+                    *state == PersistentItemLifecycle::State::kClosing);
+      if (const auto usage_entry = usage.find(key);
+          usage_entry != usage.end()) {
+        item.use_count = usage_entry->second.count;
+        item.last_used_internal_value =
+            usage_entry->second.last_used.ToInternalValue();
+      }
+      if (lifecycle.GetLiveTab(key)) {
+        // The service owns the association map, so active state is filled by
+        // the caller after this pure tree walk. Keep this branch intentionally
+        // cheap; it only distinguishes a live identity here.
+        item.is_live = true;
+      }
+      items->push_back(std::move(item));
+      continue;
+    }
+    const PersistentFolder& folder = std::get<PersistentFolder>(node.data);
+    folder_path.push_back(folder.title);
+    AppendOmniboxItems(folder.children, kind, space_id, space_name, tier, usage,
+                       lifecycle, folder_path, items);
+    folder_path.pop_back();
+  }
+}
