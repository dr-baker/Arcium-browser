+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_sidebar_drag_transaction.h"
+
+#include <utility>
+
+namespace helium {
+
+SidebarDragTransaction::SidebarDragTransaction(SidebarDragSource source)
+    : source_(std::move(source)) {}
+
+SidebarDragTransaction::~SidebarDragTransaction() = default;
+
+bool SidebarDragTransaction::UpdatePreview(SidebarDropIntent intent) {
+  if (!active_) {
+    return false;
+  }
+  preview_ = std::move(intent);
+  return true;
+}
+
+SidebarDragAction SidebarDragTransaction::preview_action() const {
+  if (!preview_) {
+    return SidebarDragAction::kNone;
+  }
+  return ClassifyAction(source_.placement, preview_->placement);
+}
+
+SidebarDragResult SidebarDragTransaction::Cancel() {
+  if (!active_) {
+    return {.outcome = SidebarDragOutcome::kRejectedFinished};
+  }
+  return Finish(SidebarDragOutcome::kCancelled);
+}
+
+SidebarDragResult SidebarDragTransaction::Commit(
+    const SidebarDragRevalidation& revalidation) {
+  if (!active_) {
+    return {.outcome = SidebarDragOutcome::kRejectedFinished};
+  }
+  if (!preview_) {
+    return Finish(SidebarDragOutcome::kRejectedNoPreview);
+  }
+  if (!revalidation.source) {
+    return Finish(SidebarDragOutcome::kRejectedSourceMissing);
+  }
+
+  const SidebarDragSource& current_source = *revalidation.source;
+  if (current_source.item_id != source_.item_id ||
+      current_source.kind != source_.kind) {
+    return Finish(SidebarDragOutcome::kRejectedSourceChanged);
+  }
+  if (current_source.context != source_.context ||
+      preview_->context != source_.context ||
+      revalidation.target_context != preview_->context) {
+    return Finish(SidebarDragOutcome::kRejectedContextMismatch);
+  }
+  if (current_source.placement != source_.placement) {
+    return Finish(SidebarDragOutcome::kRejectedSourceChanged);
+  }
+
+  const SidebarItemPlacement& target = preview_->placement;
+  if (!revalidation.target_section_accepts_source ||
+      (!target.parent_id.empty() &&
+       (!revalidation.target_parent_exists ||
+        !revalidation.target_parent_accepts_source)) ||
+      (!target.before_id.empty() && !revalidation.before_id_is_direct_child) ||
+      target.before_id == source_.item_id) {
+    return Finish(SidebarDragOutcome::kRejectedInvalidTarget);
+  }
+  if (source_.kind == SidebarItemKind::kFolder &&
+      (target.parent_id == source_.item_id ||
+       revalidation.target_parent_is_source_or_descendant)) {
+    return Finish(SidebarDragOutcome::kRejectedFolderCycle);
+  }
+
+  const SidebarDragAction action =
+      ClassifyAction(current_source.placement, target);
+  if (action == SidebarDragAction::kNone) {
+    return Finish(SidebarDragOutcome::kNoOp);
+  }
+
+  active_ = false;
+  return {.outcome = SidebarDragOutcome::kCommitted,
+          .command = SidebarDragCommand{
+              .action = action, .source = source_, .target = *preview_}};
+}
+
+// static
+SidebarDragAction SidebarDragTransaction::ClassifyAction(
+    const SidebarItemPlacement& source,
+    const SidebarItemPlacement& target) {
+  if (source.section != target.section) {
+    return target.section == SidebarSection::kPins ? SidebarDragAction::kPin
+                                                   : SidebarDragAction::kUnpin;
+  }
+  if (source.parent_id != target.parent_id) {
+    return SidebarDragAction::kReparent;
+  }
+  if (source.before_id != target.before_id) {
+    return SidebarDragAction::kReorder;
+  }
+  return SidebarDragAction::kNone;
+}
+
+SidebarDragResult SidebarDragTransaction::Finish(SidebarDragOutcome outcome) {
+  active_ = false;
+  return {.outcome = outcome};
+}
+
+}  // namespace helium
