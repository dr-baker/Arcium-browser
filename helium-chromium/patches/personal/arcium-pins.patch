+#include "chrome/browser/ui/helium/helium_sidebar_native_tab_drag_session.h"
+
+#include <utility>
+
+namespace helium {
+
+SidebarNativeTabDragSession::SidebarNativeTabDragSession(
+    SidebarNativeTabContext source_context,
+    bool source_is_single_eligible_tab)
+    : source_context_(std::move(source_context)),
+      source_was_single_eligible_tab_(source_is_single_eligible_tab) {}
+
+SidebarNativeTabDragSession::~SidebarNativeTabDragSession() = default;
+
+bool SidebarNativeTabDragSession::UpdatePinIntent(
+    SidebarNativeTabPinIntent intent) {
+  if (!active_ || invalidated_ || !source_was_single_eligible_tab_ ||
+      !source_context_.valid() || intent.context != source_context_ ||
+      intent.placement.section != SidebarSection::kPins) {
+    intent_.reset();
+    return false;
+  }
+  intent_ = std::move(intent);
+  return true;
+}
+
+void SidebarNativeTabDragSession::ClearIntent() {
+  intent_.reset();
+}
+
+void SidebarNativeTabDragSession::Invalidate() {
+  intent_.reset();
+  invalidated_ = true;
+}
+
+std::optional<SidebarNativeTabPinCommand>
+SidebarNativeTabDragSession::Complete(
+    bool successful_drop,
+    const SidebarNativeTabContext& final_context,
+    bool source_is_still_single_eligible_tab) {
+  if (!active_) {
+    return std::nullopt;
+  }
+  active_ = false;
+
+  if (!successful_drop || invalidated_ || !source_was_single_eligible_tab_ ||
+      !source_is_still_single_eligible_tab || !intent_ ||
+      final_context != source_context_ || intent_->context != source_context_ ||
+      intent_->placement.section != SidebarSection::kPins) {
+    intent_.reset();
+    return std::nullopt;
+  }
+
+  SidebarNativeTabPinCommand command{
+      .source_context = source_context_, .placement = intent_->placement};
+  intent_.reset();
+  return command;
+}
+
+bool ShouldStartWholeWindowDragImmediately(
+    bool is_dragging_every_tab,
+    const SidebarNativeTabDragSession* sidebar_session) {
+  return is_dragging_every_tab &&
+         (!sidebar_session || !sidebar_session->accepts_intent());
+}
+
+}  // namespace helium
