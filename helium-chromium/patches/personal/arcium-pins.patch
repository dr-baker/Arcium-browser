+  std::map<std::string, std::string> extra_data;
+  service_->AddPersistentItemToSessionExtraData(pin_tab, &extra_data);
+  EXPECT_TRUE(extra_data.contains(kHeliumPersistentItemTabExtraDataKey));
+
+  ASSERT_TRUE(service_->RemovePersistentItem(pin_tab));
+  EXPECT_FALSE(service_->GetPersistentItemKind(pin_tab));
+  EXPECT_FALSE(service_->GetPersistentItemId(pin_tab));
+  EXPECT_FALSE(
+      service_->GetPersistentItemHome(pin_tab, &home_url, &home_title));
+  EXPECT_FALSE(service_->RemovePersistentItem(pin_tab));
+}
