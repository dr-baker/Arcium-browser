+  const BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+  const Profile* profile = tab->GetProfile();
+  const TabStripModel* model = window ? window->GetTabStripModel() : nullptr;
+  const auto* strip =
+      model && model->Root()
+          ? static_cast<const tabs::TabStripCollection*>(model->Root())
+          : nullptr;
+  return window && profile && model && strip && !strip->IsPinTab(tab) &&
+         window->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+         !profile->IsOffTheRecord() && !profile->IsGuestSession();
