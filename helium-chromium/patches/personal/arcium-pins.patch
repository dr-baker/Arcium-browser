+void HeliumSpaceService::ReconcileLiveAssociationsWithDurableModel() {
+  std::vector<tabs::TabInterface*> removed_tabs;
+  for (const auto& [token, association] : live_associations_) {
+    static_cast<void>(token);
+    tabs::TabInterface* tab = association->tab.get();
+    std::optional<PersistentLink> item;
+    if (association->kind == PersistentRecordKind::kPin) {
+      item = ResolvePinInSpace(association->space_id, association->item_id);
+    } else {
+      BrowserWindowInterface* window =
+          tab ? tab->GetBrowserWindowInterface() : nullptr;
+      Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+      item = ResolveItem(browser, PersistentRecordKind::kFavorite,
+                         association->item_id);
+    }
+    if (item && tab) {
+      SeedAnchoredHome(tab, *item);
+    } else if (tab) {
+      removed_tabs.push_back(tab);
+    }
+  }
+
+  // Disassociation also restores the tab to the ordinary native collection.
+  // Do it after the read-only pass because it erases association entries.
+  for (tabs::TabInterface* tab : removed_tabs) {
+    DisassociateLiveTab(tab);
+  }
+}
