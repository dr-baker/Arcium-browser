+helium::SidebarDragContext PinTabContainerView::GetSidebarDragContext(
+    Browser* browser) const {
+  return {
+      .space = {sidebar_context_generation_},
+      .browser = {browser ? static_cast<uint64_t>(browser->session_id().id())
+                          : 0},
+  };
