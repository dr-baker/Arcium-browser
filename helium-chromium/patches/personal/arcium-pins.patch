+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_SIDEBAR_PIN_PROJECTION_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_SIDEBAR_PIN_PROJECTION_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "chrome/browser/ui/helium/helium_persistent_item_model.h"
+
+namespace helium {
+
+// Identifies one durable Pin within one Space. Persistent item ids are only
+// unique within a Space, so sidebar identity must always retain both parts.
+struct SidebarPinKey {
+  std::string space_id;
+  std::string item_id;
+  bool operator==(const SidebarPinKey&) const = default;
+};
+
+enum class SidebarPinRowKind { kPin, kFolder };
+
+// A renderer-facing row. The live handle is opaque session metadata and does
+// not transfer ownership of either persistence or a TabInterface.
+struct SidebarPinRow {
+  SidebarPinKey key;
+  SidebarPinRowKind kind = SidebarPinRowKind::kPin;
+  size_t depth = 0;
+  std::optional<SidebarPinKey> parent;
+  bool collapsed = false;
+  bool selected = false;
+  std::optional<int32_t> live_tab_handle;
+  std::u16string title;
+  GURL url;
+  bool operator==(const SidebarPinRow&) const = default;
+};
+
+enum class SidebarPinDropPosition { kBefore, kInside, kAfter };
+
+struct SidebarPinDropTarget {
+  SidebarPinKey key;
+  SidebarPinDropPosition position = SidebarPinDropPosition::kBefore;
+  bool operator==(const SidebarPinDropTarget&) const = default;
+};
+
+// A pure description of the durable tree operation represented by a drop.
+// Null parent means the Space root and null before means append.
+struct SidebarPinMoveIntent {
+  enum class Result { kCancel, kNoOp, kMove, kInvalid };
+
+  Result result = Result::kInvalid;
+  SidebarPinKey source;
+  std::optional<SidebarPinKey> parent;
+  std::optional<SidebarPinKey> before;
+  bool operator==(const SidebarPinMoveIntent&) const = default;
+};
+
+// The node's current durable tree position. Null parent means the Space root
+// and null before means the node is last among its durable siblings.
+struct SidebarPinPlacement {
+  std::optional<SidebarPinKey> parent;
+  std::optional<SidebarPinKey> before;
+  bool operator==(const SidebarPinPlacement&) const = default;
+};
+
+// An ephemeral read model for one Space's durable Pin tree. Rebuilding the
+// projection updates presentation metadata while stable qualified keys keep
+// existing rows and drag transactions identifiable. Although persisted trees
+// normally arrive prevalidated by PersistentItemCodec, direct callers are also
+// checked for blank or duplicate ids and inconsistent parent metadata. An
+// invalid projection exposes no rows and rejects lookups and drops. Live
+// bindings annotate rows independently; only the qualified active item may
+// expose its descendant path through a collapsed folder.
+class HeliumSidebarPinProjection {
+ public:
+  using LiveBindings = std::map<std::string, int32_t, std::less<>>;
+
+  HeliumSidebarPinProjection(
+      std::string space_id,
+      const PersistentNodes& pins,
+      const LiveBindings& live_bindings = {},
+      std::optional<SidebarPinKey> active_item = std::nullopt);
+  HeliumSidebarPinProjection(const HeliumSidebarPinProjection&);
+  HeliumSidebarPinProjection& operator=(const HeliumSidebarPinProjection&);
+  ~HeliumSidebarPinProjection();
+
+  bool valid() const { return valid_; }
+  const std::string& space_id() const { return space_id_; }
+  const std::vector<SidebarPinRow>& rows() const { return rows_; }
+  const SidebarPinRow* FindVisibleRow(const SidebarPinKey& key) const;
+  // Uses the complete durable tree, including rows hidden by collapsed
+  // folders, so `before` is suitable for a lossless MoveNode round trip.
+  std::optional<SidebarPinPlacement> GetDurablePlacement(
+      const SidebarPinKey& key) const;
+
+ private:
+  struct NodeMetadata {
+    SidebarPinRowKind kind = SidebarPinRowKind::kPin;
+    std::optional<std::string> parent_id;
+    std::vector<std::string> child_ids;
+    size_t sibling_index = 0;
+    bool collapsed = false;
+    bool selected = false;
+    std::optional<int32_t> live_tab_handle;
+    std::u16string title;
+    GURL url;
+  };
+
+  void AppendNodes(const PersistentNodes& nodes,
+                   std::optional<std::string_view> parent_id,
+                   size_t depth,
+                   bool only_active,
+                   const LiveBindings& live_bindings);
+  const NodeMetadata* FindNode(const SidebarPinKey& key) const;
+
+  friend SidebarPinMoveIntent ResolveSidebarPinDrop(
+      const HeliumSidebarPinProjection& projection,
+      const SidebarPinKey& source,
+      const std::optional<SidebarPinDropTarget>& target);
+  friend std::optional<std::vector<SidebarPinRow>> PreviewSidebarPinMove(
+      const HeliumSidebarPinProjection& projection,
+      const SidebarPinMoveIntent& intent);
+
+  std::string space_id_;
+  std::vector<SidebarPinRow> rows_;
+  std::map<std::string, NodeMetadata, std::less<>> nodes_;
+  std::vector<std::string> root_ids_;
+  std::optional<std::string> active_item_id_;
+  bool valid_ = true;
+};
+
+SidebarPinMoveIntent ResolveSidebarPinDrop(
+    const HeliumSidebarPinProjection& projection,
+    const SidebarPinKey& source,
+    const std::optional<SidebarPinDropTarget>& target);
+
+// Resolves an external item insertion without pretending that item already
+// belongs to the durable Pin tree. A null target is root append, which is the
+// only valid destination when a Space has no Pins yet.
+std::optional<SidebarPinPlacement> ResolveSidebarPinInsertion(
+    const HeliumSidebarPinProjection& projection,
+    const std::optional<SidebarPinDropTarget>& target);
+
+// Returns the visible rows after logically applying a validated move without
+// changing the projection or durable tree. A valid no-op returns an exact copy
+// of the current rows. Invalid and cancelled intents fail closed with nullopt.
+std::optional<std::vector<SidebarPinRow>> PreviewSidebarPinMove(
+    const HeliumSidebarPinProjection& projection,
+    const SidebarPinMoveIntent& intent);
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_SIDEBAR_PIN_PROJECTION_H_
