+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_sidebar_drag_transaction.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+constexpr SidebarDragContext kContext = {
+    .space = SidebarSpaceToken{.value = 10},
+    .browser = SidebarBrowserToken{.value = 20}};
+
+SidebarDragSource Source(SidebarItemKind kind = SidebarItemKind::kTab,
+                         SidebarSection section = SidebarSection::kTabs,
+                         std::string parent_id = {},
+                         std::string before_id = "next") {
+  return {.item_id = "source",
+          .kind = kind,
+          .context = kContext,
+          .placement = {.section = section,
+                        .parent_id = std::move(parent_id),
+                        .before_id = std::move(before_id)}};
+}
+
+SidebarDropIntent Target(SidebarSection section,
+                         std::string parent_id = {},
+                         std::string before_id = {}) {
+  return {.context = kContext,
+          .placement = {.section = section,
+                        .parent_id = std::move(parent_id),
+                        .before_id = std::move(before_id)}};
+}
+
+SidebarDragRevalidation ValidRevalidation(const SidebarDragSource& source) {
+  return {.source = source,
+          .target_context = kContext,
+          .target_section_accepts_source = true,
+          .target_parent_accepts_source = true,
+          .before_id_is_direct_child = true};
+}
+
+TEST(SidebarDragTransactionTest, CommitsExactlyOneSemanticResult) {
+  const SidebarDragSource source = Source();
+  SidebarDragTransaction transaction(source);
+  const SidebarDropIntent target =
+      Target(SidebarSection::kPins, "folder", "pin-after");
+  ASSERT_TRUE(transaction.UpdatePreview(target));
+
+  const SidebarDragResult result =
+      transaction.Commit(ValidRevalidation(source));
+
+  ASSERT_EQ(SidebarDragOutcome::kCommitted, result.outcome);
+  ASSERT_TRUE(result.command);
+  EXPECT_EQ(SidebarDragAction::kPin, result.command->action);
+  EXPECT_EQ(source, result.command->source);
+  EXPECT_EQ(target, result.command->target);
+  EXPECT_FALSE(transaction.is_active());
+
+  const SidebarDragResult second =
+      transaction.Commit(ValidRevalidation(source));
+  EXPECT_EQ(SidebarDragOutcome::kRejectedFinished, second.outcome);
+  EXPECT_FALSE(second.command);
+}
+
+TEST(SidebarDragTransactionTest, CancelProducesNoCommandAndIsTerminal) {
+  const SidebarDragSource source = Source();
+  SidebarDragTransaction transaction(source);
+  ASSERT_TRUE(transaction.UpdatePreview(Target(SidebarSection::kPins)));
+
+  const SidebarDragResult cancelled = transaction.Cancel();
+
+  EXPECT_EQ(SidebarDragOutcome::kCancelled, cancelled.outcome);
+  EXPECT_FALSE(cancelled.command);
+  EXPECT_FALSE(transaction.is_active());
+  EXPECT_FALSE(transaction.UpdatePreview(Target(SidebarSection::kTabs)));
+  EXPECT_EQ(SidebarDragOutcome::kRejectedFinished,
+            transaction.Commit(ValidRevalidation(source)).outcome);
+}
+
+TEST(SidebarDragTransactionTest, ExactPlacementIsNoOp) {
+  const SidebarDragSource source =
+      Source(SidebarItemKind::kPin, SidebarSection::kPins, "folder", "next");
+  SidebarDragTransaction transaction(source);
+  ASSERT_TRUE(transaction.UpdatePreview(
+      Target(SidebarSection::kPins, "folder", "next")));
+
+  const SidebarDragResult result =
+      transaction.Commit(ValidRevalidation(source));
+
+  EXPECT_EQ(SidebarDragOutcome::kNoOp, result.outcome);
+  EXPECT_FALSE(result.command);
+  EXPECT_FALSE(transaction.is_active());
+}
+
+TEST(SidebarDragTransactionTest, RejectsSpaceAndBrowserMismatches) {
+  const SidebarDragSource source = Source();
+
+  SidebarDragTransaction wrong_space(source);
+  SidebarDropIntent space_target = Target(SidebarSection::kPins);
+  space_target.context.space.value++;
+  ASSERT_TRUE(wrong_space.UpdatePreview(space_target));
+  EXPECT_EQ(SidebarDragOutcome::kRejectedContextMismatch,
+            wrong_space.Commit(ValidRevalidation(source)).outcome);
+
+  SidebarDragTransaction wrong_browser(source);
+  SidebarDropIntent browser_target = Target(SidebarSection::kPins);
+  browser_target.context.browser.value++;
+  ASSERT_TRUE(wrong_browser.UpdatePreview(browser_target));
+  EXPECT_EQ(SidebarDragOutcome::kRejectedContextMismatch,
+            wrong_browser.Commit(ValidRevalidation(source)).outcome);
+
+  SidebarDragTransaction changed_destination(source);
+  ASSERT_TRUE(changed_destination.UpdatePreview(Target(SidebarSection::kPins)));
+  SidebarDragRevalidation changed_context = ValidRevalidation(source);
+  changed_context.target_context.browser.value++;
+  EXPECT_EQ(SidebarDragOutcome::kRejectedContextMismatch,
+            changed_destination.Commit(changed_context).outcome);
+}
+
+TEST(SidebarDragTransactionTest, RejectsSourceDisappearanceAtCommit) {
+  SidebarDragTransaction transaction(Source());
+  ASSERT_TRUE(transaction.UpdatePreview(Target(SidebarSection::kPins)));
+  SidebarDragRevalidation revalidation = {.source = std::nullopt,
+                                          .target_context = kContext};
+
+  const SidebarDragResult result = transaction.Commit(revalidation);
+
+  EXPECT_EQ(SidebarDragOutcome::kRejectedSourceMissing, result.outcome);
+  EXPECT_FALSE(result.command);
+}
+
+TEST(SidebarDragTransactionTest, RejectsFolderCycleFromCurrentTreeInput) {
+  const SidebarDragSource source =
+      Source(SidebarItemKind::kFolder, SidebarSection::kPins);
+  SidebarDragTransaction transaction(source);
+  ASSERT_TRUE(transaction.UpdatePreview(
+      Target(SidebarSection::kPins, "descendant-folder")));
+  SidebarDragRevalidation revalidation = ValidRevalidation(source);
+  revalidation.target_parent_is_source_or_descendant = true;
+
+  const SidebarDragResult result = transaction.Commit(revalidation);
+
+  EXPECT_EQ(SidebarDragOutcome::kRejectedFolderCycle, result.outcome);
+  EXPECT_FALSE(result.command);
+}
+
+TEST(SidebarDragTransactionTest,
+     RejectsFolderSectionConversionWithoutExplicitAcceptance) {
+  const SidebarDragSource source =
+      Source(SidebarItemKind::kFolder, SidebarSection::kPins);
+  SidebarDragTransaction transaction(source);
+  ASSERT_TRUE(transaction.UpdatePreview(Target(SidebarSection::kTabs)));
+  SidebarDragRevalidation revalidation = ValidRevalidation(source);
+  revalidation.target_section_accepts_source = false;
+
+  const SidebarDragResult result = transaction.Commit(revalidation);
+
+  EXPECT_EQ(SidebarDragOutcome::kRejectedInvalidTarget, result.outcome);
+  EXPECT_FALSE(result.command);
+
+  SidebarDragTransaction accepted(source);
+  ASSERT_TRUE(accepted.UpdatePreview(Target(SidebarSection::kTabs)));
+  const SidebarDragResult accepted_result =
+      accepted.Commit(ValidRevalidation(source));
+  ASSERT_EQ(SidebarDragOutcome::kCommitted, accepted_result.outcome);
+  ASSERT_TRUE(accepted_result.command);
+  EXPECT_EQ(SidebarDragAction::kUnpin, accepted_result.command->action);
+}
+
+TEST(SidebarDragTransactionTest, RejectsParentFromWrongSection) {
+  const SidebarDragSource source =
+      Source(SidebarItemKind::kPin, SidebarSection::kPins);
+  SidebarDragTransaction transaction(source);
+  ASSERT_TRUE(transaction.UpdatePreview(
+      Target(SidebarSection::kPins, "tabs-section-group")));
+  SidebarDragRevalidation revalidation = ValidRevalidation(source);
+  revalidation.target_parent_accepts_source = false;
+
+  const SidebarDragResult result = transaction.Commit(revalidation);
+
+  EXPECT_EQ(SidebarDragOutcome::kRejectedInvalidTarget, result.outcome);
+  EXPECT_FALSE(result.command);
+}
+
+TEST(SidebarDragTransactionTest, RejectsBeforeItemOutsideTargetParent) {
+  const SidebarDragSource source =
+      Source(SidebarItemKind::kPin, SidebarSection::kPins);
+  SidebarDragTransaction transaction(source);
+  ASSERT_TRUE(transaction.UpdatePreview(
+      Target(SidebarSection::kPins, "folder", "foreign-child")));
+  SidebarDragRevalidation revalidation = ValidRevalidation(source);
+  revalidation.before_id_is_direct_child = false;
+
+  const SidebarDragResult result = transaction.Commit(revalidation);
+
+  EXPECT_EQ(SidebarDragOutcome::kRejectedInvalidTarget, result.outcome);
+  EXPECT_FALSE(result.command);
+}
+
+TEST(SidebarDragTransactionTest, ClassifiesSectionAndTreeChanges) {
+  SidebarDragTransaction pin(Source());
+  ASSERT_TRUE(pin.UpdatePreview(Target(SidebarSection::kPins)));
+  EXPECT_EQ(SidebarDragAction::kPin, pin.preview_action());
+
+  SidebarDragTransaction unpin(
+      Source(SidebarItemKind::kPin, SidebarSection::kPins));
+  ASSERT_TRUE(unpin.UpdatePreview(Target(SidebarSection::kTabs)));
+  EXPECT_EQ(SidebarDragAction::kUnpin, unpin.preview_action());
+
+  SidebarDragTransaction reparent(
+      Source(SidebarItemKind::kPin, SidebarSection::kPins, "old-parent"));
+  ASSERT_TRUE(
+      reparent.UpdatePreview(Target(SidebarSection::kPins, "new-parent")));
+  EXPECT_EQ(SidebarDragAction::kReparent, reparent.preview_action());
+
+  SidebarDragTransaction reorder(
+      Source(SidebarItemKind::kPin, SidebarSection::kPins, "parent", "old"));
+  ASSERT_TRUE(
+      reorder.UpdatePreview(Target(SidebarSection::kPins, "parent", "new")));
+  EXPECT_EQ(SidebarDragAction::kReorder, reorder.preview_action());
+}
+
+}  // namespace
+}  // namespace helium
