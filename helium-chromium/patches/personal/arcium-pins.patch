+// Native tab transfers can change indices and selection synchronously. Keep
+// handles so rollback never applies an old index to an unrelated tab.
+struct PinTransferSelection {
+  std::vector<tabs::TabHandle> selected;
+  std::optional<tabs::TabHandle> active;
+  std::optional<tabs::TabHandle> anchor;
+
+  explicit PinTransferSelection(TabStripModel* model) {
+    for (tabs::TabInterface* tab : model->selection_model().selected_tabs()) {
+      selected.push_back(tab->GetHandle());
+    }
+    if (tabs::TabInterface* tab = model->selection_model().active_tab()) {
+      active = tab->GetHandle();
+    }
+    if (tabs::TabInterface* tab = model->selection_model().anchor_tab()) {
+      anchor = tab->GetHandle();
+    }
+  }
+
+  void Restore(TabStripModel* model) const {
+    auto index_for = [model](const std::optional<tabs::TabHandle>& handle) {
+      tabs::TabInterface* tab = handle ? handle->Get() : nullptr;
+      return tab ? model->GetIndexOfTab(tab) : TabStripModel::kNoTab;
+    };
+    const int active_index = index_for(active);
+    if (active_index == TabStripModel::kNoTab) {
+      return;
+    }
+    ui::ListSelectionModel selection;
+    for (const tabs::TabHandle& handle : selected) {
+      tabs::TabInterface* tab = handle.Get();
+      const int index = tab ? model->GetIndexOfTab(tab) : TabStripModel::kNoTab;
+      if (index != TabStripModel::kNoTab) {
+        selection.AddIndexToSelection(index);
+      }
+    }
+    selection.AddIndexToSelection(active_index);
+    selection.set_active(active_index);
+    const int anchor_index = index_for(anchor);
+    selection.set_anchor(anchor_index == TabStripModel::kNoTab ? active_index
+                                                               : anchor_index);
+    model->SetSelectionFromModel(std::move(selection));
+  }
+};
