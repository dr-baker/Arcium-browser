+    if (GetParam() == SavedSourceKind::kFavorite) {
+      EXPECT_TRUE(MakeFavorite(source));
+    } else {
+      EXPECT_TRUE(MakePin(source));
+      if (GetParam() == SavedSourceKind::kFolderPin) {
+        EXPECT_TRUE(CreatePinFolder(source));
+        PlacePinInDurableFolder(source);
+      }
+    }
+    content::NavigationSimulator::NavigateAndCommitFromBrowser(
+        source->GetContents(), GURL("https://saved.test/edit"));
+    source->GetContents()->SetUserData(&kUnsavedPageStateKey,
+                                       std::make_unique<UnsavedPageState>());
+    return source;
+  }
+
+  SavedSourceState CaptureSavedSource(tabs::TabInterface* source) {
+    const auto id = service_->GetPersistentItemId(source);
+    const auto kind = service_->GetPersistentItemKind(source);
+    EXPECT_TRUE(id);
+    EXPECT_TRUE(kind);
+    const auto favorites = service_->GetFavoritesForBrowser(browser());
+    const PersistentLink* link = PersistentItemCodec::FindLink(
+        kind == PersistentRecordKind::kFavorite ? favorites : space_->pins(),
+        id.value_or(std::string()));
+    EXPECT_TRUE(link);
+    GURL home_url;
+    std::u16string home_title;
+    EXPECT_TRUE(
+        service_->GetPersistentItemHome(source, &home_url, &home_title));
+    return {.handle = source->GetHandle(),
+            .contents = source->GetContents(),
+            .parent = source->GetParentCollection()->GetHandle(),
+            .kind = kind.value_or(PersistentRecordKind::kPin),
+            .link = link ? *link : PersistentLink(),
+            .current_url = source->GetContents()->GetLastCommittedURL(),
+            .navigation_entry_id = source->GetContents()
+                                       ->GetController()
+                                       .GetLastCommittedEntry()
+                                       ->GetUniqueID(),
+            .navigation_count =
+                source->GetContents()->GetController().GetEntryCount(),
+            .home_url = home_url,
+            .home_title = home_title};
+  }
+
+  tabs::TabInterface* AddSavedTargetInDifferentParent() {
+    auto* target = AddOrdinaryTab("https://other-saved.test/");
+    if (GetParam() == SavedSourceKind::kFavorite) {
+      EXPECT_TRUE(MakePin(target));
+    } else {
+      EXPECT_TRUE(MakeFavorite(target));
+    }
+    target->GetContents()->SetUserData(&kUnsavedPageStateKey,
+                                       std::make_unique<UnsavedPageState>());
+    return target;
+  }
+
+  void ExpectSavedSource(const SavedSourceState& state) {
+    tabs::TabInterface* source = state.handle.Get();
+    ASSERT_TRUE(source);
+    EXPECT_EQ(state.contents, source->GetContents());
+    EXPECT_EQ(state.current_url, source->GetContents()->GetLastCommittedURL());
+    EXPECT_EQ(state.navigation_entry_id, source->GetContents()
+                                             ->GetController()
+                                             .GetLastCommittedEntry()
+                                             ->GetUniqueID());
+    EXPECT_EQ(state.navigation_count,
+              source->GetContents()->GetController().GetEntryCount());
+    auto* page_state = static_cast<UnsavedPageState*>(
+        source->GetContents()->GetUserData(&kUnsavedPageStateKey));
+    ASSERT_TRUE(page_state);
+    EXPECT_EQ("draft still in the page", page_state->input);
+    EXPECT_EQ(state.kind, service_->GetPersistentItemKind(source));
+    EXPECT_EQ(state.link.id, service_->GetPersistentItemId(source));
+    EXPECT_EQ(source, service_->GetLiveTabForPersistentItem(
+                          browser(), state.kind, state.link.id));
+    const auto favorites = service_->GetFavoritesForBrowser(browser());
+    const PersistentLink* link = PersistentItemCodec::FindLink(
+        state.kind == PersistentRecordKind::kFavorite ? favorites
+                                                      : space_->pins(),
+        state.link.id);
+    ASSERT_TRUE(link);
+    EXPECT_EQ(state.link, *link);
+    GURL home_url;
+    std::u16string home_title;
+    ASSERT_TRUE(
+        service_->GetPersistentItemHome(source, &home_url, &home_title));
+    EXPECT_EQ(state.home_url, home_url);
+    EXPECT_EQ(state.home_title, home_title);
+    auto* helper = TabUIHelper::From(source);
+    ASSERT_TRUE(helper);
+    EXPECT_TRUE(helper->HasAnchoredPinnedTabHome());
+    EXPECT_EQ(state.home_url, helper->anchored_pinned_tab_home_url());
+    EXPECT_EQ(state.home_title, helper->anchored_pinned_tab_home_title());
+    const tabs::TabCollection* parent = source->GetParentCollection();
+    if (source->IsSplit()) {
+      parent = parent->GetParentCollection();
+    }
+    EXPECT_EQ(state.parent.Get(), parent);
+    EXPECT_EQ(state.kind == PersistentRecordKind::kFavorite,
+              source->IsPinned());
+    EXPECT_EQ(state.kind == PersistentRecordKind::kPin,
+              strip()->IsPinTab(source));
+  }
+
+  split_tabs::SplitTabId SplitWithCopy(tabs::TabInterface* source,
+                                       tabs::TabInterface** companion) {
+    *companion = AddOrdinaryTab("https://destination.test/copy");
+    model()->ActivateTabAt(model()->GetIndexOfTab(source));
+    return model()->AddToNewSplit(
+        {model()->GetIndexOfTab(*companion)}, split_tabs::SplitTabVisualData(),
+        split_tabs::SplitTabCreatedSource::kToolbarButton);
+  }
+
+  void ExpectOrdinary(tabs::TabInterface* tab) {
+    ASSERT_TRUE(tab);
+    EXPECT_FALSE(tab->IsPinned());
+    EXPECT_FALSE(strip()->IsPinTab(tab));
+    EXPECT_FALSE(service_->IsPersistentItemTab(tab));
+    EXPECT_FALSE(TabUIHelper::From(tab)->HasAnchoredPinnedTabHome());
+  }
+
+  raw_ptr<HeliumSpaceService> service_ = nullptr;
+  raw_ptr<HeliumSpace> space_ = nullptr;
+};
