+void BaseTabStripRegionView::UpdateTabDragPoint(
+    TabDragController& drag_controller,
+    const gfx::Point& point_in_screen) {
+  PinTabContainerView* pins_container = GetPinsContainer();
+  const bool owns_native_boundary =
+      drag_controller.HasEligibleNativeTabPinDragSession();
+  auto set_semantic_target = [&](PersistentTabDropLocation location) {
+    if (owns_native_boundary && drag_handler_ &&
+        drag_handler_->GetDragContext()->GetDragController() ==
+            &drag_controller) {
+      drag_handler_->SetPersistentTabDropTarget(std::move(location));
+    }
+  };
+  auto clear_native_pin_intent = [&] {
+    drag_controller.ClearNativeTabPinDropIntent();
+    set_semantic_target({.target = PersistentTabDropTarget::kTab});
+    ClearTabDragBoundaryPresentation();
+  };
+
+  if (!drag_handler_ || !pins_container || !tab_strip_view_ ||
+      !GetTabStripDraggableBounds().Contains(point_in_screen)) {
+    clear_native_pin_intent();
+    return;
+  }
+
+  if (!owns_native_boundary) {
+    clear_native_pin_intent();
+    return;
+  }
+
+  // Pointer location describes the durable result of a successful drop. It
+  // must not select the DraggedTabsContainer: Chromium's drag presentation is
+  // tied to the container that already owns the dragged view.
+  // Freeze the semantic boundary before either destination adds its preview
+  // gap. Otherwise the preview can move the boundary under the pointer and
+  // make the target oscillate between Pins and tabs.
+  if (tab_strip_view_) {
+    tab_strip_view_->SetMainTabsDropPreview();
+  }
+  if (GetPinnedTabsContainer()->GetBoundsInScreen().Contains(point_in_screen)) {
+    clear_native_pin_intent();
+  } else if (tab_strip_view_->IsPointInPinsRegion(point_in_screen)) {
+    GetUnpinnedTabsContainer()->ClearPersistentTabDragPreview();
+    PersistentTabDropLocation drop_location =
+        pins_container->GetPersistentDropLocationForDrag(point_in_screen);
+    if (drop_location.target != PersistentTabDropTarget::kPin) {
+      clear_native_pin_intent();
+      return;
+    }
+    Browser* browser = browser_view_ ? browser_view_->browser() : nullptr;
+    helium::HeliumSpaceService* service =
+        browser ? helium::HeliumSpaceServiceFactory::GetForProfile(
+                      browser->profile())
+                : nullptr;
+    helium::SidebarNativeTabContext target_context{
+        .browser_session_id =
+            browser && browser->session_id().is_valid()
+                ? browser->session_id().id()
+                : 0,
+        .space_id = service
+                        ? std::string(service->GetSpaceIdForBrowser(browser))
+                        : std::string()};
+    drag_controller.UpdateNativeTabPinDropIntent(
+        {.context = std::move(target_context),
+         .placement = {.section = helium::SidebarSection::kPins,
+                       .parent_id = std::move(drop_location.parent_id),
+                       .before_id = std::move(drop_location.before_id)}});
+    drop_location.target = PersistentTabDropTarget::kPin;
+    set_semantic_target(std::move(drop_location));
+    pins_container->UpdatePersistentTabDragPreview(point_in_screen);
+  } else {
+    drag_controller.ClearNativeTabPinDropIntent();
+    pins_container->ClearPersistentTabDragPreview();
+    GetUnpinnedTabsContainer()->ClearPersistentTabDragPreview();
+    set_semantic_target({.target = PersistentTabDropTarget::kTab});
+  }
+}
+
+bool BaseTabStripRegionView::IsPointInOrdinaryTabDropRegion(
+    const gfx::Point& point_in_screen) const {
+  return tab_strip_view_ &&
+         GetTabStripDraggableBounds().Contains(point_in_screen) &&
+         !tab_strip_view_->IsPointInPinsRegion(point_in_screen);
+}
+
+void BaseTabStripRegionView::ClearTabDragBoundaryPresentation() {
+  if (PinTabContainerView* pins_container = GetPinsContainer()) {
+    pins_container->ClearPersistentTabDragPreview();
+  }
+  if (UnpinnedTabContainerView* tabs_container =
+          GetUnpinnedTabsContainer()) {
+    tabs_container->ClearPersistentTabDragPreview();
+  }
+  if (tab_strip_view_) {
+    tab_strip_view_->ClearMainTabsDropPreview();
+  }
+}
