+std::optional<std::string> HeliumSpaceService::GetPersistentItemId(
+    const tabs::TabInterface* tab) const {
+  const LiveAssociation* association = FindLiveAssociation(tab);
+  if (!association) {
+    return std::nullopt;
+  }
