+std::optional<helium::SidebarItemPlacement>
+PinTabContainerView::GetSidebarItemPlacement(
+    const helium::HeliumSidebarPinProjection& projection,
+    std::string_view id) const {
+  std::optional<helium::SidebarPinPlacement> durable =
+      projection.GetDurablePlacement(
+          {.space_id = projection.space_id(), .item_id = std::string(id)});
+  if (!durable) {
+    return std::nullopt;
+  }
+  return helium::SidebarItemPlacement{
+      .section = helium::SidebarSection::kPins,
+      .parent_id = durable->parent ? durable->parent->item_id : std::string(),
+      .before_id = durable->before ? durable->before->item_id : std::string(),
+  };
+}
+
+std::optional<helium::SidebarPinDropTarget>
+PinTabContainerView::GetSidebarPinDropTarget(
+    const gfx::Point& point_in_screen) const {
+  if (!sidebar_projection_ || !sidebar_projection_->valid()) {
+    return std::nullopt;
+  }
+  std::vector<const views::View*> visible_rows;
+  for (const views::View* child : children()) {
+    if (child->GetVisible() && row_ids_.contains(child)) {
+      visible_rows.push_back(child);
+    }
+  }
+  std::ranges::sort(visible_rows, {}, [](const views::View* row) {
+    return row->GetBoundsInScreen().y();
+  });
+  if (visible_rows.empty()) {
+    return std::nullopt;
+  }
+
+  const views::View* target = visible_rows.back();
+  helium::SidebarPinDropPosition position =
+      helium::SidebarPinDropPosition::kAfter;
+  for (const views::View* row : visible_rows) {
+    const gfx::Rect bounds = row->GetBoundsInScreen();
+    if (point_in_screen.y() < bounds.y()) {
+      target = row;
+      position = helium::SidebarPinDropPosition::kBefore;
+      break;
+    }
+    if (point_in_screen.y() >= bounds.bottom()) {
+      continue;
+    }
+    target = row;
+    const int relative_y = point_in_screen.y() - bounds.y();
+    const bool folder =
+        row_is_folders_.contains(row) && row_is_folders_.at(row);
+    const bool middle_zone = relative_y >= bounds.height() / 3 &&
+                             relative_y < bounds.height() * 2 / 3;
+    const bool indented_zone =
+        point_in_screen.x() >= bounds.x() + std::max(48, bounds.width() / 3);
+    if (folder &&
+        (middle_zone || (indented_zone && relative_y >= bounds.height() / 6 &&
+                         relative_y < bounds.height() * 5 / 6))) {
+      position = helium::SidebarPinDropPosition::kInside;
+    } else {
+      position = relative_y < bounds.height() / 2
+                     ? helium::SidebarPinDropPosition::kBefore
+                     : helium::SidebarPinDropPosition::kAfter;
+    }
+    break;
+  }
+  return helium::SidebarPinDropTarget{
+      .key = {.space_id = sidebar_projection_->space_id(),
+              .item_id = row_ids_.at(target)},
+      .position = position,
+  };
+}
+
+void PinTabContainerView::ApplySidebarMovePreview(
+    const helium::SidebarPinMoveIntent& intent) {
+  if (!sidebar_projection_) {
+    RestoreSidebarProjectionOrder();
+    return;
+  }
+  const std::optional<std::vector<helium::SidebarPinRow>> preview =
+      helium::PreviewSidebarPinMove(*sidebar_projection_, intent);
+  if (!preview) {
+    RestoreSidebarProjectionOrder();
+    return;
+  }
+
+  std::map<std::string, views::View*, std::less<>> view_by_id;
+  for (const auto& [view, id] : row_ids_) {
+    view_by_id.emplace(id, const_cast<views::View*>(view));
+  }
+  std::vector<raw_ptr<views::View>> order;
+  std::map<const views::View*, int> depths;
+  std::set<const views::View*> visible_rows;
+  order.reserve(preview->size());
+  for (const helium::SidebarPinRow& row : *preview) {
+    const auto view = view_by_id.find(row.key.item_id);
+    if (view == view_by_id.end()) {
+      RestoreSidebarProjectionOrder();
+      return;
+    }
+    order.push_back(view->second);
+    depths.emplace(view->second, static_cast<int>(row.depth));
+    visible_rows.insert(view->second);
+  }
+  sidebar_preview_order_ = std::move(order);
+  sidebar_preview_depths_ = std::move(depths);
+  sidebar_preview_visible_rows_ = std::move(visible_rows);
+  sidebar_preview_active_ = true;
+  InvalidateLayout();
+}
+
+void PinTabContainerView::RestoreSidebarProjectionOrder() {
+  if (!sidebar_preview_active_) {
+    return;
+  }
+  sidebar_preview_order_.clear();
+  sidebar_preview_depths_.clear();
+  sidebar_preview_visible_rows_.clear();
+  sidebar_preview_active_ = false;
+  InvalidateLayout();
+}
+
+void PinTabContainerView::BeginPersistentDragPresentation(
+    views::View& row,
+    const ui::MouseEvent& press_event) {
+  ClearPersistentDragPresentation();
+
+  auto presentation = std::make_unique<PersistentDragPresentation>();
+  presentation->pointer_offset = press_event.location();
+
+  const int source_depth = row_depths_.contains(&row) ? row_depths_.at(&row)
+                                                       : 0;
+  bool collecting = false;
+  for (views::View* child : children()) {
+    if (child == &row) {
+      collecting = true;
+    } else if (!collecting) {
+      continue;
+    } else if (!row_is_folders_.contains(&row) || !row_is_folders_.at(&row) ||
+               !row_depths_.contains(child) ||
+               row_depths_.at(child) <= source_depth) {
+      break;
+    }
+
+    const bool created_layer = child->layer() == nullptr;
+    PersistentDragPresentation::Entry entry{
+        .view = child,
+        .source_bounds = child->bounds(),
+        .created_layer = created_layer,
+        .filled_bounds_opaquely =
+            !created_layer && child->layer()->fills_bounds_opaquely(),
+    };
+    child->SetPaintToLayer();
+    child->layer()->SetFillsBoundsOpaquely(false);
+    if (child->layer()->parent()) {
+      child->layer()->parent()->StackAtTop(child->layer());
+    }
+    presentation->entries.push_back(std::move(entry));
+
+    if (!row_is_folders_.contains(&row) || !row_is_folders_.at(&row)) {
+      break;
+    }
+  }
+
+  if (!presentation->entries.empty()) {
+    persistent_drag_presentation_ = std::move(presentation);
+    InvalidateLayout();
+  }
+}
+
+void PinTabContainerView::UpdatePersistentDragPresentation(
+    const gfx::Point& point_in_screen) {
+  if (!persistent_drag_presentation_) {
+    return;
+  }
+
+  const PersistentDragPresentation::Entry& source =
+      persistent_drag_presentation_->entries.front();
+  if (!source.view || !source.view->parent()) {
+    return;
+  }
+  gfx::Point source_origin_in_screen = source.source_bounds.origin();
+  views::View::ConvertPointToScreen(source.view->parent(),
+                                    &source_origin_in_screen);
+  const int desired_source_y =
+      point_in_screen.y() - persistent_drag_presentation_->pointer_offset.y();
+  const int translation_y = desired_source_y - source_origin_in_screen.y();
+
+  for (const PersistentDragPresentation::Entry& entry :
+       persistent_drag_presentation_->entries) {
+    if (!entry.view || !entry.view->parent()) {
+      continue;
+    }
+    gfx::Transform transform;
+    transform.Translate(0, translation_y);
+    entry.view->SetTransform(transform);
+  }
+}
+
+void PinTabContainerView::ClearPersistentDragPresentation() {
+  if (!persistent_drag_presentation_) {
+    return;
+  }
+  for (const PersistentDragPresentation::Entry& entry :
+       persistent_drag_presentation_->entries) {
+    if (!entry.view) {
+      continue;
+    }
+    entry.view->SetTransform(gfx::Transform());
+    if (entry.created_layer && entry.view->layer()) {
+      entry.view->DestroyLayer();
+    } else if (entry.view->layer()) {
+      entry.view->layer()->SetFillsBoundsOpaquely(
+          entry.filled_bounds_opaquely);
+    }
+  }
+  persistent_drag_presentation_.reset();
+  InvalidateLayout();
+}
+
+bool PinTabContainerView::IsPersistentDragPresentationView(
+    const views::View& view) const {
+  return persistent_drag_presentation_ &&
+         std::ranges::any_of(
+             persistent_drag_presentation_->entries,
+             [&view](const PersistentDragPresentation::Entry& entry) {
+               return entry.view == &view;
+             });
+}
