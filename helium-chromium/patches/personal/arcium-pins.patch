+
+bool HeliumSpaceService::IsItemKeyVisibleInBrowser(Browser* browser,
+                                                   std::string_view key) const {
+  if (!IsEligibleBrowser(browser)) {
+    return false;
+  }
+  constexpr std::string_view kFavoritePrefix = "f:";
+  if (key.starts_with(kFavoritePrefix)) {
+    return ResolveItem(browser, PersistentRecordKind::kFavorite,
+                       key.substr(kFavoritePrefix.size()))
+        .has_value();
+  }
+  const std::string pin_prefix =
+      base::StrCat({"p:", GetSpaceIdForBrowser(browser), ":"});
+  return key.starts_with(pin_prefix) &&
+         ResolveItem(browser, PersistentRecordKind::kPin,
+                     key.substr(pin_prefix.size()))
+             .has_value();
+}
+
+bool HeliumSpaceService::IsEligibleBrowser(Browser* browser) const {
+  return browser && browser->profile() == profile_ &&
+         browser->type() == Browser::TYPE_NORMAL &&
+         !profile_->IsOffTheRecord() && !profile_->IsGuestSession();
+}
+
+std::optional<PersistentLink> HeliumSpaceService::ResolveItem(
+    Browser* browser,
+    PersistentRecordKind kind,
+    std::string_view id) const {
+  if (!IsEligibleBrowser(browser)) {
+    return std::nullopt;
+  }
+  if (kind == PersistentRecordKind::kFavorite) {
+    PersistentNodes favorites = GetFavoritesForBrowser(browser);
+    if (const PersistentLink* link =
+            PersistentItemCodec::FindLink(favorites, id)) {
+      return *link;
+    }
+    return std::nullopt;
+  }
+  auto* self = const_cast<HeliumSpaceService*>(this);
+  HeliumSpace* space = self->GetSpaceById(GetSpaceIdForBrowser(browser));
+  if (!space) {
+    return std::nullopt;
+  }
+  if (const PersistentLink* link =
+          PersistentItemCodec::FindLink(space->pins(), id)) {
+    return *link;
+  }
+  return std::nullopt;
+}
+
+std::optional<PersistentLink> HeliumSpaceService::ResolvePinInSpace(
+    std::string_view space_id,
+    std::string_view id) const {
+  auto* self = const_cast<HeliumSpaceService*>(this);
+  HeliumSpace* space = self->GetSpaceById(space_id);
+  if (!space) {
+    return std::nullopt;
+  }
+  if (const PersistentLink* link =
+          PersistentItemCodec::FindLink(space->pins(), id)) {
+    return *link;
+  }
+  return std::nullopt;
+}
