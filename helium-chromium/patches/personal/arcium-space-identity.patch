+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARCIUM_SPACE_DIRECTORY_H_
+#define CHROME_BROWSER_UI_HELIUM_ARCIUM_SPACE_DIRECTORY_H_
+
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "chrome/browser/ui/helium/helium_space.h"
+
+class BrowserWindowInterface;
+class PrefRegistrySimple;
+class Profile;
+
+namespace helium {
+
+// Each profile owns its Spaces. Local State keeps one ordered directory of
+// every profile's Spaces so the switcher can list Spaces from profiles that
+// are not loaded yet.
+inline constexpr char kArciumSpaceDirectoryPref[] = "arcium.spaces.directory";
+
+struct SpaceDirectoryEntry {
+  base::FilePath profile_path;
+  std::u16string profile_name;
+  std::string space_id;
+  std::u16string name;
+  std::string icon;
+};
+
+void RegisterSpaceDirectoryLocalStatePrefs(PrefRegistrySimple* registry);
+
+// Spaces of every profile that can open a window, in switcher order.
+std::vector<SpaceDirectoryEntry> GetSpaceDirectory();
+
+// Profiles that can own a new Space, in the profile picker's order.
+std::vector<std::pair<base::FilePath, std::u16string>> GetSpaceProfiles();
+
+// Lists Spaces of profiles that have not loaded since the directory existed,
+// read from their preference files in the background. Runs once per process.
+void SeedSpaceDirectoryFromDisk();
+
+// Rewrites `profile`'s entries in place and appends its new Spaces.
+void SyncSpaceDirectory(Profile* profile,
+                        const std::vector<HeliumSpace*>& spaces);
+
+// The frame a Space window should take when it replaces `from`.
+std::optional<SpaceWindowPlacement> GetSpaceWindowPlacement(
+    BrowserWindowInterface* from);
+
+// Opens a Space's window in place of the current one, loading its profile
+// first when needed.
+void OpenSpaceFromDirectory(const base::FilePath& profile_path,
+                            std::string space_id,
+                            std::optional<SpaceWindowPlacement> placement);
+
+// Shows a Space to the user coming from `from`. A Space of `from`'s profile
+// that no window shows replaces `from`'s Space in the same window, unless a
+// page there asks before it is left; any other Space opens or raises its own
+// window. Returns true for the same window.
+bool SwitchToSpace(BrowserWindowInterface* from,
+                   const base::FilePath& profile_path,
+                   const std::string& space_id);
+
+// The last Space anywhere cannot be deleted.
+bool CanDeleteSpace();
+
+// Whether deleting `space_id` would leave `profile` without Spaces, which
+// deletes the profile with it.
+bool IsOnlySpaceInProfile(Profile* profile);
+
+// Deletes a Space. When `from` shows it, `from`'s neighbour in the Space bar
+// takes its place at the same frame first. The only Space of a profile goes
+// with the profile itself: its windows, Favorites, history, and data.
+// `delete_profile` must match IsOnlySpaceInProfile(): the caller confirmed
+// exactly that scope. Returns false and changes nothing otherwise.
+bool DeleteSpace(Profile* profile,
+                 const std::string& space_id,
+                 BrowserWindowInterface* from,
+                 bool delete_profile);
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARCIUM_SPACE_DIRECTORY_H_
