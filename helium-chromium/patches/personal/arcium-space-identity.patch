+
+ArciumSpaceIconPicker::ArciumSpaceIconPicker(views::View* anchor,
+                                             const std::string& current_icon,
+                                             PickedCallback picked,
+                                             base::OnceClosure closed)
+    : closed_(std::move(closed)) {
+  delegate_ = std::make_unique<views::BubbleDialogDelegate>(
+      anchor, views::BubbleBorder::TOP_LEFT, views::BubbleBorder::DIALOG_SHADOW,
+      /*autosize=*/true);
+  delegate_->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  delegate_->SetShowCloseButton(false);
+  delegate_->set_margins(gfx::Insets());
+  delegate_->SetAccessibleTitle(u"Choose a Space icon");
+  auto* contents = delegate_->SetContentsView(std::make_unique<IconPickerView>(
+      current_icon,
+      base::BindRepeating(&ArciumSpaceIconPicker::OnPicked,
+                          base::Unretained(this), std::move(picked))));
+  delegate_->SetInitiallyFocusedView(contents->search());
+  widget_ = views::BubbleDialogDelegate::CreateBubble(
+      delegate_.get(), base::BindOnce(&ArciumSpaceIconPicker::OnWidgetClosed,
+                                      base::Unretained(this)));
+  widget_->Show();
+}
+
+ArciumSpaceIconPicker::~ArciumSpaceIconPicker() {
+  closed_.Reset();
+  widget_.reset();
+}
+
+void ArciumSpaceIconPicker::Close() {
+  if (widget_) {
+    widget_->Close();
+  }
+}
+
+void ArciumSpaceIconPicker::OnPicked(PickedCallback picked,
+                                     const std::string& icon) {
+  picked.Run(icon);
+  Close();
+}
+
+void ArciumSpaceIconPicker::OnWidgetClosed(
+    views::Widget::ClosedReason reason) {
+  widget_.reset();
+  if (closed_) {
+    std::move(closed_).Run();
+  }
+}
