+bool IconCell::OnKeyPressed(const ui::KeyEvent& event) {
+  // macOS buttons ignore Return; in this grid it chooses the focused icon.
+  if (event.key_code() == ui::VKEY_RETURN) {
+    NotifyClick(event);
+    return true;
+  }
+  return grid_->HandleArrow(this, event.key_code()) ||
+         ArciumSpaceIconButton::OnKeyPressed(event);
+}
