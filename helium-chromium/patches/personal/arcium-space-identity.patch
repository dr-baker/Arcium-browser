+}
+
+ArciumThemeSwatchButton::~ArciumThemeSwatchButton() = default;
+
+void ArciumThemeSwatchButton::SetSelected(bool selected) {
+  if (selected_ != selected) {
+    selected_ = selected;
+    UpdateAccessibleCheckedState();
+    SchedulePaint();
+  }
+}
+
+bool ArciumThemeSwatchButton::IsGroupFocusTraversable() const {
+  // One Tab stop for the palette; arrow keys move within it.
+  return false;
+}
+
+views::View* ArciumThemeSwatchButton::GetSelectedViewForGroup(int group) {
+  views::View::Views views;
+  parent()->parent()->GetViewsInGroup(group, &views);
+  for (views::View* view : views) {
+    if (static_cast<ArciumThemeSwatchButton*>(view)->selected_) {
+      return view;
+    }
+  }
+  return views.empty() ? nullptr : views.front();
+}
+
+void ArciumThemeSwatchButton::UpdateAccessibleCheckedState() {
+  GetViewAccessibility().SetCheckedState(selected_
+                                             ? ax::mojom::CheckedState::kTrue
+                                             : ax::mojom::CheckedState::kFalse);
+}
+
+gfx::Size ArciumThemeSwatchButton::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(kSwatchSize, kSwatchSize);
+}
+
+void ArciumThemeSwatchButton::PaintButtonContents(gfx::Canvas* canvas) {
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  const gfx::RectF bounds(GetLocalBounds());
+  const gfx::PointF center = bounds.CenterPoint();
+  const float radius = bounds.width() / 2.f;
+  const SkColor foreground = colors->GetColor(ui::kColorLabelForeground);
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  if (selected_) {
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(2.f);
+    flags.setColor(foreground);
+    canvas->DrawCircle(center, radius - 1.f, flags);
+  }
+  const float inner = selected_ ? radius - 4.f : radius - 1.f;
+  if (color_) {
+    flags.setStyle(cc::PaintFlags::kFill_Style);
+    flags.setColor(*color_);
+    canvas->DrawCircle(center, inner, flags);
+    return;
+  }
+  // Reset to the profile's look: a return arrow inside an outline.
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setStrokeWidth(1.5f);
+  flags.setColor(SkColorSetA(foreground, 0xA0));
+  canvas->DrawCircle(center, inner - 0.75f, flags);
+  gfx::Rect glyph = GetLocalBounds();
+  glyph.ClampToCenteredSize(gfx::Size(width() * 3 / 5, height() * 3 / 5));
+  helium::PaintSpaceIcon(canvas,
+                         helium::MakePhosphorIcon("arrow-counter-clockwise"),
+                         glyph,
+                         SkColorSetA(foreground, 0xC0));
+}
+
+BEGIN_METADATA(ArciumThemeSwatchButton)
+END_METADATA
+
+base::span<const SpaceThemeSwatch> GetSpaceThemeSwatches() {
+  return kSwatches;
+}
