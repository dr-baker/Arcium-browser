+constexpr char kIconKey[] = "icon";
+constexpr char kThemeKey[] = "theme";
+constexpr char kPinsCollapsedKey[] = "pins_collapsed";
+constexpr char kThemeColorKey[] = "color";
+constexpr char kThemeModeKey[] = "mode";
+constexpr char kThemeWebModeKey[] = "web_mode";
+constexpr char kThemeBackgroundKey[] = "background";
+constexpr char kBackgroundGlowsKey[] = "glows";
+constexpr char kBackgroundTintKey[] = "tint_strength";
+constexpr char kBackgroundGrainKey[] = "grain";
+constexpr char kGlowXKey[] = "x";
+constexpr char kGlowYKey[] = "y";
+constexpr char kGlowRadiusKey[] = "radius";
+constexpr char kGlowOpacityKey[] = "opacity";
+
+std::optional<SkColor> ParseColor(const std::string* value) {
+  uint32_t rgb = 0;
+  if (value && value->size() == 7 && (*value)[0] == '#' &&
+      base::HexStringToUInt(std::string_view(*value).substr(1), &rgb)) {
+    return SkColorSetA(rgb, SK_AlphaOPAQUE);
+  }
+  return std::nullopt;
+}
+
+std::string ColorString(SkColor color) {
+  return base::StringPrintf("#%02x%02x%02x", SkColorGetR(color),
+                            SkColorGetG(color), SkColorGetB(color));
+}
+
+SpaceTheme::Mode ParseMode(const std::string* value) {
+  if (value && *value == "light") {
+    return SpaceTheme::Mode::kLight;
+  }
+  if (value && *value == "dark") {
+    return SpaceTheme::Mode::kDark;
+  }
+  return SpaceTheme::Mode::kAuto;
+}
+
+const char* ModeString(SpaceTheme::Mode mode) {
+  return mode == SpaceTheme::Mode::kLight  ? "light"
+         : mode == SpaceTheme::Mode::kDark ? "dark"
+                                           : "auto";
+}
+
+double Fraction(const base::DictValue& dict,
+                std::string_view key,
+                double fallback) {
+  return std::clamp(dict.FindDouble(key).value_or(fallback), 0.0, 1.0);
+}
+
+std::optional<SpaceBackground> ParseBackground(const base::DictValue* dict) {
+  if (!dict) {
+    return std::nullopt;
+  }
+  SpaceBackground background;
+  background.tint_strength =
+      Fraction(*dict, kBackgroundTintKey, background.tint_strength);
+  background.grain = Fraction(*dict, kBackgroundGrainKey, background.grain);
+  if (const base::ListValue* glows = dict->FindList(kBackgroundGlowsKey)) {
+    for (const base::Value& value : *glows) {
+      const base::DictValue* glow = value.GetIfDict();
+      std::optional<SkColor> color =
+          glow ? ParseColor(glow->FindString(kThemeColorKey)) : std::nullopt;
+      if (!color || background.glows.size() == SpaceBackground::kMaxGlows) {
+        continue;
+      }
+      background.glows.push_back({
+          .color = *color,
+          .x = Fraction(*glow, kGlowXKey, 0.5),
+          .y = Fraction(*glow, kGlowYKey, 0.5),
+          // The Appearance setting's radius range.
+          .radius = std::clamp(glow->FindDouble(kGlowRadiusKey).value_or(0.8),
+                               0.1, 1.5),
+          .opacity = Fraction(*glow, kGlowOpacityKey, 0.5),
+      });
+    }
+  }
+  return background;
+}
+
+base::DictValue SerializeBackground(const SpaceBackground& background) {
+  base::ListValue glows;
+  for (const SpaceGlow& glow : background.glows) {
+    glows.Append(base::DictValue()
+                     .Set(kThemeColorKey, ColorString(glow.color))
+                     .Set(kGlowXKey, glow.x)
+                     .Set(kGlowYKey, glow.y)
+                     .Set(kGlowRadiusKey, glow.radius)
+                     .Set(kGlowOpacityKey, glow.opacity));
+  }
+  return base::DictValue()
+      .Set(kBackgroundGlowsKey, std::move(glows))
+      .Set(kBackgroundTintKey, background.tint_strength)
+      .Set(kBackgroundGrainKey, background.grain);
+}
+
+// A Space window opened from another one sits slightly down and to the
+// right of it, so both stay visible as separate windows.
+constexpr int kSpaceWindowOffset = 28;
+
 }  // namespace
 
+// static
+SpaceTheme SpaceTheme::FromDict(const base::DictValue* dict) {
+  SpaceTheme theme;
+  if (!dict) {
+    return theme;
+  }
+  theme.color = ParseColor(dict->FindString(kThemeColorKey));
+  theme.mode = ParseMode(dict->FindString(kThemeModeKey));
+  theme.web_mode = ParseMode(dict->FindString(kThemeWebModeKey));
+  theme.background = ParseBackground(dict->FindDict(kThemeBackgroundKey));
+  return theme;
+}
+
+base::DictValue SpaceTheme::ToDict() const {
+  base::DictValue dict;
+  if (color) {
+    dict.Set(kThemeColorKey, ColorString(*color));
+  }
+  dict.Set(kThemeModeKey, ModeString(mode));
+  dict.Set(kThemeWebModeKey, ModeString(web_mode));
+  if (background) {
+    dict.Set(kThemeBackgroundKey, SerializeBackground(*background));
+  }
+  return dict;
+}
