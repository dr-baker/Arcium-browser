+ArciumSpaceThemeEditor::~ArciumSpaceThemeEditor() = default;
+
+void ArciumSpaceThemeEditor::SetProfilePrefs(const PrefService* profile_prefs) {
+  profile_background_ = ProfileBackground(profile_prefs);
+  UpdateControls();
+}
+
+const helium::SpaceBackground& ArciumSpaceThemeEditor::shown_background()
+    const {
+  return theme_.background ? *theme_.background : profile_background_;
+}
+
+helium::SpaceBackground& ArciumSpaceThemeEditor::EnsureBackground() {
+  if (!theme_.background) {
+    helium::SpaceBackground background = profile_background_;
+    if (background.glows.empty()) {
+      background.glows.assign(std::begin(kDefaultGlows),
+                              std::end(kDefaultGlows));
+    }
+    // Keep the profile's intensity unless it is effectively off, which would
+    // hide every glow the user is about to edit.
+    if (background.tint_strength < 0.05) {
+      background.tint_strength = 0.4;
+    }
+    theme_.background = std::move(background);
+  }
+  return *theme_.background;
+}
+
+void ArciumSpaceThemeEditor::SelectGlow(size_t index) {
+  if (index < shown_background().glows.size() && selected_glow_ != index) {
+    selected_glow_ = index;
+    UpdateControls();
+  }
+}
+
+void ArciumSpaceThemeEditor::MoveGlow(size_t index, double x, double y) {
+  helium::SpaceBackground& background = EnsureBackground();
+  if (index >= background.glows.size()) {
+    return;
+  }
+  background.glows[index].x = x;
+  background.glows[index].y = y;
+  selected_glow_ = index;
+  Changed();
+}
+
+void ArciumSpaceThemeEditor::AddGlow(double x, double y) {
+  helium::SpaceBackground& background = EnsureBackground();
+  if (background.glows.size() >= helium::SpaceBackground::kMaxGlows) {
+    return;
+  }
+  helium::SpaceGlow glow{.x = x, .y = y};
+  glow.color = selected_glow_ && *selected_glow_ < background.glows.size()
+                   ? background.glows[*selected_glow_].color
+                   : kDefaultGlows[background.glows.size() % 2].color;
+  background.glows.push_back(glow);
+  selected_glow_ = background.glows.size() - 1;
+  Changed();
+}
+
+void ArciumSpaceThemeEditor::RemoveGlow(size_t index) {
+  helium::SpaceBackground& background = EnsureBackground();
+  if (index >= background.glows.size()) {
+    return;
+  }
+  background.glows.erase(background.glows.begin() + index);
+  selected_glow_.reset();
+  if (!background.glows.empty()) {
+    selected_glow_ = std::min(index, background.glows.size() - 1);
+  }
+  Changed();
+}
+
+void ArciumSpaceThemeEditor::OnSwatchPressed(std::optional<SkColor> color) {
+  if (!color) {
+    // Back to the profile's background and chrome colors.
+    theme_.background.reset();
+    theme_.color.reset();
+    selected_glow_.reset();
+    Changed();
+    return;
+  }
+  helium::SpaceBackground& background = EnsureBackground();
+  if (background.glows.empty()) {
+    background.glows.push_back({.color = *color});
+  }
+  if (!selected_glow_ || *selected_glow_ >= background.glows.size()) {
+    selected_glow_ = 0;
+  }
+  background.glows[*selected_glow_].color = *color;
+  Changed();
+}
+
+void ArciumSpaceThemeEditor::OnModePressed(bool pages, Mode mode) {
+  (pages ? theme_.web_mode : theme_.mode) = mode;
+  Changed();
+}
+
+void ArciumSpaceThemeEditor::SliderValueChanged(
+    views::Slider* sender,
+    float value,
+    float old_value,
+    views::SliderChangeReason reason) {
+  if (reason != views::SliderChangeReason::kByUser) {
+    return;
+  }
+  helium::SpaceBackground& background = EnsureBackground();
+  if (sender == intensity_) {
+    background.tint_strength = value;
+  } else if (sender == grain_) {
+    background.grain = value * kMaxGrain;
+  }
+  Changed();
+}
+
+void ArciumSpaceThemeEditor::Changed() {
+  // The browser chrome takes its color seed from the first glow, so the
+  // toolbar and the background agree.
+  if (theme_.background) {
+    theme_.color = theme_.background->glows.empty()
+                       ? std::nullopt
+                       : std::optional(theme_.background->glows.front().color);
+  }
+  UpdateControls();
+  changed_.Run(theme_);
+}
+
+void ArciumSpaceThemeEditor::UpdateControls() {
+  const helium::SpaceBackground& background = shown_background();
+  if (selected_glow_ && *selected_glow_ >= background.glows.size()) {
+    selected_glow_.reset();
+  }
+  const std::optional<SkColor> selected_color =
+      !theme_.background ? std::nullopt
+      : selected_glow_   ? std::optional(background.glows[*selected_glow_].color)
+                         : std::nullopt;
+  for (ArciumThemeSwatchButton* swatch : swatches_) {
+    swatch->SetSelected(theme_.background ? swatch->color() == selected_color &&
+                                                selected_color.has_value()
+                                          : !swatch->color().has_value());
+  }
+  intensity_->SetValue(static_cast<float>(background.tint_strength));
+  grain_->SetValue(static_cast<float>(background.grain / kMaxGrain));
+  for (const auto& [mode, button] : browser_modes_) {
+    button->SetSelected(mode == theme_.mode);
+  }
+  for (const auto& [mode, button] : page_modes_) {
+    button->SetSelected(mode == theme_.web_mode);
+  }
+  add_glow_->SetEnabled(background.glows.size() <
+                        helium::SpaceBackground::kMaxGlows);
+  preview_->Rebuild();
+}
