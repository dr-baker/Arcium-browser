+void HeliumSpaceService::SetSpaceIcon(std::string_view id, std::string icon) {
+  if (HeliumSpace* space = GetSpaceById(id)) {
+    space->SetIcon(std::move(icon));
+    SyncSpaceDirectory(profile_, GetSpaces());
+    NotifyItemsChanged(PersistentItemChange::Space(space->id()));
+  }
+}
+
+void HeliumSpaceService::SetSpaceTheme(std::string_view id, SpaceTheme theme) {
+  if (HeliumSpace* space = GetSpaceById(id)) {
+    space->SetTheme(std::move(theme));
+    NotifyItemsChanged(PersistentItemChange::Space(space->id()));
+  }
+}
+
+const SpaceTheme* HeliumSpaceService::GetThemeForBrowser(
+    Browser* browser) const {
+  if (!browser) {
+    return nullptr;
+  }
+  if (auto preview = theme_previews_.find(browser->session_id());
+      preview != theme_previews_.end()) {
+    return &preview->second;
+  }
+  const std::string_view id = GetSpaceIdForBrowser(browser);
+  for (const auto& space : spaces_) {
+    if (space->id() == id) {
+      return space->theme().IsDefault() ? nullptr : &space->theme();
+    }
+  }
+  return nullptr;
+}
+
+void HeliumSpaceService::SetThemePreviewForBrowser(
+    Browser* browser,
+    std::optional<SpaceTheme> theme) {
+  if (!IsEligibleBrowser(browser)) {
+    return;
+  }
+  if (theme) {
+    theme_previews_.insert_or_assign(browser->session_id(), std::move(*theme));
+  } else {
+    theme_previews_.erase(browser->session_id());
+  }
+}
+
+void HeliumSpaceService::SetSpacePinsCollapsed(std::string_view id,
+                                               bool collapsed) {
+  HeliumSpace* space = GetSpaceById(id);
+  if (space && space->pins_collapsed() != collapsed) {
+    space->SetPinsCollapsed(collapsed);
+    NotifyItemsChanged(PersistentItemChange::Space(space->id()));
+  }
+}
