+// Swatches in as many columns as the card's width allows.
+class SwatchGrid : public views::View {
+  METADATA_HEADER(SwatchGrid, views::View)
+
+ public:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    const int width = available_size.width().is_bounded()
+                          ? available_size.width().value()
+                          : kMaxColumns * kPitch;
+    const int columns = Columns(width);
+    const int rows =
+        (static_cast<int>(children().size()) + columns - 1) / columns;
+    return gfx::Size(columns * kPitch - kPadding,
+                     std::max(1, rows) * kPitch - kPadding);
+  }
+
+  void Layout(PassKey) override {
+    const int columns = Columns(width());
+    for (size_t i = 0; i < children().size(); ++i) {
+      const int index = static_cast<int>(i);
+      children()[i]->SetBounds((index % columns) * kPitch,
+                               (index / columns) * kPitch, kSwatch, kSwatch);
+    }
+  }
+
+ private:
+  static constexpr int kSwatch = 22;
+  static constexpr int kPitch = kSwatch + kPadding;
+  static constexpr int kMaxColumns = 12;
+
+  static int Columns(int width) {
+    return std::clamp((width + kPadding) / kPitch, 1, kMaxColumns);
+  }
+};
