+
+class ArciumSpaceIconButton;
+class ArciumSpaceIconPicker;
+class ArciumSpaceThemeEditor;
+class BrowserWindowInterface;
+class Profile;
+class ScopedProfileKeepAlive;
+
+namespace views {
+class BoxLayoutView;
+class Combobox;
+class Label;
+class MdTextButton;
+class Textfield;
+}  // namespace views
+
+// Sidebar form that creates a Space or edits one: icon, name, profile, and
+// theme. The profile is chosen once, at creation.
+class ArciumSpaceEditorView : public views::View,
+                              public views::TextfieldController {
+  METADATA_HEADER(ArciumSpaceEditorView, views::View)
+
+ public:
+  using PreviewThemeCallback =
+      base::RepeatingCallback<void(std::optional<helium::SpaceTheme>)>;
+
+  // Creates a Space when `space_id` is empty; otherwise edits that Space of
+  // `space_profile`. `preview_theme` shows the chosen theme on this window
+  // while the form is open; `close` removes the form.
+  ArciumSpaceEditorView(BrowserWindowInterface* browser,
+                        Profile* space_profile,
+                        std::string space_id,
+                        PreviewThemeCallback preview_theme,
+                        base::RepeatingClosure close);
+  ArciumSpaceEditorView(const ArciumSpaceEditorView&) = delete;
+  ArciumSpaceEditorView& operator=(const ArciumSpaceEditorView&) = delete;
+  ~ArciumSpaceEditorView() override;
+
+  void FocusName();
+  // Shows the inline confirmation for deleting the edited Space.
+  void ShowDeleteConfirmation();
+
+  // views::View:
+  bool AcceleratorPressed(const ui::Accelerator& accelerator) override;
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override;
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override;
+
+ private:
+  bool is_creating() const { return space_id_.empty(); }
+
+  std::unique_ptr<views::BoxLayoutView> CreateFieldRow();
+  std::unique_ptr<views::View> CreateNameRow();
+  std::unique_ptr<views::View> CreateProfileRow();
+  std::unique_ptr<views::View> CreateThemeRow();
+
+  void OpenIconPicker();
+  void OnIconPicked(const std::string& icon);
+  void OnIconPickerClosed();
+  void OnThemeChanged(const helium::SpaceTheme& theme);
+  void UpdateThemeControls();
+  helium::SpaceTheme PreviewForSelectedProfile() const;
+  Profile* SelectedProfile() const;
+  void OnProfileSelected();
+  void OnSelectedProfileLoaded(Profile* profile);
+  void UpdateSubmitButton();
+  void Submit();
+  void Cancel();
+  std::unique_ptr<views::View> CreateDeleteConfirmation(
+      const std::u16string& name);
+  void HideDeleteConfirmation();
+  void ConfirmDelete();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const raw_ptr<Profile> space_profile_;
+  // Editing another profile's Space must not outlive that profile.
+  std::unique_ptr<ScopedProfileKeepAlive> space_profile_keep_alive_;
+  const std::string space_id_;
+  PreviewThemeCallback preview_theme_;
+  base::RepeatingClosure close_;
+
+  std::string icon_;
+  helium::SpaceTheme theme_;
+  // Profiles offered for a new Space; the last combobox row creates one.
+  std::vector<std::pair<base::FilePath, std::u16string>> profiles_;
+
+  raw_ptr<ArciumSpaceIconButton> icon_button_ = nullptr;
+  raw_ptr<views::Textfield> name_field_ = nullptr;
+  raw_ptr<views::Combobox> profile_combobox_ = nullptr;
+  raw_ptr<ArciumSpaceThemeEditor> theme_editor_ = nullptr;
+  raw_ptr<views::MdTextButton> submit_button_ = nullptr;
+  raw_ptr<views::BoxLayoutView> actions_ = nullptr;
+  raw_ptr<views::MdTextButton> delete_button_ = nullptr;
+  raw_ptr<views::View> delete_confirmation_ = nullptr;
+  raw_ptr<views::Label> delete_message_ = nullptr;
+  raw_ptr<views::MdTextButton> keep_button_ = nullptr;
+  // Whether the confirmation shown said the profile goes too.
+  bool delete_includes_profile_ = false;
+  std::unique_ptr<ArciumSpaceIconPicker> icon_picker_;
+
+  base::WeakPtrFactory<ArciumSpaceEditorView> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_ARCIUM_SPACE_EDITOR_VIEW_H_
