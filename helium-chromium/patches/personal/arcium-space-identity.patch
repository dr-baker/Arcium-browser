+bool HeliumSpaceService::IsUnusedStarterSpace(const HeliumSpace& space) const {
+  return !fresh_starter_space_id_.empty() &&
+         space.id() == fresh_starter_space_id_ && space.name() == u"Space" &&
+         space.pins().empty() && space.source_profile().empty() &&
+         space.icon().empty() && space.theme().IsDefault() &&
