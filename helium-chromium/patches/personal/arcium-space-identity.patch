+// Whether a frame of `contents` asks before it is left, as a page with unsaved
+// changes does.
+bool AsksBeforeLeaving(content::WebContents* contents) {
+  bool asks = false;
+  contents->GetPrimaryMainFrame()->ForEachRenderFrameHost(
+      [&asks](content::RenderFrameHost* frame) {
+        asks = asks || frame->GetSuddenTerminationDisablerState(
+                           blink::mojom::SuddenTerminationDisablerType::
+                               kBeforeUnloadHandler);
+      });
+  return asks;
+}
