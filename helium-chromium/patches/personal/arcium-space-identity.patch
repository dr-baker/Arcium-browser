+void CreateSpaceInProfile(std::u16string name,
+                          std::string icon,
+                          helium::SpaceTheme theme,
+                          std::optional<helium::SpaceWindowPlacement> placement,
+                          Profile* profile) {
+  if (!profile || Browser::GetCreationStatusForProfile(profile) !=
+                      Browser::CreationStatus::kOk) {
+    return;
+  }
+  auto* service = helium::HeliumSpaceServiceFactory::GetForProfile(profile);
+  if (!service) {
+    return;
+  }
+  helium::HeliumSpace* space =
+      service->CreateSpace(std::move(name), std::move(icon), std::move(theme));
+  space->ActivateOrCreatePrimaryWindow(placement);
+}
+
+// A profile made for a Space starts with the sidebar layout of the window it
+// was made from, so the new Space shows its header and switcher.
+void CreateSpaceInNewProfile(int layout,
+                             std::u16string name,
+                             std::string icon,
+                             helium::SpaceTheme theme,
+                             std::optional<helium::SpaceWindowPlacement> placement,
+                             Profile* profile) {
+  if (profile) {
+    profile->GetPrefs()->SetInteger(prefs::kHeliumLayout, layout);
+  }
+  CreateSpaceInProfile(std::move(name), std::move(icon), std::move(theme),
+                       placement, profile);
+}
