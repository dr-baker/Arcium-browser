+
+HeliumSpace* HeliumSpaceService::CreateSpace(std::u16string name,
+                                             std::string icon,
+                                             SpaceTheme theme) {
+  HeliumSpace* space = nullptr;
+  if (spaces_.size() == 1u && IsUnusedStarterSpace(*spaces_.front())) {
+    // A new profile starts with one empty Space. Reuse it so the profile's
+    // first user Space is not joined by an empty extra one.
+    space = spaces_.front().get();
+    fresh_starter_space_id_.clear();
+    space->SetName(std::move(name));
+  } else {
+    space = GetOrCreateSpaceReplacingPins(NewId(), std::move(name), {});
+  }
+  space->SetIcon(std::move(icon));
+  space->SetTheme(std::move(theme));
+  SyncSpaceDirectory(profile_, GetSpaces());
+  NotifyItemsChanged(PersistentItemChange::Space(space->id()));
+  return space;
+}
