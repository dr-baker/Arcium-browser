+void ArciumSpaceIconButton::PaintButtonContents(gfx::Canvas* canvas) {
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  gfx::Rect bounds = GetContentsBounds();
+  const bool hovered = GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+  if (selected_ || hovered) {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(colors->GetColor(selected_ ? ui::kColorSysTonalContainer
+                                              : ui::kColorSysStateHoverOnSubtle));
+    canvas->DrawRoundRect(bounds, kCornerRadius, flags);
+  }
+  const SkColor foreground = colors->GetColor(foreground_color_id_);
+  if (placeholder_outline_ && icon_.empty()) {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(1.f);
+    flags.setColor(SkColorSetA(foreground, 0x99));
+    constexpr float kDash[] = {3.f, 2.f};
+    flags.setPathEffect(cc::PathEffect::MakeDash(kDash, 2, 0));
+    gfx::RectF outline(bounds);
+    outline.Inset(4.5f);
+    canvas->DrawRoundRect(outline, kCornerRadius - 2, flags);
+    gfx::Rect plus = bounds;
+    plus.ClampToCenteredSize(gfx::Size(glyph_size_ * 3 / 4, glyph_size_ * 3 / 4));
+    helium::PaintSpaceIcon(canvas, helium::MakePhosphorIcon("plus"), plus,
+                           SkColorSetA(foreground, 0xCC));
+    return;
+  }
+  bounds.ClampToCenteredSize(gfx::Size(glyph_size_, glyph_size_));
+  helium::PaintSpaceIcon(canvas, icon_, bounds, foreground);
+}
