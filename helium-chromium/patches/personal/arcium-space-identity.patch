+class IconPickerView : public views::View, public views::TextfieldController {
+  METADATA_HEADER(IconPickerView, views::View)
+
+ public:
+  IconPickerView(const std::string& current_icon, PickCallback pick)
+      : pick_(pick) {
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(kPadding),
+        kPadding));
+    search_ = AddChildView(std::make_unique<views::Textfield>());
+    search_->SetPlaceholderText(u"Search icons or type an emoji");
+    search_->GetViewAccessibility().SetName(u"Search icons");
+    search_->SetController(this);
+
+    auto* scroll = AddChildView(std::make_unique<views::ScrollView>());
+    scroll->SetHorizontalScrollBarMode(
+        views::ScrollView::ScrollBarMode::kDisabled);
+    // Few results shrink the bubble; many scroll.
+    scroll->ClipHeightTo(kCell + 2 * kGridInset,
+                         kVisibleRows * kCell + 2 * kGridInset);
+    scroll->SetBackgroundColor(std::nullopt);
+    grid_ = scroll->SetContents(
+        std::make_unique<IconGridView>(current_icon, std::move(pick)));
+    grid_->SetScrollView(scroll);
+    grid_->Filter(std::u16string_view());
+    // Every scroll path, including the scrollbar and the compositor, reports
+    // here; the grid then shows the rows that came into view.
+    scrolled_subscription_ = scroll->AddContentsScrolledCallback(
+        base::BindRepeating(&IconGridView::UpdateVisibleCells,
+                            base::Unretained(grid_.get())));
+  }
+
+  views::Textfield* search() { return search_; }
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override {
+    grid_->Filter(new_contents);
+  }
+
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& event) override {
+    if (event.type() != ui::EventType::kKeyPressed) {
+      return false;
+    }
+    if (event.key_code() == ui::VKEY_DOWN) {
+      grid_->FocusCurrent();
+      return true;
+    }
+    if (event.key_code() == ui::VKEY_RETURN && grid_->first()) {
+      pick_.Run(grid_->first()->icon());
+      return true;
+    }
+    return false;
+  }
+
+ private:
+  PickCallback pick_;
+  raw_ptr<views::Textfield> search_ = nullptr;
+  raw_ptr<IconGridView> grid_ = nullptr;
+  base::CallbackListSubscription scrolled_subscription_;
+};
