+      preview_theme_(std::move(preview_theme)),
+      close_(std::move(close)) {
+  if (space_profile_ && space_profile_ != browser_->GetProfile()) {
+    // Reuses the Arcium Settings origin: both are Arcium UI that edits a
+    // profile from outside its windows.
+    space_profile_keep_alive_ = std::make_unique<ScopedProfileKeepAlive>(
+        space_profile_, ProfileKeepAliveOrigin::kArciumSettingsWindow);
+  }
+  AddAccelerator(ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE));
+  std::u16string name;
+  if (!is_creating()) {
+    auto* service =
+        helium::HeliumSpaceServiceFactory::GetForProfile(space_profile_);
+    if (helium::HeliumSpace* space =
+            service ? service->GetSpaceById(space_id_) : nullptr) {
+      name = space->name();
+      icon_ = space->icon();
+      theme_ = space->theme();
+    }
+  }
+
+  auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets::VH(16, 0),
+      kRowSpacing));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kStretch);
+
+  auto* title = AddChildView(std::make_unique<views::Label>(
+      is_creating() ? u"Create a Space" : u"Edit Space",
+      views::style::CONTEXT_DIALOG_TITLE, views::style::STYLE_HEADLINE_4));
+  title->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  if (is_creating()) {
+    auto* subtitle = AddChildView(std::make_unique<views::Label>(
+        u"Separate your tabs for life, work, projects, and more.",
+        views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+    subtitle->SetMultiLine(true);
+    subtitle->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    subtitle->SetProperty(views::kMarginsKey, gfx::Insets::TLBR(0, 0, 8, 0));
+  }
+
+  AddChildView(CreateNameRow());
+  name_field_->SetText(name);
+  AddChildView(CreateProfileRow());
+  AddChildView(CreateThemeRow());
+
+  // The actions follow the fields instead of sinking to the sidebar's bottom.
+  actions_ = AddChildView(std::make_unique<views::BoxLayoutView>());
+  actions_->SetOrientation(views::BoxLayout::Orientation::kVertical);
+  actions_->SetCrossAxisAlignment(
+      views::BoxLayout::CrossAxisAlignment::kStretch);
+  actions_->SetBetweenChildSpacing(kRowSpacing);
+  actions_->SetProperty(views::kMarginsKey,
+                        gfx::Insets::TLBR(kRowPadding, 0, 0, 0));
+  submit_button_ = actions_->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&ArciumSpaceEditorView::Submit,
+                          base::Unretained(this)),
+      is_creating() ? u"Create Space" : u"Save"));
+  submit_button_->SetStyle(ui::ButtonStyle::kProminent);
+  submit_button_->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  auto* cancel = actions_->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&ArciumSpaceEditorView::Cancel,
+                          base::Unretained(this)),
+      u"Cancel"));
+  cancel->SetStyle(ui::ButtonStyle::kText);
+  cancel->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  if (!is_creating()) {
+    delete_button_ =
+        actions_->AddChildView(std::make_unique<views::MdTextButton>(
+            base::BindRepeating(&ArciumSpaceEditorView::ShowDeleteConfirmation,
+                                base::Unretained(this)),
+            u"Delete Space…"));
+    delete_button_->SetStyle(ui::ButtonStyle::kText);
+    delete_button_->SetEnabledTextColors(ui::kColorSysError);
+    delete_button_->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    if (!helium::CanDeleteSpace()) {
+      delete_button_->SetEnabled(false);
+      delete_button_->SetTooltipText(
+          u"Create another Space before deleting this one");
+    }
+    AddChildView(CreateDeleteConfirmation(name));
+  }
+
+  UpdateThemeControls();
+  UpdateSubmitButton();
+}
