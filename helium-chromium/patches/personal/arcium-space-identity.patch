+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const auto& glows = editor_->shown_background().glows;
+    if (index_ >= glows.size()) {
+      return;
+    }
+    const auto& selected = editor_->selected_glow();
+    const bool is_selected = selected && *selected == index_;
+    const gfx::PointF center = gfx::RectF(GetLocalBounds()).CenterPoint();
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(glows[index_].color);
+    canvas->DrawCircle(center, kDotRadius, flags);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(2.f);
+    flags.setColor(SK_ColorWHITE);
+    canvas->DrawCircle(center, kDotRadius, flags);
+    if (is_selected || HasFocus()) {
+      flags.setStrokeWidth(1.5f);
+      flags.setColor(SkColorSetA(SK_ColorBLACK, 0xA0));
+      canvas->DrawCircle(center, kDotRadius + 3.f, flags);
+    }
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    RequestFocus();
+    editor_->SelectGlow(index_);
+    return event.IsOnlyLeftMouseButton();
+  }
+
+  bool OnMouseDragged(const ui::MouseEvent& event) override {
+    gfx::Point point = event.location();
+    views::View::ConvertPointToTarget(this, preview_, &point);
+    const auto [x, y] = Fractions(*preview_, point);
+    editor_->MoveGlow(index_, x, y);
+    return true;
+  }
+
+  bool OnKeyPressed(const ui::KeyEvent& event) override {
+    const auto& glows = editor_->shown_background().glows;
+    if (index_ >= glows.size()) {
+      return false;
+    }
+    double x = glows[index_].x;
+    double y = glows[index_].y;
+    switch (event.key_code()) {
+      case ui::VKEY_LEFT:
+        x -= kArrowStep;
+        break;
+      case ui::VKEY_RIGHT:
+        x += kArrowStep;
+        break;
+      case ui::VKEY_UP:
+        y -= kArrowStep;
+        break;
+      case ui::VKEY_DOWN:
+        y += kArrowStep;
+        break;
+      case ui::VKEY_DELETE:
+      case ui::VKEY_BACK:
+        editor_->RemoveGlow(index_);
+        return true;
+      default:
+        return false;
+    }
+    editor_->MoveGlow(index_, std::clamp(x, 0.0, 1.0),
+                                 std::clamp(y, 0.0, 1.0));
+    return true;
+  }
+
+  void OnFocus() override {
+    editor_->SelectGlow(index_);
+    SchedulePaint();
+  }
+
+  void OnBlur() override { SchedulePaint(); }
+
+ private:
+  raw_ptr<ArciumSpaceThemeEditor> editor_;
+  raw_ptr<views::View> preview_;
+  const size_t index_;
+};
