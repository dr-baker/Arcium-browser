--- /dev/null
+++ src/chrome/browser/ui/views/helium/arcium_space_icon_picker.cc
@@ -0,0 +1,412 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/helium/arcium_space_icon_picker.h"
+
+#include <algorithm>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ui/helium/arcium_space_icon.h"
+#include "chrome/browser/ui/views/helium/arcium_space_controls.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/mojom/dialog_button.mojom.h"
+#include "ui/events/event.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/bubble/bubble_dialog_delegate_view.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/controls/scroll_view.h"
+#include "ui/views/controls/textfield/textfield.h"
+#include "ui/views/controls/textfield/textfield_controller.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/style/typography.h"
+#include "ui/views/view.h"
+
+namespace {
+
+constexpr int kColumns = 8;
+constexpr int kCell = 34;
+constexpr int kGlyph = 20;
+constexpr int kVisibleRows = 7;
+constexpr int kPadding = 10;
+// Room around the grid for a focused cell's ring.
+constexpr int kGridInset = 3;
+// Room on the right for the overlay scrollbar so the last column stays clear.
+constexpr int kScrollbarGutter = 10;
+
+using PickCallback = base::RepeatingCallback<void(const std::string&)>;
+
+std::u16string IconLabel(const std::string& icon) {
+  if (icon.empty()) {
+    return u"No icon";
+  }
+  const std::string_view glyph = helium::GetPhosphorIconName(icon);
+  if (glyph.empty()) {
+    return base::UTF8ToUTF16(icon);
+  }
+  std::string label(glyph);
+  std::ranges::replace(label, '-', ' ');
+  return base::UTF8ToUTF16(label);
+}
+
+// Emoji and other symbols typed into the search field become a text icon.
+// Keycaps and text-style symbols carry a variation selector or keycap mark
+// after an ASCII or Latin-1 first character.
+std::string EmojiCandidate(std::u16string_view query) {
+  const std::u16string_view trimmed =
+      base::TrimWhitespace(query, base::TRIM_ALL);
+  if (trimmed.empty()) {
+    return std::string();
+  }
+  const bool symbol = trimmed.front() >= 0x2190;
+  const bool selector = trimmed.size() > 1 && (trimmed[1] == 0xFE0F ||
+                                               trimmed[1] == 0x20E3);
+  return symbol || selector
+             ? helium::NormalizeSpaceIcon(base::UTF16ToUTF8(trimmed))
+             : std::string();
+}
+
+class IconGridView;
+
+// One choice in the grid. Arrow keys move along the grid; only the current
+// cell takes Tab focus.
+class IconCell : public ArciumSpaceIconButton {
+  METADATA_HEADER(IconCell, ArciumSpaceIconButton)
+
+ public:
+  IconCell(IconGridView* grid, PickCallback pick, std::string icon);
+
+  void SetCellIcon(std::string icon) {
+    SetIcon(icon);
+    SetTooltipText(IconLabel(icon));
+    GetViewAccessibility().SetName(IconLabel(icon));
+    GetViewAccessibility().SetRole(ax::mojom::Role::kListBoxOption);
+  }
+
+  // views::Button:
+  bool OnKeyPressed(const ui::KeyEvent& event) override;
+
+ private:
+  raw_ptr<IconGridView> grid_;
+};
+
+class IconGridView : public views::View {
+  METADATA_HEADER(IconGridView, views::View)
+
+ public:
+  IconGridView(const std::string& selected, PickCallback pick) {
+    GetViewAccessibility().SetRole(ax::mojom::Role::kListBox);
+    GetViewAccessibility().SetName(u"Icons");
+    emoji_cell_ = AddCell(pick, std::string());
+    none_cell_ = AddCell(pick, std::string());
+    for (const helium::PhosphorGlyph& glyph : helium::GetPhosphorGlyphs()) {
+      glyph_cells_.push_back(
+          AddCell(pick, helium::MakePhosphorIcon(glyph.name)));
+    }
+    for (IconCell* cell : glyph_cells_) {
+      cell->SetSelected(cell->icon() == selected);
+    }
+    none_cell_->SetSelected(selected.empty());
+    empty_ = AddChildView(std::make_unique<views::Label>(
+        u"No icons found", views::style::CONTEXT_LABEL,
+        views::style::STYLE_SECONDARY));
+  }
+
+  void Filter(std::u16string_view query) {
+    order_.clear();
+    const std::string emoji = EmojiCandidate(query);
+    if (!emoji.empty()) {
+      emoji_cell_->SetCellIcon(emoji);
+      order_.push_back(emoji_cell_);
+    } else if (base::TrimWhitespace(query, base::TRIM_ALL).empty()) {
+      order_.push_back(none_cell_);
+    }
+    const base::span<const helium::PhosphorGlyph> glyphs =
+        helium::GetPhosphorGlyphs();
+    for (const helium::PhosphorGlyph* glyph :
+         helium::SearchPhosphorGlyphs(query)) {
+      order_.push_back(glyph_cells_[static_cast<size_t>(glyph - glyphs.data())]);
+    }
+    for (views::View* child : children()) {
+      child->SetVisible(false);
+    }
+    // Every match is a positioned option; only the scrolled-to rows are shown,
+    // so the accessibility tree stays small enough to read with 1,500 icons.
+    for (size_t i = 0; i < order_.size(); ++i) {
+      order_[i]->GetViewAccessibility().SetPosInSet(static_cast<int>(i) + 1);
+      order_[i]->GetViewAccessibility().SetSetSize(
+          static_cast<int>(order_.size()));
+    }
+    empty_->SetVisible(order_.empty());
+    SetCurrent(order_.empty() ? nullptr : order_.front().get());
+    PreferredSizeChanged();
+    InvalidateLayout();
+  }
+
+  IconCell* first() { return order_.empty() ? nullptr : order_.front().get(); }
+
+  void FocusCurrent() {
+    if (current_) {
+      current_->SetVisible(true);
+      current_->RequestFocus();
+    }
+  }
+
+  // Moves focus by `delta` cells, or by rows for up and down.
+  bool HandleArrow(IconCell* cell, ui::KeyboardCode key) {
+    const auto found = std::ranges::find(order_, cell);
+    if (found == order_.end()) {
+      return false;
+    }
+    const int columns = Columns(width());
+    int delta = 0;
+    switch (key) {
+      case ui::VKEY_LEFT:
+        delta = -1;
+        break;
+      case ui::VKEY_RIGHT:
+        delta = 1;
+        break;
+      case ui::VKEY_UP:
+        delta = -columns;
+        break;
+      case ui::VKEY_DOWN:
+        delta = columns;
+        break;
+      default:
+        return false;
+    }
+    const int next = static_cast<int>(found - order_.begin()) + delta;
+    if (next >= 0 && next < static_cast<int>(order_.size())) {
+      SetCurrent(order_[static_cast<size_t>(next)]);
+      current_->SetVisible(true);
+      current_->ScrollViewToVisible();
+      current_->RequestFocus();
+    }
+    return true;
+  }
+
+  // Shows the cells in and near the scrolled-to rows, plus the focused one.
+  void SetScrollView(views::ScrollView* scroll) { scroll_ = scroll; }
+
+  void UpdateVisibleCells() {
+    // The scroll view's visible rect is in this view's coordinates whether it
+    // scrolls with layers or by moving this view.
+    gfx::Rect window = scroll_ ? scroll_->GetVisibleRect() : GetVisibleBounds();
+    window.Outset(gfx::Outsets::VH(2 * kCell, 0));
+    for (IconCell* cell : order_) {
+      cell->SetVisible(cell == current_ ||
+                       (!window.IsEmpty() && window.Intersects(cell->bounds())));
+    }
+  }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    const int width = available_size.width().is_bounded()
+                          ? available_size.width().value()
+                          : kColumns * kCell + 2 * kGridInset +
+                                kScrollbarGutter;
+    return gfx::Size(width, HeightForWidth(width) + 2 * kGridInset);
+  }
+
+  void Layout(PassKey) override {
+    const int columns = Columns(width());
+    for (size_t i = 0; i < order_.size(); ++i) {
+      order_[i]->SetBounds(kGridInset + (i % columns) * kCell,
+                           kGridInset + (i / columns) * kCell, kCell, kCell);
+    }
+    empty_->SetBoundsRect(GetLocalBounds());
+    UpdateVisibleCells();
+  }
+
+ private:
+  static int Columns(int width) {
+    return std::max(1, (width - 2 * kGridInset - kScrollbarGutter) / kCell);
+  }
+
+  int HeightForWidth(int width) const {
+    const int columns = Columns(width);
+    const int rows =
+        std::max<int>(1, (order_.size() + columns - 1) / columns);
+    return rows * kCell;
+  }
+
+  IconCell* AddCell(PickCallback pick, std::string icon) {
+    auto* cell = AddChildView(std::make_unique<IconCell>(this, pick, icon));
+    cell->SetFocusBehavior(FocusBehavior::NEVER);
+    return cell;
+  }
+
+  void SetCurrent(IconCell* cell) {
+    if (current_ == cell) {
+      return;
+    }
+    if (current_) {
+      current_->SetFocusBehavior(FocusBehavior::NEVER);
+    }
+    current_ = cell;
+    if (current_) {
+      current_->SetFocusBehavior(FocusBehavior::ALWAYS);
+    }
+  }
+
+  raw_ptr<IconCell> emoji_cell_ = nullptr;
+  raw_ptr<IconCell> none_cell_ = nullptr;
+  std::vector<raw_ptr<IconCell>> glyph_cells_;
+  raw_ptr<views::Label> empty_ = nullptr;
