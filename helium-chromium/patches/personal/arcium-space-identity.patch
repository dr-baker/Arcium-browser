+void ArciumSpaceEditorView::OnThemeChanged(const helium::SpaceTheme& theme) {
+  theme_ = theme;
+  UpdateThemeControls();
+}
+
+void ArciumSpaceEditorView::UpdateThemeControls() {
+  // Editing another window's Space would preview on the wrong window.
+  auto* service = helium::HeliumSpaceServiceFactory::GetForProfile(
+      browser_->GetProfile());
+  Browser* browser = browser_->GetBrowserForMigrationOnly();
+  if (is_creating()) {
+    preview_theme_.Run(PreviewForSelectedProfile());
+  } else if (space_profile_ == browser_->GetProfile() && service && browser &&
+             service->GetSpaceIdForBrowser(browser) == space_id_) {
+    preview_theme_.Run(theme_);
+  }
+}
