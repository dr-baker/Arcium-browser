+}  // namespace
+
+// A miniature of the window background. Each glow is a focusable handle:
+// drag or use arrow keys to move it, Delete to remove it. Clicking empty space
+// adds a glow there.
+class ArciumSpaceThemeEditor::Preview : public views::View {
+  METADATA_HEADER(Preview, views::View)
+
+ public:
+  explicit Preview(ArciumSpaceThemeEditor* editor) : editor_(editor) {
+    SetTooltipText(u"Click to add a glow. Drag a glow to move it.");
+    GetViewAccessibility().SetRole(ax::mojom::Role::kGroup);
+    GetViewAccessibility().SetName(u"Background preview");
+  }
+
+  void Rebuild() {
+    // Handles beyond the glow count hide rather than go away: a handle can
+    // remove its own glow from inside its key handler.
+    const size_t count = editor_->shown_background().glows.size();
+    while (children().size() < count) {
+      AddChildView(
+          std::make_unique<GlowHandle>(editor_, this, children().size()));
+    }
+    for (size_t i = 0; i < children().size(); ++i) {
+      children()[i]->SetVisible(i < count);
+      static_cast<GlowHandle*>(children()[i])->Update();
+    }
+    InvalidateLayout();
+    SchedulePaint();
+  }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(0, kPreviewHeight);
+  }
+
+  void Layout(PassKey) override {
+    const auto& glows = editor_->shown_background().glows;
+    for (size_t i = 0; i < children().size() && i < glows.size(); ++i) {
+      children()[i]->SetBounds(
+          static_cast<int>(glows[i].x * width()) - kHandleSize / 2,
+          static_cast<int>(glows[i].y * height()) - kHandleSize / 2,
+          kHandleSize, kHandleSize);
+    }
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* colors = GetColorProvider();
+    if (!colors) {
+      return;
+    }
+    const gfx::RectF bounds(GetLocalBounds());
+    gfx::ScopedCanvas scoped(canvas);
+    canvas->ClipPath(SkPath::RRect(SkRRect::MakeRectXY(
+                         gfx::RectFToSkRect(bounds), kRadius, kRadius)),
+                     true);
+    canvas->DrawColor(colors->GetColor(ui::kColorSysSurface2));
+
+    const helium::SpaceBackground& background = editor_->shown_background();
+    const float extent = std::max(bounds.width(), bounds.height());
+    for (const helium::SpaceGlow& glow : background.glows) {
+      // The miniature is shorter than a window; strengthen the glows a little
+      // so they read at this size.
+      const float alpha = std::clamp(
+          static_cast<float>(glow.opacity * background.tint_strength * 1.6),
+          0.f, 1.f);
+      const SkColor4f center = SkColor4f::FromColor(glow.color);
+      const SkColor4f stops[] = {{center.fR, center.fG, center.fB, alpha},
+                                 {center.fR, center.fG, center.fB, 0.f}};
+      const SkScalar positions[] = {0.f, 1.f};
+      cc::PaintFlags flags;
+      flags.setAntiAlias(true);
+      flags.setShader(cc::PaintShader::MakeRadialGradient(
+          SkPoint::Make(glow.x * bounds.width(), glow.y * bounds.height()),
+          std::max(1.f, static_cast<float>(glow.radius) * extent * 0.6f),
+          stops, positions, 2, SkTileMode::kClamp));
+      canvas->DrawRect(bounds, flags);
+    }
+
+    // Grain: a fixed scatter of single-pixel specks.
+    if (background.grain > 0) {
+      cc::PaintFlags flags;
+      const auto alpha = static_cast<SkAlpha>(
+          std::clamp(background.grain / kMaxGrain, 0.0, 1.0) * 90);
+      uint32_t seed = 0x2545F491;
+      const int specks = static_cast<int>(bounds.width() * bounds.height() / 6);
+      for (int i = 0; i < specks; ++i) {
+        seed = seed * 1664525u + 1013904223u;
+        const float x = (seed >> 8) % std::max(1, width());
+        seed = seed * 1664525u + 1013904223u;
+        const float y = (seed >> 8) % std::max(1, height());
+        flags.setColor(SkColorSetA((seed & 1) ? SK_ColorWHITE : SK_ColorBLACK,
+                                   alpha));
+        canvas->DrawRect(gfx::RectF(x, y, 1, 1), flags);
+      }
+    }
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (!event.IsOnlyLeftMouseButton()) {
+      return false;
+    }
+    const auto [x, y] = Fractions(*this, event.location());
+    editor_->AddGlow(x, y);
+    // Keyboard focus follows the new glow so arrow keys move it.
+    if (const auto& selected = editor_->selected_glow();
+        selected && *selected < children().size()) {
+      children()[*selected]->RequestFocus();
+    }
+    return true;
+  }
+
+ private:
+  raw_ptr<ArciumSpaceThemeEditor> editor_;
+};
