+void VerticalTabStripRegionView::AnimateSpaceSwitch(int direction) {
+  ui::Layer* layer = tab_strip_view_ ? tab_strip_view_->layer() : nullptr;
+  if (!layer || !gfx::Animation::ShouldRenderRichAnimation()) {
+    return;
+  }
+  gfx::Transform start;
+  start.Translate(direction * tab_strip_view_->width() / 3.f, 0);
+  layer->SetTransform(start);
+  layer->SetOpacity(0.f);
+  views::AnimationBuilder()
+      .SetPreemptionStrategy(
+          ui::LayerAnimator::IMMEDIATELY_ANIMATE_TO_NEW_TARGET)
+      .Once()
+      .SetDuration(base::Milliseconds(220))
+      .SetTransform(layer, gfx::Transform(), gfx::Tween::EASE_OUT)
+      .SetOpacity(layer, 1.f, gfx::Tween::EASE_OUT);
+}
+
+void VerticalTabStripRegionView::ShowSpaceEditor(Profile* profile,
+                                                 std::string space_id,
+                                                 bool confirm_delete) {
+  // Opened from the compact rail: expand for the form, collapse again after
+  // the last form closes. Replacing an open form leaves the sidebar alone.
+  const bool replacing = space_editor_;
+  const bool collapse_after = replacing ? collapse_after_space_editor_
+                                        : state_controller_->IsCollapsed();
+  if (replacing) {
+    collapse_after_space_editor_ = false;
+    CloseSpaceEditor();
+  } else if (collapse_after) {
+    state_controller_->RequestCollapse(false);
+  }
+  collapse_after_space_editor_ = collapse_after;
+  const int horizontal_padding = arcium::GetChromeLayoutConstant(
+      this, LayoutConstant::kVerticalTabStripHorizontalPadding);
+  auto editor = std::make_unique<ArciumSpaceEditorView>(
+      browser_view_->browser(), profile, std::move(space_id),
+      base::BindRepeating(&VerticalTabStripBottomContainer::SetThemePreview,
+                          base::Unretained(bottom_button_container_.get())),
+      base::BindRepeating(&VerticalTabStripRegionView::CloseSpaceEditor,
+                          base::Unretained(this)));
+  editor->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::LayoutOrientation::kVertical,
+                               views::MinimumFlexSizeRule::kScaleToMinimum,
+                               views::MaximumFlexSizeRule::kUnbounded)
+          .WithWeight(1));
+  editor->SetProperty(views::kMarginsKey,
+                      gfx::Insets::VH(0, horizontal_padding));
+  space_editor_ = AddChildViewAt(std::move(editor),
+                                 GetIndexOf(tab_area_spacer_).value_or(0));
+  for (views::View* view :
+       {static_cast<views::View*>(new_tab_button_.get()),
+        tab_area_spacer_.get(), static_cast<views::View*>(tab_strip_view_)}) {
+    if (view) {
+      view->SetVisible(false);
+    }
+  }
+  InvalidateLayout();
+  if (confirm_delete) {
+    space_editor_->ShowDeleteConfirmation();
+  } else {
+    space_editor_->FocusName();
+  }
+}
+
+void VerticalTabStripRegionView::CloseSpaceEditor() {
+  if (!space_editor_) {
+    return;
+  }
+  bottom_button_container_->SetThemePreview(std::nullopt);
+  // The form closes from its own button handlers; remove it after they
+  // return.
+  ArciumSpaceEditorView* editor = space_editor_;
+  space_editor_ = nullptr;
+  base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, RemoveChildViewT(editor));
+  for (views::View* view :
+       {static_cast<views::View*>(new_tab_button_.get()),
+        tab_area_spacer_.get(), static_cast<views::View*>(tab_strip_view_)}) {
+    if (view) {
+      view->SetVisible(true);
+    }
+  }
+  InvalidateLayout();
+  if (collapse_after_space_editor_) {
+    collapse_after_space_editor_ = false;
+    state_controller_->RequestCollapse(true);
+  }
+}
