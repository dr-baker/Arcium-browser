+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arcium_space_icon.h"
+
+#include <algorithm>
+#include <map>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/i18n/break_iterator.h"
+#include "base/no_destructor.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "cc/paint/paint_flags.h"
+#include "third_party/skia/include/core/SkPath.h"
+#include "third_party/skia/include/utils/SkParsePath.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/font_list.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/image/canvas_image_source.h"
+#include "ui/gfx/scoped_canvas.h"
+
+namespace helium {
+namespace {
+
+constexpr PhosphorGlyph kGlyphs[] = {
+#include "third_party/phosphor-icons/phosphor_regular_icons.inc"
+};
+
+constexpr float kGlyphUnits = 256.f;
+
+// Shown first when the picker opens, roughly in Arc's order of common Spaces.
+constexpr const char* kSuggestedGlyphs[] = {
+    "house",        "briefcase",     "code",          "book-open",
+    "graduation-cap", "heart",       "star",          "shopping-cart",
+    "airplane",     "game-controller", "music-notes", "camera",
+    "palette",      "flask",         "globe",         "chat-circle",
+    "calendar",     "currency-dollar", "users",       "rocket",
+    "coffee",       "leaf",          "lightning",     "sun",
+    "moon",         "folder",        "terminal",      "pencil",
+    "newspaper",    "film-slate",    "barbell",       "bank",
+    "car",          "baby",          "dog",           "cat",
+    "tree",         "fire",          "planet",        "sparkle",
+};
+
+const SkPath* GetGlyphPath(const PhosphorGlyph& glyph) {
+  static base::NoDestructor<std::map<const PhosphorGlyph*, SkPath>> cache;
+  auto found = cache->find(&glyph);
+  if (found == cache->end()) {
+    std::optional<SkPath> path = SkParsePath::FromSVGString(glyph.path);
+    if (!path) {
+      return nullptr;
+    }
+    found = cache->emplace(&glyph, std::move(*path)).first;
+  }
+  return &found->second;
+}
+
+std::u16string FirstGrapheme(std::u16string_view text) {
+  base::i18n::BreakIterator iterator(text,
+                                     base::i18n::BreakIterator::BREAK_CHARACTER);
+  if (!iterator.Init() || !iterator.Advance()) {
+    return std::u16string(text);
+  }
+  return std::u16string(iterator.GetString());
+}
+
+class SpaceIconSource : public gfx::CanvasImageSource {
+ public:
+  SpaceIconSource(std::string icon, SkColor color, int size)
+      : gfx::CanvasImageSource(gfx::Size(size, size)),
+        icon_(std::move(icon)),
+        color_(color) {}
+
+  void Draw(gfx::Canvas* canvas) override {
+    PaintSpaceIcon(canvas, icon_, gfx::Rect(size()), color_);
+  }
+
+ private:
+  const std::string icon_;
+  const SkColor color_;
+};
+
+}  // namespace
+
+base::span<const PhosphorGlyph> GetPhosphorGlyphs() {
+  return kGlyphs;
+}
+
+const PhosphorGlyph* FindPhosphorGlyph(std::string_view name) {
+  const auto found = std::ranges::lower_bound(
+      kGlyphs, name, std::less<>(),
+      [](const PhosphorGlyph& glyph) { return std::string_view(glyph.name); });
+  return found != std::end(kGlyphs) && found->name == name ? &*found : nullptr;
+}
+
+std::string_view GetPhosphorIconName(std::string_view icon) {
+  return base::StartsWith(icon, kPhosphorIconPrefix)
+             ? icon.substr(sizeof(kPhosphorIconPrefix) - 1)
+             : std::string_view();
+}
+
+std::string MakePhosphorIcon(std::string_view name) {
+  return base::StrCat({kPhosphorIconPrefix, name});
+}
+
+std::string NormalizeSpaceIcon(std::string_view icon) {
+  const std::string_view trimmed =
+      base::TrimWhitespaceASCII(icon, base::TRIM_ALL);
+  if (base::StartsWith(trimmed, kPhosphorIconPrefix)) {
+    return FindPhosphorGlyph(GetPhosphorIconName(trimmed)) ? std::string(trimmed)
+                                                           : std::string();
+  }
+  return base::UTF16ToUTF8(FirstGrapheme(base::UTF8ToUTF16(trimmed)));
+}
+
+std::vector<const PhosphorGlyph*> SearchPhosphorGlyphs(
+    std::u16string_view query) {
+  std::vector<const PhosphorGlyph*> result;
+  // Glyph names are hyphenated; their keywords hold the separate words.
+  std::string normalized = base::ToLowerASCII(base::UTF16ToUTF8(query));
+  std::ranges::replace(normalized, '-', ' ');
+  const std::vector<std::string> words =
+      base::SplitString(normalized, base::kWhitespaceASCII,
+                        base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (words.empty()) {
+    for (const char* name : kSuggestedGlyphs) {
+      if (const PhosphorGlyph* glyph = FindPhosphorGlyph(name)) {
+        result.push_back(glyph);
+      }
+    }
+  }
+  const size_t suggested = result.size();
+  for (const PhosphorGlyph& glyph : kGlyphs) {
+    const std::string_view keywords(glyph.keywords);
+    const bool matches = std::ranges::all_of(words, [&](const std::string& word) {
+      return keywords.find(word) != std::string_view::npos;
+    });
+    if (matches &&
+        !std::ranges::contains(base::span(result).first(suggested), &glyph)) {
+      result.push_back(&glyph);
+    }
+  }
+  if (!words.empty()) {
+    // Names that start with the query read as the best answers.
+    std::ranges::stable_partition(result, [&](const PhosphorGlyph* glyph) {
+      return base::StartsWith(glyph->name, words.front());
+    });
+  }
+  return result;
+}
+
+void PaintPhosphorGlyph(gfx::Canvas* canvas,
+                        const PhosphorGlyph& glyph,
+                        const gfx::Rect& bounds,
+                        SkColor color) {
+  const SkPath* path = GetGlyphPath(glyph);
+  if (!path || bounds.IsEmpty()) {
+    return;
+  }
+  const int size = std::min(bounds.width(), bounds.height());
+  gfx::ScopedCanvas scoped(canvas);
+  canvas->sk_canvas()->translate(bounds.x() + (bounds.width() - size) / 2.f,
+                                 bounds.y() + (bounds.height() - size) / 2.f);
+  canvas->sk_canvas()->scale(size / kGlyphUnits, size / kGlyphUnits);
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kFill_Style);
+  flags.setColor(color);
+  canvas->DrawPath(*path, flags);
+}
+
+void PaintSpaceIcon(gfx::Canvas* canvas,
+                    std::string_view icon,
+                    const gfx::Rect& bounds,
+                    SkColor color) {
+  if (const PhosphorGlyph* glyph =
+          FindPhosphorGlyph(GetPhosphorIconName(icon))) {
+    PaintPhosphorGlyph(canvas, *glyph, bounds, color);
+    return;
+  }
+  const int size = std::min(bounds.width(), bounds.height());
+  if (icon.empty() || base::StartsWith(icon, kPhosphorIconPrefix)) {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(SkColorSetA(color, 0xB0));
+    canvas->DrawCircle(gfx::PointF(bounds.CenterPoint()), size * 0.17f, flags);
+    return;
+  }
+  const gfx::FontList base_font;
+  const int target = std::max(8, static_cast<int>(size * 0.8f));
+  canvas->DrawStringRectWithFlags(
+      base::UTF8ToUTF16(icon),
+      base_font.DeriveWithSizeDelta(target - base_font.GetFontSize()), color,
+      bounds, gfx::Canvas::TEXT_ALIGN_CENTER);
+}
+
+ui::ImageModel GetSpaceIconImage(std::string_view icon,
+                                 ui::ColorVariant color,
+                                 int size) {
+  return ui::ImageModel::FromImageGenerator(
+      base::BindRepeating(
+          [](const std::string& icon, ui::ColorVariant color, int size,
+             const ui::ColorProvider* provider) {
+            return gfx::CanvasImageSource::MakeImageSkia<SpaceIconSource>(
+                icon, color.ResolveToSkColor(provider), size);
+          },
+          std::string(icon), color, size),
+      gfx::Size(size, size));
+}
+
+}  // namespace helium
