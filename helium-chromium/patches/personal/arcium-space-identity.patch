+ArciumSpaceThemeEditor::ArciumSpaceThemeEditor(helium::SpaceTheme theme,
+                                               const PrefService* profile_prefs,
+                                               ChangedCallback changed)
+    : theme_(std::move(theme)),
+      profile_background_(ProfileBackground(profile_prefs)),
+      changed_(std::move(changed)) {
+  auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(kPadding),
+      kPadding));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kStretch);
+  SetBackground(views::CreateRoundedRectBackground(
+      ui::kColorSysStateHoverOnSubtle, kRadius));
+  GetViewAccessibility().SetRole(ax::mojom::Role::kGroup);
+  GetViewAccessibility().SetName(u"Theme");
+
+  auto* header = AddChildView(std::make_unique<views::BoxLayoutView>());
+  header->SetBetweenChildSpacing(kPadding);
+  header->SetCrossAxisAlignment(views::BoxLayout::CrossAxisAlignment::kCenter);
+  header->AddChildView(Glyph("paint-brush", std::u16string()));
+  auto* title = header->AddChildView(std::make_unique<views::Label>(
+      u"Theme", views::style::CONTEXT_LABEL, views::style::STYLE_PRIMARY));
+  title->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  header->SetFlexForView(title, 1);
+  // Keyboard and screen reader route to the preview's click-to-add.
+  add_glow_ = header->AddChildView(std::make_unique<ArciumSpaceIconButton>(
+      base::BindRepeating(
+          [](ArciumSpaceThemeEditor* editor) {
+            // Put the new glow where it is farthest from the others.
+            const auto& glows = editor->shown_background().glows;
+            double best_x = 0.5, best_y = 0.5, best_distance = -1;
+            for (double x : {0.15, 0.5, 0.85}) {
+              for (double y : {0.2, 0.5, 0.8}) {
+                double nearest = 2;
+                for (const helium::SpaceGlow& glow : glows) {
+                  nearest = std::min(nearest, std::hypot(glow.x - x,
+                                                         glow.y - y));
+                }
+                if (nearest > best_distance) {
+                  best_distance = nearest;
+                  best_x = x;
+                  best_y = y;
+                }
+              }
+            }
+            editor->AddGlow(best_x, best_y);
+          },
+          base::Unretained(this)),
+      helium::MakePhosphorIcon("plus-circle"), kSmallGlyph, kModeButtonSize));
+  add_glow_->SetTooltipText(u"Add glow");
+  add_glow_->GetViewAccessibility().SetName(u"Add glow");
+
+  preview_ = AddChildView(std::make_unique<Preview>(this));
+  auto* hint = AddChildView(std::make_unique<views::Label>(
+      u"Click to add a glow, drag to move it", views::style::CONTEXT_LABEL,
+      views::style::STYLE_SECONDARY));
+  hint->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  hint->SetFontList(hint->font_list().DeriveWithSizeDelta(-1));
+
+  auto* palette = AddChildView(std::make_unique<SwatchGrid>());
+  palette->GetViewAccessibility().SetRole(ax::mojom::Role::kRadioGroup);
+  palette->GetViewAccessibility().SetName(u"Glow color");
+  palette->SetOwnedGroup(kSwatchGroup);
+  std::vector<std::pair<std::optional<SkColor>, std::u16string>> colors = {
+      {std::nullopt, u"Reset to the profile's look"}};
+  for (const SpaceThemeSwatch& swatch : GetSpaceThemeSwatches()) {
+    colors.emplace_back(swatch.color, swatch.name);
+  }
+  for (const auto& [color, name] : colors) {
+    auto* swatch = palette->AddChildView(std::make_unique<ArciumThemeSwatchButton>(
+        base::BindRepeating(&ArciumSpaceThemeEditor::OnSwatchPressed,
+                            base::Unretained(this), color),
+        color, name));
+    swatch->SetGroup(kSwatchGroup);
+    swatches_.push_back(swatch);
+  }
+
+  // Short visible labels keep each row's meaning obvious without icons that
+  // need decoding.
+  auto row_label = [](std::u16string text) {
+    auto label = std::make_unique<views::Label>(
+        text, views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY);
+    label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    label->SetPreferredSize(
+        gfx::Size(kRowLabelWidth, label->GetPreferredSize().height()));
+    label->GetViewAccessibility().SetIsIgnored(true);
+    return label;
+  };
+  auto add_slider = [&](std::u16string label, std::u16string name) {
+    auto* row = AddChildView(std::make_unique<views::BoxLayoutView>());
+    row->SetBetweenChildSpacing(kPadding);
+    row->SetCrossAxisAlignment(views::BoxLayout::CrossAxisAlignment::kCenter);
+    row->AddChildView(row_label(label));
+    auto* slider = row->AddChildView(std::make_unique<views::Slider>(this));
+    slider->GetViewAccessibility().SetName(name);
+    row->SetFlexForView(slider, 1);
+    return slider;
+  };
+  intensity_ = add_slider(u"Glow", u"Glow intensity");
+  grain_ = add_slider(u"Grain", u"Grain");
+
+  auto add_modes = [&](bool pages) {
+    auto* row = AddChildView(std::make_unique<views::BoxLayoutView>());
+    row->SetBetweenChildSpacing(2);
+    row->SetCrossAxisAlignment(views::BoxLayout::CrossAxisAlignment::kCenter);
+    const std::u16string subject = pages ? u"Pages" : u"Browser";
+    auto* label = row->AddChildView(row_label(subject));
+    label->SetProperty(views::kMarginsKey,
+                       gfx::Insets::TLBR(0, 0, 0, kPadding - 2));
+    const std::tuple<Mode, const char*, std::u16string> modes[] = {
+        {Mode::kAuto, "circle-half",
+         pages ? u"Match the browser" : u"Match the profile"},
+        {Mode::kLight, "sun", u"Light"},
+        {Mode::kDark, "moon", u"Dark"},
+    };
+    for (const auto& [mode, icon, label] : modes) {
+      auto* button = row->AddChildView(std::make_unique<ArciumSpaceIconButton>(
+          base::BindRepeating(&ArciumSpaceThemeEditor::OnModePressed,
+                              base::Unretained(this), pages, mode),
+          helium::MakePhosphorIcon(icon), kSmallGlyph, kModeButtonSize));
+      button->SetTooltipText(subject + u": " + label);
+      button->GetViewAccessibility().SetName(subject + u" " + label);
+      (pages ? page_modes_ : browser_modes_).emplace_back(mode, button);
+    }
+  };
+  add_modes(/*pages=*/false);
+  add_modes(/*pages=*/true);
+
+  // A saved background opens with its first glow selected, so the palette
+  // shows that glow's color.
+  if (theme_.background && !theme_.background->glows.empty()) {
+    selected_glow_ = 0;
+  }
+  UpdateControls();
+}
