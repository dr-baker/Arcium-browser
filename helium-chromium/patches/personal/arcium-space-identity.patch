+std::unique_ptr<views::View> ArciumSpaceEditorView::CreateProfileRow() {
+  // The profile name gets the row's full width under its label.
+  auto section = std::make_unique<views::BoxLayoutView>();
+  section->SetOrientation(views::BoxLayout::Orientation::kVertical);
+  section->SetInsideBorderInsets(gfx::Insets(kRowPadding));
+  section->SetBetweenChildSpacing(kRowPadding);
+  section->SetCrossAxisAlignment(views::BoxLayout::CrossAxisAlignment::kStretch);
+  section->SetBackground(views::CreateRoundedRectBackground(
+      ui::kColorSysStateHoverOnSubtle, kRowRadius));
+  auto* header = section->AddChildView(std::make_unique<views::BoxLayoutView>());
+  header->SetBetweenChildSpacing(kRowPadding);
+  header->SetCrossAxisAlignment(views::BoxLayout::CrossAxisAlignment::kCenter);
+  header->AddChildView(Glyph("user-circle"));
+  auto* label = header->AddChildView(std::make_unique<views::Label>(
+      u"Profile", views::style::CONTEXT_LABEL, views::style::STYLE_PRIMARY));
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  header->SetFlexForView(label, 1);
+  constexpr char16_t kProfileHelp[] =
+      u"Each profile keeps its own sign-ins, cookies, history, and Favorites. "
+      u"A Space keeps the profile it was created in.";
+  header->AddChildView(Glyph("info", kProfileHelp));
+  views::View* row = section.get();
+  if (is_creating()) {
+    profiles_ = helium::GetSpaceProfiles();
+    std::vector<ui::SimpleComboboxModel::Item> items;
+    std::optional<size_t> current;
+    for (size_t i = 0; i < profiles_.size(); ++i) {
+      items.emplace_back(profiles_[i].second);
+      if (profiles_[i].first == browser_->GetProfile()->GetPath()) {
+        current = i;
+      }
+    }
+    items.emplace_back(u"New profile");
+    profile_combobox_ = row->AddChildView(std::make_unique<views::Combobox>(
+        std::make_unique<ui::SimpleComboboxModel>(std::move(items))));
+    profile_combobox_->SetSelectedIndex(current.value_or(0));
+    profile_combobox_->SetCallback(
+        base::BindRepeating(&ArciumSpaceEditorView::OnProfileSelected,
+                            base::Unretained(this)));
+    profile_combobox_->GetViewAccessibility().SetName(u"Profile");
+  } else {
+    auto* name = row->AddChildView(std::make_unique<views::Label>(
+        std::u16string(),
+        views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+    for (const auto& [path, profile_name] : helium::GetSpaceProfiles()) {
+      if (space_profile_ && path == space_profile_->GetPath()) {
+        name->SetText(profile_name);
+      }
+    }
+    name->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  }
+  return section;
+}
