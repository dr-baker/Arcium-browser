+void HeliumSpace::LoadPresentation(const base::DictValue& record) {
+  const std::string* icon = record.FindString(kIconKey);
+  icon_ = icon ? NormalizeSpaceIcon(*icon) : std::string();
+  theme_ = SpaceTheme::FromDict(record.FindDict(kThemeKey));
+  pins_collapsed_ = record.FindBool(kPinsCollapsedKey).value_or(false);
+}
+
+void HeliumSpace::PersistField(std::string_view key, base::Value value) {
+  ScopedListPrefUpdate update(profile_->GetPrefs(), kHeliumSpacesPref);
+  if (base::DictValue* record = FindSpaceRecord(update.Get(), id_)) {
+    record->Set(key, std::move(value));
+  }
+}
