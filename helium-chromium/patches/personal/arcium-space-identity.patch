+HeliumSpaceService::SwitchResult HeliumSpaceService::SwitchSpaceInWindow(
+    Browser* browser,
+    std::string_view id) {
+  HeliumSpace* target = GetSpaceById(id);
+  if (!IsEligibleBrowser(browser) || !target) {
+    return SwitchResult::kUnchanged;
+  }
+  const std::string from(GetSpaceIdForBrowser(browser));
+  const std::string to(id);
+  if (from == to) {
+    return SwitchResult::kUnchanged;
+  }
+  TabStripModel* model = browser->tab_strip_model();
+
+  // What leaves with the current Space: its ordinary tabs and open Pins.
+  // Favorites belong to the profile and stay.
+  std::vector<tabs::TabHandle> leaving;
+  std::vector<std::string> leaving_pins;
+  // A handle, not the tab: closing open Pins can destroy it.
+  const tabs::TabHandle active = model->GetActiveTab()
+                                     ? model->GetActiveTab()->GetHandle()
+                                     : tabs::TabHandle::Null();
+  for (int i = 0; i < model->count(); ++i) {
+    tabs::TabInterface* tab = model->GetTabAtIndex(i);
+    if (const LiveAssociation* association = FindLiveAssociation(tab)) {
+      if (association->kind == PersistentRecordKind::kPin &&
+          association->space_id == from) {
+        leaving_pins.push_back(association->key);
+      }
+      continue;
+    }
+    // A page that asks before it is left may hold unsaved changes. Leave
+    // this window and its Space alone; the target opens in its own window.
+    if (AsksBeforeLeaving(tab->GetContents())) {
+      return SwitchResult::kKeepsWindow;
+    }
+    leaving.push_back(tab->GetHandle());
+  }
+
+  FinishSpaceSwitch(browser, from, to, leaving, leaving_pins,
+                    RecordTabs(model, leaving, active));
+  return SwitchResult::kSwitched;
+}
+
+void HeliumSpaceService::FinishSpaceSwitch(
+    Browser* browser,
+    const std::string& from,
+    const std::string& to,
+    const std::vector<tabs::TabHandle>& leaving,
+    const std::vector<std::string>& leaving_pins,
+    std::unique_ptr<KeptTabs> kept) {
+  // Arrivals first, so the window always has a tab and the leaving tabs are
+  // in the background when they close.
+  if (!RestoreSpaceTabs(browser, to)) {
+    chrome::AddTabAt(browser, GURL(), -1, true);
+  }
+  SetSpaceForBrowser(browser, to);
+  SetActiveSpace(to);
+  for (const std::string& key : leaving_pins) {
+    CloseLiveInstanceForKey(key, /*close_tab=*/true);
+  }
+  // None of these pages asks before it is left, and the records bring each
+  // one back.
+  TabStripModel* model = browser->tab_strip_model();
+  for (const tabs::TabHandle& handle : leaving) {
+    if (tabs::TabInterface* tab = handle.Get()) {
+      const int index = model->GetIndexOfTab(tab);
+      if (index != TabStripModel::kNoTab) {
+        model->DetachAndDeleteWebContentsAt(index);
+      }
+    }
+  }
+  KeepTabs(from, std::move(kept));
+}
+
+std::unique_ptr<HeliumSpaceService::KeptTabs> HeliumSpaceService::RecordTabs(
+    TabStripModel* model,
+    const std::vector<tabs::TabHandle>& tabs,
+    tabs::TabHandle active) {
+  auto kept = std::make_unique<KeptTabs>();
+  std::map<tab_groups::TabGroupId, size_t> group_indices;
+  for (const tabs::TabHandle& handle : tabs) {
+    tabs::TabInterface* tab = handle.Get();
+    if (!tab || model->GetIndexOfTab(tab) == TabStripModel::kNoTab) {
+      continue;
+    }
+    content::NavigationController& controller =
+        tab->GetContents()->GetController();
+    KeptTabs::Tab kept_tab;
+    for (int i = 0; i < controller.GetEntryCount(); ++i) {
+      kept_tab.navigations.push_back(
+          sessions::ContentSerializedNavigationBuilder::FromNavigationEntry(
+              i, controller.GetEntryAtIndex(i)));
+    }
+    if (kept_tab.navigations.empty()) {
+      continue;
+    }
+    kept_tab.selected_navigation =
+        std::max(controller.GetLastCommittedEntryIndex(), 0);
+    kept_tab.pinned = tab->IsPinned();
+    if (const std::optional<tab_groups::TabGroupId> group = tab->GetGroup()) {
+      auto [entry, inserted] =
+          group_indices.try_emplace(*group, kept->groups.size());
+      if (inserted) {
+        const TabGroup* tab_group = model->group_model()->GetTabGroup(*group);
+        kept->groups.push_back(tab_group && tab_group->visual_data()
+                                   ? *tab_group->visual_data()
+                                   : tab_groups::TabGroupVisualData());
+      }
+      kept_tab.group = entry->second;
+    }
+    if (handle == active) {
+      kept->active = kept->tabs.size();
+    }
+    kept->tabs.push_back(std::move(kept_tab));
+  }
+  return kept;
+}
+
+void HeliumSpaceService::KeepTabs(const std::string& space_id,
+                                  std::unique_ptr<KeptTabs> fresh) {
+  if (!fresh || fresh->tabs.empty()) {
+    return;
+  }
+  // A Space can already have kept tabs if it was shown without them, as by a
+  // restored window; add to them rather than replace them.
+  std::unique_ptr<KeptTabs>& kept = kept_tabs_[space_id];
+  if (!kept) {
+    kept = std::move(fresh);
+  } else {
+    const size_t tab_offset = kept->tabs.size();
+    const size_t group_offset = kept->groups.size();
+    for (KeptTabs::Tab& tab : fresh->tabs) {
+      if (tab.group) {
+        *tab.group += group_offset;
+      }
+      kept->tabs.push_back(std::move(tab));
+    }
+    kept->groups.insert(kept->groups.end(), fresh->groups.begin(),
+                        fresh->groups.end());
+    if (fresh->active) {
+      kept->active = *fresh->active + tab_offset;
+    }
+  }
+  // Addresses survive a restart; history and page state do not.
+  base::ListValue addresses;
+  for (const KeptTabs::Tab& kept_tab : kept->tabs) {
+    const sessions::SerializedNavigationEntry& entry =
+        kept_tab.navigations[static_cast<size_t>(kept_tab.selected_navigation)];
+    addresses.Append(base::DictValue()
+                         .Set("url", entry.virtual_url().spec())
+                         .Set("title", entry.title()));
+  }
+  if (HeliumSpace* space = GetSpaceById(space_id)) {
+    space->PersistField(
+        "kept_tabs",
+        base::Value(base::DictValue()
+                        .Set("tabs", std::move(addresses))
+                        .Set("active", kept->active
+                                           ? static_cast<int>(*kept->active)
+                                           : -1)));
+  }
+}
+
+bool HeliumSpaceService::RestoreSpaceTabs(Browser* browser,
+                                          std::string_view id) {
+  HeliumSpace* space = GetSpaceById(id);
+  if (!IsEligibleBrowser(browser) || !space) {
+    return false;
+  }
+  std::unique_ptr<KeptTabs> kept;
+  if (auto found = kept_tabs_.find(id); found != kept_tabs_.end()) {
+    kept = std::move(found->second);
+    kept_tabs_.erase(found);
+  } else {
+    // After a restart only the saved addresses remain.
+    kept = std::make_unique<KeptTabs>();
+    for (const base::Value& value :
+         profile_->GetPrefs()->GetList(kHeliumSpacesPref)) {
+      const base::DictValue* record = value.GetIfDict();
+      const std::string* record_id = record ? record->FindString("id") : nullptr;
+      const base::DictValue* saved =
+          record_id && *record_id == id ? record->FindDict("kept_tabs")
+                                        : nullptr;
+      const base::ListValue* addresses =
+          saved ? saved->FindList("tabs") : nullptr;
+      if (!addresses) {
+        continue;
+      }
+      const int active = saved->FindInt("active").value_or(-1);
+      for (const base::Value& address_value : *addresses) {
+        const base::DictValue* address = address_value.GetIfDict();
+        const std::string* url = address ? address->FindString("url") : nullptr;
+        const std::string* title =
+            address ? address->FindString("title") : nullptr;
+        if (!url || !GURL(*url).is_valid()) {
+          continue;
+        }
+        sessions::SerializedNavigationEntry entry;
+        entry.set_index(0);
+        entry.set_virtual_url(GURL(*url));
+        entry.set_title(title ? base::UTF8ToUTF16(*title) : std::u16string());
+        entry.set_timestamp(base::Time::Now());
+        if (static_cast<int>(kept->tabs.size()) == active) {
+          kept->active = kept->tabs.size();
+        }
+        kept->tabs.push_back({.navigations = {std::move(entry)}});
+      }
+    }
+  }
+  space->PersistField("kept_tabs", base::Value());
+
+  TabStripModel* model = browser->tab_strip_model();
+  const int count_before = model->count();
+  std::vector<std::vector<int>> group_members(kept->groups.size());
+  tabs::TabHandle active_tab;
+  for (size_t i = 0; i < kept->tabs.size(); ++i) {
+    const KeptTabs::Tab& kept_tab = kept->tabs[i];
+    // Unselected tabs load when first selected.
+    chrome::AddRestoredTab(
+        browser, kept_tab.navigations, model->count(),
+        kept_tab.selected_navigation, /*extension_app_id=*/std::string(),
+        /*group=*/std::nullopt, /*select=*/false, kept_tab.pinned,
+        base::TimeTicks(), base::Time(), /*storage_namespace=*/nullptr,
+        sessions::SerializedUserAgentOverride(), /*extra_data=*/{},
+        /*from_session_restore=*/false, /*is_active_browser=*/std::nullopt);
+    const int index = model->count() - 1;
+    if (kept_tab.group) {
+      group_members[*kept_tab.group].push_back(index);
+    }
+    if (kept->active == i) {
+      active_tab = model->GetTabAtIndex(index)->GetHandle();
+    }
+  }
+  for (size_t group = 0; group < group_members.size(); ++group) {
+    if (group_members[group].empty()) {
+      continue;
+    }
+    const tab_groups::TabGroupId group_id =
+        model->AddToNewGroup(group_members[group]);
+    if (TabGroup* tab_group = model->group_model()->GetTabGroup(group_id)) {
+      tab_group->SetVisualData(kept->groups[group]);
+    }
+  }
+  if (model->count() == count_before) {
+    return false;
+  }
+  // Grouping can move tabs, so find the active one by its handle.
+  const int active_index =
+      active_tab.Get() ? model->GetIndexOfTab(active_tab.Get())
+                       : TabStripModel::kNoTab;
+  model->ActivateTabAt(active_index != TabStripModel::kNoTab ? active_index
+                                                              : count_before);
+  return true;
+}
+
+bool HeliumSpaceService::DeleteSpace(std::string_view id) {
+  if (!GetSpaceById(id) || spaces_.size() < 2u) {
+    return false;
+  }
+  const std::string deleted(id);
+  const std::string source_profile = GetSpaceById(id)->source_profile();
+  std::vector<base::WeakPtr<Browser>> windows;
+  ProfileBrowserCollection::GetForProfile(profile_)->ForEach(
+      [&](BrowserWindowInterface* window) {
+        Browser* browser = window->GetBrowserForMigrationOnly();
+        if (browser && window->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+            GetSpaceIdForBrowser(browser) == deleted) {
+          windows.push_back(browser->AsWeakPtr());
+        }
+        return true;
+      });
+
+  {
+    ScopedListPrefUpdate update(profile_->GetPrefs(), kHeliumSpacesPref);
+    update->EraseIf([&](const base::Value& value) {
+      const base::DictValue* record = value.GetIfDict();
+      const std::string* record_id = record ? record->FindString("id") : nullptr;
+      return record_id && *record_id == deleted;
+    });
+  }
+  std::erase_if(spaces_, [&](const std::unique_ptr<HeliumSpace>& space) {
+    return space->id() == deleted;
+  });
+  kept_tabs_.erase(deleted);
+  if (fresh_starter_space_id_ == deleted) {
+    fresh_starter_space_id_.clear();
+  }
+  // Imported Arc Favorites show only in Spaces from their Arc profile. The
+  // last such Space hands them to the profile's own Favorites.
+  if (!source_profile.empty() &&
+      std::ranges::none_of(spaces_, [&](const auto& space) {
+        return space->source_profile() == source_profile;
+      })) {
+    ScopedDictPrefUpdate imported(profile_->GetPrefs(),
+                                  kHeliumArcFavoritesByProfilePref);
+    if (const base::ListValue* values = imported->FindList(source_profile)) {
+      if (auto favorites = PersistentItemCodec::Decode(*values, false)) {
+        for (PersistentNode& favorite : *favorites) {
+          const std::string& favorite_id = std::visit(
+              [](const auto& item) -> const std::string& { return item.id; },
+              favorite.data);
+          if (!HasNodeId(local_favorites_, favorite_id)) {
+            local_favorites_.push_back(std::move(favorite));
+          }
+        }
+        PersistLocalFavorites();
+      }
+    }
+    imported->Remove(source_profile);
+  }
+  if (!GetSpaceById(profile_->GetPrefs()->GetString(kHeliumActiveSpaceIdPref))) {
+    SetActiveSpace(spaces_.front()->id());
+  }
+  // Until they finish closing, or if a page keeps one open, the deleted
+  // Space's windows show the active Space instead.
+  const std::string replacement_space = GetActiveSpace()->id();
+  for (auto& [window_id, space_id] : session_space_ids_) {
+    if (space_id != deleted) {
+      continue;
+    }
+    space_id = replacement_space;
+    if (SessionService* sessions =
+            SessionServiceFactory::GetForProfile(profile_)) {
+      sessions->AddWindowExtraData(window_id, kHeliumSpaceIdWindowExtraDataKey,
+                                   replacement_space);
+    }
+  }
+  // Open Pins of the deleted Space become ordinary tabs, which close with
+  // their windows below.
+  ReconcileLiveAssociationsWithDurableModel();
+  RegisterDormantItems();
+  SyncSpaceDirectory(profile_, GetSpaces());
+  NotifyItemsChanged(PersistentItemChange::Global());
+
+  // macOS applies the frame and order of the window taking this one's place
+  // asynchronously; close after that so nothing shows through.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](std::vector<base::WeakPtr<Browser>> windows) {
+                       for (const base::WeakPtr<Browser>& browser : windows) {
+                         if (browser) {
+                           browser->window()->Close();
+                         }
+                       }
+                     },
+                     std::move(windows)));
+  return true;
+}
