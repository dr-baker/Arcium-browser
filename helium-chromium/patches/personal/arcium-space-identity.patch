+Profile* ArciumSpaceEditorView::SelectedProfile() const {
+  const size_t index =
+      profile_combobox_ ? profile_combobox_->GetSelectedIndex().value_or(0) : 0;
+  return index < profiles_.size()
+             ? g_browser_process->profile_manager()->GetProfileByPath(
+                   profiles_[index].first)
+             : nullptr;
+}
+
+void ArciumSpaceEditorView::OnProfileSelected() {
+  // A new Space inherits the selected profile's background, or the defaults
+  // for a profile that does not exist yet. A profile that is not open yet is
+  // loaded to read it.
+  Profile* target = SelectedProfile();
+  const size_t index =
+      profile_combobox_ ? profile_combobox_->GetSelectedIndex().value_or(0) : 0;
+  if (!target && index < profiles_.size()) {
+    g_browser_process->profile_manager()->LoadProfileByPath(
+        profiles_[index].first, /*incognito=*/false,
+        base::BindOnce(&ArciumSpaceEditorView::OnSelectedProfileLoaded,
+                       weak_factory_.GetWeakPtr()));
+  }
+  theme_editor_->SetProfilePrefs(target ? target->GetPrefs() : nullptr);
+  UpdateThemeControls();
+}
+
+void ArciumSpaceEditorView::OnSelectedProfileLoaded(Profile* profile) {
+  if (profile && profile == SelectedProfile()) {
+    theme_editor_->SetProfilePrefs(profile->GetPrefs());
+    UpdateThemeControls();
+  }
+}
+
+helium::SpaceTheme ArciumSpaceEditorView::PreviewForSelectedProfile() const {
+  // "Profile theme" and "Match profile" mean the chosen profile's look, which
+  // can differ from this window's profile.
+  helium::SpaceTheme preview = theme_;
+  Profile* target = SelectedProfile();
+  if (!preview.background && target != browser_->GetProfile()) {
+    preview.background = theme_editor_->profile_background();
+  }
+  ThemeService* themes =
+      target && target != browser_->GetProfile()
+          ? ThemeServiceFactory::GetForProfile(target)
+          : nullptr;
+  if (!themes) {
+    return preview;
+  }
+  if (!preview.color) {
+    preview.color = themes->GetUserColor();
+  }
+  if (preview.mode == Mode::kAuto) {
+    switch (themes->GetBrowserColorScheme()) {
+      case ThemeService::BrowserColorScheme::kLight:
+        preview.mode = Mode::kLight;
+        break;
+      case ThemeService::BrowserColorScheme::kDark:
+        preview.mode = Mode::kDark;
+        break;
+      case ThemeService::BrowserColorScheme::kSystem:
+        break;
+    }
+  }
+  return preview;
+}
+
+void ArciumSpaceEditorView::UpdateSubmitButton() {
+  submit_button_->SetEnabled(
+      !base::TrimWhitespace(name_field_->GetText(), base::TRIM_ALL).empty());
+}
+
+void ArciumSpaceEditorView::ContentsChanged(
+    views::Textfield* sender,
+    const std::u16string& new_contents) {
+  UpdateSubmitButton();
+}
+
+bool ArciumSpaceEditorView::HandleKeyEvent(views::Textfield* sender,
+                                           const ui::KeyEvent& key_event) {
+  if (key_event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  if (key_event.key_code() == ui::VKEY_RETURN) {
+    if (submit_button_->GetEnabled()) {
+      Submit();
+    }
+    return true;
+  }
+  if (key_event.key_code() == ui::VKEY_ESCAPE) {
+    Cancel();
+    return true;
+  }
+  return false;
+}
+
+void ArciumSpaceEditorView::Submit() {
+  std::u16string name(
+      base::TrimWhitespace(name_field_->GetText(), base::TRIM_ALL));
+  if (name.empty()) {
+    return;
+  }
+  if (is_creating()) {
+    const std::optional<helium::SpaceWindowPlacement> placement =
+        helium::GetSpaceWindowPlacement(browser_);
+    const size_t index = profile_combobox_->GetSelectedIndex().value_or(0);
+    ProfileManager* profile_manager = g_browser_process->profile_manager();
+    if (index >= profiles_.size()) {
+      ProfileManager::CreateMultiProfileAsync(
+          name, profiles::GetPlaceholderAvatarIndex(), /*is_hidden=*/false,
+          base::BindOnce(&CreateSpaceInNewProfile,
+                         browser_->GetProfile()->GetPrefs()->GetInteger(
+                             prefs::kHeliumLayout),
+                         name, icon_, theme_, placement));
+    } else if (Profile* profile =
+                   profile_manager->GetProfileByPath(profiles_[index].first)) {
+      CreateSpaceInProfile(name, icon_, theme_, placement, profile);
+    } else {
+      profile_manager->LoadProfileByPath(
+          profiles_[index].first, /*incognito=*/false,
+          base::BindOnce(&CreateSpaceInProfile, name, icon_, theme_,
+                         placement));
+    }
+  } else if (auto* service = helium::HeliumSpaceServiceFactory::GetForProfile(
+                 space_profile_)) {
+    service->SetSpaceName(space_id_, name);
+    service->SetSpaceIcon(space_id_, icon_);
+    service->SetSpaceTheme(space_id_, theme_);
+  }
+  preview_theme_.Run(std::nullopt);
+  close_.Run();
+}
+
+std::unique_ptr<views::View> ArciumSpaceEditorView::CreateDeleteConfirmation(
+    const std::u16string& name) {
+  auto card = std::make_unique<views::BoxLayoutView>();
+  card->SetOrientation(views::BoxLayout::Orientation::kVertical);
+  card->SetCrossAxisAlignment(views::BoxLayout::CrossAxisAlignment::kStretch);
+  card->SetInsideBorderInsets(gfx::Insets(kRowPadding + 4));
+  card->SetBetweenChildSpacing(kRowSpacing);
+  card->SetBackground(views::CreateRoundedRectBackground(
+      ui::kColorSysStateHoverOnSubtle, kRowRadius));
+  card->SetProperty(views::kMarginsKey,
+                    gfx::Insets::TLBR(kRowPadding, 0, 0, 0));
+  card->GetViewAccessibility().SetRole(ax::mojom::Role::kAlertDialog);
+  card->GetViewAccessibility().SetName(u"Delete " + name);
+  card->SetVisible(false);
+
+  auto* title = card->AddChildView(std::make_unique<views::Label>(
+      u"Delete \u201c" + name + u"\u201d?", views::style::CONTEXT_LABEL,
+      views::style::STYLE_EMPHASIZED));
+  title->SetMultiLine(true);
+  title->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  delete_message_ = card->AddChildView(std::make_unique<views::Label>(
+      std::u16string(), views::style::CONTEXT_LABEL,
+      views::style::STYLE_SECONDARY));
+  delete_message_->SetMultiLine(true);
+  delete_message_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+
+  auto* confirm = card->AddChildView(std::make_unique<CardButton>(
+      base::BindRepeating(&ArciumSpaceEditorView::ConfirmDelete,
+                          base::Unretained(this)),
+      u"Delete Space"));
+  confirm->SetStyle(ui::ButtonStyle::kProminent);
+  confirm->SetBgColorIdOverride(ui::kColorSysError);
+  confirm->SetEnabledTextColors(ui::kColorSysOnError);
+  confirm->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  keep_button_ = card->AddChildView(std::make_unique<CardButton>(
+      base::BindRepeating(&ArciumSpaceEditorView::HideDeleteConfirmation,
+                          base::Unretained(this)),
+      u"Keep Space"));
+  keep_button_->SetStyle(ui::ButtonStyle::kText);
+  keep_button_->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  // macOS buttons take focus only with Full Keyboard Access; the card needs
+  // focus so Return, Tab, and Escape work as soon as it shows.
+  confirm->SetFocusBehavior(FocusBehavior::ALWAYS);
+  keep_button_->SetFocusBehavior(FocusBehavior::ALWAYS);
+  delete_confirmation_ = card.get();
+  return card;
+}
+
+void ArciumSpaceEditorView::ShowDeleteConfirmation() {
+  if (!delete_confirmation_ || !helium::CanDeleteSpace()) {
+    return;
+  }
+  // Say exactly what goes: deleting a profile's only Space deletes the
+  // profile and its data too.
+  std::u16string profile_name;
+  if (ProfileAttributesEntry* entry =
+          g_browser_process->profile_manager()
+              ->GetProfileAttributesStorage()
+              .GetProfileAttributesWithPath(space_profile_->GetPath())) {
+    profile_name = entry->GetLocalProfileName();
+  }
+  delete_includes_profile_ = helium::IsOnlySpaceInProfile(space_profile_);
+  delete_message_->SetText(
+      delete_includes_profile_
+          ? u"It is the only Space in the profile \u201c" + profile_name +
+                u"\u201d, so that profile is deleted too, with its "
+                u"Favorites, history, cookies, and saved passwords. Its "
+                u"windows close."
+          : u"Its Pins and open tabs close. Favorites stay with the "
+            u"profile \u201c" +
+                profile_name + u"\u201d.");
+  // The card replaces the form so it and the Space bar stay in view.
+  for (views::View* child : children()) {
+    child->SetVisible(child == delete_confirmation_);
+  }
+  keep_button_->RequestFocus();
+}
+
+void ArciumSpaceEditorView::HideDeleteConfirmation() {
+  for (views::View* child : children()) {
+    child->SetVisible(child != delete_confirmation_);
+  }
+  FocusName();
+}
+
+void ArciumSpaceEditorView::ConfirmDelete() {
+  // Another window may have changed what this deletion takes, such as by
+  // deleting the profile's other Space. Show the new scope and ask again.
+  if (helium::IsOnlySpaceInProfile(space_profile_) !=
+      delete_includes_profile_) {
+    ShowDeleteConfirmation();
+    return;
+  }
+  // The form goes first; the window may close with its Space.
+  Profile* profile = space_profile_;
+  const std::string space_id = space_id_;
+  BrowserWindowInterface* from = browser_;
+  preview_theme_.Run(std::nullopt);
+  close_.Run();
+  helium::DeleteSpace(profile, space_id, from, delete_includes_profile_);
+}
+
+void ArciumSpaceEditorView::Cancel() {
+  preview_theme_.Run(std::nullopt);
+  close_.Run();
+}
+
+BEGIN_METADATA(ArciumSpaceEditorView)
+END_METADATA
