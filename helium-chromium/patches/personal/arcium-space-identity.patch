@@ -0,0 +1,453 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arcium_space_directory.h"
+
+#include <algorithm>
+#include <iterator>
+#include <map>
+#include <memory>
+#include <set>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/json/json_reader.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/lifetime/browser_shutdown.h"
+#include "chrome/browser/profiles/delete_profile_helper.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_attributes_entry.h"
+#include "chrome/browser/profiles/profile_attributes_storage.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/profiles/profile_metrics.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_window.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/helium/helium_space_service.h"
+#include "chrome/browser/ui/helium/helium_space_service_factory.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "chrome/common/chrome_constants.h"
+#include "components/keep_alive_registry/keep_alive_types.h"
+#include "components/keep_alive_registry/scoped_keep_alive.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+
+namespace helium {
+namespace {
+
+constexpr char kProfileKey[] = "profile";
+constexpr char kIdKey[] = "id";
+constexpr char kNameKey[] = "name";
+constexpr char kIconKey[] = "icon";
+
+bool CanOpenWindows(const ProfileAttributesEntry* entry) {
+  return entry && !entry->IsOmitted() && !entry->IsSigninRequired();
+}
+
+std::string DirectoryKey(const base::FilePath& profile_path) {
+  return profile_path.BaseName().AsUTF8Unsafe();
+}
+
+// Profiles that predate the directory list their Spaces only in their own
+// preference files. Reads them without loading the profiles.
+using DiskSpaces = std::map<base::FilePath, base::ListValue>;
+DiskSpaces ReadSpacesFromDisk(std::vector<base::FilePath> profile_paths) {
+  DiskSpaces result;
+  for (const base::FilePath& path : profile_paths) {
+    std::string contents;
+    if (!base::ReadFileToString(path.Append(chrome::kPreferencesFilename),
+                                &contents)) {
+      continue;
+    }
+    std::optional<base::DictValue> prefs = base::JSONReader::ReadDict(
+        contents, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+    const base::ListValue* spaces =
+        prefs ? prefs->FindListByDottedPath(kHeliumSpacesPref) : nullptr;
+    if (!spaces) {
+      continue;
+    }
+    base::ListValue entries;
+    for (const base::Value& value : *spaces) {
+      const base::DictValue* space = value.GetIfDict();
+      const std::string* id = space ? space->FindString(kIdKey) : nullptr;
+      if (!id || id->empty()) {
+        continue;
+      }
+      const std::string* name = space->FindString(kNameKey);
+      const std::string* icon = space->FindString(kIconKey);
+      base::DictValue entry;
+      entry.Set(kProfileKey, DirectoryKey(path));
+      entry.Set(kIdKey, *id);
+      entry.Set(kNameKey, name ? *name : std::string("Space"));
+      entry.Set(kIconKey, icon ? *icon : std::string());
+      entries.Append(std::move(entry));
+    }
+    result.emplace(path, std::move(entries));
+  }
+  return result;
+}
+
+bool HasDirectoryEntries(const base::ListValue& directory,
+                         const std::string& key) {
+  return std::ranges::any_of(directory, [&](const base::Value& value) {
+    const base::DictValue* record = value.GetIfDict();
+    const std::string* owner = record ? record->FindString(kProfileKey) : nullptr;
+    return owner && *owner == key;
+  });
+}
+
+void AddSpacesFromDisk(DiskSpaces spaces) {
+  ProfileManager* profile_manager =
+      g_browser_process ? g_browser_process->profile_manager() : nullptr;
+  PrefService* local_state =
+      g_browser_process ? g_browser_process->local_state() : nullptr;
+  if (!profile_manager || !local_state) {
+    return;
+  }
+  base::ListValue directory =
+      local_state->GetList(kArciumSpaceDirectoryPref).Clone();
+  bool changed = false;
+  for (auto& [path, entries] : spaces) {
+    // A profile that loaded meanwhile has already listed its own Spaces, and
+    // a deleted one must not return.
+    if (profile_manager->GetProfileByPath(path) ||
+        !CanOpenWindows(profile_manager->GetProfileAttributesStorage()
+                            .GetProfileAttributesWithPath(path)) ||
+        HasDirectoryEntries(directory, DirectoryKey(path))) {
+      continue;
+    }
+    for (base::Value& entry : entries) {
+      directory.Append(std::move(entry));
+      changed = true;
+    }
+  }
+  if (changed) {
+    local_state->SetList(kArciumSpaceDirectoryPref, std::move(directory));
+  }
+}
+
+base::DictValue EntryRecord(const std::string& profile,
+                            const HeliumSpace& space) {
+  base::DictValue record;
+  record.Set(kProfileKey, profile);
+  record.Set(kIdKey, space.id());
+  record.Set(kNameKey, base::UTF16ToUTF8(space.name()));
+  record.Set(kIconKey, space.icon());
+  return record;
+}
+
+void ActivateSpace(std::string space_id,
+                   std::optional<SpaceWindowPlacement> placement,
+                   Profile* profile) {
+  if (!profile || !g_browser_process || g_browser_process->IsShuttingDown() ||
+      browser_shutdown::IsTryingToQuit() ||
+      Browser::GetCreationStatusForProfile(profile) !=
+          Browser::CreationStatus::kOk) {
+    return;
+  }
+  auto* service = HeliumSpaceServiceFactory::GetForProfile(profile);
+  if (HeliumSpace* space = service ? service->GetSpaceById(space_id) : nullptr) {
+    space->ActivateOrCreatePrimaryWindow(placement);
+  }
+}
+
+}  // namespace
+
+void RegisterSpaceDirectoryLocalStatePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterListPref(kArciumSpaceDirectoryPref);
+}
+
+std::vector<SpaceDirectoryEntry> GetSpaceDirectory() {
+  std::vector<SpaceDirectoryEntry> result;
+  ProfileManager* profile_manager =
+      g_browser_process ? g_browser_process->profile_manager() : nullptr;
+  PrefService* local_state =
+      g_browser_process ? g_browser_process->local_state() : nullptr;
+  if (!profile_manager || !local_state) {
+    return result;
+  }
+  ProfileAttributesStorage& storage =
+      profile_manager->GetProfileAttributesStorage();
+  std::set<std::pair<base::FilePath, std::string>> seen;
+  for (const base::Value& value :
+       local_state->GetList(kArciumSpaceDirectoryPref)) {
+    const base::DictValue* record = value.GetIfDict();
+    const std::string* profile =
+        record ? record->FindString(kProfileKey) : nullptr;
+    const std::string* id = record ? record->FindString(kIdKey) : nullptr;
+    if (!profile || profile->empty() || !id || id->empty()) {
+      continue;
+    }
+    const base::FilePath profile_basename =
+        base::FilePath::FromUTF8Unsafe(*profile);
+    if (profile_basename.empty() ||
+        profile_basename.BaseName() != profile_basename ||
+        profile_basename.ReferencesParent()) {
+      continue;
+    }
+    const base::FilePath path =
+        profile_manager->user_data_dir().Append(profile_basename);
+    ProfileAttributesEntry* entry =
+        storage.GetProfileAttributesWithPath(path);
+    if (!CanOpenWindows(entry) || !seen.emplace(path, *id).second) {
+      continue;
+    }
+    const std::string* name = record->FindString(kNameKey);
+    const std::string* icon = record->FindString(kIconKey);
+    result.push_back({
+        .profile_path = path,
+        .profile_name = entry->GetLocalProfileName(),
+        .space_id = *id,
+        .name = name ? base::UTF8ToUTF16(*name) : u"Space",
+        .icon = icon ? *icon : std::string(),
+    });
+  }
+  return result;
+}
+
+std::vector<std::pair<base::FilePath, std::u16string>> GetSpaceProfiles() {
+  std::vector<std::pair<base::FilePath, std::u16string>> result;
+  ProfileManager* profile_manager =
+      g_browser_process ? g_browser_process->profile_manager() : nullptr;
+  if (!profile_manager) {
+    return result;
+  }
+  for (ProfileAttributesEntry* entry :
+       profile_manager->GetProfileAttributesStorage()
+           .GetAllProfilesAttributesSortedByLocalProfileNameWithCheck()) {
+    if (CanOpenWindows(entry)) {
+      result.emplace_back(entry->GetPath(), entry->GetLocalProfileName());
+    }
+  }
+  return result;
+}
+
+void SyncSpaceDirectory(Profile* profile,
+                        const std::vector<HeliumSpace*>& spaces) {
+  PrefService* local_state =
+      g_browser_process ? g_browser_process->local_state() : nullptr;
+  if (!profile || !profile->IsRegularProfile() || !local_state) {
+    return;
+  }
+  const std::string key = DirectoryKey(profile->GetPath());
+  ProfileManager* profile_manager = g_browser_process->profile_manager();
+  if (!profile_manager) {
+    return;
+  }
+  ProfileAttributesStorage& storage =
+      profile_manager->GetProfileAttributesStorage();
+  const base::ListValue& current = local_state->GetList(kArciumSpaceDirectoryPref);
+  base::ListValue updated;
+  std::set<std::string> placed;
+  for (const base::Value& value : current) {
+    const base::DictValue* record = value.GetIfDict();
+    const std::string* owner = record ? record->FindString(kProfileKey) : nullptr;
+    if (!owner) {
+      continue;
+    }
+    if (*owner != key) {
+      // Drop the Spaces of deleted profiles.
+      if (storage.GetProfileAttributesWithPath(
+              profile_manager->user_data_dir().Append(
+                  base::FilePath::FromUTF8Unsafe(*owner)))) {
+        updated.Append(value.Clone());
+      }
+      continue;
+    }
+    const std::string* id = record->FindString(kIdKey);
+    for (HeliumSpace* space : spaces) {
+      if (id && space->id() == *id && placed.insert(space->id()).second) {
+        updated.Append(EntryRecord(key, *space));
+        break;
+      }
+    }
+  }
+  for (HeliumSpace* space : spaces) {
+    if (placed.insert(space->id()).second) {
+      updated.Append(EntryRecord(key, *space));
+    }
+  }
+  if (updated != current) {
+    local_state->SetList(kArciumSpaceDirectoryPref, std::move(updated));
+  }
+}
+
+void SeedSpaceDirectoryFromDisk() {
+  static bool seeded = false;
+  ProfileManager* profile_manager =
+      g_browser_process ? g_browser_process->profile_manager() : nullptr;
+  PrefService* local_state =
+      g_browser_process ? g_browser_process->local_state() : nullptr;
+  if (seeded || !profile_manager || !local_state) {
+    return;
+  }
+  seeded = true;
+  const base::ListValue& directory =
+      local_state->GetList(kArciumSpaceDirectoryPref);
+  std::vector<base::FilePath> missing;
+  for (ProfileAttributesEntry* entry :
+       profile_manager->GetProfileAttributesStorage()
+           .GetAllProfilesAttributes()) {
+    if (CanOpenWindows(entry) &&
+        !profile_manager->GetProfileByPath(entry->GetPath()) &&
+        !HasDirectoryEntries(directory, DirectoryKey(entry->GetPath()))) {
+      missing.push_back(entry->GetPath());
+    }
+  }
+  if (missing.empty()) {
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(&ReadSpacesFromDisk, std::move(missing)),
+      base::BindOnce(&AddSpacesFromDisk));
+}
+
+std::optional<SpaceWindowPlacement> GetSpaceWindowPlacement(
+    BrowserWindowInterface* from) {
+  Browser* browser = from ? from->GetBrowserForMigrationOnly() : nullptr;
+  BrowserWindow* window = browser ? browser->window() : nullptr;
+  if (!window) {
+    return std::nullopt;
+  }
+  SpaceWindowPlacement placement;
+  if (!window->IsFullscreen() && !window->IsMinimized()) {
+    placement.bounds = window->IsMaximized() ? window->GetRestoredBounds()
+                                             : window->GetBounds();
+    placement.maximized = window->IsMaximized();
+  }
+  if (const auto* sidebar = tabs::VerticalTabStripStateController::From(from);
+      sidebar && sidebar->ShouldDisplayVerticalTabs()) {
+    placement.sidebar_width = sidebar->GetUncollapsedWidth();
+    placement.sidebar_collapsed = sidebar->IsCollapsed();
+  }
+  return placement;
+}
+
+void OpenSpaceFromDirectory(const base::FilePath& profile_path,
+                            std::string space_id,
+                            std::optional<SpaceWindowPlacement> placement) {
+  ProfileManager* profile_manager =
+      g_browser_process ? g_browser_process->profile_manager() : nullptr;
+  if (!profile_manager ||
+      !CanOpenWindows(profile_manager->GetProfileAttributesStorage()
+                          .GetProfileAttributesWithPath(profile_path))) {
+    return;
+  }
+  if (Profile* profile = profile_manager->GetProfileByPath(profile_path)) {
+    ActivateSpace(std::move(space_id), placement, profile);
+    return;
+  }
+  profile_manager->LoadProfileByPath(
+      profile_path, /*incognito=*/false,
+      base::BindOnce(&ActivateSpace, std::move(space_id), placement));
+}
+
+bool SwitchToSpace(BrowserWindowInterface* from,
+                   const base::FilePath& profile_path,
+                   const std::string& space_id) {
+  Browser* browser = from ? from->GetBrowserForMigrationOnly() : nullptr;
+  if (browser && from->GetProfile()->GetPath() == profile_path) {
+    auto* service = HeliumSpaceServiceFactory::GetForProfile(from->GetProfile());
+    HeliumSpace* space = service ? service->GetSpaceById(space_id) : nullptr;
+    if (space && !space->GetPrimaryBrowser()) {
+      const HeliumSpaceService::SwitchResult result =
+          service->SwitchSpaceInWindow(browser, space_id);
+      if (result == HeliumSpaceService::SwitchResult::kSwitched) {
+        return true;
+      }
+      // Otherwise the target opens in its own window below.
+    }
+  }
+  OpenSpaceFromDirectory(profile_path, space_id, GetSpaceWindowPlacement(from));
+  return false;
+}
+
+bool CanDeleteSpace() {
+  return GetSpaceDirectory().size() > 1u;
+}
+
+bool IsOnlySpaceInProfile(Profile* profile) {
+  auto* service =
+      profile ? HeliumSpaceServiceFactory::GetForProfile(profile) : nullptr;
+  return service && service->GetSpaces().size() == 1u;
+}
+
+bool DeleteSpace(Profile* profile,
+                 const std::string& space_id,
+                 BrowserWindowInterface* from,
+                 bool delete_profile) {
+  auto* service =
+      profile ? HeliumSpaceServiceFactory::GetForProfile(profile) : nullptr;
+  if (!service || !service->GetSpaceById(space_id) || !CanDeleteSpace() ||
+      IsOnlySpaceInProfile(profile) != delete_profile) {
+    return false;
+  }
+
+  Browser* from_browser = from ? from->GetBrowserForMigrationOnly() : nullptr;
+  if (from_browser && from->GetProfile() == profile &&
+      service->GetSpaceIdForBrowser(from_browser) == space_id) {
+    // Move this window's place to the next Space in the bar, or the previous
+    // one at the end, before its own Space goes away.
+    const std::vector<SpaceDirectoryEntry> entries = GetSpaceDirectory();
+    const auto deleted = std::ranges::find_if(
+        entries, [&](const SpaceDirectoryEntry& entry) {
+          return entry.profile_path == profile->GetPath() &&
+                 entry.space_id == space_id;
+        });
+    if (deleted != entries.end()) {
+      const auto neighbour =
+          std::next(deleted) != entries.end() ? std::next(deleted)
+                                              : std::prev(deleted);
+      ProfileManager* profile_manager = g_browser_process->profile_manager();
+      if (profile_manager->GetProfileByPath(neighbour->profile_path)) {
+        // A neighbour in the same profile takes over this very window.
+        SwitchToSpace(from, neighbour->profile_path, neighbour->space_id);
+      } else {
+        // Closing the deleted Space's last window must not end the app
+        // before the neighbour's profile has loaded.
+        profile_manager->LoadProfileByPath(
+            neighbour->profile_path, /*incognito=*/false,
+            base::BindOnce(
+                [](std::unique_ptr<ScopedKeepAlive> keep_alive,
+                   std::string space_id,
+                   std::optional<SpaceWindowPlacement> placement,
+                   Profile* profile) {
+                  ActivateSpace(std::move(space_id), placement, profile);
+                },
+                std::make_unique<ScopedKeepAlive>(
+                    KeepAliveOrigin::PROFILE_MANAGER,
+                    KeepAliveRestartOption::DISABLED),
+                neighbour->space_id, GetSpaceWindowPlacement(from)));
+      }
+    }
+  }
+
+  if (!delete_profile) {
+    return service->DeleteSpace(space_id);
+  }
+  // Deleting the profile closes its windows; let the neighbour window's new
+  // frame land first, as Space deletion does.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::FilePath path) {
+                       if (g_browser_process &&
+                           g_browser_process->profile_manager()) {
+                         g_browser_process->profile_manager()
+                             ->GetDeleteProfileHelper()
+                             .MaybeScheduleProfileForDeletion(
+                                 path, base::DoNothing(),
+                                 ProfileMetrics::DELETE_PROFILE_USER_MANAGER);
+                       }
+                     },
+                     profile->GetPath()));
+  return true;
+}
+
+}  // namespace helium
