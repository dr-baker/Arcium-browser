 #ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_SPACE_H_
 #define CHROME_BROWSER_UI_HELIUM_HELIUM_SPACE_H_
 
+#include <optional>
 #include <string>
 #include <string_view>
 #include <utility>
+#include <vector>
 
 #include "base/memory/raw_ptr.h"
+#include "base/values.h"
 #include "chrome/browser/ui/helium/helium_persistent_item_model.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/geometry/rect.h"
 
 class BrowserWindowInterface;
 class Profile;
 
 namespace helium {
 
+// One colored glow in the window background, in the same terms as the
+// chrome appearance setting: position and radius are fractions of the window.
+struct SpaceGlow {
+  SkColor color = SK_ColorWHITE;
+  double x = 0.5;
+  double y = 0.5;
+  double radius = 0.8;
+  double opacity = 0.5;
+
+  friend bool operator==(const SpaceGlow&, const SpaceGlow&) = default;
+};
+
+// The window background effect a Space shows instead of its profile's: glows,
+// their strength, and grain. The material stays the profile's.
+struct SpaceBackground {
+  static constexpr size_t kMaxGlows = 4;
+
+  std::vector<SpaceGlow> glows;
+  double tint_strength = 0.4;
+  double grain = 0.06;
+
+  friend bool operator==(const SpaceBackground&,
+                         const SpaceBackground&) = default;
+};
+
+// A Space's own look. Anything left unset follows the profile.
+struct SpaceTheme {
+  enum class Mode { kAuto, kLight, kDark };
+
+  static SpaceTheme FromDict(const base::DictValue* dict);
+  base::DictValue ToDict() const;
+  bool IsDefault() const {
+    return !color && mode == Mode::kAuto && web_mode == Mode::kAuto &&
+           !background;
+  }
+
+  friend bool operator==(const SpaceTheme&, const SpaceTheme&) = default;
+
+  // Seed for the browser chrome's colors.
+  std::optional<SkColor> color;
+  // Light or dark browser chrome.
+  Mode mode = Mode::kAuto;
+  // Light or dark web pages; kAuto follows the chrome.
+  Mode web_mode = Mode::kAuto;
+  std::optional<SpaceBackground> background;
+};
+
+// What a Space window takes from the window the user came from: a new window
+// opens slightly offset from its frame, and any Space window takes its
+// sidebar width and collapsed state.
+struct SpaceWindowPlacement {
