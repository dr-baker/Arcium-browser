+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARCIUM_SPACE_ICON_H_
+#define CHROME_BROWSER_UI_HELIUM_ARCIUM_SPACE_ICON_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/models/image_model.h"
+#include "ui/color/color_variant.h"
+
+namespace gfx {
+class Canvas;
+class Rect;
+}  // namespace gfx
+
+namespace helium {
+
+// A Space icon is stored as one string: "ph:<name>" names a Phosphor glyph,
+// any other non-empty value is a short emoji or text, and an empty value draws
+// a neutral dot.
+inline constexpr char kPhosphorIconPrefix[] = "ph:";
+
+struct PhosphorGlyph {
+  const char* name;
+  // Space-separated lowercase words: the name, Phosphor tags, and categories.
+  const char* keywords;
+  // SVG path data in a 256-unit square.
+  const char* path;
+};
+
+base::span<const PhosphorGlyph> GetPhosphorGlyphs();
+const PhosphorGlyph* FindPhosphorGlyph(std::string_view name);
+
+// Returns the glyph name for "ph:<name>", or an empty view for other icons.
+std::string_view GetPhosphorIconName(std::string_view icon);
+std::string MakePhosphorIcon(std::string_view name);
+
+// Trims whitespace, keeps known glyphs, and limits text icons to a few
+// characters. Unknown glyph names become the empty icon.
+std::string NormalizeSpaceIcon(std::string_view icon);
+
+// Matches every word of `query` against glyph keywords. An empty query
+// returns the suggested Space glyphs first, then the rest alphabetically.
+std::vector<const PhosphorGlyph*> SearchPhosphorGlyphs(std::u16string_view query);
+
+// Paints `icon` centered in `bounds`. Glyphs and the dot use `color`.
+void PaintSpaceIcon(gfx::Canvas* canvas,
+                    std::string_view icon,
+                    const gfx::Rect& bounds,
+                    SkColor color);
+void PaintPhosphorGlyph(gfx::Canvas* canvas,
+                        const PhosphorGlyph& glyph,
+                        const gfx::Rect& bounds,
+                        SkColor color);
+
+ui::ImageModel GetSpaceIconImage(std::string_view icon,
+                                 ui::ColorVariant color,
+                                 int size);
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARCIUM_SPACE_ICON_H_
