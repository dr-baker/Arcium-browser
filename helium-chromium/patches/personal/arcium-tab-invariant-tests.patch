+// Exercise the actual service and collection moves. Expected membership is
+// recorded from the requested action, not inferred from the resulting model.
+TEST_F(HeliumSpaceServiceTest, ActionSequencesPreserveTabOwnership) {
+  enum class Membership { kOrdinary, kPin, kFavorite };
+  struct Item {
+    tabs::TabInterface* tab;
+    content::WebContents* contents;
+    GURL url;
+    Membership membership = Membership::kOrdinary;
+  };
+  std::vector<Item> items;
+  for (const char* url : {"https://one.test/", "https://two.test/",
+                          "https://three.test/", "https://four.test/"}) {
+    auto* tab = AddOrdinaryTab(url);
+    ASSERT_TRUE(tab);
+    items.push_back({tab, tab->GetContents(), GURL(url)});
+  }
+  auto* model = browser()->tab_strip_model();
+  auto* strip = static_cast<tabs::TabStripCollection*>(
+      const_cast<tabs::TabCollection*>(model->Root()));
+  for (uint32_t seed : {1u, 42u, 20260927u, 0xC0FFEEu}) {
+    std::mt19937 random(seed);
+    for (int step = 0; step < 64; ++step) {
+      auto& item = items[random() % items.size()];
+      const unsigned action = random() % 4;
+      SCOPED_TRACE(testing::Message() << "seed=" << seed
+                                    << " step=" << step
+                                    << " action=" << action);
+      auto* selected = model->GetActiveTab();
+      if (action == 0) {
+        model->ActivateTabAt(model->GetIndexOfTab(item.tab));
+        selected = item.tab;
+      } else if (item.membership != Membership::kOrdinary) {
+        ASSERT_TRUE(service_->RemovePersistentItem(item.tab));
+        item.membership = Membership::kOrdinary;
+      } else if (action == 1) {
+        ASSERT_TRUE(service_->ConvertTabToPinInSpace(
+            browser(), space_->id(), item.tab, {}, {}));
+        item.membership = Membership::kPin;
+      } else {
+        ASSERT_TRUE(service_->AddFavoriteFromTab(item.tab));
+        item.membership = Membership::kFavorite;
+      }
+      base::RunLoop().RunUntilIdle();
+      ASSERT_EQ(items.size(), static_cast<size_t>(model->count()));
+      EXPECT_EQ(selected, model->GetActiveTab());
+      std::set<tabs::TabInterface*> unique_tabs;
+      std::set<std::string> unique_records;
+      for (const auto& expected : items) {
+        const int index = model->GetIndexOfTab(expected.tab);
+        ASSERT_NE(TabStripModel::kNoTab, index);
+        EXPECT_TRUE(unique_tabs.insert(model->GetTabAtIndex(index)).second);
+        EXPECT_EQ(expected.contents, model->GetWebContentsAt(index));
+        EXPECT_EQ(expected.url, expected.contents->GetLastCommittedURL());
+        const auto kind = service_->GetPersistentItemKind(expected.tab);
+        const auto id = service_->GetPersistentItemId(expected.tab);
+        EXPECT_EQ(expected.membership == Membership::kPin,
+                  strip->IsPinTab(expected.tab));
+        EXPECT_EQ(expected.membership == Membership::kFavorite,
+                  model->IsTabPinned(index));
+        if (expected.membership == Membership::kOrdinary) {
+          EXPECT_FALSE(kind);
+          EXPECT_FALSE(id);
+          EXPECT_EQ(strip->unpinned_collection(),
+                    expected.tab->GetParentCollection());
+        } else {
+          ASSERT_TRUE(kind);
+          ASSERT_TRUE(id);
+          EXPECT_EQ(expected.membership == Membership::kPin
+                        ? PersistentRecordKind::kPin
+                        : PersistentRecordKind::kFavorite, *kind);
+          EXPECT_TRUE(unique_records.insert(std::string(*id)).second);
+          EXPECT_EQ(expected.tab, service_->GetLiveTabForPersistentItem(
+                                      browser(), *kind, *id));
+        }
+      }
+    }
+  }
+}
