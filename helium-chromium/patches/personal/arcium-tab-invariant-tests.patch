+  // Check actual rendered rows, including retiring native views. Checking only
+  // collection nodes would miss a stale Favorite still parented in the UI.
+  testing::AssertionResult SidebarMatchesModel() {
+    std::map<std::string, int> persistent_rows;
+    int native_rows = 0;
+    auto visit = [&](auto&& self, views::View* view) -> void {
+      if (!view->GetVisible()) {
+        return;
+      }
+      if (auto* persistent = views::AsViewClass<PersistentTabView>(view)) {
+        ++persistent_rows[persistent->stable_id()];
+      } else if (views::IsViewClass<TabView>(view)) {
+        ++native_rows;
+      }
+      for (views::View* child : view->children()) {
+        self(self, child);
+      }
+    };
+    visit(visit, root_node()->view());
+    auto* service = helium::HeliumSpaceServiceFactory::GetForProfile(
+        browser()->profile());
+    int expected_native = 0;
+    std::map<std::string, int> expected_persistent;
+    for (int i = 0; i < tab_strip_model()->count(); ++i) {
+      auto* tab = tab_strip_model()->GetTabAtIndex(i);
+      if (const auto id = service->GetPersistentItemId(tab)) {
+        ++expected_persistent[std::string(*id)];
+      } else {
+        ++expected_native;
+        auto* node = unpinned_collection_node()->GetNodeForHandle(tab->GetHandle());
+        if (!node || !node->view()->GetVisible() ||
+            node->view()->bounds().IsEmpty()) {
+          return testing::AssertionFailure() << "ordinary tab " << i
+                                             << " has no visible row";
+        }
+      }
+    }
+    if (native_rows != expected_native || persistent_rows != expected_persistent) {
+      return testing::AssertionFailure()
+             << "native rows=" << native_rows << " expected=" << expected_native
+             << "; persistent rows=" << testing::PrintToString(persistent_rows)
+             << " expected=" << testing::PrintToString(expected_persistent);
+    }
+    return testing::AssertionSuccess();
+  }
+
+  void WaitForSidebarAgreement() {
+    EXPECT_TRUE(base::test::RunUntil([&] { return SidebarMatchesModel(); }));
+    EXPECT_TRUE(SidebarMatchesModel());
+  }
+
 };
 
