+// These sequences deliberately interleave active and background operations.
+// The page owns a sentinel, so retaining a URL but replacing the WebContents
+// or reloading the document cannot accidentally pass.
+IN_PROC_BROWSER_TEST_F(HeliumPersistentTabViewTest,
+                       ActionSequencesPreserveVisibleTabsAndPageState) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL url = embedded_test_server()->GetURL("/title1.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), url));
+  ui_test_utils::NavigateToURLWithDisposition(
+      browser(), url, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP);
+  ui_test_utils::NavigateToURLWithDisposition(
+      browser(), url, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP);
+  std::vector<tabs::TabInterface*> tabs;
+  std::vector<content::WebContents*> contents;
+  for (int i = 0; i < tab_strip_model()->count(); ++i) {
+    auto* tab = tab_strip_model()->GetTabAtIndex(i);
+    tabs.push_back(tab);
+    contents.push_back(tab->GetContents());
+    ASSERT_TRUE(content::ExecJs(tab->GetContents(),
+        "document.body.innerHTML = '<input id=unsaved>';"
+        "document.getElementById('unsaved').value = 'keep this';"));
+  }
+  auto* service = helium::HeliumSpaceServiceFactory::GetForProfile(
+      browser()->profile());
+  for (int round = 0; round < 6; ++round) {
+    for (size_t index = 0; index < tabs.size(); ++index) {
+      auto* target = tabs[index];
+      auto* selected = tabs[(index + round) % tabs.size()];
+      tab_strip_model()->ActivateTabAt(tab_strip_model()->GetIndexOfTab(selected));
+      for (bool favorite : {false, true}) {
+        SCOPED_TRACE(testing::Message() << "round=" << round
+                                      << " tab=" << index
+                                      << " favorite=" << favorite);
+        if (favorite) {
+          ASSERT_TRUE(service->AddFavoriteFromTab(target));
+        } else {
+          ASSERT_TRUE(service->ConvertTabToPinInSpace(
+              browser(), service->GetDefaultSpace()->id(), target, {}, {}));
+        }
+        ASSERT_NO_FATAL_FAILURE(WaitForSidebarAgreement());
+        EXPECT_EQ(selected, tab_strip_model()->GetActiveTab());
+        ASSERT_TRUE(service->RemovePersistentItem(target));
+        ASSERT_NO_FATAL_FAILURE(WaitForSidebarAgreement());
+        EXPECT_EQ(selected, tab_strip_model()->GetActiveTab());
+        ASSERT_EQ(tabs.size(), static_cast<size_t>(tab_strip_model()->count()));
+        for (size_t i = 0; i < tabs.size(); ++i) {
+          ASSERT_EQ(contents[i], tabs[i]->GetContents());
+          EXPECT_EQ("keep this", content::EvalJs(
+              contents[i], "document.getElementById('unsaved').value"));
+        }
+      }
+    }
+  }
