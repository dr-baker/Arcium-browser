+// Fixed seeds and step traces make a failing sequence reproducible. These
+// checks describe ownership rules, independently of the transition code.
+class PersistentItemInvariantTest : public testing::TestWithParam<uint32_t> {};
+
+TEST_P(PersistentItemInvariantTest, LifecycleOwnershipAcrossActionSequences) {
+  using State = PersistentItemLifecycle::State;
+  PersistentItemLifecycle lifecycle;
+  std::mt19937 random(GetParam());
+  const std::array<std::string, 4> ids = {"a", "b", "c", "d"};
+  std::set<uint64_t> issued_tokens;
+  uint64_t next_token = 1;
+  for (const auto& id : ids) {
+    ASSERT_TRUE(lifecycle.AddDormant(id));
+  }
+  for (int step = 0; step < 512; ++step) {
+    const auto& id = ids[random() % ids.size()];
+    const unsigned action = random() % 9;
+    SCOPED_TRACE(testing::Message() << "seed=" << GetParam()
+                                  << " step=" << step << " id=" << id
+                                  << " action=" << action);
+    const auto token = lifecycle.GetLiveTab(id);
+    switch (action) {
+      case 0:
+        lifecycle.AddDormant(id);
+        break;
+      case 1: {
+        const auto decision = lifecycle.BeginActivation(id);
+        if (decision.action ==
+            PersistentItemLifecycle::ActivationAction::kMaterialize) {
+          const uint64_t fresh = next_token++;
+          issued_tokens.insert(fresh);
+          ASSERT_TRUE(lifecycle.DidMaterialize(id, fresh));
+        } else if (decision.action ==
+                   PersistentItemLifecycle::ActivationAction::kActivateExisting) {
+          EXPECT_EQ(token, decision.live_tab);
+        }
+        break;
+      }
+      case 2:
+        if (token) {
+          lifecycle.BeginClose(*token);
+        }
+        break;
+      case 3:
+        if (token) {
+          lifecycle.CompleteClose(*token);
+        }
+        break;
+      case 4:
+        if (token) {
+          lifecycle.CancelClose(*token);
+        }
+        break;
+      case 5:
+        lifecycle.Forget(id);
+        break;
+      case 6: {
+        const auto before_state = lifecycle.GetState(id);
+        const auto before_token = lifecycle.GetLiveTab(id);
+        const auto& destination = ids[random() % ids.size()];
+        if (lifecycle.Rekey(id, destination)) {
+          EXPECT_FALSE(lifecycle.GetState(id));
+          EXPECT_EQ(before_state, lifecycle.GetState(destination));
+          EXPECT_EQ(before_token, lifecycle.GetLiveTab(destination));
+        } else {
+          EXPECT_EQ(before_state, lifecycle.GetState(id));
+          EXPECT_EQ(before_token, lifecycle.GetLiveTab(id));
+        }
+        break;
+      }
+      case 7: {
+        const uint64_t fresh = next_token++;
+        issued_tokens.insert(fresh);
+        lifecycle.RestoreLive(id, fresh);
+        break;
+      }
+      case 8:
+        lifecycle.RetainOnly({ids[random() % ids.size()], id});
+        break;
+    }
+
+    std::set<uint64_t> owned;
+    for (const auto& item : ids) {
+      const auto state = lifecycle.GetState(item);
+      const auto live = lifecycle.GetLiveTab(item);
+      EXPECT_EQ(state == State::kLive || state == State::kClosing,
+                live.has_value());
+      if (live) {
+        EXPECT_TRUE(owned.insert(*live).second) << "duplicate live tab";
+        EXPECT_EQ(std::optional<std::string_view>(item),
+                  lifecycle.GetItemForLiveTab(*live));
+      }
+    }
+    // Includes retired tokens: removing a record must clear the reverse index.
+    for (uint64_t issued : issued_tokens) {
+      const auto owner = lifecycle.GetItemForLiveTab(issued);
+      EXPECT_EQ(owned.contains(issued), owner.has_value());
+      if (owner) {
+        EXPECT_EQ(issued, lifecycle.GetLiveTab(*owner));
+      }
+    }
+  }
+}
+
+TEST_P(PersistentItemInvariantTest, TreeMovesPreserveIdentityAndPersistence) {
+  std::mt19937 random(GetParam());
+  PersistentNodes nodes = Tree();
+  const std::array<std::string, 4> ids = {"top", "outer", "nested", "empty"};
+  const std::array<std::string, 3> parents = {"", "outer", "empty"};
+  for (int step = 0; step < 128; ++step) {
+    const auto& id = ids[random() % ids.size()];
+    const auto& parent = parents[random() % parents.size()];
+    SCOPED_TRACE(testing::Message() << "seed=" << GetParam()
+                                  << " step=" << step << " id=" << id
+                                  << " parent=" << parent);
+    const auto before = nodes;
+    if (!PersistentItemCodec::MoveNode(nodes, id, parent, {})) {
+      EXPECT_EQ(before, nodes) << "rejected move changed the tree";
+    }
+    const auto restored =
+        PersistentItemCodec::Decode(PersistentItemCodec::Encode(nodes), true);
+    ASSERT_TRUE(restored) << "invalid or duplicate durable identity";
+    EXPECT_EQ(nodes, *restored);
+    for (const char* link_id : {"top", "nested"}) {
+      const auto* link = PersistentItemCodec::FindLink(nodes, link_id);
+      ASSERT_TRUE(link);
+      EXPECT_EQ(GURL(std::string("https://") + link_id + ".test/"), link->url);
+      EXPECT_EQ(u"Link", link->title);
+    }
+    ASSERT_TRUE(PersistentItemCodec::FindFolder(nodes, "outer"));
+    EXPECT_TRUE(PersistentItemCodec::FindFolder(nodes, "outer")->collapsed);
+    EXPECT_TRUE(PersistentItemCodec::FindFolder(nodes, "empty"));
+  }
+}
+
+INSTANTIATE_TEST_SUITE_P(FixedSeeds, PersistentItemInvariantTest,
+                        testing::Values(1u, 42u, 20260927u, 0xC0FFEEu));
+
 }  // namespace
 }  // namespace helium
