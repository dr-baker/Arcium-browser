+TEST(SidebarRowLayoutTest, ExpandedRowsShareColumnsAtEachUIScale) {
+  struct ScaleCase {
+    double scale;
+    int inset;
+    int slot;
+    int gap;
+    int indent;
+  };
+  for (const auto& test :
+       {ScaleCase{0.8, 5, 14, 6, 13}, ScaleCase{1.0, 6, 18, 8, 16},
+        ScaleCase{1.25, 8, 23, 10, 20}, ScaleCase{1.5, 9, 27, 12, 24}}) {
+    SCOPED_TRACE(test.scale);
+    const arcium::SidebarRowMetrics metrics =
+        arcium::SidebarRowMetrics::ForScale(test.scale);
+    EXPECT_EQ(test.inset, metrics.container_padding);
+    EXPECT_EQ(test.inset, metrics.horizontal_inset);
+    EXPECT_EQ(test.slot, metrics.icon_slot_width);
+    EXPECT_EQ(test.gap, metrics.icon_title_gap);
+    EXPECT_EQ(test.slot, metrics.close_slot_width);
+    EXPECT_EQ(test.gap, metrics.close_title_gap);
+    EXPECT_EQ(test.indent, metrics.depth_indent);
+
+    const int sidebar_width = base::ClampRound(300 * test.scale);
+    const int favicon_size = base::ClampRound(16 * test.scale);
+    const int icon_inset = base::ClampRound(3 * test.scale);
+    const gfx::Size decorated_icon(favicon_size + 2 * icon_inset,
+                                   favicon_size + 2 * icon_inset);
+    for (int depth : {0, 1, 2}) {
+      SCOPED_TRACE(depth);
+      const int row_x = test.inset + depth * test.indent;
+      const gfx::Rect row(row_x, 0, sidebar_width - row_x - test.inset,
+                          base::ClampRound(28 * test.scale));
+      const arcium::SidebarRowBounds tab = arcium::CalculateSidebarRowBounds(
+          row, metrics, decorated_icon, base::ClampRound(16 * test.scale));
+      const arcium::SidebarRowBounds folder = arcium::CalculateSidebarRowBounds(
+          row, metrics, gfx::Size(test.slot, test.slot),
+          base::ClampRound(16 * test.scale));
+      EXPECT_EQ(row_x + test.inset + test.slot + test.gap, tab.title.x());
+      EXPECT_EQ(tab.title, folder.title);
+      const int favicon_edge = test.inset + test.slot / 2 - favicon_size / 2;
+      EXPECT_EQ(sidebar_width - test.inset - favicon_edge, tab.title.right());
+      EXPECT_EQ(tab.icon.x() + icon_inset - depth * test.indent,
+                sidebar_width - tab.title.right());
+      EXPECT_EQ(folder.icon.CenterPoint().x(),
+                tab.icon.x() + icon_inset + favicon_size / 2);
+
+      // The hit target can be 26 or 28 DIP; neither changes the text endpoint
+      // or the visual close icon's column.
+      for (int close_design_size : {26, 28}) {
+        SCOPED_TRACE(close_design_size);
+        const int close_size = base::ClampRound(close_design_size * test.scale);
+        const arcium::SidebarRowBounds with_close =
+            arcium::CalculateSidebarRowBounds(
+                row, metrics, decorated_icon, base::ClampRound(16 * test.scale),
+                gfx::Size(close_size, close_size));
+        EXPECT_EQ(tab.title.x(), with_close.title.x());
+        EXPECT_EQ(sidebar_width - 2 * test.inset - test.slot - test.gap,
+                  with_close.title.right());
+        EXPECT_EQ(sidebar_width - 2 * test.inset - test.slot + test.slot / 2,
+                  with_close.close_button.CenterPoint().x());
+      }
+    }
+  }
+}
