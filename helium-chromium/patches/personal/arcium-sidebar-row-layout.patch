===================================================================
--- /dev/null
+++ src/chrome/browser/ui/views/tabs/common/sidebar_row_layout.h
@@ -0,0 +1,129 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_COMMON_SIDEBAR_ROW_LAYOUT_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_COMMON_SIDEBAR_ROW_LAYOUT_H_
+
+#include <algorithm>
+#include <optional>
+
+#include "base/numerics/safe_conversions.h"
+#include "chrome/browser/ui/views/helium/arcium_chrome_ui_scale.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/button/label_button.h"
+
+namespace arcium {
+
+// Expanded rows share design slots even when their actual images or button
+// hit targets have different sizes. All dimensions are scaled together.
+struct SidebarRowMetrics {
+  int container_padding;
+  int horizontal_inset;
+  int icon_slot_width;
+  int favicon_width;
+  int icon_title_gap;
+  int close_slot_width;
+  int close_title_gap;
+  int depth_indent;
+
+  static SidebarRowMetrics ForScale(double scale) {
+    const int edge_spacing = base::ClampRound(6 * scale);
+    return {.container_padding = edge_spacing,
+            .horizontal_inset = edge_spacing,
+            .icon_slot_width = base::ClampRound(18 * scale),
+            .favicon_width = base::ClampRound(16 * scale),
+            .icon_title_gap = base::ClampRound(8 * scale),
+            .close_slot_width = base::ClampRound(18 * scale),
+            .close_title_gap = base::ClampRound(8 * scale),
+            .depth_indent = base::ClampRound(16 * scale)};
+  }
+};
+
+inline SidebarRowMetrics GetSidebarRowMetrics(const views::View* view) {
+  return SidebarRowMetrics::ForScale(GetChromeUIScale(view));
+}
+
+inline void ApplySidebarRowMetricsToLabelButton(
+    views::LabelButton* button,
+    const SidebarRowMetrics& metrics) {
+  // Native vertical insets contribute to a folder row's preferred height.
+  // Replace only its horizontal insets so the row keeps that height.
+  gfx::Insets insets = button->GetInsets();
+  insets.set_left(metrics.horizontal_inset);
+  insets.set_right(metrics.horizontal_inset);
+  button->SetBorder(views::CreateEmptyBorder(insets));
+  button->SetImageLabelSpacing(metrics.icon_title_gap);
+}
+
+struct SidebarRowBounds {
+  gfx::Rect icon;
+  gfx::Rect title;
+  gfx::Rect close_button;
+  gfx::Rect alert_indicator;
+};
+
+inline gfx::Rect CenterSidebarRowChild(const gfx::Rect& contents,
+                                       int slot_x,
+                                       int slot_width,
+                                       const gfx::Size& child_size) {
+  // Use the same integer center for differently sized images at fractional
+  // scales. TabIcon includes extra insets for its attention/discard indicators.
+  gfx::Rect bounds(slot_x + slot_width / 2 - child_size.width() / 2,
+                   contents.y() + (contents.height() - child_size.height()) / 2,
+                   child_size.width(), child_size.height());
+  bounds.Intersect(contents);
+  return bounds;
+}
+
+inline SidebarRowBounds CalculateSidebarRowBounds(
+    const gfx::Rect& contents,
+    const SidebarRowMetrics& metrics,
+    const std::optional<gfx::Size>& icon_size,
+    int title_height,
+    const std::optional<gfx::Size>& close_size = std::nullopt,
+    const std::optional<gfx::Size>& alert_size = std::nullopt) {
+  SidebarRowBounds bounds;
+  const int leading_slot_x = contents.x() + metrics.horizontal_inset;
+  int title_x =
+      leading_slot_x + metrics.icon_slot_width + metrics.icon_title_gap;
+  if (icon_size) {
+    bounds.icon = CenterSidebarRowChild(contents, leading_slot_x,
+                                        metrics.icon_slot_width, *icon_size);
+  }
+  if (alert_size) {
+    // A pinned row can replace its favicon with the alert. Ordinary rows keep
+    // both, placing the alert between the favicon and title.
+    const int alert_x = icon_size ? title_x : leading_slot_x;
+    bounds.alert_indicator = CenterSidebarRowChild(
+        contents, alert_x, metrics.icon_slot_width, *alert_size);
+    title_x = alert_x + metrics.icon_slot_width + metrics.icon_title_gap;
+  }
+
+  int trailing_edge = contents.right() - metrics.horizontal_inset;
+  if (close_size) {
+    const int close_slot_x = trailing_edge - metrics.close_slot_width;
+    bounds.close_button = CenterSidebarRowChild(
+        contents, close_slot_x, metrics.close_slot_width, *close_size);
+    trailing_edge = close_slot_x - metrics.close_title_gap;
+  } else {
+    // Mirror the painted favicon's leading edge, including integer centering
+    // at fractional scales. Folder indentation does not move the trailing edge.
+    trailing_edge -= metrics.icon_slot_width / 2 - metrics.favicon_width / 2;
+  }
+
+  title_x = std::clamp(title_x, contents.x(), contents.right());
+  trailing_edge = std::clamp(trailing_edge, title_x, contents.right());
+  bounds.title =
+      gfx::Rect(title_x, contents.y() + (contents.height() - title_height) / 2,
+                trailing_edge - title_x, title_height);
+  bounds.title.Intersect(contents);
+  return bounds;
+}
+
+}  // namespace arcium
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_COMMON_SIDEBAR_ROW_LAYOUT_H_
