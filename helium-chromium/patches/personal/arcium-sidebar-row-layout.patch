+TEST_F(RenderTextTest, ExplicitCenteredFadeRampsDoNotOverlap) {
+  auto* text = GetRenderText();
+  text->SetText(u"A long title that overflows the available display width");
+  text->SetColor(SK_ColorBLACK);
+  text->SetCursorEnabled(false);
+  text->SetHorizontalAlignment(ALIGN_CENTER);
+  text->SetElideBehavior(FADE_TAIL);
+  text->SetFadeGradientWidth(16);
+  text->SetDisplayRect(Rect(3, 7, 7, 20));
+  DrawVisualText();
+
+  Rect shader_rect = text->display_rect();
+  shader_rect.Inset(Insets::TLBR(0, test_api()->GetAlignmentOffset(0).x(), 0, 0));
+  const SkPoint points[] = {SkPoint::Make(shader_rect.x(), shader_rect.y()),
+                            SkPoint::Make(shader_rect.right(), shader_rect.y())};
+  const auto position = [&](int x) {
+    return static_cast<SkScalar>(x - shader_rect.x()) / shader_rect.width();
+  };
+  const SkScalar positions[] = {0, position(3), position(6),
+                                position(7), 1};
+  const SkColor4f opaque = SkColor4f::FromColor(SK_ColorBLACK);
+  const SkColor4f transparent = SkColor4f::FromColor(SK_ColorTRANSPARENT);
+  const SkColor4f colors[] = {transparent, transparent, opaque, opaque,
+                              transparent};
+  const auto expected = cc::PaintShader::MakeLinearGradient(
+      points, colors, positions, std::size(colors), SkTileMode::kClamp);
+  ASSERT_TRUE(GetRendererPaint().getShader());
+  EXPECT_TRUE(GetRendererPaint().getShader()->EqualsForTesting(*expected));
+}
