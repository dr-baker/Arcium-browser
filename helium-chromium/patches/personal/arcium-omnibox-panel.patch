+class FakeSession : public CommandSession {
+ public:
+  explicit FakeSession(std::shared_ptr<FakeState> state)
+      : state_(std::move(state)) {}
+  void SetInvocation(CommandInvocationMode mode) override {
+    state_->mode = mode;
+  }
+  std::vector<CommandScopeDescriptor> GetScopes() const override {
+    return state_->scopes;
+  }
+  void Search(CommandScopeId scope,
+              std::u16string query,
+              CommandPublishCallback publish) override {
+    state_->publish = std::move(publish);
+    auto result = std::make_shared<CommandPublication>();
+    result->query_epoch = ++state_->epoch;
+    result->revision = base::UnguessableToken::Create();
+    result->scope_id = scope;
+    result->query = query;
+    result->scopes = state_->scopes;
+    result->current_tab = state_->current;
+    result->invocation_text = u"https://origin.test/current";
+    const auto descriptor =
+        std::ranges::find(state_->scopes, scope, &CommandScopeDescriptor::id);
+    if (scope != kSavedScope && (!query.empty() || scope != kOmniScope)) {
+      auto row = Result(
+          "typed:" + scope, query.empty() ? descriptor->label : query,
+          CommandProviderTarget{kNativeCommandProvider, "typed:" + scope});
+      row.kind = CommandRowKind::kTypedSearch;
+      row.provider_id = descriptor->provider_id;
+      row.icon = descriptor->icon;
+      row.primary_verb = descriptor->search_verb;
+      result->rows.push_back(std::move(row));
+    }
+    const auto normalized = base::i18n::FoldCase(query);
+    for (const auto& record : state_->records) {
+      if (result->rows.size() == kMaxRows) {
+        break;
+      }
+      if (scope != kOmniScope && record.scope != scope) {
+        continue;
+      }
+      if (query.empty() && scope == kOmniScope && !record.suggested) {
+        continue;
+      }
+      if (!query.empty() &&
+          (record.row.kind == CommandRowKind::kTypedSearch ||
+           base::i18n::FoldCase(record.row.title).find(normalized) ==
+               std::u16string::npos)) {
+        continue;
+      }
+      result->rows.push_back(record.row);
+    }
+    state_->last_publication = result;
+    if (!state_->defer_search) {
+      state_->publish.Run(std::move(result));
+    }
+  }
+  void Cancel() override {
+    ++state_->cancels;
+    state_->publish.Reset();
+  }
+  CommandMenu ResolveActions(const CommandTarget& target,
+                             std::string_view menu_id,
+                             std::u16string_view query) override {
+    const auto state = state_;
+    state->menu_requests.emplace_back(menu_id);
+    state->menu_queries.emplace_back(query);
+    state->menu_targets.push_back(target);
+    CommandMenu menu;
+    menu.id = menu_id.empty() ? "actions" : std::string(menu_id);
+    menu.title = menu.id == "actions" ? u"Actions" : u"Choose destination";
+    menu.filterable = true;
+    menu.placeholder =
+        menu.id == "actions" ? u"Find an action…" : u"Find a folder or Space…";
+    auto action = [&](std::string id, std::u16string label,
+                      std::string submenu = "") {
+      CommandMenuEntry entry;
+      entry.id = std::move(id);
+      entry.label = std::move(label);
+      entry.submenu_id = std::move(submenu);
+      entry.icon =
+          TestIcon(SkColorSetRGB(80 + menu.entries.size() * 25, 100, 140));
+      if (entry.submenu_id.empty()) {
+        CommandIntent intent;
+        intent.provider_id = kBuiltinCommandProvider;
+        intent.action_id = entry.id;
+        intent.target = target;
+        entry.intent = std::move(intent);
+      }
+      menu.entries.push_back(std::move(entry));
+    };
+    if (state->target_missing) {
+      // The owner revalidates the retained target on each menu lookup.
+    } else if (state->extra_menus.contains(menu.id)) {
+      menu = state->extra_menus.at(menu.id);
+    } else if (menu.id == "actions") {
+      action("pin", u"Pin tab");
+      action("favorite", u"Add favorite");
+      action("move", u"Move to Space…", "spaces");
+      action("folder", u"Choose folder…", "folders");
+      action("close", u"Close tab");
+      if (state->late_action) {
+        action("late-provider-action", u"Send to a late provider");
+      }
+      if (state->mute_menu) {
+        action(state->muted ? "unmute" : "mute",
+               state->muted ? u"Unmute site" : u"Mute site");
+        // Presentation identity stays stable while its executable intent
+        // changes.
+        menu.entries.back().id = "site-mute";
+        menu.entries.back().icon =
+            TestIcon(state->muted ? SK_ColorBLUE : SK_ColorRED);
+      }
+    } else {
+      for (const auto& [id, name] :
+           std::vector<std::pair<std::string, std::u16string>>{
+               {"root", u"Space root"},
+               {"design", u"References"},
+               {"research", u"References"}}) {
+        action(id, name);
+        auto& entry = menu.entries.back();
+        entry.detail = id == "root"     ? u"Design"
+                       : id == "design" ? u"Design › Interface › References"
+                                        : u"Research › Sources › References";
+        entry.intent->destination = CommandDestination{
+            menu.id == "spaces" ? CommandDestinationKind::kSpace
+                                : CommandDestinationKind::kFolder,
+            id, id == "root" ? "" : id, name};
+      }
+    }
+    const auto normalized = base::i18n::FoldCase(query);
+    std::erase_if(menu.entries, [&](const auto& entry) {
+      return !normalized.empty() &&
+             base::i18n::FoldCase(entry.label + u" " + entry.detail)
+                     .find(normalized) == std::u16string::npos;
+    });
+    if (menu.entries.size() > kMaxMenuEntries) {
+      menu.entries.resize(kMaxMenuEntries);
+    }
+    if (state->resolve_hook) {
+      state->resolve_hook.Run();
+    }
+    return menu;
+  }
+  CommandExecutionResult Execute(const CommandIntent& intent) override {
+    const auto state = state_;
+    state->executed.push_back(intent);
+    if (intent.action_id == "mute") {
+      state->muted = true;
+    }
+    if (intent.action_id == "unmute") {
+      state->muted = false;
+    }
+    if (state->remove_target_on_execute) {
+      state->target_missing = true;
+    }
+    if (state->execute_hook) {
+      state->execute_hook.Run();
+    }
+    return {true, state->dismiss_on_execute, u"Done"};
+  }
+
+ private:
+  std::shared_ptr<FakeState> state_;
+};
+}  // namespace
