+  dove.activity = CommandActivity::kDot;
+  dove.primary_icon = CommandPrimaryIcon::kSwitch;
+  dove.primary_verb = u"Switch to tab";
+  state->records = {
+      {kOmniScope, suggestion, true}, {kWebScope, documentation, true},
+      {kSavedScope, interface, true}, {kSavedScope, references, true},
+      {kSavedScope, favorite, true},  {kYouTubeScope, video, true},
+      {kYouTubeScope, dove, true}};
+  for (int i = 0; i < 209; ++i) {
+    auto row = Result("reference:" + base::NumberToString(i),
+                      u"Reference library " + base::NumberToString16(i),
+                      pin("reference:" + base::NumberToString(i)), true);
+    row.activity = CommandActivity::kCircle;
+    row.primary_verb = u"Restore pin";
