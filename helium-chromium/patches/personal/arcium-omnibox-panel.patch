+}
+CommandRow Result(std::string key,
+                  std::u16string title,
+                  CommandTarget target,
+                  bool actions = false) {
+  CommandRow row;
+  row.provider_id = kBuiltinCommandProvider;
+  row.selection_key = std::move(key);
+  row.title = std::move(title);
+  row.target = std::move(target);
+  row.has_actions = actions;
+  row.primary_verb = u"Open website";
+  return row;
+}
+std::vector<CommandScopeDescriptor> TestScopes() {
+  std::vector<CommandScopeDescriptor> scopes;
+  for (const auto& [id, label] :
+       std::vector<std::pair<std::string, std::u16string>>{
+           {kOmniScope, u"Omni"},
+           {kWebScope, u"Bing"},
+           {kSavedScope, u"Saved"},
+           {kYouTubeScope, u"YouTube"},
+           {kXScope, u"X"},
+           {kChatGPTScope, u"ChatGPT"}}) {
+    CommandScopeDescriptor scope;
+    scope.id = id;
+    scope.provider_id = kBuiltinCommandProvider;
+    scope.label = label;
+    scope.tint = SkColorSetRGB(133, 170, 207);
+    scope.placeholder = u"Search " + label + u"…";
+    scope.search_verb = u"Search " + label;
+    scope.accessibility_description = u"Search " + label;
+    scopes.push_back(std::move(scope));
+  }
+  scopes[1].icon = TestIcon(SK_ColorBLUE);
+  return scopes;
+}
+struct FakeState {
+  std::vector<CommandScopeDescriptor> scopes = TestScopes();
