+class ArciumNativePanelTest : public views::ViewsTestBase {
+ protected:
+  void SetUp() override {
+    // Hidden RootView bitmap painting does not composite child layers. Use
+    // synchronous View scrolling so both row pixels and offsets are observable.
+    feature_list_.InitAndDisableFeature(
+        ::features::kUiCompositorScrollWithLayers);
+    views::ViewsTestBase::SetUp();
+    state_ = TestState();
+  }
+  void TearDown() override {
+    Close();
+    views::ViewsTestBase::TearDown();
+  }
+  void Open(bool new_tab = true) {
+    if (panel_) {
+      panel_->SetInvocation(new_tab);
+    } else {
+      // CreateTestWidget initializes with show=false. Tests never show or
+      // activate a native window, and never call the production BrowserView.
+      widget_ = CreateTestWidget(views::Widget::InitParams::CLIENT_OWNS_WIDGET);
+      panel_ = widget_->SetContentsView(std::make_unique<CommandPanelView>(
+          std::make_unique<FakeSession>(state_),
+          base::BindRepeating(
+              [](ArciumNativePanelTest* test) { ++test->dismissals_; },
+              base::Unretained(this)),
+          base::BindRepeating(
+              [](ArciumNativePanelTest* test, bool invocation) {
+                test->panel_->SetInvocation(invocation);
+              },
+              base::Unretained(this))));
+      panel_->SetInvocation(new_tab);
+      widget_->SetBounds(gfx::Rect(panel_->GetPreferredSize()));
+    }
+    widget_->GetRootView()->DeprecatedLayoutImmediately();
+    panel_->FocusInput();
+    ASSERT_FALSE(widget_->IsVisible());
+    ASSERT_FALSE(panel_->scroll_for_testing()->contents()->layer());
+  }
+  void Close() {
+    if (!widget_) {
+      return;
+    }
+    views::ViewTracker tracker(panel_);
+    widget_->CloseNow();
+    widget_.reset();
+    panel_ = nullptr;
+    EXPECT_FALSE(tracker.view());
+    base::RunLoop().RunUntilIdle();
+    EXPECT_FALSE(tracker.view());
+  }
+  CommandPanelView* panel() { return panel_; }
+  SkBitmap PaintPanel() {
+    // Paint the root of the hidden widget's View tree. The attached panel is a
+    // child and cannot be treated as the paint walk's root.
+    return views::test::PaintViewToBitmap(widget_->GetRootView());
+  }
+  void Key(ui::KeyboardCode key, int flags = 0) {
+    ui::KeyEvent event(ui::EventType::kKeyPressed, key, flags);
+    panel_->HandleKeyEvent(panel_->input_for_testing(), event);
+    if (widget_) {
+      views::test::RunScheduledLayout(widget_.get());
+    }
+  }
+  void Query(const std::u16string& text) {
+    panel_->input_for_testing()->SetText(text);
+    panel_->ContentsChanged(panel_->input_for_testing(), text);
+    views::test::RunScheduledLayout(widget_.get());
+  }
+  void PinActions() {
+    Query(u"interface");
+    Key(ui::VKEY_DOWN);
+    ASSERT_TRUE(
+        panel_->row_for_testing(panel_->selected_for_testing()).has_actions);
+    Key(ui::VKEY_K, kActionModifier);
+    ASSERT_TRUE(panel_->actions_visible_for_testing());
+  }
+  void Publish(std::shared_ptr<CommandPublication> publication) {
+    state_->last_publication = publication;
+    state_->publish.Run(std::move(publication));
+    views::test::RunScheduledLayout(widget_.get());
+  }
+  std::shared_ptr<CommandPublication> Update() {
+    auto publication =
+        std::make_shared<CommandPublication>(*state_->last_publication);
+    publication->revision = base::UnguessableToken::Create();
+    return publication;
+  }
+  base::test::ScopedFeatureList feature_list_;
+  std::shared_ptr<FakeState> state_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<CommandPanelView> panel_ = nullptr;
+  int dismissals_ = 0;
+};
