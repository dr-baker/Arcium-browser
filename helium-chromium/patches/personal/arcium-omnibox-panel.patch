+struct CommandPanelAppearance {
+  enum class Labels { kPill, kText, kJoined };
+  enum class Icons { kActions, kArrows, kGoSwitch, kReturn };
+  // Values are stored in the profile's command-panel layout dictionary.
+  enum class Reveal { kTabs, kIcons, kEdge, kHidden, kFlush, kDivot };
+  Labels labels = Labels::kText;
+  Icons icons = Icons::kGoSwitch;
+  Reveal reveal = Reveal::kEdge;
+  bool connected = true;
+  bool full_width = true;
+  bool scope_tints = true;
+  double glow_strength = 1.0;
+  bool activity_dots = true;
+  friend bool operator==(const CommandPanelAppearance&,
+                         const CommandPanelAppearance&) = default;
+};
