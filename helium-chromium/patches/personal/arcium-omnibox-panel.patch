+}
+void CommandPanelView::SetUIScale(float scale) {
+  scale = std::clamp(scale, .8f, 1.25f);
+  if (ui_scale_ == scale) {
+    return;
+  }
+  ui_scale_ = scale;
+  if (GetWidget()) {
+    auto bounds = GetWidget()->GetWindowBoundsInScreen();
+    const int available_width = available_width_provider_
+                                    ? available_width_provider_.Run() : 10000;
+    const int width = std::max(280, std::min(GetPreferredSize().width(),
+                                           available_width));
+    bounds.set_x(bounds.CenterPoint().x() - width / 2);
+    bounds.set_width(width);
+    GetWidget()->SetBounds(bounds);
+  }
+  input_->SetFontList(Font(S(scale, 18), true));
+  RebuildViews();
+}
+void CommandPanelView::BindPreferences(
+    PrefService* prefs,
+    base::RepeatingCallback<float()> scale_provider,
+    base::RepeatingCallback<int()> available_width_provider) {
+  available_width_provider_ = std::move(available_width_provider);
+  pref_observer_.Init(prefs);
+  SetAppearance(ReadCommandPanelAppearance(prefs));
+  SetUIScale(scale_provider.Run());
+  pref_observer_.Add(
+      kCommandPanelLayoutPref,
+      base::BindRepeating(
+          [](CommandPanelView* view, PrefService* owner) {
+            view->SetAppearance(ReadCommandPanelAppearance(owner));
+          },
+          base::Unretained(this), prefs));
+  pref_observer_.Add(kChromeUIScalePref,
+                     base::BindRepeating(
+                         [](CommandPanelView* view,
+                            base::RepeatingCallback<float()> provider) {
+                           view->SetUIScale(provider.Run());
+                         },
+                         base::Unretained(this), scale_provider));
+}
+void CommandPanelView::SetNativeMaterial(bool enabled) {
+  native_material_ = enabled;
+  SchedulePaint();
