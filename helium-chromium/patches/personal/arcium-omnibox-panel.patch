+TEST_F(ArciumNativePanelTest, IconAndLabelPaintDoNotInheritTheSlowerRailFade) {
+  auto motion = gfx::AnimationTestApi::SetRichAnimationRenderMode(
+      gfx::Animation::RichAnimationRenderMode::FORCE_ENABLED);
+  gfx::ScopedAnimationDurationScaleMode duration(
+      gfx::ScopedAnimationDurationScaleMode::NORMAL_DURATION);
+  state_->scopes[0].icon = TestIcon(SK_ColorWHITE);
+  state_->scopes[0].label = u"Independent label";
+  Open();
+  CommandPanelAppearance appearance;
+  appearance.reveal = CommandPanelAppearance::Reveal::kFlush;
+  appearance.scope_tints = false;
+  panel()->SetAppearance(appearance);
+  Key(ui::VKEY_UP);
+  gfx::AnimationTestApi reveal(panel()->scope_animation_for_testing());
+  gfx::AnimationTestApi label(panel()->scope_label_animation_for_testing());
+  gfx::AnimationTestApi icon(panel()->scope_icon_animation_for_testing());
+  const auto start = base::TimeTicks::Now();
+  for (auto* animation : {&reveal, &label, &icon}) {
+    animation->SetStartTime(start);
+    animation->Step(start + base::Milliseconds(80));
+  }
+  EXPECT_EQ(1, panel()->scope_label_animation_for_testing()->GetCurrentValue());
+  EXPECT_LT(panel()->scope_icon_animation_for_testing()->GetCurrentValue(), 1);
+  EXPECT_LT(panel()->scope_animation_for_testing()->GetCurrentValue(), 1);
+  const auto changed_pixels = [](const SkBitmap& before,
+                                 const gfx::Rect& region, const SkBitmap& after,
+                                 const gfx::Point& destination) {
+    int changed = 0;
+    for (int y = 0; y < region.height(); ++y) {
+      for (int x = 0; x < region.width(); ++x) {
+        changed += before.getColor(region.x() + x, region.y() + y) !=
+                   after.getColor(destination.x() + x, destination.y() + y);
+      }
+    }
+    return changed;
+  };
+  const auto label_region = [](const gfx::Rect& scope) {
+    // The selected caption extends into the right half of its scope; the
+    // fixture's solid icon stays in the left half. Exclude the top stroke.
+    return gfx::Rect(scope.CenterPoint().x(), scope.y() + 4,
+                     scope.width() / 2 - 6, 20);
+  };
+  const auto scope_at_80 = panel()->scope_button_for_testing(0)->bounds();
+  const auto label_at_80 = label_region(scope_at_80);
+  const auto before_icon = PaintPanel();
+  icon.Step(start + base::Milliseconds(110));
+  EXPECT_EQ(1, panel()->scope_icon_animation_for_testing()->GetCurrentValue());
+  const auto after_icon = PaintPanel();
+  const gfx::Rect icon_region(scope_at_80.x() + 4, scope_at_80.y() + 4,
+                              scope_at_80.width() / 2 - 4, 20);
+  EXPECT_GT(changed_pixels(before_icon, icon_region, after_icon,
+                           icon_region.origin()),
+            0);
+  EXPECT_EQ(0, changed_pixels(before_icon, label_at_80, after_icon,
+                              label_at_80.origin()));
+  reveal.Step(start + base::Milliseconds(110));
+  EXPECT_LT(panel()->scope_animation_for_testing()->GetCurrentValue(), 1);
+  const auto label_at_110 =
+      label_region(panel()->scope_button_for_testing(0)->bounds());
+  const auto before_rail = PaintPanel();
+  reveal.Step(start + base::Milliseconds(140));
+  const auto label_at_140 =
+      label_region(panel()->scope_button_for_testing(0)->bounds());
+  const auto after_rail = PaintPanel();
+  EXPECT_EQ(0, changed_pixels(before_rail, label_at_110, after_rail,
+                              label_at_140.origin()));
+  int caption_pixels = 0;
+  for (int y = label_at_140.y(); y < label_at_140.bottom(); ++y) {
+    for (int x = label_at_140.x(); x < label_at_140.right(); ++x) {
+      caption_pixels += SkColorGetG(after_rail.getColor(x, y)) > 100;
+    }
+  }
+  EXPECT_GT(caption_pixels, 0);
+  EXPECT_FALSE(widget_->IsVisible());
+}
