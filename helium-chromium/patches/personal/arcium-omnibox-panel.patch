+TEST_F(ArciumNativePanelTest, EmptyAndCapturedPublicationsPaintDuringResize) {
+  auto motion = gfx::AnimationTestApi::SetRichAnimationRenderMode(
+      gfx::Animation::RichAnimationRenderMode::FORCE_DISABLED);
+  state_->defer_search = true;
+  Open();
+  EXPECT_EQ(0u, panel()->row_count_for_testing());
+  EXPECT_FALSE(PaintPanel().empty());
+  auto paints = std::make_shared<int>(0);
+  auto empty_paints = std::make_shared<int>(0);
+  panel()->SetGeometryChangedCallback(
+      base::BindLambdaForTesting([this, paints, empty_paints]() {
+        ++*paints;
+        if (panel()->row_count_for_testing() == 0) {
+          ++*empty_paints;
+        }
+        // Resize can paint after clearing results and before Select() has
+        // normalized the previous ordinal. Exercise that actual callback.
+        EXPECT_FALSE(PaintPanel().empty());
+      }));
+  Key(ui::VKEY_RIGHT);
+  Key(ui::VKEY_RIGHT);
+  Query(u"perfume");
+  EXPECT_EQ(kSavedScope, panel()->scope_for_testing());
+  EXPECT_EQ(0u, panel()->row_count_for_testing());
+  // Pending publication can retain the previous ordinal; paint must guard it.
+  EXPECT_EQ(0, panel()->selected_for_testing());
+  auto empty = Update();
+  empty->rows.clear();
+  empty->current_tab.reset();
+  Publish(empty);
+  EXPECT_EQ(0u, panel()->row_count_for_testing());
+  EXPECT_FALSE(PaintPanel().empty());
+  Open(false);
+  auto current = Update();
+  current->rows.clear();
+  current->current_tab = state_->current;
+  Publish(current);
+  panel()->SetGeometryChangedCallback(base::RepeatingClosure());
+  ASSERT_EQ(1u, panel()->row_count_for_testing());
+  EXPECT_EQ("current", panel()->row_for_testing(0).selection_key);
+  EXPECT_EQ(0, panel()->selected_for_testing());
+  EXPECT_GT(*paints, 0);
+  EXPECT_GT(*empty_paints, 0);
+  EXPECT_FALSE(PaintPanel().empty());
+  EXPECT_FALSE(widget_->IsVisible());
+}
