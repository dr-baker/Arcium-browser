+}
+void CommandPanelView::ContentsChanged(views::Textfield*,
+                                       const std::u16string&) {
+  if (updating_) {
+    return;
+  }
+  current_context_ = false;
+  invocation_prefill_pending_ = false;
+  scope_browsing_ = false;
+  scope_hovered_ = false;
+  UpdateScopeReveal();
+  selected_ = 0;
+  selection_explicit_ = false;
+  selection_missing_ = false;
+  pending_selection_key_.clear();
+  feedback_.clear();
+  GetViewAccessibility().SetDescription(u"");
+  RebuildResults();
+}
+std::u16string CommandPanelView::Verb(const DisplayRow& row) const {
+  if (row.menu_entry) {
+    return row.menu_entry->submenu_id.empty() ? u"Choose" : u"Open";
+  }
+  if (!row.data.primary_verb.empty()) {
+    return row.data.primary_verb;
+  }
+  const auto* scope = ActiveScope();
+  return scope ? scope->search_verb : u"Open";
+}
+std::u16string_view CommandPanelView::ClampInputForQuery() {
+  const auto text = input_->GetText();
+  if (text.size() <= CommandSession::kMaxQueryLength) {
+    return text;
+  }
+  size_t length = CommandSession::kMaxQueryLength;
+  if (CBU16_IS_LEAD(text[length - 1]) && CBU16_IS_TRAIL(text[length])) {
+    --length;
+  }
+  // Preserve the IME's composition. Query and row copies use only the bounded
+  // prefix until ContentsChanged is called again for the committed text.
+  if (input_->IsIMEComposing()) {
+    return text.substr(0, length);
+  }
+  const auto selection = input_->GetSelectedRange();
+  const std::u16string bounded(text.substr(0, length));
+  const base::AutoReset<bool> update_guard(&updating_, true);
+  input_->SetText(bounded);
+  input_->SetSelectedRange(gfx::Range(std::min(selection.start(), length),
+                                    std::min(selection.end(), length)));
+  // SetText records the old value. Release it so Undo cannot restore an
+  // oversized query after the clamp.
+  input_->ClearEditHistory();
+  return input_->GetText();
+}
+size_t CommandPanelView::ScopeIndex(std::string_view id) const {
+  const auto found =
+      std::ranges::find(scopes_, id, &CommandScopeDescriptor::id);
+  return found == scopes_.end() ? 0 : found - scopes_.begin();
+}
+const CommandScopeDescriptor* CommandPanelView::ActiveScope() const {
+  return scopes_.empty() ? nullptr : &scopes_[ScopeIndex(scope_)];
+}
+std::string CommandPanelView::SelectedKey() const {
+  const auto* row = SelectedRow();
+  return row ? row->data.selection_key : std::string();
+}
+const CommandPanelView::DisplayRow* CommandPanelView::SelectedRow() const {
+  if (selected_ < 0 || selected_ >= static_cast<int>(rows_.size())) {
+    return nullptr;
+  }
+  const auto& row = rows_[selected_];
+  return row.menu_entry.has_value() == actions_visible_ ? &row : nullptr;
+}
+CommandPanelView::Row* CommandPanelView::SelectedRowView() const {
+  return SelectedRow() && selected_ < static_cast<int>(row_views_.size())
+             ? row_views_[selected_].get()
+             : nullptr;
+}
+void CommandPanelView::SyncScopes(std::vector<CommandScopeDescriptor> scopes) {
+  const bool same_order =
+      scopes.size() == scopes_.size() &&
+      std::ranges::equal(scopes, scopes_, {}, &CommandScopeDescriptor::id,
+                         &CommandScopeDescriptor::id);
+  if (same_order) {
+    scopes_ = std::move(scopes);
+    for (size_t i = 0; i < scopes_.size(); ++i) {
+      scope_buttons_[i]->GetViewAccessibility().SetName(
+          scopes_[i].accessibility_description);
+      scope_buttons_[i]->SchedulePaint();
+    }
+    return;
+  }
+  std::vector<float> weights;
+  weights.reserve(scopes.size());
+  for (const auto& descriptor : scopes) {
+    const auto found =
+        std::ranges::find(scopes_, descriptor.id, &CommandScopeDescriptor::id);
+    weights.push_back(found == scopes_.end()
+                          ? (descriptor.id == scope_ ? 1.f : 0.f)
+                          : ScopeWeight(found - scopes_.begin()));
+  }
+  input_->GetViewAccessibility().ClearActiveDescendant();
+  for (const auto& button : scope_buttons_) {
+    RemoveChildViewT(button.get());
+  }
+  scope_buttons_.clear();
+  scopes_ = std::move(scopes);
+  previous_scope_weights_ = std::move(weights);
+  if (!scopes_.empty() &&
+      std::ranges::none_of(
+          scopes_, [this](const auto& scope) { return scope.id == scope_; })) {
+    scope_ = scopes_.front().id;
+  }
+  for (size_t i = 0; i < scopes_.size(); ++i) {
+    scope_buttons_.push_back(
+        AddChildView(std::make_unique<ScopeButton>(this, i)));
+  }
+  scope_selection_animation_.Reset(1);
+  InvalidateLayout();
+}
+CommandPanelView::InputState CommandPanelView::CaptureInputState() {
+  InputState state;
+  state.query = ClampInputForQuery();
+  const auto selection = input_->GetSelectedRange();
+  state.selection = gfx::Range(std::min(selection.start(), state.query.size()),
+                               std::min(selection.end(), state.query.size()));
+  state.row = selected_;
+  state.selection_key =
+      pending_selection_key_.empty() ? SelectedKey() : pending_selection_key_;
+  state.explicit_selection = selection_explicit_;
+  state.missing_selection = selection_missing_;
+  return state;
+}
+void CommandPanelView::RestoreInputState(const InputState& state) {
+  const base::AutoReset<bool> update_guard(&updating_, true);
+  input_->SetText(state.query);
+  input_->SetSelectedRange(state.selection);
+  selected_ = state.row;
+  selection_explicit_ = state.explicit_selection;
+  selection_missing_ = state.missing_selection;
+}
+void CommandPanelView::RebuildResults(bool resolve_menu) {
+  const std::u16string query(ClampInputForQuery());
+  if (actions_visible_) {
+    if (resolve_menu && action_target_) {
+      RefreshCurrentMenu(false);
+      return;
+    }
+    RebuildMenuRows(false);
+    return;
+  }
+  requested_query_ = current_context_ ? std::u16string() : query;
+  if (publication_ && (publication_->scope_id != scope_ ||
+                       publication_->query != requested_query_)) {
+    publication_.reset();
+    rows_.clear();
+    RebuildViews();
+  }
+  const uint64_t request = ++request_generation_;
+  session_->Search(
+      scope_, requested_query_,
+      base::BindRepeating(&CommandPanelView::ApplyPublication,
+                          weak_ptr_factory_.GetWeakPtr(), request));
+}
+bool CommandPanelView::RefreshCurrentMenu(bool preserve_selection) {
+  if (!actions_visible_ || !action_target_ || menu_stack_.empty()) {
+    return false;
+  }
+  const CommandTarget target = *action_target_;
+  const std::string menu_id = menu_stack_.back().menu.id;
+  const std::u16string query = menu_stack_.back().menu.filterable
+                                   ? std::u16string(ClampInputForQuery())
+                                   : u"";
+  const uint64_t request = ++request_generation_;
+  const auto weak = weak_ptr_factory_.GetWeakPtr();
+  auto menu = session_->ResolveActions(target, menu_id, query);
+  if (!weak || request != request_generation_) {
+    return false;
+  }
+  ++action_resolutions_;
+  menu_stack_.back().menu = std::move(menu);
+  RebuildMenuRows(preserve_selection);
+  return true;
+}
+void CommandPanelView::ApplyPublication(
+    uint64_t request,
+    std::shared_ptr<const CommandPublication> publication) {
+  if (request != request_generation_ || !publication ||
+      publication->scope_id != scope_ ||
+      publication->query != requested_query_) {
+    return;
+  }
+  const bool preserve_selection = publication_ != nullptr;
+  publication_ = std::move(publication);
+  SyncScopes(publication_->scopes);
+  if (scopes_.empty() || publication_->scope_id != scope_) {
+    publication_.reset();
+    rows_.clear();
+    selection_explicit_ = false;
+    selection_missing_ = false;
+    pending_selection_key_.clear();
+    RebuildViews();
+    if (!scopes_.empty()) {
+      RebuildResults();
+    }
+    return;
+  }
+  if (current_context_ && invocation_prefill_pending_) {
+    const base::AutoReset<bool> update_guard(&updating_, true);
+    input_->SetText(publication_->invocation_text);
+    input_->SelectAll(false);
+    invocation_prefill_pending_ = false;
+  }
+  if (!actions_visible_) {
+    RebuildPublicationRows(preserve_selection);
+  } else {
+    Select(selected_, false, true);
+  }
+}
+void CommandPanelView::RebuildPublicationRows(bool preserve_selection) {
+  const std::string selected_key =
+      !pending_selection_key_.empty()
+          ? pending_selection_key_
+          : (preserve_selection && selection_explicit_ ? SelectedKey()
+                                                       : std::string());
+  rows_.clear();
+  if (publication_) {
+    const bool show_current = current_context_ && scope_ == kOmniScope &&
+                              publication_->current_tab.has_value();
+    if (show_current) {
+      auto current = *publication_->current_tab;
+      current.is_default = true;
+      rows_.push_back({std::move(current), std::nullopt});
+    }
+    for (const auto& data : publication_->rows) {
+      if (rows_.size() >= CommandSession::kMaxRows) {
+        break;
+      }
+      if (show_current &&
+          (std::holds_alternative<CommandLiveTarget>(
+               publication_->current_tab->target) ||
+           std::holds_alternative<CommandPersistentTarget>(
+               publication_->current_tab->target)) &&
+          data.target == publication_->current_tab->target &&
+          data.primary_action_id ==
+              publication_->current_tab->primary_action_id) {
+        continue;
+      }
+      rows_.push_back({data, std::nullopt});
+    }
+  }
+  if (!selected_key.empty()) {
+    const auto found = std::ranges::find_if(rows_, [&](const auto& row) {
+      return row.data.selection_key == selected_key;
+    });
+    if (found != rows_.end()) {
+      selected_ = found - rows_.begin();
+      pending_selection_key_.clear();
+      selection_missing_ = false;
+    } else {
+      selected_ = -1;
+      selection_missing_ = true;
+      pending_selection_key_ =
+          publication_ && !publication_->done ? selected_key : std::string();
+    }
+  } else if (selection_missing_) {
+    selected_ = -1;
+  } else if (!selection_explicit_ && !rows_.empty()) {
+    const auto found = std::ranges::find_if(
+        rows_, [](const auto& row) { return row.data.is_default; });
+    selected_ = found == rows_.end() ? 0 : found - rows_.begin();
+  }
+  if (publication_ && publication_->done) {
+    pending_selection_key_.clear();
+  }
+  selected_ =
+      rows_.empty() || selection_missing_
+          ? -1
+          : std::clamp(selected_, 0, static_cast<int>(rows_.size()) - 1);
+  RebuildViews(preserve_selection);
+}
+void CommandPanelView::RebuildMenuRows(bool preserve_selection) {
+  const std::string selected_key =
+      !pending_selection_key_.empty()
+          ? pending_selection_key_
+          : (preserve_selection ? SelectedKey() : std::string());
+  rows_.clear();
+  if (!menu_stack_.empty()) {
+    const auto& menu = menu_stack_.back().menu;
+    for (const auto& entry : menu.entries) {
+      if (rows_.size() == CommandSession::kMaxMenuEntries) {
+        break;
+      }
+      DisplayRow row;
+      row.data.selection_key = entry.id;
+      row.data.title = entry.label;
+      row.data.detail = entry.detail;
+      row.data.icon = entry.icon;
+      row.data.primary_icon = CommandPrimaryIcon::kAction;
+      row.menu_entry = entry;
+      rows_.push_back(std::move(row));
+    }
+  }
+  if (!selected_key.empty()) {
+    const auto found = std::ranges::find_if(rows_, [&](const auto& row) {
+      return row.data.selection_key == selected_key;
+    });
+    if (found != rows_.end()) {
+      selected_ = found - rows_.begin();
+      selection_missing_ = false;
+    } else {
+      selected_ = -1;
+      selection_missing_ = true;
+    }
+  }
+  pending_selection_key_.clear();
+  selected_ =
+      rows_.empty() || selection_missing_
+          ? -1
+          : std::clamp(selected_, 0, static_cast<int>(rows_.size()) - 1);
+  RebuildViews(preserve_selection);
+}
+void CommandPanelView::RebuildViews(bool preserve_selection) {
+  input_->GetViewAccessibility().ClearActiveDescendant();
+  row_views_.clear();
+  hovered_ = -1;
+  if (back_button_) {
+    RemoveChildViewT(back_button_.get());
+    back_button_ = nullptr;
+  }
+  results_view_->RemoveAllChildViews();
+  if (actions_visible_) {
+    back_button_ = AddChildView(std::make_unique<BackButton>(this));
+    back_button_->GetViewAccessibility().SetName(
+        menu_stack_.size() > 1 ? u"Back to actions" : u"Back to results");
+  }
+  for (size_t i = 0; i < rows_.size(); ++i) {
+    auto* row = results_view_->AddChildView(std::make_unique<Row>(this, i));
+    const auto& data = rows_[i].data;
+    row->GetViewAccessibility().SetName(data.title + u", " + data.category +
+                                        u", " + data.detail + u", " +
+                                        Verb(rows_[i]));
+    row->SetEnabled(!rows_[i].menu_entry || rows_[i].menu_entry->enabled);
+    row_views_.push_back(row);
+  }
+  if (!preserve_selection) {
+    selection_initialized_ = false;
+  }
+  const auto* scope = ActiveScope();
+  input_->SetPlaceholderText(
+      actions_visible_
+          ? (menu_stack_.back().menu.placeholder.empty()
+                 ? u"Find an action…"
+                 : menu_stack_.back().menu.placeholder)
+          : (scope ? scope->placeholder : u"Search or enter URL…"));
+  input_->GetViewAccessibility().SetName(
+      actions_visible_
+          ? menu_stack_.back().menu.title
+          : (scope ? scope->accessibility_description : u"Search"));
+  footer_button_->GetViewAccessibility().SetName(
+      actions_visible_ ? u"Back to results " + ActionShortcut()
+                       : u"Actions " + ActionShortcut());
+  PreferredSizeChanged();
+  InvalidateLayout();
+  if (GetWidget()) {
+    UpdateGeometry();
+  }
+  Select(selected_, false, preserve_selection);
+  SchedulePaint();
+}
+gfx::Size CommandPanelView::CalculatePreferredSize(
+    const views::SizeBounds&) const {
+  const int gap =
+      appearance_.labels == CommandPanelAppearance::Labels::kJoined ? 5 : 0;
+  const int results = std::min(
+      440, 11 + (actions_visible_ ? kHeadingHeight : 0) +
+               (rows_.empty() ? kEmptyHeight
+                              : static_cast<int>(rows_.size()) * kRowHeight) +
+               std::max(0, static_cast<int>(rows_.size()) - 1) * gap);
+  return gfx::Size(S(ui_scale_, 760 + 2 * kShadowInset),
+                   S(ui_scale_, kRailReserve + kSearchHeight + results +
+                                    kFooterHeight + kShadowInset));
+}
+gfx::Rect CommandPanelView::BodyBounds() const {
+  return gfx::Rect(S(ui_scale_, kShadowInset), S(ui_scale_, kRailReserve),
+                   width() - S(ui_scale_, 2 * kShadowInset),
+                   height() - S(ui_scale_, kRailReserve + kShadowInset));
+}
+void CommandPanelView::UpdateGeometry() {
+  if (!GetWidget()) {
+    return;
+  }
+  auto bounds = GetWidget()->GetWindowBoundsInScreen();
+  bounds.set_height(GetPreferredSize().height());
+  GetWidget()->SetBounds(bounds);
+  GetWidget()->GetRootView()->DeprecatedLayoutImmediately();
+  if (geometry_changed_) {
+    geometry_changed_.Run();
+  }
+}
+float CommandPanelView::ScopeRise() const {
+  if (actions_visible_) {
+    return 0;
+  }
+  const auto geometry = GeometryForReveal(appearance_.reveal);
+  return geometry.resting_rise +
+         (geometry.revealed_rise - geometry.resting_rise) *
+             scope_animation_.GetCurrentValue();
+}
+void CommandPanelView::Layout(PassKey) {
+  const auto body = BodyBounds();
+  const int input_inset = 50;
+  input_->SetBounds(body.x() + S(ui_scale_, input_inset),
+                    body.y() + S(ui_scale_, 19),
+                    std::max(1, body.width() - S(ui_scale_, input_inset + 20)),
+                    S(ui_scale_, 23));
+  const int heading = actions_visible_ ? kHeadingHeight : 0;
+  const int gap =
+      appearance_.labels == CommandPanelAppearance::Labels::kJoined ? 5 : 0;
+  const int content_height =
+      S(ui_scale_,
+            (rows_.empty() ? kEmptyHeight
+                           : static_cast<int>(rows_.size()) * kRowHeight) +
+            std::max(0, static_cast<int>(rows_.size()) - 1) * gap);
+  scroll_->SetBounds(body.x() + S(ui_scale_, 8),
+                     body.y() + S(ui_scale_, kSearchHeight + 7 + heading),
+                     body.width() - S(ui_scale_, 16),
+                     body.height() - S(ui_scale_, kSearchHeight + 11 +
+                                                      kFooterHeight + heading));
+  results_view_->SetSize(gfx::Size(scroll_->width(), content_height));
+  for (size_t i = 0; i < row_views_.size(); ++i) {
+    row_views_[i]->SetBounds(0, S(ui_scale_, i * (kRowHeight + gap)),
+                             results_view_->width(), S(ui_scale_, kRowHeight));
+  }
+  // Scroll bounds can be unchanged while a new menu adds overflowing rows.
+  scroll_->DeprecatedLayoutImmediately();
+  if (back_button_) {
+    back_button_->SetBounds(scroll_->x() + S(ui_scale_, 10),
+                            scroll_->y() + S(ui_scale_, 8 - heading),
+                            S(ui_scale_, 28), S(ui_scale_, 28));
+  }
+  const int footer_control = S(ui_scale_, FooterControlWidth(actions_visible_));
+  footer_button_->SetBounds(body.right() - S(ui_scale_, 19) - footer_control,
+                            body.bottom() - S(ui_scale_, 42), footer_control,
+                            S(ui_scale_, 42));
+  std::vector<float> label_spaces(scopes_.size());
+  float total_labels = 0;
+  for (size_t i = 0; i < scopes_.size(); ++i) {
+    label_spaces[i] =
+        ScopeWeight(i) * ScopeLabelProgress() *
+        (gfx::GetStringWidth(scopes_[i].label, Font(11, true)) + 7);
+    total_labels += label_spaces[i];
+  }
+  const auto geometry = GeometryForReveal(appearance_.reveal);
+  const float inset = geometry.flush ? 0 : 24;
+  const float count = std::max<size_t>(1, scopes_.size());
+  const float scope_gap = std::min(
+      8.f, std::max(0.f, (body.width() / ui_scale_ - 2 * inset) / count / 3));
+  const float span = std::max(0.f, body.width() / ui_scale_ - 2 * inset -
+                                       std::max(0.f, count - 1) * scope_gap);
+  const float label_budget =
+      std::max(0.f, span - std::min(16.f, span / count) * count);
+  if (total_labels > label_budget) {
+    const float factor = label_budget / total_labels;
+    for (auto& label : label_spaces) {
+      label *= factor;
+    }
+    total_labels = label_budget;
+  }
+  const float item =
+      appearance_.full_width
+          ? std::max(1.f, (span - total_labels) / count)
+          : std::min(38.f, std::max(1.f, (span - total_labels) / count));
+  float x = body.x() / ui_scale_ + inset;
+  const int top = body.y() - base::ClampRound(ScopeRise() * ui_scale_);
+  const int scope_height =
+      base::ClampRound(ui_scale_ * (geometry.resting_height +
+                                    (42 - geometry.resting_height) *
+                                        scope_animation_.GetCurrentValue()));
+  for (size_t i = 0; i < scope_buttons_.size(); ++i) {
+    const int button_x = base::ClampRound(x * ui_scale_);
+    const float end = x + item + label_spaces[i];
+    const int button_width = base::ClampRound(end * ui_scale_) - button_x;
+    scope_buttons_[i]->SetVisible(!actions_visible_ &&
+                                  (scope_height > 0 || geometry.flush));
+    scope_buttons_[i]->SetBounds(button_x, top, button_width, scope_height);
+    scope_buttons_[i]->GetViewAccessibility().SetIsSelected(scopes_[i].id ==
+                                                            scope_);
+    x = end + scope_gap;
+  }
+  if (const auto* row = SelectedRowView(); !selection_initialized_ && row) {
+    selection_y_ = row->y();
+    previous_selection_y_ = selection_y_;
+    selection_animation_.Reset(1);
+    selection_initialized_ = true;
+  }
+}
+SkPath CommandPanelView::GetPanelContourPath() const {
+  const auto b = BodyBounds();
+  const float radius = 13 * ui_scale_, left = b.x() + .5f,
+              right = b.right() - .5f;
+  const float top = b.y() + .5f, bottom = b.bottom() - .5f;
+  SkPathBuilder path;
+  const auto geometry = GeometryForReveal(appearance_.reveal);
+  if (geometry.flush && appearance_.connected && appearance_.full_width &&
+      !actions_visible_ && !scope_buttons_.empty()) {
+    const float crest = scope_buttons_.front()->y();
+    // The trough stays at its resting height while the whole rail rises.
+    const float valley = b.y() - geometry.detent_height * ui_scale_;
+    const float dip = std::max(0.f, valley - crest);
+    path.moveTo(left + radius, crest);
+    for (size_t i = 0; i + 1 < scope_buttons_.size(); ++i) {
+      const auto* button = scope_buttons_[i].get();
+      const auto* next = scope_buttons_[i + 1].get();
+      const float gap = next->x() - button->bounds().right();
+      const float middle = (button->bounds().right() + next->x()) / 2.f;
+      // Keep equal-radius arcs tangent even when a registry has many narrow
+      // scopes. The six-scope presentation retains the panel's 13px radius.
+      const float trough_radius = std::min(
+          {radius, (std::min(button->width(), next->width()) + gap) / 4,
+           (middle - left - radius) / 2, (right - radius - middle) / 2});
+      if (dip < .01f || trough_radius <= 0) {
+        continue;
+      }
+      const float arc_drop = std::min(trough_radius, dip / 2);
+      const float run =
+          std::sqrt(2 * trough_radius * arc_drop - arc_drop * arc_drop);
+      const SkPoint radii = {trough_radius, trough_radius};
+      path.lineTo(middle - 2 * run, crest)
+          .arcTo(radii, 0, SkPathBuilder::kSmall_ArcSize, SkPathDirection::kCW,
+                 {middle - run, crest + arc_drop})
+          .lineTo(middle - run, valley - arc_drop)
+          .arcTo(radii, 0, SkPathBuilder::kSmall_ArcSize, SkPathDirection::kCCW,
+                 {middle + run, valley - arc_drop})
+          .lineTo(middle + run, crest + arc_drop)
+          .arcTo(radii, 0, SkPathBuilder::kSmall_ArcSize, SkPathDirection::kCW,
+                 {middle + 2 * run, crest});
+    }
+    const SkPoint radii = {radius, radius};
+    path.lineTo(right - radius, crest)
+        .arcTo(radii, 0, SkPathBuilder::kSmall_ArcSize, SkPathDirection::kCW,
+               {right, crest + radius})
+        .lineTo(right, bottom - radius)
+        .arcTo(radii, 0, SkPathBuilder::kSmall_ArcSize, SkPathDirection::kCW,
+               {right - radius, bottom})
+        .lineTo(left + radius, bottom)
+        .arcTo(radii, 0, SkPathBuilder::kSmall_ArcSize, SkPathDirection::kCW,
+               {left, bottom - radius})
+        .lineTo(left, crest + radius)
+        .arcTo(radii, 0, SkPathBuilder::kSmall_ArcSize, SkPathDirection::kCW,
+               {left + radius, crest})
+        .close();
+    return path.detach();
+  }
+  path.moveTo(left + radius, top);
+  if (appearance_.connected && !actions_visible_) {
+    for (const auto& button : scope_buttons_) {
+      const float x = button->x(), y = button->y(),
+                  end = button->bounds().right();
+      if (y >= top - 1) {
+        continue;
+      }
+      const float shoulder = std::min(4 * ui_scale_, (top - y) * .3f);
+      const float cap =
+          std::max(0.f, std::min({radius, (button->width() - 4 * ui_scale_) / 2,
+                                  top - y - shoulder}));
+      path.lineTo(x - shoulder, top)
+          .quadTo(x, top, x, top - shoulder)
+          .lineTo(x, y + cap)
+          .quadTo(x, y, x + cap, y)
+          .lineTo(end - cap, y)
+          .quadTo(end, y, end, y + cap)
+          .lineTo(end, top - shoulder)
+          .quadTo(end, top, end + shoulder, top);
+    }
+  }
+  path.lineTo(right - radius, top)
+      .quadTo(right, top, right, top + radius)
+      .lineTo(right, bottom - radius)
+      .quadTo(right, bottom, right - radius, bottom)
+      .lineTo(left + radius, bottom)
+      .quadTo(left, bottom, left, bottom - radius)
+      .lineTo(left, top + radius)
+      .quadTo(left, top, left + radius, top)
+      .close();
+  return path.detach();
+}
+SkPath CommandPanelView::GetContourPath() const {
+  SkPathBuilder path;
+  path.addPath(GetPanelContourPath());
+  if (!appearance_.connected && !actions_visible_) {
+    for (const auto& button : scope_buttons_) {
+      const float height = BodyBounds().y() + .5f - button->y();
+      if (button->GetVisible() && height > 0) {
+        path.addPath(TopRoundedRectPath(
+            gfx::RectF(button->x(), button->y(), button->width(), height),
+            13 * ui_scale_));
+      }
+    }
+  }
+  return path.detach();
+}
+void CommandPanelView::PaintConnectedScopeGlow(gfx::Canvas* canvas) {
+  if (!appearance_.connected || !appearance_.scope_tints || actions_visible_) {
+    return;
+  }
+  gfx::ScopedCanvas restore(canvas);
+  const auto contour = GetContourPath();
+  canvas->ClipPath(contour, true);
+  const auto geometry = GeometryForReveal(appearance_.reveal);
+  const float y = BodyBounds().y() + (4 - geometry.resting_rise) * ui_scale_;
+  const auto glow = [&](SkColor tint, float x, float spread, float alpha) {
+    if (tint == SK_ColorTRANSPARENT || spread <= 0) {
+      return;
+    }
+    for (const bool tail : {false, true}) {
+      auto matrix = SkMatrix::Scale(spread, (tail ? 96 : 26) * ui_scale_);
+      matrix.postTranslate(x, y - (tail ? 70 * ui_scale_ : 0));
+      const SkColor4f stops[] = {
+          SkColor4f::FromColor(
+              Alpha(tint, base::ClampRound(255 * alpha * appearance_.glow_strength * (tail ? .65f : 1)))),
+          SkColors::kTransparent};
+      cc::PaintFlags flags;
+      flags.setShader(cc::PaintShader::MakeRadialGradient(
+          {0, 0}, 1, stops, nullptr, 2, SkTileMode::kClamp,
+          SkGradient::Interpolation{}, 0, &matrix));
+      canvas->DrawPath(contour, flags);
+    }
+  };
+  for (size_t i = 0; i < scopes_.size(); ++i) {
+    const auto* button = scope_buttons_[i].get();
+    const float x = button->x() + button->width() / 2.f;
+    const float reach = button->width() * .9f;
+    const float alpha = .14f + .08f * ScopeWeight(i);
+    if (scopes_[i].id == kOmniScope) {
+      glow(SkColorSetRGB(181, 158, 205), x - button->width() * .24f,
+           reach * .8f, alpha);
+      glow(SkColorSetRGB(133, 170, 207), x + button->width() * .24f,
+           reach * .8f, alpha);
+      glow(SkColorSetRGB(132, 189, 165), x, reach, alpha * .6f);
+    } else {
+      glow(scopes_[i].tint, x, reach, alpha);
+    }
+  }
+}
+void CommandPanelView::OnPaint(gfx::Canvas* canvas) {
+  const auto body = BodyBounds();
+  cc::PaintFlags fill;
+  fill.setAntiAlias(true);
+  fill.setColor(kPanel);
+  if (!native_material_) {
+    canvas->DrawPath(GetContourPath(), fill);
+  }
+  PaintConnectedScopeGlow(canvas);
+  cc::PaintFlags edge;
+  edge.setAntiAlias(true);
+  edge.setColor(Alpha(SK_ColorWHITE, 54));
+  edge.setStyle(cc::PaintFlags::kStroke_Style);
+  edge.setStrokeWidth(ui_scale_);
+  canvas->DrawPath(GetPanelContourPath(), edge);
+  canvas->FillRect(gfx::Rect(body.x() + S(ui_scale_, 10),
+                             body.y() + S(ui_scale_, kSearchHeight - 1),
+                             body.width() - S(ui_scale_, 20), S(ui_scale_, 1)),
+                   Alpha(SK_ColorWHITE, 21));
+  GlyphAt(canvas, Glyph::kSearch,
+          gfx::Rect(body.x() + S(ui_scale_, 20), body.y() + S(ui_scale_, 22),
+                    S(ui_scale_, 18), S(ui_scale_, 18)),
+          kText);
+  canvas->FillRect(
+      gfx::Rect(body.x() + S(ui_scale_, 10), body.bottom() - S(ui_scale_, 42),
+                body.width() - S(ui_scale_, 20), S(ui_scale_, 1)),
+      Alpha(SK_ColorWHITE, 11));
+  {
+    gfx::ScopedCanvas restore(canvas);
+    canvas->Translate(gfx::Vector2d(body.x() + S(ui_scale_, 19),
+                                    body.bottom() - S(ui_scale_, 42)));
+    canvas->Scale(ui_scale_, ui_scale_);
+    PaintFooter(canvas, base::ClampRound(body.width() / ui_scale_) - 38, 42);
+  }
+  if (actions_visible_) {
+    const int y = scroll_->y() - S(ui_scale_, kHeadingHeight);
+    FillRoundRect(
+        canvas,
+        gfx::Rect(scroll_->x() + S(ui_scale_, 10), y + S(ui_scale_, 8),
+                  S(ui_scale_, 28), S(ui_scale_, 28)),
+        S(ui_scale_, 5), Alpha(SK_ColorWHITE, 9));
+    GlyphAt(canvas, Glyph::kBack,
+            gfx::Rect(scroll_->x() + S(ui_scale_, 15), y + S(ui_scale_, 13),
+                      S(ui_scale_, 18), S(ui_scale_, 18)),
+            kText);
+    canvas->DrawStringRect(
+        MenuBreadcrumb(), Font(S(ui_scale_, 12), true), kText,
+        gfx::Rect(scroll_->x() + S(ui_scale_, 50), y + S(ui_scale_, 8),
+                  scroll_->width() - S(ui_scale_, 60), S(ui_scale_, 28)));
+    canvas->FillRect(
+        gfx::Rect(scroll_->x(), y + S(ui_scale_, kHeadingHeight - 7),
+                  scroll_->width(), S(ui_scale_, 1)),
+        Alpha(SK_ColorWHITE, 11));
+  }
+  if (rows_.empty()) {
+    auto empty_bounds = scroll_->bounds();
+    empty_bounds.Inset(
+        gfx::Insets::TLBR(0, S(ui_scale_, 15), 0, S(ui_scale_, 15)));
+    canvas->DrawStringRect(
+        actions_visible_ ? u"No matching choices" : u"No matching results",
+        Font(S(ui_scale_, 14)), kMuted, empty_bounds);
+  }
+}
+void CommandPanelView::PaintRow(gfx::Canvas* canvas,
+                                size_t index,
+                                int width,
+                                int height) {
+  const auto& row = rows_[index];
+  const auto& data = row.data;
+  const bool selected =
+      static_cast<int>(index) == selected_ && !scope_browsing_;
+  // Selection semantics update immediately. The cue arrives with the moving
+  // highlight, so it cannot announce the destination ahead of that highlight.
+  const float cue_progress = selected ? selection_animation_.GetCurrentValue() : 0;
+  const auto* active_scope = ActiveScope();
+  const SkColor tint =
+      data.tint != SK_ColorTRANSPARENT
+          ? data.tint
+          : (active_scope && active_scope->tint != SK_ColorTRANSPARENT
+                 ? active_scope->tint
+                 : kMuted);
+  const bool joined =
+      appearance_.labels == CommandPanelAppearance::Labels::kJoined;
+  if (joined) {
+    cc::PaintFlags border;
+    border.setAntiAlias(true);
+    border.setStyle(cc::PaintFlags::kStroke_Style);
+    border.setColor(Alpha(SK_ColorWHITE, base::ClampRound(35 + 42 * cue_progress)));
+    border.setStrokeWidth(1);
+    canvas->DrawRoundRect(gfx::Rect(0, 0, width, height), 7, border);
+  }
+  int x = joined ? 8 : 11;
+  if (!row.menu_entry) {
+    if (appearance_.activity_dots) {
+      cc::PaintFlags marker;
+      marker.setAntiAlias(true);
+      marker.setColor(Blend(SkColorSetRGB(170, 205, 188),
+                            SkColorSetRGB(228, 243, 233), cue_progress));
+      const gfx::PointF center(x + 5, height / 2.0f);
+      if (data.activity == CommandActivity::kCircle ||
+          data.activity == CommandActivity::kCircleDot) {
+        marker.setStyle(cc::PaintFlags::kStroke_Style);
+        marker.setStrokeWidth(1);
+        canvas->DrawCircle(center, 4.5f, marker);
+      }
+      if (data.activity == CommandActivity::kDot ||
+          data.activity == CommandActivity::kCircleDot) {
+        marker.setStyle(cc::PaintFlags::kFill_Style);
+        canvas->DrawCircle(center, 3, marker);
+      }
+      x += 14;
+    }
+    const int favicon_size = joined ? 24 : 27;
+    DrawIcon(canvas, data.icon, gfx::Rect(x + 5, (height - 17) / 2, 17, 17),
+             data.kind == CommandRowKind::kTypedSearch ? Glyph::kSearch
+                                                       : Glyph::kGlobe,
+             SkColorSetRGB(184, 203, 220));
+    x += favicon_size + (joined ? 10 : 12);
+  } else {
+    x = 13;
+    if (!data.icon.isNull()) {
+      DrawIcon(canvas, data.icon, gfx::Rect(x, (height - 17) / 2, 17, 17),
+               Glyph::kGo, kMuted);
+      x += 27;
+    }
+  }
+  const int cue_width = joined ? 28 : 24;
+  const std::u16string verb = selected && width >= 330 ? Verb(row) : u"";
+  const int verb_width =
+      verb.empty() ? 0 : gfx::GetStringWidth(verb, Font(12, true)) + 9;
+  const int cue_x = width - (joined ? 0 : 11) - cue_width;
+  const int verb_x = cue_x - verb_width;
+  const int right = verb_x - (verb.empty() ? 0 : 12);
+  const int category_gap = joined ? 20 : 10;
+  const auto category_font = joined ? Font(11) : Font(10, true);
+  const int category_width =
+      row.menu_entry
+          ? 0
+          : std::min(
+                gfx::GetStringWidth(data.category, category_font) +
+                    (appearance_.labels == CommandPanelAppearance::Labels::kPill
+                         ? 12
+                         : 0),
+                std::max(0, (right - x) * 46 / 100));
+  const int available = std::max(
+      1, right - x - category_width - (category_width ? category_gap : 0));
+  const int title_width =
+      std::min(gfx::GetStringWidth(data.title, Font(14, true)), available);
+  const bool subtitle = row.menu_entry && !data.detail.empty();
+  const SkColor title_color =
+      row.menu_entry && !row.menu_entry->enabled ? kMuted : kText;
+  canvas->DrawStringRect(
+      data.title, Font(14, true), title_color,
+      gfx::Rect(x, subtitle ? 2 : 0, title_width, subtitle ? 22 : height));
+  if (subtitle) {
+    canvas->DrawStringRect(data.detail, Font(10), kMuted,
+                           gfx::Rect(x, 22, available, 17));
+  }
+  if (category_width) {
+    const int label_x = x + title_width + category_gap;
+    if (appearance_.labels == CommandPanelAppearance::Labels::kPill) {
+      FillRoundRect(
+          canvas, gfx::Rect(label_x, (height - 18) / 2, category_width, 18), 4,
+          Alpha(appearance_.scope_tints ? tint : SK_ColorWHITE,
+                appearance_.scope_tints ? (selected ? 31 : 20)
+                                        : (selected ? 10 : 4)));
+    }
+    if (joined) {
+      canvas->FillRect(gfx::Rect(label_x - 10, (height - 13) / 2, 1, 13),
+                       Alpha(SK_ColorWHITE, 46));
+    }
+    canvas->DrawStringRect(
+        data.category, category_font,
+        appearance_.scope_tints
+            ? Mix(tint, selected ? SkColorSetRGB(214, 227, 224) : tint)
+            : (selected ? SkColorSetRGB(214, 227, 224) : kMuted),
+        gfx::Rect(
+            label_x +
+                (appearance_.labels == CommandPanelAppearance::Labels::kPill
+                     ? 6
+                     : 0),
+            0,
+            category_width -
+                (appearance_.labels == CommandPanelAppearance::Labels::kPill
+                     ? 12
+                     : 0),
+            height));
+  }
+  if (verb_width > 9) {
+    canvas->DrawStringRect(verb, Font(12, true), kText,
+                           gfx::Rect(verb_x, 0, verb_width - 9, height));
+  }
+  SkColor cue_color = Blend(SkColorSetRGB(160, 170, 167),
+                            SkColorSetRGB(225, 232, 229), cue_progress);
+  if (appearance_.scope_tints) {
+    cue_color = Mix(tint, cue_color);
+  }
+  if (!appearance_.scope_tints && !joined) {
+    cue_color = Blend(cue_color, SkColorSetRGB(81, 101, 106), cue_progress);
+    FillRoundRect(canvas, gfx::Rect(cue_x, (height - 23) / 2, cue_width, 23), 4,
+                  Blend(Alpha(SK_ColorWHITE, 10), SkColorSetRGB(237, 243, 239),
+                        cue_progress));
+  }
+  if (row.menu_entry) {
+    if (!row.menu_entry->submenu_id.empty()) {
+      canvas->DrawStringRect(u"›", Font(22), cue_color,
+                             gfx::Rect(cue_x, 0, cue_width, height));
+    } else {
+      GlyphAt(
+          canvas, Glyph::kGo,
+          gfx::Rect(cue_x + (cue_width - 17) / 2, (height - 17) / 2, 17, 17),
+          cue_color);
+    }
+  } else if (appearance_.icons == CommandPanelAppearance::Icons::kReturn) {
+    if (selected) {
+      canvas->DrawStringRect(u"↵", Font(18),
+                             Alpha(cue_color, base::ClampRound(255 * cue_progress)),
+                             gfx::Rect(cue_x, 0, cue_width, height));
+    }
+  } else if (appearance_.icons == CommandPanelAppearance::Icons::kArrows) {
+    canvas->DrawStringRect(u"→", Font(18),
+                           Alpha(cue_color, base::ClampRound(255 * (1 - cue_progress))),
+                           gfx::Rect(cue_x, 0, cue_width, height));
+    if (selected) {
+      canvas->DrawStringRect(u"↵", Font(18),
+                             Alpha(cue_color, base::ClampRound(255 * cue_progress)),
+                             gfx::Rect(cue_x, 0, cue_width, height));
+    }
+  } else {
+    Glyph glyph =
+        data.primary_icon == CommandPrimaryIcon::kSwitch   ? Glyph::kSwitch
+        : data.primary_icon == CommandPrimaryIcon::kAction ? Glyph::kMove
+                                                           : Glyph::kGo;
+    if (appearance_.icons == CommandPanelAppearance::Icons::kActions &&
+        data.kind == CommandRowKind::kTypedSearch) {
+      glyph = Glyph::kSearch;
+    }
+    GlyphAt(canvas, glyph,
+            gfx::Rect(cue_x + (cue_width - 17) / 2, (height - 17) / 2, 17, 17),
+            cue_color);
+  }
+}
+void CommandPanelView::PaintScope(gfx::Canvas* canvas,
+                                  size_t index,
+                                  int width,
+                                  int height) {
+  const auto& scope = scopes_[index];
+  const float weight = ScopeWeight(index);
+  if (!appearance_.connected) {
+    cc::PaintFlags edge;
+    edge.setAntiAlias(true);
+    edge.setColor(Alpha(SK_ColorWHITE, base::ClampRound(36 + 20 * weight)));
+    edge.setStyle(cc::PaintFlags::kStroke_Style);
+    edge.setStrokeWidth(1);
+    canvas->DrawPath(TopRoundedRectPath(
+        gfx::RectF(.5f, .5f, width - 1, height - 1), 13), edge);
+  }
+  if (appearance_.scope_tints && !appearance_.connected) {
+    cc::PaintFlags glow;
+    if (scope.id == kOmniScope) {
+      constexpr std::array<float, 3> centers = {.5f, .88f, .12f};
+      constexpr std::array<SkColor, 3> colors = {SkColorSetRGB(132, 189, 165),
+                                                 SkColorSetRGB(133, 170, 207),
+                                                 SkColorSetRGB(181, 158, 205)};
+      for (size_t i = 0; i < colors.size(); ++i) {
+        const float fade = i == 0 ? .9f : .85f;
+        auto matrix = SkMatrix::Scale(width * (i == 0 ? .6f : .65f) * fade,
+                                      height * fade);
+        matrix.postTranslate(width * centers[i], 0);
+        const SkColor4f stops[] = {
+            SkColor4f::FromColor(Alpha(colors[i], base::ClampRound((46 + 25 * weight) * appearance_.glow_strength))),
+            SkColors::kTransparent};
+        glow.setShader(cc::PaintShader::MakeRadialGradient(
+            {0, 0}, 1, stops, nullptr, 2, SkTileMode::kClamp,
+            SkGradient::Interpolation{}, 0, &matrix));
+        canvas->DrawRect(gfx::Rect(0, 0, width, height), glow);
+      }
+    } else {
+      const auto tint = scope.tint;
+      const SkPoint points[] = {{0, 0}, {0, static_cast<float>(height)}};
+      const SkScalar positions[] = {0, .7f, 1};
+      const SkColor4f colors[] = {
+          SkColor4f::FromColor(Alpha(tint, base::ClampRound((40 + 25 * weight) * appearance_.glow_strength))),
+          SkColor4f::FromColor(Alpha(tint, base::ClampRound((20 + 13 * weight) * appearance_.glow_strength))),
+          SkColors::kTransparent};
+      glow.setShader(cc::PaintShader::MakeLinearGradient(
+          points, colors, positions, 3, SkTileMode::kClamp));
+      canvas->DrawRect(gfx::Rect(0, 0, width, height), glow);
+    }
+  }
+  const auto geometry = GeometryForReveal(appearance_.reveal);
+  const float progress = scope_animation_.GetCurrentValue();
+  const float icon_opacity =
+      geometry.icons_hidden ? scope_icon_animation_.GetCurrentValue() : 1;
+  const float label_progress = weight * ScopeLabelProgress();
+  const int label = std::min(
+      std::max(0, width - 23),
+      base::ClampRound(label_progress *
+                       (gfx::GetStringWidth(scope.label, Font(11, true)) + 7)));
+  const int x = (width - 16 - label) / 2;
+  const Glyph glyph = scope.id == kOmniScope ? Glyph::kOmni : Glyph::kGlobe;
+  const auto color = SkColorSetRGB(131 + base::ClampRound(97 * weight),
+                                   148 + base::ClampRound(90 * weight),
+                                   141 + base::ClampRound(91 * weight));
+  const int icon_y = base::ClampRound(
+      geometry.resting_padding + (8 - geometry.resting_padding) * progress);
+  if (icon_opacity > 0) {
+    canvas->SaveLayerAlpha(base::ClampRound(icon_opacity * 255),
+                           gfx::Rect(x, icon_y, 16, 16));
+    DrawIcon(canvas, scope.icon, gfx::Rect(x, icon_y, 16, 16), glyph, color);
+    canvas->Restore();
+  }
+  if (label) {
+    canvas->DrawStringRect(
+        scope.label, Font(11, true),
+        Alpha(color, base::ClampRound(255 * label_progress)),
+        gfx::Rect(x + 23, icon_y, std::max(1, label - 7), 16));
+  }
+}
+void CommandPanelView::PaintFooter(gfx::Canvas* canvas, int width, int height) {
+  std::u16string hint;
+  if (!feedback_.empty()) {
+    hint = feedback_;
+  } else if (scope_browsing_) {
+    hint = u"← → / Tab scope  ↓ results  ↵ ";
+    hint +=
+        !input_->GetText().empty() && !current_context_ ? u"search" : u"type";
+  } else {
+    if (selected_ == 0 && !actions_visible_) {
+      hint = u"← → / Tab scopes · ";
+    }
+    hint += u"↑ ↓ choose ↵ ";
+    if (actions_visible_) {
+      hint += rows_.empty() ? u"no matching choices" : u"choose an action";
+    } else if (const auto* row = SelectedRow()) {
+      hint += base::i18n::ToLower(Verb(*row));
+    } else {
+      hint += rows_.empty() ? u"no matches" : u"choose a result";
+    }
+  }
+  canvas->DrawStringRect(
+      hint, Font(11), kMuted,
+      gfx::Rect(0, 0,
+                std::max(1, width - FooterControlWidth(actions_visible_) - 15),
+                height));
+}
+void CommandPanelView::Select(int index,
+                              bool animate,
+                              bool preserve_animation) {
+  if (animate && !rows_.empty()) {
+    selection_explicit_ = true;
+  }
+  if (rows_.empty() || index < 0) {
+    index = -1;
+  } else {
+    index = std::clamp(index, 0, static_cast<int>(rows_.size()) - 1);
+    selection_missing_ = false;
+    pending_selection_key_.clear();
+  }
+
+  const float current_y =
+      previous_selection_y_ + (selection_y_ - previous_selection_y_) *
+                                  selection_animation_.GetCurrentValue();
+  selected_ = index;
+  const float next_y = index >= 0 && index < static_cast<int>(row_views_.size())
+                           ? row_views_[index]->y()
+                           : selection_y_;
+  if (!preserve_animation || next_y != selection_y_) {
+    previous_selection_y_ = current_y;
+    selection_y_ = next_y;
+    const bool moving = (animate || preserve_animation) &&
+                        gfx::Animation::ShouldRenderRichAnimation();
+    selection_animation_.Reset(moving ? 0 : 1);
+    if (moving) {
+      selection_animation_.Show();
+    }
+  }
+  for (size_t i = 0; i < row_views_.size(); ++i) {
+    row_views_[i]->GetViewAccessibility().SetIsSelected(
+        static_cast<int>(i) == selected_ && !scope_browsing_);
+    row_views_[i]->SchedulePaint();
+  }
+  if (scope_browsing_ && !scope_buttons_.empty()) {
+    input_->GetViewAccessibility().SetActiveDescendant(
+        *scope_buttons_[ScopeIndex(scope_)]);
+  } else if (auto* row = SelectedRowView(); !scope_browsing_ && row) {
+    input_->GetViewAccessibility().SetActiveDescendant(*row);
+    row->ScrollRectToVisible(row->GetLocalBounds());
+  } else {
+    input_->GetViewAccessibility().ClearActiveDescendant();
+  }
+  results_view_->SchedulePaint();
+  footer_button_->SchedulePaint();
+  SchedulePaint();
+}
+void CommandPanelView::HoverRow(int index) {
+  if (hovered_ == index) {
+    return;
+  }
+  hovered_ = index;
+  results_view_->SchedulePaint();
+}
+float CommandPanelView::ScopeWeight(size_t index) const {
+  const float progress = scope_selection_animation_.GetCurrentValue();
+  const float previous = previous_scope_weights_[index];
+  return previous +
+         ((scopes_[index].id == scope_ ? 1 : 0) - previous) * progress;
+}
+float CommandPanelView::ScopeLabelProgress() const {
+  return appearance_.reveal == CommandPanelAppearance::Reveal::kTabs
+             ? 1
+             : scope_label_animation_.GetCurrentValue();
+}
+void CommandPanelView::UpdateScopeReveal() {
+  const bool show = !actions_visible_ && (scope_browsing_ || scope_hovered_);
+  if (!gfx::Animation::ShouldRenderRichAnimation()) {
+    scope_animation_.Reset(show ? 1 : 0);
+    scope_label_animation_.Reset(show ? 1 : 0);
+    scope_icon_animation_.Reset(show ? 1 : 0);
+  } else if (show) {
+    scope_animation_.Show();
+    scope_label_animation_.Show();
+    scope_icon_animation_.Show();
+  } else {
+    scope_animation_.Hide();
+    scope_label_animation_.Hide();
+    scope_icon_animation_.Hide();
+  }
+  AnimationProgressed(&scope_animation_);
+}
+void CommandPanelView::BrowseScopes(bool enabled) {
+  scope_browsing_ = enabled;
+  scope_hide_timer_.Stop();
+  if (enabled && !scope_buttons_.empty()) {
+    input_->GetViewAccessibility().SetActiveDescendant(
+        *scope_buttons_[ScopeIndex(scope_)]);
+  }
+  UpdateScopeReveal();
+  Select(selected_ < 0 && !selection_missing_ ? 0 : selected_, false);
+}
+void CommandPanelView::HoverScopes(bool enabled) {
+  scope_hovered_ = enabled;
+  scope_hide_timer_.Stop();
+  if (enabled || scope_browsing_ ||
+      !gfx::Animation::ShouldRenderRichAnimation()) {
+    UpdateScopeReveal();
+  } else {
+    scope_hide_timer_.Start(FROM_HERE, base::Milliseconds(100),
+        base::BindOnce(&CommandPanelView::UpdateScopeReveal, base::Unretained(this)));
+  }
+}
+void CommandPanelView::ChooseScope(CommandScopeId scope) {
+  if (actions_visible_) {
+    ShowActions(false);
+  }
+  for (size_t i = 0; i < scopes_.size(); ++i) {
+    previous_scope_weights_[i] = ScopeWeight(i);
+  }
+  scope_ = scope;
+  scope_selection_animation_.Reset(
+      gfx::Animation::ShouldRenderRichAnimation() ? 0 : 1);
+  if (gfx::Animation::ShouldRenderRichAnimation()) {
+    scope_selection_animation_.Show();
+  }
+  selected_ = 0;
+  selection_explicit_ = false;
+  selection_missing_ = false;
+  pending_selection_key_.clear();
+  current_context_ = false;
+  RebuildResults();
+  BrowseScopes(true);
+  RevealContent(1);
+  FocusInput();
+}
+void CommandPanelView::RevealContent(int direction) {
+  content_direction_ = direction;
+  content_animation_.Reset(gfx::Animation::ShouldRenderRichAnimation() ? 0 : 1);
+  if (gfx::Animation::ShouldRenderRichAnimation()) {
+    content_animation_.Show();
+  }
+}
+bool CommandPanelView::HandleScopeScroll(float vertical_delta) {
+  if (actions_visible_ || scroll_->CurrentOffset().y() > 0) {
+    return false;
+  }
+  if (vertical_delta > 0 && !scope_browsing_) {
+    BrowseScopes(true);
+    return true;
+  }
+  if (vertical_delta < 0 && scope_browsing_) {
+    BrowseScopes(false);
+    Select(selected_, false);
+    return true;
+  }
+  return false;
+}
+bool CommandPanelView::HandleScopeScroll(const ui::ScrollEvent& event) {
+  return event.type() == ui::EventType::kScroll &&
+         event.momentum_phase() != ui::EventMomentumPhase::BEGAN &&
+         event.momentum_phase() != ui::EventMomentumPhase::INERTIAL_UPDATE &&
+         HandleScopeScroll(event.y_offset());
+}
+std::u16string CommandPanelView::MenuBreadcrumb() const {
+  std::u16string breadcrumb;
+  for (const auto& frame : menu_stack_) {
+    if (!breadcrumb.empty()) {
+      breadcrumb += u" › ";
+    }
+    breadcrumb += frame.menu.title;
+  }
+  return breadcrumb;
+}
+bool CommandPanelView::OpenMenuForRow(const DisplayRow& row,
+                                      std::string_view menu_id) {
+  const bool saved_context = current_context_;
+  const bool saved_scopes = scope_browsing_;
+  const auto saved_search = CaptureInputState();
+  const CommandTarget target = row.data.target;
+  const uint64_t request = ++request_generation_;
+  const auto weak = weak_ptr_factory_.GetWeakPtr();
+  auto menu = session_->ResolveActions(target, menu_id, u"");
+  if (!weak || request != request_generation_) {
+    return false;
+  }
+  ++action_resolutions_;
+  session_->Cancel();
+  if (!weak || request != request_generation_) {
+    return false;
+  }
+  saved_context_ = saved_context;
+  saved_scopes_ = saved_scopes;
+  saved_search_ = saved_search;
+  action_target_ = target;
+  menu_stack_.push_back({std::move(menu), {}});
+  actions_visible_ = true;
+  scope_browsing_ = false;
+  const base::AutoReset<bool> update_guard(&updating_, true);
+  input_->SetText(u"");
+  input_->ClearEditHistory();
+  selected_ = 0;
+  selection_explicit_ = false;
+  selection_missing_ = false;
+  pending_selection_key_.clear();
+  RebuildMenuRows(false);
+  UpdateScopeReveal();
+  RevealContent(1);
+  FocusInput();
+  return true;
+}
+void CommandPanelView::ShowActions(bool enabled) {
+  if (enabled == actions_visible_) {
+    return;
+  }
+  if (enabled) {
+    const auto* selected = SelectedRow();
+    if (!selected || !selected->data.has_actions) {
+      return;
+    }
+    const auto row = *selected;
+    if (!OpenMenuForRow(row, "")) {
+      return;
+    }
+  } else {
+    actions_visible_ = false;
+    menu_stack_.clear();
+    action_target_.reset();
+    RestoreInputState(saved_search_);
+    current_context_ = saved_context_;
+    scope_browsing_ = saved_scopes_;
+    pending_selection_key_ = saved_search_.selection_key;
+    publication_.reset();
+    rows_.clear();
+    RebuildViews();
+    RebuildResults();
+  }
+  feedback_.clear();
+  GetViewAccessibility().SetDescription(u"");
+  UpdateScopeReveal();
+  RevealContent(enabled ? 1 : -1);
+  FocusInput();
+}
+void CommandPanelView::OpenSubmenu(const CommandMenuEntry& entry) {
+  CHECK(action_target_);
+  const auto parent_input = CaptureInputState();
+  const CommandTarget target = *action_target_;
+  const std::string submenu_id = entry.submenu_id;
+  const uint64_t request = ++request_generation_;
+  const auto weak = weak_ptr_factory_.GetWeakPtr();
+  auto menu = session_->ResolveActions(target, submenu_id, u"");
+  if (!weak || request != request_generation_) {
+    return;
+  }
+  ++action_resolutions_;
+  menu_stack_.back().input = parent_input;
+  menu_stack_.push_back({std::move(menu), {}});
+  const base::AutoReset<bool> update_guard(&updating_, true);
+  input_->SetText(u"");
+  selected_ = 0;
+  selection_explicit_ = false;
+  selection_missing_ = false;
+  pending_selection_key_.clear();
+  RebuildMenuRows(false);
+  RevealContent(1);
+  FocusInput();
+}
+void CommandPanelView::BackMenu() {
+  if (menu_stack_.size() <= 1) {
+    ShowActions(false);
+    return;
+  }
+  ++request_generation_;
+  menu_stack_.pop_back();
+  const auto state = menu_stack_.back().input;
+  RestoreInputState(state);
+  pending_selection_key_ = state.selection_key;
+  if (!RefreshCurrentMenu(true)) {
+    return;
+  }
+  RevealContent(-1);
+  FocusInput();
+}
+void CommandPanelView::Activate(int index, int event_flags) {
+  if (index < 0 || index >= static_cast<int>(rows_.size())) {
+    return;
+  }
+  if (scope_browsing_) {
+    BrowseScopes(false);
+  }
+  Select(index, false);
+  const DisplayRow row = rows_[index];
+  if (!row.menu_entry && !row.data.primary_submenu_id.empty()) {
+    OpenMenuForRow(row, row.data.primary_submenu_id);
+    return;
+  }
+  CommandIntent intent;
+  if (row.menu_entry) {
+    if (!row.menu_entry->enabled) {
+      return;
+    }
+    if (!row.menu_entry->submenu_id.empty()) {
+      OpenSubmenu(*row.menu_entry);
+      return;
+    }
+    if (!row.menu_entry->intent) {
+      return;
+    }
+    intent = *row.menu_entry->intent;
+  } else {
+    intent.provider_id = row.data.provider_id;
+    intent.action_id = row.data.primary_action_id;
+    intent.target = row.data.target;
+    intent.query = requested_query_;
+  }
+  intent.event_flags = event_flags;
+  const auto weak = weak_ptr_factory_.GetWeakPtr();
+  const uint64_t request = request_generation_;
+  const auto outcome = session_->Execute(intent);
+  if (!weak || request != request_generation_) {
+    return;
+  }
+  if (outcome.dismiss) {
+    dismiss_.Run();
+    return;
+  }
+  if (outcome.success && actions_visible_ && !RefreshCurrentMenu(true)) {
+    return;
+  }
+  feedback_ = outcome.feedback;
+  GetViewAccessibility().SetDescription(feedback_);
+  footer_button_->SchedulePaint();
+  FocusInput();
+}
+bool CommandPanelView::HandleKeyEvent(views::Textfield*,
+                                      const ui::KeyEvent& event) {
+  if (event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  const auto code = event.key_code();
+  if ((event.IsCommandDown() || event.IsControlDown()) && code == ui::VKEY_K) {
+    ShowActions(!actions_visible_);
+    return true;
+  }
+  if ((event.IsCommandDown() || event.IsControlDown()) &&
+      (code == ui::VKEY_T || code == ui::VKEY_L)) {
+    reopen_.Run(code == ui::VKEY_T);
+    return true;
+  }
+  if (code == ui::VKEY_ESCAPE) {
+    if (scope_browsing_) {
+      BrowseScopes(false);
+    } else if (actions_visible_) {
+      BackMenu();
+    } else {
+      dismiss_.Run();
+    }
+    return true;
+  }
+  if (!event.IsCommandDown() && !event.IsControlDown() && !event.IsAltDown() &&
+      (code == ui::VKEY_LEFT || code == ui::VKEY_RIGHT || code == ui::VKEY_TAB)) {
+    if (actions_visible_) {
+      ShowActions(false);
+    }
+    const bool forward = code == ui::VKEY_RIGHT ||
+                         (code == ui::VKEY_TAB && !event.IsShiftDown());
+    if (scopes_.empty()) {
+      return true;
+    }
+    const size_t current = ScopeIndex(scope_);
+    const size_t next =
+        (current + (forward ? 1 : scopes_.size() - 1)) % scopes_.size();
+    ChooseScope(scopes_[next].id);
+    return true;
+  }
+  if (scope_browsing_) {
+    if (code == ui::VKEY_DOWN || code == ui::VKEY_RETURN) {
+      const int result = code == ui::VKEY_DOWN && selected_ < 0 ? 0 : selected_;
+      BrowseScopes(false);
+      Select(result, false);
+      selection_explicit_ = !rows_.empty();
+      if (code == ui::VKEY_RETURN &&
+          !base::TrimWhitespace(input_->GetText(), base::TRIM_ALL).empty() &&
+          !current_context_) {
+        Activate(result, event.flags());
+      }
+      return true;
+    }
+    if (code == ui::VKEY_UP) {
+      return true;
+    }
+  }
+  if (code == ui::VKEY_UP && selected_ <= 0 && !actions_visible_) {
+    BrowseScopes(true);
+    return true;
+  }
+  if (code == ui::VKEY_DOWN || code == ui::VKEY_UP) {
+    Select(selected_ + (code == ui::VKEY_DOWN ? 1 : -1), true);
+    return true;
+  }
+  if (code == ui::VKEY_RETURN) {
+    Activate(selected_, event.flags());
+    return true;
+  }
+  return false;
+}
+bool CommandPanelView::OnMousePressed(const ui::MouseEvent& event) {
+  if (!GetContourPath().contains(event.x(), event.y())) {
+    dismiss_.Run();
+    return true;
+  }
+  return false;
+}
+bool CommandPanelView::OnMouseWheel(const ui::MouseWheelEvent& event) {
+  return HandleScopeScroll(event.y_offset()) || views::View::OnMouseWheel(event);
+}
+void CommandPanelView::OnScrollEvent(ui::ScrollEvent* event) {
+  if (event->type() != ui::EventType::kScroll || event->y_offset() == 0) {
+    views::View::OnScrollEvent(event);
+    return;
+  }
+  HandleScopeScroll(*event);
+  // Input and footer chrome do not scroll vertically. Preserve native precision
+  // here, and prevent rejected momentum from returning as a wheel event.
+  event->SetHandled();
+  event->StopPropagation();
+}
+void CommandPanelView::AnimationProgressed(const gfx::Animation* animation) {
+  const bool scope_geometry = animation == &scope_animation_ ||
+                              animation == &scope_label_animation_ ||
+                              animation == &scope_selection_animation_;
+  if (scope_geometry) {
+    InvalidateLayout();
+    if (GetWidget()) {
+      GetWidget()->GetRootView()->DeprecatedLayoutImmediately();
+    }
+    if (geometry_changed_) {
+      geometry_changed_.Run();
+    }
+  }
+  if (scope_geometry || animation == &scope_icon_animation_) {
+    for (const auto& button : scope_buttons_) {
+      button->SchedulePaint();
+    }
+  }
+  for (const auto& row : row_views_) {
+    row->SchedulePaint();
+  }
+  results_view_->SchedulePaint();
+  SchedulePaint();
+}
+void CommandPanelView::AnimationEnded(const gfx::Animation* animation) {
+  AnimationProgressed(animation);
+}
