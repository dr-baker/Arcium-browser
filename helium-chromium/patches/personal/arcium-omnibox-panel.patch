+void CommandPanelView::FocusInput() {
+  input_->RequestFocus();
+}
+void CommandPanelView::SetInvocation(bool new_tab) {
+  ++request_generation_;
+  session_->Cancel();
+  session_->SetInvocation(new_tab ? CommandInvocationMode::kNewTab
+                                  : CommandInvocationMode::kCurrentTab);
+  const base::AutoReset<bool> update_guard(&updating_, true);
+  current_context_ = !new_tab;
+  invocation_prefill_pending_ = !new_tab;
+  scope_ = kOmniScope;
+  actions_visible_ = false;
+  menu_stack_.clear();
+  action_target_.reset();
+  pending_selection_key_.clear();
+  publication_.reset();
+  rows_.clear();
+  SyncScopes(session_->GetScopes());
+  scope_browsing_ = false;
+  scope_hovered_ = false;
+  scope_hide_timer_.Stop();
+  scope_animation_.Reset(0);
+  scope_label_animation_.Reset(0);
+  scope_icon_animation_.Reset(0);
+  previous_scope_weights_.assign(scopes_.size(), 0);
+  if (!scopes_.empty()) {
+    previous_scope_weights_[ScopeIndex(scope_)] = 1;
+  }
+  scope_selection_animation_.Reset(1);
+  content_animation_.Reset(1);
+  hovered_ = -1;
+  selected_ = 0;
+  selection_explicit_ = false;
+  selection_missing_ = false;
+  input_->SetText(u"");
+  input_->SelectAll(false);
+  feedback_.clear();
+  GetViewAccessibility().SetDescription(u"");
+  RebuildViews();
+  RebuildResults();
+  FocusInput();
+}
+void CommandPanelView::SetAppearance(CommandPanelAppearance appearance) {
+  if (appearance_ == appearance) {
+    return;
+  }
+  appearance_ = appearance;
+  UpdateScopeReveal();
