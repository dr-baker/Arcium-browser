+  panel()->GetViewAccessibility().GetAccessibleNodeData(&data);
+  EXPECT_TRUE(
+      data.GetString16Attribute(ax::mojom::StringAttribute::kDescription)
+          .empty());
+  EXPECT_EQ(0, dismissals_);
+}
+TEST_F(ArciumNativePanelTest, RepeatedInvocationsReuseOnlyTheHiddenPresenter) {
+  for (int i = 0; i < 12; ++i) {
+    Open();
+    auto* widget = panel()->GetWidget();
+    Open(false);
+    EXPECT_EQ(widget, panel()->GetWidget());
+    EXPECT_FALSE(panel()->input_for_testing()->GetText().empty());
+    Open();
+    EXPECT_TRUE(panel()->input_for_testing()->GetText().empty());
+    EXPECT_FALSE(widget_->IsVisible());
+    Close();
+  }
+}
