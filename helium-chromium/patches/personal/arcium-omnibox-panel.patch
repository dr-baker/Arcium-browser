+SkPath TopRoundedRectPath(const gfx::RectF& rect, float radius) {
+  radius = std::min({radius, rect.width() / 2, rect.height()});
+  SkPathBuilder path;
+  path.moveTo(rect.x(), rect.bottom())
+      .lineTo(rect.x(), rect.y() + radius)
+      .quadTo(rect.x(), rect.y(), rect.x() + radius, rect.y())
+      .lineTo(rect.right() - radius, rect.y())
+      .quadTo(rect.right(), rect.y(), rect.right(), rect.y() + radius)
+      .lineTo(rect.right(), rect.bottom())
+      .close();
+  return path.detach();
+}
