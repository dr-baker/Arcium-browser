+class CommandPanelView::ResultsScrollView : public views::ScrollView {
+  METADATA_HEADER(ResultsScrollView, views::ScrollView)
+ public:
+  explicit ResultsScrollView(CommandPanelView* panel) : panel_(panel) {}
+  bool OnMouseWheel(const ui::MouseWheelEvent& event) override {
+    return panel_->HandleScopeScroll(event.y_offset()) ||
+           ScrollView::OnMouseWheel(event);
+  }
+  void OnScrollEvent(ui::ScrollEvent* event) override {
+    // Native trackpad events must reach scope reveal before compositor scrolling
+    // consumes them, including at the top boundary.
+    if (panel_->HandleScopeScroll(*event)) {
+      event->SetHandled();
+      event->StopPropagation();
+      return;
+    }
+    ScrollView::OnScrollEvent(event);
+    if (event->type() == ui::EventType::kScroll && !event->handled()) {
+      // Keep the wheel fallback local: Widget's conversion loses momentum phase
+      // and would retry the scope policy instead of only scrolling results.
+      ui::MouseWheelEvent wheel(*event);
+      ScrollView::OnMouseWheel(wheel);
+      event->SetHandled();
+      event->StopPropagation();
+    }
+  }
+
+ private:
+  raw_ptr<CommandPanelView> panel_;
+};
