+          .lineTo(14.7f, 8.8f)
+          .lineTo(21, 9.6f)
+          .lineTo(16.4f, 14.1f)
+          .lineTo(17.5f, 20.4f)
+          .lineTo(12, 17.4f)
+          .lineTo(6.5f, 20.4f)
+          .lineTo(7.6f, 14.1f)
+          .lineTo(3, 9.6f)
+          .lineTo(9.3f, 8.8f)
+          .close();
+      break;
+    case Glyph::kVideo:
+      canvas->DrawRoundRect(gfx::Rect(3, 5, 18, 14), 4, flags);
+      path.moveTo(10, 9).lineTo(15, 12).lineTo(10, 15).close();
+      break;
+    case Glyph::kX:
+      path.moveTo(5, 3)
+          .lineTo(9, 3)
+          .lineTo(19, 21)
+          .lineTo(15, 21)
+          .close()
