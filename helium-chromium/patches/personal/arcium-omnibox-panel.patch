+      FillRoundRect(canvas, gfx::Rect(0, 0,
+          base::ClampRound(width() / panel_->ui_scale_),
+          base::ClampRound(height() / panel_->ui_scale_)), 13,
+          Alpha(SK_ColorWHITE, GetState() == STATE_PRESSED ? 16 : 7));
+    }
+    panel_->PaintScope(canvas, index_,
+                       base::ClampRound(width() / panel_->ui_scale_),
+                       base::ClampRound(height() / panel_->ui_scale_));
+  }
+
+ private:
+  raw_ptr<CommandPanelView> panel_;
+  size_t index_;
+};
