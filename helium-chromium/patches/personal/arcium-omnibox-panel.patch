+    const int w = base::ClampRound(width() / panel_->ui_scale_);
+    const int h = base::ClampRound(height() / panel_->ui_scale_);
+    const float progress = panel_->content_animation_.GetCurrentValue();
+    canvas->Translate(gfx::Vector2d(0, base::ClampRound(
+        5 * panel_->content_direction_ * (1 - progress))));
+    canvas->SaveLayerAlpha(base::ClampRound(255 * (.35f + .65f * progress)),
+                           gfx::Rect(0, 0, w, h));
+    if (GetState() == STATE_PRESSED) {
+      FillRoundRect(canvas, gfx::Rect(0, 0, w, h), 6,
+                    Alpha(SK_ColorWHITE, 16));
+    }
+    panel_->PaintRow(canvas, index_, w, h);
+    canvas->Restore();
+  }
+
+ private:
+  raw_ptr<CommandPanelView> panel_;
+  size_t index_;
+};
+void CommandPanelView::ResultsView::OnPaint(gfx::Canvas* canvas) {
+  if (panel_->hovered_ >= 0 &&
+      panel_->hovered_ < static_cast<int>(panel_->row_views_.size()) &&
+      (panel_->hovered_ != panel_->selected_ || panel_->scope_browsing_)) {
+    FillRoundRect(canvas, panel_->row_views_[panel_->hovered_]->bounds(),
+                  6 * panel_->ui_scale_, Alpha(SK_ColorWHITE, 12));
+  }
+  if (!panel_->SelectedRowView() || panel_->scope_browsing_) {
+    return;
+  }
+  const float y = panel_->previous_selection_y_ +
+                  (panel_->selection_y_ - panel_->previous_selection_y_) *
+                      panel_->selection_animation_.GetCurrentValue();
+  FillRoundRect(canvas,
+                gfx::RectF(0, y, width(), S(panel_->ui_scale_, kRowHeight)),
+                6 * panel_->ui_scale_, kSelection);
+  if (panel_->appearance_.labels != CommandPanelAppearance::Labels::kJoined) {
+    cc::PaintFlags edge;
+    edge.setAntiAlias(true);
+    edge.setStyle(cc::PaintFlags::kStroke_Style);
+    edge.setStrokeWidth(panel_->ui_scale_);
+    edge.setColor(Alpha(SkColorSetRGB(169, 201, 193), 28));
+    gfx::RectF bounds(0, y, width(), S(panel_->ui_scale_, kRowHeight));
+    bounds.Inset(.5f * panel_->ui_scale_);
+    canvas->DrawRoundRect(bounds, 6 * panel_->ui_scale_, edge);
+  }
+}
