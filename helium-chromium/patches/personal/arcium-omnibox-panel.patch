+  std::vector<std::u16string> menu_queries;
+  std::vector<CommandTarget> menu_targets;
+  std::map<std::string, CommandMenu> extra_menus;
+  bool late_action = false;
+  bool defer_search = false;
+  bool mute_menu = false;
+  bool muted = false;
+  bool target_missing = false;
+  bool remove_target_on_execute = false;
+  bool dismiss_on_execute = false;
+  base::RepeatingClosure execute_hook;
+  base::RepeatingClosure resolve_hook;
+  size_t cancels = 0;
+  uint64_t epoch = 0;
+};
+std::shared_ptr<FakeState> TestState() {
+  auto state = std::make_shared<FakeState>();
+  const auto pin = [](std::string id) -> CommandTarget {
+    return CommandPersistentTarget{CommandPersistentKind::kPin, "design", id};
+  };
+  auto suggestion =
+      Result("suggestion", u"arcium browser",
+             CommandProviderTarget{kNativeCommandProvider, "suggestion"});
+  suggestion.kind = CommandRowKind::kTypedSearch;
+  suggestion.primary_verb = u"Search Bing";
+  auto documentation =
+      Result("documentation", u"Arcium documentation",
+             CommandUrlTarget{GURL("https://arcium.test/docs")});
+  auto interface =
+      Result("interface", u"Arcium interface review", pin("interface"), true);
+  interface.activity = CommandActivity::kCircle;
+  interface.primary_verb = u"Restore pin";
