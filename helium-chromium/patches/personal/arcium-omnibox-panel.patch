+  auto pin = state_->records[2];
+  pin.row.title = std::u16string(200, u'W');
+  pin.row.category = u"Pin";
+  pin.row.primary_verb = u"Restore";
+  state_->records = {pin};
+  Open();
+  for (const auto labels : {CommandPanelAppearance::Labels::kText,
+                            CommandPanelAppearance::Labels::kPill}) {
+    CommandPanelAppearance appearance;
+    appearance.labels = labels;
+    appearance.scope_tints = false;
+    panel()->SetAppearance(appearance);
+    constexpr float scale = 1.15f;
+    panel()->SetUIScale(scale);
+    views::test::RunScheduledLayout(widget_.get());
+    ASSERT_EQ(1u, panel()->row_count_for_testing());
+    ASSERT_EQ(0, panel()->selected_for_testing());
+    ASSERT_EQ(1, panel()->selection_animation_for_testing()->GetCurrentValue());
+
+    const auto* row =
+        panel()->scroll_for_testing()->contents()->children().front().get();
+    gfx::Point origin;
+    views::View::ConvertPointToTarget(row, widget_->GetRootView(), &origin);
+    const int logical_width = base::ClampRound(row->width() / scale);
+    const int logical_height = base::ClampRound(row->height() / scale);
+    const auto font = [](int size) {
+      const gfx::FontList base_font;
+      return base_font.DeriveWithSizeDelta(size - base_font.GetFontSize())
+          .DeriveWithWeight(gfx::Font::Weight::MEDIUM);
+    };
+    EXPECT_GT(gfx::GetStringWidth(pin.row.title, font(14)), logical_width);
+    const int cue_x = logical_width - 11 - 24;
+    const int verb_x =
+        cue_x - gfx::GetStringWidth(pin.row.primary_verb, font(12)) - 9;
+    const int category_right = verb_x - 12;
+    const auto region = [&](int left, int right) {
+      const int top = base::ClampCeil(7 * scale);
+      const int bottom = base::ClampFloor((logical_height - 7) * scale);
+      const int start = base::ClampCeil(left * scale);
+      const int end = base::ClampFloor(right * scale);
+      return gfx::Rect(origin.x() + start, origin.y() + top, end - start,
+                       bottom - top);
+    };
+    // A long title exhausts its ellipsis width. The category must still leave
+    // ten logical pixels of clear space before the selected action verb.
+    const auto gap = region(verb_x - 10, verb_x);
+    const auto category =
+        region(category_right - gfx::GetStringWidth(pin.row.category, font(10)),
+               category_right);
+    const auto verb = region(verb_x, cue_x - 9);
+    const auto bitmap = PaintPanel();
+    const gfx::Rect bitmap_bounds(bitmap.width(), bitmap.height());
+    ASSERT_TRUE(bitmap_bounds.Contains(gap));
+    ASSERT_TRUE(bitmap_bounds.Contains(category));
+    ASSERT_TRUE(bitmap_bounds.Contains(verb));
+    const auto foreground_pixels = [&bitmap](const gfx::Rect& bounds) {
+      int count = 0;
+      for (int y = bounds.y(); y < bounds.bottom(); ++y) {
+        for (int x = bounds.x(); x < bounds.right(); ++x) {
+          const SkColor color = bitmap.getColor(x, y);
+          if (SkColorGetR(color) > 165 && SkColorGetG(color) > 165 &&
+              SkColorGetB(color) > 165) {
+            ++count;
+          }
+        }
+      }
+      return count;
+    };
+    EXPECT_EQ(0, foreground_pixels(gap));
+    EXPECT_GT(foreground_pixels(category), 0);
+    EXPECT_GT(foreground_pixels(verb), 0);
+    EXPECT_FALSE(widget_->IsVisible());
+  }
+}
