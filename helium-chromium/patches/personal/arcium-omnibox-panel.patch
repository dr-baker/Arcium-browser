+CommandPanelAppearance ReadCommandPanelAppearance(PrefService* prefs) {
+  CommandPanelAppearance result;
+  if (!prefs || !prefs->FindPreference(kCommandPanelLayoutPref)) {
+    return result;
+  }
+  const auto& value = prefs->GetDict(kCommandPanelLayoutPref);
+  const int labels = value.FindInt("labels").value_or(1);
+  const int icons = value.FindInt("icons").value_or(2);
+  const int reveal = value.FindInt("scope_reveal").value_or(2);
+  if (labels >= 0 && labels <= 2) {
+    result.labels = static_cast<CommandPanelAppearance::Labels>(labels);
+  }
+  if (icons >= 0 && icons <= 3) {
+    result.icons = static_cast<CommandPanelAppearance::Icons>(icons);
+  }
+  if (reveal >= 0 &&
+      reveal <= static_cast<int>(CommandPanelAppearance::Reveal::kDivot)) {
+    result.reveal = static_cast<CommandPanelAppearance::Reveal>(reveal);
+  }
+  result.connected = value.FindBool("connected").value_or(true);
+  result.full_width = value.FindBool("full_width").value_or(true);
+  result.scope_tints = value.FindBool("scope_tints").value_or(true);
+  const double strength = value.FindDouble("glow_strength").value_or(1.0);
+  if (std::isfinite(strength) && strength >= 0.0 && strength <= 2.0) {
+    result.glow_strength = strength;
+  }
+  result.activity_dots = value.FindBool("activity_dots").value_or(true);
+  return result;
+}
