+CommandPanelView::CommandPanelView(std::unique_ptr<CommandSession> session,
+                                   base::RepeatingClosure dismiss,
+                                   base::RepeatingCallback<void(bool)> reopen)
+    : session_(std::move(session)),
+      dismiss_(std::move(dismiss)),
+      reopen_(std::move(reopen)) {
+  CHECK(session_);
+  GetViewAccessibility().SetRole(ax::mojom::Role::kDialog);
+  GetViewAccessibility().SetName(u"Arcium command bar");
+  input_ = AddChildView(std::make_unique<CommandTextfield>());
+  input_->set_controller(this);
+  input_->SetBorder(views::CreateEmptyBorder(0));
+  input_->SetBackgroundColor(SK_ColorTRANSPARENT);
+  input_->SetColor(kText);
+  input_->SetFontList(Font(18, true));
+  input_->GetViewAccessibility().SetRole(
+      ax::mojom::Role::kTextFieldWithComboBox);
+  input_->GetViewAccessibility().SetName(u"Search everything or enter URL");
+  input_->GetViewAccessibility().SetHasPopup(ax::mojom::HasPopup::kListbox);
+  scroll_ = AddChildView(std::make_unique<ResultsScrollView>(this));
+  scroll_->SetBackgroundColor(std::nullopt);
+  scroll_->SetDrawOverflowIndicator(false);
+  scroll_->SetHorizontalScrollBarMode(
+      views::ScrollView::ScrollBarMode::kDisabled);
+  results_view_ = scroll_->SetContents(std::make_unique<ResultsView>(this));
+  results_view_->GetViewAccessibility().SetRole(ax::mojom::Role::kListBox);
+  results_view_->GetViewAccessibility().SetName(u"Suggestions");
+  footer_button_ = AddChildView(std::make_unique<FooterButton>(this));
+  selection_animation_.SetSlideDuration(base::Milliseconds(80));
+  scope_animation_.SetSlideDuration(base::Milliseconds(140));
+  scope_label_animation_.SetSlideDuration(base::Milliseconds(80));
+  scope_icon_animation_.SetSlideDuration(base::Milliseconds(110));
+  scope_selection_animation_.SetSlideDuration(base::Milliseconds(80));
+  content_animation_.SetSlideDuration(base::Milliseconds(160));
+  for (auto* animation : {&selection_animation_, &scope_animation_,
+                          &scope_label_animation_, &scope_icon_animation_,
+                          &scope_selection_animation_, &content_animation_}) {
+    animation->SetTweenType(gfx::Tween::LINEAR_OUT_SLOW_IN);
+    animation->Reset(1);
+  }
+  SyncScopes(session_->GetScopes());
+  SetInvocation(true);
+}
+CommandPanelView::~CommandPanelView() {
+  weak_ptr_factory_.InvalidateWeakPtrs();
+  scope_hide_timer_.Stop();
+  session_->Cancel();
