+TEST(ArciumShortcutPresetsTest, MalformedProfileBackupRejectsReapplication) {
+  TestingPrefServiceSimple pref_service;
+  RegisterPrefs(&pref_service);
+  BrowserShortcutService service(&pref_service);
+  ASSERT_EQ(ApplyArcShortcutPreset(&service), PresetResult::kApplied);
+  pref_service.SetInteger(::arcium::kCollapsedSidebarStylePref, 0);
+  const auto configured = service.GetAcceleratorMap();
+  const auto shortcuts = pref_service.GetDict(prefs::kCustomAccelerators).Clone();
+  auto backup = pref_service.GetDict(prefs::kArcShortcutBackup).Clone();
+  backup.Set("profile_preferences", "invalid saved preferences");
+  pref_service.SetDict(prefs::kArcShortcutBackup, backup.Clone());
+
+  EXPECT_EQ(ApplyArcShortcutPreset(&service), PresetResult::kInvalidConfiguration);
+  EXPECT_EQ(service.GetAcceleratorMap(), configured);
+  EXPECT_EQ(pref_service.GetDict(prefs::kCustomAccelerators), shortcuts);
+  EXPECT_EQ(pref_service.GetDict(prefs::kArcShortcutBackup), backup);
+  EXPECT_EQ(pref_service.GetInteger(::arcium::kCollapsedSidebarStylePref), 0);
+}
