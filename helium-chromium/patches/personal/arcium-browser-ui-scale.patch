+gfx::Insets ScaleChromeInsets(const views::View* view, gfx::Insets insets) {
+  if (arcium::GetChromeUIScale(view) == 1.0) {
+    return insets;
+  }
+  return gfx::Insets::TLBR(arcium::ScaleChromeDip(view, insets.top()),
+                           arcium::ScaleChromeDip(view, insets.left()),
+                           arcium::ScaleChromeDip(view, insets.bottom()),
+                           arcium::ScaleChromeDip(view, insets.right()));
+}
+
+gfx::FontList ScaleChromeFontList(const gfx::FontList& font_list,
+                                  const views::View* view) {
+  const int scaled_size = arcium::ScaleChromeDip(view, font_list.GetFontSize());
+  return scaled_size == font_list.GetFontSize()
+             ? font_list
+             : font_list.DeriveWithSizeDelta(scaled_size -
+                                             font_list.GetFontSize());
+}
+
+ui::ImageModel ScaleChromeImageModel(const ui::ImageModel& image,
+                                     const views::View* view) {
+  if (!image.IsVectorIcon()) {
+    return image;
+  }
+  const ui::VectorIconModel vector = image.GetVectorIcon();
+  if (!vector.vector_icon()) {
+    return image;
+  }
+  return ui::ImageModel::FromVectorIcon(
+      *vector.vector_icon(), vector.color(),
+      arcium::ScaleChromeDip(view, vector.icon_size()), vector.badge_icon());
+}
+
+ui::ImageModel ScaleChromeRasterImageModel(
+    const ui::ImageModel& image,
+    const views::View* view,
+    const ui::ColorProvider* color_provider) {
+  if (image.IsEmpty() || image.IsVectorIcon() ||
+      arcium::GetChromeUIScale(view) == 1.0 || !color_provider) {
+    return image;
+  }
+
+  const gfx::ImageSkia raster = image.Rasterize(color_provider);
+  if (raster.isNull() || raster.size().IsEmpty()) {
+    return image;
+  }
+
+  const gfx::Size scaled_size(arcium::ScaleChromeDip(view, raster.width()),
+                              arcium::ScaleChromeDip(view, raster.height()));
+  return ui::ImageModel::FromImageSkia(
+      gfx::ImageSkiaOperations::CreateResizedImage(
+          raster, skia::ImageOperations::RESIZE_BEST, scaled_size));
+}
+
+void ApplyChromeScaleToBookmarkButton(views::LabelButton* button,
+                                      const views::View* scale_view) {
+  const gfx::FontList& base_font = views::TypographyProvider::Get().GetFont(
+      views::style::CONTEXT_BUTTON, views::style::STYLE_PRIMARY);
+  for (views::View* child : button->children()) {
+    if (auto* label = views::AsViewClass<views::Label>(child)) {
+      label->SetFontList(ScaleChromeFontList(base_font, scale_view));
+    }
+  }
+  button->SetImageLabelSpacing(arcium::GetChromeLayoutConstant(
+      scale_view, LayoutConstant::kBookmarkBarButtonImageLabelPadding));
+}
