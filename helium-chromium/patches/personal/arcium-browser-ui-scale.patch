+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license found in the LICENSE file.
+
+#include <algorithm>
+
+#include "base/numerics/safe_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/layout_constants.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/helium/arcium_chrome_ui_scale.h"
+#include "components/prefs/pref_service.h"
+#include "ui/base/class_property.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+// Zero leaves child widgets free to inherit their browser window's scale.
+DEFINE_UI_CLASS_PROPERTY_KEY(int, kChromeUIScalePercentKey, 0)
+}  // namespace
+
+namespace arcium {
+double GetChromeUIScale(const Profile* profile) {
+  const PrefService* prefs =
+      profile ? profile->GetOriginalProfile()->GetPrefs() : nullptr;
+  if (!prefs || !prefs->FindPreference(kChromeUIScalePref)) {
+    return 1.0;
+  }
+  return std::clamp(prefs->GetInteger(kChromeUIScalePref), kChromeUIScaleMin,
+                    kChromeUIScaleMax) /
+         100.0;
+}
+
+double GetChromeUIScale(const views::View* view) {
+  for (const views::Widget* widget = view ? view->GetWidget() : nullptr;
+       widget; widget = widget->parent()) {
+    const int percent = widget->GetProperty(kChromeUIScalePercentKey);
+    if (percent) {
+      return percent / 100.0;
+    }
+  }
+  return 1.0;
+}
+
+void UpdateChromeUIScaleCache(views::Widget* widget, const Profile* profile) {
+  if (widget) {
+    widget->SetProperty(
+        kChromeUIScalePercentKey,
+        profile ? base::ClampRound(GetChromeUIScale(profile) * 100) : 0);
+  }
+}
+
+int ScaleChromeDip(const views::View* view, int value) {
+  return base::ClampRound(value * GetChromeUIScale(view));
+}
+
+int GetChromeLayoutConstant(const views::View* view, LayoutConstant constant) {
+  return ScaleChromeDip(view, GetLayoutConstant(constant));
+}
+void RefreshChromeUI(BrowserView* browser_view) {
+  if (!browser_view || !browser_view->GetWidget() ||
+      !browser_view->GetIsNormalType()) {
+    return;
+  }
+  UpdateChromeUIScaleCache(browser_view->GetWidget(), browser_view->GetProfile());
+  // Theme propagation refreshes cached icons and padding. Recompute layout
+  // without changing page zoom or the display device scale factor.
+  browser_view->GetWidget()->ThemeChanged();
+  auto invalidate = [](auto&& self, views::View* view) -> void {
+    for (views::View* child : view->children()) {
+      self(self, child);
+    }
+    view->InvalidateLayout();
+  };
+  invalidate(invalidate, browser_view);
+  browser_view->GetWidget()->OnSizeConstraintsChanged();
+}
+
+}  // namespace arcium
