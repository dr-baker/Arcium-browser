+TEST_F(ArciumCommandBarTest, FloatingBarAndSuggestionTextUseProfileScale) {
+  browser()->profile()->GetPrefs()->SetInteger(arcium::kChromeUIScalePref, 115);
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(true));
+  auto* location = floating();
+  EXPECT_DOUBLE_EQ(1.15, arcium::GetChromeUIScale(location));
+  EXPECT_FALSE(BrowserView::GetBrowserViewForNativeWindow(
+      location->GetWidget()->GetNativeWindow()));
+  auto* text = location->AddChildView(std::make_unique<OmniboxTextView>(nullptr));
+  auto rendered = text->CreateRenderText(u"Saved Pin");
+  const auto& base_font = views::TypographyProvider::Get().GetFont(
+      CONTEXT_OMNIBOX_POPUP, views::style::STYLE_PRIMARY);
+  EXPECT_EQ(arcium::ScaleChromeDip(text, base_font.GetFontSize()),
+            rendered->font_list().GetFontSize());
+  EXPECT_EQ(arcium::ScaleChromeDip(text, 19), rendered->min_line_height());
+  views::test::WidgetDestroyedWaiter destroyed(location->GetWidget());
+  browser_view()->CloseArciumCommandBar();
+  destroyed.Wait();
+}
