+const PrefService* ChromeAppearancePrefs(const BrowserView* browser_view) {
+  if (!browser_view || !browser_view->GetIsNormalType() ||
+      !browser_view->GetProfile()) {
+    return nullptr;
+  }
+  return browser_view->GetProfile()->GetOriginalProfile()->GetPrefs();
+}
+
+// Paint predicates only need material selection. Avoid decoding color points
+// and allocating their identifiers during every Chrome Views paint.
+GlassSurfaceConfiguration ReadMaterialSelection(const PrefService* prefs) {
+  GlassSurfaceConfiguration selection;
+  if (!prefs || !prefs->FindPreference(kArciumChromeAppearancePref)) {
+    return selection;
+  }
+  const base::DictValue& value = prefs->GetDict(kArciumChromeAppearancePref);
+  selection.enabled =
+      value.FindBool(kGlassAppearanceEnabledKey).value_or(false);
+  if (const std::string* material =
+          value.FindString(kGlassAppearanceMaterialKey)) {
+    if (*material == kGlassAppearanceLiquidGlass) {
+      selection.material = GlassSurfaceMaterial::kLiquidGlass;
+    } else if (*material == kGlassAppearanceFrosted) {
+      selection.material = GlassSurfaceMaterial::kFrosted;
+    } else if (*material == kGlassAppearanceSolid) {
+      selection.material = GlassSurfaceMaterial::kSolid;
+    }
+  }
+  return selection;
+}
+
+GlassSurfaceResolution ResolveNativeFrameGlass(
+    const BrowserView* browser_view,
+    const GlassBackendAvailability& availability) {
+  return ResolveGlassSurfaceConfiguration(
+      ReadMaterialSelection(ChromeAppearancePrefs(browser_view)),
+      GetRequestedGlassBackend(), availability.native_liquid_glass,
+      availability.native_material, availability.reduce_transparency);
+}
+
+}  // namespace
+
+GlassSurfaceConfiguration GetNativeFrameGlassConfiguration(
+    const BrowserView* browser_view) {
+  const PrefService* prefs = ChromeAppearancePrefs(browser_view);
+  return prefs ? ReadGlassSurfaceConfiguration(prefs)
+               : DefaultGlassSurfaceConfiguration();
+}
+
+GlassSurfaceResolution GetNativeFrameGlassResolution(
+    const BrowserView* browser_view) {
+  return ResolveNativeFrameGlass(browser_view,
+                                 GetNativeFrameGlassAvailability());
+}
 
