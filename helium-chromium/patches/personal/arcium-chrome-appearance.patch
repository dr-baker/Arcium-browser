+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_GLASS_SURFACE_CONFIGURATION_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_GLASS_SURFACE_CONFIGURATION_H_
+
+#include <array>
+#include <cstddef>
+#include <optional>
+#include <string>
+
+#include "base/values.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+class PrefService;
+
+namespace helium {
+
+enum class GlassBackend;
+
+// Profile-owned appearance settings for the main browser chrome. The
+// preference is deliberately a dictionary so future fields can be added
+// without changing the profile preference type.
+inline constexpr char kArciumChromeAppearancePref[] =
+    "arcium.chrome.appearance";
+
+inline constexpr char kGlassAppearanceEnabledKey[] = "enabled";
+inline constexpr char kGlassAppearanceMaterialKey[] = "material";
+inline constexpr char kGlassAppearanceMaterialOpacityKey[] = "materialOpacity";
+inline constexpr char kGlassAppearanceGlassTintOpacityKey[] =
+    "glassTintOpacity";
+inline constexpr char kGlassAppearanceGlassStyleKey[] = "glassStyle";
+inline constexpr char kGlassAppearanceFrostedStyleKey[] = "frostedStyle";
+inline constexpr char kGlassAppearanceFrostedTintStrengthKey[] =
+    "frostedTintStrength";
+inline constexpr char kGlassAppearanceTintStrengthKey[] = "tintStrength";
+inline constexpr char kGlassAppearanceGrainKey[] = "grain";
+inline constexpr char kGlassAppearanceGrainScaleKey[] = "grainScale";
+inline constexpr char kGlassAppearancePointsKey[] = "points";
+inline constexpr char kGlassAppearanceMatchColorAdjustmentsKey[] =
+    "matchColorAdjustments";
+
+inline constexpr char kGlassAppearanceAuto[] = "auto";
+inline constexpr char kGlassAppearanceLiquidGlass[] = "liquidGlass";
+inline constexpr char kGlassAppearanceFrosted[] = "frosted";
+inline constexpr char kGlassAppearanceSolid[] = "solid";
+inline constexpr char kGlassAppearanceGlassStyleRegular[] = "regular";
+inline constexpr char kGlassAppearanceGlassStyleClear[] = "clear";
+inline constexpr char kGlassAppearanceFrostedStyleAutomatic[] = "automatic";
+inline constexpr char kGlassAppearanceFrostedStyleSidebar[] = "sidebar";
+inline constexpr char kGlassAppearanceFrostedStyleMenu[] = "menu";
+inline constexpr char kGlassAppearanceFrostedStylePopover[] = "popover";
+inline constexpr char kGlassAppearanceFrostedStyleHud[] = "hud";
+
+inline constexpr char kGlassPointIdKey[] = "id";
+inline constexpr char kGlassPointColorKey[] = "color";
+inline constexpr char kGlassPointXKey[] = "x";
+inline constexpr char kGlassPointYKey[] = "y";
+inline constexpr char kGlassPointRadiusKey[] = "radius";
+inline constexpr char kGlassPointOpacityKey[] = "opacity";
+
+inline constexpr size_t kMaxGlassColorPoints = 4;
+
+enum class GlassSurfaceMaterial {
+  kAuto,
+  kLiquidGlass,
+  kFrosted,
+  kSolid,
+};
+
+enum class GlassSurfaceGlassStyle {
+  kRegular,
+  kClear,
+};
+
+enum class GlassSurfaceFrostedStyle {
+  kAutomatic,
+  kSidebar,
+  kMenu,
+  kPopover,
+  kHud,
+};
+
+struct GlassColorPoint {
+  std::string id;
+  SkColor4f color = {1.0f, 1.0f, 1.0f, 1.0f};
+  double x = 0.5;
+  double y = 0.5;
+  double radius = 0.5;
+  double opacity = 0.0;
+
+  bool operator==(const GlassColorPoint& other) const {
+    return id == other.id && color == other.color && x == other.x &&
+           y == other.y && radius == other.radius && opacity == other.opacity;
+  }
+};
+
+struct GlassSurfaceConfiguration {
+  // false means that the existing command-line glass policy remains in
+  // control. The editable default enables the Liquid Glass surface.
+  bool enabled = true;
+  GlassSurfaceMaterial material = GlassSurfaceMaterial::kLiquidGlass;
+  double material_opacity = 0.95;
+  double glass_tint_opacity = 0.7;
+  GlassSurfaceGlassStyle glass_style = GlassSurfaceGlassStyle::kRegular;
+  GlassSurfaceFrostedStyle frosted_style = GlassSurfaceFrostedStyle::kAutomatic;
+  // Multiplies the existing frosted theme tint; one preserves it.
+  double frosted_tint_strength = 1.0;
+  double tint_strength = 0.0;
+  double grain = 0.0;
+  double grain_scale = 0.5;
+  bool match_color_adjustments = false;
+  std::array<GlassColorPoint, kMaxGlassColorPoints> points;
+  size_t point_count = 0;
+
+  bool operator==(const GlassSurfaceConfiguration& other) const {
+    if (enabled != other.enabled || material != other.material ||
+        material_opacity != other.material_opacity ||
+        glass_tint_opacity != other.glass_tint_opacity ||
+        glass_style != other.glass_style ||
+        frosted_style != other.frosted_style ||
+        frosted_tint_strength != other.frosted_tint_strength ||
+        tint_strength != other.tint_strength || grain != other.grain ||
+        grain_scale != other.grain_scale ||
+        match_color_adjustments != other.match_color_adjustments ||
+        point_count != other.point_count) {
+      return false;
+    }
+    for (size_t i = 0; i < point_count; ++i) {
+      if (!(points[i] == other.points[i])) {
+        return false;
+      }
+    }
+    return true;
+  }
+};
+
+// The public UI material is intentionally smaller than the internal renderer
+// backend enum. Native availability and accessibility settings are resolved
+// separately so the UI can report what was requested and what is active.
+struct GlassSurfaceResolution {
+  bool enabled = false;
+  GlassSurfaceMaterial configured = GlassSurfaceMaterial::kAuto;
+  GlassSurfaceMaterial active = GlassSurfaceMaterial::kAuto;
+  bool uses_translucent_native_base = false;
+  bool paints_chrome_transparent = false;
+  const char* fallback_reason = "disabled";
+};
+
+GlassSurfaceConfiguration DefaultGlassSurfaceConfiguration();
+
+// Parses and clamps untrusted profile data. Missing or malformed fields use
+// the defaults above; non-finite numbers never reach AppKit.
+GlassSurfaceConfiguration ParseGlassSurfaceConfiguration(
+    const base::DictValue& dict);
+
+// Parses the dictionary exchanged with the native SettingsUI bridge. Every
+// field is required, unknown fields are rejected, and all values must be
+// finite and within the renderer's supported ranges. This keeps Foundation
+// input from reaching the profile preference or AppKit renderer unchecked.
+std::optional<GlassSurfaceConfiguration> ParseGlassSurfaceConfigurationStrict(
+    const base::DictValue& dict);
+
+// Emits the complete canonical bridge representation. The output always has
+// every top-level appearance field and points, including when the profile
+// preference is unset or has no color points.
+base::DictValue SerializeGlassSurfaceConfiguration(
+    const GlassSurfaceConfiguration& configuration);
+
+// Fills missing profile fields with canonical defaults for a SettingsUI
+// snapshot while preserving saved values, including malformed or unknown
+// fields for the strict bridge decoder to reject.
+base::DictValue CompleteGlassSurfaceConfigurationForEditing(
+    const base::DictValue& saved);
+
+GlassSurfaceConfiguration ReadGlassSurfaceConfiguration(
+    const PrefService* prefs);
+
+// `native_liquid_glass` is true only when the NSGlassEffectView API is
+// available. Frosted is the NSVisualEffectView fallback. Reduce Transparency
+// and a command-line opaque/chromium override suppress transparent Chrome
+// Views, so the UI can disable decorative controls rather than claiming that
+// an opaque frame displays them.
+GlassSurfaceResolution ResolveGlassSurfaceConfiguration(
+    const GlassSurfaceConfiguration& configuration,
+    GlassBackend requested_backend,
+    bool native_liquid_glass,
+    bool native_frosted,
+    bool reduce_transparency);
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_GLASS_SURFACE_CONFIGURATION_H_
