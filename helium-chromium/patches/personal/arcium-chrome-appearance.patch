+namespace helium {
+
+TEST(GlassSurfaceConfigurationTest, DefaultsAreCanonicalEditableValues) {
+  const GlassSurfaceConfiguration configuration =
+      DefaultGlassSurfaceConfiguration();
+
+  EXPECT_TRUE(configuration.enabled);
+  EXPECT_EQ(configuration.material, GlassSurfaceMaterial::kLiquidGlass);
+  EXPECT_DOUBLE_EQ(configuration.material_opacity, 0.95);
+  EXPECT_DOUBLE_EQ(configuration.glass_tint_opacity, 0.7);
+  EXPECT_EQ(configuration.glass_style, GlassSurfaceGlassStyle::kRegular);
+  EXPECT_EQ(configuration.frosted_style, GlassSurfaceFrostedStyle::kAutomatic);
+  EXPECT_DOUBLE_EQ(configuration.frosted_tint_strength, 1.0);
+  EXPECT_DOUBLE_EQ(configuration.tint_strength, 0.4);
+  EXPECT_DOUBLE_EQ(configuration.grain, 0.06);
+  EXPECT_DOUBLE_EQ(configuration.grain_scale, 0.5);
+  ASSERT_EQ(configuration.point_count, 2u);
+  EXPECT_EQ(configuration.points[0].id, "yellow");
+  EXPECT_EQ(configuration.points[1].id, "blue");
+
+  const base::DictValue serialized =
+      SerializeGlassSurfaceConfiguration(configuration);
+  ASSERT_NE(serialized.FindBool(kGlassAppearanceEnabledKey), std::nullopt);
+  EXPECT_TRUE(*serialized.FindBool(kGlassAppearanceEnabledKey));
+  ASSERT_NE(serialized.FindString(kGlassAppearanceMaterialKey), nullptr);
+  EXPECT_STREQ(serialized.FindString(kGlassAppearanceMaterialKey)->c_str(),
+               kGlassAppearanceLiquidGlass);
+  EXPECT_DOUBLE_EQ(*serialized.FindDouble(kGlassAppearanceMaterialOpacityKey),
+                   0.95);
+  EXPECT_DOUBLE_EQ(*serialized.FindDouble(kGlassAppearanceGlassTintOpacityKey),
+                   0.7);
+  EXPECT_DOUBLE_EQ(*serialized.FindDouble(kGlassAppearanceGrainScaleKey), 0.5);
+}
+
+TEST(GlassSurfaceConfigurationTest, EmptyDictionaryUsesCanonicalDefaults) {
+  const GlassSurfaceConfiguration configuration =
+      ParseGlassSurfaceConfiguration(base::DictValue());
+  EXPECT_EQ(configuration, DefaultGlassSurfaceConfiguration());
+}
+
+TEST(GlassSurfaceConfigurationTest,
+     OldSavedDictionaryPreservesNewFieldDefaults) {
+  base::DictValue legacy;
+  legacy.Set(kGlassAppearanceEnabledKey, true);
+  legacy.Set(kGlassAppearanceMaterialKey, kGlassAppearanceSolid);
+  legacy.Set(kGlassAppearanceTintStrengthKey, 0.2);
+  legacy.Set(kGlassAppearanceGrainKey, 0.1);
+  legacy.Set(kGlassAppearancePointsKey, base::ListValue());
+
+  const GlassSurfaceConfiguration configuration =
+      ParseGlassSurfaceConfiguration(legacy);
+  EXPECT_TRUE(configuration.enabled);
+  EXPECT_EQ(configuration.material, GlassSurfaceMaterial::kSolid);
+  EXPECT_DOUBLE_EQ(configuration.tint_strength, 0.2);
+  EXPECT_DOUBLE_EQ(configuration.grain, 0.1);
+  EXPECT_DOUBLE_EQ(configuration.material_opacity, 0.95);
+  EXPECT_DOUBLE_EQ(configuration.glass_tint_opacity, 0.7);
+  EXPECT_EQ(configuration.glass_style, GlassSurfaceGlassStyle::kRegular);
+  EXPECT_EQ(configuration.frosted_style, GlassSurfaceFrostedStyle::kAutomatic);
+  EXPECT_DOUBLE_EQ(configuration.frosted_tint_strength, 1.0);
+  EXPECT_DOUBLE_EQ(configuration.grain_scale, 0.5);
+  EXPECT_EQ(configuration.point_count, 0u);
+}
+
+TEST(GlassSurfaceConfigurationTest, EqualityIncludesNewFields) {
+  const GlassSurfaceConfiguration baseline = DefaultGlassSurfaceConfiguration();
+
+  GlassSurfaceConfiguration changed = baseline;
+  changed.material_opacity = 0.5;
+  EXPECT_NE(changed, baseline);
+  changed = baseline;
+  changed.glass_tint_opacity = 0.5;
+  EXPECT_NE(changed, baseline);
+  changed = baseline;
+  changed.glass_style = GlassSurfaceGlassStyle::kClear;
+  EXPECT_NE(changed, baseline);
+  changed = baseline;
+  changed.frosted_style = GlassSurfaceFrostedStyle::kHud;
+  EXPECT_NE(changed, baseline);
+  changed = baseline;
+  changed.frosted_tint_strength = 1.5;
+  EXPECT_NE(changed, baseline);
+  changed = baseline;
+  changed.grain_scale = 2.0;
+  EXPECT_NE(changed, baseline);
+}
+
+TEST(GlassSurfaceConfigurationTest,
+     CompletesLegacyDictionaryForEditingWithoutMutatingSavedValue) {
+  base::DictValue legacy;
+  legacy.Set(kGlassAppearanceEnabledKey, true);
+  legacy.Set(kGlassAppearanceMaterialKey, kGlassAppearanceSolid);
+  legacy.Set(kGlassAppearanceTintStrengthKey, 0.2);
+  legacy.Set(kGlassAppearanceGrainKey, 0.1);
+  legacy.Set(kGlassAppearancePointsKey, base::ListValue());
+  const base::DictValue original = legacy.Clone();
+
+  base::DictValue complete =
+      CompleteGlassSurfaceConfigurationForEditing(legacy);
+  EXPECT_EQ(legacy, original);
+  EXPECT_EQ(complete.size(), 12u);
+  EXPECT_TRUE(ParseGlassSurfaceConfigurationStrict(complete));
+  EXPECT_TRUE(*complete.FindBool(kGlassAppearanceEnabledKey));
+  EXPECT_STREQ(complete.FindString(kGlassAppearanceMaterialKey)->c_str(),
+               kGlassAppearanceSolid);
+  EXPECT_DOUBLE_EQ(*complete.FindDouble(kGlassAppearanceTintStrengthKey), 0.2);
+  EXPECT_DOUBLE_EQ(*complete.FindDouble(kGlassAppearanceGrainKey), 0.1);
+  EXPECT_DOUBLE_EQ(*complete.FindDouble(kGlassAppearanceMaterialOpacityKey),
+                   0.95);
+  EXPECT_DOUBLE_EQ(*complete.FindDouble(kGlassAppearanceGlassTintOpacityKey),
+                   0.7);
+  EXPECT_STREQ(complete.FindString(kGlassAppearanceGlassStyleKey)->c_str(),
+               kGlassAppearanceGlassStyleRegular);
+  EXPECT_STREQ(complete.FindString(kGlassAppearanceFrostedStyleKey)->c_str(),
+               kGlassAppearanceFrostedStyleAutomatic);
+  EXPECT_DOUBLE_EQ(*complete.FindDouble(kGlassAppearanceFrostedTintStrengthKey),
+                   1.0);
+  EXPECT_DOUBLE_EQ(*complete.FindDouble(kGlassAppearanceGrainScaleKey), 0.5);
+}
+
+TEST(GlassSurfaceConfigurationTest,
+     EditingCompletionPreservesInvalidValuesForStrictRejection) {
+  base::DictValue malformed;
+  malformed.Set(kGlassAppearanceGlassTintOpacityKey, "NaN");
+  const base::DictValue malformed_original = malformed.Clone();
+  EXPECT_FALSE(ParseGlassSurfaceConfigurationStrict(
+      CompleteGlassSurfaceConfigurationForEditing(malformed)));
+  EXPECT_EQ(malformed, malformed_original);
+
+  base::DictValue unknown;
+  unknown.Set("futureField", true);
+  const base::DictValue unknown_original = unknown.Clone();
+  EXPECT_FALSE(ParseGlassSurfaceConfigurationStrict(
+      CompleteGlassSurfaceConfigurationForEditing(unknown)));
+  EXPECT_EQ(unknown, unknown_original);
+}
+
+TEST(GlassSurfaceConfigurationTest, ClampsInvalidNumbersAndSkipsBadColors) {
+  base::DictValue dict;
+  dict.Set(kGlassAppearanceEnabledKey, true);
+  dict.Set(kGlassAppearanceMaterialOpacityKey, -1.0);
+  dict.Set(kGlassAppearanceGlassTintOpacityKey, 2.0);
+  dict.Set(kGlassAppearanceMaterialKey, "unrecognized");
+  dict.Set(kGlassAppearanceGlassStyleKey, "unrecognized");
+  dict.Set(kGlassAppearanceFrostedStyleKey, "unrecognized");
+  dict.Set(kGlassAppearanceFrostedTintStrengthKey, 3.0);
+  dict.Set(kGlassAppearanceTintStrengthKey, 4.0);
+  // Values saved with the previous 3.0 maximum are clamped to the new bound.
+  dict.Set(kGlassAppearanceGrainScaleKey, 3.0);
+  // base::Value normalizes nonfinite doubles at construction time, so use a
+  // wrong-type persisted value here. The parser still keeps a defensive
+  // isfinite check for dictionaries originating outside base::Value.
+  dict.Set(kGlassAppearanceGrainKey, "NaN");
+
+  base::ListValue points;
+  base::DictValue invalid_color;
+  invalid_color.Set(kGlassPointIdKey, "invalid");
+  invalid_color.Set(kGlassPointColorKey, "#not-a-color");
+  points.Append(std::move(invalid_color));
+
+  base::DictValue clamped;
+  clamped.Set(kGlassPointIdKey, "clamped");
+  clamped.Set(kGlassPointColorKey, "#123456");
+  clamped.Set(kGlassPointXKey, -1.0);
+  clamped.Set(kGlassPointYKey, 2.0);
+  clamped.Set(kGlassPointRadiusKey, 9.0);
+  clamped.Set(kGlassPointOpacityKey, -1.0);
+  points.Append(std::move(clamped));
+  dict.Set(kGlassAppearancePointsKey, std::move(points));
+
+  const GlassSurfaceConfiguration configuration =
+      ParseGlassSurfaceConfiguration(dict);
+  EXPECT_TRUE(configuration.enabled);
+  EXPECT_EQ(configuration.material, GlassSurfaceMaterial::kLiquidGlass);
+  EXPECT_DOUBLE_EQ(configuration.material_opacity, 0.0);
+  EXPECT_DOUBLE_EQ(configuration.glass_tint_opacity, 1.0);
+  EXPECT_EQ(configuration.glass_style, GlassSurfaceGlassStyle::kRegular);
+  EXPECT_EQ(configuration.frosted_style, GlassSurfaceFrostedStyle::kAutomatic);
+  EXPECT_DOUBLE_EQ(configuration.frosted_tint_strength, 2.0);
+  EXPECT_DOUBLE_EQ(configuration.tint_strength, 1.0);
+  EXPECT_DOUBLE_EQ(configuration.grain, 0.06);
+  EXPECT_DOUBLE_EQ(configuration.grain_scale, 2.0);
+  ASSERT_EQ(configuration.point_count, 1u);
+  EXPECT_DOUBLE_EQ(configuration.points[0].x, 0.0);
+  EXPECT_DOUBLE_EQ(configuration.points[0].y, 1.0);
+  EXPECT_DOUBLE_EQ(configuration.points[0].radius, 1.5);
+  EXPECT_DOUBLE_EQ(configuration.points[0].opacity, 0.0);
+
+  dict.Set(kGlassAppearanceMaterialKey, kGlassAppearanceAuto);
+  EXPECT_EQ(ParseGlassSurfaceConfiguration(dict).material,
+            GlassSurfaceMaterial::kAuto);
+}
+
+TEST(GlassSurfaceConfigurationTest,
+     PermissiveParserUsesDefaultsForMalformedNewFields) {
+  base::DictValue dict;
+  dict.Set(kGlassAppearanceMaterialOpacityKey, "NaN");
+  dict.Set(kGlassAppearanceGlassTintOpacityKey, "NaN");
+  dict.Set(kGlassAppearanceFrostedTintStrengthKey, "NaN");
+  dict.Set(kGlassAppearanceGrainScaleKey, "NaN");
+
+  const GlassSurfaceConfiguration configuration =
+      ParseGlassSurfaceConfiguration(dict);
+  EXPECT_DOUBLE_EQ(configuration.material_opacity, 0.95);
+  EXPECT_DOUBLE_EQ(configuration.glass_tint_opacity, 0.7);
+  EXPECT_DOUBLE_EQ(configuration.frosted_tint_strength, 1.0);
+  EXPECT_DOUBLE_EQ(configuration.grain_scale, 0.5);
+}
+
+TEST(GlassSurfaceConfigurationTest, EmptyPointsListClearsCanonicalPoints) {
+  base::DictValue dict;
+  dict.Set(kGlassAppearancePointsKey, base::ListValue());
+
+  const GlassSurfaceConfiguration configuration =
+      ParseGlassSurfaceConfiguration(dict);
+  EXPECT_EQ(configuration.point_count, 0u);
+}
+
+TEST(GlassSurfaceConfigurationTest, ResolvesSolidForReducedTransparency) {
+  GlassSurfaceConfiguration configuration = DefaultGlassSurfaceConfiguration();
+  configuration.enabled = true;
+  configuration.material = GlassSurfaceMaterial::kLiquidGlass;
+
+  const GlassSurfaceResolution resolution = ResolveGlassSurfaceConfiguration(
+      configuration, GlassBackend::kAuto, true, true, true);
+  EXPECT_EQ(resolution.configured, GlassSurfaceMaterial::kLiquidGlass);
+  EXPECT_EQ(resolution.active, GlassSurfaceMaterial::kSolid);
+  EXPECT_FALSE(resolution.paints_chrome_transparent);
+  EXPECT_STREQ(resolution.fallback_reason, "reduce-transparency");
+}
+
+TEST(GlassSurfaceConfigurationTest, SolidKeepsChromeTransparent) {
+  GlassSurfaceConfiguration configuration = DefaultGlassSurfaceConfiguration();
+  configuration.enabled = true;
+  configuration.material = GlassSurfaceMaterial::kSolid;
+
+  const GlassSurfaceResolution resolution = ResolveGlassSurfaceConfiguration(
+      configuration, GlassBackend::kAuto, true, true, false);
+  EXPECT_EQ(resolution.active, GlassSurfaceMaterial::kSolid);
+  EXPECT_TRUE(resolution.paints_chrome_transparent);
+}
+
+TEST(GlassSurfaceConfigurationTest, StrictSerializerRoundTripsCanonicalValue) {
+  GlassSurfaceConfiguration configuration = DefaultGlassSurfaceConfiguration();
+  configuration.enabled = true;
+  configuration.material = GlassSurfaceMaterial::kSolid;
+  configuration.material_opacity = 0.25;
+  configuration.glass_tint_opacity = 0.75;
+  configuration.glass_style = GlassSurfaceGlassStyle::kClear;
+  configuration.frosted_style = GlassSurfaceFrostedStyle::kHud;
+  configuration.frosted_tint_strength = 1.8;
+  configuration.grain_scale = 2.25;
+
+  base::DictValue serialized =
+      SerializeGlassSurfaceConfiguration(configuration);
+  std::optional<GlassSurfaceConfiguration> parsed =
+      ParseGlassSurfaceConfigurationStrict(serialized);
+  ASSERT_TRUE(parsed);
+
+  base::DictValue canonical_again = SerializeGlassSurfaceConfiguration(*parsed);
+  EXPECT_EQ(serialized, canonical_again);
+  EXPECT_EQ(serialized.size(), 12u);
+  ASSERT_NE(serialized.FindString(kGlassAppearanceMaterialKey), nullptr);
+  EXPECT_STREQ(serialized.FindString(kGlassAppearanceMaterialKey)->c_str(),
+               "solid");
+  ASSERT_NE(serialized.FindString(kGlassAppearanceGlassStyleKey), nullptr);
+  EXPECT_STREQ(serialized.FindString(kGlassAppearanceGlassStyleKey)->c_str(),
+               "clear");
+  ASSERT_NE(serialized.FindString(kGlassAppearanceFrostedStyleKey), nullptr);
+  EXPECT_STREQ(serialized.FindString(kGlassAppearanceFrostedStyleKey)->c_str(),
+               "hud");
+  EXPECT_DOUBLE_EQ(parsed->material_opacity, 0.25);
+  EXPECT_DOUBLE_EQ(parsed->glass_tint_opacity, 0.75);
+  EXPECT_EQ(parsed->glass_style, GlassSurfaceGlassStyle::kClear);
+  EXPECT_EQ(parsed->frosted_style, GlassSurfaceFrostedStyle::kHud);
+  EXPECT_DOUBLE_EQ(parsed->frosted_tint_strength, 1.8);
+  EXPECT_DOUBLE_EQ(parsed->grain_scale, 2.0);
+  EXPECT_DOUBLE_EQ(*serialized.FindDouble(kGlassAppearanceGrainScaleKey), 2.0);
+}
+
+TEST(GlassSurfaceConfigurationTest, StrictParserRejectsMalformedValues) {
+  const base::DictValue valid =
+      SerializeGlassSurfaceConfiguration(DefaultGlassSurfaceConfiguration());
+
+  base::DictValue unknown_key = valid.Clone();
+  unknown_key.Set("futureField", true);
+  EXPECT_FALSE(ParseGlassSurfaceConfigurationStrict(unknown_key));
+
+  base::DictValue nonfinite = valid.Clone();
+  nonfinite.Set(kGlassAppearanceGrainKey, "not-a-number");
+  EXPECT_FALSE(ParseGlassSurfaceConfigurationStrict(nonfinite));
+
+  base::DictValue out_of_range = valid.Clone();
+  out_of_range.Set(kGlassAppearanceTintStrengthKey, -0.01);
+  EXPECT_FALSE(ParseGlassSurfaceConfigurationStrict(out_of_range));
+
+  base::DictValue new_field_out_of_range = valid.Clone();
+  new_field_out_of_range.Set(kGlassAppearanceMaterialOpacityKey, 1.01);
+  EXPECT_FALSE(ParseGlassSurfaceConfigurationStrict(new_field_out_of_range));
+
+  new_field_out_of_range = valid.Clone();
+  new_field_out_of_range.Set(kGlassAppearanceGlassTintOpacityKey, -0.01);
+  EXPECT_FALSE(ParseGlassSurfaceConfigurationStrict(new_field_out_of_range));
+
+  new_field_out_of_range = valid.Clone();
+  new_field_out_of_range.Set(kGlassAppearanceGrainScaleKey, 0.49);
+  EXPECT_FALSE(ParseGlassSurfaceConfigurationStrict(new_field_out_of_range));
+
+  new_field_out_of_range = valid.Clone();
+  new_field_out_of_range.Set(kGlassAppearanceGrainScaleKey, 2.01);
+  EXPECT_FALSE(ParseGlassSurfaceConfigurationStrict(new_field_out_of_range));
+
+  new_field_out_of_range = valid.Clone();
+  new_field_out_of_range.Set(kGlassAppearanceFrostedTintStrengthKey, 2.01);
+  EXPECT_FALSE(ParseGlassSurfaceConfigurationStrict(new_field_out_of_range));
+
+  base::DictValue nonfinite_new_field = valid.Clone();
+  nonfinite_new_field.Set(kGlassAppearanceMaterialOpacityKey, "NaN");
+  EXPECT_FALSE(ParseGlassSurfaceConfigurationStrict(nonfinite_new_field));
+
+  base::DictValue unknown_style = valid.Clone();
+  unknown_style.Set(kGlassAppearanceGlassStyleKey, "unrecognized");
+  EXPECT_FALSE(ParseGlassSurfaceConfigurationStrict(unknown_style));
+
+  unknown_style = valid.Clone();
+  unknown_style.Set(kGlassAppearanceFrostedStyleKey, "unrecognized");
+  EXPECT_FALSE(ParseGlassSurfaceConfigurationStrict(unknown_style));
+
+  base::DictValue duplicate_ids = valid.Clone();
+  base::ListValue* points = duplicate_ids.FindList(kGlassAppearancePointsKey);
+  ASSERT_NE(points, nullptr);
+  ASSERT_GE(points->size(), 2u);
+  base::DictValue* second_point = (*points)[1].GetIfDict();
+  ASSERT_NE(second_point, nullptr);
+  second_point->Set(kGlassPointIdKey, "yellow");
+  EXPECT_FALSE(ParseGlassSurfaceConfigurationStrict(duplicate_ids));
+
+  const char* required_keys[] = {
+      kGlassAppearanceEnabledKey,
+      kGlassAppearanceMaterialKey,
+      kGlassAppearanceMaterialOpacityKey,
+      kGlassAppearanceGlassTintOpacityKey,
+      kGlassAppearanceGlassStyleKey,
+      kGlassAppearanceFrostedStyleKey,
+      kGlassAppearanceFrostedTintStrengthKey,
+      kGlassAppearanceTintStrengthKey,
+      kGlassAppearanceGrainKey,
+      kGlassAppearanceGrainScaleKey,
+      kGlassAppearancePointsKey,
+  };
+  for (const char* key : required_keys) {
+    base::DictValue missing_field = valid.Clone();
+    EXPECT_TRUE(missing_field.Remove(key));
+    EXPECT_FALSE(ParseGlassSurfaceConfigurationStrict(missing_field));
+  }
+}
+
+TEST(GlassSurfaceConfigurationTest, StrictParserAcceptsExactBoundariesAndInts) {
+  base::DictValue boundary =
+      SerializeGlassSurfaceConfiguration(DefaultGlassSurfaceConfiguration());
+  boundary.Set(kGlassAppearanceTintStrengthKey, 1);
+  boundary.Set(kGlassAppearanceGrainKey, 0.3);
+  boundary.Set(kGlassAppearanceMaterialOpacityKey, 0);
+  boundary.Set(kGlassAppearanceGlassTintOpacityKey, 1);
+  boundary.Set(kGlassAppearanceFrostedTintStrengthKey, 2);
+  boundary.Set(kGlassAppearanceGrainScaleKey, 2.0);
+
+  base::ListValue* points = boundary.FindList(kGlassAppearancePointsKey);
+  ASSERT_NE(points, nullptr);
+  ASSERT_FALSE(points->empty());
+  base::DictValue* point = (*points)[0].GetIfDict();
+  ASSERT_NE(point, nullptr);
+  point->Set(kGlassPointXKey, 0);
+  point->Set(kGlassPointYKey, 1);
+  point->Set(kGlassPointRadiusKey, 0.1);
+  point->Set(kGlassPointOpacityKey, 1);
+
+  std::optional<GlassSurfaceConfiguration> parsed =
+      ParseGlassSurfaceConfigurationStrict(boundary);
+  ASSERT_TRUE(parsed);
+  EXPECT_DOUBLE_EQ(parsed->tint_strength, 1.0);
+  EXPECT_DOUBLE_EQ(parsed->grain, 0.3);
+  EXPECT_DOUBLE_EQ(parsed->material_opacity, 0.0);
+  EXPECT_DOUBLE_EQ(parsed->glass_tint_opacity, 1.0);
+  EXPECT_DOUBLE_EQ(parsed->frosted_tint_strength, 2.0);
+  EXPECT_DOUBLE_EQ(parsed->grain_scale, 2.0);
+
+  base::DictValue lower_boundary = boundary.Clone();
+  lower_boundary.Set(kGlassAppearanceGrainScaleKey, 0.5);
+  std::optional<GlassSurfaceConfiguration> lower_parsed =
+      ParseGlassSurfaceConfigurationStrict(lower_boundary);
+  ASSERT_TRUE(lower_parsed);
+  EXPECT_DOUBLE_EQ(lower_parsed->grain_scale, 0.5);
+  EXPECT_DOUBLE_EQ(parsed->points[0].x, 0.0);
+  EXPECT_DOUBLE_EQ(parsed->points[0].y, 1.0);
+  EXPECT_DOUBLE_EQ(parsed->points[0].radius, 0.1);
+  EXPECT_DOUBLE_EQ(parsed->points[0].opacity, 1.0);
+
+  base::DictValue canonical = SerializeGlassSurfaceConfiguration(*parsed);
+  ASSERT_NE(canonical.FindDouble(kGlassAppearanceGrainKey), std::nullopt);
+  EXPECT_DOUBLE_EQ(*canonical.FindDouble(kGlassAppearanceGrainKey), 0.3);
+  base::ListValue* canonical_points =
+      canonical.FindList(kGlassAppearancePointsKey);
+  ASSERT_NE(canonical_points, nullptr);
+  base::DictValue* canonical_point = (*canonical_points)[0].GetIfDict();
+  ASSERT_NE(canonical_point, nullptr);
+  ASSERT_NE(canonical_point->FindDouble(kGlassPointRadiusKey), std::nullopt);
+  EXPECT_DOUBLE_EQ(*canonical_point->FindDouble(kGlassPointRadiusKey), 0.1);
+}
+
+TEST(GlassSurfaceConfigurationTest, PersistsMatchedColorAdjustments) {
+  auto configuration = DefaultGlassSurfaceConfiguration();
+  EXPECT_FALSE(configuration.match_color_adjustments);
+  configuration.match_color_adjustments = true;
+  auto serialized = SerializeGlassSurfaceConfiguration(configuration);
+  auto parsed = ParseGlassSurfaceConfigurationStrict(serialized);
+  ASSERT_TRUE(parsed);
+  EXPECT_TRUE(parsed->match_color_adjustments);
+  serialized.Set(kGlassAppearanceMatchColorAdjustmentsKey, 1);
+  EXPECT_FALSE(ParseGlassSurfaceConfigurationStrict(serialized));
+}
+
+TEST(GlassSurfaceConfigurationTest, CompletesOlderColorLinkSetting) {
+  auto saved =
+      SerializeGlassSurfaceConfiguration(DefaultGlassSurfaceConfiguration());
+  saved.Remove(kGlassAppearanceMatchColorAdjustmentsKey);
+  auto complete = CompleteGlassSurfaceConfigurationForEditing(saved);
+  auto parsed = ParseGlassSurfaceConfigurationStrict(complete);
+  ASSERT_TRUE(parsed);
+  EXPECT_FALSE(parsed->match_color_adjustments);
+}
+
