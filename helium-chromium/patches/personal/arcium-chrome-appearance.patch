+namespace helium {
+
+namespace {
+
+constexpr double kDefaultPointRadius = 0.5;
+constexpr double kMinimumPointRadius = 0.1;
+constexpr double kMaximumPointRadius = 1.5;
+constexpr double kMaximumGrain = 0.3;
+constexpr double kMinimumGrainScale = 0.5;
+constexpr double kMaximumGrainScale = 2.0;
+
+std::optional<double> FindNumber(const base::DictValue& dict,
+                                 std::string_view key) {
+  return dict.FindDouble(key);
+}
+
+double ReadClampedNumber(const base::DictValue& dict,
+                         std::string_view key,
+                         double default_value,
+                         double minimum,
+                         double maximum) {
+  std::optional<double> number = FindNumber(dict, key);
+  if (!number || !std::isfinite(*number)) {
+    return default_value;
+  }
+  return std::clamp(*number, minimum, maximum);
+}
+
+int HexDigit(char value) {
+  if (value >= '0' && value <= '9') {
+    return value - '0';
+  }
+  if (value >= 'a' && value <= 'f') {
+    return value - 'a' + 10;
+  }
+  if (value >= 'A' && value <= 'F') {
+    return value - 'A' + 10;
+  }
+  return -1;
+}
+
+bool ParseRgbColor(std::string_view value, SkColor4f* color) {
+  if (value.size() != 7 || value[0] != '#') {
+    return false;
+  }
+
+  int channels[3] = {};
+  for (size_t channel = 0; channel < 3; ++channel) {
+    const int high = HexDigit(value[1 + channel * 2]);
+    const int low = HexDigit(value[2 + channel * 2]);
+    if (high < 0 || low < 0) {
+      return false;
+    }
+    channels[channel] = high * 16 + low;
+  }
+
+  *color = {channels[0] / 255.0f, channels[1] / 255.0f, channels[2] / 255.0f,
+            1.0f};
+  return true;
+}
+
+GlassSurfaceMaterial ParseMaterial(std::string_view value,
+                                   GlassSurfaceMaterial fallback) {
+  if (value == kGlassAppearanceAuto) {
+    return GlassSurfaceMaterial::kAuto;
+  }
+  if (value == kGlassAppearanceLiquidGlass) {
+    return GlassSurfaceMaterial::kLiquidGlass;
+  }
+  if (value == kGlassAppearanceFrosted) {
+    return GlassSurfaceMaterial::kFrosted;
+  }
+  if (value == kGlassAppearanceSolid) {
+    return GlassSurfaceMaterial::kSolid;
+  }
+  return fallback;
+}
+
+std::optional<GlassSurfaceMaterial> ParseMaterialStrict(
+    std::string_view value) {
+  if (value == kGlassAppearanceAuto) {
+    return GlassSurfaceMaterial::kAuto;
+  }
+  if (value == kGlassAppearanceLiquidGlass) {
+    return GlassSurfaceMaterial::kLiquidGlass;
+  }
+  if (value == kGlassAppearanceFrosted) {
+    return GlassSurfaceMaterial::kFrosted;
+  }
+  if (value == kGlassAppearanceSolid) {
+    return GlassSurfaceMaterial::kSolid;
+  }
+  return std::nullopt;
+}
+
+GlassSurfaceGlassStyle ParseGlassStyle(std::string_view value) {
+  if (value == kGlassAppearanceGlassStyleClear) {
+    return GlassSurfaceGlassStyle::kClear;
+  }
+  return GlassSurfaceGlassStyle::kRegular;
+}
+
+std::optional<GlassSurfaceGlassStyle> ParseGlassStyleStrict(
+    std::string_view value) {
+  if (value == kGlassAppearanceGlassStyleRegular) {
+    return GlassSurfaceGlassStyle::kRegular;
+  }
+  if (value == kGlassAppearanceGlassStyleClear) {
+    return GlassSurfaceGlassStyle::kClear;
+  }
+  return std::nullopt;
+}
+
+const char* GlassStyleString(GlassSurfaceGlassStyle style) {
+  switch (style) {
+    case GlassSurfaceGlassStyle::kRegular:
+      return kGlassAppearanceGlassStyleRegular;
+    case GlassSurfaceGlassStyle::kClear:
+      return kGlassAppearanceGlassStyleClear;
+  }
+  return kGlassAppearanceGlassStyleRegular;
+}
+
+GlassSurfaceFrostedStyle ParseFrostedStyle(std::string_view value) {
+  if (value == kGlassAppearanceFrostedStyleSidebar) {
+    return GlassSurfaceFrostedStyle::kSidebar;
+  }
+  if (value == kGlassAppearanceFrostedStyleMenu) {
+    return GlassSurfaceFrostedStyle::kMenu;
+  }
+  if (value == kGlassAppearanceFrostedStylePopover) {
+    return GlassSurfaceFrostedStyle::kPopover;
+  }
+  if (value == kGlassAppearanceFrostedStyleHud) {
+    return GlassSurfaceFrostedStyle::kHud;
+  }
+  return GlassSurfaceFrostedStyle::kAutomatic;
+}
+
+std::optional<GlassSurfaceFrostedStyle> ParseFrostedStyleStrict(
+    std::string_view value) {
+  if (value == kGlassAppearanceFrostedStyleAutomatic) {
+    return GlassSurfaceFrostedStyle::kAutomatic;
+  }
+  if (value == kGlassAppearanceFrostedStyleSidebar) {
+    return GlassSurfaceFrostedStyle::kSidebar;
+  }
+  if (value == kGlassAppearanceFrostedStyleMenu) {
+    return GlassSurfaceFrostedStyle::kMenu;
+  }
+  if (value == kGlassAppearanceFrostedStylePopover) {
+    return GlassSurfaceFrostedStyle::kPopover;
+  }
+  if (value == kGlassAppearanceFrostedStyleHud) {
+    return GlassSurfaceFrostedStyle::kHud;
+  }
+  return std::nullopt;
+}
+
+const char* FrostedStyleString(GlassSurfaceFrostedStyle style) {
+  switch (style) {
+    case GlassSurfaceFrostedStyle::kAutomatic:
+      return kGlassAppearanceFrostedStyleAutomatic;
+    case GlassSurfaceFrostedStyle::kSidebar:
+      return kGlassAppearanceFrostedStyleSidebar;
+    case GlassSurfaceFrostedStyle::kMenu:
+      return kGlassAppearanceFrostedStyleMenu;
+    case GlassSurfaceFrostedStyle::kPopover:
+      return kGlassAppearanceFrostedStylePopover;
+    case GlassSurfaceFrostedStyle::kHud:
+      return kGlassAppearanceFrostedStyleHud;
+  }
+  return kGlassAppearanceFrostedStyleAutomatic;
+}
+
+const char* MaterialString(GlassSurfaceMaterial material) {
+  switch (material) {
+    case GlassSurfaceMaterial::kAuto:
+      return kGlassAppearanceAuto;
+    case GlassSurfaceMaterial::kLiquidGlass:
+      return kGlassAppearanceLiquidGlass;
+    case GlassSurfaceMaterial::kFrosted:
+      return kGlassAppearanceFrosted;
+    case GlassSurfaceMaterial::kSolid:
+      return kGlassAppearanceSolid;
+  }
+  return kGlassAppearanceAuto;
+}
+
+bool IsKnownTopLevelKey(std::string_view key) {
+  return key == kGlassAppearanceEnabledKey ||
+         key == kGlassAppearanceMaterialKey ||
+         key == kGlassAppearanceMaterialOpacityKey ||
+         key == kGlassAppearanceGlassTintOpacityKey ||
+         key == kGlassAppearanceGlassStyleKey ||
+         key == kGlassAppearanceFrostedStyleKey ||
+         key == kGlassAppearanceFrostedTintStrengthKey ||
+         key == kGlassAppearanceTintStrengthKey ||
+         key == kGlassAppearanceGrainKey ||
+         key == kGlassAppearanceGrainScaleKey ||
+         key == kGlassAppearancePointsKey ||
+         key == kGlassAppearanceMatchColorAdjustmentsKey;
+}
+
+bool IsKnownPointKey(std::string_view key) {
+  return key == kGlassPointIdKey || key == kGlassPointColorKey ||
+         key == kGlassPointXKey || key == kGlassPointYKey ||
+         key == kGlassPointRadiusKey || key == kGlassPointOpacityKey;
+}
+
+bool HasPointId(const GlassSurfaceConfiguration& configuration,
+                std::string_view id) {
+  for (size_t i = 0; i < configuration.point_count; ++i) {
+    if (configuration.points[i].id == id) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool HasFiniteNumberInRange(const base::DictValue& dict,
+                            std::string_view key,
+                            double minimum,
+                            double maximum,
+                            double* output) {
+  const std::optional<double> number = dict.FindDouble(key);
+  if (!number || !std::isfinite(*number) || *number < minimum ||
+      *number > maximum) {
+    return false;
+  }
+  *output = *number;
+  return true;
+}
+
+int ColorByte(float component) {
+  if (!std::isfinite(component)) {
+    return 0;
+  }
+  return static_cast<int>(
+      std::lround(std::clamp(component, 0.0f, 1.0f) * 255.0f));
+}
+
+std::string ColorString(const SkColor4f& color) {
+  return base::StringPrintf("#%02X%02X%02X", ColorByte(color.fR),
+                            ColorByte(color.fG), ColorByte(color.fB));
+}
+
+double CanonicalNumber(double value, double minimum, double maximum) {
+  if (!std::isfinite(value)) {
+    return minimum;
+  }
+  return std::clamp(value, minimum, maximum);
+}
+
+}  // namespace
+
+GlassSurfaceConfiguration DefaultGlassSurfaceConfiguration() {
+  GlassSurfaceConfiguration configuration;
+  configuration.tint_strength = 0.4;
+  configuration.grain = 0.06;
+  configuration.points[0] = {.id = "yellow",
+                             .color = {0.937255f, 0.780392f, 0.4f, 1.0f},
+                             .x = 0.18,
+                             .y = 0.2,
+                             .radius = 0.8,
+                             .opacity = 0.5};
+  configuration.points[1] = {.id = "blue",
+                             .color = {0.411765f, 0.576471f, 0.929412f, 1.0f},
+                             .x = 0.8,
+                             .y = 0.65,
+                             .radius = 0.9,
+                             .opacity = 0.4};
+  configuration.point_count = 2;
+  return configuration;
+}
+
+GlassSurfaceConfiguration ParseGlassSurfaceConfiguration(
+    const base::DictValue& dict) {
+  GlassSurfaceConfiguration configuration = DefaultGlassSurfaceConfiguration();
+
+  configuration.enabled =
+      dict.FindBool(kGlassAppearanceEnabledKey).value_or(configuration.enabled);
+  configuration.match_color_adjustments =
+      dict.FindBool(kGlassAppearanceMatchColorAdjustmentsKey).value_or(false);
+  if (const std::string* material =
+          dict.FindString(kGlassAppearanceMaterialKey)) {
+    configuration.material = ParseMaterial(*material, configuration.material);
+  }
+  configuration.material_opacity =
+      ReadClampedNumber(dict, kGlassAppearanceMaterialOpacityKey,
+                        configuration.material_opacity, 0.0, 1.0);
+  configuration.glass_tint_opacity =
+      ReadClampedNumber(dict, kGlassAppearanceGlassTintOpacityKey,
+                        configuration.glass_tint_opacity, 0.0, 1.0);
+  if (const std::string* glass_style =
+          dict.FindString(kGlassAppearanceGlassStyleKey)) {
+    configuration.glass_style = ParseGlassStyle(*glass_style);
+  }
+  if (const std::string* frosted_style =
+          dict.FindString(kGlassAppearanceFrostedStyleKey)) {
+    configuration.frosted_style = ParseFrostedStyle(*frosted_style);
+  }
+  configuration.frosted_tint_strength =
+      ReadClampedNumber(dict, kGlassAppearanceFrostedTintStrengthKey,
+                        configuration.frosted_tint_strength, 0.0, 2.0);
+  configuration.tint_strength =
+      ReadClampedNumber(dict, kGlassAppearanceTintStrengthKey,
+                        configuration.tint_strength, 0.0, 1.0);
+  configuration.grain = ReadClampedNumber(
+      dict, kGlassAppearanceGrainKey, configuration.grain, 0.0, kMaximumGrain);
+  configuration.grain_scale = ReadClampedNumber(
+      dict, kGlassAppearanceGrainScaleKey, configuration.grain_scale,
+      kMinimumGrainScale, kMaximumGrainScale);
+
+  const base::ListValue* points = dict.FindList(kGlassAppearancePointsKey);
+  if (!points) {
+    return configuration;
+  }
+
+  configuration.point_count = 0;
+  for (const base::Value& value : *points) {
+    if (configuration.point_count == kMaxGlassColorPoints) {
+      break;
+    }
+    const base::DictValue* point_dict = value.GetIfDict();
+    if (!point_dict) {
+      continue;
+    }
+    const std::string* id = point_dict->FindString(kGlassPointIdKey);
+    if (!id || id->empty() || HasPointId(configuration, *id)) {
+      continue;
+    }
+    const std::string* color_string =
+        point_dict->FindString(kGlassPointColorKey);
+    GlassColorPoint point;
+    if (!color_string || !ParseRgbColor(*color_string, &point.color)) {
+      continue;
+    }
+    point.id = *id;
+    point.x = ReadClampedNumber(*point_dict, kGlassPointXKey, 0.5, 0.0, 1.0);
+    point.y = ReadClampedNumber(*point_dict, kGlassPointYKey, 0.5, 0.0, 1.0);
+    point.radius = ReadClampedNumber(*point_dict, kGlassPointRadiusKey,
+                                     kDefaultPointRadius, kMinimumPointRadius,
+                                     kMaximumPointRadius);
+    point.opacity =
+        ReadClampedNumber(*point_dict, kGlassPointOpacityKey, 0.0, 0.0, 1.0);
+    configuration.points[configuration.point_count++] = std::move(point);
+  }
+
+  return configuration;
+}
+
+std::optional<GlassSurfaceConfiguration> ParseGlassSurfaceConfigurationStrict(
+    const base::DictValue& dict) {
+  if (dict.size() != 12) {
+    return std::nullopt;
+  }
+  for (const auto item : dict) {
+    if (!IsKnownTopLevelKey(item.first)) {
+      return std::nullopt;
+    }
+  }
+
+  const std::optional<bool> enabled = dict.FindBool(kGlassAppearanceEnabledKey);
+  const std::optional<bool> match_color_adjustments =
+      dict.FindBool(kGlassAppearanceMatchColorAdjustmentsKey);
+  const std::string* material_string =
+      dict.FindString(kGlassAppearanceMaterialKey);
+  const std::optional<GlassSurfaceMaterial> material =
+      material_string ? ParseMaterialStrict(*material_string) : std::nullopt;
+  const std::string* glass_style_string =
+      dict.FindString(kGlassAppearanceGlassStyleKey);
+  const std::optional<GlassSurfaceGlassStyle> glass_style =
+      glass_style_string ? ParseGlassStyleStrict(*glass_style_string)
+                         : std::nullopt;
+  const std::string* frosted_style_string =
+      dict.FindString(kGlassAppearanceFrostedStyleKey);
+  const std::optional<GlassSurfaceFrostedStyle> frosted_style =
+      frosted_style_string ? ParseFrostedStyleStrict(*frosted_style_string)
+                           : std::nullopt;
+  if (!enabled || !match_color_adjustments || !material || !glass_style ||
+      !frosted_style) {
+    return std::nullopt;
+  }
+
+  GlassSurfaceConfiguration configuration;
+  configuration.enabled = *enabled;
+  configuration.match_color_adjustments = *match_color_adjustments;
+  configuration.material = *material;
+  configuration.glass_style = *glass_style;
+  configuration.frosted_style = *frosted_style;
+  if (!HasFiniteNumberInRange(dict, kGlassAppearanceMaterialOpacityKey, 0.0,
+                              1.0, &configuration.material_opacity) ||
+      !HasFiniteNumberInRange(dict, kGlassAppearanceGlassTintOpacityKey, 0.0,
+                              1.0, &configuration.glass_tint_opacity) ||
+      !HasFiniteNumberInRange(dict, kGlassAppearanceFrostedTintStrengthKey, 0.0,
+                              2.0, &configuration.frosted_tint_strength) ||
+      !HasFiniteNumberInRange(dict, kGlassAppearanceTintStrengthKey, 0.0, 1.0,
+                              &configuration.tint_strength) ||
+      !HasFiniteNumberInRange(dict, kGlassAppearanceGrainKey, 0.0,
+                              kMaximumGrain, &configuration.grain) ||
+      !HasFiniteNumberInRange(dict, kGlassAppearanceGrainScaleKey,
+                              kMinimumGrainScale, kMaximumGrainScale,
+                              &configuration.grain_scale)) {
+    return std::nullopt;
+  }
+
+  const base::ListValue* points = dict.FindList(kGlassAppearancePointsKey);
+  if (!points || points->size() > kMaxGlassColorPoints) {
+    return std::nullopt;
+  }
+
+  for (const base::Value& value : *points) {
+    const base::DictValue* point_dict = value.GetIfDict();
+    if (!point_dict || point_dict->size() != 6) {
+      return std::nullopt;
+    }
+    for (const auto item : *point_dict) {
+      if (!IsKnownPointKey(item.first)) {
+        return std::nullopt;
+      }
+    }
+
+    const std::string* id = point_dict->FindString(kGlassPointIdKey);
+    const std::string* color_string =
+        point_dict->FindString(kGlassPointColorKey);
+    GlassColorPoint point;
+    if (!id || id->empty() || HasPointId(configuration, *id) || !color_string ||
+        !ParseRgbColor(*color_string, &point.color) ||
+        !HasFiniteNumberInRange(*point_dict, kGlassPointXKey, 0.0, 1.0,
+                                &point.x) ||
+        !HasFiniteNumberInRange(*point_dict, kGlassPointYKey, 0.0, 1.0,
+                                &point.y) ||
+        !HasFiniteNumberInRange(*point_dict, kGlassPointRadiusKey,
+                                kMinimumPointRadius, kMaximumPointRadius,
+                                &point.radius) ||
+        !HasFiniteNumberInRange(*point_dict, kGlassPointOpacityKey, 0.0, 1.0,
+                                &point.opacity)) {
+      return std::nullopt;
+    }
+    point.id = *id;
+    configuration.points[configuration.point_count++] = std::move(point);
+  }
+
+  return configuration;
+}
+
+base::DictValue SerializeGlassSurfaceConfiguration(
+    const GlassSurfaceConfiguration& configuration) {
+  base::ListValue points = base::ListValue::with_capacity(
+      std::min(configuration.point_count, kMaxGlassColorPoints));
+  std::array<std::string, kMaxGlassColorPoints> point_ids;
+  size_t point_count = 0;
+  for (size_t i = 0;
+       i < std::min(configuration.point_count, kMaxGlassColorPoints); ++i) {
+    const GlassColorPoint& point = configuration.points[i];
+    if (point.id.empty() ||
+        std::find(point_ids.begin(), point_ids.begin() + point_count,
+                  point.id) != point_ids.begin() + point_count) {
+      continue;
+    }
+    point_ids[point_count++] = point.id;
+    base::DictValue serialized_point;
+    serialized_point.Set(kGlassPointIdKey, point.id);
+    serialized_point.Set(kGlassPointColorKey, ColorString(point.color));
+    serialized_point.Set(kGlassPointXKey, CanonicalNumber(point.x, 0.0, 1.0));
+    serialized_point.Set(kGlassPointYKey, CanonicalNumber(point.y, 0.0, 1.0));
+    serialized_point.Set(kGlassPointRadiusKey,
+                         CanonicalNumber(point.radius, kMinimumPointRadius,
+                                         kMaximumPointRadius));
+    serialized_point.Set(kGlassPointOpacityKey,
+                         CanonicalNumber(point.opacity, 0.0, 1.0));
+    points.Append(std::move(serialized_point));
+  }
+
+  base::DictValue result;
+  result.Set(kGlassAppearanceEnabledKey, configuration.enabled);
+  result.Set(kGlassAppearanceMatchColorAdjustmentsKey,
+             configuration.match_color_adjustments);
+  result.Set(kGlassAppearanceMaterialKey,
+             MaterialString(configuration.material));
+  result.Set(kGlassAppearanceMaterialOpacityKey,
+             CanonicalNumber(configuration.material_opacity, 0.0, 1.0));
+  result.Set(kGlassAppearanceGlassTintOpacityKey,
+             CanonicalNumber(configuration.glass_tint_opacity, 0.0, 1.0));
+  result.Set(kGlassAppearanceGlassStyleKey,
+             GlassStyleString(configuration.glass_style));
+  result.Set(kGlassAppearanceFrostedStyleKey,
+             FrostedStyleString(configuration.frosted_style));
+  result.Set(kGlassAppearanceFrostedTintStrengthKey,
+             CanonicalNumber(configuration.frosted_tint_strength, 0.0, 2.0));
+  result.Set(kGlassAppearanceTintStrengthKey,
+             CanonicalNumber(configuration.tint_strength, 0.0, 1.0));
+  result.Set(kGlassAppearanceGrainKey,
+             CanonicalNumber(configuration.grain, 0.0, kMaximumGrain));
+  result.Set(kGlassAppearanceGrainScaleKey,
+             CanonicalNumber(configuration.grain_scale, kMinimumGrainScale,
+                             kMaximumGrainScale));
+  result.Set(kGlassAppearancePointsKey, std::move(points));
+  return result;
+}
+
+base::DictValue CompleteGlassSurfaceConfigurationForEditing(
+    const base::DictValue& saved) {
+  base::DictValue complete =
+      SerializeGlassSurfaceConfiguration(DefaultGlassSurfaceConfiguration());
+  complete.Merge(saved.Clone());
+  return complete;
+}
+
+GlassSurfaceConfiguration ReadGlassSurfaceConfiguration(
+    const PrefService* prefs) {
+  if (!prefs) {
+    return DefaultGlassSurfaceConfiguration();
+  }
+  return ParseGlassSurfaceConfiguration(
+      prefs->GetDict(kArciumChromeAppearancePref));
+}
+
+GlassSurfaceResolution ResolveGlassSurfaceConfiguration(
+    const GlassSurfaceConfiguration& configuration,
+    GlassBackend requested,
+    bool native_liquid_glass,
+    bool native_frosted,
+    bool reduce_transparency) {
+  GlassSurfaceResolution resolution;
+  resolution.enabled = configuration.enabled;
+  resolution.configured = configuration.material;
+  resolution.active = configuration.material;
+  resolution.fallback_reason = "none";
+
+  if (!configuration.enabled) {
+    resolution.fallback_reason = "disabled";
+    return resolution;
+  }
+
+  // These are process-wide safety/diagnostic overrides. They suppress the
+  // transparent Chrome Views gates too; otherwise the custom surface would be
+  // covered by the opaque frame while the settings page claimed it was active.
+  if (reduce_transparency) {
+    resolution.active = GlassSurfaceMaterial::kSolid;
+    resolution.fallback_reason = "reduce-transparency";
+    return resolution;
+  }
+
+  if (requested == GlassBackend::kOpaque) {
+    resolution.active = GlassSurfaceMaterial::kSolid;
+    resolution.fallback_reason = "command-line-opaque";
+    return resolution;
+  }
+  if (requested == GlassBackend::kChromium) {
+    resolution.active = GlassSurfaceMaterial::kSolid;
+    resolution.fallback_reason = "command-line-chromium-unsupported";
+    return resolution;
+  }
+
+  if (requested == GlassBackend::kNativeLiquidGlass) {
+    if (native_liquid_glass) {
+      resolution.active = GlassSurfaceMaterial::kLiquidGlass;
+      if (configuration.material != GlassSurfaceMaterial::kLiquidGlass) {
+        resolution.fallback_reason = "command-line-override";
+      }
+    } else if (native_frosted) {
+      resolution.active = GlassSurfaceMaterial::kFrosted;
+      resolution.fallback_reason = "command-line-liquid-glass-unavailable";
+    } else {
+      resolution.active = GlassSurfaceMaterial::kSolid;
+      resolution.fallback_reason = "command-line-liquid-glass-unavailable";
+    }
+  } else if (requested == GlassBackend::kNativeMaterial) {
+    if (native_frosted) {
+      resolution.active = GlassSurfaceMaterial::kFrosted;
+      if (configuration.material != GlassSurfaceMaterial::kFrosted) {
+        resolution.fallback_reason = "command-line-override";
+      }
+    } else {
+      resolution.active = GlassSurfaceMaterial::kSolid;
+      resolution.fallback_reason = "command-line-frosted-unavailable";
+    }
+  } else {
+    switch (configuration.material) {
+      case GlassSurfaceMaterial::kAuto:
+        if (native_liquid_glass) {
+          resolution.active = GlassSurfaceMaterial::kLiquidGlass;
+        } else if (native_frosted) {
+          resolution.active = GlassSurfaceMaterial::kFrosted;
+        } else {
+          resolution.active = GlassSurfaceMaterial::kSolid;
+          resolution.fallback_reason = "no-supported-renderer";
+        }
+        break;
+      case GlassSurfaceMaterial::kLiquidGlass:
+        if (native_liquid_glass) {
+          resolution.active = GlassSurfaceMaterial::kLiquidGlass;
+        } else if (native_frosted) {
+          resolution.active = GlassSurfaceMaterial::kFrosted;
+          resolution.fallback_reason = "liquid-glass-unavailable";
+        } else {
+          resolution.active = GlassSurfaceMaterial::kSolid;
+          resolution.fallback_reason = "liquid-glass-unavailable";
+        }
+        break;
+      case GlassSurfaceMaterial::kFrosted:
+        if (!native_frosted) {
+          resolution.active = GlassSurfaceMaterial::kSolid;
+          resolution.fallback_reason = "frosted-unavailable";
+        }
+        break;
+      case GlassSurfaceMaterial::kSolid:
+        break;
+    }
+  }
+
+  resolution.uses_translucent_native_base =
+      resolution.active == GlassSurfaceMaterial::kLiquidGlass ||
+      resolution.active == GlassSurfaceMaterial::kFrosted;
+  // A solid profile surface still needs transparent Chrome Views so its color
+  // points and grain can be seen through the browser frame. The window itself
+  // stays on the stable translucent initialization path while this profile
+  // setting is enabled; a solid base covers the surface when transparency is
+  // unavailable.
+  resolution.paints_chrome_transparent = true;
+  return resolution;
+}
+
+}  // namespace helium
