+    return GlassSurfaceColorHarmony::kSplitComplementary;
+  }
+  if (value == kGlassAppearanceColorHarmonyTriadic) {
+    return GlassSurfaceColorHarmony::kTriadic;
+  }
+  if (value == kGlassAppearanceColorHarmonyTetradic) {
+    return GlassSurfaceColorHarmony::kTetradic;
+  }
+  return fallback;
+}
