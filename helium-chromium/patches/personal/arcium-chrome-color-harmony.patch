+TEST(GlassSurfaceConfigurationTest,
+     StrictParserAcceptsLegacyDictionaryWithoutColorHarmony) {
+  base::DictValue legacy =
+      SerializeGlassSurfaceConfiguration(DefaultGlassSurfaceConfiguration());
+  EXPECT_TRUE(legacy.Remove(kGlassAppearanceColorHarmonyKey));
+  EXPECT_EQ(legacy.size(), 12u);
+
+  std::optional<GlassSurfaceConfiguration> parsed =
+      ParseGlassSurfaceConfigurationStrict(legacy);
+  ASSERT_TRUE(parsed);
+  EXPECT_EQ(parsed->color_harmony, GlassSurfaceColorHarmony::kCustom);
+}
+
+TEST(GlassSurfaceConfigurationTest, StrictParserRoundTripsColorHarmonyModes) {
+  struct HarmonyCase {
+    const char* serialized;
+    GlassSurfaceColorHarmony value;
+  };
+  const HarmonyCase cases[] = {
+      {kGlassAppearanceColorHarmonyCustom,
+       GlassSurfaceColorHarmony::kCustom},
+      {kGlassAppearanceColorHarmonyComplementary,
+       GlassSurfaceColorHarmony::kComplementary},
+      {kGlassAppearanceColorHarmonySplitComplementary,
+       GlassSurfaceColorHarmony::kSplitComplementary},
+      {kGlassAppearanceColorHarmonyTriadic, GlassSurfaceColorHarmony::kTriadic},
+      {kGlassAppearanceColorHarmonyTetradic,
+       GlassSurfaceColorHarmony::kTetradic},
+  };
+
+  for (const HarmonyCase& harmony_case : cases) {
+    base::DictValue serialized = SerializeGlassSurfaceConfiguration(
+        DefaultGlassSurfaceConfiguration());
+    serialized.Set(kGlassAppearanceColorHarmonyKey, harmony_case.serialized);
+
+    std::optional<GlassSurfaceConfiguration> parsed =
+        ParseGlassSurfaceConfigurationStrict(serialized);
+    ASSERT_TRUE(parsed) << harmony_case.serialized;
+    EXPECT_EQ(parsed->color_harmony, harmony_case.value);
+    const base::DictValue canonical =
+        SerializeGlassSurfaceConfiguration(*parsed);
+    ASSERT_NE(canonical.FindString(kGlassAppearanceColorHarmonyKey), nullptr);
+    EXPECT_STREQ(canonical.FindString(kGlassAppearanceColorHarmonyKey)->c_str(),
+                 harmony_case.serialized);
+  }
+}
+
+TEST(GlassSurfaceConfigurationTest,
+     StrictParserRequiresValidColorHarmonyWhenPresent) {
+  base::DictValue missing =
+      SerializeGlassSurfaceConfiguration(DefaultGlassSurfaceConfiguration());
+  EXPECT_TRUE(missing.Remove(kGlassAppearanceColorHarmonyKey));
+  // Removing the harmony field makes this a valid legacy twelve-field value.
+  EXPECT_TRUE(ParseGlassSurfaceConfigurationStrict(missing));
+
+  base::DictValue missing_old_field = SerializeGlassSurfaceConfiguration(
+      DefaultGlassSurfaceConfiguration());
+  EXPECT_TRUE(missing_old_field.Remove(kGlassAppearanceMaterialKey));
+  EXPECT_EQ(missing_old_field.size(), 12u);
+  EXPECT_FALSE(ParseGlassSurfaceConfigurationStrict(missing_old_field));
+
+  base::DictValue invalid =
+      SerializeGlassSurfaceConfiguration(DefaultGlassSurfaceConfiguration());
+  invalid.Set(kGlassAppearanceColorHarmonyKey, "unknown");
+  EXPECT_FALSE(ParseGlassSurfaceConfigurationStrict(invalid));
+
+  base::DictValue wrong_type = SerializeGlassSurfaceConfiguration(
+      DefaultGlassSurfaceConfiguration());
+  wrong_type.Set(kGlassAppearanceColorHarmonyKey, 1);
+  EXPECT_FALSE(ParseGlassSurfaceConfigurationStrict(wrong_type));
+}
+
+TEST(GlassSurfaceConfigurationTest,
+     PermissiveParserCanonicalizesUnknownColorHarmony) {
+  base::DictValue dict;
+  dict.Set(kGlassAppearanceColorHarmonyKey, "unknown");
+
+  const GlassSurfaceConfiguration configuration =
+      ParseGlassSurfaceConfiguration(dict);
+  EXPECT_EQ(configuration.color_harmony, GlassSurfaceColorHarmony::kCustom);
+
+  const base::DictValue canonical =
+      SerializeGlassSurfaceConfiguration(configuration);
+  ASSERT_NE(canonical.FindString(kGlassAppearanceColorHarmonyKey), nullptr);
+  EXPECT_STREQ(canonical.FindString(kGlassAppearanceColorHarmonyKey)->c_str(),
+               kGlassAppearanceColorHarmonyCustom);
+}
