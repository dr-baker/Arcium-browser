+class MRUTabPreviewCacheTest : public BrowserWithTestWindowTest {
+ protected:
+  std::unique_ptr<MRUTabPreviewCache> MakeCache(bool enabled = false) {
+    return std::make_unique<MRUTabPreviewCache>(
+        browser()->tab_strip_model(),
+        base::BindRepeating([] { return gfx::Size(800, 450); }),
+        base::BindRepeating([](bool enabled) { return enabled; }, enabled));
+  }
+  tabs::TabHandle AddHandle() {
+    AddTab(browser(), GURL("https://example.test/"));
+    return browser()->tab_strip_model()->GetActiveTab()->GetHandle();
+  }
+  void Put(MRUTabPreviewCache& cache, tabs::TabHandle handle, int width) {
+    SkBitmap bitmap;
+    bitmap.allocN32Pixels(width, width * 9 / 16);
+    bitmap.eraseColor(SK_ColorBLUE);
+    cache.Store(handle, gfx::ImageSkia::CreateFrom1xBitmap(bitmap));
+  }
+  void Budget(MRUTabPreviewCache& cache, size_t bytes) { cache.budget_ = bytes; }
+  size_t Bytes(const MRUTabPreviewCache& cache) { return cache.bytes_; }
+  void Release(MRUTabPreviewCache& cache) { cache.OnReleaseMemory(); }
+  void SeedThumbnail(tabs::TabHandle handle) {
+    auto* contents = handle.Get()->GetContents();
+    if (!ThumbnailTabHelper::FromWebContents(contents)) {
+      ThumbnailTabHelper::CreateForWebContents(contents);
+    }
+    SkBitmap bitmap;
+    bitmap.allocN32Pixels(160, 90);
+    bitmap.eraseColor(SK_ColorBLUE);
+    ThumbnailTabHelper::FromWebContents(contents)->thumbnail()->AssignSkBitmap(
+        bitmap);
+    content::RunAllTasksUntilIdle();
+  }
+  size_t Running(const MRUTabPreviewCache& cache) { return cache.running_.size(); }
+  size_t Queued(const MRUTabPreviewCache& cache) { return cache.queued_.size(); }
+  tabs::TabHandle NextQueued(const MRUTabPreviewCache& cache) {
+    return cache.queued_.front()->handle;
+  }
+  bool ReadyToCapture(content::WebContents* contents) {
+    return MRUTabPreviewCache::IsPageReadyForCapture(contents);
+  }
+  void CompleteCapture(MRUTabPreviewCache& cache, tabs::TabHandle handle,
+                       content::WeakDocumentPtr document) {
+    SkBitmap bitmap;
+    bitmap.allocN32Pixels(160, 90);
+    bitmap.eraseColor(SK_ColorBLUE);
+    cache.Captured(handle, handle.Get()->GetContents()->GetWeakPtr(), document,
+                   0, gfx::ImageSkia::CreateFrom1xBitmap(bitmap));
+  }
+};
+
+class PreviewLoadObserver : public content::WebContentsObserver {
+ public:
+  explicit PreviewLoadObserver(content::WebContents* contents)
+      : content::WebContentsObserver(contents) {}
+  void DidStartLoading() override { ++loads; }
+  int loads = 0;
+};
+
+TEST_F(MRUTabPreviewCacheTest, ActiveCapturePublishesWithoutDeactivation) {
+  const auto handle = AddHandle();
+  SeedThumbnail(handle);
+  auto* contents = handle.Get()->GetContents();
+  content::WebContentsTester::For(contents)->TestDidFirstVisuallyNonEmptyPaint();
+  ASSERT_TRUE(ReadyToCapture(contents));
+  auto cache = MakeCache(true);
+  ASSERT_TRUE(cache->Get(handle).isNull());
+  int updates = 0;
+  auto subscription = cache->SubscribeToCaptures(base::BindRepeating(
+      [](tabs::TabHandle expected, int* updates, tabs::TabHandle actual,
+         gfx::ImageSkia image) {
+        EXPECT_EQ(expected, actual);
+        EXPECT_FALSE(image.isNull());
+        ++*updates;
+      }, handle, &updates));
+  // Rebuilding the selected rail cancels decodes, not a valid page capture.
+  cache->CancelPendingRequests();
+  CompleteCapture(*cache, handle,
+                  contents->GetPrimaryMainFrame()->GetWeakDocumentPtr());
+  EXPECT_EQ(updates, 1);
+  EXPECT_FALSE(cache->Get(handle).isNull());
+  EXPECT_EQ(browser()->tab_strip_model()->GetActiveTab()->GetHandle(), handle);
+}
+
+TEST_F(MRUTabPreviewCacheTest, ActiveCaptureRejectsNavigationAndMemoryRelease) {
+  const auto handle = AddHandle();
+  SeedThumbnail(handle);
+  auto* contents = handle.Get()->GetContents();
+  content::WebContentsTester::For(contents)->TestDidFirstVisuallyNonEmptyPaint();
+  auto document = contents->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+  auto cache = MakeCache(true);
+  int updates = 0;
+  auto subscription = cache->SubscribeToCaptures(base::BindRepeating(
+      [](int* updates, tabs::TabHandle, gfx::ImageSkia) { ++*updates; },
+      &updates));
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(
+      contents, GURL("https://next.test/"));
+  content::WebContentsTester::For(contents)->TestDidFirstVisuallyNonEmptyPaint();
+  CompleteCapture(*cache, handle, document);
+  EXPECT_TRUE(cache->Get(handle).isNull());
+  Release(*cache);
+  CompleteCapture(*cache, handle,
+                  contents->GetPrimaryMainFrame()->GetWeakDocumentPtr());
+  EXPECT_TRUE(cache->Get(handle).isNull());
+  EXPECT_EQ(updates, 0);
+}
+
+TEST_F(MRUTabPreviewCacheTest, FiveVisibleCardsWaitBehindStaleDecodes) {
+  std::vector<tabs::TabHandle> handles;
+  for (int i = 0; i < 7; ++i) {
+    handles.push_back(AddHandle());
+    SeedThumbnail(handles.back());
+  }
+  auto cache = MakeCache(true);
+  const gfx::Size size(160, 90);
+  int obsolete_callbacks = 0;
+  for (size_t i = 0; i < 2; ++i) {
+    cache->Request(handles[i], size, base::BindOnce(
+        [](int* count, gfx::ImageSkia) { ++*count; }, &obsolete_callbacks));
+  }
+  ASSERT_EQ(Running(*cache), 2u);
+  cache->CancelPendingRequests();
+  int visible_callbacks = 0;
+  for (size_t i = 2; i < handles.size(); ++i) {
+    cache->Request(handles[i], size, base::BindOnce(
+        [](int* count, gfx::ImageSkia image) {
+          EXPECT_FALSE(image.isNull());
+          ++*count;
+        }, &visible_callbacks), i == 2);
+  }
+  EXPECT_EQ(Running(*cache), 2u);
+  EXPECT_EQ(Queued(*cache), 5u);
+  EXPECT_EQ(NextQueued(*cache), handles[2]);
+  content::RunAllTasksUntilIdle();
+  EXPECT_EQ(obsolete_callbacks, 0);
+  EXPECT_EQ(visible_callbacks, 5);
+}
