+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_MRU_TAB_PREVIEW_RAIL_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_MRU_TAB_PREVIEW_RAIL_H_
+
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "components/tabs/public/tab_interface.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+
+class BrowserView;
+namespace content { class WebContents; }
+namespace gfx { class ImageSkia; }
+namespace views { class ImageView; class Label; }
+
+// The MRU feature owns card layout and cached images. The hosting overlay owns
+// glass/materials and event handling.
+class MRUTabPreviewRail : public views::View {
+  METADATA_HEADER(MRUTabPreviewRail, views::View)
+
+ public:
+  explicit MRUTabPreviewRail(BrowserView* browser_view);
+  ~MRUTabPreviewRail() override;
+  void Update(const std::vector<content::WebContents*>& tabs, size_t selected);
+  void SetLabelContrast(SkColor background, bool shadow);
+
+ private:
+  struct Card {
+    raw_ptr<views::View> container;
+    raw_ptr<views::ImageView> preview;
+    raw_ptr<views::ImageView> placeholder;
+    raw_ptr<views::Label> title;
+    bool selected;
+    tabs::TabHandle handle;
+  };
+  void OnThumbnail(size_t card, gfx::ImageSkia image);
+  void OnCaptured(tabs::TabHandle handle, gfx::ImageSkia image);
+  const raw_ptr<BrowserView> browser_view_;
+  raw_ptr<views::View> cards_view_;
+  raw_ptr<views::Label> position_;
+  std::vector<Card> cards_;
+  SkColor background_ = SkColorSetRGB(28, 28, 30);
+  bool shadow_ = false;
+  base::CallbackListSubscription capture_subscription_;
+  base::WeakPtrFactory<MRUTabPreviewRail> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_MRU_TAB_PREVIEW_RAIL_H_
