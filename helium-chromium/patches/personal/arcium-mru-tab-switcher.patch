+gfx::Size CalculateMRUPreviewSize(BrowserView* browser_view) {
+  const int available_width = std::max(browser_view->width(), 640);
+  const int available_height = std::max(browser_view->height(), 480);
+  int width = std::clamp(available_width * 48 / 100, 408, 720);
+  int height = width * 9 / 16;
+  const int maximum_height =
+      std::clamp(available_height * 48 / 100, 230, 405);
+  if (height > maximum_height) {
+    height = maximum_height;
+    width = height * 16 / 9;
+  }
+  return gfx::Size(width, height);
+}
