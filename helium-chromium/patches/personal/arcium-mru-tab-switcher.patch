+// Displays the selected tab while Ctrl+Tab walks a stable MRU snapshot.
+class MRUTabSwitcherOverlay : public views::ViewObserver {
+ public:
+  explicit MRUTabSwitcherOverlay(BrowserView* browser_view)
+      : browser_view_(browser_view) {
+    browser_view_->AddObserver(this);
+  }
+  MRUTabSwitcherOverlay(const MRUTabSwitcherOverlay&) = delete;
+  MRUTabSwitcherOverlay& operator=(const MRUTabSwitcherOverlay&) = delete;
+  ~MRUTabSwitcherOverlay() override {
+    browser_view_->RemoveObserver(this);
+    if (bubble_) {
+      auto* bubble = bubble_.get();
+      bubble_ = nullptr;
+      browser_view_->RemoveChildViewT(bubble);
+    }
+  }
+
+  void Update(const std::vector<content::WebContents*>& starting_tabs,
+              content::WebContents* selected_tab) {
+    if (!starting_tabs.empty()) {
+      tabs_ = starting_tabs;
+    }
+    const auto selected = std::find(tabs_.begin(), tabs_.end(), selected_tab);
+    if (selected == tabs_.end()) {
+      return;
+    }
+    selected_index_ = selected - tabs_.begin();
+    EnsureView();
+    bubble_->Update(tabs_, selected_index_);
+    PositionView();
+    bubble_->SetVisible(true);
+  }
+
+  class BubbleView : public views::View {
+    METADATA_HEADER(BubbleView, views::View)
+
+   public:
+    explicit BubbleView(BrowserView* browser_view)
+        : browser_view_(browser_view) {
+      GetViewAccessibility().SetRole(ax::mojom::Role::kGroup);
+      GetViewAccessibility().SetName(
+          l10n_util::GetStringUTF16(IDS_RECENT_TABS_MENU));
+      SetLayoutManager(std::make_unique<views::FillLayout>());
+      shadow_ = std::make_unique<views::ViewShadow>(this, 2);
+      shadow_->SetRoundedCornerRadius(12);
+      helium::GlassSurfaceParams params;
+      params.preset = helium::GlassSurfacePreset::kGlassmorphic;
+      params.tint_color = SK_ColorWHITE;
+      params.tint_strength = 0.0f;
+      params.opacity = 1.0f;
+      params.opaque_color = SkColorSetRGB(28, 28, 30);
+      params.corner_radii = gfx::RoundedCornersF(12);
+      glass_surface_ =
+          AddChildView(std::make_unique<helium::GlassSurfaceView>(params));
+      rail_ = AddChildView(std::make_unique<MRUTabPreviewRail>(browser_view));
+      // Keep card content above the glass layer, in the browser's render pass.
+      rail_->SetPaintToLayer();
+      rail_->layer()->SetFillsBoundsOpaquely(false);
+    }
+
+    void Update(const std::vector<content::WebContents*>& tabs, size_t selected) {
+      rail_->Update(tabs, selected);
+      SkColor background = SkColorSetRGB(28, 28, 30);
+      const bool uses_backdrop = glass_surface_->uses_backdrop();
+      if (uses_backdrop) {
+        background = browser_view_->GetColorProvider()->GetColor(
+            kColorTabHoverCardBackground);
+        auto* page = browser_view_->GetActiveWebContents();
+        auto* host = page ? page->GetRenderWidgetHostView() : nullptr;
+        if (host) {
+          if (auto color = host->GetBackgroundColor()) {
+            background = color_utils::GetResultingPaintColor(*color, background);
+          }
+        }
+      }
+      rail_->SetLabelContrast(background, uses_backdrop);
+    }
+
+    private:
+    const raw_ptr<BrowserView> browser_view_;
+    raw_ptr<helium::GlassSurfaceView> glass_surface_ = nullptr;
+    raw_ptr<MRUTabPreviewRail> rail_ = nullptr;
+    std::unique_ptr<views::ViewShadow> shadow_;
+  };
+
+ private:
+  void OnViewBoundsChanged(views::View*) override {
+    if (bubble_) {
+      bubble_->Update(tabs_, selected_index_);
+      PositionView();
+    }
+  }
+
+  void EnsureView() {
+    if (bubble_) {
+      return;
+    }
+    auto bubble = std::make_unique<BubbleView>(browser_view_);
+    bubble->SetProperty(views::kViewIgnoredByLayoutKey, true);
+    bubble->SetCanProcessEventsWithinSubtree(false);
+    bubble->SetVisible(false);
+    bubble->SetPaintToLayer();
+    bubble->layer()->SetFillsBoundsOpaquely(false);
+    bubble_ = browser_view_->AddChildView(std::move(bubble));
+  }
+
+  void PositionView() {
+    gfx::Rect bounds = browser_view_->GetLocalBounds();
+    bounds.ClampToCenteredSize(bubble_->GetPreferredSize());
+    bubble_->SetBoundsRect(bounds);
+  }
+
+  const raw_ptr<BrowserView> browser_view_;
+  std::vector<content::WebContents*> tabs_;
+  size_t selected_index_ = 0;
+  raw_ptr<BubbleView> bubble_ = nullptr;
+};
