+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_MRU_TAB_PREVIEW_CACHE_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_MRU_TAB_PREVIEW_CACHE_H_
+
+#include <deque>
+#include <list>
+#include <memory>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory_coordinator/memory_consumer.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/image/image_skia.h"
+
+class TabStripModel;
+class ThumbnailImage;
+
+// Window-owned, bounded last-good previews. Reading/prefetching never subscribes
+// to thumbnail capture, activates a tab, or loads a background page.
+class MRUTabPreviewCache : public TabStripModelObserver,
+                           public base::MemoryConsumer {
+ public:
+  using ImageCallback = base::OnceCallback<void(gfx::ImageSkia)>;
+  MRUTabPreviewCache(TabStripModel* model,
+                    base::RepeatingCallback<gfx::Size()> capture_size_pixels,
+                    base::RepeatingCallback<bool()> enabled);
+  ~MRUTabPreviewCache() override;
+  gfx::ImageSkia Get(tabs::TabHandle handle);
+  void Request(tabs::TabHandle handle, gfx::Size size, ImageCallback callback,
+               bool high_priority = true);
+  void Prefetch(tabs::TabHandle handle, gfx::Size size);
+  void CancelPendingRequests();
+  // One visible-page copy on switcher entry, without activating another tab.
+  void CaptureActiveTab();
+  base::CallbackListSubscription SubscribeToCaptures(
+      base::RepeatingCallback<void(tabs::TabHandle, gfx::ImageSkia)> callback);
+
+  static gfx::Size BoundCaptureSize(gfx::Size requested, gfx::Size surface);
+
+ private:
+  friend class MRUTabPreviewCacheTest;
+  struct Entry {
+    tabs::TabHandle handle;
+    gfx::ImageSkia image;
+    size_t bytes;
+    base::WeakPtr<content::WebContents> contents;
+    content::WeakDocumentPtr document;
+    bool sharp;
+    uint64_t thumbnail_generation;
+  };
+  struct Job {
+    tabs::TabHandle handle;
+    gfx::Size size;
+    uint64_t generation;
+    std::vector<ImageCallback> callbacks;
+    scoped_refptr<ThumbnailImage> thumbnail;
+  };
+  void Enqueue(tabs::TabHandle handle, gfx::Size size, ImageCallback callback,
+               bool high_priority);
+  void Pump();
+  void Decoded(std::shared_ptr<Job> job,
+               base::WeakPtr<content::WebContents> contents,
+               content::WeakDocumentPtr document,
+               gfx::ImageSkia image);
+  bool IsCurrent(tabs::TabHandle handle,
+                 base::WeakPtr<content::WebContents> contents,
+                 const content::WeakDocumentPtr& document) const;
+  void Store(tabs::TabHandle handle, gfx::ImageSkia image, bool sharp = false);
+  void Trim();
+  void WatchActiveTab();
+  static bool IsPageReadyForCapture(content::WebContents* contents);
+  void CaptureDepartingTab(tabs::TabInterface* tab);
+  void Captured(tabs::TabHandle handle,
+                base::WeakPtr<content::WebContents> contents,
+                content::WeakDocumentPtr document, uint64_t generation,
+                gfx::ImageSkia image);
+  void OnTabStripModelChanged(TabStripModel*, const TabStripModelChange&,
+                             const TabStripSelectionChange&) override;
+  void OnTabWillBeRemoved(tabs::TabInterface* tab, int index) override;
+  void OnUpdateMemoryLimit() override;
+  void OnReleaseMemory() override;
+
+  const raw_ptr<TabStripModel> model_;
+  base::RepeatingCallback<gfx::Size()> capture_size_pixels_;
+  base::RepeatingCallback<bool()> enabled_;
+  std::list<Entry> entries_;
+  size_t bytes_ = 0;
+  size_t budget_ = 24 * 1024 * 1024;
+  uint64_t generation_ = 0;
+  uint64_t capture_generation_ = 0;
+  bool capture_running_ = false;
+  bool pending_active_capture_ = false;
+  base::RepeatingCallbackList<void(tabs::TabHandle, gfx::ImageSkia)>
+      capture_callbacks_;
+  std::deque<std::shared_ptr<Job>> queued_;
+  std::vector<std::shared_ptr<Job>> running_;
+  base::CallbackListSubscription deactivate_subscription_;
+  base::MemoryConsumerRegistration memory_registration_;
+  base::WeakPtrFactory<MRUTabPreviewCache> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_MRU_TAB_PREVIEW_CACHE_H_
