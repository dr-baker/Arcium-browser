--- /dev/null
+++ src/chrome/browser/ui/views/frame/mru_tab_preview_rail.cc
@@ -0,0 +1,208 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/mru_tab_preview_rail.h"
+
+#include <algorithm>
+#include <memory>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tab_ui_helper.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/mru_tab_preview_cache.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_provider.h"
+#include "ui/display/screen.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/gfx/geometry/size_conversions.h"
+#include "ui/gfx/shadow_value.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/background.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/image_view.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/layout/fill_layout.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+constexpr int kPanelInset = 12;
+constexpr int kCardInset = 8;
+constexpr int kCardGap = 8;
+constexpr int kMetadataHeight = 24;
+constexpr int kIconSize = 16;
+constexpr int kCornerRadius = 12;
+constexpr size_t kMaxCards = 5;
+}  // namespace
+
+MRUTabPreviewRail::MRUTabPreviewRail(BrowserView* browser_view)
+    : browser_view_(browser_view) {
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(kPanelInset), 8));
+  cards_view_ = AddChildView(std::make_unique<views::View>());
+  cards_view_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), kCardGap));
+  position_ = AddChildView(std::make_unique<views::Label>());
+  position_->SetSubpixelRenderingEnabled(false);
+  position_->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  capture_subscription_ = browser_view_->mru_preview_cache().SubscribeToCaptures(
+      base::BindRepeating(&MRUTabPreviewRail::OnCaptured, base::Unretained(this)));
+}
+
+MRUTabPreviewRail::~MRUTabPreviewRail() {
+  browser_view_->mru_preview_cache().CancelPendingRequests();
+}
+
+void MRUTabPreviewRail::Update(
+    const std::vector<content::WebContents*>& tabs, size_t selected) {
+  if (tabs.empty() || selected >= tabs.size()) {
+    return;
+  }
+  // A five-card viewport becomes narrower/fewer cards on small windows rather
+  // than overflowing or shrinking the title into an unreadable strip.
+  const int available = std::max(120, browser_view_->width() - 48);
+  const size_t count = std::min({kMaxCards, tabs.size(),
+      static_cast<size_t>(std::max(1, (available - 2 * kPanelInset + kCardGap) /
+                                         (140 + kCardGap)))});
+  const int card_width = std::min(256,
+      (available - 2 * kPanelInset - (static_cast<int>(count) - 1) * kCardGap) /
+          static_cast<int>(count));
+  const int preview_width = std::max(1, card_width - 2 * kCardInset - 4);
+  const gfx::Size preview_size(preview_width, preview_width * 9 / 16);
+  const size_t first = std::min(selected > count / 2 ? selected - count / 2 : 0,
+                                tabs.size() - count);
+  auto& cache = browser_view_->mru_preview_cache();
+  weak_factory_.InvalidateWeakPtrs();
+  cache.CancelPendingRequests();
+  cards_.clear();
+  cards_view_->RemoveAllChildViews();
+  std::vector<tabs::TabHandle> handles;
+  auto* model = browser_view_->browser()->tab_strip_model();
+  for (size_t offset = 0; offset < count; ++offset) {
+    const size_t index = first + offset;
+    const int model_index = model->GetIndexOfWebContents(tabs[index]);
+    if (model_index == TabStripModel::kNoTab) {
+      return;
+    }
+    auto* tab = model->GetTabAtIndex(model_index);
+    auto* helper = TabUIHelper::From(tab);
+    handles.push_back(tab->GetHandle());
+    const auto favicon = helper ? helper->GetFavicon() : ui::ImageModel();
+    const auto title = helper ? helper->GetTitle() : tabs[index]->GetTitle();
+    auto* card = cards_view_->AddChildView(std::make_unique<views::View>());
+    card->SetPreferredSize(gfx::Size(card_width,
+        preview_size.height() + 2 * kCardInset + 4 + 8 + kMetadataHeight));
+    card->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(kCardInset), 8));
+    card->SetTooltipText(title);
+    card->GetViewAccessibility().SetRole(ax::mojom::Role::kGroup);
+    card->GetViewAccessibility().SetName(title);
+    auto* preview = card->AddChildView(std::make_unique<views::View>());
+    preview->SetPreferredSize(preview_size);
+    preview->SetBackground(views::CreateRoundedRectBackground(
+        SkColorSetARGB(32, 127, 127, 127), 8));
+    preview->SetLayoutManager(std::make_unique<views::FillLayout>());
+    auto* image = preview->AddChildView(std::make_unique<views::ImageView>());
+    image->SetImageSize(preview_size);
+    image->SetCornerRadius(8);
+    auto* placeholder = preview->AddChildView(std::make_unique<views::ImageView>());
+    placeholder->SetImageSize(gfx::Size(32, 32));
+    placeholder->SetImage(favicon);
+    auto* metadata = card->AddChildView(std::make_unique<views::View>());
+    metadata->SetPreferredSize(gfx::Size(preview_width, kMetadataHeight));
+    auto* row = metadata->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 8));
+    row->set_cross_axis_alignment(views::BoxLayout::CrossAxisAlignment::kCenter);
+    auto* icon = metadata->AddChildView(std::make_unique<views::ImageView>());
+    icon->SetImage(favicon);
+    icon->SetImageSize(gfx::Size(kIconSize, kIconSize));
+    auto* label = metadata->AddChildView(std::make_unique<views::Label>(title));
+    label->SetSubpixelRenderingEnabled(false);
+    label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    label->SetElideBehavior(gfx::ELIDE_TAIL);
+    label->SetMaximumWidthSingleLine(std::max(1, preview_width - kIconSize - 8));
+    row->SetFlexForView(label, 1);
+    cards_.push_back(
+        {card, image, placeholder, label, index == selected, handles.back()});
+    const auto cached = cache.Get(handles.back());
+    if (!cached.isNull()) {
+      OnThumbnail(offset, cached);
+    }
+  }
+  position_->SetText(base::NumberToString16(selected + 1) + u" / " +
+                     base::NumberToString16(tabs.size()));
+  position_->SetVisible(tabs.size() > count);
+  SetLabelContrast(background_, shadow_);
+  float scale = 1.0f;
+  if (auto* widget = browser_view_->GetWidget(); widget && widget->GetNativeWindow()) {
+    scale = display::Screen::Get()->GetDisplayNearestWindow(
+        widget->GetNativeWindow()).device_scale_factor();
+  }
+  const auto capture_size = gfx::ScaleToCeiledSize(preview_size,
+                                                 std::clamp(scale, 1.0f, 2.0f));
+  const size_t selected_card = selected - first;
+  auto request = [&](size_t i, bool priority) {
+    cache.Request(handles[i], capture_size,
+        base::BindOnce(&MRUTabPreviewRail::OnThumbnail,
+                       weak_factory_.GetWeakPtr(), i), priority);
+  };
+  request(selected_card, true);
+  for (size_t i = 0; i < count; ++i) {
+    if (i != selected_card) {
+      request(i, false);
+    }
+  }
+  InvalidateLayout();
+  PreferredSizeChanged();
+}
+
+void MRUTabPreviewRail::OnThumbnail(size_t card, gfx::ImageSkia image) {
+  if (image.isNull() || card >= cards_.size()) {
+    return;
+  }
+  cards_[card].preview->SetImage(ui::ImageModel::FromImageSkia(image));
+  cards_[card].placeholder->SetVisible(false);
+}
+
+void MRUTabPreviewRail::OnCaptured(tabs::TabHandle handle, gfx::ImageSkia image) {
+  // Selection can move while the copy is in flight. Resolve the current slot
+  // by tab identity rather than writing into the original card index.
+  for (size_t i = 0; i < cards_.size(); ++i) {
+    if (cards_[i].handle == handle) {
+      OnThumbnail(i, image);
+      return;
+    }
+  }
+}
+
+void MRUTabPreviewRail::SetLabelContrast(SkColor background, bool shadow) {
+  background_ = background;
+  shadow_ = shadow;
+  const SkColor foreground = color_utils::GetColorWithMaxContrast(background);
+  auto style = [&](views::Label* label) {
+    label->SetBackgroundColor(background);
+    label->SetEnabledColor(foreground);
+    label->SetShadows(shadow ? gfx::ShadowValues{gfx::ShadowValue(
+        gfx::Vector2d(0, 1), 2, SkColorSetA(
+            color_utils::GetColorWithMaxContrast(foreground), 0x99))}
+                            : gfx::ShadowValues());
+  };
+  style(position_);
+  for (auto& card : cards_) {
+    style(card.title);
+    card.container->SetBackground(card.selected
+        ? views::CreateRoundedRectBackground(SkColorSetA(foreground, 36), kCornerRadius)
+        : nullptr);
+    card.container->SetBorder(card.selected
+        ? views::CreateRoundedRectBorder(2, kCornerRadius, SkColorSetA(foreground, 160))
+        : views::CreateEmptyBorder(2));
+  }
+}
+
+BEGIN_METADATA(MRUTabPreviewRail)
+END_METADATA
