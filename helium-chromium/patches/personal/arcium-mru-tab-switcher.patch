+TEST_F(MRUTabPreviewCacheTest, CancellationSuppressesDecodeCallbackAndRefill) {
+  auto handle = AddHandle();
+  SeedThumbnail(handle);
+  auto cache = MakeCache(true);
+  bool replied = false;
+  cache->Request(handle, {160, 90}, base::BindOnce(
