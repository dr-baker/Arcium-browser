+
+MRUTabPreviewCache::MRUTabPreviewCache(
+    TabStripModel* model,
+    base::RepeatingCallback<gfx::Size()> capture_size_pixels,
+    base::RepeatingCallback<bool()> enabled)
+    : model_(model),
+      capture_size_pixels_(std::move(capture_size_pixels)),
+      enabled_(std::move(enabled)),
+      memory_registration_("MRUTabPreviewCache", std::nullopt, this) {
+  OnUpdateMemoryLimit();
+  model_->AddObserver(this);
+  WatchActiveTab();
+}
+
+MRUTabPreviewCache::~MRUTabPreviewCache() {
+  model_->RemoveObserver(this);
+}
+
+gfx::ImageSkia MRUTabPreviewCache::Get(tabs::TabHandle handle) {
+  auto it = std::ranges::find(entries_, handle, &Entry::handle);
+  if (it == entries_.end()) {
+    return {};
+  }
+  auto* tab = handle.Get();
+  auto* helper = tab ? ThumbnailTabHelper::FromWebContents(tab->GetContents())
+                     : nullptr;
+  // Discard deliberately retains a last-good image. A live document change
+  // invalidates it, even when navigation reused the same RenderFrameHost.
+  if (!IsCurrent(handle, it->contents, it->document) &&
+      !(tab && model_->GetIndexOfTab(tab) != TabStripModel::kNoTab && helper &&
+        helper->is_tab_discarded())) {
+    bytes_ -= it->bytes;
+    entries_.erase(it);
+    return {};
+  }
+  entries_.splice(entries_.begin(), entries_, it);
+  return entries_.front().image;
+}
+
+void MRUTabPreviewCache::Request(tabs::TabHandle handle,
+                                 gfx::Size size,
+                                 ImageCallback callback, bool high_priority) {
+  auto image = Get(handle);
+  if (!image.isNull()) {
+    auto* tab = handle.Get();
+    auto* helper = ThumbnailTabHelper::FromWebContents(tab->GetContents());
+    const auto& entry = entries_.front();
+    if (entry.sharp || !helper ||
+        entry.thumbnail_generation == helper->thumbnail()->cached_data_generation()) {
+      std::move(callback).Run(std::move(image));
+      return;
+    }
+  }
+  Enqueue(handle, size, std::move(callback), high_priority);
+}
+
+void MRUTabPreviewCache::Prefetch(tabs::TabHandle handle, gfx::Size size) {
+  if (!Get(handle).isNull()) {
+    auto* helper = ThumbnailTabHelper::FromWebContents(handle.Get()->GetContents());
+    const auto& entry = entries_.front();
+    if (entry.sharp || !helper || entry.thumbnail_generation ==
+                                     helper->thumbnail()->cached_data_generation()) {
+      return;
+    }
+  }
+  Enqueue(handle, size, {}, false);
+}
+
+void MRUTabPreviewCache::Enqueue(tabs::TabHandle handle,
+                                 gfx::Size size,
+                                 ImageCallback callback, bool high_priority) {
+  size = BoundCaptureSize(size, size);
+  if (!enabled_.Run() || !budget_ || size.IsEmpty()) {
+    if (callback) {
+      std::move(callback).Run({});
+    }
+    return;
+  }
+  for (const auto& jobs : {running_,
+                          std::vector(queued_.begin(), queued_.end())}) {
+    for (auto& job : jobs) {
+      if (job->handle == handle && job->size == size &&
+          job->generation == generation_) {
+        if (callback) {
+          job->callbacks.push_back(std::move(callback));
+        }
+        return;
+      }
+    }
+  }
+  auto job = std::make_shared<Job>(handle, size, generation_,
+                                  std::vector<ImageCallback>(), nullptr);
+  if (callback) {
+    job->callbacks.push_back(std::move(callback));
+  }
+  // Keep a full five-card rail queued even while two stale decodes finish.
+  if (high_priority) {
+    if (queued_.size() >= 5) {
+      queued_.pop_back();
+    }
+    queued_.push_front(job);
+  } else if (queued_.size() < 5) {
+    queued_.push_back(job);
+  }
+  Pump();
+}
+
+void MRUTabPreviewCache::Pump() {
+  while (running_.size() < 2 && !queued_.empty()) {
+    auto job = queued_.front();
+    queued_.pop_front();
+    auto* tab = job->handle.Get();
+    auto* contents = tab && model_->GetIndexOfTab(tab) != TabStripModel::kNoTab
+                         ? tab->GetContents() : nullptr;
+    auto* helper = contents
+                       ? ThumbnailTabHelper::FromWebContents(contents)
+                       : nullptr;
+    if (!helper || !contents->GetPrimaryMainFrame()) {
+      auto alive = weak_factory_.GetWeakPtr();
+      for (auto& callback : job->callbacks) {
+        std::move(callback).Run({});
+        if (!alive) {
+          return;
+        }
+      }
+      continue;
+    }
+    running_.push_back(job);
+    job->thumbnail = helper->thumbnail();
+    auto alive = weak_factory_.GetWeakPtr();
+    job->thumbnail->RequestCachedImage(
+        job->size,
+        base::BindOnce(&MRUTabPreviewCache::Decoded, weak_factory_.GetWeakPtr(),
+                       job, contents->GetWeakPtr(),
+                       contents->GetPrimaryMainFrame()->GetWeakDocumentPtr()));
+    if (!alive) {
+      return;
+    }
+  }
+}
+
+bool MRUTabPreviewCache::IsCurrent(
+    tabs::TabHandle handle,
+    base::WeakPtr<content::WebContents> contents,
+    const content::WeakDocumentPtr& document) const {
+  auto* tab = handle.Get();
+  return tab && model_->GetIndexOfTab(tab) != TabStripModel::kNoTab && contents &&
+         tab->GetContents() == contents.get() &&
+         document.AsRenderFrameHostIfValid() &&
+         document.AsRenderFrameHostIfValid() == contents->GetPrimaryMainFrame();
+}
+
+void MRUTabPreviewCache::Decoded(
+    std::shared_ptr<Job> job,
+    base::WeakPtr<content::WebContents> contents,
+    content::WeakDocumentPtr document,
+    gfx::ImageSkia image) {
+  std::erase(running_, job);
+  job->thumbnail.reset();
+  if (job->generation == generation_) {
+    if (!IsCurrent(job->handle, contents, document)) {
+      image = {};
+    }
+    if (!image.isNull()) {
+      // A sharper departure capture may have arrived during the decode.
+      auto existing = Get(job->handle);
+      if (!existing.isNull() && entries_.front().sharp) {
+        image = existing;
+      } else {
+        Store(job->handle, image);
+        image = Get(job->handle);
+      }
+    }
+    auto callbacks = std::move(job->callbacks);
+    auto alive = weak_factory_.GetWeakPtr();
+    for (auto& callback : callbacks) {
+      std::move(callback).Run(image);
+      if (!alive) {
+        return;
+      }
+    }
+  }
+  Pump();
+}
+
+void MRUTabPreviewCache::CancelPendingRequests() {
+  ++generation_;
+  queued_.clear();
+  for (auto& job : running_) {
+    job->callbacks.clear();
+  }
+  // Running tasks still count toward the concurrency cap until they finish.
+}
+
+void MRUTabPreviewCache::Store(tabs::TabHandle handle, gfx::ImageSkia image,
+                               bool sharp) {
+  auto* tab = handle.Get();
+  if (!tab || model_->GetIndexOfTab(tab) == TabStripModel::kNoTab ||
+      !tab->GetContents()->GetPrimaryMainFrame()) {
+    return;
+  }
+  // Own a tightly sized bitmap: a crop subset otherwise keeps its larger
+  // source allocation alive and defeats byte accounting.
+  const auto& source = image.GetRepresentation(1.0f).GetBitmap();
+  if (source.drawsNothing()) {
+    return;
+  }
+  const int width = std::min(source.width(), source.height() * 16 / 9);
+  const int height = std::min(source.height(), width * 9 / 16);
+  if (!width || !height) {
+    return;
+  }
+  const auto allocation_size = base::CheckedNumeric<size_t>(width) * height * 4;
+  if (!allocation_size.IsValid() ||
+      allocation_size.ValueOrDie() > budget_) {
+    return;
+  }
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocN32Pixels(width, height) ||
+      !source.readPixels(bitmap.info(), bitmap.getPixels(), bitmap.rowBytes(),
+                         (source.width() - width) / 2,
+                         0)) {
+    return;
+  }
+  bitmap.setImmutable();
+  image = gfx::ImageSkia::CreateFrom1xBitmap(bitmap);
+  size_t bytes = 0;
+  for (const auto& rep : image.image_reps()) {
+    bytes += rep.GetBitmap().computeByteSize();
+  }
+  if (!bytes || bytes > budget_) {
+    return;
+  }
+  auto it = std::ranges::find(entries_, handle, &Entry::handle);
+  if (it != entries_.end()) {
+    bytes_ -= it->bytes;
+    entries_.erase(it);
+  }
+  auto* contents = tab->GetContents();
+  auto* helper = ThumbnailTabHelper::FromWebContents(contents);
+  entries_.push_front({handle, std::move(image), bytes, contents->GetWeakPtr(),
+                      contents->GetPrimaryMainFrame()->GetWeakDocumentPtr(),
+                      sharp,
+                      helper ? helper->thumbnail()->cached_data_generation() : 0});
+  bytes_ += bytes;
+  Trim();
+}
+
+void MRUTabPreviewCache::Trim() {
+  while (!entries_.empty() && (bytes_ > budget_ || entries_.size() > 64)) {
+    bytes_ -= entries_.back().bytes;
+    entries_.pop_back();
+  }
+}
+
+gfx::Size MRUTabPreviewCache::BoundCaptureSize(gfx::Size requested,
+                                             gfx::Size surface) {
+  if (requested.IsEmpty() || surface.IsEmpty()) {
+    return {};
+  }
+  const double scale = std::min(
+      {1.0, 1440.0 / requested.width(), 810.0 / requested.height(),
+       double(surface.width()) / requested.width(),
+       double(surface.height()) / requested.height()});
+  return gfx::Size(std::max(1, int(std::floor(requested.width() * scale))),
+                   std::max(1, int(std::floor(requested.height() * scale))));
+}
+
+void MRUTabPreviewCache::WatchActiveTab() {
+  deactivate_subscription_ = {};
+  if (auto* tab = model_->GetActiveTab()) {
+    deactivate_subscription_ = tab->RegisterWillDeactivate(base::BindRepeating(
+        &MRUTabPreviewCache::CaptureDepartingTab, weak_factory_.GetWeakPtr()));
+  }
+}
+
+void MRUTabPreviewCache::CaptureActiveTab() {
+  if (capture_running_) {
+    pending_active_capture_ = true;
+    return;
+  }
+  if (auto* tab = model_->GetActiveTab()) {
+    CaptureDepartingTab(tab);
+  }
+}
+
+base::CallbackListSubscription MRUTabPreviewCache::SubscribeToCaptures(
+    base::RepeatingCallback<void(tabs::TabHandle, gfx::ImageSkia)> callback) {
+  return capture_callbacks_.Add(std::move(callback));
+}
+
+bool MRUTabPreviewCache::IsPageReadyForCapture(content::WebContents* contents) {
+  if (!contents || contents->IsBeingDestroyed() ||
+      !contents->CompletedFirstVisuallyNonEmptyPaint()) {
+    return false;
+  }
+  auto* helper = ThumbnailTabHelper::FromWebContents(contents);
+  return helper && helper->thumbnail()->GetCaptureReadiness() !=
+                       ThumbnailImage::CaptureReadiness::kNotReady;
+}
+
+void MRUTabPreviewCache::CaptureDepartingTab(tabs::TabInterface* tab) {
+  if (!enabled_.Run() || !budget_ || capture_running_ || model_->closing_all()) {
+    return;
+  }
+  auto* contents = tab->GetContents();
+  // A committed document can still display its predecessor's surface until
+  // first paint. Readiness also rejects navigation starting during a copy.
+  if (!IsPageReadyForCapture(contents)) {
+    return;
+  }
+  auto* view = contents->GetRenderWidgetHostView();
+  if (contents->IsBeingDestroyed() ||
+      contents->GetVisibility() != content::Visibility::VISIBLE || !view ||
+      !view->IsSurfaceAvailableForCopy() || !contents->GetPrimaryMainFrame()) {
+    return;
+  }
+  // CopyFromSurface takes its source rectangle in DIPs and destination in
+  // physical pixels. Scaling the source too would double-scale on Retina.
+  const auto source_size = view->GetViewBounds().size();
+  const auto surface = gfx::ScaleToFlooredSize(source_size,
+                                              view->GetDeviceScaleFactor());
+  const auto size = BoundCaptureSize(capture_size_pixels_.Run(), surface);
+  if (size.IsEmpty()) {
+    return;
+  }
+  const int crop_width = std::min(source_size.width(), source_size.height() * 16 / 9);
+  const int crop_height = std::min(source_size.height(), crop_width * 9 / 16);
+  if (!crop_width || !crop_height) {
+    return;
+  }
+  capture_running_ = true;
+  const gfx::Rect source_rect((source_size.width() - crop_width) / 2, 0,
+                              crop_width, crop_height);
+  view->CopyFromSurface(
+      source_rect, size, base::Milliseconds(250),
+      base::BindPostTaskToCurrentDefault(base::BindOnce(
+          [](base::WeakPtr<MRUTabPreviewCache> self, tabs::TabHandle handle,
+             base::WeakPtr<content::WebContents> contents,
+             content::WeakDocumentPtr document, uint64_t generation,
+             const content::CopyFromSurfaceResult& result) {
+            if (!self) {
+              return;
+            }
+            self->Captured(handle, contents, document, generation,
+                           result.has_value() && !result->bitmap.drawsNothing()
+                               ? gfx::ImageSkia::CreateFrom1xBitmap(result->bitmap)
+                               : gfx::ImageSkia());
+          }, weak_factory_.GetWeakPtr(), tab->GetHandle(), contents->GetWeakPtr(),
+          contents->GetPrimaryMainFrame()->GetWeakDocumentPtr(),
+          capture_generation_)));
+}
+
+void MRUTabPreviewCache::Captured(
+    tabs::TabHandle handle, base::WeakPtr<content::WebContents> contents,
+    content::WeakDocumentPtr document, uint64_t generation,
+    gfx::ImageSkia image) {
+  capture_running_ = false;
+  const bool valid = generation == capture_generation_ && !image.isNull() &&
+                     IsCurrent(handle, contents, document) &&
+                     IsPageReadyForCapture(contents.get());
+  if (valid) {
+    Store(handle, image, true);
+    image = Get(handle);
+  }
+  // A departure copy may have occupied the single capture slot at entry.
+  if (std::exchange(pending_active_capture_, false)) {
+    CaptureActiveTab();
+  }
+  if (valid && !image.isNull()) {
+    capture_callbacks_.Notify(handle, image);
+  }
+}
+
+void MRUTabPreviewCache::OnTabStripModelChanged(
+    TabStripModel*, const TabStripModelChange&,
+    const TabStripSelectionChange&) {
+  WatchActiveTab();
+}
+
+void MRUTabPreviewCache::OnTabWillBeRemoved(tabs::TabInterface* tab, int) {
+  CancelPendingRequests();
+  ++capture_generation_;
+  auto it = std::ranges::find(entries_, tab->GetHandle(), &Entry::handle);
+  if (it != entries_.end()) {
+    bytes_ -= it->bytes;
+    entries_.erase(it);
+  }
+  if (tab == model_->GetActiveTab()) {
+    deactivate_subscription_ = {};
+  }
+}
+
+void MRUTabPreviewCache::OnUpdateMemoryLimit() {
+  budget_ = (24 * 1024 * 1024) *
+            static_cast<size_t>(std::clamp(memory_limit(), 0, 100)) / 100;
+}
+
+void MRUTabPreviewCache::OnReleaseMemory() {
+  CancelPendingRequests();
+  ++capture_generation_;
+  pending_active_capture_ = false;
+  entries_.clear();
+  bytes_ = 0;
+}
