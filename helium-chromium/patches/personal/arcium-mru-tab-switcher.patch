+}
+
+TEST(MRUTabPreviewCacheSizeTest, EmptyDimensionsDoNotCapture) {
+  EXPECT_TRUE(MRUTabPreviewCache::BoundCaptureSize({}, {1920, 1080}).IsEmpty());
+  EXPECT_TRUE(MRUTabPreviewCache::BoundCaptureSize({480, 270}, {}).IsEmpty());
+}
