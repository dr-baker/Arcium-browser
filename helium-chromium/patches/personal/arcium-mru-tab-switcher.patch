+            ThumbnailTabHelper::FromWebContents(contents)
+                ->thumbnail()->GetCaptureReadiness());
+  ASSERT_FALSE(contents->CompletedFirstVisuallyNonEmptyPaint());
+  EXPECT_FALSE(ReadyToCapture(contents));
+  content::WebContentsTester::For(contents)->TestDidFirstVisuallyNonEmptyPaint();
+  EXPECT_TRUE(ReadyToCapture(contents));
+  auto navigation = content::NavigationSimulator::CreateBrowserInitiated(
+      GURL("https://next.test/"), contents);
+  navigation->Start();
+  EXPECT_FALSE(ReadyToCapture(contents));
+}
