 IN_PROC_BROWSER_TEST_F(HeliumPersistentTabViewTest,
+                       PinMoveReportsPreviousSelectedIndex) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  AppendTab();
+  AppendTab();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/title1.html")));
+  TabStripModel* model = tab_strip_model();
+  tabs::TabInterface* tab = model->GetActiveTab();
+  const int initial_index = model->GetIndexOfTab(tab);
+  ASSERT_GT(initial_index, 0);
+
+  class MoveObserver : public TabStripModelObserver {
+   public:
+    explicit MoveObserver(TabStripModel* model) : model_(model) {
+      model_->AddObserver(this);
+    }
+    ~MoveObserver() override { model_->RemoveObserver(this); }
+    void OnTabStripModelChanged(
+        TabStripModel*,
+        const TabStripModelChange& change,
+        const TabStripSelectionChange& selection) override {
+      if (change.type() == TabStripModelChange::kMoved) {
+        previous_active = selection.old_model.active();
+        next_active = selection.new_model.active();
+      }
+    }
+    std::optional<size_t> previous_active;
+    std::optional<size_t> next_active;
+
+   private:
+    raw_ptr<TabStripModel> model_;
+  } observer(model);
+
+  auto* service = helium::HeliumSpaceServiceFactory::GetForProfile(
+      browser()->profile());
+  ASSERT_TRUE(service);
+  ASSERT_TRUE(service->AddPinFromTab(tab));
+  const int pin_index = model->GetIndexOfTab(tab);
+  ASSERT_LT(pin_index, initial_index);
+  EXPECT_EQ(static_cast<size_t>(initial_index), observer.previous_active);
+  EXPECT_EQ(static_cast<size_t>(pin_index), observer.next_active);
+  EXPECT_EQ(tab, model->GetActiveTab());
+
+  ASSERT_TRUE(service->RemovePersistentItem(tab));
+  EXPECT_EQ(static_cast<size_t>(pin_index), observer.previous_active);
+  EXPECT_EQ(static_cast<size_t>(model->GetIndexOfTab(tab)),
+            observer.next_active);
+  EXPECT_EQ(tab, model->GetActiveTab());
+}
