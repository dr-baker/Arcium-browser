Index: src/chrome/browser/ui/helium/helium_little_arc_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/helium_little_arc_unittest.cc
@@ -0,0 +1,45 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_little_arc.h"
+
+#include <memory>
+
+#include "chrome/test/base/testing_profile.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace helium {
+namespace {
+
+TEST(LittleArcEligibilityTest, AcceptsWebUrlsForExactRegularAndOtrProfiles) {
+  TestingProfile profile;
+  Profile* otr_profile =
+      profile.GetPrimaryOTRProfile(/*create_if_needed=*/true);
+
+  EXPECT_TRUE(CanOpenUrlInLittleArc(&profile, GURL("https://example.test/")));
+  EXPECT_TRUE(CanOpenUrlInLittleArc(otr_profile, GURL("http://example.test/")));
+  EXPECT_NE(&profile, otr_profile);
+}
+
+TEST(LittleArcEligibilityTest, RejectsUnsupportedAndInvalidUrls) {
+  TestingProfile profile;
+
+  EXPECT_FALSE(CanOpenUrlInLittleArc(&profile, GURL()));
+  EXPECT_FALSE(
+      CanOpenUrlInLittleArc(&profile, GURL("mailto:person@example.test")));
+  EXPECT_FALSE(CanOpenUrlInLittleArc(&profile, GURL("file:///tmp/example")));
+}
+
+TEST(LittleArcEligibilityTest, RejectsProfilesThatCannotCreateWindows) {
+  TestingProfile::Builder builder;
+  builder.DisallowBrowserWindows();
+  std::unique_ptr<TestingProfile> profile = builder.Build();
+
+  EXPECT_FALSE(
+      CanOpenUrlInLittleArc(profile.get(), GURL("https://example.test/")));
+}
+
+}  // namespace
+}  // namespace helium
