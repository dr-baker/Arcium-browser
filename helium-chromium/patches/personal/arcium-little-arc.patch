+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_LITTLE_ARC_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_LITTLE_ARC_H_
+
+#include <vector>
+
+class Browser;
+class GURL;
+class Profile;
+
+namespace content {
+struct OpenURLParams;
+}  // namespace content
+
+namespace helium {
+
+// Installs Little Arc as the process-wide optional-navigation handler.
+void InitializeLittleArc();
+
+// Opens external links in a temporary popup so the main window's tab state is
+// left alone. ⌘O promotes the peek into a normal tab.
+bool ShouldOpenExternalLinksInLittleArc(Profile* profile);
+
+bool IsLittleArcBrowser(const Browser* browser);
+
+// Returns true when |profile| may create a Little Arc popup for |url|. The
+// exact profile, including an off-the-record profile, owns the new popup.
+bool CanOpenUrlInLittleArc(Profile* profile, const GURL& url);
+
+// Opens |urls| in a new Little Arc popup for |profile|. Returns the popup, or
+// nullptr if creation failed.
+Browser* OpenUrlsInLittleArc(Profile* profile, const std::vector<GURL>& urls);
+
+// Opens one link while retaining Chromium's referrer, initiator, and context
+// menu navigation state.
+Browser* OpenUrlInLittleArc(Profile* profile,
+                            const content::OpenURLParams& params);
+
+// Moves the Little Arc contents into the profile's last tabbed window and
+// closes the popup. Returns false if |browser| is not a Little Arc window.
+bool PromoteLittleArcToTab(Browser* browser);
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_LITTLE_ARC_H_
