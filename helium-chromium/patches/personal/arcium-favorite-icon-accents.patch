+void PersistentTabView::ScheduleFaviconColorAnalysis() {
+  if (presentation_mode_ != PresentationMode::kCompactGrid ||
+      favicon_state_ != PersistentFaviconState::kResolved) {
+    return;
+  }
+
+  const gfx::ImageSkia image = favicon_model_.Rasterize(nullptr);
+  if (image.isNull()) {
+    return;
+  }
+  const float scale = ui::GetScaleForMaxSupportedResourceScaleFactor();
+  const SkBitmap bitmap = image.GetRepresentation(scale).GetBitmap();
+  if (bitmap.empty() || bitmap.isNull()) {
+    return;
+  }
+
+  const GURL requested_url = url_;
+  const uint64_t generation = favicon_generation_;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&helium::favorite_favicon::CalculateAccent, bitmap),
+      base::BindOnce(&PersistentTabView::OnFaviconColorAvailable,
+                     weak_ptr_factory_.GetWeakPtr(), requested_url,
+                     generation));
+}
+
+void PersistentTabView::OnFaviconColorAvailable(
+    const GURL& requested_url,
+    uint64_t generation,
+    std::optional<SkColor> color) {
+  if (requested_url != url_ || generation != favicon_generation_ ||
+      favicon_state_ != PersistentFaviconState::kResolved) {
+    return;
+  }
+  favicon_accent_color_ = std::move(color);
+  UpdateColors();
+}
