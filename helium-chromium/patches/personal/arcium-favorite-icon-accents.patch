+    if (config.view == icon_) {
+      config.min_width =
+          is_favorite ? kFavoriteIconDesignWidth : kIconDesignWidth;
+      break;
+    }
+  }
+
+  const bool selected =
+      GetSelectionState() != TabStyle::TabSelectionState::kInactive;
+  if (!is_favorite) {
+    favorite_selection_animation_.Reset();
+  } else if (first_presentation_update) {
+    favorite_selection_animation_.Reset(selected ? 1.0 : 0.0);
+  } else if (selected) {
+    favorite_selection_animation_.Show();
+  } else {
+    favorite_selection_animation_.Hide();
+  }
+
+  if (GetColorProvider()) {
+    UpdateColors();
+  } else {
+    favorite_outline_color_ = SK_ColorTRANSPARENT;
+    UpdateBorder();
+  }
+  InvalidateLayout();
+  PreferredSizeChanged();
+  if (favorite_presentation_) {
+    ScheduleFavoriteFaviconColorAnalysis();
+  }
+}
