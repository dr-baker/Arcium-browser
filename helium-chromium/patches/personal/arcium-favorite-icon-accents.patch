+void TabView::PaintFavoriteOutline(gfx::Canvas* canvas) {
+  const float selection_progress = static_cast<float>(
+      favorite_selection_animation_.GetCurrentValue());
+  if (selection_progress <= 0.0f ||
+      SkColorGetA(favorite_outline_color_) == SK_AlphaTRANSPARENT) {
+    return;
+  }
+
+  const float stroke_width =
+      static_cast<float>(arcium::ScaleChromeDip(this, 1));
+  gfx::RectF outline_bounds(GetLocalBounds());
+  outline_bounds.Inset(stroke_width / 2.0f);
+  cc::PaintFlags outline_flags;
+  outline_flags.setAntiAlias(true);
+  outline_flags.setStyle(cc::PaintFlags::kStroke_Style);
+  outline_flags.setStrokeWidth(stroke_width);
+  outline_flags.setColor(SkColorSetA(
+      favorite_outline_color_,
+      static_cast<SkAlpha>(std::clamp(224.0f * selection_progress, 0.0f,
+                                      255.0f))));
+  const SkScalar corner_radius = SkIntToScalar(
+      arcium::ScaleChromeDip(this, kFavoriteCornerRadius));
+  canvas->DrawRoundRect(
+      outline_bounds,
+      std::max<SkScalar>(0, corner_radius - stroke_width / 2.0f),
+      outline_flags);
