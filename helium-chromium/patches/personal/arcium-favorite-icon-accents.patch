+void TabView::PaintFavoriteBackground(gfx::Canvas* canvas) {
+  const bool hovered = IsHoverAnimationActive();
+  const float hover_progress = static_cast<float>(GetHoverAnimationValue());
+  const float selection_progress = static_cast<float>(
+      favorite_selection_animation_.GetCurrentValue());
+  const SkColor active_background = tab_style_->GetCurrentTabBackgroundColor(
+      TabStyle::TabSelectionState::kActive, hovered, hover_progress,
+      IsFrameActive(), GetColorProvider());
+  const SkColor inactive_background =
+      tab_style_->GetCurrentTabBackgroundColor(
+          TabStyle::TabSelectionState::kInactive, hovered, hover_progress,
+          IsFrameActive(), GetColorProvider());
+  const SkColor idle_inactive_background =
+      SkColorSetA(inactive_background, 0x24);
+  const SkColor hovered_inactive_background = color_utils::AlphaBlend(
+      inactive_background, idle_inactive_background, hover_progress);
+  const SkColor fill_color = color_utils::AlphaBlend(
+      active_background, hovered_inactive_background, selection_progress);
+
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(fill_color);
+  const SkScalar corner_radius = SkIntToScalar(
+      arcium::ScaleChromeDip(this, kFavoriteCornerRadius));
+  canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()), corner_radius, flags);
+
+  if (selection_progress > 0.0f) {
+    cc::PaintFlags highlight_flags;
+    highlight_flags.setAntiAlias(true);
+    highlight_flags.setColor(SkColorSetA(
+        SK_ColorWHITE,
+        static_cast<SkAlpha>(std::clamp(32.0f * selection_progress, 0.0f,
+                                        255.0f))));
+    canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()), corner_radius,
+                          highlight_flags);
+  }
+}
