+void TabView::SetFavoritePresentation(bool is_favorite) {
+  if (favorite_presentation_ == is_favorite) {
+    return;
+  }
+
+  const bool first_presentation_update = !favorite_presentation_initialized_;
+  favorite_presentation_initialized_ = true;
