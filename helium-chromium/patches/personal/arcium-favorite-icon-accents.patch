+void TabView::ScheduleFavoriteFaviconColorAnalysis() {
+  // Vector/default ImageModels can require a ColorProvider to rasterize. Live
+  // Favorite accents only use decoded favicon images; those are safe to copy
+  // before dispatching the worker task.
+  if (!favorite_presentation_ || !tab_data_.favicon.IsImage()) {
+    return;
+  }
+
+  const gfx::ImageSkia image = tab_data_.favicon.Rasterize(nullptr);
+  if (image.isNull()) {
+    return;
+  }
+  const float scale = ui::GetScaleForMaxSupportedResourceScaleFactor();
+  const SkBitmap bitmap = image.GetRepresentation(scale).GetBitmap();
+  if (bitmap.empty() || bitmap.isNull()) {
+    return;
+  }
+
+  const GURL requested_url = tab_data_.visible_url;
+  const uint64_t generation = favorite_favicon_generation_;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&helium::favorite_favicon::CalculateAccent, bitmap),
+      base::BindOnce(&TabView::OnFavoriteFaviconColorAvailable,
+                     weak_ptr_factory_.GetWeakPtr(), requested_url,
+                     generation));
+}
