+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_COMMON_FAVORITE_FAVICON_STYLE_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_COMMON_FAVORITE_FAVICON_STYLE_H_
+
+#include <algorithm>
+#include <optional>
+
+#include "ui/gfx/color_analysis.h"
+#include "ui/gfx/color_utils.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+namespace helium::favorite_favicon {
+
+// Computes a stable accent from a decoded favicon. This is intentionally a
+// small per-view operation; callers decide when to run it off the paint path
+// and how to discard stale results.
+inline std::optional<SkColor> CalculateAccent(SkBitmap bitmap) {
+  if (bitmap.empty() || bitmap.isNull()) {
+    return std::nullopt;
+  }
+
+  bool has_visible_pixels = false;
+  for (int y = 0; y < bitmap.height() && !has_visible_pixels; ++y) {
+    for (int x = 0; x < bitmap.width(); ++x) {
+      if (SkColorGetA(bitmap.getColor(x, y)) != SK_AlphaTRANSPARENT) {
+        has_visible_pixels = true;
+        break;
+      }
+    }
+  }
+  if (!has_visible_pixels) {
+    return std::nullopt;
+  }
+
+  SkColor color = color_utils::CalculateKMeanColorOfBitmap(bitmap);
+  color_utils::HSL hsl;
+  color_utils::SkColorToHSL(color, &hsl);
+  // White, black, and gray favicons do not provide a useful hue. Callers use
+  // their theme-aware neutral fallback for those icons.
+  if (hsl.s < 0.12) {
+    return std::nullopt;
+  }
+  hsl.s = std::max(hsl.s, 0.45);
+  hsl.l = std::clamp(hsl.l, 0.28, 0.72);
+  return color_utils::HSLToSkColor(hsl, SK_AlphaOPAQUE);
+}
+
+inline SkColor EnsureContrast(SkColor accent,
+                              SkColor background,
+                              SkColor fallback) {
+  if (SkColorGetA(accent) == SK_AlphaTRANSPARENT) {
+    return fallback;
+  }
+  if (color_utils::GetContrastRatio(accent, background) >= 1.35f) {
+    return accent;
+  }
+  return color_utils::BlendTowardMaxContrast(accent, 0xcc);
+}
+
+}  // namespace helium::favorite_favicon
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_COMMON_FAVORITE_FAVICON_STYLE_H_
