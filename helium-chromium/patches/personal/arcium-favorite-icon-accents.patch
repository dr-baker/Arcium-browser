+  if (!favorite_presentation_ ||
+      requested_url != tab_data_.visible_url ||
+      generation != favorite_favicon_generation_) {
+    return;
+  }
+  favorite_favicon_accent_color_ = std::move(color);
+  if (GetColorProvider()) {
+    UpdateColors();
+  }
