+void TabView::LoadFavoriteFavicon() {
+  favorite_favicon_task_tracker_.TryCancelAll();
+  if (!favorite_presentation_ || !tab_data_.visible_url.is_valid() ||
+      !collection_node_) {
+    return;
+  }
+
+  BrowserView* browser_view =
+      collection_node_->GetController()->GetBrowserView();
+  if (!browser_view) {
+    return;
+  }
+  favicon::FaviconService* favicon_service = FaviconServiceFactory::GetForProfile(
+      browser_view->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+  if (!favicon_service) {
+    return;
+  }
+
+  if (auto* driver = favicon::ContentFaviconDriver::FromWebContents(
+          GetTabInterface()->GetContents())) {
+    driver->EnableLargeIcons();
+  }
+  auto* history_service = HistoryServiceFactory::GetForProfile(
+      browser_view->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+  if (!favorite_favicon_subscription_ && history_service) {
+    favorite_favicon_subscription_ =
+        history_service->AddFaviconsChangedCallback(base::BindRepeating(
+            [](base::WeakPtr<TabView> view, const std::set<GURL>& urls,
+               const GURL&) {
+              if (view && view->favorite_presentation_ &&
+                  (urls.empty() || urls.contains(view->tab_data_.visible_url))) {
+                view->LoadFavoriteFavicon();
+              }
+            }, weak_ptr_factory_.GetWeakPtr()));
+  }
+  const GURL requested_url = tab_data_.visible_url;
+  const uint64_t generation = favorite_favicon_generation_;
+  favicon_service->GetRawFaviconForPageURL(
+      requested_url,
+      {favicon_base::IconType::kFavicon,
+       favicon_base::IconType::kTouchIcon,
+       favicon_base::IconType::kTouchPrecomposedIcon,
+       favicon_base::IconType::kWebManifestIcon},
+      static_cast<int>(std::ceil(
+          kFavoriteIconDesignWidth * arcium::GetChromeUIScale(this) *
+          ui::GetScaleForMaxSupportedResourceScaleFactor())),
+      /*fallback_to_host=*/false,
+      base::BindOnce(&TabView::OnFavoriteCachedFaviconAvailable,
+                     weak_ptr_factory_.GetWeakPtr(), requested_url,
+                     generation, /*host_fallback=*/false),
+      &favorite_favicon_task_tracker_);
+}
+
+void TabView::LoadFavoriteHostFallbackFavicon(const GURL& requested_url,
+                                             uint64_t generation) {
+  if (!favorite_presentation_ || requested_url != tab_data_.visible_url ||
+      generation != favorite_favicon_generation_ || !collection_node_) {
+    return;
+  }
+  BrowserView* browser_view =
+      collection_node_->GetController()->GetBrowserView();
+  if (!browser_view) {
+    return;
+  }
+  favicon::FaviconService* favicon_service = FaviconServiceFactory::GetForProfile(
+      browser_view->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+  if (!favicon_service) {
+    return;
+  }
+
+  favicon_service->GetRawFaviconForPageURL(
+      requested_url,
+      {favicon_base::IconType::kFavicon,
+       favicon_base::IconType::kTouchIcon,
+       favicon_base::IconType::kTouchPrecomposedIcon,
+       favicon_base::IconType::kWebManifestIcon},
+      static_cast<int>(std::ceil(
+          kFavoriteIconDesignWidth * arcium::GetChromeUIScale(this) *
+          ui::GetScaleForMaxSupportedResourceScaleFactor())),
+      /*fallback_to_host=*/true,
+      base::BindOnce(&TabView::OnFavoriteCachedFaviconAvailable,
+                     weak_ptr_factory_.GetWeakPtr(), requested_url,
+                     generation, /*host_fallback=*/true),
+      &favorite_favicon_task_tracker_);
+}
+
+void TabView::OnFavoriteCachedFaviconAvailable(
+    const GURL& requested_url,
+    uint64_t generation,
+    bool host_fallback,
+    const favicon_base::FaviconRawBitmapResult& bitmap_result) {
+  if (!favorite_presentation_ || requested_url != tab_data_.visible_url ||
+      generation != favorite_favicon_generation_) {
+    return;
+  }
+  if (!bitmap_result.is_valid()) {
+    if (!host_fallback) {
+      LoadFavoriteHostFallbackFavicon(requested_url, generation);
+    }
+    return;
+  }
+
+  gfx::Image decoded =
+      gfx::Image::CreateFrom1xPNGBytes(bitmap_result.bitmap_data);
+  if (decoded.IsEmpty() || bitmap_result.pixel_size.width() <= 0) {
+    if (!host_fallback) {
+      LoadFavoriteHostFallbackFavicon(requested_url, generation);
+    }
+    return;
+  }
+  const float scale = std::max(
+      1.0f, static_cast<float>(bitmap_result.pixel_size.width()) /
+                static_cast<float>(kFavoriteIconDesignWidth *
+                                   arcium::GetChromeUIScale(this)));
+  gfx::ImageSkia image =
+      gfx::ImageSkia::CreateFromBitmap(decoded.AsBitmap(), scale);
+  image.EnsureRepsForSupportedScales();
+  icon_->SetFavoriteFavicon(
+      ui::ImageModel::FromImageSkia(image), requested_url,
+      tab_data_.should_themify_favicon);
 }
 
