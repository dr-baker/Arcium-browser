+favicon_base::FaviconRawBitmapResult MakeCachedFaviconResult(
+    SkColor color,
+    const GURL& icon_url,
+    int pixel_size) {
+  SkBitmap bitmap;
+  bitmap.allocN32Pixels(pixel_size, pixel_size);
+  bitmap.eraseColor(color);
+  std::optional<std::vector<uint8_t>> png =
+      gfx::PNGCodec::EncodeBGRASkBitmap(bitmap, /*discard_transparency=*/false);
+  CHECK(png);
+
+  favicon_base::FaviconRawBitmapResult result;
+  result.bitmap_data =
+      base::MakeRefCounted<base::RefCountedBytes>(std::move(*png));
+  result.pixel_size = gfx::Size(pixel_size, pixel_size);
+  result.icon_url = icon_url;
+  result.icon_type = favicon_base::IconType::kFavicon;
+  result.fetched_because_of_page_visit = true;
+  return result;
+}
