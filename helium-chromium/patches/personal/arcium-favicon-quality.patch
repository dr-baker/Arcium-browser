+TEST_F(PersistentTabViewTest,
+       LiveFavoriteKeepsCachedBitmapAcrossStandardTabDataUpdates) {
+  const GURL page_url("https://example.test/");
+  SkBitmap standard_bitmap;
+  standard_bitmap.allocN32Pixels(16, 16);
+  standard_bitmap.eraseColor(SK_ColorBLUE);
+  tabs::TabData live_data;
+  live_data.visible_url = page_url;
+  live_data.favicon = ui::ImageModel::FromImageSkia(
+      gfx::ImageSkia::CreateFromBitmap(standard_bitmap, 1.0f));
+
+  SkBitmap cached_bitmap;
+  cached_bitmap.allocN32Pixels(48, 48);
+  cached_bitmap.eraseColor(SK_ColorRED);
+  const ui::ImageModel cached_favicon = ui::ImageModel::FromImageSkia(
+      gfx::ImageSkia::CreateFromBitmap(cached_bitmap, 2.0f));
+
+  TabIcon icon;
+  icon.SetFaviconSize(24);
+  icon.SetData(live_data);
+  icon.SetFavoriteFavicon(cached_favicon, page_url,
+                          /*should_themify_favicon=*/false);
+  ASSERT_EQ(cached_favicon, icon.GetFaviconForTesting());
+
+  SkBitmap updated_standard_bitmap;
+  updated_standard_bitmap.allocN32Pixels(16, 16);
+  updated_standard_bitmap.eraseColor(SK_ColorGREEN);
+  live_data.favicon = ui::ImageModel::FromImageSkia(
+      gfx::ImageSkia::CreateFromBitmap(updated_standard_bitmap, 1.0f));
+  icon.SetData(live_data);
+  EXPECT_EQ(cached_favicon, icon.GetFaviconForTesting());
+
+  icon.ClearFavoriteFavicon();
+  icon.SetData(live_data);
+  EXPECT_EQ(live_data.favicon, icon.GetFaviconForTesting());
+
+  icon.SetFavoriteFavicon(cached_favicon, page_url,
+                          /*should_themify_favicon=*/false);
+
+  live_data.visible_url = GURL("https://other.test/");
+  icon.SetData(live_data);
+  EXPECT_EQ(live_data.favicon, icon.GetFaviconForTesting());
+}
