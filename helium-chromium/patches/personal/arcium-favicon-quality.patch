+void ContentFaviconDriver::EnableLargeIcons() {
+  if (!EnableLargeIconHandlers()) {
+    return;
+  }
+  needs_large_icon_refresh_ = true;
+  content::RenderFrameHost* frame = web_contents()->GetPrimaryMainFrame();
+  if (!frame || !frame->GetLastCommittedURL().SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  // A valid imported 16/32px bitmap otherwise satisfies the largest handler.
+  // Refresh once when this loaded tab first opts into larger artwork.
+  SetFaviconOutOfDateForPage(frame->GetLastCommittedURL(), false);
+  needs_large_icon_refresh_ = false;
+  FetchFavicon(frame->GetLastCommittedURL(), /*is_same_document=*/false);
+  if (frame->IsDocumentOnLoadCompletedInMainFrame()) {
+    OnUpdateCandidates(frame->GetLastCommittedURL(),
+                       FaviconURLsFromContentFaviconURLs(frame->FaviconURLs()),
+                       GetManifestURL(frame));
+  }
+}
