+GlassBackendAvailability GetNativeFrameGlassAvailability() {
+  bool liquid_glass = false;
+  if (@available(macOS 26.0, *)) {
+    liquid_glass = true;
+  }
+  return {.native_liquid_glass = liquid_glass,
+          .native_material = true,
+          .reduce_transparency = GlassReduceTransparency()};
+}
+
+NSView* CreateNativeGlassBackgroundView(
+    NSRect frame,
+    ui::ColorProviderKey::ColorMode color_mode,
+    SkColor tint_color) {
+  const GlassBackend resolved =
+      ResolveGlassSurface(GlassHost::kNativeFrame).resolved;
+  if (resolved == GlassBackend::kNativeMaterial) {
+    return CreateNativeFrameMaterialBackgroundView(frame, color_mode,
+                                                   tint_color);
+  }
+  if (resolved == GlassBackend::kNativeLiquidGlass) {
+    if (@available(macOS 26.0, *)) {
+      NSGlassEffectView* glass_view =
+          [[ArciumLiquidGlassBackgroundView alloc] initWithFrame:frame];
+      glass_view.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+      glass_view.style = NSGlassEffectViewStyleRegular;
+      glass_view.tintColor = ColorFromSkColor(tint_color, 0.40);
+      return glass_view;
+    }
+  }
+  return nil;
+}
+
+}  // namespace helium
