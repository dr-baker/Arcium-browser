+++ src/chrome/browser/ui/views/helium/glass_surface.cc
@@ -0,0 +1,274 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license found in the LICENSE file.
+
+#include "chrome/browser/ui/views/helium/glass_surface.h"
+
+#include <algorithm>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/notreached.h"
+#include "base/trace_event/trace_event.h"
+#include "cc/paint/filter_operation.h"
+#include "cc/paint/filter_operations.h"
+#include "cc/paint/paint_filter.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/compositor/layer.h"
+
+namespace helium {
+
+namespace {
+
+struct MaterialTuning {
+  float blur_radius;
+  float edge_width;
+  float refraction;
+  float dispersion;
+  float tint_strength;
+  float saturation;
+  float specular;
+  float grain;
+  SkColor4f tint;
+};
+
+constexpr MaterialTuning kBasicTuning = {
+    .blur_radius = 13.0f, .edge_width = 28.0f, .refraction = 0.6f,
+    .dispersion = 0.0f, .tint_strength = 0.10f, .saturation = 1.03f,
+    .specular = 0.08f, .grain = 0.004f,
+    .tint = {0.76f, 0.84f, 1.0f, 1.0f},
+};
+
+constexpr MaterialTuning kGlassmorphicTuning = {
+    .blur_radius = 10.0f, .edge_width = 18.0f, .refraction = 7.0f,
+    .dispersion = 0.15f, .tint_strength = 0.12f, .saturation = 1.10f,
+    .specular = 0.26f, .grain = 0.008f,
+    .tint = {0.50f, 0.69f, 1.0f, 1.0f},
+};
+
+constexpr float kBackdropFilterQuality = 1.0f;
+constexpr float kMaxSampleRadius = 20.0f;
+
+const MaterialTuning& GetMaterialTuning(GlassSurfacePreset preset) {
+  switch (preset) {
+    case GlassSurfacePreset::kBasic:
+      return kBasicTuning;
+    case GlassSurfacePreset::kGlassmorphic:
+      return kGlassmorphicTuning;
+  }
+  NOTREACHED();
+}
+
+float ClampUnit(float value) {
+  return std::clamp(value, 0.0f, 1.0f);
+}
+
+}  // namespace
+
+GlassBackend GetRequestedGlassBackend() {
+  const std::string value =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          kArciumGlassBackendSwitch);
+  if (value == "liquid-glass") {
+    return GlassBackend::kNativeLiquidGlass;
+  }
+  if (value == "material") {
+    return GlassBackend::kNativeMaterial;
+  }
+  if (value == "chromium") {
+    return GlassBackend::kChromium;
+  }
+  if (value == "opaque") {
+    return GlassBackend::kOpaque;
+  }
+  return GlassBackend::kAuto;
+}
+
+GlassBackend ResolveGlassBackend(
+    GlassBackend requested,
+    const GlassBackendAvailability& availability) {
+  if (availability.reduce_transparency || requested == GlassBackend::kOpaque) {
+    return GlassBackend::kOpaque;
+  }
+  if (requested != GlassBackend::kAuto) {
+    const bool available =
+        (requested == GlassBackend::kNativeLiquidGlass &&
+         availability.native_liquid_glass) ||
+        (requested == GlassBackend::kNativeMaterial &&
+         availability.native_material) ||
+        (requested == GlassBackend::kChromium && availability.chromium) ||
+        requested == GlassBackend::kOpaque;
+    if (available) {
+      return requested;
+    }
+  }
+  if (availability.native_liquid_glass) {
+    return GlassBackend::kNativeLiquidGlass;
+  }
+  if (availability.native_material) {
+    return GlassBackend::kNativeMaterial;
+  }
+  if (availability.chromium) {
+    return GlassBackend::kChromium;
+  }
+  return GlassBackend::kOpaque;
+}
+
+#if !BUILDFLAG(IS_MAC)
+bool GlassReduceTransparency() {
+  return false;
+}
+
+GlassBackendAvailability GetNativeFrameGlassAvailability() {
+  return {};
+}
+#endif
+
+GlassResolution ResolveGlassSurface(GlassHost host) {
+  GlassBackendAvailability availability;
+  if (host == GlassHost::kEmbedded) {
+    availability.chromium = true;
+    availability.reduce_transparency = GlassReduceTransparency();
+  } else {
+    availability = GetNativeFrameGlassAvailability();
+  }
+  const GlassBackend requested = GetRequestedGlassBackend();
+  const GlassBackend resolved = ResolveGlassBackend(requested, availability);
+  const char* reason = availability.reduce_transparency ? "reduce-transparency"
+      : requested == GlassBackend::kOpaque ? "explicit-opaque"
+      : resolved == GlassBackend::kOpaque ? "no-supported-renderer"
+      : requested != GlassBackend::kAuto && requested != resolved
+          ? "preferred-renderer-unavailable" : "none";
+  TRACE_EVENT_INSTANT("ui", "Arcium.Glass.Resolve", "requested",
+                     GlassBackendName(requested), "resolved",
+                     GlassBackendName(resolved), "host",
+                     host == GlassHost::kEmbedded ? "embedded" : "native-frame",
+                     "fallback_reason", reason);
+  return {requested, resolved, host, reason};
+}
+
+const char* GlassBackendName(GlassBackend backend) {
+  switch (backend) {
+    case GlassBackend::kAuto:
+      return "auto";
+    case GlassBackend::kNativeLiquidGlass:
+      return "liquid-glass";
+    case GlassBackend::kNativeMaterial:
+      return "material";
+    case GlassBackend::kChromium:
+      return "chromium";
+    case GlassBackend::kOpaque:
+      return "opaque";
+  }
+  NOTREACHED();
+}
+
+GlassSurfaceView::GlassSurfaceView(const GlassSurfaceParams& params)
+    : backend_(ResolveGlassSurface(GlassHost::kEmbedded).resolved),
+      preset_(params.preset),
+      tint_color_(params.tint_color),
+      tint_strength_(ClampUnit(params.tint_strength)),
+      opacity_(ClampUnit(params.opacity)),
+      opaque_color_(params.opaque_color),
+      corner_radii_(params.corner_radii) {
+  SetCanProcessEventsWithinSubtree(false);
+  // A transparent solid layer supplies drawable bounds for backdrop filtering.
+  SetPaintToLayer(ui::LAYER_SOLID_COLOR);
+  UpdateLayer();
+}
+
+GlassSurfaceView::~GlassSurfaceView() = default;
+
+void GlassSurfaceView::SetPreset(GlassSurfacePreset preset) {
+  if (preset_ == preset) {
+    return;
+  }
+  preset_ = preset;
+  UpdateLayer();
+}
+
+void GlassSurfaceView::SetTintColor(SkColor tint_color) {
+  if (tint_color_ == tint_color) {
+    return;
+  }
+  tint_color_ = tint_color;
+  UpdateLayer();
+}
+
+void GlassSurfaceView::SetTintStrength(float tint_strength) {
+  tint_strength = ClampUnit(tint_strength);
+  if (tint_strength_ == tint_strength) {
+    return;
+  }
+  tint_strength_ = tint_strength;
+  UpdateLayer();
+}
+
+void GlassSurfaceView::SetOpacity(float opacity) {
+  opacity = ClampUnit(opacity);
+  if (opacity_ == opacity) {
+    return;
+  }
+  opacity_ = opacity;
+  UpdateLayer();
+}
+
+void GlassSurfaceView::SetCornerRadii(
+    const gfx::RoundedCornersF& corner_radii) {
+  if (corner_radii_ == corner_radii) {
+    return;
+  }
+  corner_radii_ = corner_radii;
+  UpdateLayer();
+}
+
+void GlassSurfaceView::UpdateLayer() {
+  if (!layer()) {
+    return;
+  }
+
+  const MaterialTuning& tuning = GetMaterialTuning(preset_);
+  layer()->SetOpacity(1.0f);
+  layer()->SetColor(backend_ == GlassBackend::kOpaque ? opaque_color_
+                                                      : SK_ColorTRANSPARENT);
+  layer()->SetBackgroundBlur(0.0f);
+  layer()->SetBackdropFilterQuality(kBackdropFilterQuality);
+  layer()->SetRoundedCornerRadius(corner_radii_);
+  layer()->SetIsFastRoundedCorner(!corner_radii_.IsEmpty());
+  cc::FilterOperations filters;
+  const gfx::Size size = GetLocalBounds().size();
+  if (backend_ == GlassBackend::kChromium && opacity_ > 0.0f &&
+      !size.IsEmpty()) {
+    cc::GlassmorphicFilterParams params;
+    params.resolution = SkSize::Make(size.width(), size.height());
+    params.panel_size = params.resolution;
+    params.corner_radius = corner_radii_.upper_left();
+    params.blur_radius = tuning.blur_radius;
+    params.opacity = opacity_;
+    params.edge_width = tuning.edge_width;
+    params.refraction = tuning.refraction;
+    params.dispersion = tuning.dispersion;
+    params.tint_strength = ClampUnit(tuning.tint_strength + tint_strength_);
+    params.saturation = tuning.saturation;
+    params.specular = tuning.specular;
+    params.grain = tuning.grain;
+    const SkColor4f external = SkColor4f::FromColor(tint_color_);
+    params.tint = {tuning.tint.fR * external.fR,
+                   tuning.tint.fG * external.fG,
+                   tuning.tint.fB * external.fB, 1.0f};
+    const SkRect crop = SkRect::MakeWH(size.width(), size.height());
+    filters.Append(cc::FilterOperation::CreateReferenceFilter(
+        sk_make_sp<cc::GlassmorphicPaintFilter>(params, kMaxSampleRadius,
+                                                &crop)));
+  }
+  layer()->SetCustomBackdropFilters(filters);
+}
+
+void GlassSurfaceView::OnBoundsChanged(const gfx::Rect& previous_bounds) {
+  UpdateLayer();
+}
+
+BEGIN_METADATA(GlassSurfaceView)
+END_METADATA
+
+}  // namespace helium
