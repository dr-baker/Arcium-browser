+IN_PROC_BROWSER_TEST_F(PeekControllerBrowserTest,
+                       SplitSourceRetainsLayoutAndContentsHosts) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL url = embedded_test_server()->GetURL("/empty.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), url));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), url, WindowOpenDisposition::NEW_BACKGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  TabStripModel* const model = browser()->tab_strip_model();
+  BrowserView* const view = BrowserView::GetBrowserViewForBrowser(browser());
+  PeekController* const controller = view->peek_controller();
+  const auto split =
+      model->AddToNewSplit({1}, split_tabs::SplitTabVisualData(),
+                           split_tabs::SplitTabCreatedSource::kToolbarButton);
+  for (int source_index : {0, 1}) {
+    model->ActivateTabAt(source_index);
+    content::WebContents* const source = model->GetWebContentsAt(source_index);
+    ASSERT_TRUE(controller->Show(PeekNavigationParams(url), source));
+    content::WebContents* const preview =
+        controller->web_contents_for_testing();
+    ASSERT_TRUE(content::WaitForLoadStop(preview));
+    EXPECT_EQ(split, model->GetSplitForTab(0));
+    EXPECT_EQ(split, model->GetSplitForTab(1));
+    EXPECT_FALSE(model->GetSplitForTab(model->GetIndexOfWebContents(preview)));
+    auto* const host = view->GetContentsContainerViewFor(preview);
+    ASSERT_TRUE(host);
+    EXPECT_EQ(preview, host->contents_view()->web_contents());
+    EXPECT_TRUE(source->ShouldIgnoreInputEventsForTesting());
+
+    controller->Close();
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return !controller->is_showing() &&
+             model->GetActiveWebContents() == source;
+    }));
+    EXPECT_EQ(2, model->count());
+    EXPECT_EQ(source, model->GetActiveWebContents());
+    EXPECT_EQ(split, model->GetSplitForTab(0));
+    EXPECT_EQ(split, model->GetSplitForTab(1));
+    EXPECT_FALSE(source->ShouldIgnoreInputEventsForTesting());
+    for (int index : {0, 1}) {
+      content::WebContents* const contents = model->GetWebContentsAt(index);
+      auto* const restored_host = view->GetContentsContainerViewFor(contents);
+      ASSERT_TRUE(restored_host);
+      EXPECT_EQ(contents, restored_host->contents_view()->web_contents());
+    }
+  }
+}
