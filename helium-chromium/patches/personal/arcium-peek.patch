+  raw_ptr<BrowserView> browser_view_;
+  raw_ptr<TabStripModel> tab_strip_model_ = nullptr;
+  raw_ptr<ContentsContainerView> contents_container_ = nullptr;
+  raw_ptr<views::View> overlay_view_ = nullptr;
+  raw_ptr<views::WebView> backdrop_view_ = nullptr;
+  base::WeakPtr<content::WebContents> preview_contents_;
+  base::WeakPtr<content::WebContents> source_contents_;
+  bool close_pending_ = false;
+  bool close_scheduled_ = false;
+  bool restore_source_on_close_ = false;
