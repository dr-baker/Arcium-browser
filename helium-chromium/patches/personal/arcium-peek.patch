+#if !BUILDFLAG(IS_ANDROID)
+TEST_F(RenderViewContextMenuPrefsTest, PeekIsAvailableOnlyForHttpLinks) {
+  content::ContextMenuParams params = CreateParams(MenuItem::LINK);
+  params.link_url = GURL("https://peek.example/page");
+  params.unfiltered_link_url = params.link_url;
+
+  TestRenderViewContextMenu menu(*web_contents()->GetPrimaryMainFrame(),
+                                 params);
+  custom_handlers::ProtocolHandlerRegistry registry(profile()->GetPrefs(),
+                                                    nullptr);
+  menu.set_protocol_handler_registry(&registry);
+  menu.Init();
+  EXPECT_TRUE(menu.IsItemPresent(IDC_CONTENT_CONTEXT_OPENLINKPEEK));
+  EXPECT_TRUE(menu.IsCommandIdEnabled(IDC_CONTENT_CONTEXT_OPENLINKPEEK));
+
+  params.link_url = GURL("file:///tmp/peek.html");
+  params.unfiltered_link_url = params.link_url;
+  TestRenderViewContextMenu file_menu(
+      *web_contents()->GetPrimaryMainFrame(), params);
+  file_menu.set_protocol_handler_registry(&registry);
+  file_menu.Init();
+  EXPECT_FALSE(file_menu.IsItemPresent(IDC_CONTENT_CONTEXT_OPENLINKPEEK));
+}
+
+TEST_F(RenderViewContextMenuPrefsTest, PeekCanBeDisabled) {
+  profile()->GetPrefs()->SetBoolean(prefs::kHeliumPeekEnabled, false);
+  content::ContextMenuParams params = CreateParams(MenuItem::LINK);
+  params.link_url = GURL("https://peek.example/page");
+  params.unfiltered_link_url = params.link_url;
+
+  TestRenderViewContextMenu menu(*web_contents()->GetPrimaryMainFrame(),
+                                 params);
+  custom_handlers::ProtocolHandlerRegistry registry(profile()->GetPrefs(),
+                                                    nullptr);
+  menu.set_protocol_handler_registry(&registry);
+  menu.Init();
+
+  EXPECT_FALSE(menu.IsItemPresent(IDC_CONTENT_CONTEXT_OPENLINKPEEK));
+  EXPECT_FALSE(menu.IsCommandIdEnabled(IDC_CONTENT_CONTEXT_OPENLINKPEEK));
+}
