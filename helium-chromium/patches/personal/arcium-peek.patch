+IN_PROC_BROWSER_TEST_F(PeekControllerBrowserTest,
+                       TemporarySessionExclusionAndLivePromotion) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL source_url = embedded_test_server()->GetURL("/empty.html");
+  const GURL preview_url = embedded_test_server()->GetURL("/title1.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), source_url));
+  TabStripModel* const model = browser()->tab_strip_model();
+  content::WebContents* const source = model->GetActiveWebContents();
+  PeekController* const controller =
+      BrowserView::GetBrowserViewForBrowser(browser())->peek_controller();
+  SessionService* const service =
+      SessionServiceFactory::GetForProfile(browser()->profile());
+  ASSERT_TRUE(service);
+  auto* const live_context = browser()->GetFeatures().live_tab_context();
+  SessionServiceTestHelper helper(service);
+  const auto read_snapshot = [&]() {
+    service->ResetFromCurrentBrowsers();
+    helper.SaveNow();
+    helper.command_storage_manager()->MoveCurrentSessionToLastSession();
+    // Read through the production service so queued writes and reads use its
+    // backend sequence, rather than performing file I/O on the browser thread.
+    base::test::TestFuture<
+        std::vector<std::unique_ptr<sessions::SessionWindow>>, SessionID, bool>
+        snapshot;
+    service->GetLastSession(snapshot.GetCallback());
+    EXPECT_FALSE(snapshot.Get<2>());
+    return std::get<0>(snapshot.Take());
+  };
+
+  ASSERT_TRUE(controller->Show(PeekNavigationParams(preview_url), source));
+  content::WebContents* const preview = controller->web_contents_for_testing();
+  ASSERT_TRUE(content::WaitForLoadStop(preview));
+  ASSERT_TRUE(content::ExecJs(preview, "window.peekState = 'retained'"));
+  const SessionID preview_id = sessions::SessionTabHelper::IdForTab(preview);
+  EXPECT_EQ(2, model->count());
+  EXPECT_EQ(1, live_context->GetTabCount());
+  EXPECT_EQ(0, live_context->GetSelectedIndex());
+  EXPECT_FALSE(preview->GetController()
+                   .GetDefaultSessionStorageNamespace()
+                   ->should_persist());
+  auto temporary_snapshot = read_snapshot();
+  ASSERT_EQ(1u, temporary_snapshot.size());
+  ASSERT_EQ(1u, temporary_snapshot[0]->tabs.size());
+  EXPECT_EQ(sessions::SessionTabHelper::IdForTab(source),
+            temporary_snapshot[0]->tabs[0]->tab_id);
+
+  controller->OpenInTab();
+  EXPECT_EQ(preview, model->GetActiveWebContents());
+  EXPECT_EQ(preview_id, sessions::SessionTabHelper::IdForTab(preview));
+  EXPECT_EQ("retained", content::EvalJs(preview, "window.peekState"));
+  EXPECT_EQ(2, model->count());
+  EXPECT_EQ(2, live_context->GetTabCount());
+  EXPECT_EQ(1, live_context->GetSelectedIndex());
+  // This assertion covers incremental enrollment before a snapshot rebuild.
+  EXPECT_TRUE(preview->GetController()
+                  .GetDefaultSessionStorageNamespace()
+                  ->should_persist());
+  auto promoted_snapshot = read_snapshot();
+  ASSERT_EQ(1u, promoted_snapshot.size());
+  ASSERT_EQ(2u, promoted_snapshot[0]->tabs.size());
+  EXPECT_EQ(preview_id, promoted_snapshot[0]->tabs[1]->tab_id);
+  EXPECT_EQ(1, promoted_snapshot[0]->selected_tab_index);
+
+  auto* const restore_service =
+      TabRestoreServiceFactory::GetForProfile(browser()->profile());
+  ASSERT_TRUE(restore_service);
+  const size_t restored_entries = restore_service->entries().size();
+  model->ActivateTabAt(model->GetIndexOfWebContents(source));
+  ASSERT_TRUE(controller->Show(PeekNavigationParams(preview_url), source));
+  ASSERT_TRUE(content::WaitForLoadStop(controller->web_contents_for_testing()));
+  controller->Close();
+  EXPECT_EQ(restored_entries, restore_service->entries().size());
+  EXPECT_EQ(2, model->count());
+  // Ordinary tabs are the negative control for recently-closed exclusion.
+  model->CloseWebContentsAt(model->GetIndexOfWebContents(preview),
+                            TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  EXPECT_EQ(restored_entries + 1, restore_service->entries().size());
+}
