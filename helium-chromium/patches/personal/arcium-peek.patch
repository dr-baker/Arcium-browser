+content::NavigationController::LoadURLParams PeekNavigationParams(
+    const GURL& url) {
+  return content::NavigationController::LoadURLParams(content::OpenURLParams(
+      url, content::Referrer(), WindowOpenDisposition::CURRENT_TAB,
+      ui::PAGE_TRANSITION_LINK, /*is_renderer_initiated=*/false));
+}
