+            content::WebContents* source_contents);
+  void Close();
+  void OpenInTab();
+  void OpenInSidebar();
+
+  bool is_showing() const { return preview_contents_ != nullptr; }
+  content::WebContents* web_contents_for_testing() const {
+    return preview_contents_.get();
+  }
+  views::View* overlay_view_for_testing() const { return overlay_view_; }
+
