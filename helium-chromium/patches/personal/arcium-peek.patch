+IN_PROC_BROWSER_TEST_F(PeekControllerBrowserTest,
+                       CyclingAndSourceRemovalReleaseBackdrop) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL url = embedded_test_server()->GetURL("/empty.html");
+  TabStripModel* const model = browser()->tab_strip_model();
+  content::WebContents* const source = model->GetActiveWebContents();
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), url, WindowOpenDisposition::NEW_BACKGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  content::WebContents* const other = model->GetWebContentsAt(1);
+  PeekController* const controller =
+      BrowserView::GetBrowserViewForBrowser(browser())->peek_controller();
+
+  ASSERT_TRUE(controller->Show(PeekNavigationParams(url), source));
+  ASSERT_TRUE(content::WaitForLoadStop(controller->web_contents_for_testing()));
+  model->SelectNextTab();
+  EXPECT_EQ(other, model->GetActiveWebContents());
+  ASSERT_TRUE(base::test::RunUntil([&] { return !controller->is_showing(); }));
+  EXPECT_FALSE(source->ShouldIgnoreInputEventsForTesting());
+  EXPECT_EQ(2, model->count());
+
+  model->ActivateTabAt(model->GetIndexOfWebContents(source));
+  ASSERT_TRUE(controller->Show(PeekNavigationParams(url), source));
+  content::WebContents* const preview = controller->web_contents_for_testing();
+  ASSERT_TRUE(content::WaitForLoadStop(preview));
+  ASSERT_TRUE(content::ExecJs(preview,
+                              "window.peekState = 'source gone'; "
+                              "window.onbeforeunload = () => 'stay';"));
+  content::PrepContentsForBeforeUnloadTest(preview);
+  const auto source_weak = source->GetWeakPtr();
+  model->CloseWebContentsAt(model->GetIndexOfWebContents(source),
+                            TabCloseTypes::CLOSE_NONE);
+  auto* const dialog = ui_test_utils::WaitForAppModalDialog();
+  ASSERT_TRUE(dialog->is_before_unload_dialog());
+  EXPECT_FALSE(source_weak);
+  dialog->view()->CancelAppModalDialog();
+  ASSERT_TRUE(base::test::RunUntil([&] { return !controller->is_showing(); }));
+  EXPECT_EQ(preview, model->GetActiveWebContents());
+  EXPECT_FALSE(tabs::TemporaryTab::IsTemporary(preview));
+  EXPECT_EQ("source gone", content::EvalJs(preview, "window.peekState"));
+  EXPECT_EQ(2, browser()->GetFeatures().live_tab_context()->GetTabCount());
+  ASSERT_TRUE(content::ExecJs(preview, "window.onbeforeunload = null"));
+}
+
+}  // namespace helium
