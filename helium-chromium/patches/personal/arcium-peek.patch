+  void OnPreviewWillDiscard(tabs::TabInterface* tab,
+                            content::WebContents* old_contents,
+                            content::WebContents* new_contents);
+  void OnSourceWillDetach(tabs::TabInterface* tab,
+                          tabs::TabInterface::DetachReason reason);
+  void OnSourceWillDiscard(tabs::TabInterface* tab,
+                           content::WebContents* old_contents,
+                           content::WebContents* new_contents);
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabCloseCancelled(const tabs::TabInterface* tab) override;
+  void WillCloseAllTabs(TabStripModel* model) override;
+  void CloseAllTabsStopped(TabStripModel* model,
