+IN_PROC_BROWSER_TEST_F(PeekControllerBrowserTest,
+                       CloseAndTransferLiveContents) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL url = embedded_test_server()->GetURL("/empty.html");
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser());
+  ASSERT_TRUE(browser_view);
+  PeekController* const controller = browser_view->peek_controller();
+  ASSERT_TRUE(controller);
+  content::WebContents* const source =
+      browser()->tab_strip_model()->GetActiveWebContents();
+  ASSERT_TRUE(source);
+
+  EXPECT_FALSE(controller->Show(
+      PeekNavigationParams(GURL("file:///tmp/not-peekable")), source));
+  EXPECT_FALSE(controller->is_showing());
+
+  ASSERT_TRUE(controller->Show(PeekNavigationParams(url), source));
+  ASSERT_TRUE(controller->is_showing());
+  ASSERT_TRUE(content::WaitForLoadStop(controller->web_contents_for_testing()));
+  EXPECT_TRUE(source->ShouldIgnoreInputEventsForTesting());
+
+  controller->Close();
+  EXPECT_FALSE(controller->is_showing());
+  EXPECT_FALSE(source->ShouldIgnoreInputEventsForTesting());
+
+  ASSERT_TRUE(controller->Show(PeekNavigationParams(url), source));
+  content::WebContents* const preview_contents =
+      controller->web_contents_for_testing();
+  ASSERT_TRUE(content::WaitForLoadStop(preview_contents));
+  const int old_count = browser()->tab_strip_model()->count();
+  const int source_index =
+      browser()->tab_strip_model()->GetIndexOfWebContents(source);
+  controller->OpenInSidebar();
+
+  EXPECT_FALSE(controller->is_showing());
+  EXPECT_EQ(old_count, browser()->tab_strip_model()->count());
+  EXPECT_EQ(source, browser()->tab_strip_model()->GetActiveWebContents());
+  EXPECT_EQ(preview_contents,
+            browser()->tab_strip_model()->GetWebContentsAt(source_index + 1));
+  EXPECT_FALSE(source->ShouldIgnoreInputEventsForTesting());
+
+  ASSERT_TRUE(controller->Show(PeekNavigationParams(url), source));
+  content::WebContents* const command_preview_contents =
+      controller->web_contents_for_testing();
+  ASSERT_TRUE(content::WaitForLoadStop(command_preview_contents));
+  EXPECT_TRUE(chrome::ExecuteCommand(browser(), IDC_OPEN_FILE));
+
+  EXPECT_FALSE(controller->is_showing());
+  EXPECT_EQ(old_count + 1, browser()->tab_strip_model()->count());
+  EXPECT_EQ(command_preview_contents,
+            browser()->tab_strip_model()->GetActiveWebContents());
+  EXPECT_FALSE(source->ShouldIgnoreInputEventsForTesting());
+}
