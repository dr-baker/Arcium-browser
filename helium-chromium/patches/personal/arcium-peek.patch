+// This backdrop hosts only the inactive source. The live preview remains in
+// the browser's normal ContentsWebView above this view.
+class PeekOverlayView : public views::View {
+  METADATA_HEADER(PeekOverlayView, views::View)
+
+ public:
+  PeekOverlayView(Profile* profile,
+                  base::RepeatingClosure close_callback,
+                  base::RepeatingClosure open_in_tab_callback,
+                  base::RepeatingClosure open_in_sidebar_callback)
+      : close_callback_(close_callback) {
+    backdrop_view_ = AddChildView(std::make_unique<views::WebView>(profile));
+    backdrop_view_->SetCanProcessEventsWithinSubtree(false);
+    scrim_ = AddChildView(std::make_unique<views::View>());
+    scrim_->SetCanProcessEventsWithinSubtree(false);
+    close_button_ = AddChildView(CreatePeekActionButton(
+        std::move(close_callback), views::kCloseIcon,
+        l10n_util::GetStringUTF16(IDS_HELIUM_PEEK_CLOSE)));
+    open_in_tab_button_ = AddChildView(CreatePeekActionButton(
+        std::move(open_in_tab_callback), views::kOpenInNewIcon,
+        l10n_util::GetStringUTF16(IDS_HELIUM_PEEK_OPEN_IN_TAB)));
+    open_in_sidebar_button_ = AddChildView(CreatePeekActionButton(
+        std::move(open_in_sidebar_callback), views::kTabIcon,
+        l10n_util::GetStringUTF16(IDS_HELIUM_PEEK_OPEN_IN_SIDEBAR)));
+  }
+
+  views::WebView* backdrop_view() const { return backdrop_view_; }
+
+ private:
+  void OnThemeChanged() override {
+    views::View::OnThemeChanged();
+    const SkColor tint =
+        GetColorProvider()->GetColor(ui::kColorSysSurfaceVariant);
+    scrim_->SetBackground(views::CreateSolidBackground(SkColorSetA(tint, 184)));
+  }
+
+  void Layout(PassKey) override {
+    const gfx::Rect bounds = GetContentsBounds();
+    backdrop_view_->SetBoundsRect(bounds);
+    scrim_->SetBoundsRect(bounds);
+    const gfx::Rect card = GetPeekCardBounds(bounds);
+    const int controls_x = card.right() + kControlRailGap;
+    close_button_->SetBounds(controls_x, card.y(), kControlSize, kControlSize);
+    open_in_tab_button_->SetBounds(
+        controls_x, close_button_->bounds().bottom() + kControlGap,
+        kControlSize, kControlSize);
+    open_in_sidebar_button_->SetBounds(
+        controls_x, open_in_tab_button_->bounds().bottom() + kControlGap,
+        kControlSize, kControlSize);
+  }
+
+  bool OnMousePressed(const ui::MouseEvent&) override {
+    close_callback_.Run();
+    return true;
+  }
+
+  raw_ptr<views::WebView> backdrop_view_ = nullptr;
+  raw_ptr<views::View> scrim_ = nullptr;
+  raw_ptr<views::ImageButton> close_button_ = nullptr;
+  raw_ptr<views::ImageButton> open_in_tab_button_ = nullptr;
+  raw_ptr<views::ImageButton> open_in_sidebar_button_ = nullptr;
+  base::RepeatingClosure close_callback_;
+};
+
+BEGIN_METADATA(PeekOverlayView)
+END_METADATA
+
+}  // namespace
+
+bool IsPeekEnabled(Profile* profile) {
+  return profile && profile->GetPrefs()->GetBoolean(prefs::kHeliumPeekEnabled);
+}
+
+bool ShowPeekForLink(content::WebContents* source_contents,
+                     content::NavigationController::LoadURLParams params) {
+  tabs::TabInterface* const tab =
+      source_contents
+          ? tabs::TabInterface::MaybeGetFromContents(source_contents)
+          : nullptr;
+  BrowserWindowInterface* const browser_window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  Browser* const browser =
+      browser_window ? browser_window->GetBrowserForMigrationOnly() : nullptr;
+  BrowserView* const browser_view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  return browser_view && browser_view->peek_controller() &&
+         browser_view->peek_controller()->Show(std::move(params),
+                                               source_contents);
+}
+
+gfx::Rect GetPeekCardBounds(gfx::Rect bounds) {
+  bounds.Inset(gfx::Insets(kOverlayInset));
+  const int card_width =
+      std::min(kCardMaximumWidth,
+               std::max(0, bounds.width() - kControlRailGap - kControlSize));
+  const int card_height = std::min(kCardMaximumHeight, bounds.height());
+  const int group_width = card_width + kControlRailGap + kControlSize;
+  return gfx::Rect(bounds.x() + (bounds.width() - group_width) / 2,
+                   bounds.y() + (bounds.height() - card_height) / 2, card_width,
+                   card_height);
+}
+
+PeekController::PeekController(BrowserView* browser_view)
+    : browser_view_(browser_view),
+      tab_strip_model_(browser_view->browser()->tab_strip_model()) {
+  tab_strip_model_->AddObserver(this);
+  pref_change_registrar_.Init(browser_view_->browser()->profile()->GetPrefs());
+  pref_change_registrar_.Add(
+      prefs::kHeliumPeekEnabled,
+      base::BindRepeating(&PeekController::OnPeekEnabledChanged,
+                          weak_factory_.GetWeakPtr()));
+}
+
+PeekController::~PeekController() {
+  ClearPresentation();
+  ResetPreviewState();
+}
+
+bool PeekController::Show(content::NavigationController::LoadURLParams params,
+                          content::WebContents* source_contents) {
+  Browser* const browser = browser_view_->browser();
+  if (!tab_strip_model_ || tab_strip_model_->closing_all() ||
+      !IsPeekEnabled(browser->profile()) || !params.url.SchemeIsHTTPOrHTTPS() ||
+      !source_contents ||
+      source_contents->GetBrowserContext() != browser->profile() ||
+      tabs::TemporaryTab::IsTemporary(source_contents) ||
+      tab_strip_model_->GetIndexOfWebContents(source_contents) ==
+          TabStripModel::kNoTab) {
+    return false;
+  }
+  // Validate the source host before changing selection, then reacquire the
+  // preview's actual host after activation. Split activation changes hosts.
+  if (!browser_view_->GetContentsContainerViewFor(source_contents)) {
+    return false;
+  }
+  Close();
+  if (preview_contents_) {
+    return false;
+  }
+
+  auto contents = content::WebContents::Create(
+      content::WebContents::CreateParams(browser->profile()));
+  tabs::TemporaryTab::CreateForWebContents(contents.get(), source_contents);
+  auto tab =
+      std::make_unique<tabs::TabModel>(std::move(contents), tab_strip_model_);
+  preview_contents_ = tab->GetContents()->GetWeakPtr();
+  Observe(preview_contents_.get());
+  source_contents_ = source_contents->GetWeakPtr();
+  preview_will_deactivate_subscription_ = tab->RegisterWillDeactivate(
+      base::BindRepeating(&PeekController::OnPreviewWillDeactivate,
+                          weak_factory_.GetWeakPtr()));
+  preview_did_activate_subscription_ =
+      tab->RegisterDidActivate(base::BindRepeating(
+          &PeekController::OnPreviewDidActivate, weak_factory_.GetWeakPtr()));
+  preview_will_detach_subscription_ =
+      tab->RegisterWillDetach(base::BindRepeating(
+          &PeekController::OnPreviewWillDetach, weak_factory_.GetWeakPtr()));
+  preview_will_discard_subscription_ =
+      tab->RegisterWillDiscardContents(base::BindRepeating(
+          &PeekController::OnPreviewWillDiscard, weak_factory_.GetWeakPtr()));
+  tabs::TabInterface* source_tab =
+      tabs::TabInterface::GetFromContents(source_contents);
+  source_will_detach_subscription_ =
+      source_tab->RegisterWillDetach(base::BindRepeating(
+          &PeekController::OnSourceWillDetach, weak_factory_.GetWeakPtr()));
+  source_will_discard_subscription_ =
+      source_tab->RegisterWillDiscardContents(base::BindRepeating(
+          &PeekController::OnSourceWillDiscard, weak_factory_.GetWeakPtr()));
+  const int source_index =
+      tab_strip_model_->GetIndexOfWebContents(source_contents);
+  // Detached insertion inside a split removes the split. Keep the temporary
+  // tab outside it so closing Peek restores the source's existing layout.
+  int insertion_index = source_index + 1;
+  const auto source_split = source_tab->GetSplit();
+  while (source_split && tab_strip_model_->ContainsIndex(insertion_index) &&
+         tab_strip_model_->GetSplitForTab(insertion_index) == source_split) {
+    ++insertion_index;
+  }
+  tab_strip_model_->InsertDetachedTabAt(insertion_index, std::move(tab),
+                                        AddTabTypes::ADD_ACTIVE);
+  if (!AttachPresentation()) {
+    // Insertion used a fully initialized normal tab. If its host is
+    // unavailable, close the still-empty temporary tab and let the original
+    // request proceed.
+    Close();
+    return false;
+  }
+
+  // Retarget the destination frame while preserving the initiating frame,
+  // origin, referrer, user gesture and request context copied by upstream APIs.
+  params.frame_tree_node_id = content::FrameTreeNodeId();
+  preview_contents_->GetController().LoadURLWithParams(params);
+  contents_container_->contents_view()->RequestFocus();
+  return true;
+}
+
+bool PeekController::AttachPresentation() {
+  if (overlay_view_) {
+    return true;
+  }
+  if (!preview_contents_ || !source_contents_ || !tab_strip_model_ ||
+      !IsPeekEnabled(browser_view_->browser()->profile()) ||
+      tab_strip_model_->GetActiveWebContents() != preview_contents_.get()) {
+    return false;
+  }
+  ContentsContainerView* const container =
+      browser_view_->GetContentsContainerViewFor(preview_contents_.get());
+  if (!container ||
+      container->contents_view()->web_contents() != preview_contents_.get()) {
+    return false;
+  }
+  for (ContentsContainerView* host :
+       browser_view_->GetContentsContainerViews()) {
+    if (host->contents_view()->web_contents() == source_contents_.get()) {
+      return false;
+    }
+  }
+  auto overlay = std::make_unique<PeekOverlayView>(
+      browser_view_->browser()->profile(),
+      base::BindRepeating(&PeekController::Close, weak_factory_.GetWeakPtr()),
+      base::BindRepeating(&PeekController::OpenInTab,
+                          weak_factory_.GetWeakPtr()),
+      base::BindRepeating(&PeekController::OpenInSidebar,
+                          weak_factory_.GetWeakPtr()));
+  backdrop_view_ = overlay->backdrop_view();
+  overlay_view_ = overlay.get();
+  contents_container_ = container;
+  // Browser activation has already detached the source from its normal view.
+  backdrop_view_->SetWebContents(source_contents_.get());
+  scoped_ignore_input_events_ =
+      source_contents_->IgnoreInputEvents(std::nullopt);
+  container->peek_overlay_view()->AddChildView(std::move(overlay));
+  container->peek_overlay_view()->SetVisible(true);
+  container->SetPeekPresentation(true);
+  return true;
+}
+
+void PeekController::ClearPresentation() {
+  if (backdrop_view_) {
+    backdrop_view_->SetWebContents(nullptr);
+  }
+  backdrop_view_ = nullptr;
+  scoped_ignore_input_events_.reset();
+  if (contents_container_) {
+    contents_container_->SetPeekPresentation(false);
+    if (overlay_view_) {
+      contents_container_->peek_overlay_view()->RemoveChildViewT(overlay_view_);
+    }
+    contents_container_->peek_overlay_view()->SetVisible(false);
+  }
+  overlay_view_ = nullptr;
+  contents_container_ = nullptr;
+}
+
+void PeekController::ResetPreviewState() {
+  Observe(nullptr);
+  preview_will_deactivate_subscription_ = {};
+  preview_did_activate_subscription_ = {};
+  preview_will_detach_subscription_ = {};
+  preview_will_discard_subscription_ = {};
+  source_will_detach_subscription_ = {};
+  source_will_discard_subscription_ = {};
+  preview_contents_.reset();
+  source_contents_.reset();
+  close_pending_ = false;
+  close_scheduled_ = false;
+  restore_source_on_close_ = false;
+}
+
+void PeekController::Close() {
+  if (!preview_contents_) {
+    ClearPresentation();
+    ResetPreviewState();
+    return;
+  }
+  restore_source_on_close_ = true;
+  ClearPresentation();
+  if (close_pending_) {
+    return;
+  }
+  close_pending_ = true;
+  FinishClose(preview_contents_);
+}
+
+void PeekController::ScheduleClose(bool restore_source) {
+  restore_source_on_close_ = restore_source;
+  if (close_pending_ || closing_all_ || !tab_strip_model_ ||
+      tab_strip_model_->closing_all()) {
+    return;
+  }
+  close_pending_ = true;
+  close_scheduled_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&PeekController::FinishScheduledClose,
+                                weak_factory_.GetWeakPtr(), preview_contents_));
+}
+
+void PeekController::FinishScheduledClose(
+    base::WeakPtr<content::WebContents> expected_contents) {
+  if (!close_scheduled_ || expected_contents.get() != preview_contents_.get()) {
+    return;
+  }
+  close_scheduled_ = false;
+  FinishClose(expected_contents);
+}
+
+void PeekController::FinishClose(
+    base::WeakPtr<content::WebContents> expected_contents) {
+  if (!expected_contents ||
+      expected_contents.get() != preview_contents_.get() || !tab_strip_model_ ||
+      closing_all_ || tab_strip_model_->closing_all()) {
+    return;
+  }
+  ClearPresentation();
+  const int index =
+      tab_strip_model_->GetIndexOfWebContents(preview_contents_.get());
+  if (index != TabStripModel::kNoTab) {
+    tab_strip_model_->CloseWebContentsAt(index, TabCloseTypes::CLOSE_NONE);
+  }
+}
+
+void PeekController::RestoreSourceFocus(
+    base::WeakPtr<content::WebContents> source_contents) {
+  if (preview_contents_ || !source_contents || !tab_strip_model_ ||
+      closing_all_ || tab_strip_model_->closing_all()) {
+    return;
+  }
+  const int index =
+      tab_strip_model_->GetIndexOfWebContents(source_contents.get());
+  if (index != TabStripModel::kNoTab) {
+    tab_strip_model_->ActivateTabAt(index);
+    source_contents->RestoreFocus();
+  }
+}
+
+void PeekController::OnPreviewWillDeactivate(tabs::TabInterface* tab) {
+  // Clear the passive source before normal selection can attach that source
+  // to a ContentsWebView. Never double-host the source during tab activation.
+  ClearPresentation();
+  if (!close_pending_) {
+    ScheduleClose(/*restore_source=*/false);
+  }
+}
+
+void PeekController::OnPreviewDidActivate(tabs::TabInterface* tab) {
+  if (!close_pending_ && !closing_all_) {
+    AttachPresentation();
+  }
+}
+
+void PeekController::OnPreviewWillDetach(
+    tabs::TabInterface* tab,
+    tabs::TabInterface::DetachReason reason) {
+  ClearPresentation();
+  if (reason == tabs::TabInterface::DetachReason::kDelete) {
+    // This notification precedes the beforeunload response. Retain observation
+    // and ownership until confirmed removal or the user's cancellation.
+    // The model already started closing; discard a queued duplicate request.
+    close_pending_ = true;
+    close_scheduled_ = false;
+    return;
+  }
+  // Moving a document to another window is an explicit retention action.
+  tabs::TemporaryTab::FromWebContents(tab->GetContents())->Promote();
+  ResetPreviewState();
+}
+
+void PeekController::OnPreviewWillDiscard(tabs::TabInterface* tab,
+                                          content::WebContents* old_contents,
+                                          content::WebContents* new_contents) {
+  ClearPresentation();
+  preview_contents_ = new_contents->GetWeakPtr();
+  Observe(new_contents);
+  if (close_pending_) {
+    // The earlier task refers to the discarded contents. Retry against the
+    // replacement after the model has completed its replacement notification.
+    close_pending_ = false;
+    ScheduleClose(restore_source_on_close_);
+  }
+}
+
+void PeekController::OnTabStripModelChanged(
+    TabStripModel* model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (change.type() == TabStripModelChange::kRemoved && preview_contents_) {
+    bool preview_removed = false;
+    bool source_removed = false;
+    for (const auto& removed : change.GetRemove()->contents) {
+      preview_removed |= removed.contents == preview_contents_.get();
+      source_removed |= removed.contents == source_contents_.get();
+    }
+    const auto source = source_contents_;
+    const bool restore = preview_removed && restore_source_on_close_ &&
+                         !closing_all_;
+    if (preview_removed) {
+      ClearPresentation();
+      ResetPreviewState();
+    } else if (source_removed) {
+      ClearPresentation();
+      source_contents_.reset();
+      source_will_detach_subscription_ = {};
+      source_will_discard_subscription_ = {};
+      ScheduleClose(/*restore_source=*/false);
+    }
+    if (restore && source) {
+      const auto selected = selection.new_contents
+                                ? selection.new_contents->GetWeakPtr()
+                                : base::WeakPtr<content::WebContents>();
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              [](base::WeakPtr<PeekController> controller,
+                 base::WeakPtr<content::WebContents> source,
+                 base::WeakPtr<content::WebContents> selected) {
+                if (controller && controller->tab_strip_model_ &&
+                    controller->tab_strip_model_->GetActiveWebContents() ==
+                        selected.get()) {
+                  controller->RestoreSourceFocus(source);
+                }
+              },
+              weak_factory_.GetWeakPtr(), source, selected));
+    }
+  }
+  if (change.type() == TabStripModelChange::kReplaced && preview_contents_ &&
+      change.GetReplace()->new_contents == preview_contents_.get() &&
+      !close_pending_ && !closing_all_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](base::WeakPtr<PeekController> controller) {
+                         if (controller) {
+                           controller->AttachPresentation();
+                         }
+                       },
+                       weak_factory_.GetWeakPtr()));
+  }
+}
+
+void PeekController::OnSourceWillDetach(
+    tabs::TabInterface* tab,
+    tabs::TabInterface::DetachReason reason) {
+  ClearPresentation();
+  if (reason == tabs::TabInterface::DetachReason::kDelete) {
+    // A close attempt can be cancelled. Close Peek after actual removal.
+    return;
+  }
+  source_contents_.reset();
+  ScheduleClose(/*restore_source=*/false);
+}
+
+void PeekController::OnSourceWillDiscard(tabs::TabInterface* tab,
+                                         content::WebContents* old_contents,
+                                         content::WebContents* new_contents) {
+  ClearPresentation();
+  source_contents_.reset();
+  ScheduleClose(/*restore_source=*/false);
+}
+
+void PeekController::OnTabCloseCancelled(const tabs::TabInterface* tab) {
+  if (preview_contents_ && tab->GetContents() == preview_contents_.get()) {
+    // The model can report an oracle rejection inside a guarded bulk operation.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&PeekController::HandlePreviewCloseCancelled,
+                       weak_factory_.GetWeakPtr(), preview_contents_));
+  }
+}
+
+void PeekController::BeforeUnloadFired(bool proceed) {
+  if (!proceed && close_pending_) {
+    // Observe actual renderer cancellation. The model's close-cancel signal
+    // covers only oracle rejection, not the beforeunload dialog's answer.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&PeekController::HandlePreviewCloseCancelled,
+                       weak_factory_.GetWeakPtr(), preview_contents_));
+  }
+}
+
+void PeekController::HandlePreviewCloseCancelled(
+    base::WeakPtr<content::WebContents> expected_contents) {
+  if (!expected_contents ||
+      expected_contents.get() != preview_contents_.get() || !close_pending_ ||
+      !tab_strip_model_ ||
+      tab_strip_model_->GetIndexOfWebContents(expected_contents.get()) ==
+          TabStripModel::kNoTab) {
+    return;
+  }
+  closing_all_ = false;
+  close_pending_ = false;
+  close_scheduled_ = false;
+  restore_source_on_close_ = false;
+  if (!source_contents_ ||
+      !IsPeekEnabled(browser_view_->browser()->profile())) {
+    // The user chose to retain this document. If its preview host is gone,
+    // make it an ordinary reachable tab rather than leaving a hidden survivor.
+    OpenInTab();
+    return;
+  }
+  const int index =
+      tab_strip_model_->GetIndexOfWebContents(preview_contents_.get());
+  if (index != TabStripModel::kNoTab) {
+    tab_strip_model_->ActivateTabAt(index);
+    AttachPresentation();
+  }
+}
+
+void PeekController::WillCloseAllTabs(TabStripModel* model) {
+  closing_all_ = true;
+  ClearPresentation();
+}
+
+void PeekController::CloseAllTabsStopped(TabStripModel* model,
+                                         CloseAllStoppedReason reason) {
+  closing_all_ = false;
+  if (!preview_contents_) {
+    ResetPreviewState();
+  } else if (reason == kCloseAllCanceled && !close_pending_) {
+    // This also fires when closing pauses for a beforeunload response. Actual
+    // cancellation is handled by BeforeUnloadFired after the user's answer.
+    AttachPresentation();
+  }
+}
+
+void PeekController::OnTabStripModelDestroyed(TabStripModel* model) {
+  ClearPresentation();
+  ResetPreviewState();
+  tab_strip_model_ = nullptr;
+}
+
+void PeekController::OnPeekEnabledChanged() {
+  if (!IsPeekEnabled(browser_view_->browser()->profile())) {
+    Close();
+  }
+}
+
+void PeekController::OpenInTab() {
+  if (!preview_contents_) {
+    return;
+  }
+  content::WebContents* const contents = preview_contents_.get();
+  ClearPresentation();
+  ResetPreviewState();
+  tabs::TemporaryTab::FromWebContents(contents)->Promote();
+}
+
+void PeekController::OpenInSidebar() {
+  const auto source = source_contents_;
+  OpenInTab();
+  RestoreSourceFocus(source);
+}
+
+}  // namespace helium
