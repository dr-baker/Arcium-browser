+IN_PROC_BROWSER_TEST_F(PeekControllerBrowserTest,
+                       DisablingPeekClosesOpenSurface) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL url = embedded_test_server()->GetURL("/empty.html");
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser());
+  ASSERT_TRUE(browser_view);
+  PeekController* const controller = browser_view->peek_controller();
+  ASSERT_TRUE(controller);
+  content::WebContents* const source =
+      browser()->tab_strip_model()->GetActiveWebContents();
+  ASSERT_TRUE(source);
+
+  ASSERT_TRUE(controller->Show(PeekNavigationParams(url), source));
+  ASSERT_TRUE(content::WaitForLoadStop(controller->web_contents_for_testing()));
+  EXPECT_TRUE(source->ShouldIgnoreInputEventsForTesting());
+
+  browser()->profile()->GetPrefs()->SetBoolean(prefs::kHeliumPeekEnabled,
+                                               false);
+  EXPECT_FALSE(controller->is_showing());
+  EXPECT_FALSE(source->ShouldIgnoreInputEventsForTesting());
+  EXPECT_FALSE(controller->Show(PeekNavigationParams(url), source));
+}
