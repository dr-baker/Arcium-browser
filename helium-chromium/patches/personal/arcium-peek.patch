+  base::CallbackListSubscription preview_will_deactivate_subscription_;
+  base::CallbackListSubscription preview_did_activate_subscription_;
+  base::CallbackListSubscription preview_will_detach_subscription_;
+  base::CallbackListSubscription preview_will_discard_subscription_;
+  base::CallbackListSubscription source_will_detach_subscription_;
