+// Exercise the real production context-menu adapter, browser delegate routes
+// and prompt host. The request echo distinguishes full parameter forwarding
+// from a URL-only navigation even when both pages finish loading successfully.
+IN_PROC_BROWSER_TEST_F(PeekControllerBrowserTest,
+                       ProductionNavigationAndWebsiteInteractions) {
+  net::EmbeddedTestServer https_server(net::EmbeddedTestServer::TYPE_HTTPS);
+  https_server.SetSSLConfig(net::EmbeddedTestServer::CERT_TEST_NAMES);
+  https_server.ServeFilesFromSourceDirectory("chrome/test/data");
+  https_server.RegisterRequestHandler(base::BindRepeating(
+      [](const net::test_server::HttpRequest& request)
+          -> std::unique_ptr<net::test_server::HttpResponse> {
+        if (request.relative_url != "/peek-referrer") {
+          return nullptr;
+        }
+        auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+        response->set_content_type("text/html");
+        const auto referrer = request.headers.find("Referer");
+        response->set_content(
+            "<body id='referrer'>" +
+            base::EscapeForHTML(referrer == request.headers.end()
+                                    ? std::string()
+                                    : referrer->second) +
+            "</body>");
+        return response;
+      }));
+  ASSERT_TRUE(https_server.Start());
+  const GURL source_url = https_server.GetURL("a.test", "/empty.html");
+  const GURL preview_url = https_server.GetURL("b.test", "/peek-referrer");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), source_url));
+  TabStripModel* const model = browser()->tab_strip_model();
+  content::WebContents* const source = model->GetActiveWebContents();
+  PeekController* const controller =
+      BrowserView::GetBrowserViewForBrowser(browser())->peek_controller();
+  const int original_count = model->count();
+
+  const auto make_menu = [&]() {
+    content::ContextMenuParams params;
+    params.page_url = source_url;
+    params.frame_url = source_url;
+    params.link_url = preview_url;
+    params.unfiltered_link_url = preview_url;
+    params.frame_origin =
+        source->GetPrimaryMainFrame()->GetLastCommittedOrigin();
+    params.referrer_policy = network::mojom::ReferrerPolicy::kAlways;
+    auto menu = std::make_unique<TestRenderViewContextMenu>(
+        *source->GetPrimaryMainFrame(), params);
+    menu->Init();
+    return menu;
+  };
+  auto menu = make_menu();
+  ASSERT_TRUE(menu->IsItemPresent(IDC_CONTENT_CONTEXT_OPENLINKPEEK));
+  menu->ExecuteCommand(IDC_CONTENT_CONTEXT_OPENLINKPEEK, 0);
+  content::WebContents* const preview = controller->web_contents_for_testing();
+  ASSERT_TRUE(preview);
+  ASSERT_TRUE(content::WaitForLoadStop(preview));
+  EXPECT_EQ(source_url.spec(),
+            content::EvalJs(preview, "document.body.textContent"));
+  EXPECT_EQ(source_url, source->GetLastCommittedURL());
+  EXPECT_EQ(preview, model->GetActiveWebContents());
+  EXPECT_EQ(original_count + 1, model->count());
+  EXPECT_TRUE(tabs::TemporaryTab::IsTemporary(preview));
+  EXPECT_TRUE(tabs::TabInterface::GetFromContents(preview)->IsActivated());
+
+  auto* const preview_settings =
+      PageSpecificContentSettingsDelegate::FromWebContents(preview);
+  ASSERT_TRUE(preview_settings);
+  EXPECT_EQ(browser(), preview->GetDelegate());
+  // A gestured website request must reach the ordinary browser prompt host.
+  // NO_USER_GESTURE on ExecJs does not clear activation from the link request.
+  permissions::PermissionRequestObserver permission_observer(preview);
+  ASSERT_TRUE(content::ExecJs(
+      preview,
+      "navigator.registerProtocolHandler('web+arcium', '/handler?u=%s')"));
+  permission_observer.Wait();
+  ASSERT_TRUE(permission_observer.request_shown());
+  auto* const permission_manager =
+      permissions::PermissionRequestManager::FromWebContents(preview);
+  ASSERT_EQ(1u, permission_manager->Requests().size());
+  EXPECT_EQ(permissions::RequestType::kRegisterProtocolHandler,
+            permission_manager->Requests()[0]->request_type());
+  EXPECT_FALSE(PageSpecificContentSettingsDelegate::FromWebContents(source)
+                   ->pending_protocol_handler()
+                   .IsValid());
+  permission_manager->Dismiss(std::monostate());
+
+  auto* const popup_blocker =
+      blocked_content::PopupBlockerTabHelper::FromWebContents(preview);
+  ASSERT_TRUE(popup_blocker);
+  // Observe the website's activation state before testing an ungestured popup.
+  // The earlier link and permission request both granted transient activation.
+  ASSERT_EQ(true, content::EvalJs(preview, R"(
+      new Promise(resolve => {
+        const check = () => navigator.userActivation.isActive
+            ? setTimeout(check, 100) : resolve(true);
+        check();
+      }))", content::EXECUTE_SCRIPT_NO_USER_GESTURE));
+  ASSERT_TRUE(content::ExecJs(preview, "window.open('/empty.html')",
+                              content::EXECUTE_SCRIPT_NO_USER_GESTURE));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return popup_blocker->GetBlockedPopupsCount() == 1; }));
+  EXPECT_EQ(original_count + 1, model->count());
+
+  auto* const dialogs =
+      javascript_dialogs::TabModalDialogManager::FromWebContents(preview);
+  ASSERT_TRUE(dialogs);
+  base::RunLoop dialog_shown;
+  dialogs->SetDialogShownCallbackForTesting(dialog_shown.QuitClosure());
+  content::ExecuteScriptAsync(preview,
+                              "window.peekConfirmResult = confirm('Peek?')");
+  dialog_shown.Run();
+  EXPECT_TRUE(dialogs->IsShowingDialogForTesting());
+  EXPECT_FALSE(
+      javascript_dialogs::TabModalDialogManager::FromWebContents(source)
+          ->IsShowingDialogForTesting());
+  dialogs->ClickDialogButtonForTesting(true, std::u16string());
+  EXPECT_EQ(true, content::EvalJs(preview, "window.peekConfirmResult"));
+
+  // A menu created while enabled can be invoked after the setting changes.
+  // Its ordinary foreground-tab fallback must preserve the same request.
+  auto fallback_menu = make_menu();
+  browser()->profile()->GetPrefs()->SetBoolean(prefs::kHeliumPeekEnabled,
+                                               false);
+  ASSERT_FALSE(controller->is_showing());
+  fallback_menu->ExecuteCommand(IDC_CONTENT_CONTEXT_OPENLINKPEEK, 0);
+  content::WebContents* const fallback = model->GetActiveWebContents();
+  ASSERT_NE(source, fallback);
+  ASSERT_TRUE(content::WaitForLoadStop(fallback));
+  EXPECT_EQ(source_url.spec(),
+            content::EvalJs(fallback, "document.body.textContent"));
+  EXPECT_FALSE(tabs::TemporaryTab::IsTemporary(fallback));
+  EXPECT_EQ(original_count + 1, model->count());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(fallback, model->GetActiveWebContents());
+}
