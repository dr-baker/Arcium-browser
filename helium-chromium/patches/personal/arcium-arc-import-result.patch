+class StagedBrowsers {
+ public:
+  StagedBrowsers() = default;
+  StagedBrowsers(const StagedBrowsers&) = delete;
+  StagedBrowsers& operator=(const StagedBrowsers&) = delete;
+
+  ~StagedBrowsers() {
+    if (keep_browsers_) {
+      return;
+    }
+    for (auto it = windows_.rbegin(); it != windows_.rend(); ++it) {
+      BrowserWindowInterface* window = it->get();
+      Browser* browser = window ? window->GetBrowserForMigrationOnly()
+                                : nullptr;
+      if (browser && browser->GetWindow()) {
+        browser->GetWindow()->Close();
+      }
+    }
+  }
+
+  Browser* Create(Profile* profile) {
+    Browser* browser = CreateBrowserForImport(profile);
+    if (!browser || browser->profile() != profile || !browser->GetWindow()) {
+      return nullptr;
+    }
+    BrowserWindowInterface* window = browser;
+    windows_.push_back(window->GetWeakPtr());
+    if (browser->type() != Browser::TYPE_NORMAL ||
+        window->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+        window->GetBrowserForMigrationOnly() != browser ||
+        !window->GetTabStripModel()) {
+      return nullptr;
+    }
+    return browser;
+  }
+
+  void KeepBrowsers() { keep_browsers_ = true; }
+
+ private:
+  std::vector<base::WeakPtr<BrowserWindowInterface>> windows_;
+  bool keep_browsers_ = false;
+};
+
