+bool CanCloseImportedContents(BrowserWindowInterface* window,
+                              Profile* profile,
+                              content::WebContents* contents,
+                              const std::string& source_profile) {
+  Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  TabStripModel* tab_strip_model =
+      window ? window->GetTabStripModel() : nullptr;
+  if (!window || window->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      !browser || browser->profile() != profile || !tab_strip_model ||
+      !contents) {
+    return false;
+  }
+
+  const int index = tab_strip_model->GetIndexOfWebContents(contents);
+  if (index == TabStripModel::kNoTab) {
+    return false;
+  }
+  // A captured tab may have been destroyed during destination staging. Check
+  // membership before reading its provenance or consulting its close policy.
+  contents = tab_strip_model->GetWebContentsAt(index);
+  if (!IsImportedContents(contents, source_profile)) {
+    return false;
+  }
+  tabs::TabInterface* tab = tab_strip_model->GetTabForWebContents(contents);
+  TabStripModelDelegate* delegate = tab_strip_model->delegate();
+  return tab && tab_strip_model->IsTabClosable(tab) &&
+         !contents->NeedToFireBeforeUnloadOrUnloadEvents() &&
+         !HasSuddenTerminationHandlers(contents) && delegate &&
+         !delegate->ShouldRunUnloadListenerBeforeClosing(contents);
 }
 
