+std::map<std::string, int> ArcTabCountsForSpace(
+    helium::HeliumSpaceService* service,
+    Profile* profile,
+    std::string_view space_id) {
+  std::map<std::string, int> result;
+  ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+      [&](BrowserWindowInterface* window) {
+        Browser* browser = window->GetBrowserForMigrationOnly();
+        if (window->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+            !browser || browser->profile() != profile ||
+            service->GetSpaceIdForBrowser(browser) != space_id ||
+            !window->GetTabStripModel()) {
+          return true;
+        }
+        for (int index = 0; index < browser->tab_strip_model()->count();
+             ++index) {
+          const TabProvenance* provenance = TabProvenance::FromWebContents(
+              browser->tab_strip_model()->GetWebContentsAt(index));
+          if (provenance && provenance->source() == "arc") {
+            EXPECT_EQ("arc-profile", provenance->collection_id());
+            ++result[provenance->item_id()];
+          }
+        }
+        return true;
+      });
+  return result;
+}
