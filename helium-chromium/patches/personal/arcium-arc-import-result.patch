+
+        using Disabler = blink::mojom::SuddenTerminationDisablerType;
+        if (frame->GetSuddenTerminationDisablerState(
+                Disabler::kBeforeUnloadHandler) ||
+            frame->GetSuddenTerminationDisablerState(
