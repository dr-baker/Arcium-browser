+// Keep the command line and its lazily parsed network cache in sync across tests.
+class ScopedPublicServerAddressSpace {
+ public:
+  explicit ScopedPublicServerAddressSpace(const std::string& host_port) {
+    command_line_.GetProcessCommandLine()->AppendSwitchASCII(
+        network::switches::kIpAddressSpaceOverrides, host_port + "=public");
+    network::IPAddressSpaceOverrides::GetInstance().ResetForTesting();
+  }
+
+  ~ScopedPublicServerAddressSpace() {
+    network::IPAddressSpaceOverrides::GetInstance().ResetForTesting();
+  }
+
+ private:
+  base::test::ScopedCommandLine command_line_;
+};
 
