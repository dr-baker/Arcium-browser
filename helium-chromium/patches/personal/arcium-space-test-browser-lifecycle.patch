+  void TearDown() override {
+    // Drain pending lifecycle and database tasks before destroying windows.
+    base::RunLoop().RunUntilIdle();
+    // Secondary windows follow the same lifecycle as the base fixture's window.
+    for (auto& secondary_browser : secondary_browsers_) {
+      secondary_browser->tab_strip_model()->CloseAllTabs();
+      secondary_browser->GetFeatures().TearDownPreBrowserWindowDestruction();
+      secondary_browser.reset();
+    }
+    secondary_browsers_.clear();
+    BrowserWithTestWindowTest::TearDown();
+  }
+
+  Browser* CreateSecondaryBrowser(Profile* owner_profile = nullptr) {
+    secondary_browsers_.push_back(
+        CreateBrowser(owner_profile ? owner_profile : profile(),
+                      Browser::TYPE_NORMAL, /*hosted_app=*/false));
+    return secondary_browsers_.back().get();
+  }
+
+  void DestroySecondaryBrowser(Browser* target) {
+    for (auto current = secondary_browsers_.begin();
+         current != secondary_browsers_.end(); ++current) {
+      if (current->get() != target) {
+        continue;
+      }
+      (*current)->tab_strip_model()->CloseAllTabs();
+      (*current)->GetFeatures().TearDownPreBrowserWindowDestruction();
+      secondary_browsers_.erase(current);
+      return;
+    }
+    ADD_FAILURE() << "Secondary browser was not found";
+  }
