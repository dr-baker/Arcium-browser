+// Marks the empty tab added when the last ordinary tabs close.
+const int kLastTabRecoveryKey = 0;
+
+// The empty tab stands for a window with no tabs left. Once the user goes
+// somewhere in it, it is an ordinary tab again.
+bool IsUntouchedRecoveryTab(content::WebContents* contents) {
+  if (!contents->GetUserData(&kLastTabRecoveryKey) ||
+      contents->GetController().GetEntryCount() > 1) {
+    return false;
+  }
+  const GURL& url = contents->GetVisibleURL();
+  return url.is_empty() || url.IsAboutBlank() ||
+         (url.SchemeIs("chrome") &&
+          (url.host() == "newtab" || url.host() == "new-tab-page"));
+}
+
+bool ShouldAddEmptyTabBeforeClosingLastOrdinaryTabs(
+    TabStripModel* model,
+    base::span<content::WebContents* const> closing_tabs,
+    bool closing_all) {
+  if (closing_all || !model->delegate()->IsNormalWindow()) {
+    return false;
+  }
+  // Closing that empty tab means closing the empty window, so a second Close
+  // Tab after the last one closes the window.
+  if (!closing_tabs.empty() &&
+      std::ranges::all_of(closing_tabs, &IsUntouchedRecoveryTab)) {
+    return false;
+  }
+
+  const int first_ordinary_tab_index = model->IndexOfFirstUnpinnedTab();
+  if (first_ordinary_tab_index == model->count()) {
+    return false;
+  }
+
+  for (int index = first_ordinary_tab_index; index < model->count(); ++index) {
+    tabs::TabInterface* const tab = model->GetTabAtIndex(index);
+    if (!model->IsTabClosable(tab) ||
+        std::find(closing_tabs.begin(), closing_tabs.end(),
+                  tab->GetContents()) == closing_tabs.end()) {
+      return false;
+    }
+  }
+
+  return true;
+}
+
+void AddEmptyTabBeforeClosingLastOrdinaryTabs(
+    TabStripModel* model,
+    base::span<content::WebContents* const> closing_tabs,
+    bool closing_all) {
+  if (!ShouldAddEmptyTabBeforeClosingLastOrdinaryTabs(
+          model, closing_tabs, closing_all)) {
+    return;
+  }
+
+  // Keep the new tab in the ordinary section and in the background. When a
+  // beforeunload handler cancels the close, the current tab remains selected.
+  const int index = model->IndexOfFirstUnpinnedTab();
+  const int count_before = model->count();
+  model->delegate()->AddTabAt(GURL(), index, false);
+  if (model->count() > count_before && model->ContainsIndex(index)) {
+    model->GetWebContentsAt(index)->SetUserData(
+        &kLastTabRecoveryKey, std::make_unique<base::SupportsUserData::Data>());
+  }
+}
