+class LastOrdinaryTabRecoveryTest : public TabStripModelTest {
+ public:
+  void SetUp() override {
+    TabStripModelTest::SetUp();
+    delegate()->SetIsNormalWindow(true);
+  }
+
+  void InstallRecoveryTabInsertionCallback(WebContents** recovery_tab) {
+    delegate()->SetAddTabAtCallback(base::BindLambdaForTesting(
+        [this, recovery_tab](const GURL& url, int index, bool foreground) {
+          EXPECT_TRUE(url.is_empty());
+          EXPECT_EQ(tabstrip()->IndexOfFirstUnpinnedTab(), index);
+          EXPECT_FALSE(foreground);
+
+          ASSERT_GE(index, 0);
+          ASSERT_LE(index, tabstrip()->count());
+          std::unique_ptr<WebContents> contents = CreateWebContents();
+          *recovery_tab = contents.get();
+          tabstrip()->InsertWebContentsAt(index, std::move(contents),
+                                          AddTabTypes::ADD_NONE);
+        }));
+  }
+};
+
+TEST_F(LastOrdinaryTabRecoveryTest,
+       ClosingLastOrdinaryTabAddsAndSelectsEmptyTab) {
+  WebContents* recovery_tab = nullptr;
+  InstallRecoveryTabInsertionCallback(&recovery_tab);
+  tabstrip()->AppendWebContents(CreateWebContents(), true);
+
+  tabstrip()->CloseWebContentsAt(0, TabCloseTypes::CLOSE_NONE);
+
+  ASSERT_EQ(1, tabstrip()->count());
+  ASSERT_NE(nullptr, recovery_tab);
+  EXPECT_EQ(recovery_tab, tabstrip()->GetActiveWebContents());
+  EXPECT_EQ(recovery_tab, tabstrip()->GetWebContentsAt(0));
+}
+
+TEST_F(LastOrdinaryTabRecoveryTest,
+       ClosingLastOrdinaryGroupPreservesPinsAndReentersBeforeGuard) {
+  WebContents* recovery_tab = nullptr;
+  InstallRecoveryTabInsertionCallback(&recovery_tab);
+  PrepareTabs(tabstrip(), 3);
+  WebContents* const pinned_tab = tabstrip()->GetWebContentsAt(0);
+  tabstrip()->SetTabPinned(0, true);
+  const tab_groups::TabGroupId group = tabstrip()->AddToNewGroup({1, 2});
+
+  tabstrip()->CloseAllTabsInGroup(group);
+
+  ASSERT_EQ(2, tabstrip()->count());
+  ASSERT_NE(nullptr, recovery_tab);
+  EXPECT_EQ(pinned_tab, tabstrip()->GetWebContentsAt(0));
+  EXPECT_TRUE(tabstrip()->IsTabPinned(0));
+  EXPECT_EQ(recovery_tab, tabstrip()->GetWebContentsAt(1));
+  EXPECT_FALSE(tabstrip()->IsTabPinned(1));
+}
+
+TEST_F(LastOrdinaryTabRecoveryTest,
