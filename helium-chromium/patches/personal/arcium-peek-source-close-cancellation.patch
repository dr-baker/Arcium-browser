+  for (const auto& decision : approved_close_decisions_) {
+    if (decision.contents.get() == contents && IsCurrentDocument(decision)) {
+      return (decision.coordinated || decision.ready_to_remove) &&
+             !decision.ready_to_remove;
+    }
+    if (contents == source_contents_.get() &&
+        decision.contents.get() == preview_contents_.get() &&
+        !decision.coordinated && IsCurrentDocument(decision)) {
+      // An independently accepted preview dismissal is already irreversible.
+      return false;
+    }
+  }
+  if (IsCoordinatingClose(contents) ||
+      (source_close_restore_pending_ &&
+       (contents == source_contents_.get() ||
+        contents == preview_contents_.get()))) {
+    return true;
+  }
+  return contents == source_contents_.get() && IsLiveTab(contents) &&
+         IsLiveTab(preview_contents_.get()) &&
+         tabs::TemporaryTab::IsTemporary(preview_contents_.get()) &&
+         IsPeekEnabled(browser_view_->browser()->profile());
+}
+
+std::optional<bool> PeekController::DeferClose(content::WebContents* contents) {
+  if (IsBrowserClosing()) {
+    AbandonSourceClose();
+    return std::nullopt;
+  }
+  for (const auto& decision : approved_close_decisions_) {
+    if (decision.contents.get() == contents && IsCurrentDocument(decision)) {
+      // ClosePage is asynchronous even for documents without listeners.
+      // Only its actual CloseContents callback permits coordinated removal.
+      if (decision.coordinated || decision.ready_to_remove) {
+        return !decision.ready_to_remove;
+      }
+      return std::nullopt;
+    }
+    if (contents == source_contents_.get() &&
+        decision.contents.get() == preview_contents_.get() &&
+        !decision.coordinated && IsCurrentDocument(decision)) {
+      return std::nullopt;
+    }
+  }
+  if (IsCoordinatingClose(contents) ||
+      (source_close_restore_pending_ &&
+       (contents == source_contents_.get() ||
+        contents == preview_contents_.get()))) {
+    return true;
+  }
+  if (!ShouldDeferClose(contents)) {
+    return std::nullopt;
+  }
+
+  SourceClose close;
+  close.source = {source_contents_,
+                  source_contents_->GetPrimaryMainFrame()->GetWeakDocumentPtr()};
+  close.preview = {
+      preview_contents_,
+      preview_contents_->GetPrimaryMainFrame()->GetWeakDocumentPtr()};
+  close.generation = ++source_close_generation_;
+  close.waiting_for_reply =
+      TabCloseTypesData::FromWebContents(preview_contents_.get()) != nullptr;
+  close.waiting_for_reply |= UnloadController::AdoptCoordinatedClose(
+      preview_contents_.get(), weak_factory_.GetWeakPtr());
+  close.source_waiting_for_reply = UnloadController::AdoptCoordinatedClose(
+      source_contents_.get(), weak_factory_.GetWeakPtr());
+  source_close_ = std::move(close);
+  close_pending_ = false;
+  close_scheduled_ = false;
+  restore_source_on_close_ = false;
+  source_modal_suspended_ = false;
+  ClearPresentation();
+  // TabStripModel writes the original source close types after we return true.
+  // Start outside its guarded operation, including for eventless documents.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&PeekController::StartSourceClose,
+                                weak_factory_.GetWeakPtr(),
+                                source_close_generation_));
+  return true;
+}
+
+void PeekController::StartSourceClose(uint64_t generation) {
+  if (!source_close_ || source_close_->generation != generation) {
+    return;
+  }
+  if (!IsSourceCloseValid()) {
+    AbortSourceClose(/*restore_preview=*/true);
+    return;
+  }
+  if (source_close_->waiting_for_reply) {
+    return;
+  }
+  if (source_close_->phase == SourceClose::Phase::kSource &&
+      source_close_->source_waiting_for_reply) {
+    source_close_->waiting_for_reply = true;
+    return;
+  }
+  const CloseDecision decision =
+      source_close_->phase == SourceClose::Phase::kPreview
+          ? source_close_->preview : source_close_->source;
+  // Custom confirmation can complete synchronously inside this helper.
+  source_close_->waiting_for_reply = true;
+  const auto controller = weak_factory_.GetWeakPtr();
+  const bool deferred =
+      UnloadController::From(browser_view_->browser())->RunCoordinatedUnloadEvents(
+          decision.contents.get(), controller);
+  if (controller && !deferred && controller->source_close_ &&
+      controller->source_close_->generation == generation &&
+      controller->source_close_->waiting_for_reply &&
+      controller->IsCurrentDocument(decision)) {
+    controller->BeforeUnloadFired(decision.contents.get(), /*proceed=*/true);
+  }
+}
+
+bool PeekController::BeforeUnloadFired(content::WebContents* contents,
+                                      bool proceed) {
+  if (IsBrowserClosing()) {
+    // Snapshot this before cancellation bookkeeping can reset window ownership.
+    AbandonSourceClose();
+    return false;
+  }
+  if (IsCoordinatingClose(contents)) {
+    const bool expected =
+        source_close_->waiting_for_reply &&
+        contents == (source_close_->phase == SourceClose::Phase::kPreview
+                         ? source_close_->preview.contents.get()
+                         : source_close_->source.contents.get());
+    if (!expected) {
+      if (!proceed || !IsSourceCloseValid()) {
+        AbortSourceClose(/*restore_preview=*/true);
+      } else if (contents == source_close_->source.contents.get() &&
+                 source_close_->phase == SourceClose::Phase::kPreview) {
+        // A source decision already in flight is part of this transaction too.
+        source_close_->source_approved = true;
+        source_close_->source_waiting_for_reply = false;
+      }
+      return true;
+    }
+    source_close_->waiting_for_reply = false;
+    if (!proceed || !IsSourceCloseValid()) {
+      AbortSourceClose(/*restore_preview=*/true);
+      return true;
+    }
+    const uint64_t generation = source_close_->generation;
+    if (source_close_->phase == SourceClose::Phase::kPreview &&
+        !source_close_->source_approved) {
+      source_close_->phase = SourceClose::Phase::kSource;
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&PeekController::StartSourceClose,
+                                    weak_factory_.GetWeakPtr(), generation));
+    } else {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&PeekController::CommitSourceClose,
+                                    weak_factory_.GetWeakPtr(), generation));
+    }
+    return true;
+  }
+  for (const auto& decision : approved_close_decisions_) {
+    if (decision.contents.get() == contents && IsCurrentDocument(decision)) {
+      return decision.coordinated;
+    }
+  }
+  if (proceed && contents == preview_contents_.get() &&
+      (close_pending_ || TabCloseTypesData::FromWebContents(contents))) {
+    // A separate preview dismissal accepted its own decision. A subsequent
+    // source close must not adopt an answer that has already been delivered.
+    approved_close_decisions_.push_back(
+        {preview_contents_,
+         contents->GetPrimaryMainFrame()->GetWeakDocumentPtr()});
+  }
+  return false;
+}
+
+void PeekController::OnUnloadCompleted(content::WebContents* contents) {
+  for (auto& decision : approved_close_decisions_) {
+    if (decision.contents.get() == contents && IsCurrentDocument(decision)) {
+      decision.ready_to_remove = true;
+      return;
+    }
+  }
+  if (contents == source_contents_.get() || contents == preview_contents_.get()) {
+    // A page may also complete a renderer/forced close outside source preflight.
+    // Its already-unloaded document must proceed to normal removal and cleanup.
+    CloseDecision decision = {
+        contents->GetWeakPtr(),
+        contents->GetPrimaryMainFrame()->GetWeakDocumentPtr()};
+    if (!AbortSourceClose(/*restore_preview=*/false) ||
+        !IsCurrentDocument(decision)) {
+      return;
+    }
+    decision.ready_to_remove = true;
+    approved_close_decisions_.push_back(std::move(decision));
+  }
+}
+
+bool PeekController::CancelTabClose(content::WebContents* contents) {
+  const auto controller = weak_factory_.GetWeakPtr();
+  if (IsLiveTab(contents) && !IsBrowserClosing()) {
+    // Normal marker, gesture, DevTools and priority cleanup can notify observers.
+    UnloadController::From(browser_view_->browser())
+        ->BeforeUnloadFired(contents, /*proceed=*/false);
+  }
+  return !!controller;
+}
+
+bool PeekController::AbortSourceClose(bool restore_preview) {
+  if (!source_close_ && !source_close_restore_pending_) {
+    return true;
+  }
+  if (IsBrowserClosing()) {
+    AbandonSourceClose();
+    return true;
+  }
+  const auto source = source_contents_;
+  const auto preview = preview_contents_;
+  source_close_.reset();
+  const uint64_t generation = ++source_close_generation_;
+  source_close_restore_pending_ = restore_preview;
+  source_modal_suspended_ = false;
+  if (!CancelTabClose(source.get())) {
+    return false;
+  }
+  if (generation != source_close_generation_) {
+    return true;
+  }
+  if (!CancelTabClose(preview.get())) {
+    return false;
+  }
+  if (restore_preview && generation == source_close_generation_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&PeekController::RestoreAfterCoordinatedCloseCancelled,
+                       weak_factory_.GetWeakPtr(), source, preview, generation));
+  }
+  return true;
+}
+
+void PeekController::AbandonSourceClose() {
+  source_close_.reset();
+  source_close_restore_pending_ = false;
+  approved_close_decisions_.clear();
+  ++source_close_generation_;
+}
+
+bool PeekController::HandoffPendingDecision(content::WebContents* contents) {
+  if (!UnloadController::HandoffCoordinatedClose(contents)) {
+    return false;
+  }
+  TabCloseTypesData::CreateForWebContents(contents, TabCloseTypes::CLOSE_NONE);
+  close_pending_ = true;
+  close_scheduled_ = false;
+  return true;
+}
+
+void PeekController::OnCloseDecisionCancelled(content::WebContents* contents) {
+  if (contents == preview_contents_.get() && close_pending_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&PeekController::HandlePreviewCloseCancelled,
+                       weak_factory_.GetWeakPtr(), preview_contents_));
+  } else if (contents == source_contents_.get() ||
+             contents == preview_contents_.get()) {
+    // A retained old reply may have activated its source after preflight was
+    // aborted. Restore the attached presentation after that modal unwinds.
+    OnBrowserCloseCancelled();
+  }
+}
+
+void PeekController::OnBrowserCloseStarted() {
+  // The window owns its existing queue and pending document replies now.
+  AbandonSourceClose();
+  close_pending_ = false;
+  close_scheduled_ = false;
+  restore_source_on_close_ = false;
+  source_modal_suspended_ = false;
+  ++source_modal_generation_;
+  ClearPresentation();
+}
+
+void PeekController::OnBrowserCloseCancelled() {
+  if (source_close_ || close_pending_ || IsBrowserClosing() ||
+      !IsLiveTab(source_contents_.get()) ||
+      !IsLiveTab(preview_contents_.get()) ||
+      !IsPeekEnabled(browser_view_->browser()->profile())) {
+    return;
+  }
+  source_close_restore_pending_ = true;
+  const uint64_t generation = ++source_close_generation_;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&PeekController::RestoreAfterCoordinatedCloseCancelled,
+                     weak_factory_.GetWeakPtr(), source_contents_,
+                     preview_contents_, generation));
+}
+
+void PeekController::RestoreAfterCoordinatedCloseCancelled(
+    base::WeakPtr<content::WebContents> source,
+    base::WeakPtr<content::WebContents> preview,
+    uint64_t generation) {
+  if (!source_close_restore_pending_ || generation != source_close_generation_) {
+    return;
+  }
+  source_close_restore_pending_ = false;
+  if (IsBrowserClosing()) {
+    AbandonSourceClose();
+    return;
+  }
+  if (source.get() != source_contents_.get() ||
+      preview.get() != preview_contents_.get() ||
+      !IsLiveTab(source.get()) || !IsLiveTab(preview.get()) || close_pending_ ||
+      !IsPeekEnabled(browser_view_->browser()->profile())) {
+    return;
+  }
+  // Duplicate closes while cancellation unwinds join that canceled attempt.
+  const auto controller = weak_factory_.GetWeakPtr();
+  if (!CancelTabClose(source.get()) || !CancelTabClose(preview.get()) ||
+      generation != source_close_generation_) {
+    return;
+  }
+  if (source.get() != source_contents_.get() ||
+      preview.get() != preview_contents_.get() ||
+      !IsLiveTab(source.get()) || !IsLiveTab(preview.get()) || close_pending_ ||
+      IsBrowserClosing() || !IsPeekEnabled(browser_view_->browser()->profile())) {
+    return;
+  }
+  const auto* active = tab_strip_model_->GetActiveWebContents();
+  if (active != source.get() && active != preview.get()) {
+    ScheduleClose(/*restore_source=*/false);
+    return;
+  }
+  tab_strip_model_->ActivateTabAt(
+      tab_strip_model_->GetIndexOfWebContents(preview.get()));
+  if (controller && source.get() == controller->source_contents_.get() &&
+      preview.get() == controller->preview_contents_.get() &&
+      !controller->close_pending_) {
+    controller->AttachPresentation();
+  }
+}
+
+void PeekController::CommitSourceClose(uint64_t generation) {
+  if (!source_close_ || source_close_->generation != generation) {
+    return;
+  }
+  if (!IsSourceCloseValid()) {
+    AbortSourceClose(/*restore_preview=*/true);
+    return;
+  }
+  const CloseDecision source = source_close_->source;
+  const CloseDecision preview = source_close_->preview;
+  const auto controller = weak_factory_.GetWeakPtr();
+  approved_close_decisions_.push_back(source);
+  approved_close_decisions_.back().coordinated = true;
+  approved_close_decisions_.push_back(preview);
+  approved_close_decisions_.back().coordinated = true;
+  source_close_.reset();
+  ++source_close_generation_;
+  close_pending_ = true;
+  close_scheduled_ = false;
+  restore_source_on_close_ = false;
+  source_modal_suspended_ = false;
+  ClearPresentation();
+  // Retain the original source's close types and ordinary history policy.
+  // The temporary target keeps its own exclusion from session/history records.
+  TabCloseTypesData::CreateForWebContents(preview.contents.get(),
+                                        TabCloseTypes::CLOSE_NONE);
+  preview.contents->ClosePage();
+  // The first unload can synchronously remove a tab or destroy the browser.
+  // Its removal also resets Peek state, so approvals live outside that state.
+  if (controller && !controller->IsBrowserClosing() &&
+      controller->IsCurrentDocument(source) &&
+      controller->IsLiveTab(source.contents.get())) {
+    source.contents->ClosePage();
+  }
+}
+
+void PeekController::OnCloseDocumentChanged() {
+  std::erase_if(approved_close_decisions_, [this](const CloseDecision& decision) {
+    return !IsCurrentDocument(decision);
+  });
+  if (source_close_ && !IsSourceCloseValid()) {
+    AbortSourceClose(/*restore_preview=*/true);
+  }
+}
+
+void PeekController::PrimaryPageChanged(content::Page& page) {
+  OnCloseDocumentChanged();
+}
+
+void PeekController::WebContentsDestroyed() {
+  AbortSourceClose(/*restore_preview=*/false);
+}
+
+bool PeekController::AdoptPendingPreviewClose() {
+  if (!preview_contents_ ||
+      !TabCloseTypesData::FromWebContents(preview_contents_.get())) {
