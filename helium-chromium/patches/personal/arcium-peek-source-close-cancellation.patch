+void UnloadController::TakeOverCoordinatedCloses() {
+  const auto controller = lifetime_factory_.GetWeakPtr();
+  std::vector<base::WeakPtr<content::WebContents>> pending_contents;
+  for (int i = 0; i < browser_->tab_strip_model()->count(); ++i) {
+    auto* contents = browser_->tab_strip_model()->GetWebContentsAt(i);
+    if (GetCoordinatedClose(contents)) {
+      pending_contents.push_back(contents->GetWeakPtr());
+    }
+  }
+  if (tab_close_coordinator_) {
+    tab_close_coordinator_->OnBrowserCloseStarted();
+  }
+  for (const auto& contents : pending_contents) {
+    if (!controller) {
+      return;
+    }
+    if (!contents ||
+        GetCurrentUnloadController(contents.get()) != controller.get()) {
+      continue;
+    }
+    if (auto* pending = GetCoordinatedClose(contents.get())) {
+      const auto coordinator = pending->coordinator;
+      // Keep the document and token of the visible native/custom confirmation.
+      // Window Cancel leaves its eventual reply held, unless explicitly adopted.
+      pending->coordinator = tab_close_coordinator_;
+      pending->handoff = false;
+      if (coordinator && coordinator.get() != tab_close_coordinator_.get()) {
+        // Retire only the moved participant, not its old owner's unrelated Peek.
+        coordinator->BeforeUnloadFired(contents.get(), /*proceed=*/false);
+      }
+    }
+  }
+}
