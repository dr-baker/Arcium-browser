+bool UnloadController::RunCoordinatedUnloadEvents(
+    content::WebContents* contents,
+    base::WeakPtr<TabCloseCoordinator> coordinator) {
+  const auto controller = lifetime_factory_.GetWeakPtr();
+  const auto weak_contents = contents->GetWeakPtr();
+  auto* data = TrackCoordinatedClose(contents, std::move(coordinator),
+                                     /*handoff=*/false);
+  const auto document = data->document;
+  const auto token = data->token;
+  const bool deferred = RunUnloadEventsHelper(
+      contents, base::BindOnce(&UnloadController::OnCoordinatedCustomConfirmation,
+                               weak_contents, document, token));
+  if (!deferred && controller && IsCurrentDocument(weak_contents, document) &&
+      GetCurrentUnloadController(weak_contents.get()) == controller.get()) {
+    auto* pending = GetCoordinatedClose(weak_contents.get());
+    if (pending && pending->token == token) {
+      weak_contents->RemoveUserData(&kCoordinatedCloseKey);
+    }
+  }
+  return deferred;
+}
+
+// static
+bool UnloadController::AdoptCoordinatedClose(
+    content::WebContents* contents,
+    base::WeakPtr<TabCloseCoordinator> coordinator) {
+  if (auto* pending = GetCoordinatedClose(contents)) {
+    pending->coordinator = std::move(coordinator);
+    pending->handoff = false;
+    return true;
+  }
+  if (TabCloseTypesData::FromWebContents(contents)) {
+    // Adopt an ordinary native close already waiting on this exact document.
+    TrackCoordinatedClose(contents, std::move(coordinator), /*handoff=*/false);
+    return true;
+  }
+  return false;
+}
+
+// static
+bool UnloadController::HasCoordinatedClose(content::WebContents* contents) {
+  return GetCoordinatedClose(contents) != nullptr;
+}
+
+// static
+bool UnloadController::HandoffCoordinatedClose(content::WebContents* contents) {
+  if (auto* pending = GetCoordinatedClose(contents)) {
+    pending->handoff = true;
+    return true;
+  }
+  return false;
+}
+
+// static
+void UnloadController::OnCoordinatedCustomConfirmation(
+    base::WeakPtr<content::WebContents> contents,
+    content::WeakDocumentPtr document,
+    base::UnguessableToken token,
+    bool confirmed) {
+  // A custom handler may answer synchronously inside the guarded model close.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+          [](base::WeakPtr<content::WebContents> contents,
+             content::WeakDocumentPtr document,
+             base::UnguessableToken token, bool confirmed) {
+            if (!IsCurrentDocument(contents, document)) {
+              return;
+            }
+            auto* pending = GetCoordinatedClose(contents.get());
+            if (!pending || pending->token != token) {
+              return;
+            }
+            const auto coordinator = pending->coordinator;
+            auto* unload = GetCurrentUnloadController(contents.get());
+            if (!unload) {
+              contents->RemoveUserData(&kCoordinatedCloseKey);
+              if (coordinator) {
+                coordinator->BeforeUnloadFired(contents.get(), false);
+              }
+              CancelAbandonedClose(contents, document);
+              return;
+            }
+            // Snapshot ownership before Cancel can reset browser-close state.
+            const bool ordinary_handoff = pending->handoff &&
+                !unload->is_attempting_to_close_browser() &&
+                !unload->force_skip_warning_user_on_close();
+            bool proceed_to_unload = false;
+            unload->BeforeUnloadFired(contents.get(), confirmed,
+                                      &proceed_to_unload);
+            if (!ordinary_handoff || !IsCurrentDocument(contents, document) ||
+                GetCoordinatedClose(contents.get())) {
+              return;
+            }
+            // The dispatcher can delete/move the tab or destroy its controller.
+            // Resolve the live host again; never reuse the pre-callback pointer.
+            unload = GetCurrentUnloadController(contents.get());
+            if (!unload || unload->is_attempting_to_close_browser() ||
+                unload->force_skip_warning_user_on_close()) {
+              return;
+            }
+            if (confirmed && proceed_to_unload) {
+              auto* tab = tabs::TabInterface::GetFromContents(contents.get());
+              auto* model = tab->GetBrowserWindowInterface()->GetTabStripModel();
+              const int index = model->GetIndexOfWebContents(contents.get());
+              if (index != TabStripModel::kNoTab) {
+                // The static adapter already runs after the model guard. This
+                // is the final operation on the validated exact document.
+                model->CloseWebContentsAt(
+                    index, TabCloseTypes::CLOSE_USER_GESTURE);
