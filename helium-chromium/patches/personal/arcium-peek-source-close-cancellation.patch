+struct CoordinatedCloseData : base::SupportsUserData::Data {
+  base::WeakPtr<UnloadController::TabCloseCoordinator> coordinator;
+  content::WeakDocumentPtr document;
+  const base::UnguessableToken token = base::UnguessableToken::Create();
+  bool handoff = false;
+};
+
+CoordinatedCloseData* TrackCoordinatedClose(
+    content::WebContents* contents,
+    base::WeakPtr<UnloadController::TabCloseCoordinator> coordinator,
+    bool handoff) {
+  auto data = std::make_unique<CoordinatedCloseData>();
+  data->coordinator = std::move(coordinator);
+  data->document = contents->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+  data->handoff = handoff;
+  auto* result = data.get();
+  contents->SetUserData(&kCoordinatedCloseKey, std::move(data));
+  return result;
+}
+
+CoordinatedCloseData* GetCoordinatedClose(content::WebContents* contents) {
+  if (!contents || contents->IsBeingDestroyed()) {
+    return nullptr;
+  }
+  auto* data = static_cast<CoordinatedCloseData*>(
+      contents->GetUserData(&kCoordinatedCloseKey));
+  if (data && (!data->document.AsRenderFrameHostIfValid() ||
+               data->document.AsRenderFrameHostIfValid() !=
+                   contents->GetPrimaryMainFrame())) {
+    return nullptr;
+  }
+  return data;
+}
+
+bool IsCurrentDocument(base::WeakPtr<content::WebContents> contents,
+                       content::WeakDocumentPtr document) {
+  return contents && !contents->IsBeingDestroyed() &&
+         document.AsRenderFrameHostIfValid() &&
+         document.AsRenderFrameHostIfValid() == contents->GetPrimaryMainFrame();
+}
+
+UnloadController* GetCurrentUnloadController(content::WebContents* contents) {
+  auto* tab = tabs::TabInterface::GetFromContents(contents);
+  auto* browser = tab ? tab->GetBrowserWindowInterface() : nullptr;
+  return browser ? UnloadController::From(browser) : nullptr;
+}
+
+void CancelAbandonedClose(base::WeakPtr<content::WebContents> contents,
+                          content::WeakDocumentPtr document) {
+  if (!IsCurrentDocument(contents, document) ||
