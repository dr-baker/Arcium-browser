+std::vector<uint8_t> MakeSolidPng(int size,
+                                  const std::array<uint8_t, 4>& rgba) {
+  std::vector<uint8_t> pixels(size * size * rgba.size());
+  for (size_t i = 0; i < pixels.size(); i += rgba.size()) {
+    std::copy(rgba.begin(), rgba.end(), pixels.begin() + i);
+  }
+  auto png = gfx::PNGCodec::Encode(
+      pixels.data(), gfx::PNGCodec::FORMAT_RGBA, gfx::Size(size, size),
+      size * rgba.size(), /*discard_transparency=*/false,
+      std::vector<gfx::PNGCodec::Comment>());
+  return png.value_or(std::vector<uint8_t>());
+}
