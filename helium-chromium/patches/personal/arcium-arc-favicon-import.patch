+std::set<GURL> GetPersistentSidebarURLs(Profile* profile) {
+  std::set<GURL> urls;
+  helium::HeliumSpaceService* service =
+      helium::HeliumSpaceServiceFactory::GetForProfile(profile);
+  if (!service) {
+    return urls;
+  }
+
+  AddPersistentNodeURLs(service->GetLocalFavorites(), &urls);
+  const std::vector<helium::HeliumSpace*> spaces = service->GetSpaces();
+  for (const helium::HeliumSpace* space : spaces) {
+    AddPersistentNodeURLs(service->GetFavoritesForSpace(*space), &urls);
+    AddPersistentNodeURLs(space->pins(), &urls);
+  }
+  return urls;
 }
 
