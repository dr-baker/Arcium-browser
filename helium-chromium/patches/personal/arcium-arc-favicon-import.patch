+void AddPersistentNodeURLs(const helium::PersistentNodes& nodes,
+                           std::set<GURL>* urls) {
+  for (const helium::PersistentNode& node : nodes) {
+    if (const auto* link = std::get_if<helium::PersistentLink>(&node.data)) {
+      if (link->url.is_valid()) {
+        urls->insert(link->url);
+      }
+    } else if (const auto* folder =
+                   std::get_if<helium::PersistentFolder>(&node.data)) {
+      AddPersistentNodeURLs(folder->children, urls);
+    }
+  }
+}
