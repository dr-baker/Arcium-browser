+  const base::FilePath profile_directory =
+      temp_dir.GetPath().AppendASCII("Arc Profile");
+  if (!base::CreateDirectory(profile_directory) ||
+      !CreateFaviconsDatabase(
+          profile_directory.Append(FILE_PATH_LITERAL("Favicons")))) {
+    return base::FilePath();
+  }
+  return profile_directory;
