+bool CreateFaviconsDatabase(const base::FilePath& database_path) {
+  sql::Database db(sql::test::kTestTag);
+  if (!db.Open(database_path) ||
+      !db.Execute("CREATE TABLE favicons (id INTEGER PRIMARY KEY, url TEXT);")) {
+    return false;
+  }
+  if (!db.Execute(
+          "CREATE TABLE icon_mapping (icon_id INTEGER, page_url TEXT);")) {
+    return false;
+  }
+  if (!db.Execute(
+          "CREATE TABLE favicon_bitmaps (id INTEGER PRIMARY KEY, "
+          "icon_id INTEGER, last_updated INTEGER, image_data BLOB, "
+          "width INTEGER, height INTEGER);")) {
+    return false;
+  }
+  if (!db.Execute(
+          "INSERT INTO favicons (id, url) VALUES "
+          "(1, 'not a url'), "
+          "(2, 'https://empty.example/favicon.ico'), "
+          "(3, 'https://corrupt.example/favicon.ico'), "
+          "(4, 'https://favorite.example/favicon.ico');")) {
+    return false;
+  }
+  if (!db.Execute(
+          "INSERT INTO icon_mapping (icon_id, page_url) VALUES "
+          "(1, 'https://invalid.example/'), "
+          "(2, 'https://empty.example/'), "
+          "(3, 'https://corrupt.example/'), "
+          "(4, 'https://favorite.example/');")) {
+    return false;
+  }
+
+  auto insert_bitmap = [&db](int64_t id, int64_t icon_id,
+                             const std::vector<uint8_t>& image_data, int width,
+                             int height) {
+    sql::Statement statement(db.GetUniqueStatement(
+        "INSERT INTO favicon_bitmaps "
+        "(id, icon_id, last_updated, image_data, width, height) "
+        "VALUES (?, ?, 0, ?, ?, ?);"));
+    statement.BindInt64(0, id);
+    statement.BindInt64(1, icon_id);
+    statement.BindBlob(2, image_data);
+    statement.BindInt(3, width);
+    statement.BindInt(4, height);
+    return statement.Run();
+  };
+
+  const std::vector<uint8_t> small_red =
+      MakeSolidPng(16, {0xff, 0x00, 0x00, 0xff});
+  const std::vector<uint8_t> large_blue =
+      MakeSolidPng(32, {0x00, 0x00, 0xff, 0xff});
+  if (small_red.empty() || large_blue.empty() ||
+      !insert_bitmap(1, 1, small_red, 16, 16) ||
+      !insert_bitmap(2, 2, {}, 16, 16) ||
+      !insert_bitmap(3, 3, {1, 2, 3}, 16, 16) ||
+      !insert_bitmap(4, 4, small_red, 16, 16) ||
+      !insert_bitmap(5, 4, large_blue, 32, 32) ||
+      !insert_bitmap(6, 4, {1, 2, 3}, 64, 64)) {
+    return false;
+  }
+  return true;
+}
