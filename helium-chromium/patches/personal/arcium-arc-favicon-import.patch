+std::optional<std::vector<uint8_t>> ReencodeFavicon(
+    base::span<const uint8_t> src,
+    int max_size) {
+  if (max_size <= 0) {
+    return std::nullopt;
+  }
+
+  SkBitmap decoded = content::DecodeImage(src, gfx::Size(max_size, max_size));
+  if (decoded.empty()) {
+    return std::nullopt;
+  }
+
+  if (decoded.width() > max_size || decoded.height() > max_size) {
+    const double scale = std::min(
+        static_cast<double>(max_size) / decoded.width(),
+        static_cast<double>(max_size) / decoded.height());
+    const int new_width =
+        std::max(1, static_cast<int>(decoded.width() * scale));
+    const int new_height =
+        std::max(1, static_cast<int>(decoded.height() * scale));
+    decoded = skia::ImageOperations::Resize(
+        decoded, skia::ImageOperations::RESIZE_LANCZOS3, new_width, new_height);
+  }
