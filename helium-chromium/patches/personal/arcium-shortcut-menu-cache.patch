 TEST(BrowserShortcutPlatformMacTest,
+     ManagedNonAliasItemsRefreshWithoutAliasBaselineLookup) {
+  ASSERT_NE(NSApp, nil);
+  ScopedMainMenu menu(MainMenuWithCommandShortcut(
+      IDC_NEW_TAB, @"New Tab", @"t", NSEventModifierFlagCommand,
+      @selector(commandDispatch:)));
+
+  const ui::Accelerator new_tab(ui::VKEY_T, ui::EF_COMMAND_DOWN);
+  UpdatePlatformMenuAccelerators({
+      {new_tab, IDC_NEW_TAB},
+  });
+
+  // A service label refresh can rebuild defaults repeatedly while the menu
+  // item remains managed. Nonalias commands have no original-alias cache.
+  for (int refresh = 0; refresh < 3; ++refresh) {
+    const std::vector<BrowserShortcutPlatformDefaultAccelerator> defaults =
+        GetPlatformDefaultAccelerators();
+    int new_tab_entries = 0;
+    for (const BrowserShortcutPlatformDefaultAccelerator& entry : defaults) {
+      if (entry.command_id != IDC_NEW_TAB) {
+        continue;
+      }
+      ++new_tab_entries;
+      EXPECT_EQ(entry.accelerator, new_tab);
+    }
+    EXPECT_EQ(new_tab_entries, 1);
+  }
+}
