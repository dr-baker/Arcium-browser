@@ -43,6 +43,52 @@
   }
   return false;
 }
+
+ui::MenuModel* GetSubmenuForCommand(const ui::MenuModel* menu, int command_id) {
+  for (size_t index = 0; index < menu->GetItemCount(); index++) {
+    if (menu->GetCommandIdAt(index) == command_id && menu->IsVisibleAt(index)) {
+      return menu->GetSubmenuModelAt(index);
+    }
+  }
+  return nullptr;
+}
+
+bool IsCommandChecked(const ui::MenuModel* menu, int command_id) {
+  for (size_t index = 0; index < menu->GetItemCount(); index++) {
+    if (menu->GetCommandIdAt(index) == command_id && menu->IsVisibleAt(index)) {
+      return menu->IsItemCheckedAt(index);
+    }
+  }
+  return false;
+}
+
+void ExpectCurrentBrowserLayoutMenu(const ui::MenuModel* menu,
+                                    bool vertical_layout) {
+  EXPECT_TRUE(
+      ContainsCommand(menu, IDC_BROWSER_LAYOUT_MENU, IDS_BROWSER_LAYOUT_MENU));
+  EXPECT_FALSE(ContainsCommand(menu, IDC_TOGGLE_VERTICAL_TABS, std::nullopt));
+  EXPECT_FALSE(
+      ContainsCommand(menu, IDC_TOGGLE_VERTICAL_TABS_COLLAPSE, std::nullopt));
+  EXPECT_FALSE(ContainsCommand(menu, IDC_TOGGLE_VERTICAL_TABS_EXPAND_ON_HOVER,
+                               std::nullopt));
+
+  ui::MenuModel* layout_menu =
+      GetSubmenuForCommand(menu, IDC_BROWSER_LAYOUT_MENU);
+  ASSERT_TRUE(layout_menu);
+  EXPECT_TRUE(ContainsCommand(layout_menu, IDC_BROWSER_LAYOUT_CLASSIC,
+                              IDS_BROWSER_LAYOUT_CLASSIC));
+  EXPECT_TRUE(ContainsCommand(layout_menu, IDC_BROWSER_LAYOUT_DYNAMIC,
+                              IDS_BROWSER_LAYOUT_DYNAMIC));
+  EXPECT_TRUE(ContainsCommand(layout_menu, IDC_BROWSER_LAYOUT_COMPACT,
+                              IDS_BROWSER_LAYOUT_COMPACT));
+  EXPECT_TRUE(ContainsCommand(layout_menu, IDC_BROWSER_LAYOUT_VERTICAL,
+                              IDS_BROWSER_LAYOUT_VERTICAL));
+  EXPECT_EQ(vertical_layout,
+            IsCommandChecked(layout_menu, IDC_BROWSER_LAYOUT_VERTICAL));
+  EXPECT_EQ(vertical_layout,
+            ContainsCommand(layout_menu, IDC_BROWSER_LAYOUT_VERTICAL_RIGHT,
+                            IDS_BROWSER_LAYOUT_VERTICAL_RIGHT));
+}
