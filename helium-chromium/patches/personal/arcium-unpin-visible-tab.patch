 UnpinnedTabContainerView::~UnpinnedTabContainerView() = default;
+
+void UnpinnedTabContainerView::AttachTabView(
+    std::unique_ptr<views::View> child,
+    const gfx::Rect& previous_bounds_in_screen) {
+  // Persistent Pins use a projected row and hide the native tab view. When
+  // that view returns to ordinary tabs, this container owns its visibility.
+  // A hidden source has no visible origin from which to animate.
+  const gfx::Rect visible_origin =
+      child->GetVisible() ? previous_bounds_in_screen : gfx::Rect();
+  if (auto* tab_view = views::AsViewClass<TabView>(child.get())) {
+    child->SetVisible(!tab_view->data().is_temporary);
+  } else {
+    child->SetVisible(true);
+  }
+  layout_manager_->AnimateAndReparentView(std::move(child), visible_origin);
+}
