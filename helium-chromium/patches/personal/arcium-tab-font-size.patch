+
+  Profile* original_profile = profile ? profile->GetOriginalProfile() : nullptr;
+  if (!original_profile || !original_profile->GetPrefs()) {
+    return;
+  }
+
+  PrefService* prefs = original_profile->GetPrefs();
+  if (!prefs->FindPreference(arcium::kTabFontSizePref)) {
+    return;
+  }
+
+  profile_observation_.Observe(original_profile);
+  pref_change_registrar_.Init(prefs);
+  pref_change_registrar_.Add(
+      arcium::kTabFontSizePref,
+      base::BindRepeating(&TabTitle::UpdateFont, base::Unretained(this)));
+  UpdateFont();
+}
+
+TabTitle::~TabTitle() = default;
+
+void TabTitle::UpdateFont() {
+  PrefService* prefs = pref_change_registrar_.prefs();
+  if (!prefs || !prefs->FindPreference(arcium::kTabFontSizePref)) {
+    return;
+  }
+
+  const int configured_size = prefs->GetInteger(arcium::kTabFontSizePref);
+  if (configured_size == arcium::kTabFontSizeDefault) {
+    if (font_list().GetFontSize() != base_font_list_.GetFontSize()) {
+      SetFontList(base_font_list_);
+    }
+    return;
+  }
+
+  const int requested_size = std::clamp(
+      configured_size, arcium::kTabFontSizeMin, arcium::kTabFontSizeMax);
+  const int base_size = base_font_list_.GetFontSize();
+  if (font_list().GetFontSize() == requested_size) {
+    return;
+  }
+  SetFontList(base_font_list_.DeriveWithSizeDelta(requested_size - base_size));
+}
+
+void TabTitle::OnProfileWillBeDestroyed(Profile*) {
+  pref_change_registrar_.Reset();
+  profile_observation_.Reset();
 }
 
