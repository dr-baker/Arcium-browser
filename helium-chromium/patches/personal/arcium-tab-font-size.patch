+TEST_F(TabTest, TabTitleAppliesProfileFontSizeLive) {
+  if (!profile_.GetPrefs()->FindPreference(arcium::kTabFontSizePref)) {
+    profile_.GetTestingPrefService()->registry()->RegisterIntegerPref(
+        arcium::kTabFontSizePref, arcium::kTabFontSizeDefault);
+  }
+
+  auto title = std::make_unique<TabTitle>(&profile_);
+  const int native_font_size = title->font_list().GetFontSize();
+  EXPECT_EQ(arcium::kTabFontSizeDefault,
+            profile_.GetPrefs()->GetInteger(arcium::kTabFontSizePref));
+  EXPECT_GT(native_font_size, 0);
+
+  profile_.GetPrefs()->SetInteger(arcium::kTabFontSizePref, 16);
+  EXPECT_EQ(16, title->font_list().GetFontSize());
+
+  profile_.GetPrefs()->SetInteger(arcium::kTabFontSizePref,
+                                 arcium::kTabFontSizeMin - 1);
+  EXPECT_EQ(arcium::kTabFontSizeMin, title->font_list().GetFontSize());
+
+  profile_.GetPrefs()->SetInteger(arcium::kTabFontSizePref,
+                                 arcium::kTabFontSizeMax + 1);
+  EXPECT_EQ(arcium::kTabFontSizeMax, title->font_list().GetFontSize());
+
+  profile_.GetPrefs()->SetInteger(arcium::kTabFontSizePref,
+                                 arcium::kTabFontSizeDefault);
+  EXPECT_EQ(native_font_size, title->font_list().GetFontSize());
+}
