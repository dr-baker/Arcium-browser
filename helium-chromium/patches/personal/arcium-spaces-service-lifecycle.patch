+void HeliumSpaceService::Shutdown() {
+  // Profile services first release borrowed state while their dependencies are
+  // alive. Repeating this cleanup from destruction must not dereference them.
+  weak_factory_.InvalidateWeakPtrs();
+  browser_collection_observation_.Reset();
   TabStripModelObserver::StopObservingAll(this);
   observed_tab_strip_models_.clear();
+  live_associations_.clear();
+  live_token_by_tab_.clear();
+  persistent_item_drags_.clear();
+  live_pin_space_transfers_.clear();
+  items_changed_callbacks_.Clear();
+  pin_to_tab_conversion_hook_for_testing_.Reset();
+  pin_space_transfer_hook_for_testing_.Reset();
+  pin_space_transfer_browser_factory_for_testing_.Reset();
+  session_space_ids_.clear();
+  empty_tab_strip_close_deferrals_.clear();
+  // The profile owns this service and outlives it. Keep the owned durable model
+  // intact; shutdown neither rewrites preferences nor changes live tabs.
 }
 
