+TEST_F(HeliumSpaceServiceTest,
+       ProfileDestructionCancelsPendingPinCloseCallbacks) {
+  // This fixture deletes profiles directly. Release Browser's keepalive
+  // synchronously so its inherited task cannot outlive the profile.
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitAndDisableFeature(features::kDestroyProfileOnBrowserClose);
+
+  // Destroy an actual keyed-service profile with close bookkeeping still
+  // queued. The manager collection must outlive Spaces' phase-one observation
+  // cleanup.
+  constexpr char kRetiringProfile[] = "space-shutdown";
+  TestingProfile* retiring_profile = CreateProfile(kRetiringProfile);
+  auto retiring_profile_weak = retiring_profile->GetWeakPtr();
+  auto* retiring_service =
+      HeliumSpaceServiceFactory::GetInstance()->SetTestingSubclassFactoryAndUse(
+          retiring_profile,
+          base::BindOnce([](content::BrowserContext* context) {
+            return std::make_unique<HeliumSpaceService>(
+                static_cast<Profile*>(context));
+          }));
+  ASSERT_TRUE(retiring_service);
+  auto retiring_browser = CreateBrowser(retiring_profile, Browser::TYPE_NORMAL,
+                                        /*hosted_app=*/false);
+  AddTab(retiring_browser.get(), GURL("https://shutdown.test/"));
+  ASSERT_TRUE(retiring_service->AddPinFromTab(
+      retiring_browser->tab_strip_model()->GetActiveTab()));
+  const auto durable_spaces =
+      retiring_profile->GetPrefs()->GetList(kHeliumSpacesPref).Clone();
+  int shutdown_updates = 0;
+  auto shutdown_subscription =
+      retiring_service->RegisterItemsChanged(base::BindRepeating(
+          [](int* updates, const PersistentItemChange&) { ++*updates; },
+          &shutdown_updates));
+  // Closing a live Pin posts deferred lifecycle work. Do not drain it before
+  // deleting the profile, and keep the subscription alive across that deletion.
+  retiring_browser->tab_strip_model()->CloseAllTabs();
+  retiring_browser->GetFeatures().TearDownPreBrowserWindowDestruction();
+  retiring_browser.reset();
+  EXPECT_EQ(durable_spaces,
+            retiring_profile->GetPrefs()->GetList(kHeliumSpacesPref));
+  const int updates_before_destruction = shutdown_updates;
+  DeleteProfile(kRetiringProfile);
+  ASSERT_FALSE(retiring_profile_weak);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(updates_before_destruction, shutdown_updates);
+}
