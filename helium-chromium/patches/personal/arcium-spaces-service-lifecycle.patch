+  AddOrdinaryTab("https://source-other.test/");
+  HeliumSpace* target =
+      service_->GetOrCreateSpace("home-close-target", u"Target");
+  Browser* target_browser = CreateSecondaryBrowser();
+  service_->SetSpaceForBrowser(target_browser, target->id());
+  AddTab(target_browser, GURL("https://target-other.test/"));
+  const base::ListValue original_pref =
+      profile()->GetPrefs()->GetList(kHeliumSpacesPref).Clone();
+  std::vector<int> notification_order;
+  base::CallbackListSubscription before_delete;
+  base::CallbackListSubscription ui_change;
+  base::CallbackListSubscription after_delete;
+  service_->SetPinSpaceTransferHookForTesting(
+      base::BindLambdaForTesting([&](PinSpaceTransferPhaseForTesting phase) {
+        if (phase != PinSpaceTransferPhaseForTesting::kAfterPlacement) {
+          return;
+        }
+        TabUIHelper* helper = TabUIHelper::From(handle.Get());
+        ASSERT_TRUE(helper);
+        helper->ClearAnchoredPinnedTabHome();
+        before_delete =
+            helper->AddTabUIChangeCallback(base::BindLambdaForTesting(
+                [&]() { notification_order.push_back(1); }));
+        ui_change =
+            helper->AddTabUIChangeCallback(base::BindLambdaForTesting([&]() {
+              notification_order.push_back(2);
+              tabs::TabInterface* current = handle.Get();
+              ASSERT_TRUE(current);
+              const int index =
+                  target_browser->tab_strip_model()->GetIndexOfTab(current);
+              ASSERT_NE(TabStripModel::kNoTab, index);
+              target_browser->tab_strip_model()->DetachAndDeleteWebContentsAt(
+                  index);
+            }));
+        after_delete =
+            helper->AddTabUIChangeCallback(base::BindLambdaForTesting(
+                [&]() { notification_order.push_back(3); }));
+      }));
+
+  EXPECT_FALSE(
+      service_->MovePinToSpace(browser(), id, space_->id(), target->id()));
+  base::RunLoop().RunUntilIdle();
+
+  EXPECT_FALSE(handle.Get());
+  EXPECT_EQ((std::vector<int>{1, 2}), notification_order);
+  EXPECT_EQ(original_pref, profile()->GetPrefs()->GetList(kHeliumSpacesPref));
+  EXPECT_TRUE(PersistentItemCodec::FindLink(space_->pins(), id));
+  EXPECT_FALSE(PersistentItemCodec::FindLink(target->pins(), id));
+  EXPECT_EQ(1, target_browser->tab_strip_model()->count());
+  EXPECT_FALSE(service_->IsPersistentItemLive(browser(),
+                                              PersistentRecordKind::kPin, id));
