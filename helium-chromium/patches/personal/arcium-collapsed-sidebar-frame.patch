+void BrowserView::UpdateCollapsedSidebarHiddenState(bool force_reveal_reset) {
+  const bool fully_hidden = IsCollapsedSidebarFullyHiddenForLayout();
+  const bool state_changed = fully_hidden != collapsed_sidebar_fully_hidden_;
+  collapsed_sidebar_fully_hidden_ = fully_hidden;
+
+  if (!zen_mode_enabled_ && (state_changed || force_reveal_reset)) {
+    const float reveal = fully_hidden ? 0.f : 1.f;
+    zen_top_chrome_animation_.Reset(reveal);
+    zen_side_chrome_animation_.Reset(reveal);
+    if (auto* frame_view = GetFrameView()) {
+      frame_view->SetCaptionButtonsOpacity(reveal);
+    }
+  }
+
+  UpdateZenModeEventMonitor();
+  if (state_changed) {
+    InvalidateLayout();
+    if (GetWidget()) {
+      GetWidget()->OnSizeConstraintsChanged();
+    }
+  }
+}
