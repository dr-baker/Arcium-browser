+int GetChromeFrameBorderWidth(const Profile* profile) {
+  const PrefService* prefs =
+      profile ? profile->GetOriginalProfile()->GetPrefs() : nullptr;
+  if (!prefs || !prefs->FindPreference(kChromeFrameBorderWidthPref)) {
+    return kChromeFrameBorderWidthDefault;
+  }
+  return std::clamp(prefs->GetInteger(kChromeFrameBorderWidthPref),
+                    kChromeFrameBorderWidthMin,
+                    kChromeFrameBorderWidthMax);
+}
+
+int GetChromeFrameBorderWidth(const views::View* view) {
+  const views::Widget* widget = view ? view->GetWidget() : nullptr;
+  const BrowserView* browser_view =
+      widget ? BrowserView::GetBrowserViewForNativeWindow(
+                   widget->GetNativeWindow())
+             : nullptr;
+  const int border_width =
+      browser_view && browser_view->GetIsNormalType()
+          ? GetChromeFrameBorderWidth(browser_view->GetProfile())
+          : kChromeFrameBorderWidthDefault;
+  return ScaleChromeDip(view, border_width);
+}
+
 int ScaleChromeDip(const views::View* view, int value) {
   return base::ClampRound(value * GetChromeUIScale(view));
 }
