+constexpr char kSharedPaletteConfigurationKey[] = "configuration";
+constexpr char kSharedPaletteAccentKey[] = "accent";
+constexpr char kSharedPaletteLightChromeColorKey[] = "lightChromeColor";
+constexpr char kSharedPaletteDarkChromeColorKey[] = "darkChromeColor";
+constexpr char kSharedPaletteControlColorIDKey[] = "controlColorID";
+constexpr size_t kSharedPaletteConfigurationKeyCount = 13;
+
+constexpr std::array<std::string_view, 39> kProfilePreferences = {
+    prefs::kRestoreOnStartup,
+    prefs::kPromptForDownload,
+    prefs::kHeliumLittleArcExternalLinks,
+    prefs::kHeliumPeekEnabled,
+    prefs::kArciumOmniboxPersistentItemsEnabled,
+    prefs::kNewTabNextToActive,
+    prefs::kTabCyclingMRU,
+    prefs::kArciumAutoPictureInPictureEnabled,
+    prefs::kShiftRightClickContextMenu,
+    prefs::kHeliumLayout,
+    prefs::kVerticalTabsUncollapsedWidth,
+    arcium::kCollapsedSidebarStylePref,
+    arcium::kCommandBarAppearancePref,
+    arcium::kCommandPanelLayoutPref,
+    arcium::kArcSidebarNavigationEnabledPref,
+    arcium::kSidebarExtensionsDrawerEnabledPref,
+    arcium::kChromeFrameBorderWidthPref,
+    arcium::kChromeUIScalePref,
+    prefs::kHeliumVerticalRightAligned,
+    prefs::kHeliumZenMode,
+    prefs::kHeliumZenModeSidebarPinned,
+    prefs::kHeliumZenModeTopChromePinned,
+    prefs::kHeliumRoundedFrame,
+    prefs::kHeliumCenteredLocationBar,
+    prefs::kHeliumMinimalLocationBar,
+    prefs::kShowHomeButton,
+    prefs::kShowBackButton,
+    prefs::kShowForwardButton,
+    prefs::kShowReloadButton,
+    prefs::kShowAvatarButton,
+    prefs::kShowExtensionsButton,
+    prefs::kShowMenuButton,
+    prefs::kShowMediaButton,
+    prefs::kShowVerticalTabsCollapseButton,
+    prefs::kShowDynamicNewTabButton,
+    helium::kHeliumSpacesPref,
+    helium::kHeliumActiveSpaceIdPref,
+    helium::kArciumChromeAppearancePref,
+    arcium_settings::kSharedPalettePref,
+};
+
+struct ParsedSharedPalette {
+  base::DictValue configuration;
+  std::string accent;
+  SkColor accent_color = SK_ColorTRANSPARENT;
+  std::string light_chrome_color;
+  SkColor light_chrome_color_value = SK_ColorTRANSPARENT;
+  std::string dark_chrome_color;
+  SkColor dark_chrome_color_value = SK_ColorTRANSPARENT;
+};
+
+bool IsMatchingNormalBrowser(BrowserWindowInterface* browser,
+                             const Profile* profile) {
+  Profile* browser_profile = browser ? browser->GetProfile() : nullptr;
+  if (!browser_profile || !profile || browser_profile != profile ||
+      browser_profile->GetOriginalProfile() != profile) {
+    return false;
+  }
+
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  return browser_view && browser_view->GetIsNormalType();
+}
+
+void ApplySidebarWidthToBrowser(BrowserWindowInterface* browser,
+                                Profile* profile,
+                                int width) {
+  if (!IsMatchingNormalBrowser(browser, profile)) {
+    return;
+  }
+
+  auto* state_controller = tabs::VerticalTabStripStateController::From(browser);
+  if (!state_controller) {
+    return;
+  }
+
+  // The state controller owns the per-window/session value and its change
+  // notification synchronizes the region view and fallback profile preference.
+  state_controller->SetUncollapsedWidth(width);
+}
+
+BrowserWindowInterface* FindMatchingNormalBrowser(Profile* profile) {
+  if (!profile) {
+    return nullptr;
+  }
+
+  GlobalBrowserCollection* collection = GlobalBrowserCollection::GetInstance();
+  if (!collection) {
+    return nullptr;
+  }
+
+  BrowserWindowInterface* matching_browser = nullptr;
+  collection->ForEach(
+      [&matching_browser, profile](BrowserWindowInterface* browser) {
+        if (IsMatchingNormalBrowser(browser, profile)) {
+          matching_browser = browser;
+          return false;
+        }
+        return true;
+      },
+      BrowserCollection::Order::kActivation);
+  return matching_browser;
+}
+
+bool HasExactlyKeys(const base::DictValue& dictionary,
+                    std::initializer_list<std::string_view> keys) {
+  if (dictionary.size() != keys.size()) {
+    return false;
+  }
+  for (std::string_view key : keys) {
+    if (!dictionary.Find(key)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool HasFiniteNumberInRange(const base::DictValue& dictionary,
+                            std::string_view key,
+                            double minimum,
+                            double maximum) {
+  const std::optional<double> value = dictionary.FindDouble(key);
+  return value.has_value() && std::isfinite(*value) && *value >= minimum &&
+         *value <= maximum;
+}
+
+bool IsOneOf(std::string_view value,
+             std::initializer_list<std::string_view> allowed_values) {
+  for (std::string_view allowed : allowed_values) {
+    if (value == allowed) {
+      return true;
+    }
+  }
+  return false;
+}
+
+int HexDigit(char value) {
+  if (value >= '0' && value <= '9') {
+    return value - '0';
+  }
+  if (value >= 'a' && value <= 'f') {
+    return value - 'a' + 10;
+  }
+  if (value >= 'A' && value <= 'F') {
+    return value - 'A' + 10;
+  }
+  return -1;
+}
+
+std::optional<SkColor> ParseHexColor(std::string_view value) {
+  if (value.size() != 7 || value[0] != '#') {
+    return std::nullopt;
+  }
+  int channels[3] = {};
+  for (size_t channel = 0; channel < 3; ++channel) {
+    const int high = HexDigit(value[1 + channel * 2]);
+    const int low = HexDigit(value[2 + channel * 2]);
+    if (high < 0 || low < 0) {
+      return std::nullopt;
+    }
+    channels[channel] = high * 16 + low;
+  }
+  return SkColorSetRGB(channels[0], channels[1], channels[2]);
+}
+
+std::string ColorString(SkColor color) {
+  return base::StringPrintf("#%02X%02X%02X", SkColorGetR(color),
+                            SkColorGetG(color), SkColorGetB(color));
+}
+
+bool ValidateOKLCH(const base::DictValue& value) {
+  return HasExactlyKeys(value, {"lightness", "chroma", "hue"}) &&
+         HasFiniteNumberInRange(value, "lightness", 0.0, 1.0) &&
+         HasFiniteNumberInRange(value, "chroma", 0.0, 0.5) &&
+         HasFiniteNumberInRange(value, "hue", 0.0, 360.0);
+}
+
+std::optional<ParsedSharedPalette> ParseSharedPalette(
+    const base::DictValue& payload) {
+  if (!HasExactlyKeys(payload,
+                      {kSharedPaletteConfigurationKey, kSharedPaletteAccentKey,
+                       kSharedPaletteLightChromeColorKey,
+                       kSharedPaletteDarkChromeColorKey})) {
+    return std::nullopt;
+  }
+
+  const base::DictValue* configuration =
+      payload.FindDict(kSharedPaletteConfigurationKey);
+  const std::string* accent = payload.FindString(kSharedPaletteAccentKey);
+  const std::string* light_chrome_color =
+      payload.FindString(kSharedPaletteLightChromeColorKey);
+  const std::string* dark_chrome_color =
+      payload.FindString(kSharedPaletteDarkChromeColorKey);
+  if (!configuration || !accent || !light_chrome_color || !dark_chrome_color ||
+      (configuration->size() != kSharedPaletteConfigurationKeyCount &&
+       configuration->size() != kSharedPaletteConfigurationKeyCount + 1) ||
+      !configuration->Find("accentSource") ||
+      !configuration->Find("customAccent") ||
+      !configuration->Find("brandLightness") ||
+      !configuration->Find("harmony") ||
+      !configuration->Find("chromeSource") ||
+      !configuration->Find("companion") || !configuration->Find("hue") ||
+      !configuration->Find("chroma") ||
+      !configuration->Find("neutralHue") ||
+      !configuration->Find("neutralChroma") ||
+      !configuration->Find("textContrast") ||
+      !configuration->Find("lightCanvas") ||
+      !configuration->Find("darkCanvas")) {
+    return std::nullopt;
+  }
+
+  // The native model deliberately accepts no arbitrary metadata. This one
+  // optional identifier is resolved by Swift, but must survive the native
+  // preference round trip for the next snapshot.
+  if (configuration->size() == kSharedPaletteConfigurationKeyCount + 1) {
+    const std::string* control_color_id =
+        configuration->FindString(kSharedPaletteControlColorIDKey);
+    if (!control_color_id || control_color_id->empty() ||
+        control_color_id->size() > 128) {
+      return std::nullopt;
+    }
+  }
+
+  const std::string* accent_source = configuration->FindString("accentSource");
+  const std::string* harmony = configuration->FindString("harmony");
+  const std::string* chrome_source = configuration->FindString("chromeSource");
+  const base::DictValue* custom_accent =
+      configuration->FindDict("customAccent");
+  const base::DictValue* companion = configuration->FindDict("companion");
+  if (!accent_source || !harmony || !chrome_source || !custom_accent ||
+      !companion ||
+      !IsOneOf(*accent_source,
+               {"Primary brand", "Companion", "Custom accent"}) ||
+      !IsOneOf(*harmony, {"Quiet", "Related", "Complementary",
+                          "Split complementary", "My second color"}) ||
+      !IsOneOf(*chrome_source,
+               {"Brand tint", "Companion tint", "Neutral", "Custom hue"}) ||
+      !ValidateOKLCH(*custom_accent) || !ValidateOKLCH(*companion) ||
+      !HasFiniteNumberInRange(*configuration, "brandLightness", 0.0, 1.0) ||
+      !HasFiniteNumberInRange(*configuration, "hue", 0.0, 360.0) ||
+      !HasFiniteNumberInRange(*configuration, "chroma", 0.0, 0.5) ||
+      !HasFiniteNumberInRange(*configuration, "neutralHue", 0.0, 360.0) ||
+      !HasFiniteNumberInRange(*configuration, "neutralChroma", 0.0, 0.04) ||
+      !HasFiniteNumberInRange(*configuration, "textContrast", 4.5, 7.0) ||
+      !HasFiniteNumberInRange(*configuration, "lightCanvas", 0.0, 1.0) ||
+      !HasFiniteNumberInRange(*configuration, "darkCanvas", 0.0, 1.0)) {
+    return std::nullopt;
+  }
+
+  const std::optional<SkColor> accent_color = ParseHexColor(*accent);
+  const std::optional<SkColor> light_color = ParseHexColor(*light_chrome_color);
+  const std::optional<SkColor> dark_color = ParseHexColor(*dark_chrome_color);
+  if (!accent_color || !light_color || !dark_color) {
+    return std::nullopt;
+  }
+
+  ParsedSharedPalette parsed;
+  parsed.configuration = configuration->Clone();
+  parsed.accent_color = *accent_color;
+  parsed.accent = ColorString(*accent_color);
+  parsed.light_chrome_color_value = *light_color;
+  parsed.light_chrome_color = ColorString(*light_color);
+  parsed.dark_chrome_color_value = *dark_color;
+  parsed.dark_chrome_color = ColorString(*dark_color);
+  return parsed;
+}
+
+bool IsCurrentPalette(ThemeService* theme_service,
+                      const ParsedSharedPalette& palette) {
+  if (!theme_service || theme_service->UsingPolicyTheme() ||
+      theme_service->UsingExtensionTheme()) {
+    return false;
+  }
+  const std::optional<SkColor> user_color = theme_service->GetUserColor();
+  return user_color.has_value() && *user_color == palette.accent_color;
+}
+
+}  // namespace
+
+std::optional<SkColor> GetSharedPaletteChromeColor(Profile* profile,
+                                                   bool dark) {
+  if (!profile) {
+    return std::nullopt;
+  }
+  PrefService* prefs = profile->GetPrefs();
+  ThemeService* theme_service = ThemeServiceFactory::GetForProfile(profile);
+  if (!prefs || !theme_service || !prefs->FindPreference(kSharedPalettePref)) {
+    return std::nullopt;
+  }
+  const std::optional<ParsedSharedPalette> palette =
+      ParseSharedPalette(prefs->GetDict(kSharedPalettePref));
+  if (!palette || !IsCurrentPalette(theme_service, *palette)) {
+    return std::nullopt;
+  }
+  return dark ? palette->dark_chrome_color_value
+              : palette->light_chrome_color_value;
+}
+
+ArciumSettingsModel::ArciumSettingsModel(
+    Profile* profile,
+    base::RepeatingClosure changed_callback,
+    base::RepeatingClosure profile_destroyed_callback)
+    : profile_(profile),
+      changed_callback_(std::move(changed_callback)),
+      profile_destroyed_callback_(std::move(profile_destroyed_callback)) {
+  if (!profile_) {
+    return;
+  }
+
+  profile_observation_.Observe(profile_);
+  prefs_ = profile_->GetPrefs();
+  if (!prefs_) {
+    return;
+  }
+
+  pref_change_registrar_.Init(prefs_);
+  for (std::string_view name : kProfilePreferences) {
+    if (prefs_->FindPreference(name)) {
+      pref_change_registrar_.Add(
+          name,
+          base::BindRepeating(&ArciumSettingsModel::OnProfilePreferenceChanged,
+                              base::Unretained(this)));
+    }
+  }
+
+  theme_service_ = ThemeServiceFactory::GetForProfile(profile_);
+  if (theme_service_) {
+    theme_service_observation_.Observe(theme_service_);
+  }
+
+  space_service_ = helium::HeliumSpaceServiceFactory::GetForProfile(profile_);
+  shortcut_service_ =
+      browser_shortcuts::BrowserShortcutServiceFactory::GetForProfile(profile_);
+  if (shortcut_service_) {
+    shortcut_observation_.Observe(shortcut_service_);
+  }
+
+  if (g_browser_process) {
+    local_state_ = g_browser_process->local_state();
+  }
+  if (local_state_) {
+    local_pref_change_registrar_.Init(local_state_);
+#if BUILDFLAG(IS_MAC)
+    for (std::string_view name : {prefs::kConfirmToQuitEnabled,
+                                  prefs::kArciumShowSpacesInDockMenu}) {
+      if (local_state_->FindPreference(name)) {
+        local_pref_change_registrar_.Add(
+            name,
+            base::BindRepeating(&ArciumSettingsModel::OnLocalPreferenceChanged,
+                                base::Unretained(this)));
+      }
+    }
+#endif
+  }
+}
+
+ArciumSettingsModel::~ArciumSettingsModel() {
+  Shutdown();
+}
+
+bool ArciumSettingsModel::HasPreference(std::string_view name) const {
+  return prefs_ && prefs_->FindPreference(name);
+}
+
+bool ArciumSettingsModel::GetBoolean(std::string_view name) const {
+  return prefs_ && HasPreference(name) && prefs_->GetBoolean(name);
+}
+
+bool ArciumSettingsModel::IsManaged(std::string_view name) const {
+  return prefs_ && HasPreference(name) &&
+         !prefs_->IsUserModifiablePreference(name);
+}
+
+void ArciumSettingsModel::SetBoolean(std::string_view name, bool value) {
+  if (shutting_down_ || !prefs_ || !HasPreference(name) ||
+      !prefs_->IsUserModifiablePreference(name)) {
+    return;
+  }
+  prefs_->SetBoolean(name, value);
+}
+
+bool ArciumSettingsModel::HasLocalPreference(std::string_view name) const {
+  return local_state_ && local_state_->FindPreference(name);
+}
+
+bool ArciumSettingsModel::GetLocalBoolean(std::string_view name) const {
+  return local_state_ && HasLocalPreference(name) &&
+         local_state_->GetBoolean(name);
+}
+
+bool ArciumSettingsModel::IsLocalManaged(std::string_view name) const {
+  return local_state_ && HasLocalPreference(name) &&
+         !local_state_->IsUserModifiablePreference(name);
+}
+
+void ArciumSettingsModel::SetLocalBoolean(std::string_view name, bool value) {
+  if (shutting_down_ || !local_state_ || !HasLocalPreference(name) ||
+      !local_state_->IsUserModifiablePreference(name)) {
+    return;
+  }
+  local_state_->SetBoolean(name, value);
+}
+
+int ArciumSettingsModel::GetInteger(std::string_view name) const {
+  return prefs_ && HasPreference(name) ? prefs_->GetInteger(name) : 0;
+}
+
+void ArciumSettingsModel::SetInteger(std::string_view name, int value) {
+  if (shutting_down_ || !prefs_ || !HasPreference(name) ||
+      !prefs_->IsUserModifiablePreference(name)) {
+    return;
+  }
+  prefs_->SetInteger(name, value);
+}
+
+bool ArciumSettingsModel::HasSidebarWidth() const {
+  return prefs_ && HasPreference(prefs::kVerticalTabsUncollapsedWidth);
+}
+
+int ArciumSettingsModel::GetSidebarWidth() const {
+  if (!HasSidebarWidth()) {
+    return tabs::kVerticalTabStripDefaultUncollapsedWidth;
+  }
+
+  int width = prefs_->GetInteger(prefs::kVerticalTabsUncollapsedWidth);
+  if (BrowserWindowInterface* browser = FindMatchingNormalBrowser(profile_)) {
+    if (auto* state_controller =
+            tabs::VerticalTabStripStateController::From(browser)) {
+      width = state_controller->GetUncollapsedWidth();
+    }
+  }
+
+  return std::clamp(width, kSidebarWidthMin, kSidebarWidthMax);
+}
+
+bool ArciumSettingsModel::IsSidebarWidthManaged() const {
+  return HasSidebarWidth() && IsManaged(prefs::kVerticalTabsUncollapsedWidth);
+}
+
+bool ArciumSettingsModel::SetSidebarWidth(int width) {
+  if (width < kSidebarWidthMin || width > kSidebarWidthMax || shutting_down_ ||
+      !HasSidebarWidth() ||
+      !prefs_->IsUserModifiablePreference(
+          prefs::kVerticalTabsUncollapsedWidth)) {
+    return false;
+  }
+
+  prefs_->SetInteger(prefs::kVerticalTabsUncollapsedWidth, width);
+
+  if (GlobalBrowserCollection* collection =
+          GlobalBrowserCollection::GetInstance()) {
+    collection->ForEach(
+        [this, width](BrowserWindowInterface* browser) {
+          ApplySidebarWidthToBrowser(browser, profile_, width);
+          return true;
+        },
+        BrowserCollection::Order::kActivation);
+  }
+  return true;
+}
+
+void ArciumSettingsModel::ClearPreference(std::string_view name) {
+  if (shutting_down_ || !prefs_ || !HasPreference(name) ||
+      !prefs_->IsUserModifiablePreference(name)) {
+    return;
+  }
+  prefs_->ClearPref(name);
+}
+
+base::DictValue ArciumSettingsModel::GetCommandPanelLayout() const {
+  return prefs_ && HasPreference(arcium::kCommandPanelLayoutPref)
+             ? prefs_->GetDict(arcium::kCommandPanelLayoutPref).Clone()
+             : base::DictValue();
+}
+
+bool ArciumSettingsModel::SetCommandPanelLayout(const base::DictValue& layout) {
+  if (shutting_down_ || !prefs_ ||
+      !HasPreference(arcium::kCommandPanelLayoutPref) ||
+      !prefs_->IsUserModifiablePreference(arcium::kCommandPanelLayoutPref) ||
+      layout.size() != 8) {
+    return false;
+  }
+  for (const auto* key : {"labels", "icons", "scope_reveal"}) {
+    const auto value = layout.FindInt(key);
+    const int maximum = std::string_view(key) == "labels"         ? 2
+                        : std::string_view(key) == "scope_reveal" ? 5
+                                                                  : 3;
+    if (!value || *value < 0 || *value > maximum) {
+      return false;
+    }
+  }
+  for (const auto* key :
+       {"connected", "full_width", "scope_tints", "activity_dots"}) {
+    if (!layout.FindBool(key).has_value()) {
+      return false;
+    }
+  }
+  const auto strength = layout.FindDouble("glow_strength");
+  if (!strength || !std::isfinite(*strength) || *strength < 0.0 ||
+      *strength > 2.0) {
+    return false;
+  }
+  prefs_->SetDict(arcium::kCommandPanelLayoutPref, layout.Clone());
+  return true;
+}
+
+base::DictValue ArciumSettingsModel::GetChromeAppearance() const {
+  if (!prefs_ || !HasPreference(helium::kArciumChromeAppearancePref)) {
+    return {};
+  }
+  // Fill missing fields from the shared defaults without changing stored
+  // values. Malformed values and unknown keys remain visible to the strict
+  // editor parser, so completing an older dictionary does not sanitize it.
+  return helium::CompleteGlassSurfaceConfigurationForEditing(
+      prefs_->GetDict(helium::kArciumChromeAppearancePref));
+}
+
+bool ArciumSettingsModel::SetChromeAppearance(
+    const base::DictValue& configuration) {
+  if (shutting_down_ || !prefs_ ||
+      !HasPreference(helium::kArciumChromeAppearancePref) ||
+      !prefs_->IsUserModifiablePreference(
+          helium::kArciumChromeAppearancePref)) {
+    return false;
+  }
+
+  std::optional<helium::GlassSurfaceConfiguration> parsed =
+      helium::ParseGlassSurfaceConfigurationStrict(configuration);
+  if (!parsed) {
+    return false;
+  }
+  // Store the canonical form so future fields and malformed Foundation input
+  // cannot bypass the one shared runtime schema.
+  prefs_->SetDict(helium::kArciumChromeAppearancePref,
+                  helium::SerializeGlassSurfaceConfiguration(*parsed));
+  return true;
+}
+
+void ArciumSettingsModel::ResetChromeAppearance() {
+  ClearPreference(helium::kArciumChromeAppearancePref);
+}
+
+bool ArciumSettingsModel::IsAppearanceAvailable() const {
+  return !shutting_down_ && prefs_ && theme_service_ &&
+         prefs_->FindPreference(prefs::kBrowserColorScheme);
+}
+
+int ArciumSettingsModel::GetAppearanceMode() const {
+  const int system =
+      static_cast<int>(ThemeService::BrowserColorScheme::kSystem);
+  const int dark = static_cast<int>(ThemeService::BrowserColorScheme::kDark);
+  if (!theme_service_) {
+    return system;
+  }
+  const int mode = static_cast<int>(theme_service_->GetBrowserColorScheme());
+  return mode >= system && mode <= dark ? mode : system;
+}
+
+bool ArciumSettingsModel::IsAppearanceManaged() const {
+  return !IsAppearanceAvailable() || theme_service_->UsingPolicyTheme() ||
+         !prefs_->IsUserModifiablePreference(prefs::kBrowserColorScheme);
+}
+
+bool ArciumSettingsModel::SetAppearanceMode(int mode) {
+  if (shutting_down_ || IsAppearanceManaged()) {
+    return false;
+  }
+
+  const int system =
+      static_cast<int>(ThemeService::BrowserColorScheme::kSystem);
+  const int dark = static_cast<int>(ThemeService::BrowserColorScheme::kDark);
+  if (mode < system || mode > dark) {
+    return false;
+  }
+  theme_service_->SetBrowserColorScheme(
+      static_cast<ThemeService::BrowserColorScheme>(mode));
+  return true;
+}
+
+base::DictValue ArciumSettingsModel::GetSharedPalette() const {
+  base::DictValue result;
+  result.Set(kSharedPaletteConfigurationKey, base::DictValue());
+  result.Set(kSharedPaletteAccentKey, std::string());
+  result.Set(kSharedPaletteLightChromeColorKey, std::string());
+  result.Set(kSharedPaletteDarkChromeColorKey, std::string());
+  result.Set("available", false);
+  result.Set("managed", false);
+  result.Set("editable", false);
+  result.Set("editabilityReason", std::string());
+  result.Set("overrideActive", false);
+
+  if (!IsAppearanceAvailable() || !prefs_->FindPreference(kSharedPalettePref)) {
+    return result;
+  }
+
+  const bool managed = theme_service_->UsingPolicyTheme() ||
+                       !prefs_->IsUserModifiablePreference(kSharedPalettePref);
+  result.Set("available", true);
+  result.Set("managed", managed);
+  result.Set("editable", !managed);
+
+  const std::optional<ParsedSharedPalette> palette =
+      ParseSharedPalette(prefs_->GetDict(kSharedPalettePref));
+  if (theme_service_->UsingPolicyTheme()) {
+    result.Set(kSharedPaletteAccentKey,
+               ColorString(theme_service_->GetPolicyThemeColor()));
+    return result;
+  }
+  if (theme_service_->UsingExtensionTheme()) {
+    if (ui::ColorProvider* color_provider = theme_service_->GetColorProvider()) {
+      result.Set(kSharedPaletteAccentKey,
+                 ColorString(color_provider->GetColor(kColorToolbar)));
+    }
+    result.Set("editable", false);
+    result.Set("editabilityReason", "extension_theme");
+    return result;
+  }
+
+  const std::optional<SkColor> user_color = theme_service_->GetUserColor();
+  if (!user_color) {
+    return result;
+  }
+  result.Set(kSharedPaletteAccentKey, ColorString(*user_color));
+  if (!palette || !IsCurrentPalette(theme_service_, *palette)) {
+    return result;
+  }
+
+  result.Set(kSharedPaletteConfigurationKey, palette->configuration.Clone());
+  result.Set(kSharedPaletteLightChromeColorKey, palette->light_chrome_color);
+  result.Set(kSharedPaletteDarkChromeColorKey, palette->dark_chrome_color);
+  result.Set("overrideActive", true);
+  return result;
+}
+
+bool ArciumSettingsModel::SetSharedPalette(const base::DictValue& payload) {
+  if (shutting_down_ || !IsAppearanceAvailable() ||
+      !prefs_->FindPreference(kSharedPalettePref) ||
+      !prefs_->IsUserModifiablePreference(kSharedPalettePref) ||
+      theme_service_->UsingPolicyTheme() ||
+      theme_service_->UsingExtensionTheme()) {
+    return false;
+  }
+
+  const std::optional<ParsedSharedPalette> palette =
+      ParseSharedPalette(payload);
+  if (!palette) {
+    return false;
+  }
+
+  base::DictValue stored;
+  stored.Set(kSharedPaletteConfigurationKey, palette->configuration.Clone());
+  stored.Set(kSharedPaletteAccentKey, palette->accent);
+  stored.Set(kSharedPaletteLightChromeColorKey, palette->light_chrome_color);
+  stored.Set(kSharedPaletteDarkChromeColorKey, palette->dark_chrome_color);
+
+  {
+    base::AutoReset<bool> resetter(&suppress_shared_palette_notifications_,
+                                   true);
+    prefs_->SetDict(kSharedPalettePref, std::move(stored));
+    theme_service_->SetUserColor(palette->accent_color);
+  }
+  NotifyChanged();
+  return true;
+}
+
+bool ArciumSettingsModel::ResetSharedPalette() {
+  if (shutting_down_ || !IsAppearanceAvailable() ||
+      !prefs_->FindPreference(kSharedPalettePref) ||
+      !prefs_->IsUserModifiablePreference(kSharedPalettePref) ||
+      theme_service_->UsingPolicyTheme() ||
+      theme_service_->UsingExtensionTheme()) {
+    return false;
+  }
+
+  const std::optional<ParsedSharedPalette> palette =
+      ParseSharedPalette(prefs_->GetDict(kSharedPalettePref));
+  const bool owns_user_color =
+      palette && IsCurrentPalette(theme_service_, *palette);
+  const bool had_saved_palette = !prefs_->GetDict(kSharedPalettePref).empty();
+  {
+    base::AutoReset<bool> resetter(&suppress_shared_palette_notifications_,
+                                   true);
+    if (owns_user_color) {
+      theme_service_->SetUserColor(std::nullopt);
+    }
+    prefs_->ClearPref(kSharedPalettePref);
+  }
+  if (had_saved_palette || owns_user_color) {
+    NotifyChanged();
+  }
+  return true;
+}
+
+int ArciumSettingsModel::GetStartupType() const {
+  if (!prefs_ || !HasPreference(prefs::kRestoreOnStartup)) {
+    return static_cast<int>(SessionStartupPref::DEFAULT);
+  }
+  return static_cast<int>(SessionStartupPref::GetStartupPref(prefs_).type);
+}
+
+void ArciumSettingsModel::SetStartupType(int type) {
+  if (shutting_down_ || !prefs_ ||
+      !prefs_->IsUserModifiablePreference(prefs::kRestoreOnStartup)) {
+    return;
+  }
+
+  SessionStartupPref startup = SessionStartupPref::GetStartupPref(prefs_);
+  switch (static_cast<SessionStartupPref::Type>(type)) {
+    case SessionStartupPref::DEFAULT:
+    case SessionStartupPref::LAST:
+    case SessionStartupPref::URLS:
+    case SessionStartupPref::LAST_AND_URLS:
+      startup.type = static_cast<SessionStartupPref::Type>(type);
+      SessionStartupPref::SetStartupPref(prefs_, startup);
+      break;
+    default:
+      break;
+  }
+}
+
+std::vector<SpaceState> ArciumSettingsModel::GetSpaces() {
+  std::vector<SpaceState> spaces;
+  if (shutting_down_ || !space_service_) {
+    return spaces;
+  }
+
+  const std::string active_id =
+      prefs_ && HasPreference(helium::kHeliumActiveSpaceIdPref)
+          ? prefs_->GetString(helium::kHeliumActiveSpaceIdPref)
+          : std::string();
+  for (helium::HeliumSpace* space : space_service_->GetSpaces()) {
+    if (!space) {
+      continue;
+    }
+    spaces.push_back({space->id(), space->name(), space->id() == active_id});
+  }
+  return spaces;
+}
+
+bool ArciumSettingsModel::SetActiveSpace(std::string_view id) {
+  if (shutting_down_ || !space_service_ || !prefs_ ||
+      !prefs_->FindPreference(helium::kHeliumActiveSpaceIdPref) ||
+      !prefs_->IsUserModifiablePreference(helium::kHeliumActiveSpaceIdPref) ||
+      !space_service_->GetSpaceById(id)) {
+    return false;
+  }
+  space_service_->SetActiveSpace(id);
+  NotifyChanged();
+  return true;
+}
+
+browser_shortcuts::arcium::PresetResult ArciumSettingsModel::ApplyArcPreset() {
+  if (shutting_down_ || !shortcut_service_) {
+    return browser_shortcuts::arcium::PresetResult::kPreferencesLocked;
+  }
+  const browser_shortcuts::arcium::PresetResult result =
+      browser_shortcuts::arcium::ApplyArcShortcutPreset(shortcut_service_);
+  if (result == browser_shortcuts::arcium::PresetResult::kApplied ||
+      result == browser_shortcuts::arcium::PresetResult::kNoChange) {
+    NotifyChanged();
+  }
+  return result;
+}
+
+browser_shortcuts::arcium::PresetResult
+ArciumSettingsModel::RestoreArcPreset() {
+  if (shutting_down_ || !shortcut_service_ || !HasPreviousArcPreset()) {
+    return browser_shortcuts::arcium::PresetResult::kNoPreviousConfiguration;
+  }
+  const browser_shortcuts::arcium::PresetResult result =
+      browser_shortcuts::arcium::RestorePreviousArcShortcutConfiguration(
+          shortcut_service_);
+  if (result == browser_shortcuts::arcium::PresetResult::kApplied ||
+      result == browser_shortcuts::arcium::PresetResult::kNoChange) {
+    NotifyChanged();
+  }
+  return result;
+}
+
+bool ArciumSettingsModel::HasPreviousArcPreset() const {
+  return shortcut_service_ &&
+         browser_shortcuts::arcium::HasPreviousArcShortcutConfiguration(
+             *shortcut_service_);
+}
+
+browser_shortcuts::arcium::PresetReport
+ArciumSettingsModel::GetArcPresetReport() const {
+  if (!shortcut_service_) {
+    return {};
+  }
+  return browser_shortcuts::arcium::GetArcShortcutPresetReport(
+      *shortcut_service_);
+}
+
+void ArciumSettingsModel::Shutdown() {
+  if (shutting_down_) {
+    return;
+  }
+  shutting_down_ = true;
+
+  // Detach in this order before notifying the Cocoa controller. ProfileObserver
+  // runs while keyed services still exist, but the window must never ask them
+  // for state after this point.
+  shortcut_observation_.Reset();
+  theme_service_observation_.Reset();
+  profile_observation_.Reset();
+  pref_change_registrar_.Reset();
+  local_pref_change_registrar_.Reset();
+
+  shortcut_service_ = nullptr;
+  theme_service_ = nullptr;
+  space_service_ = nullptr;
+  prefs_ = nullptr;
+  local_state_ = nullptr;
+  profile_ = nullptr;
+  changed_callback_.Reset();
+}
+
+void ArciumSettingsModel::OnProfileWillBeDestroyed(Profile* profile) {
+  if (profile != profile_ || shutting_down_) {
+    return;
+  }
+  Shutdown();
+  if (profile_destroyed_callback_) {
+    profile_destroyed_callback_.Run();
+  }
+}
+
+void ArciumSettingsModel::OnBrowserShortcutsChanged() {
+  NotifyChanged();
+}
+
+void ArciumSettingsModel::OnThemeChanged() {
+  if (suppress_shared_palette_notifications_) {
+    return;
+  }
+  NotifyChanged();
+}
+
+void ArciumSettingsModel::NotifyChanged() {
+  if (!shutting_down_ && changed_callback_) {
+    changed_callback_.Run();
+  }
+}
+
+void ArciumSettingsModel::OnProfilePreferenceChanged(std::string_view name) {
+  if (suppress_shared_palette_notifications_ && name == kSharedPalettePref) {
+    return;
+  }
+  NotifyChanged();
+}
+
+void ArciumSettingsModel::OnLocalPreferenceChanged(std::string_view name) {
+  NotifyChanged();
+}
+
+}  // namespace arcium_settings
