+}
+
+namespace arcium_settings {
+
+struct SpaceState {
+  std::string id;
+  std::u16string name;
+  bool active = false;
+};
+
+inline constexpr int kSidebarWidthMin = 160;
+inline constexpr int kSidebarWidthMax = 400;
+
+// The native settings window owns one of these for the original Profile it is
+// displaying. All pointers are valid only until Shutdown() or
+// OnProfileWillBeDestroyed().
+class ArciumSettingsModel final
+    : public ProfileObserver,
+      public browser_shortcuts::BrowserShortcutService::Observer,
+      public ThemeServiceObserver {
+ public:
+  ArciumSettingsModel(Profile* profile,
+                      base::RepeatingClosure changed_callback,
+                      base::RepeatingClosure profile_destroyed_callback);
+  ArciumSettingsModel(const ArciumSettingsModel&) = delete;
+  ArciumSettingsModel& operator=(const ArciumSettingsModel&) = delete;
+  ~ArciumSettingsModel() override;
+
+  Profile* profile() const { return profile_; }
+  bool available() const { return profile_ && prefs_; }
+
+  bool HasPreference(std::string_view name) const;
+  bool GetBoolean(std::string_view name) const;
+  bool IsManaged(std::string_view name) const;
+  void SetBoolean(std::string_view name, bool value);
+
+  bool HasLocalPreference(std::string_view name) const;
+  bool GetLocalBoolean(std::string_view name) const;
+  bool IsLocalManaged(std::string_view name) const;
+  void SetLocalBoolean(std::string_view name, bool value);
+
+  int GetInteger(std::string_view name) const;
+  void SetInteger(std::string_view name, int value);
+  bool HasSidebarWidth() const;
+  int GetSidebarWidth() const;
+  bool IsSidebarWidthManaged() const;
+  bool SetSidebarWidth(int width);
+  void ClearPreference(std::string_view name);
+
+  // Returns the registered profile-owned browser chrome appearance. A missing
+  // registration is returned as an empty dictionary; existing values are
+  // preserved so SettingsUI can fail closed on legacy or malformed data.
+  base::DictValue GetCommandPanelLayout() const;
+  bool SetCommandPanelLayout(const base::DictValue& layout);
+  base::DictValue GetChromeAppearance() const;
+  // Accepts only a complete, strictly validated configuration. Invalid
+  // values and managed/unavailable preferences are rejected before any write.
+  bool SetChromeAppearance(const base::DictValue& configuration);
+  void ResetChromeAppearance();
+
+  // Browser appearance mode is owned by ThemeService. The integer values
+  // match ThemeService::BrowserColorScheme and are exposed only to the
+  // SettingsUI bridge.
+  bool IsAppearanceAvailable() const;
+  int GetAppearanceMode() const;
+  bool IsAppearanceManaged() const;
+  bool SetAppearanceMode(int mode);
+
+  // The palette dictionary stores SettingsPaletteConfiguration JSON together
+  // with its resolved browser colors. Effective state is returned only when
+  // ThemeService still reports the saved user color as active.
+  base::DictValue GetSharedPalette() const;
+  bool SetSharedPalette(const base::DictValue& payload);
+  bool ResetSharedPalette();
+
+  int GetStartupType() const;
+  void SetStartupType(int type);
+
+  std::vector<SpaceState> GetSpaces();
+  bool SetActiveSpace(std::string_view id);
+
+  browser_shortcuts::BrowserShortcutService* shortcut_service() const {
+    return shortcut_service_;
+  }
+  browser_shortcuts::arcium::PresetResult ApplyArcPreset();
+  browser_shortcuts::arcium::PresetResult RestoreArcPreset();
+  bool HasPreviousArcPreset() const;
+  browser_shortcuts::arcium::PresetReport GetArcPresetReport() const;
+
+  // Detaches every Profile, PrefService, and keyed-service observer. This is
+  // used before application teardown and is safe to call more than once.
+  void Shutdown();
+
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile* profile) override;
+
+  // BrowserShortcutService::Observer:
+  void OnBrowserShortcutsChanged() override;
+
+  // ThemeServiceObserver:
+  void OnThemeChanged() override;
+
+ private:
+  void NotifyChanged();
+  void OnProfilePreferenceChanged(std::string_view name);
+  void OnLocalPreferenceChanged(std::string_view name);
+
+  raw_ptr<Profile> profile_ = nullptr;
+  raw_ptr<PrefService> prefs_ = nullptr;
+  raw_ptr<PrefService> local_state_ = nullptr;
+  raw_ptr<helium::HeliumSpaceService> space_service_ = nullptr;
+  raw_ptr<browser_shortcuts::BrowserShortcutService> shortcut_service_ =
+      nullptr;
+  raw_ptr<ThemeService> theme_service_ = nullptr;
+
+  PrefChangeRegistrar pref_change_registrar_;
+  PrefChangeRegistrar local_pref_change_registrar_;
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+  base::ScopedObservation<browser_shortcuts::BrowserShortcutService,
+                          browser_shortcuts::BrowserShortcutService::Observer>
+      shortcut_observation_{this};
+  base::ScopedObservation<ThemeService, ThemeServiceObserver>
+      theme_service_observation_{this};
+
+  base::RepeatingClosure changed_callback_;
+  base::RepeatingClosure profile_destroyed_callback_;
+  bool suppress_shared_palette_notifications_ = false;
+  bool shutting_down_ = false;
+};
+
+}  // namespace arcium_settings
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARCIUM_SETTINGS_MODEL_H_
