+TEST_P(RendererPixelTestWithBackdropFilter, ReferenceDisplacementMapBackdrop) {
+  // Keep the rounded mask on all three captures so the only intended change is
+  // the serialized Reference/DisplacementMap filter itself.
+  include_backdrop_mask_ = true;
+
+  auto rebuild_scene = [&]() {
+    pass_list_.clear();
+    SetUpRenderPassList();
+  };
+
+  // The root pass paints a deterministic green/red/blue bar pattern with
+  // one-pixel gaps. This makes a small displacement visible without relying
+  // on external images or a browser-page readback.
+  backdrop_filters_ = cc::FilterOperations();
+  rebuild_scene();
+  const SkBitmap untouched = CaptureCurrentScene();
+  WriteRefractionArtifact(untouched, renderer_type(), "untouched");
+
+  backdrop_filters_ = cc::FilterOperations();
+  backdrop_filters_.Append(cc::FilterOperation::CreateReferenceFilter(
+      MakeSolidDisplacementMap(/*scale=*/0.0f, filter_pass_layer_rect_)));
+  rebuild_scene();
+  const SkBitmap identity = CaptureCurrentScene();
+  WriteRefractionArtifact(identity, renderer_type(), "identity");
+  EXPECT_TRUE(BitmapsMatchExactly(untouched, identity));
+
+  backdrop_filters_ = cc::FilterOperations();
+  backdrop_filters_.Append(cc::FilterOperation::CreateReferenceFilter(
+      MakeSolidDisplacementMap(/*scale=*/12.0f, filter_pass_layer_rect_)));
+  rebuild_scene();
+  const SkBitmap displaced = CaptureCurrentScene();
+  WriteRefractionArtifact(displaced, renderer_type(), "displaced");
+
+  ASSERT_EQ(displaced.width(), untouched.width());
+  ASSERT_EQ(displaced.height(), untouched.height());
+  const PixelDifference difference =
+      CalculatePixelDifference(untouched, displaced);
+  ASSERT_GT(difference.count, 0);
+  EXPECT_GT(difference.max_channel_delta, 8);
+  EXPECT_TRUE(filter_pass_layer_rect_.Contains(difference.bounds))
+      << "displacement escaped crop bounds: " << difference.bounds.ToString();
+
+  int outside_crop_difference_count = 0;
+  int black_pixel_count = 0;
+  int transparent_pixel_count = 0;
+  for (int y = 0; y < displaced.height(); ++y) {
+    for (int x = 0; x < displaced.width(); ++x) {
+      if (!filter_pass_layer_rect_.Contains(x, y) &&
+          untouched.getColor(x, y) != displaced.getColor(x, y)) {
+        ++outside_crop_difference_count;
+      }
+      const SkColor color = displaced.getColor(x, y);
+      if (color == SK_ColorBLACK) {
+        ++black_pixel_count;
+      }
+      if (SkColorGetA(color) == 0) {
+        ++transparent_pixel_count;
+      }
+    }
+  }
+  EXPECT_EQ(outside_crop_difference_count, 0);
+  EXPECT_EQ(black_pixel_count, 0);
+  EXPECT_EQ(transparent_pixel_count, 0);
+
+  const gfx::Point center = filter_pass_layer_rect_.CenterPoint();
+  const SkColor center_color = displaced.getColor(center.x(), center.y());
+  EXPECT_GT(SkColorGetA(center_color), 200);
+  EXPECT_NE(center_color, SK_ColorBLACK);
+
+  // The top-left sample is outside the rounded backdrop mask even though it
+  // lies inside the rectangular crop. It must remain the untouched backdrop.
+  const gfx::Point masked_corner(filter_pass_layer_rect_.x() + 1,
+                                 filter_pass_layer_rect_.y() + 1);
+  EXPECT_EQ(untouched.getColor(masked_corner.x(), masked_corner.y()),
+            displaced.getColor(masked_corner.x(), masked_corner.y()));
+}
