 // GetGpuRendererTypes() can return an empty list, e.g. on Fuchsia ARM64.
 GTEST_ALLOW_UNINSTANTIATED_PARAMETERIZED_TEST(GPURendererPixelTest);
 
+constexpr char kRefractionArtifactOutputSwitch[] =
+    "arcium-refraction-artifacts";
+
+class CaptureOnlyPixelComparator final : public cc::PixelComparator {
+ public:
+  bool Compare(const SkBitmap&, const SkBitmap&) const override { return true; }
+};
+
+const char* RendererTypeName(RendererType type) {
+  switch (type) {
+    case RendererType::kSkiaGL:
+      return "skia-gl";
+    case RendererType::kSkiaVk:
+      return "skia-vulkan";
+    case RendererType::kSkiaGraphiteDawn:
+      return "skia-graphite-dawn";
+    case RendererType::kSoftware:
+      return "software";
+  }
+}
+
+sk_sp<cc::PaintFilter> MakeSolidDisplacementMap(float scale,
+                                                 const gfx::Rect& bounds) {
+  const SkRect crop_rect = gfx::RectToSkRect(bounds);
+  auto displacement = sk_make_sp<cc::ShaderPaintFilter>(
+      cc::PaintShader::MakeColor(SkColor4f{0.75f, 0.625f, 0.5f, 1.0f}),
+      /*alpha=*/1.0f, cc::PaintFlags::FilterQuality::kNone,
+      cc::ShaderPaintFilter::Dither::kNo, &crop_rect);
+  return sk_make_sp<cc::DisplacementMapEffectPaintFilter>(
+      SkColorChannel::kR, SkColorChannel::kG, scale, std::move(displacement),
+      /*color=*/nullptr, &crop_rect);
+}
+
+struct PixelDifference {
+  int count = 0;
+  int max_channel_delta = 0;
+  gfx::Rect bounds;
+};
+
+PixelDifference CalculatePixelDifference(const SkBitmap& before,
+                                         const SkBitmap& after) {
+  DCHECK_EQ(before.width(), after.width());
+  DCHECK_EQ(before.height(), after.height());
+  PixelDifference difference;
+  for (int y = 0; y < before.height(); ++y) {
+    for (int x = 0; x < before.width(); ++x) {
+      const SkColor before_color = before.getColor(x, y);
+      const SkColor after_color = after.getColor(x, y);
+      if (before_color == after_color) {
+        continue;
+      }
+      ++difference.count;
+      difference.bounds.Union(gfx::Rect(x, y, 1, 1));
+      difference.max_channel_delta = std::max(
+          {difference.max_channel_delta,
+           std::abs(static_cast<int>(SkColorGetR(before_color)) -
+                    static_cast<int>(SkColorGetR(after_color))),
+           std::abs(static_cast<int>(SkColorGetG(before_color)) -
+                    static_cast<int>(SkColorGetG(after_color))),
+           std::abs(static_cast<int>(SkColorGetB(before_color)) -
+                    static_cast<int>(SkColorGetB(after_color))),
+           std::abs(static_cast<int>(SkColorGetA(before_color)) -
+                    static_cast<int>(SkColorGetA(after_color)))});
+    }
+  }
+  return difference;
+}
+
+bool BitmapsMatchExactly(const SkBitmap& before, const SkBitmap& after) {
+  return CalculatePixelDifference(before, after).count == 0;
+}
+
+void WriteRefractionArtifact(const SkBitmap& bitmap,
+                             RendererType renderer_type,
+                             const char* state) {
+  const base::FilePath output_dir =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+          kRefractionArtifactOutputSwitch);
+  if (output_dir.empty()) {
+    return;
+  }
+
+  const std::string filename = base::StringPrintf(
+      "renderer-refraction-%s-%s.png", RendererTypeName(renderer_type),
+      state);
+  EXPECT_TRUE(cc::WritePNGFile(bitmap, output_dir.AppendASCII(filename), false));
+}
