+IN_PROC_BROWSER_TEST_F(HeliumPersistentTabViewTest,
+                       ProjectedLivePinRemainsVisibleAfterUnpin) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/title1.html")));
+
+  tabs::TabInterface* pin_tab = tab_strip_model()->GetActiveTab();
+  ASSERT_TRUE(pin_tab);
+  content::WebContents* pin_contents = pin_tab->GetContents();
+
+  helium::HeliumSpaceService* service =
+      helium::HeliumSpaceServiceFactory::GetForProfile(
+          browser()->profile());
+  ASSERT_TRUE(service);
+  helium::HeliumSpace* space = service->GetDefaultSpace();
+  ASSERT_TRUE(space);
+  ASSERT_TRUE(service->ConvertTabToPinInSpace(
+      browser(), space->id(), pin_tab, /*parent_id=*/{}, /*before_id=*/{}));
+
+  // Sidebar projection hides the native Pin TabView while its virtual row is
+  // displayed. The test must observe that state before exercising removal.
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    TabCollectionNode* node = root_node()->GetNodeForHandle(
+        pin_tab->GetHandle());
+    TabView* view = node ? views::AsViewClass<TabView>(node->view()) : nullptr;
+    return view && !view->GetVisible();
+  }));
+
+  ASSERT_TRUE(service->RemovePersistentItem(pin_tab));
+  base::RunLoop().RunUntilIdle();
+
+  TabCollectionNode* ordinary_node =
+      unpinned_collection_node()->GetNodeForHandle(pin_tab->GetHandle());
+  ASSERT_TRUE(ordinary_node);
+  TabView* ordinary_view =
+      views::AsViewClass<TabView>(ordinary_node->view());
+  ASSERT_TRUE(ordinary_view);
+  EXPECT_TRUE(ordinary_view->GetVisible());
+  EXPECT_EQ(pin_tab, tab_strip_model()->GetActiveTab());
+  EXPECT_EQ(pin_contents, tab_strip_model()->GetActiveWebContents());
+}
+
+IN_PROC_BROWSER_TEST_F(HeliumPersistentTabViewTest,
+                       UnfavoriteRemovesRetiringFavoriteViews) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/title1.html")));
+
+  tabs::TabInterface* favorite_tab = tab_strip_model()->GetActiveTab();
+  ASSERT_TRUE(favorite_tab);
+  content::WebContents* favorite_contents = favorite_tab->GetContents();
+  helium::HeliumSpaceService* service =
+      helium::HeliumSpaceServiceFactory::GetForProfile(
+          browser()->profile());
+  ASSERT_TRUE(service);
+
+  auto* pinned_view = views::AsViewClass<PinnedTabContainerView>(
+      pinned_collection_node()->view());
+  ASSERT_TRUE(pinned_view);
+  ASSERT_TRUE(service->AddFavoriteFromTab(favorite_tab));
+
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    if (pinned_collection_node()->children().size() != 1u) {
+      return false;
+    }
+    for (views::View* child : pinned_view->children()) {
+      if (views::IsViewClass<PersistentTabView>(child)) {
+        return true;
+      }
+    }
+    return false;
+  }));
+
+  ASSERT_TRUE(service->RemovePersistentItem(favorite_tab));
+  base::RunLoop().RunUntilIdle();
+
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    bool has_pending_view = false;
+    for (views::View* child : pinned_view->children()) {
+      has_pending_view |=
+          TabCollectionAnimatingLayoutManager::IsPendingDeletion(*child);
+    }
+    return pinned_collection_node()->children().empty() &&
+           pinned_view->children().empty() && !has_pending_view;
+  }));
+
+  TabCollectionNode* ordinary_node =
+      unpinned_collection_node()->GetNodeForHandle(
+          favorite_tab->GetHandle());
+  ASSERT_TRUE(ordinary_node);
+  EXPECT_EQ(favorite_tab, tab_strip_model()->GetActiveTab());
+  EXPECT_EQ(favorite_contents, tab_strip_model()->GetActiveWebContents());
+}
