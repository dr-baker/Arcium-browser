+++ src/components/tabs/public/temporary_tab.h
@@ -0,0 +1,55 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_TABS_PUBLIC_TEMPORARY_TAB_H_
+#define COMPONENTS_TABS_PUBLIC_TEMPORARY_TAB_H_
+
+#include "base/callback_list.h"
+#include "base/functional/callback_forward.h"
+#include "base/memory/weak_ptr.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace content {
+class WebContents;
+}
+
+namespace tabs {
+
+// A browser-owned tab whose lifetime is temporary until explicitly promoted.
+// The tab remains a normal active model member with its normal website helpers.
+// Presentation and persistence consumers may omit it without changing model
+// indices or ownership. Create this marker before creating the tab's features.
+class TemporaryTab : public content::WebContentsUserData<TemporaryTab> {
+ public:
+  ~TemporaryTab() override;
+  TemporaryTab(const TemporaryTab&) = delete;
+  TemporaryTab& operator=(const TemporaryTab&) = delete;
+
+  static bool IsTemporary(const content::WebContents* contents);
+
+  // Returns the source to retain as the selected page in persisted snapshots.
+  content::WebContents* source_contents() const;
+  bool is_temporary() const { return is_temporary_; }
+
+  // Enrolls the same live tab in ordinary presentation and persistence.
+  // Promotion is one-way; callbacks run once after the state has changed.
+  void Promote();
+  base::CallbackListSubscription RegisterOnPromoted(
+      base::RepeatingClosure callback);
+
+ private:
+  friend class content::WebContentsUserData<TemporaryTab>;
+  TemporaryTab(content::WebContents* contents,
+               content::WebContents* source_contents);
+
+  bool is_temporary_ = true;
+  base::WeakPtr<content::WebContents> source_contents_;
+  base::RepeatingClosureList promoted_callbacks_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace tabs
+
+#endif  // COMPONENTS_TABS_PUBLIC_TEMPORARY_TAB_H_
