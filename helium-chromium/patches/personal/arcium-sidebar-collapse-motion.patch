+  if (!IsFullyHiddenSidebarStyleEnabled() ||
+      (motion != TabStripAnimations::kCollapse &&
+       motion != TabStripAnimations::kExpand)) {
+    return;
+  }
+
+  if (status == BrowserAnimationUpdate::kStarted) {
+    const double start_top = GetTopChromeRevealRatio();
+    const double start_width = *BrowserAnimationController::From(browser_)
+                                    ->GetCurrentValue(
+                                        TabStripAnimations::kVerticalTabStrip,
+                                        TabStripAnimations::kTabStripWidth);
+    zen_cursor_exit_timer_.Stop();
+    zen_top_chrome_animation_.Reset(start_top);
+    sidebar_chrome_transition_ = SidebarChromeTransition{
+        start_width, start_top,
+        motion == TabStripAnimations::kExpand ? 1.0 : 0.0};
