+void BrowserView::OnCollapsedSidebarAnimationUpdated(
+    BrowserAnimationUpdate status,
+    BrowserAnimationMotion motion) {
+  if (status == BrowserAnimationUpdate::kEnded ||
+      status == BrowserAnimationUpdate::kCanceled) {
+    // Hand the exact current reveal back to transient toolbar behavior before
+    // a possible reversal starts. Posted cleanup must not reset a new motion.
+    if (sidebar_chrome_transition_) {
+      const float reveal = GetTopChromeRevealRatio();
+      sidebar_chrome_transition_.reset();
+      zen_top_chrome_animation_.Reset(reveal);
+    }
