+       ClearsOnlyOrdinaryTabsInInvokingWindow) {
+  tabs::TabInterface* pin_tab =
+      AddTabTo(browser(), "https://pin.example.test/");
+  ASSERT_TRUE(pin_tab);
+  const std::optional<std::string> pin_id = service_->ConvertTabToPinInSpace(
+      browser(), space_->id(), pin_tab, /*parent_id=*/{}, /*before_id=*/{});
+  ASSERT_TRUE(pin_id);
+
+  tabs::TabInterface* favorite_tab =
+      AddTabTo(browser(), "https://favorite.example.test/");
+  ASSERT_TRUE(favorite_tab);
+  ASSERT_TRUE(service_->AddFavoriteFromTab(favorite_tab));
+
+  tabs::TabInterface* ordinary_tab =
+      AddTabTo(browser(), "https://ordinary.example.test/");
+  ASSERT_TRUE(ordinary_tab);
+  const tabs::TabHandle pin_handle = pin_tab->GetHandle();
+  const tabs::TabHandle favorite_handle = favorite_tab->GetHandle();
+  const tabs::TabHandle ordinary_handle = ordinary_tab->GetHandle();
+
+  helium::HeliumSpace* other_space =
+      service_->GetOrCreateSpace("other-space", u"Other Space");
+  ASSERT_TRUE(other_space);
+  std::unique_ptr<Browser> other_browser =
+      CreateBrowser(profile(), Browser::TYPE_NORMAL, /*hosted_app=*/false);
+  ASSERT_TRUE(other_browser);
+  service_->SetSpaceForBrowser(other_browser.get(), other_space->id());
+  tabs::TabInterface* other_tab =
+      AddTabTo(other_browser.get(), "https://other.example.test/");
+  ASSERT_TRUE(other_tab);
+  const tabs::TabHandle other_handle = other_tab->GetHandle();
+
+  EXPECT_TRUE(ClearUnpinnedTabs(browser()));
+  EXPECT_EQ(nullptr, ordinary_handle.Get());
+  EXPECT_NE(nullptr, pin_handle.Get());
+  EXPECT_NE(nullptr, favorite_handle.Get());
+  EXPECT_NE(nullptr, other_handle.Get());
+  EXPECT_NE(TabStripModel::kNoTab,
+            browser()->tab_strip_model()->GetIndexOfTab(pin_handle.Get()));
+  EXPECT_NE(
+      TabStripModel::kNoTab,
+      browser()->tab_strip_model()->GetIndexOfTab(favorite_handle.Get()));
+  EXPECT_NE(TabStripModel::kNoTab,
+            other_browser->tab_strip_model()->GetIndexOfTab(other_handle.Get()));
+}
