+bool BrowserShortcutService::CanModifyConfiguration() const {
+  return prefs_->IsUserModifiablePreference(prefs::kCustomAccelerators) &&
+         prefs_->IsUserModifiablePreference(prefs::kArcShortcutBackup);
+}
+
+ConfigurationResult BrowserShortcutService::RestorePreviousConfiguration() {
+  if (!CanModifyConfiguration()) {
+    return ConfigurationResult::kPreferencesLocked;
+  }
+
+  const base::DictValue& backup = prefs_->GetDict(prefs::kArcShortcutBackup);
+  if (backup.FindInt(kBackupVersionKey) != kBackupVersion) {
+    return ConfigurationResult::kNoPreviousConfiguration;
+  }
+  const base::DictValue* saved_configuration =
+      backup.FindDict(kBackupConfigurationKey);
+  if (!saved_configuration) {
+    return ConfigurationResult::kNoPreviousConfiguration;
+  }
+
+  const CommandAccelerators previous = current_;
+  prefs_->SetDict(prefs::kCustomAccelerators, saved_configuration->Clone());
+  LoadFromPrefs();
+  prefs_->ClearPref(prefs::kArcShortcutBackup);
+  RebuildCommandCache();
+  // Consuming the marker changes restore availability even when the saved
+  // bindings already match the current preference.
+  NotifyChanged();
+  return current_ == previous ? ConfigurationResult::kNoChange
+                              : ConfigurationResult::kSuccess;
+}
