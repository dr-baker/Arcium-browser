+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/browser_shortcuts/arcium_shortcut_commands.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <iterator>
+#include <optional>
+#include <string_view>
+#include <vector>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/helium/helium_favorites_and_pins.h"
+#include "chrome/browser/ui/helium/helium_space.h"
+#include "chrome/browser/ui/helium/helium_space_service.h"
+#include "chrome/browser/ui/helium/helium_space_service_factory.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/tabs/public/tab_interface.h"
+
+namespace browser_shortcuts::arcium {
+
+namespace {
+
+bool IsNormalBrowser(Browser* browser) {
+  return browser && browser->is_type_normal() && browser->profile();
+}
+
+bool IsEligiblePersistentBrowser(Browser* browser) {
+  if (!IsNormalBrowser(browser)) {
+    return false;
+  }
+  Profile* const profile = browser->profile();
+  return !profile->IsOffTheRecord() && !profile->IsGuestSession();
+}
+
+bool SelectTab(Browser* browser,
+               bool next,
+               bool recent,
+               TabStripUserGestureDetails detail) {
+  if (!IsNormalBrowser(browser)) {
+    return false;
+  }
+  TabStripModel* const model = browser->tab_strip_model();
+  if (!model || model->count() < 2 ||
+      model->active_index() == TabStripModel::kNoTab) {
+    return false;
+  }
+
+  const int old_index = model->active_index();
+  const TabStripModel::TabRelativeDirection direction =
+      next ? TabStripModel::TabRelativeDirection::kNext
+           : TabStripModel::TabRelativeDirection::kPrevious;
+  if (recent) {
+    model->SelectRecentTab(direction, detail);
+  } else {
+    model->SelectSequentialTab(direction, detail);
+  }
+  return model->active_index() != old_index;
+}
+
+bool ActivateSpace(Browser* browser, helium::HeliumSpace* space) {
+  return IsEligiblePersistentBrowser(browser) && space &&
+         space->ActivateOrCreatePrimaryWindow() != nullptr;
+}
+
+}  // namespace
+
+bool ToggleCurrentSpacePin(Browser* browser) {
+  if (!IsEligiblePersistentBrowser(browser) ||
+      !helium::IsHeliumFavoritesAndPinsEnabled()) {
+    return false;
+  }
+
+  TabStripModel* const model = browser->tab_strip_model();
+  tabs::TabInterface* const tab = model ? model->GetActiveTab() : nullptr;
+  if (!tab) {
+    return false;
+  }
+
+  helium::HeliumSpaceService* const service =
+      helium::HeliumSpaceServiceFactory::GetForProfile(browser->profile());
+  if (!service) {
+    return false;
+  }
+
+  const std::optional<helium::PersistentRecordKind> kind =
+      service->GetPersistentItemKind(tab);
+  if (kind.has_value()) {
+    // The Arc pin shortcut has no Favorite equivalent. In particular, never
+    // route a Favorite through RemovePersistentItem or the context-menu
+    // toggle, which would change a different persistent collection.
+    return *kind == helium::PersistentRecordKind::kPin &&
+           service->RemovePersistentItem(tab);
+  }
+
+  return helium::MakePin(tab);
+}
+
+bool SelectSpace(Browser* browser, size_t index) {
+  if (!IsEligiblePersistentBrowser(browser)) {
+    return false;
+  }
+
+  helium::HeliumSpaceService* const service =
+      helium::HeliumSpaceServiceFactory::GetForProfile(browser->profile());
+  if (!service) {
+    return false;
+  }
+  const std::vector<helium::HeliumSpace*> spaces = service->GetSpaces();
+  if (index >= spaces.size()) {
+    return false;
+  }
+  const std::optional<size_t> arc_index =
+      SpaceIndexForArcOrdinal(index + 1, spaces.size());
+  return arc_index.has_value() && ActivateSpace(browser, spaces[*arc_index]);
+}
+
+bool SelectRelativeSpace(Browser* browser, bool next) {
+  if (!IsEligiblePersistentBrowser(browser)) {
+    return false;
+  }
+
+  helium::HeliumSpaceService* const service =
+      helium::HeliumSpaceServiceFactory::GetForProfile(browser->profile());
+  if (!service) {
+    return false;
+  }
+  const std::vector<helium::HeliumSpace*> spaces = service->GetSpaces();
+  if (spaces.empty()) {
+    return false;
+  }
+
+  const std::string_view current_id = service->GetSpaceIdForBrowser(browser);
+  const auto current = std::find_if(
+      spaces.begin(), spaces.end(),
+      [current_id](const helium::HeliumSpace* space) {
+        return space && space->id() == current_id;
+      });
+  if (current == spaces.end()) {
+    return false;
+  }
+
+  const size_t current_index =
+      static_cast<size_t>(std::distance(spaces.begin(), current));
+  const size_t count = spaces.size();
+  const size_t target_index =
+      next ? (current_index + 1) % count
+           : (current_index + count - 1) % count;
+  return ActivateSpace(browser, spaces[target_index]);
+}
+
+bool SelectSequentialTab(Browser* browser,
+                         bool next,
+                         TabStripUserGestureDetails detail) {
+  return SelectTab(browser, next, /*recent=*/false, detail);
+}
+
+bool SelectRecentTab(Browser* browser,
+                     bool next,
+                     TabStripUserGestureDetails detail) {
+  return SelectTab(browser, next, /*recent=*/true, detail);
+}
+
+}  // namespace browser_shortcuts::arcium
