+ConfigurationResult BrowserShortcutService::ApplyConfiguration(
+    const std::vector<CommandAcceleratorConfiguration>& configuration) {
+  if (!CanModifyConfiguration()) {
+    return ConfigurationResult::kPreferencesLocked;
+  }
+
+  std::set<int> configured_commands;
+  std::map<ui::Accelerator, int> requested_accelerators;
+  std::vector<std::pair<int, AcceleratorEntry>> parsed_entries;
+
+  // Parse and validate the entire request before touching `current_` or any
+  // preference. Existing user-modifiable conflicts are deliberately resolved
+  // below, but locked owners and duplicate requested bindings are rejected.
+  for (const CommandAcceleratorConfiguration& command : configuration) {
+    if (!HasCommand(command.command_id)) {
+      return ConfigurationResult::kUnknownCommand;
+    }
+    if (!configured_commands.insert(command.command_id).second) {
+      return ConfigurationResult::kInvalidConfiguration;
+    }
+
+    for (const std::string& serialized : command.accelerators) {
+      std::optional<AcceleratorEntry> entry = EntryFromString(serialized, true);
+      if (!entry) {
+        return ConfigurationResult::kInvalidAccelerator;
+      }
+      const auto [it, inserted] = requested_accelerators.emplace(
+          entry->accelerator, command.command_id);
+      if (!inserted) {
+        return ConfigurationResult::kAcceleratorConflict;
+      }
+      if (IsAcceleratorLocked(entry->accelerator, command.command_id)) {
+        return ConfigurationResult::kShortcutLocked;
+      }
+      parsed_entries.emplace_back(command.command_id, std::move(*entry));
+    }
+  }
+
+  CommandAccelerators candidate = current_;
+  for (const CommandAcceleratorConfiguration& command : configuration) {
+    auto it = candidate.find(command.command_id);
+    DCHECK(it != candidate.end());
+    std::erase_if(it->second, [](const AcceleratorEntry& entry) {
+      return entry.user_modifiable;
+    });
+  }
+
+  for (const auto& [command_id, entry] : parsed_entries) {
+    if (IsAcceleratorLocked(candidate, entry.accelerator, command_id)) {
+      return ConfigurationResult::kShortcutLocked;
+    }
+    RemoveConflictingAccelerators(candidate, entry.accelerator, command_id);
+    InsertEntrySorted(candidate[command_id], entry);
+  }
+
+  if (candidate == current_) {
+    return ConfigurationResult::kNoChange;
+  }
+
+  if (!HasPreviousConfiguration()) {
+    base::DictValue backup;
+    backup.Set(kBackupVersionKey, kBackupVersion);
+    backup.Set(kBackupConfigurationKey,
+               prefs_->GetDict(prefs::kCustomAccelerators).Clone());
+    prefs_->SetDict(prefs::kArcShortcutBackup, std::move(backup));
+  }
+
+  current_ = std::move(candidate);
+  PersistToPrefs();
+  RebuildCommandCache();
+  NotifyChanged();
+  return ConfigurationResult::kSuccess;
+}
