+TEST_F(MRUTabCyclingTest, ExplicitSequentialSelectionIgnoresMRUPreference) {
+  // The active tab starts at index 2. MRU ordering would select index 1,
+  // while the explicit sequential command must wrap to index 0.
+  tabstrip()->SelectSequentialTab(
+      TabStripModel::TabRelativeDirection::kNext);
+  EXPECT_EQ(0, tabstrip()->active_index());
+
+  tabstrip()->SelectSequentialTab(
+      TabStripModel::TabRelativeDirection::kPrevious);
+  EXPECT_EQ(2, tabstrip()->active_index());
+}
