+  std::optional<int> optional_command_id;
+  if (command_id != 0) {
+    optional_command_id = command_id;
+  }
+  return {action_id,
+          action_name,
+          optional_command_id,
+          accelerator, CommandName(service, command_id), std::move(reason)};
+}
+
+std::string SupportedShortcutReason(const ShortcutDefinition& definition,
+                                    const BrowserShortcutService& service) {
+  if (!service.HasCommand(definition.command_id)) {
+    return "This browser action is not available in the current build.";
+  }
+  if (!IsValidAcceleratorString(definition.accelerator)) {
+    return "Preset accelerator is invalid.";
+  }
+  if (definition.command_id == IDC_ARCIUM_TOGGLE_SPACE_PIN &&
+      !helium::IsHeliumFavoritesAndPinsEnabled()) {
+    return "Space Pins are disabled in the current build.";
+  }
+  const PrefService* prefs = service.GetPrefs();
+  if (definition.command_id == IDC_TOGGLE_VERTICAL_TABS_COLLAPSE &&
+      (!prefs ||
+       prefs->GetInteger(::prefs::kHeliumLayout) !=
+           std::to_underlying(HeliumLayoutType::kVertical))) {
+    return "Sidebar visibility is unavailable in the current layout.";
+  }
+  if (service.IsAcceleratorLocked(definition.accelerator,
+                                  definition.command_id)) {
+    return "This shortcut is reserved by the browser.";
+  }
+  return std::string();
+}
+
+PresetResult ToPresetResult(ConfigurationResult result) {
+  switch (result) {
+    case ConfigurationResult::kSuccess:
+      return PresetResult::kApplied;
+    case ConfigurationResult::kNoChange:
+      return PresetResult::kNoChange;
+    case ConfigurationResult::kUnknownCommand:
+      return PresetResult::kUnknownCommand;
+    case ConfigurationResult::kInvalidAccelerator:
+      return PresetResult::kInvalidAccelerator;
+    case ConfigurationResult::kInvalidConfiguration:
+      return PresetResult::kInvalidConfiguration;
+    case ConfigurationResult::kShortcutLocked:
+      return PresetResult::kShortcutLocked;
+    case ConfigurationResult::kAcceleratorConflict:
+      return PresetResult::kAcceleratorConflict;
+    case ConfigurationResult::kPreferencesLocked:
+      return PresetResult::kPreferencesLocked;
+    case ConfigurationResult::kNoPreviousConfiguration:
+      return PresetResult::kNoPreviousConfiguration;
+  }
+}
+
+}  // namespace
+
+PresetReport GetArcShortcutPresetReport(const BrowserShortcutService& service) {
+  PresetReport report;
+  for (const ShortcutDefinition& definition : kSupportedShortcuts) {
+    bool uses_platform_binding = false;
+#if BUILDFLAG(IS_MAC)
+    if (definition.command_id == IDC_CLOSE_TAB) {
+      uses_platform_binding = IsPlatformDynamicCloseAccelerator(
+          ui::Accelerator(ui::VKEY_W, ui::EF_COMMAND_DOWN));
+    }
+#endif
+    std::string reason = uses_platform_binding
+                             ? std::string()
+                             : SupportedShortcutReason(definition, service);
+    CommandReport entry = MakeReport(
+        definition.action_id, definition.action_name, definition.command_id,
+        definition.accelerator, service, std::move(reason));
+    entry.uses_platform_binding = uses_platform_binding;
+    if (entry.reason.empty()) {
+      report.supported.push_back(std::move(entry));
+    } else {
+      report.unavailable.push_back(std::move(entry));
+    }
+  }
+
+  for (const UnavailableDefinition& definition : kUnavailableShortcuts) {
+    report.unavailable.push_back(MakeReport(
+        definition.action_id, definition.action_name, definition.command_id,
+        definition.accelerator, service, definition.reason));
+  }
+  return report;
+}
+
+PresetResult ApplyArcShortcutPreset(BrowserShortcutService* service) {
+  const PresetReport report = GetArcShortcutPresetReport(*service);
+  std::map<int, std::vector<std::string>> accelerators_by_command;
+  for (const CommandReport& entry : report.supported) {
+    if (entry.uses_platform_binding) {
+      continue;
+    }
+    DCHECK(entry.command_id.has_value());
+    accelerators_by_command[*entry.command_id].push_back(entry.accelerator);
+  }
+  if (accelerators_by_command.empty()) {
+    return PresetResult::kNoSupportedCommands;
+  }
+
+  std::vector<CommandAcceleratorConfiguration> configuration;
+  configuration.reserve(accelerators_by_command.size());
+  for (auto& [command_id, accelerators] : accelerators_by_command) {
+    configuration.push_back(
+        {command_id, std::move(accelerators)});
+  }
+  return ToPresetResult(service->ApplyConfiguration(configuration));
+}
+
+bool CanModifyArcShortcutConfiguration(const BrowserShortcutService& service) {
+  return service.CanModifyConfiguration();
+}
+
+bool HasPreviousArcShortcutConfiguration(
+    const BrowserShortcutService& service) {
+  return service.HasPreviousConfiguration();
+}
+
+PresetResult RestorePreviousArcShortcutConfiguration(
+    BrowserShortcutService* service) {
+  return ToPresetResult(service->RestorePreviousConfiguration());
+}
+
