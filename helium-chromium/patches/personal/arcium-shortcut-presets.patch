+TEST(BrowserShortcutPlatformMacTest, PresetPreservesNativeDynamicClose) {
+  ASSERT_NE(NSApp, nil);
+  for (bool has_tabs : {false, true}) {
+    ScopedMainMenu menu(MainMenuWithCloseShortcuts(has_tabs));
+    TestingPrefServiceSimple preferences;
+    auto* registry = preferences.registry();
+    registry->RegisterDictionaryPref(prefs::kCustomAccelerators);
+    registry->RegisterDictionaryPref(prefs::kArcShortcutBackup);
+    registry->RegisterBooleanPref(::prefs::kCopyPageUrlShortcut, false);
+    registry->RegisterBooleanPref(::prefs::kVerticalCollapseShortcut, false);
+    registry->RegisterBooleanPref(::prefs::kTabCyclingMRU, false);
+    registry->RegisterBooleanPref(::prefs::kCtrlTabMru, false);
+    registry->RegisterIntegerPref(::prefs::kHeliumLayout, 0);
+    BrowserShortcutService service(&preferences);
+    const auto report = arcium::GetArcShortcutPresetReport(service);
+    bool found_native_close = false;
+    for (const auto& entry : report.supported) {
+      if (entry.action_id == "close_current_tab_or_window") {
+        found_native_close = true;
+        EXPECT_TRUE(entry.uses_platform_binding);
+      }
+    }
+    EXPECT_TRUE(found_native_close);
+    EXPECT_EQ(arcium::ApplyArcShortcutPreset(&service),
+              arcium::PresetResult::kApplied);
+    EXPECT_FALSE(preferences.GetDict(prefs::kCustomAccelerators).contains(
+        base::NumberToString(IDC_CLOSE_TAB)));
+    EXPECT_TRUE(IsPlatformDynamicCloseAccelerator(
+        ui::Accelerator(ui::VKEY_W, ui::EF_COMMAND_DOWN)));
+  }
+}
