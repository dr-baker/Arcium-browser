+void RegisterPrefs(TestingPrefServiceSimple* pref_service) {
+  pref_service->registry()->RegisterDictionaryPref(
+      prefs::kCustomAccelerators);
+  pref_service->registry()->RegisterDictionaryPref(prefs::kArcShortcutBackup);
+  pref_service->registry()->RegisterBooleanPref(::prefs::kCopyPageUrlShortcut,
+                                                true);
+  pref_service->registry()->RegisterBooleanPref(
+      ::prefs::kVerticalCollapseShortcut, true);
+  pref_service->registry()->RegisterBooleanPref(::prefs::kTabCyclingMRU,
+                                                false);
+  pref_service->registry()->RegisterBooleanPref(::prefs::kCtrlTabMru, false);
+  pref_service->registry()->RegisterIntegerPref(::prefs::kHeliumLayout, 0);
+}
+
+void UseVerticalSidebar(TestingPrefServiceSimple* pref_service) {
+  pref_service->SetInteger(
+      ::prefs::kHeliumLayout,
+      std::to_underlying(HeliumLayoutType::kVertical));
+}
