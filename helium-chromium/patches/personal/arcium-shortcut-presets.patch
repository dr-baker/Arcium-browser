+class ScopedMainMenu {
+ public:
+  explicit ScopedMainMenu(NSMenu* replacement)
+      : original_([NSApp mainMenu]) {
+    [NSApp setMainMenu:replacement];
+  }
+
+  ScopedMainMenu(const ScopedMainMenu&) = delete;
+  ScopedMainMenu& operator=(const ScopedMainMenu&) = delete;
+
+  ~ScopedMainMenu() { [NSApp setMainMenu:original_]; }
+
+ private:
+  NSMenu* __strong original_;
+};
