+bool IsPlatformDefaultUserModifiable(int command_id,
+                                     const ui::Accelerator& accelerator) {
+  // Keep the legacy Ctrl+S dispatcher independently assignable for the
+  // dedicated Save Page command.
+  if (command_id == IDC_CTRL_S_SHORTCUT) {
+    return true;
+  }
+
+  // These exact legacy defaults are displaced by Arcium commands. Other
+  // defaults owned by the same commands remain reserved, including any
+  // AppKit-customized menu accelerator discovered above.
+  switch (command_id) {
+    case IDC_COPY_OR_INSPECT_SHORTCUT:
+      return accelerator ==
+             ui::Accelerator(ui::VKEY_C,
+                             ui::EF_COMMAND_DOWN | ui::EF_SHIFT_DOWN);
+    case IDC_SELECT_NEXT_TAB:
+      return accelerator ==
+                 ui::Accelerator(ui::VKEY_TAB, ui::EF_CONTROL_DOWN) ||
+             accelerator == ui::Accelerator(
+                                ui::VKEY_RIGHT,
+                                ui::EF_COMMAND_DOWN | ui::EF_ALT_DOWN);
+    case IDC_SELECT_PREVIOUS_TAB:
+      return accelerator ==
+                 ui::Accelerator(ui::VKEY_TAB,
+                                 ui::EF_CONTROL_DOWN | ui::EF_SHIFT_DOWN) ||
+             accelerator == ui::Accelerator(
+                                ui::VKEY_LEFT,
+                                ui::EF_COMMAND_DOWN | ui::EF_ALT_DOWN);
+    case IDC_FOCUS_NEXT_PANE:
+      return accelerator == ui::Accelerator(
+                                ui::VKEY_DOWN,
+                                ui::EF_COMMAND_DOWN | ui::EF_ALT_DOWN);
+    case IDC_FOCUS_PREVIOUS_PANE:
+      return accelerator == ui::Accelerator(
+                                ui::VKEY_UP,
+                                ui::EF_COMMAND_DOWN | ui::EF_ALT_DOWN);
+    case IDC_SELECT_LAST_TAB:
+      return accelerator ==
+             ui::Accelerator(ui::VKEY_9, ui::EF_COMMAND_DOWN);
+    default:
+      return false;
+  }
+}
