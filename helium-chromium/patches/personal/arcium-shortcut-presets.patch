+#ifndef CHROME_BROWSER_UI_BROWSER_SHORTCUTS_ARCIUM_SHORTCUT_COMMANDS_H_
+#define CHROME_BROWSER_UI_BROWSER_SHORTCUTS_ARCIUM_SHORTCUT_COMMANDS_H_
+
+#include <cstddef>
+#include <optional>
+
+#include "chrome/browser/ui/tabs/tab_strip_user_gesture_details.h"
+
+class Browser;
+
+namespace browser_shortcuts::arcium {
+
+// Returns the zero-based Space index represented by an Arc Space ordinal. Arc
+// exposes only the first nine Spaces through numbered shortcuts.
+constexpr std::optional<size_t> SpaceIndexForArcOrdinal(size_t ordinal,
+                                                        size_t space_count) {
+  return ordinal == 0 || ordinal > 9 || ordinal > space_count
+             ? std::nullopt
+             : std::optional<size_t>(ordinal - 1);
+}
+
+// Toggles the active tab's durable Space Pin. Favorites, ordinary Chromium
+// pinned tabs, and ineligible tab contexts are left unchanged.
+bool ToggleCurrentSpacePin(Browser* browser);
+
+// Activates a Space by its zero-based profile index, creating its primary
+// normal window when it does not already have one. Only Arc's first nine
+// Spaces are addressable through numbered shortcuts.
+bool SelectSpace(Browser* browser, size_t index);
+
+// Activates the adjacent Space in the ordered profile Space list. `next`
+// selects the next Space when true and the previous Space otherwise; the list
+// wraps at either end.
+bool SelectRelativeSpace(Browser* browser, bool next);
+
+// Selects tabs through TabStripModel's group-aware sequential or MRU APIs.
+// These return false when the browser is ineligible or has fewer than two tabs.
+bool SelectSequentialTab(
+    Browser* browser,
+    bool next,
+    TabStripUserGestureDetails detail = TabStripUserGestureDetails(
+        TabStripUserGestureDetails::GestureType::kKeyboard));
+bool SelectRecentTab(
+    Browser* browser,
+    bool next,
+    TabStripUserGestureDetails detail = TabStripUserGestureDetails(
+        TabStripUserGestureDetails::GestureType::kKeyboard));
+
+}  // namespace browser_shortcuts::arcium
+
+#endif  // CHROME_BROWSER_UI_BROWSER_SHORTCUTS_ARCIUM_SHORTCUT_COMMANDS_H_
