+std::u16string EscapeMarkdownLinkText(std::u16string_view text) {
+  std::u16string escaped;
+  escaped.reserve(text.size());
+  for (char16_t character : text) {
+    switch (character) {
+      case u'\\':
+      case u'[':
+      case u']':
+      case u'*':
+      case u'_':
+      case u'`':
+      case u'&':
+      case u'~':
+      case u'<':
+      case u'>':
+        escaped.push_back(u'\\');
+        break;
+      case u'\r':
+      case u'\n':
+        escaped.push_back(u' ');
+        continue;
+      default:
+        break;
+    }
+    escaped.push_back(character);
+  }
+  return escaped;
+}
+
+std::u16string EscapeMarkdownDestination(std::u16string_view destination) {
+  std::u16string escaped;
+  escaped.reserve(destination.size());
+  for (char16_t character : destination) {
+    switch (character) {
+      case u'\\':
+      case u'<':
+      case u'>':
+        escaped.push_back(u'\\');
+        break;
+      case u'\r':
+      case u'\n':
+        escaped.push_back(u' ');
+        continue;
+      default:
+        break;
+    }
+    escaped.push_back(character);
+  }
+  return escaped;
+}
+
+Browser* GetBrowser(BrowserWindowInterface* browser_window) {
+  return browser_window ? browser_window->GetBrowserForMigrationOnly()
+                        : nullptr;
+}
+
+}  // namespace
+
+bool ClearUnpinnedTabs(BrowserWindowInterface* browser_window) {
+  if (!browser_window ||
+      browser_window->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return false;
+  }
+  Browser* browser = GetBrowser(browser_window);
+  TabStripModel* model = browser ? browser->tab_strip_model() : nullptr;
+  if (!model) {
+    return false;
+  }
+
+  std::vector<tabs::TabHandle> tabs_to_close;
+  tabs_to_close.reserve(model->count());
+  helium::HeliumSpaceService* space_service =
+      helium::HeliumSpaceServiceFactory::GetForProfile(browser->profile());
+  // Capture the invoking window's effective Space before any close can run
+  // synchronous lifecycle callbacks that change its association.
+  const bool has_space_service = space_service != nullptr;
+  const std::string effective_space_id =
+      space_service
+          ? std::string(space_service->GetSpaceIdForBrowser(browser))
+          : std::string();
+  for (int index = 0; index < model->count(); ++index) {
+    tabs::TabInterface* tab = model->GetTabAtIndex(index);
+    if (!tab || tab->IsPinned() ||
+        (space_service && space_service->IsPersistentItemTab(tab))) {
+      continue;
+    }
+    tabs_to_close.push_back(tab->GetHandle());
+  }
+  if (tabs_to_close.empty()) {
+    return false;
+  }
+
+  base::WeakPtr<BrowserWindowInterface> browser_weak =
+      browser_window->GetWeakPtr();
+  bool closed_any = false;
+  for (const tabs::TabHandle& tab_handle : tabs_to_close) {
+    BrowserWindowInterface* current_window = browser_weak.get();
+    Browser* current_browser = GetBrowser(current_window);
+    TabStripModel* current_model =
+        current_browser ? current_browser->tab_strip_model() : nullptr;
+    if (!current_window || !current_browser || !current_model) {
+      break;
+    }
+    space_service = helium::HeliumSpaceServiceFactory::GetForProfile(
+        current_browser->profile());
+    if (has_space_service &&
+        (!space_service ||
+         space_service->GetSpaceIdForBrowser(current_browser) !=
+             effective_space_id)) {
+      break;
+    }
+    tabs::TabInterface* tab = tab_handle.Get();
+    BrowserWindowInterface* tab_window =
+        tab ? tab->GetBrowserWindowInterface() : nullptr;
+    if (!tab || tab_window != current_window ||
+        tab_window->GetBrowserForMigrationOnly() != current_browser ||
+        tab->IsPinned() ||
+        (space_service && space_service->IsPersistentItemTab(tab))) {
+      continue;
+    }
+    const int index = current_model->GetIndexOfTab(tab);
+    if (index == TabStripModel::kNoTab) {
+      continue;
+    }
+    current_model->CloseWebContentsAt(
+        index, TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+    closed_any = true;
+  }
+  return closed_any;
+}
+
+std::u16string FormatTabMarkdownLink(std::u16string_view title,
+                                     const GURL& canonical_url) {
+  const std::u16string canonical_url_text =
+      base::UTF8ToUTF16(canonical_url.spec());
+  std::u16string literal_title(title);
+  if (literal_title.empty()) {
+    literal_title = canonical_url_text;
+  }
+
+  std::u16string markdown;
+  markdown.reserve(literal_title.size() + canonical_url_text.size() + 5);
+  markdown.push_back(u'[');
+  markdown.append(EscapeMarkdownLinkText(literal_title));
+  // An angle-bracket destination accepts parentheses and percent-encoded
+  // spaces without interpreting them as Markdown delimiters. GURL::spec()
+  // keeps the canonical URL's percent escapes intact; only Markdown delimiter
+  // characters are escaped below.
+  markdown.append(u"](<");
+  markdown.append(EscapeMarkdownDestination(canonical_url_text));
+  markdown.append(u">)");
+  return markdown;
+}
+
+bool CopyCurrentTabURLAsMarkdown(BrowserWindowInterface* browser_window) {
+  Browser* browser = GetBrowser(browser_window);
+  content::WebContents* web_contents =
+      browser ? browser->tab_strip_model()->GetActiveWebContents() : nullptr;
+  if (!browser || !web_contents || !web_contents->GetVisibleURL().is_valid()) {
+    return false;
+  }
+
+  const std::u16string markdown =
+      FormatTabMarkdownLink(web_contents->GetTitle(),
+                            web_contents->GetVisibleURL());
+  ui::ScopedClipboardWriter clipboard_writer(ui::ClipboardBuffer::kCopyPaste);
+  clipboard_writer.WriteText(markdown);
+  return true;
+}
+
+bool CloseSplitView(BrowserWindowInterface* browser_window) {
+  Browser* browser = GetBrowser(browser_window);
+  TabStripModel* model = browser ? browser->tab_strip_model() : nullptr;
+  tabs::TabInterface* active_tab = model ? model->GetActiveTab() : nullptr;
+  if (!model || !active_tab) {
+    return false;
+  }
+
+  const std::optional<split_tabs::SplitTabId> split_id =
+      active_tab->GetSplit();
+  if (!split_id.has_value()) {
+    return false;
+  }
+  model->RemoveSplit(*split_id);
+  return true;
+}
+
+bool FocusSplitViewPane(BrowserWindowInterface* browser_window,
+                        int pane_index,
+                        TabStripUserGestureDetails user_gesture) {
+  Browser* browser = GetBrowser(browser_window);
+  TabStripModel* model = browser ? browser->tab_strip_model() : nullptr;
+  tabs::TabInterface* active_tab = model ? model->GetActiveTab() : nullptr;
+  if (!model || !active_tab || pane_index < 0) {
+    return false;
+  }
+
+  const std::optional<split_tabs::SplitTabId> split_id =
+      active_tab->GetSplit();
+  if (!split_id.has_value()) {
+    return false;
+  }
+  split_tabs::SplitTabData* split_data = model->GetSplitData(*split_id);
+  if (!split_data) {
+    return false;
+  }
+  const std::vector<tabs::TabInterface*> split_tabs = split_data->ListTabs();
+  if (split_tabs.size() < 2) {
+    return false;
+  }
+  if (pane_index >= static_cast<int>(split_tabs.size())) {
+    return false;
+  }
+  tabs::TabInterface* target_tab = split_tabs[pane_index];
+  const int target_index = model->GetIndexOfTab(target_tab);
+  if (target_index == TabStripModel::kNoTab) {
+    return false;
+  }
+  model->ActivateTabAt(target_index, user_gesture);
+  target_tab->GetContents()->Focus();
+  return true;
+}
+
+bool SelectNinthVisibleTab(BrowserWindowInterface* browser_window,
+                           TabStripUserGestureDetails user_gesture) {
+  Browser* browser = GetBrowser(browser_window);
+  TabStripModel* model = browser ? browser->tab_strip_model() : nullptr;
+  if (!model) {
+    return false;
+  }
+
+  int visible_count = 0;
+  for (int index = 0; index < model->count(); ++index) {
+    if (model->IsTabCollapsed(index)) {
+      continue;
+    }
+    if (visible_count++ == 8) {
+      model->ActivateTabAt(index, user_gesture);
+      return true;
+    }
+  }
+  return false;
+}
