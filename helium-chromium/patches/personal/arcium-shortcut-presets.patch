+  // The explicit recent command still follows the recency order and selects
+  // index 1 from the fixture's active index 2.
+  tabstrip()->SelectRecentTab(TabStripModel::TabRelativeDirection::kNext);
+  EXPECT_EQ(1, tabstrip()->active_index());
