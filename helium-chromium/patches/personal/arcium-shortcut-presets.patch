+
+  const ui::Accelerator unrelated_select_next_tab(
+      ui::VKEY_OEM_6, ui::EF_COMMAND_DOWN | ui::EF_SHIFT_DOWN);
+  bool found_unrelated = false;
+  for (const BrowserShortcutPlatformDefaultAccelerator& entry : defaults) {
+    if (entry.command_id != IDC_SELECT_NEXT_TAB ||
+        entry.accelerator != unrelated_select_next_tab) {
+      continue;
+    }
+    found_unrelated = true;
+    EXPECT_FALSE(entry.user_modifiable);
+  }
+  EXPECT_TRUE(found_unrelated);
+}
