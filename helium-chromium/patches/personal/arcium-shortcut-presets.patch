+TEST(ArciumShortcutPresetsTest,
+     AppliesSupportedSubsetAndRestoresNonEmptyConfiguration) {
+  TestingPrefServiceSimple pref_service;
+  RegisterPrefs(&pref_service);
+
+  // Keep one unrelated custom binding and deliberately unassign Ctrl+Tab so
+  // restore proves that the full profile dictionary and effective map return.
+  base::ListValue added;
+  added.Append("Control+Alt+KeyT");
+  base::ListValue removed;
+  removed.Append("Control+Tab");
+  base::DictValue initial;
+  initial.Set(base::NumberToString(IDC_NEW_TAB),
+              base::DictValue().Set("added", std::move(added)));
+  initial.Set(base::NumberToString(IDC_SELECT_NEXT_TAB),
+              base::DictValue().Set("removed", std::move(removed)));
+  pref_service.SetDict(prefs::kCustomAccelerators, initial.Clone());
+
+  BrowserShortcutService service(&pref_service);
+  const base::DictValue before_preferences =
+      pref_service.GetDict(prefs::kCustomAccelerators).Clone();
+  const auto before_accelerators = service.GetAcceleratorMap();
+
+  EXPECT_EQ(ApplyArcShortcutPreset(&service), PresetResult::kApplied);
+  EXPECT_TRUE(HasPreviousArcShortcutConfiguration(service));
+
+  EXPECT_EQ(RestorePreviousArcShortcutConfiguration(&service),
+            PresetResult::kApplied);
+  EXPECT_EQ(pref_service.GetDict(prefs::kCustomAccelerators),
+            before_preferences);
+  EXPECT_EQ(service.GetAcceleratorMap(), before_accelerators);
+  EXPECT_FALSE(HasPreviousArcShortcutConfiguration(service));
+}
