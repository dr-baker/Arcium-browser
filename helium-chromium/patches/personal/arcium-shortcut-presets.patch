+NSMenu* MainMenuWithCommandShortcut(int command_id,
+                                    NSString* title,
+                                    NSString* key_equivalent,
+                                    NSEventModifierFlags modifier_mask,
+                                    SEL action) {
+  NSMenu* menu = [[NSMenu alloc] initWithTitle:@"Test Main Menu"];
+  NSMenuItem* item = [[NSMenuItem alloc]
+      initWithTitle:title
+             action:action
+      keyEquivalent:key_equivalent];
+  item.tag = command_id;
+  item.keyEquivalentModifierMask = modifier_mask;
+  [menu addItem:item];
+  return menu;
+}
+
+NSMenu* MainMenuWithSavePageShortcut(NSString* key_equivalent,
+                                     NSEventModifierFlags modifier_mask) {
+  return MainMenuWithCommandShortcut(IDC_SAVE_PAGE, @"Save Page",
+                                     key_equivalent, modifier_mask,
+                                     @selector(commandDispatch:));
+}
+
+NSMenu* MainMenuWithCopyURLShortcut(NSString* key_equivalent,
+                                    NSEventModifierFlags modifier_mask) {
+  return MainMenuWithCommandShortcut(IDC_COPY_URL, @"Copy URL", key_equivalent,
+                                     modifier_mask, @selector(commandDispatch:));
+}
+
+int CountDefaultsForCommand(
+    const std::vector<BrowserShortcutPlatformDefaultAccelerator>& defaults,
+    int command_id) {
+  int count = 0;
+  for (const BrowserShortcutPlatformDefaultAccelerator& entry : defaults) {
+    if (entry.command_id == command_id) {
+      ++count;
+    }
+  }
+  return count;
+}
+
+NSMenu* MainMenuWithCloseShortcuts(bool has_tabs,
+                                   NSString* close_window_key = nil,
+                                   NSEventModifierFlags close_window_modifiers =
+                                       NSEventModifierFlagCommand,
+                                   NSString* close_tab_key = nil,
+                                   NSEventModifierFlags close_tab_modifiers =
+                                       NSEventModifierFlagCommand) {
+  if (!close_window_key) {
+    close_window_key = has_tabs ? @"W" : @"w";
+  }
+  if (!close_tab_key) {
+    close_tab_key = @"w";
+  }
+
+  NSMenu* menu = [[NSMenu alloc] initWithTitle:@"Test Main Menu"];
+  NSMenuItem* close_window = [[NSMenuItem alloc]
+      initWithTitle:@"Close Window"
+             action:@selector(performClose:)
+      keyEquivalent:close_window_key];
+  close_window.tag = IDC_CLOSE_WINDOW;
+  close_window.keyEquivalentModifierMask = close_window_modifiers;
+  [menu addItem:close_window];
+
+  NSMenuItem* close_tab = [[NSMenuItem alloc]
+      initWithTitle:@"Close Tab"
+             action:@selector(commandDispatch:)
+      keyEquivalent:close_tab_key];
+  close_tab.tag = IDC_CLOSE_TAB;
+  close_tab.hidden = !has_tabs;
+  close_tab.keyEquivalentModifierMask = close_tab_modifiers;
+  [menu addItem:close_tab];
+  return menu;
+}
