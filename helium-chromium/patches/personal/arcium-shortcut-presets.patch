+
+// A report entry keeps the stable Arc action identifier and human-facing name
+// alongside the browser command label that native settings can show to the
+// user. `reason` is empty for supported entries and explains why an unavailable
+// entry was omitted from the applied configuration.
+struct CommandReport {
+  std::string action_id;
+  std::string action_name;
+  std::optional<int> command_id;
+  std::string accelerator;
+  std::u16string browser_command_name;
+  std::string reason;
+  // Already supplied by the native menu; do not persist a competing binding.
+  bool uses_platform_binding = false;
+};
+
+struct PresetReport {
+  std::vector<CommandReport> supported;
+  std::vector<CommandReport> unavailable;
+};
+
+enum class PresetResult {
+  kApplied,
+  kNoChange,
+  kNoSupportedCommands,
+  kUnknownCommand,
+  kInvalidAccelerator,
+  kInvalidConfiguration,
+  kShortcutLocked,
+  kAcceleratorConflict,
+  kPreferencesLocked,
+  kNoPreviousConfiguration,
+};
+
+// Computes the Arc macOS shortcut mapping against the commands and locked
+// accelerators available in this build. The unsupported list is intentional:
+// callers can explain real product gaps instead of silently assigning a
+// browser command with different behavior.
+PresetReport GetArcShortcutPresetReport(const BrowserShortcutService& service);
+
+// Applies every currently supported Arc mapping as one service transaction.
+// Unsupported Arc actions remain in the report and do not make the supported
+// subset fail.
+PresetResult ApplyArcShortcutPreset(BrowserShortcutService* service);
+
+bool CanModifyArcShortcutConfiguration(const BrowserShortcutService& service);
+
+bool HasPreviousArcShortcutConfiguration(const BrowserShortcutService& service);
+
+PresetResult RestorePreviousArcShortcutConfiguration(
+    BrowserShortcutService* service);
+
+}  // namespace browser_shortcuts::arcium
