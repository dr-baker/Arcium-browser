+TEST(BrowserShortcutPlatformMacTest, DynamicCloseUsesVisibleLiveMenuItems) {
+  ASSERT_NE(NSApp, nil);
+  NSMenu* main_menu = MainMenuWithCloseShortcuts(/*has_tabs=*/true);
+  // Visibility determines ownership; a disabled item still owns its AppKit
+  // key equivalent and must not be replaced by a static fallback.
+  [main_menu itemWithTag:IDC_CLOSE_TAB].enabled = NO;
+  ScopedMainMenu menu(main_menu);
+
+  EXPECT_TRUE(IsPlatformDynamicCloseAccelerator(
+      ui::Accelerator(ui::VKEY_W, ui::EF_COMMAND_DOWN)));
+  EXPECT_TRUE(IsPlatformDynamicCloseAccelerator(
+      ui::Accelerator(ui::VKEY_W,
+                      ui::EF_COMMAND_DOWN | ui::EF_SHIFT_DOWN)));
+  EXPECT_FALSE(IsPlatformDynamicCloseAccelerator(
+      ui::Accelerator(ui::VKEY_W,
+                      ui::EF_COMMAND_DOWN | ui::EF_ALT_DOWN)));
+}
