+TEST(BrowserShortcutPlatformMacTest,
+     DynamicCloseDoesNotClaimCustomizedOrConflictingAccelerators) {
+  ASSERT_NE(NSApp, nil);
+  NSMenu* menu = MainMenuWithCloseShortcuts(
+      /*has_tabs=*/true, @"x", NSEventModifierFlagCommand,
+      @"X", NSEventModifierFlagCommand);
+  NSMenuItem* conflict = [[NSMenuItem alloc]
+      initWithTitle:@"Other Command"
+             action:@selector(commandDispatch:)
+      keyEquivalent:@"w"];
+  conflict.tag = IDC_NEW_TAB;
+  conflict.keyEquivalentModifierMask = NSEventModifierFlagCommand;
+  [menu addItem:conflict];
+  ScopedMainMenu scoped_menu(menu);
+
+  EXPECT_FALSE(IsPlatformDynamicCloseAccelerator(
+      ui::Accelerator(ui::VKEY_W, ui::EF_COMMAND_DOWN)));
+  EXPECT_TRUE(IsPlatformDynamicCloseAccelerator(
+      ui::Accelerator(ui::VKEY_X, ui::EF_COMMAND_DOWN)));
+  EXPECT_TRUE(IsPlatformDynamicCloseAccelerator(
+      ui::Accelerator(ui::VKEY_X,
+                      ui::EF_COMMAND_DOWN | ui::EF_SHIFT_DOWN)));
