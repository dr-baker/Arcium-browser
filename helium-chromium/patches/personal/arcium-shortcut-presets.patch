+      "https://example.test/path%20with%20spaces/(part)?line=%0A#anchor");
+
+  EXPECT_EQ(
+      u"[Title \\[literal\\]\\\\slash next](<https://example.test/path%20with%20spaces/(part)?line=%0A#anchor>)",
+      FormatTabMarkdownLink(u"Title [literal]\\slash\nnext", url));
+}
+
+TEST(ArciumShortcutTabActionsTest, EscapesInlineMarkdownAndHtmlDelimiters) {
+  const GURL url("https://example.test/(part)%20name");
+
+  EXPECT_EQ(
+      u"[\\*bold\\* \\_under\\_ \\`code\\` \\<tag\\>](<https://example.test/(part)%20name>)",
+      FormatTabMarkdownLink(u"*bold* _under_ `code` <tag>", url));
+}
+
+TEST(ArciumShortcutTabActionsTest, KeepsEntitiesAndStrikethroughLiteral) {
+  EXPECT_EQ(u"[A \\&lt;B \\~\\~C\\~\\~](<https://example.test/>)",
+            FormatTabMarkdownLink(u"A &lt;B ~~C~~", GURL("https://example.test/")));
+}
+
+TEST(ArciumShortcutTabActionsTest, EmptyTitleUsesCanonicalURL) {
+  const GURL url("https://example.test/path%20with%20spaces/(part)");
+
+  EXPECT_EQ(
+      u"[https://example.test/path%20with%20spaces/(part)](<https://example.test/path%20with%20spaces/(part)>)",
+      FormatTabMarkdownLink({}, url));
+}
