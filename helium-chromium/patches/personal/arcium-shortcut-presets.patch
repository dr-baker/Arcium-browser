+TEST(ArciumShortcutPresetsTest,
+     ReportsArcCommandsAndDedicatedSidebarEquivalents) {
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitWithFeatures(
+      {}, {tabs::kVerticalTabs, tabs::kVerticalTabsLaunch});
+  TestingPrefServiceSimple pref_service;
+  RegisterPrefs(&pref_service);
+  UseVerticalSidebar(&pref_service);
+  BrowserShortcutService service(&pref_service);
+
+  const PresetReport report = GetArcShortcutPresetReport(service);
+  bool found_save_page = false;
+  bool found_sidebar = false;
+  bool found_little_arc = false;
+  for (const CommandReport& entry : report.supported) {
+    if (entry.action_id == "save_page_as") {
+      found_save_page = true;
+      ASSERT_TRUE(entry.command_id.has_value());
+      EXPECT_EQ(*entry.command_id, IDC_SAVE_PAGE);
+      EXPECT_EQ(entry.action_name, "Save Page As");
+      EXPECT_EQ(entry.accelerator, "Meta+Shift+KeyS");
+    }
+    if (entry.action_id == "show_hide_sidebar") {
+      found_sidebar = true;
+      ASSERT_TRUE(entry.command_id.has_value());
+      EXPECT_EQ(*entry.command_id, IDC_TOGGLE_VERTICAL_TABS_COLLAPSE);
+      EXPECT_EQ(entry.action_name, "Show or Hide the Sidebar");
+      EXPECT_EQ(entry.accelerator, "Meta+KeyS");
+    }
+    EXPECT_NE(entry.command_id.value_or(0), IDC_CTRL_S_SHORTCUT);
+  }
+  for (const CommandReport& entry : report.unavailable) {
+    if (entry.action_id == "open_little_arc") {
+      found_little_arc = true;
+      EXPECT_FALSE(entry.command_id.has_value());
+    }
+  }
+  EXPECT_TRUE(found_save_page);
+  EXPECT_TRUE(found_sidebar);
+  EXPECT_TRUE(found_little_arc);
+}
