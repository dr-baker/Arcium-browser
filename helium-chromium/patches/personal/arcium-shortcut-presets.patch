+TEST(ArciumShortcutPresetsTest,
+     ApplyPreservesEmptyOriginalBackupAcrossRepeatedApplications) {
+  TestingPrefServiceSimple pref_service;
+  RegisterPrefs(&pref_service);
+  BrowserShortcutService service(&pref_service);
+  CountingObserver observer;
+  ServiceObservation observation(&observer);
+  observation.Observe(&service);
+
+  EXPECT_EQ(service.ApplyConfiguration({
+                {IDC_NEW_TAB, {"Control+Alt+KeyT"}},
+            }),
+            ConfigurationResult::kSuccess);
+  EXPECT_TRUE(service.HasPreviousConfiguration());
+  const base::DictValue* saved_configuration =
+      pref_service.GetDict(prefs::kArcShortcutBackup)
+          .FindDict(kBackupConfigurationKey);
+  ASSERT_TRUE(saved_configuration);
+  EXPECT_TRUE(saved_configuration->empty());
+  EXPECT_EQ(observer.change_count, 1);
+
+  // A second application changes the live mapping but retains the original
+  // empty configuration until restore consumes it.
+  EXPECT_EQ(service.ApplyConfiguration({
+                {IDC_NEW_TAB, {"Control+Alt+KeyN"}},
+            }),
+            ConfigurationResult::kSuccess);
+  EXPECT_EQ(observer.change_count, 2);
+  EXPECT_TRUE(service.HasPreviousConfiguration());
+  EXPECT_TRUE(pref_service.GetDict(prefs::kArcShortcutBackup)
+                  .FindDict(kBackupConfigurationKey)
+                  ->empty());
+
+  EXPECT_EQ(service.RestorePreviousConfiguration(),
+            ConfigurationResult::kSuccess);
+  EXPECT_FALSE(service.HasPreviousConfiguration());
+  EXPECT_TRUE(pref_service.GetDict(prefs::kCustomAccelerators).empty());
+  EXPECT_EQ(observer.change_count, 3);
+}
