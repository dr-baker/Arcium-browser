+class ArciumCommandSessionTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    auto registry = std::make_unique<CommandProviderRegistry>();
+    registry_ = registry.get();
+    session_ = CreateCommandSessionForProviders(
+        std::move(registry), std::make_unique<FakeActionDelegate>(actions_),
+        base::BindLambdaForTesting([this](CommandInvocationMode) {
+          ++capture_count_;
+          return invocation_snapshot_;
+        }));
+  }
+
+  void TearDown() override {
+    registry_ = nullptr;
+    session_.reset();
+  }
+
+  std::shared_ptr<FakeProviderState> AddProvider(
+      std::string id,
+      std::vector<std::string> scopes) {
+    auto state = std::make_shared<FakeProviderState>();
+    for (const auto& scope : scopes) {
+      state->scopes.push_back(MakeScope(id, scope));
+    }
+    EXPECT_TRUE(registry_->Register(
+        std::make_unique<FakeCommandProvider>(std::move(id), state)));
+    return state;
+  }
+
+  CommandPublishCallback CollectPublications() {
+    return base::BindLambdaForTesting(
+        [this](std::shared_ptr<const CommandPublication> publication) {
+          publications_.push_back(std::move(publication));
+        });
+  }
+
+  void Search(std::string scope, std::u16string query = u"query") {
+    session_->Search(std::move(scope), std::move(query), CollectPublications());
+  }
+
+  void PostUpdate(CommandProviderPublishCallback callback,
+                  CommandProviderResults results) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](CommandProviderPublishCallback callback,
+                          CommandProviderResults results) {
+                         callback.Run(std::move(results));
+                       },
+                       std::move(callback), std::move(results)));
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  std::shared_ptr<FakeActionState> actions_ =
+      std::make_shared<FakeActionState>();
+  CommandInvocationSnapshot invocation_snapshot_;
+  size_t capture_count_ = 0;
+  std::vector<std::shared_ptr<const CommandPublication>> publications_;
+  raw_ptr<CommandProviderRegistry> registry_ = nullptr;
+  std::unique_ptr<CommandSession> session_;
+};
