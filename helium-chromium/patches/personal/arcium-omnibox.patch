+constexpr SkColor kOmniTint = SkColorSetRGB(0x54, 0x88, 0xbd);
+constexpr SkColor kSavedTint = SkColorSetRGB(0xb3, 0x91, 0x65);
+constexpr SkColor kYouTubeTint = SkColorSetRGB(0xe3, 0x4b, 0x49);
