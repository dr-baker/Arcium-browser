+#ifndef CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_ICON_CACHE_H_
+#define CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_ICON_CACHE_H_
+
+#include <cstddef>
+#include <memory>
+
+#include "base/functional/callback.h"
+#include "ui/gfx/image/image_skia.h"
+#include "url/gurl.h"
+
+namespace arcium {
+
+// Fetchers receive only visible page/icon URLs. The cache limits simultaneous
+// row requests and retained icons independently of the size of the saved index.
+class CommandIconCache {
+ public:
+  using FetchCallback = base::RepeatingCallback<
+      void(const GURL&, bool, base::OnceCallback<void(gfx::ImageSkia)>)>;
+  static constexpr size_t kMaxPageRequests = 8;
+  static constexpr size_t kMaxEngineRequests = 1;
+  static constexpr size_t kMaxCachedIcons = 64;
+  static constexpr size_t kMaxUrlLength = 4096;
+
+  CommandIconCache(FetchCallback fetch, base::RepeatingClosure cancel);
+  ~CommandIconCache();
+  gfx::ImageSkia GetPageIcon(const GURL& url, base::RepeatingClosure refreshed);
+  gfx::ImageSkia GetEngineIcon(const GURL& url,
+                               base::RepeatingClosure refreshed);
+  void Cancel();
+  size_t pending_for_testing() const;
+  size_t cached_for_testing() const;
+
+ private:
+  class Impl;
+  std::unique_ptr<Impl> impl_;
+};
+
+}  // namespace arcium
+
+#endif  // CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_ICON_CACHE_H_
