+  EXPECT_EQ(2u, publications_.size());
+
+  Search("scope", u"third query");
+  ASSERT_EQ(3u, provider->callbacks.size());
+  PostUpdate(provider->callbacks[2],
+             {{MakeRow("provider", "stale-destruction")}, true});
+  registry_ = nullptr;
+  session_.reset();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(3u, publications_.size());
+  EXPECT_EQ(1u, provider->destroy_count);
