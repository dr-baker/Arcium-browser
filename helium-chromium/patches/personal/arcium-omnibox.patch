+CommandScopeDescriptor MakeScope(std::string provider_id,
+                                 std::string scope_id) {
+  CommandScopeDescriptor scope;
+  scope.id = std::move(scope_id);
+  scope.provider_id = std::move(provider_id);
+  scope.label = u"Test scope";
+  return scope;
+}
+
+CommandRow MakeRow(std::string provider_id,
+                   std::string key,
+                   CommandRowKind kind = CommandRowKind::kResult) {
+  CommandRow row;
+  row.kind = kind;
+  row.provider_id = provider_id;
+  row.target = CommandProviderTarget{std::move(provider_id), key};
+  row.selection_key = std::move(key);
+  row.title = u"Test result";
+  row.has_actions = true;
+  return row;
+}
+
+struct FakeProviderState {
+  std::vector<CommandScopeDescriptor> scopes;
+  std::vector<std::string> additional_supported_scopes;
+  std::vector<CommandQuery> queries;
+  std::vector<CommandProviderPublishCallback> callbacks;
+  CommandProviderResults initial_results;
+  bool publish_on_start = true;
+  bool publish_on_cancel = false;
+  bool require_retained_target = false;
+  size_t menu_entry_count = 1;
+  size_t cancel_count = 0;
+  size_t reset_count = 0;
+  size_t destroy_count = 0;
+  std::optional<CommandProviderTarget> retained_target;
+  std::vector<std::string> resolved_menu_ids;
+  std::vector<std::u16string> resolved_queries;
+  std::vector<CommandIntent> executions;
+
+  void Publish(size_t query_index, CommandProviderResults results) {
+    // Keep a callback copy alive if a publication reenters Start().
+    auto callback = callbacks.at(query_index);
+    callback.Run(std::move(results));
+  }
+};
+
+class FakeCommandProvider final : public CommandQueryProvider {
+ public:
+  FakeCommandProvider(std::string id, std::shared_ptr<FakeProviderState> state)
+      : id_(std::move(id)), state_(std::move(state)) {}
+  ~FakeCommandProvider() override { ++state_->destroy_count; }
+
+  std::string_view id() const override { return id_; }
+  std::vector<CommandScopeDescriptor> GetScopes() const override {
+    return state_->scopes;
+  }
+  bool SupportsScope(std::string_view scope_id) const override {
+    return CommandQueryProvider::SupportsScope(scope_id) ||
+           std::find(state_->additional_supported_scopes.begin(),
+                     state_->additional_supported_scopes.end(),
+                     scope_id) != state_->additional_supported_scopes.end();
+  }
+  void Start(CommandQuery query,
+             CommandProviderPublishCallback publish) override {
+    state_->queries.push_back(std::move(query));
+    state_->callbacks.push_back(std::move(publish));
+    if (state_->publish_on_start) {
+      state_->Publish(state_->callbacks.size() - 1, state_->initial_results);
+    }
+  }
+  void Cancel() override {
+    ++state_->cancel_count;
+    if (state_->publish_on_cancel && !state_->callbacks.empty()) {
+      state_->Publish(state_->callbacks.size() - 1,
+                      {{MakeRow(id_, "cancelled")}, true});
+    }
+  }
+  void ResetRetainedTarget() override {
+    ++state_->reset_count;
+    state_->retained_target.reset();
+  }
+  CommandMenu ResolveActions(const CommandProviderTarget& target,
+                             std::string_view menu_id,
+                             std::u16string_view query) override {
+    state_->retained_target = target;
+    state_->resolved_menu_ids.emplace_back(menu_id);
+    state_->resolved_queries.emplace_back(query);
+    CommandMenu menu;
+    menu.id = std::string(menu_id);
+    for (size_t i = 0; i < state_->menu_entry_count; ++i) {
+      CommandMenuEntry entry;
+      entry.id = "provider-action-" + std::to_string(i);
+      entry.label = u"Provider-owned action";
+      CommandIntent intent;
+      intent.provider_id = id_;
+      intent.action_id = entry.id;
+      intent.target = target;
+      intent.query = query;
+      entry.intent = std::move(intent);
+      menu.entries.push_back(std::move(entry));
+    }
+    return menu;
+  }
+  CommandExecutionResult Execute(const CommandIntent& intent) override {
+    state_->executions.push_back(intent);
+    const auto* target = std::get_if<CommandProviderTarget>(&intent.target);
+    const bool available = !state_->require_retained_target ||
+                           (target && state_->retained_target == *target);
+    return {available, available, u"Provider action"};
+  }
+
+ private:
+  const std::string id_;
+  const std::shared_ptr<FakeProviderState> state_;
+};
+
+struct FakeActionState {
+  std::vector<CommandInvocation> invocations;
+  std::vector<CommandTarget> resolved_targets;
+  std::vector<std::string> resolved_menu_ids;
+  std::vector<std::u16string> resolved_queries;
+  std::vector<CommandIntent> executions;
+  size_t menu_entry_count = 1;
+};
+
+class FakeActionDelegate final : public CommandActionDelegate {
+ public:
+  explicit FakeActionDelegate(std::shared_ptr<FakeActionState> state)
+      : state_(std::move(state)) {}
+  void SetInvocation(const CommandInvocation& invocation) override {
+    state_->invocations.push_back(invocation);
+  }
+  CommandMenu ResolveActions(const CommandTarget& target,
+                             std::string_view menu_id,
+                             std::u16string_view query) override {
+    state_->resolved_targets.push_back(target);
+    state_->resolved_menu_ids.emplace_back(menu_id);
+    state_->resolved_queries.emplace_back(query);
+    CommandMenu menu;
+    for (size_t i = 0; i < state_->menu_entry_count; ++i) {
+      CommandMenuEntry entry;
+      entry.id = "browser-action-" + std::to_string(i);
+      menu.entries.push_back(std::move(entry));
+    }
+    return menu;
+  }
+  CommandExecutionResult Execute(const CommandIntent& intent) override {
+    state_->executions.push_back(intent);
+    return {true, true, u"Browser action"};
+  }
+
+ private:
+  const std::shared_ptr<FakeActionState> state_;
+};
