+#include "base/i18n/case_conversion.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "components/omnibox/browser/autocomplete_provider.h"
+#include "components/omnibox/browser/autocomplete_result.h"
+#include "third_party/icu/source/common/unicode/normalizer2.h"
+#include "third_party/icu/source/common/unicode/unistr.h"
+
+namespace arcium {
+namespace {
+std::u16string Normalize(std::u16string_view value) {
+  const auto folded = base::i18n::FoldCase(value);
+  UErrorCode status = U_ZERO_ERROR;
+  const auto* nfc = icu::Normalizer2::getNFCInstance(status);
+  CHECK(U_SUCCESS(status));
+  icu::UnicodeString output;
+  nfc->normalize(icu::UnicodeString(false, folded.data(), folded.size()),
+                 output, status);
+  CHECK(U_SUCCESS(status));
+  return std::u16string(output.getBuffer(), output.length());
+}
+bool Better(const CommandSearchResult& left, const CommandSearchResult& right) {
+  // Owner relevance includes its existing tier and frecency policy. Query
+  // matching adds a bounded text score, so owner policy affects every result.
+  const int64_t left_relevance =
+      static_cast<int64_t>(left.source_relevance) + left.text_score;
+  const int64_t right_relevance =
+      static_cast<int64_t>(right.source_relevance) + right.text_score;
+  if (left_relevance != right_relevance) {
+    return left_relevance > right_relevance;
+  }
+  if (left.text_score != right.text_score) {
+    return left.text_score > right.text_score;
+  }
+  if (left.source_relevance != right.source_relevance) {
+    return left.source_relevance > right.source_relevance;
+  }
+  return left.record.slot < right.record.slot;
+}
+int Score(std::u16string_view text,
+          std::u16string_view token,
+          int exact,
+          int prefix,
+          int contains) {
+  if (text == token) {
+    return exact;
+  }
+  if (base::StartsWith(text, token)) {
+    return prefix;
+  }
+  return text.find(token) != std::u16string_view::npos ? contains : 0;
+}
+}  // namespace
+
+CommandSearchIndex::CommandSearchIndex(std::vector<CommandRecord> records,
+                                       uint64_t revision)
+    : records_(std::move(records)), revision_(revision) {
+  CHECK_NE(revision_, 0u);
+  CHECK_LE(records_.size(), UINT32_MAX);
+  search_text_.reserve(records_.size());
+  for (auto& record : records_) {
+    if (record.primary_scope_id.empty()) {
+      record.primary_scope_id =
+          record.scope_ids.empty() ? "omni"
+                                   : std::string_view(record.scope_ids.front());
+    }
+    if (record.primary_scope_id != "omni" &&
+        std::ranges::find(record.scope_ids, record.primary_scope_id) ==
+            record.scope_ids.end()) {
+      record.scope_ids.push_back(record.primary_scope_id);
+    }
+    search_text_.push_back(
+        {Normalize(record.title), Normalize(record.url),
+         Normalize(record.context + u" " + record.category)});
+  }
+}
+CommandSearchIndex::~CommandSearchIndex() = default;
+
+std::vector<CommandSearchResult> CommandSearchIndex::Search(
+    std::u16string_view query,
+    std::string_view scope_id,
+    size_t limit) const {
+  limit = std::min(limit, kMaxResults);
+  std::vector<CommandSearchResult> results;
+  results.reserve(limit);
+  if (!limit || query.size() > kMaxQueryLength) {
+    return results;
+  }
+  const auto normalized = Normalize(query);
+  const auto tokens =
+      base::SplitStringPiece(normalized, base::kWhitespaceUTF16,
+                             base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (tokens.size() > kMaxQueryTerms) {
+    return results;
+  }
+  for (size_t slot = 0; slot < records_.size(); ++slot) {
+    const auto& record = records_[slot];
+    if (scope_id != "omni" && std::ranges::find(record.scope_ids, scope_id) ==
+                                  record.scope_ids.end()) {
+      continue;
+    }
+    if (tokens.empty() && !record.suggested) {
+      continue;
+    }
+    const auto& text = search_text_[slot];
+    int score = 0;
+    bool matched = true;
+    for (const auto token : tokens) {
+      const int token_score =
+          std::max({Score(text.title, token, 100, 80, 50),
+                    Score(text.url, token, 45, 35, 25),
+                    Score(text.context, token, 30, 20, 10)});
+      if (!token_score) {
+        matched = false;
+        break;
+      }
+      score += token_score;
+    }
+    if (!matched) {
+      continue;
+    }
+    CommandSearchResult candidate{Ref(slot), score, record.source_relevance};
+    const auto position =
+        std::lower_bound(results.begin(), results.end(), candidate, Better);
+    if (results.size() == limit && position == results.end()) {
+      continue;
+    }
+    // Allocation remains bounded by the requested visible result count.
+    if (results.size() == limit) {
+      results.pop_back();
+    }
+    const auto insertion =
+        std::lower_bound(results.begin(), results.end(), candidate, Better);
+    results.insert(insertion, candidate);
+  }
+  return results;
+}
+const CommandRecord* CommandSearchIndex::Get(CommandRecordRef ref) const {
+  if (ref.snapshot != snapshot_ || ref.revision != revision_ ||
+      ref.slot >= records_.size()) {
+    return nullptr;
+  }
+  return &records_[ref.slot];
+}
+CommandRecordRef CommandSearchIndex::Ref(size_t slot) const {
+  CHECK_LT(slot, records_.size());
+  return {snapshot_, revision_, static_cast<uint32_t>(slot)};
+}
+size_t CommandSearchIndex::EstimateOwnedBytes() const {
+  size_t bytes = sizeof(*this) + records_.capacity() * sizeof(CommandRecord) +
+                 search_text_.capacity() * sizeof(SearchText);
+  for (const auto& r : records_) {
+    bytes += r.id.capacity() + 1;
+    bytes += r.primary_scope_id.capacity() + 1;
+    bytes += r.scope_ids.capacity() * sizeof(std::string);
+    for (const auto& scope_id : r.scope_ids) {
+      bytes += scope_id.capacity() + 1;
+    }
+    for (const auto* text : {&r.title, &r.url, &r.context, &r.category}) {
+      bytes += (text->capacity() + 1) * sizeof(char16_t);
+    }
+  }
+  for (const auto& r : search_text_) {
+    for (const auto* text : {&r.title, &r.url, &r.context}) {
+      bytes += (text->capacity() + 1) * sizeof(char16_t);
+    }
+  }
+  return bytes;
+}
+std::vector<NativeCommandRow> ProjectNativeCommandRows(
+    const AutocompleteResult& result,
+    base::UnguessableToken result_revision,
+    size_t limit,
+    bool (*supported)(const AutocompleteMatch&)) {
+  CHECK(!result_revision.is_empty());
+  limit = std::min({limit, CommandSearchIndex::kMaxResults, result.size()});
+  std::vector<NativeCommandRow> rows;
+  rows.reserve(limit);
+  const auto* default_match = result.default_match();
+  for (size_t i = 0; i < result.size() && rows.size() < limit; ++i) {
+    const auto& match = result.match_at(i);
+    if (supported && !supported(match)) {
+      continue;
+    }
+    rows.push_back(
+        {result_revision, static_cast<uint32_t>(i), match.relevance,
+         match.provider ? static_cast<int>(match.provider->type()) : 0,
+         static_cast<int>(match.type), match.allowed_to_be_default_match,
+         &match == default_match});
+  }
+  return rows;
+}
+}  // namespace arcium
