+// Immediate live-tab switches and folder navigation share the active Pin tier.
+// An exact folder title then outranks a Pin's breadcrumb-only match, including
+// the existing Pin policy's maximum 30 points of usage and recency.
+constexpr int kLiveTabRelevance = 4000;
+constexpr int kFolderRelevance = 4000;
+
+bool SavedItemsEligible(const Browser* browser) {
+  if (!browser || !browser->is_type_normal()) {
+    return false;
+  }
+  const Profile* profile = browser->profile();
+  return !profile->IsOffTheRecord() && !profile->IsGuestSession() &&
+         helium::IsHeliumFavoritesAndPinsEnabled();
+}
+
+std::string LiveIdentity(const CommandLiveTarget& target) {
+  return "live:" + base::NumberToString(target.browser_session_id) + ":" +
+         base::NumberToString(target.tab_session_id);
+}
+
+void AddSiteScope(CommandRecord& record, const GURL& url) {
+  if (!url.is_valid()) {
+    return;
+  }
+  // DomainIs requires an exact host or a subdomain separated by a dot.
+  if (url.DomainIs("youtube.com") || url.DomainIs("youtu.be")) {
+    record.scope_ids.emplace_back(kYouTubeScope);
+  } else if (url.DomainIs("x.com") || url.DomainIs("twitter.com")) {
+    record.scope_ids.emplace_back(kXScope);
+  } else if (url.DomainIs("chatgpt.com") || url.DomainIs("chat.openai.com")) {
+    record.scope_ids.emplace_back(kChatGPTScope);
+  }
+}
+
+std::u16string AppendBreadcrumb(std::u16string context,
+                                const std::u16string& title) {
+  if (!context.empty()) {
+    context += u" › ";
+  }
+  return context + title;
+}
+
+std::u16string ItemContext(const helium::PersistentOmniboxItem& item) {
+  std::u16string context =
+      item.space_name.empty() ? u"All Spaces" : item.space_name;
+  for (const auto& folder : item.folder_path) {
+    context = AppendBreadcrumb(std::move(context), folder);
+  }
+  return context;
+}
+
+ArciumOmniboxItem NativeItem(const helium::PersistentOmniboxItem& source) {
+  ArciumOmniboxItem item;
+  item.kind = source.kind == helium::PersistentRecordKind::kPin
+                  ? ArciumOmniboxItem::Kind::kPin
+                  : ArciumOmniboxItem::Kind::kFavorite;
+  item.id = source.id;
+  item.space_id = source.space_id;
+  item.space_name = source.space_name;
+  item.folder_path = source.folder_path;
+  item.title = source.title;
+  item.url = source.url;
+  switch (source.tier) {
+    case helium::PersistentOmniboxItem::Tier::kActiveSpacePin:
+      item.tier = ArciumOmniboxItem::Tier::kActiveSpacePin;
+      break;
+    case helium::PersistentOmniboxItem::Tier::kFavorite:
+      item.tier = ArciumOmniboxItem::Tier::kFavorite;
+      break;
+    case helium::PersistentOmniboxItem::Tier::kOtherSpacePin:
+      item.tier = ArciumOmniboxItem::Tier::kOtherSpacePin;
+      break;
+  }
+  item.is_live = source.is_live;
+  item.is_active = source.is_active;
+  item.use_count = source.use_count;
+  item.last_used_internal_value = source.last_used_internal_value;
+  return item;
+}
+
+int ItemTierBase(helium::PersistentOmniboxItem::Tier tier) {
+  switch (tier) {
+    case helium::PersistentOmniboxItem::Tier::kActiveSpacePin:
+      return 4000;
+    case helium::PersistentOmniboxItem::Tier::kFavorite:
+      return 3000;
+    case helium::PersistentOmniboxItem::Tier::kOtherSpacePin:
+      return 2000;
+  }
+  return 2000;
+}
+
+CommandActivity LiveActivity(
+    std::optional<helium::PersistentRecordKind> persistent_kind) {
+  return persistent_kind == helium::PersistentRecordKind::kPin
+             ? CommandActivity::kCircleDot
+             : CommandActivity::kDot;
+}
+
+std::u16string TabTitle(content::WebContents& contents) {
+  return contents.GetTitle().empty()
+             ? base::UTF8ToUTF16(contents.GetVisibleURL().spec())
+             : contents.GetTitle();
+}
