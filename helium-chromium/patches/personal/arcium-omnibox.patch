+gfx::ImageSkia ScopeIcon(std::string_view scope_id) {
+  if (scope_id == kYouTubeScope || scope_id == kXScope) {
+    return gfx::ImageSkia(
+        std::make_unique<BrandedScopeIcon>(
+            scope_id == kYouTubeScope ? BrandedScopeIcon::Kind::kYouTube
+                                      : BrandedScopeIcon::Kind::kX),
+        gfx::Size(16, 16));
+  }
+  if (scope_id == kSavedScope) {
+    return gfx::CreateVectorIcon(kKeepIcon, 16, kSavedTint);
+  }
+  if (scope_id == kChatGPTScope) {
+    return gfx::ImageSkia(
+        std::make_unique<BrandedScopeIcon>(BrandedScopeIcon::Kind::kChat),
+        gfx::Size(16, 16));
+  }
+  if (scope_id == kOmniScope) {
+    return gfx::CreateVectorIcon(omnibox::kSparkIcon, 16, kOmniTint);
+  }
+  return gfx::CreateVectorIcon(vector_icons::kGlobeIcon, 16, kOmniTint);
+}
