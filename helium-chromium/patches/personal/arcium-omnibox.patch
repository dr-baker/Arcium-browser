+  EXPECT_EQ("GET", handle->GetRequestMethod());
+  EXPECT_FALSE(handle->GetRequestHeaders().GetHeader("Content-Type"));
+  EXPECT_EQ("omnibox-acceptance",
+            handle->GetRequestHeaders().GetHeader("X-Search-Integration"));
+}
+
+TEST_F(ChromeOmniboxPostNavigationTest, PostPreservesBackgroundTabDisposition) {
+  auto* original = browser()->tab_strip_model()->GetActiveWebContents();
+  TemplateURLRef::PostContent post_content{"application/x-www-form-urlencoded",
+                                           "q=background+query"};
+  Accept(&post_content, WindowOpenDisposition::NEW_BACKGROUND_TAB);
+
+  ASSERT_EQ(2, browser()->tab_strip_model()->count());
+  EXPECT_EQ(original, browser()->tab_strip_model()->GetActiveWebContents());
+  auto& controller =
+      browser()->tab_strip_model()->GetWebContentsAt(1)->GetController();
+  ASSERT_TRUE(controller.GetPendingEntry());
+  auto body = controller.GetPendingEntry()->GetPostData();
+  ASSERT_TRUE(body);
+  ASSERT_EQ(1u, body->elements()->size());
+  EXPECT_EQ(
+      "q=background+query",
+      body->elements()->front().As<network::DataElementBytes>().AsStringView());
+
+  auto simulator = content::NavigationSimulator::CreateFromPending(controller);
+  EXPECT_TRUE(simulator->GetNavigationHandle()->IsPost());
+  EXPECT_EQ("application/x-www-form-urlencoded",
+            simulator->GetNavigationHandle()->GetRequestHeaders().GetHeader(
+                "Content-Type"));
+}
+
+}  // namespace
