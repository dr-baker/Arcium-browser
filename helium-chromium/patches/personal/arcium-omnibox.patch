+                   accepted_urls);
+  PostConfirmation(new_epoch, new_target, replacement, new_input,
+                   accepted_urls);
+  task_environment_.RunUntilIdle();
+
+  ASSERT_EQ(1u, accepted_urls.size());
+  EXPECT_EQ(GURL("https://new-selection.test/"), accepted_urls[0]);
+}
