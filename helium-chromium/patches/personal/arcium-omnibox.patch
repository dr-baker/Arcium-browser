+TEST_F(ArciumCommandBarTest, PopupResultsBeginBelowActualCommandInput) {
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(true));
+  auto* location = floating();
+  auto* field = location->omnibox_view();
+  field->SetFontList(field->GetFontList().DeriveWithSizeDelta(12));
+  field->SetUserText(u"boundary", false);
+  auto* controller = location->GetOmniboxController();
+  controller->StopAutocomplete(true);
+  auto* autocomplete = controller->autocomplete_controller();
+  ASSERT_FALSE(autocomplete->providers().empty());
+  ACMatches matches;
+  for (int i = 0; i < 3; ++i) {
+    AutocompleteMatch match(autocomplete->providers().front().get(), 1000 - i,
+                            false, AutocompleteMatchType::URL_WHAT_YOU_TYPED);
+    match.allowed_to_be_default_match = i == 0;
+    match.destination_url = GURL("https://boundary.test/");
+    match.contents = u"Boundary result";
+    match.description = u"boundary.test";
+    match.contents_class = {{0, ACMatchClassification::NONE}};
+    match.description_class = {{0, ACMatchClassification::NONE}};
+    matches.push_back(std::move(match));
+  }
+  auto& result = const_cast<AutocompleteResult&>(autocomplete->result());
+  result.Reset();
+  result.AppendMatches(matches);
+  auto* popup =
+      static_cast<OmniboxPopupViewViews*>(location->GetOmniboxPopupView());
+  ASSERT_TRUE(popup);
+  popup->UpdatePopupAppearance();
+  ASSERT_TRUE(popup->GetWidget());
+  auto* widget = location->GetWidget();
+  const int outer_width =
+      widget->GetWindowBoundsInScreen().width() - location->width();
+  for (int width : {240, 640, 320}) {
+    gfx::Rect bounds = widget->GetWindowBoundsInScreen();
+    bounds.set_width(width + outer_width);
+    widget->SetBounds(bounds);
+    location->InvalidateLayout();
+    views::test::RunScheduledLayout(location);
+    popup->UpdatePopupBounds();
+    views::test::RunScheduledLayout(popup->GetWidget()->GetRootView());
+    const gfx::Rect input_bounds = location->GetBoundsInScreen();
+    const gfx::Rect popup_bounds = popup->GetBoundsInScreen();
+    const int results_top =
+        input_bounds.bottom() +
+        RoundedOmniboxResultsFrame::GetLocationBarAlignmentInsets().bottom();
+    EXPECT_EQ(results_top, popup_bounds.y());
+    int previous_bottom = results_top;
+    int visible_rows = 0;
+    for (views::View* row : popup->children()) {
+      if (!row->GetVisible()) {
+        continue;
+      }
+      const gfx::Rect row_bounds = row->GetBoundsInScreen();
+      EXPECT_GE(row_bounds.y(), previous_bottom);
+      EXPECT_LE(row_bounds.bottom(), popup_bounds.bottom());
+      previous_bottom = row_bounds.bottom();
+      ++visible_rows;
+    }
+    EXPECT_EQ(3, visible_rows);
+  }
+  views::test::WidgetDestroyedWaiter destroyed(widget);
+  browser_view()->CloseArciumCommandBar();
+  destroyed.Wait();
+}
