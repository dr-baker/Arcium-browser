+bool HasAction(const CommandMenu& menu, std::string_view id) {
+  return std::ranges::any_of(menu.entries, [id](const auto& entry) {
+    return (entry.intent && entry.intent->action_id == id) ||
+           entry.submenu_id == id;
+  });
+}
+
+const CommandMenuEntry* FindAction(const CommandMenu& menu,
+                                   std::string_view id) {
+  const auto entry =
+      std::ranges::find_if(menu.entries, [id](const auto& candidate) {
+        return (candidate.intent && candidate.intent->action_id == id) ||
+               candidate.submenu_id == id;
+      });
+  return entry == menu.entries.end() ? nullptr : &*entry;
+}
+
+bool SameGlyph(const gfx::ImageSkia& first, const gfx::ImageSkia& second) {
+  if (first.isNull() || second.isNull()) {
+    return first.isNull() == second.isNull();
+  }
+  const auto& first_bitmap = first.GetRepresentation(1.0f).GetBitmap();
+  const auto& second_bitmap = second.GetRepresentation(1.0f).GetBitmap();
+  if (first_bitmap.width() != second_bitmap.width() ||
+      first_bitmap.height() != second_bitmap.height()) {
+    return false;
+  }
+  for (int y = 0; y < first_bitmap.height(); ++y) {
+    for (int x = 0; x < first_bitmap.width(); ++x) {
+      if (first_bitmap.getColor(x, y) != second_bitmap.getColor(x, y)) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
