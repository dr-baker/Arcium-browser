+#ifndef COMPONENTS_OMNIBOX_BROWSER_ARCIUM_PERSISTENT_ITEM_RANK_H_
+#define COMPONENTS_OMNIBOX_BROWSER_ARCIUM_PERSISTENT_ITEM_RANK_H_
+
+#include <algorithm>
+#include <cstdint>
+
+#include "base/time/time.h"
+
+namespace arcium {
+
+// Shared BookmarkProvider policy. Callers choose the existing tier base and
+// query match quality, and pass usage from the authoritative item snapshot.
+inline int PersistentItemRelevance(int tier_base,
+                                   int match_quality,
+                                   int use_count,
+                                   int64_t last_used_internal_value,
+                                   base::Time now) {
+  int recency = 0;
+  if (last_used_internal_value > 0) {
+    const auto age = std::clamp(
+        now - base::Time::FromInternalValue(last_used_internal_value),
+        base::TimeDelta(), base::Days(10));
+    recency = 10 - age.InDays();
+  }
+  return tier_base + match_quality * 10 + std::clamp(use_count, 0, 10) * 2 +
+         recency;
+}
+
+}  // namespace arcium
+
+#endif  // COMPONENTS_OMNIBOX_BROWSER_ARCIUM_PERSISTENT_ITEM_RANK_H_
