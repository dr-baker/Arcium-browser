+TEST_F(ArciumCommandBarTest, CommandInputFitsScaledTextAndCaretInHeader) {
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(true));
+  auto* location = floating();
+  auto* field = location->omnibox_view();
+  field->SetFontList(field->GetFontList().DeriveWithSizeDelta(12));
+  field->SetUserText(u"command", false);
+  views::test::RunScheduledLayout(location);
+  auto* widget = location->GetWidget();
+  const int outer_width =
+      widget->GetWindowBoundsInScreen().width() - location->width();
+  for (int width : {240, 640, 320}) {
+    gfx::Rect bounds = widget->GetWindowBoundsInScreen();
+    bounds.set_width(width + outer_width);
+    widget->SetBounds(bounds);
+    location->InvalidateLayout();
+    views::test::RunScheduledLayout(location);
+    EXPECT_EQ(width, location->width());
+    EXPECT_EQ(48, field->height());
+    EXPECT_GE(field->GetContentsBounds().height(),
+              field->GetFontList().GetHeight());
+    EXPECT_TRUE(
+        location->GetBoundsInScreen().Contains(field->GetCaretBounds()));
+    views::ImageView* search_icon = nullptr;
+    for (views::View* child : location->children()) {
+      if (child->GetVisible() && child != field) {
+        search_icon = views::AsViewClass<views::ImageView>(child);
+      }
+    }
+    ASSERT_TRUE(search_icon);
+    EXPECT_EQ(field->GetFontList().GetFontSize(), search_icon->width());
+    EXPECT_LT(search_icon->bounds().right(), field->x());
+    EXPECT_TRUE(location->GetLocalBounds().Contains(field->bounds()));
+    const gfx::Rect field_bounds = field->bounds();
+    const gfx::Rect icon_bounds = search_icon->bounds();
+    for (int pass = 0; pass < 4; ++pass) {
+      location->InvalidateLayout();
+      views::test::RunScheduledLayout(location);
+      EXPECT_EQ(field_bounds, field->bounds());
+      EXPECT_EQ(icon_bounds, search_icon->bounds());
+    }
+  }
+  views::test::WidgetDestroyedWaiter destroyed(location->GetWidget());
+  browser_view()->CloseArciumCommandBar();
+  destroyed.Wait();
+}
