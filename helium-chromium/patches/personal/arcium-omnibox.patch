+                                const CommandPersistentTarget& identity) {
+  LiveTarget result;
+  ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+      [profile, spaces, &identity, &result](BrowserWindowInterface* window) {
+        Browser* browser = window->GetBrowserForMigrationOnly();
+        if (!browser || browser->profile() != profile ||
+            browser->type() != Browser::TYPE_NORMAL ||
+            (IsPin(identity.kind) && spaces->GetExplicitSpaceIdForBrowser(
+                                         browser) != identity.space_id)) {
+          return true;
+        }
+        tabs::TabInterface* tab = spaces->GetLiveTabForPersistentItem(
+            browser, RecordKind(identity.kind), identity.item_id);
+        if (tab) {
+          result = {browser, tab};
+          return false;
+        }
+        if (!result.browser) {
+          result.browser = browser;
+        }
+        return true;
+      },
+      BrowserCollection::Order::kActivation);
+  return result;
+}
+
+bool IsOrdinaryTab(Browser* browser,
+                   tabs::TabInterface* tab,
+                   HeliumSpaceService* spaces) {
+  if (!browser || browser->type() != Browser::TYPE_NORMAL || !tab ||
+      tab->GetBrowserWindowInterface() != browser ||
+      tabs::TemporaryTab::IsTemporary(tab->GetContents()) ||
+      (spaces && spaces->IsPersistentItemTab(tab))) {
+    return false;
+  }
+  return browser->tab_strip_model()->GetIndexOfTab(tab) !=
+         TabStripModel::kNoTab;
+}
+
+bool IsOrdinaryStandalone(Browser* browser,
+                          tabs::TabInterface* tab,
+                          HeliumSpaceService* spaces) {
+  return IsOrdinaryTab(browser, tab, spaces) && !tab->IsPinned() &&
+         !tab->GetGroup() && !tab->IsBlocked() && !tab->IsSplit();
+}
+
+bool CanPersistTab(Browser* browser,
+                   tabs::TabInterface* tab,
+                   HeliumSpaceService* spaces) {
+  return PersistentActionsEnabled(browser, spaces) &&
+         IsOrdinaryStandalone(browser, tab, spaces) &&
+         !spaces->GetExplicitSpaceIdForBrowser(browser).empty() &&
+         tab->GetContents()->GetLastCommittedURL().SchemeIsHTTPOrHTTPS();
+}
+
+bool FindParent(const PersistentNodes& nodes,
+                std::string_view id,
+                std::string_view parent,
+                std::string* result) {
+  for (const auto& node : nodes) {
+    if (const auto* link = std::get_if<PersistentLink>(&node.data)) {
+      if (link->id == id) {
+        *result = std::string(parent);
+        return true;
+      }
+    } else if (const auto* folder = std::get_if<PersistentFolder>(&node.data)) {
+      if (folder->id == id) {
+        *result = std::string(parent);
+        return true;
+      }
+      if (FindParent(folder->children, id, folder->id, result)) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+bool FindFolderPath(const PersistentNodes& nodes,
+                    std::string_view id,
+                    std::vector<std::string>* path) {
+  for (const auto& node : nodes) {
+    const auto* folder = std::get_if<PersistentFolder>(&node.data);
+    if (!folder) {
+      continue;
+    }
+    path->push_back(folder->id);
+    if (folder->id == id || FindFolderPath(folder->children, id, path)) {
+      return true;
+    }
+    path->pop_back();
+  }
+  return false;
+}
+
+bool MatchesDestination(std::u16string_view name,
+                        std::u16string_view path,
+                        std::u16string_view query) {
+  const std::u16string haystack =
+      base::i18n::ToLower(base::StrCat({name, u" ", path}));
+  for (const std::u16string& word :
+       base::SplitString(base::i18n::ToLower(query), u" /",
+                         base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (haystack.find(word) == std::u16string::npos) {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::string DestinationId(std::string_view kind,
+                          std::string_view space,
+                          std::string_view folder) {
+  return base::StrCat(
+      {kind, ":", base::NumberToString(space.size()), ":", space, ":", folder});
+}
+
+CommandIntent MakeIntent(const CommandTarget& target, std::string_view action) {
+  CommandIntent intent;
+  intent.provider_id = kBuiltinCommandProvider;
+  intent.action_id = std::string(action);
+  intent.target = target;
+  return intent;
+}
+
+void AddAction(CommandMenu* menu,
+               const CommandTarget& target,
+               std::string_view action,
+               std::u16string label,
+               std::string_view entry_id = {}) {
+  CommandMenuEntry entry;
+  entry.id = std::string(entry_id.empty() ? action : entry_id);
+  entry.label = std::move(label);
+  entry.icon = ActionIcon(action);
+  entry.intent = MakeIntent(target, action);
+  menu->entries.push_back(std::move(entry));
+}
+
+void AddSubmenu(CommandMenu* menu,
+                std::string_view action,
+                std::u16string label) {
+  CommandMenuEntry entry;
+  entry.id = std::string(action);
+  entry.label = std::move(label);
+  entry.icon = ActionIcon(action);
+  entry.submenu_id = std::string(action);
+  menu->entries.push_back(std::move(entry));
+}
+
+void AddDestination(CommandMenu* menu,
+                    const CommandTarget& target,
+                    std::string_view action,
+                    CommandDestination destination,
+                    std::u16string detail,
+                    std::u16string_view query) {
+  // Filter the full current tree before applying the publication bound.
+  if (!MatchesDestination(destination.name, detail, query) ||
+      menu->entries.size() >= CommandSession::kMaxMenuEntries) {
+    return;
+  }
+  CommandMenuEntry entry;
+  entry.id = DestinationId(action, destination.space_id, destination.folder_id);
+  entry.label = destination.name;
+  entry.detail = std::move(detail);
+  entry.icon = ActionIcon(action);
+  entry.intent = MakeIntent(target, action);
+  entry.intent->destination = std::move(destination);
+  menu->entries.push_back(std::move(entry));
+}
+
+void AppendFolderDestinations(const PersistentNodes& nodes,
+                              const CommandTarget& target,
+                              std::string_view space_id,
+                              std::string_view current_parent,
+                              std::u16string path,
+                              std::u16string_view query,
+                              CommandMenu* menu) {
+  for (const auto& node : nodes) {
+    const auto* folder = std::get_if<PersistentFolder>(&node.data);
+    if (!folder) {
+      continue;
+    }
+    const std::u16string full_path =
+        path.empty() ? folder->title
+                     : base::StrCat({path, u" / ", folder->title});
+    if (folder->id != current_parent) {
+      AddDestination(menu, target, command_action::kMoveToFolder,
+                     {.kind = CommandDestinationKind::kFolder,
+                      .space_id = std::string(space_id),
+                      .folder_id = folder->id,
+                      .name = folder->title},
+                     full_path, query);
+    }
+    AppendFolderDestinations(folder->children, target, space_id, current_parent,
+                             full_path, query, menu);
+  }
+}
+
+bool SetOneSiteMuted(content::WebContents* contents, bool mute) {
+  const GURL url = contents->GetLastCommittedURL();
+  if (url.is_empty()) {
+    return false;
+  }
+  if (url.SchemeIs(content::kChromeUIScheme)) {
+    return SetTabAudioMuted(contents, mute,
+                            TabMutedReason::kContentSettingChrome, {});
+  }
+  Profile* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  HostContentSettingsMap* settings =
+      HostContentSettingsMapFactory::GetForProfile(profile);
+  if (!settings) {
+    return false;
+  }
+  const ContentSetting desired =
+      mute ? CONTENT_SETTING_BLOCK : CONTENT_SETTING_ALLOW;
+  if (!profile->IsIncognitoProfile()) {
+    settings->SetContentSettingDefaultScope(
+        url, url, ContentSettingsType::SOUND, CONTENT_SETTING_DEFAULT);
+    if (settings->GetContentSetting(url, url, ContentSettingsType::SOUND) ==
+        desired) {
+      return true;
+    }
+  }
+  settings->SetContentSettingDefaultScope(url, url, ContentSettingsType::SOUND,
+                                          desired);
+  return settings->GetContentSetting(url, url, ContentSettingsType::SOUND) ==
+         desired;
+}
+
+bool HasAction(const CommandMenu& menu, std::string_view action) {
+  return std::ranges::any_of(menu.entries, [action](const auto& entry) {
+    return entry.enabled &&
+           ((entry.intent && entry.intent->action_id == action) ||
+            entry.submenu_id == action);
+  });
+}
+
+CommandMenu FilterActions(CommandMenu menu, std::u16string_view query) {
+  std::erase_if(menu.entries, [query](const auto& entry) {
+    return !MatchesDestination(entry.label, entry.detail, query);
+  });
+  if (menu.entries.size() > CommandSession::kMaxMenuEntries) {
+    menu.entries.resize(CommandSession::kMaxMenuEntries);
+  }
+  return menu;
+}
+
+WindowOpenDisposition InvocationDisposition(const CommandInvocation& invocation,
+                                            int event_flags) {
+  const auto base_disposition =
+      invocation.mode == CommandInvocationMode::kNewTab
+          ? WindowOpenDisposition::NEW_FOREGROUND_TAB
+          : WindowOpenDisposition::CURRENT_TAB;
+  return ui::DispositionFromEventFlags(event_flags, base_disposition);
+}
+
+bool PrepareCurrentTab(base::WeakPtr<Browser> owner,
+                       const std::optional<CommandLiveTarget>& source) {
+  if (!owner || !source ||
+      owner->session_id().id() != source->browser_session_id) {
+    return false;
+  }
+  const LiveTarget target = FindLiveTarget(owner->profile(), *source);
+  if (target.browser != owner.get() || !target.tab) {
+    return false;
+  }
+  const tabs::TabHandle handle = target.tab->GetHandle();
+  owner->tab_strip_model()->ActivateTabAt(
+      owner->tab_strip_model()->GetIndexOfTab(target.tab));
+  return owner && handle.Get() &&
+         owner->tab_strip_model()->GetActiveTab() == handle.Get();
+}
+
+bool CanOpenSplit(Browser* owner,
+                  tabs::TabInterface* source,
+                  HeliumSpaceService* spaces) {
+  const auto usable_member = [owner](tabs::TabInterface* tab) {
+    return owner && owner->type() == Browser::TYPE_NORMAL && tab &&
+           tab->GetBrowserWindowInterface() == owner &&
+           owner->tab_strip_model()->GetIndexOfTab(tab) !=
+               TabStripModel::kNoTab &&
+           !tabs::TemporaryTab::IsTemporary(tab->GetContents()) &&
+           !tab->GetGroup() && !tab->IsBlocked();
+  };
+  const auto is_saved = [spaces](tabs::TabInterface* tab) {
+    return spaces && spaces->IsPersistentItemTab(tab);
+  };
+  if (!usable_member(source)) {
+    return false;
+  }
+  if (!source->IsSplit()) {
+    return is_saved(source) || !source->IsPinned();
+  }
+  TabStripModel* model = owner->tab_strip_model();
+  const auto split = source->GetSplit();
+  if (!split || !model->ContainsSplit(*split)) {
+    return false;
+  }
+  const auto members = model->GetSplitData(*split)->ListTabs();
+  if (members.size() != 2 ||
+      std::ranges::find(members, source) == members.end() ||
+      !std::ranges::all_of(members, usable_member)) {
+    return false;
+  }
+  const auto saved_count = std::ranges::count_if(members, is_saved);
+  if (saved_count > 1) {
+    return false;
+  }
+  if (saved_count == 0) {
+    return std::ranges::none_of(members,
+                                [](auto* tab) { return tab->IsPinned(); });
+  }
+  const auto saved = std::ranges::find_if(members, is_saved);
+  const auto saved_kind = spaces->GetPersistentItemKind(*saved);
+  // A Favorite companion inherits PINNED structurally while it shares the
+  // saved split. It has no durable association. The shared Pin model preserves
+  // the saved member and normalizes the companion when the split changes.
+  return std::ranges::all_of(members, [is_saved, saved_kind](auto* tab) {
+    return is_saved(tab) || !tab->IsPinned() ||
+           saved_kind == PersistentRecordKind::kFavorite;
+  });
+}
+
+void CloseUnusedCopy(base::WeakPtr<Browser> owner,
+                     tabs::TabHandle candidate,
+                     HeliumSpaceService* spaces) {
+  if (!owner || !candidate.Get() ||
+      !IsOrdinaryStandalone(owner.get(), candidate.Get(), spaces)) {
+    return;
+  }
+  const int index = owner->tab_strip_model()->GetIndexOfTab(candidate.Get());
+  // No owner, router, or tab access is permitted after this close request.
+  owner->tab_strip_model()->CloseWebContentsAt(index,
+                                               TabCloseTypes::CLOSE_NONE);
+}
+
+CommandExecutionResult OpenSplitCopy(base::WeakPtr<Browser> owner,
+                                     CommandLiveTarget source_identity,
+                                     GURL url,
+                                     HeliumSpaceService* spaces) {
+  if (!owner || !url.SchemeIsHTTPOrHTTPS() ||
+      owner->session_id().id() != source_identity.browser_session_id) {
+    return Unavailable();
+  }
+  const LiveTarget source_target =
+      FindLiveTarget(owner->profile(), source_identity);
+  if (source_target.browser != owner.get() ||
+      !CanOpenSplit(owner.get(), source_target.tab, spaces)) {
+    return Unavailable();
+  }
+  const tabs::TabHandle source = source_target.tab->GetHandle();
+  const auto original_split = source.Get()->GetSplit();
+  std::optional<tabs::TabHandle> other;
+  if (original_split) {
+    if (!owner->tab_strip_model()->ContainsSplit(*original_split)) {
+      return Unavailable();
+    }
+    for (auto* tab :
+         owner->tab_strip_model()->GetSplitData(*original_split)->ListTabs()) {
+      if (tab != source.Get()) {
+        other = tab->GetHandle();
+      }
+    }
+  }
+  std::vector<tabs::TabHandle> existing_tabs;
+  for (int index = 0; index < owner->tab_strip_model()->count(); ++index) {
+    existing_tabs.push_back(
+        owner->tab_strip_model()->GetTabAtIndex(index)->GetHandle());
+  }
+
+  // A copy preserves an existing Pin or Favorite association and prevents a
+  // target in another split from being moved into the captured source's split.
+  NavigateParams params(owner.get(), url, ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::NEW_BACKGROUND_TAB;
+  params.window_action = NavigateParams::WindowAction::kNoAction;
+  Navigate(&params);
+  if (!owner) {
+    return Unavailable();
+  }
+  TabStripModel* model = owner->tab_strip_model();
+  const int inserted_index =
+      model->GetIndexOfWebContents(params.navigated_or_inserted_contents);
+  if (inserted_index == TabStripModel::kNoTab) {
+    return Unavailable();
+  }
+  const tabs::TabHandle candidate =
+      model->GetTabAtIndex(inserted_index)->GetHandle();
+  if (std::ranges::find(existing_tabs, candidate) != existing_tabs.end()) {
+    return Unavailable();
+  }
+  if (!source.Get() || !CanOpenSplit(owner.get(), source.Get(), spaces) ||
+      source.Get()->GetSplit() != original_split ||
+      !IsOrdinaryStandalone(owner.get(), candidate.Get(), spaces) ||
+      candidate == source ||
+      (other &&
+       (!other->Get() || other->Get()->GetSplit() != original_split))) {
+    CloseUnusedCopy(owner, candidate, spaces);
+    return Unavailable();
+  }
+
+  model->ActivateTabAt(model->GetIndexOfTab(source.Get()));
+  if (!owner || !source.Get() || !candidate.Get()) {
+    CloseUnusedCopy(owner, candidate, spaces);
+    return Unavailable();
+  }
+  model = owner->tab_strip_model();
+  if (model->GetActiveTab() != source.Get() ||
+      !CanOpenSplit(owner.get(), source.Get(), spaces) ||
+      !IsOrdinaryStandalone(owner.get(), candidate.Get(), spaces) ||
+      source.Get()->GetSplit() != original_split ||
+      (other &&
+       (!other->Get() || other->Get()->GetSplit() != original_split))) {
+    CloseUnusedCopy(owner, candidate, spaces);
+    return Unavailable();
+  }
+  // Revalidation immediately precedes the model methods' CHECK preconditions.
+  auto resulting_split = original_split;
+  if (original_split) {
+    model->UpdateTabInSplit(other->Get(), model->GetIndexOfTab(candidate.Get()),
+                            TabStripModel::SplitUpdateType::kReplace);
+  } else {
+    resulting_split = model->AddToNewSplit(
+        {model->GetIndexOfTab(candidate.Get())},
+        split_tabs::SplitTabVisualData(),
+        split_tabs::SplitTabCreatedSource::kKeyboardShortcut);
+  }
+  // AddToNewSplit may return an ID without creating a split. GetSplitData is
+  // a checked getter, so probe the model's membership before trusting that ID.
+  if (owner && source.Get() && candidate.Get() && resulting_split &&
+      owner->tab_strip_model()->ContainsSplit(*resulting_split) &&
+      source.Get()->GetSplit() == resulting_split &&
+      candidate.Get()->GetSplit() == resulting_split) {
+    return Succeeded(u"Opened in Split", true);
+  }
+  CloseUnusedCopy(owner, candidate, spaces);
+  return Unavailable();
+}
+
+CommandExecutionResult RevealFolder(base::WeakPtr<Browser> context,
+                                    HeliumSpaceService* spaces,
+                                    CommandPersistentTarget target) {
+  if (!context || !spaces) {
+    return Unavailable();
+  }
+  std::vector<std::string> ancestors;
+  if (IsPin(target.kind)) {
+    HeliumSpace* space = spaces->GetSpaceById(target.space_id);
+    if (!space || !FindFolderPath(space->pins(), target.item_id, &ancestors)) {
+      return Unavailable();
+    }
+  } else if (!FindFolderPath(spaces->GetFavoritesForBrowser(context.get()),
+                             target.item_id, &ancestors)) {
+    return Unavailable();
+  }
+  for (const std::string& id : ancestors) {
+    if (!context) {
+      return Unavailable();
+    }
+    bool collapsed = false;
+    if (IsPin(target.kind)) {
+      HeliumSpace* space = spaces->GetSpaceById(target.space_id);
+      const auto* folder =
+          space ? PersistentItemCodec::FindFolder(space->pins(), id) : nullptr;
+      if (!folder) {
+        return Unavailable();
+      }
+      collapsed = folder->collapsed;
+    } else {
+      const PersistentNodes favorites =
+          spaces->GetFavoritesForBrowser(context.get());
+      const auto* folder = PersistentItemCodec::FindFolder(favorites, id);
+      if (!folder) {
+        return Unavailable();
+      }
+      collapsed = folder->collapsed;
+    }
+    if (collapsed) {
+      const bool changed =
+          IsPin(target.kind)
+              ? spaces->TogglePinFolderCollapsedInSpace(context.get(),
+                                                        target.space_id, id)
+              : spaces->ToggleFolderCollapsed(
+                    context.get(), PersistentRecordKind::kFavorite, id);
+      if (!changed) {
+        return Unavailable();
+      }
+    }
+  }
+  if (IsPin(target.kind)) {
+    HeliumSpace* space = spaces->GetSpaceById(target.space_id);
+    return space && space->ActivateOrCreatePrimaryWindow()
+               ? Succeeded(u"Revealed folder", true)
+               : Unavailable();
+  }
+  if (!context) {
+    return Unavailable();
+  }
+  context->window()->Show();
+  return Succeeded(u"Revealed folder", true);
+}
+
+}  // namespace
+
+std::optional<GURL> BuildCommandSearchUrl(std::string_view scope_id,
+                                          std::u16string_view query) {
+  if (query.size() > CommandSession::kMaxQueryLength) {
+    return std::nullopt;
+  }
+  const std::u16string trimmed(base::TrimWhitespace(query, base::TRIM_ALL));
+  if (trimmed.empty()) {
+    return std::nullopt;
+  }
+  const std::string escaped =
+      base::EscapeQueryParamValue(base::UTF16ToUTF8(trimmed), false);
+  if (scope_id == kYouTubeScope) {
+    return GURL(base::StrCat(
+        {"https://www.youtube.com/results?search_query=", escaped}));
+  }
+  if (scope_id == kXScope) {
+    return GURL(
+        base::StrCat({"https://x.com/search?q=", escaped, "&src=typed_query"}));
+  }
+  if (scope_id == kChatGPTScope) {
+    // The web integration opens ChatGPT with a populated query. Sending the
+    // query remains a decision on that site's page.
+    return GURL(base::StrCat({"https://chatgpt.com/?q=", escaped}));
+  }
+  return std::nullopt;
+}
