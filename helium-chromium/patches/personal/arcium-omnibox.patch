+class CommandLocalCorpus::Impl final : public BrowserCollectionObserver,
+                                       public TabStripModelObserver {
+ public:
+  explicit Impl(Browser* browser)
+      : index_(
+            std::make_unique<CommandSearchIndex>(std::vector<CommandRecord>(),
+                                                 1)) {
+    if (!browser) {
+      return;
+    }
+    owner_ = browser->GetWeakPtr();
+    browsers_ = ProfileBrowserCollection::GetForProfile(browser->profile());
+    if (SavedItemsEligible(browser)) {
+      service_ =
+          helium::HeliumSpaceServiceFactory::GetForProfile(browser->profile());
+      if (service_) {
+        items_subscription_ =
+            service_->RegisterItemsChanged(base::BindRepeating(
+                &Impl::OnItemsChanged, weak_factory_.GetWeakPtr()));
+      }
+    }
+    collection_observation_.Observe(browsers_.get());
+    browsers_->ForEach([this](BrowserWindowInterface* window) {
+      ObserveModel(window->GetTabStripModel());
+      return true;
+    });
+    Refresh();
+  }
+
+  ~Impl() override {
+    weak_factory_.InvalidateWeakPtrs();
+    collection_observation_.Reset();
+    TabStripModelObserver::StopObservingAll(this);
+  }
+
+  const CommandSearchIndex& index() const { return *index_; }
+
+  std::optional<CommandLocalMetadata> Get(CommandRecordRef ref) const {
+    if (!index_->Get(ref)) {
+      return std::nullopt;
+    }
+    CHECK_LT(ref.slot, metadata_.size());
+    return metadata_[ref.slot];
+  }
+
+  std::vector<ArciumOmniboxItem> GetNativeItems() const {
+    return native_items_;
+  }
+
+  std::vector<CommandLiveTarget> FindLiveTargets(const GURL& url) const {
+    std::vector<CommandLiveTarget> targets;
+    if (!url.is_valid()) {
+      return targets;
+    }
+    for (const auto& item : live_items_) {
+      if (item.url != url) {
+        continue;
+      }
+      auto* contents = GetContents(item.target);
+      if (contents && contents->GetVisibleURL() == url) {
+        targets.push_back(item.target);
+      }
+    }
+    return targets;
+  }
+
+  content::WebContents* GetContents(const CommandLiveTarget& target) const {
+    if (!browsers_ || !SessionID::IsValidValue(target.browser_session_id) ||
+        !SessionID::IsValidValue(target.tab_session_id)) {
+      return nullptr;
+    }
+    auto* window = browsers_->FindBrowserWithID(
+        SessionID::FromSerializedValue(target.browser_session_id));
+    if (!window || window->IsDeleteScheduled()) {
+      return nullptr;
+    }
+    auto* model = window->GetTabStripModel();
+    if (!model) {
+      return nullptr;
+    }
+    for (int i = 0; i < model->count(); ++i) {
+      auto* contents = model->GetTabAtIndex(i)->GetContents();
+      if (sessions::SessionTabHelper::IdForTab(contents).id() ==
+          target.tab_session_id) {
+        return contents;
+      }
+    }
+    return nullptr;
+  }
+
+  std::optional<CommandRow> GetLiveRow(const CommandLiveTarget& target) const {
+    auto* contents = GetContents(target);
+    if (!contents) {
+      return std::nullopt;
+    }
+    auto* window = browsers_->FindBrowserWithID(
+        SessionID::FromSerializedValue(target.browser_session_id));
+    auto* browser = window->GetBrowserForMigrationOnly();
+    auto* tab = tabs::TabInterface::GetFromContents(contents);
+    std::optional<CommandPersistentTarget> saved_target;
+    bool at_saved_home = false;
+    if (service_ && SavedItemsEligible(browser)) {
+      const auto kind = service_->GetPersistentItemKind(tab);
+      const auto id = service_->GetPersistentItemId(tab);
+      if (kind && id) {
+        const bool pin = *kind == helium::PersistentRecordKind::kPin;
+        saved_target = CommandPersistentTarget{
+            pin ? CommandPersistentKind::kPin
+                : CommandPersistentKind::kFavorite,
+            pin ? std::string(service_->GetSpaceIdForBrowser(browser))
+                : std::string(),
+            *id};
+        for (const auto& item : native_items_) {
+          if (item.id == saved_target->item_id &&
+              item.space_id == saved_target->space_id &&
+              (item.kind == ArciumOmniboxItem::Kind::kPin) == pin) {
+            at_saved_home = item.url == contents->GetVisibleURL();
+            break;
+          }
+        }
+      }
+    }
+    auto row = ProjectLiveCommandRow(target, saved_target, at_saved_home);
+    row.title = TabTitle(*contents);
+    row.detail = base::UTF8ToUTF16(contents->GetVisibleURL().spec());
+    if (auto* driver =
+            favicon::ContentFaviconDriver::FromWebContents(contents)) {
+      const auto favicon = driver->GetFavicon();
+      if (!favicon.IsEmpty()) {
+        row.icon = favicon.AsImageSkia();
+      }
+    }
+    return row;
+  }
+
+  CommandInvocationSnapshot CaptureInvocation(
+      CommandInvocationMode mode) const {
+    CommandInvocationSnapshot snapshot;
+    snapshot.invocation.mode = mode;
+    auto* browser = OwnerBrowser();
+    if (!browser) {
+      return snapshot;
+    }
+    auto* tab = browser->tab_strip_model()->GetActiveTab();
+    auto* contents = tab ? tab->GetContents() : nullptr;
+    if (!contents) {
+      return snapshot;
+    }
+    snapshot.text = base::UTF8ToUTF16(contents->GetVisibleURL().spec());
+    const auto tab_id = sessions::SessionTabHelper::IdForTab(contents);
+    if (!browser->session_id().is_valid() || !tab_id.is_valid()) {
+      return snapshot;
+    }
+    const CommandLiveTarget target{browser->session_id().id(), tab_id.id()};
+    snapshot.invocation.source_tab = target;
+    auto projected = GetLiveRow(target);
+    if (!projected) {
+      return snapshot;
+    }
+    auto row = std::move(*projected);
+    row.kind = CommandRowKind::kCurrentTab;
+    snapshot.current_tab = std::move(row);
+    return snapshot;
+  }
+
+  base::CallbackListSubscription RegisterChanged(
+      base::RepeatingClosure callback) {
+    return changed_.Add(std::move(callback));
+  }
+
+ private:
+  struct LiveItem {
+    CommandLiveTarget target;
+    GURL url;
+  };
+
+  Browser* OwnerBrowser() const {
+    return owner_ && !owner_->IsDeleteScheduled()
+               ? owner_->GetBrowserForMigrationOnly()
+               : nullptr;
+  }
+
+  void ObserveModel(TabStripModel* model) {
+    if (model && observed_models_.insert(model).second) {
+      model->AddObserver(this);
+    }
+  }
+
+  void OnBrowserCreated(BrowserWindowInterface* browser) override {
+    ObserveModel(browser->GetTabStripModel());
+    ScheduleRefresh();
+  }
+
+  void OnBrowserClosed(BrowserWindowInterface* browser) override {
+    auto* model = browser->GetTabStripModel();
+    if (model && observed_models_.erase(model)) {
+      model->RemoveObserver(this);
+    }
+    if (owner_.get() == browser) {
+      owner_.reset();
+    }
+    ScheduleRefresh();
+  }
+
+  void OnTabStripModelChanged(
+      TabStripModel* model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override {
+    ScheduleRefresh();
+  }
+
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      int index,
+                      TabChangeType change_type) override {
+    if (change_type == TabChangeType::kLoadingOnly) {
+      return;
+    }
+    ScheduleRefresh();
+  }
+
+  void OnTabStripModelDestroyed(TabStripModel* model) override {
+    // TabStripModelObserver has already unregistered from the destroyed model.
+    observed_models_.erase(model);
+    ScheduleRefresh();
+  }
+
+  void OnItemsChanged(const helium::PersistentItemChange& change) {
+    ScheduleRefresh();
+  }
+
+  void ScheduleRefresh() {
+    if (refresh_posted_) {
+      return;
+    }
+    refresh_posted_ = true;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&Impl::Refresh, weak_factory_.GetWeakPtr()));
+  }
+
+  void AddItem(const helium::PersistentOmniboxItem& item,
+               base::Time now,
+               std::vector<CommandRecord>& records,
+               std::vector<CommandLocalMetadata>& metadata) {
+    const bool pin = item.kind == helium::PersistentRecordKind::kPin;
+    const CommandPersistentTarget target{
+        pin ? CommandPersistentKind::kPin : CommandPersistentKind::kFavorite,
+        item.space_id, item.id};
+    CommandRecord record;
+    record.id = CommandPersistentSelectionKey(target);
+    record.title =
+        item.title.empty() ? base::UTF8ToUTF16(item.url.spec()) : item.title;
+    record.url = base::UTF8ToUTF16(item.url.spec());
+    record.context = ItemContext(item);
+    record.category = pin ? u"Pin" : u"Favorite";
+    record.primary_scope_id = kSavedScope;
+    record.scope_ids = {kSavedScope};
+    AddSiteScope(record, item.url);
+    record.source_relevance =
+        PersistentItemRelevance(ItemTierBase(item.tier), 0, item.use_count,
+                                item.last_used_internal_value, now);
+    record.suggested = item.is_live || item.use_count > 0;
+    CommandLocalMetadata local;
+    local.target = target;
+    local.primary_icon =
+        item.is_live ? CommandPrimaryIcon::kSwitch : CommandPrimaryIcon::kGo;
+    local.primary_verb = item.is_live ? u"Switch" : pin ? u"Restore" : u"Open";
+    local.activity =
+        pin ? (item.is_live ? CommandActivity::kCircleDot
+                            : CommandActivity::kCircle)
+            : (item.is_live ? CommandActivity::kDot : CommandActivity::kNone);
+    records.push_back(std::move(record));
+    metadata.push_back(std::move(local));
+  }
+
+  void AddFolders(const helium::PersistentNodes& nodes,
+                  const std::string& space_id,
+                  const std::u16string& context,
+                  CommandPersistentKind kind,
+                  std::vector<CommandRecord>& records,
+                  std::vector<CommandLocalMetadata>& metadata) {
+    for (const auto& node : nodes) {
+      const auto* folder = std::get_if<helium::PersistentFolder>(&node.data);
+      if (!folder) {
+        continue;
+      }
+      const CommandPersistentTarget target{kind, space_id, folder->id};
+      CommandRecord record;
+      record.id = CommandPersistentSelectionKey(target);
+      record.title = folder->title;
+      record.context = context;
+      record.category = u"Folder";
+      record.primary_scope_id = kSavedScope;
+      record.scope_ids = {kSavedScope};
+      record.source_relevance = kFolderRelevance;
+      CommandLocalMetadata local;
+      local.target = target;
+      local.primary_icon = CommandPrimaryIcon::kAction;
+      local.primary_verb = u"Open";
+      records.push_back(std::move(record));
+      metadata.push_back(std::move(local));
+      AddFolders(folder->children, space_id,
+                 AppendBreadcrumb(context, folder->title), kind, records,
+                 metadata);
+    }
+  }
+
+  void Refresh() {
+    refresh_posted_ = false;
+    std::vector<CommandRecord> records;
+    std::vector<CommandLocalMetadata> metadata;
+    std::vector<ArciumOmniboxItem> native_items;
+    std::vector<LiveItem> live_items;
+    std::map<std::string, std::u16string> space_names;
+    std::map<std::string, GURL> saved_homes;
+    auto* browser = OwnerBrowser();
+    const bool saved_enabled = service_ && SavedItemsEligible(browser);
+    if (saved_enabled) {
+      const auto items = service_->GetOmniboxItemsForBrowser(browser);
+      records.reserve(items.size());
+      metadata.reserve(items.size());
+      native_items.reserve(items.size());
+      const auto now = base::Time::Now();
+      for (const auto& item : items) {
+        native_items.push_back(NativeItem(item));
+        AddItem(item, now, records, metadata);
+        saved_homes.emplace(records.back().id, item.url);
+      }
+      // GetSpaces() returns borrowed pointers. Copy each projection during this
+      // refresh and retain no pointer into an imported or mutable saved tree.
+      for (const auto* space : service_->GetSpaces()) {
+        space_names.emplace(space->id(), space->name());
+        AddFolders(space->pins(), space->id(), space->name(),
+                   CommandPersistentKind::kPinFolder, records, metadata);
+      }
+      AddFolders(service_->GetFavoritesForBrowser(browser), {}, u"All Spaces",
+                 CommandPersistentKind::kFavoriteFolder, records, metadata);
+    }
+    if (browser && browsers_) {
+      browsers_->ForEach([&](BrowserWindowInterface* window) {
+        if (window->IsDeleteScheduled() || !window->GetSessionID().is_valid()) {
+          return true;
+        }
+        auto* model = window->GetTabStripModel();
+        if (!model) {
+          return true;
+        }
+        ObserveModel(model);
+        std::u16string context;
+        std::string space_id;
+        if (saved_enabled) {
+          auto* legacy_browser = window->GetBrowserForMigrationOnly();
+          if (legacy_browser) {
+            space_id = service_->GetSpaceIdForBrowser(legacy_browser);
+            const auto space = space_names.find(space_id);
+            if (space != space_names.end()) {
+              context = space->second;
+            }
+          }
+        }
+        for (int i = 0; i < model->count(); ++i) {
+          auto* tab = model->GetTabAtIndex(i);
+          auto* contents = tab->GetContents();
+          if (!contents) {
+            continue;
+          }
+          const auto tab_id = sessions::SessionTabHelper::IdForTab(contents);
+          if (!tab_id.is_valid()) {
+            continue;
+          }
+          const CommandLiveTarget target{window->GetSessionID().id(),
+                                         tab_id.id()};
+          const GURL url = contents->GetVisibleURL();
+          live_items.push_back({target, url});
+          const auto persistent_kind =
+              saved_enabled ? service_->GetPersistentItemKind(tab)
+                            : std::nullopt;
+          if (persistent_kind) {
+            const auto id = service_->GetPersistentItemId(tab);
+            if (id) {
+              const bool pin =
+                  *persistent_kind == helium::PersistentRecordKind::kPin;
+              const CommandPersistentTarget saved_target{
+                  pin ? CommandPersistentKind::kPin
+                      : CommandPersistentKind::kFavorite,
+                  pin ? space_id : std::string(), *id};
+              const auto home =
+                  saved_homes.find(CommandPersistentSelectionKey(saved_target));
+              if (home != saved_homes.end() && home->second == url) {
+                // Deduplicate only a represented durable home. A Favorite
+                // visible in another Space and any away page keep a live row.
+                continue;
+              }
+            }
+          }
+          CommandRecord record;
+          record.id = LiveIdentity(target);
+          record.title = TabTitle(*contents);
+          record.url = base::UTF8ToUTF16(url.spec());
+          record.context = context;
+          record.category = u"Tab";
+          record.primary_scope_id = kOmniScope;
+          AddSiteScope(record, url);
+          record.source_relevance = kLiveTabRelevance;
+          record.suggested = true;
+          CommandLocalMetadata local;
+          local.target = target;
+          local.primary_icon = CommandPrimaryIcon::kSwitch;
+          local.primary_verb = u"Switch";
+          local.activity = LiveActivity(persistent_kind);
+          records.push_back(std::move(record));
+          metadata.push_back(std::move(local));
+        }
+        return true;
+      });
+    }
+    CHECK_EQ(records.size(), metadata.size());
+    index_ =
+        std::make_unique<CommandSearchIndex>(std::move(records), ++revision_);
+    metadata_ = std::move(metadata);
+    native_items_ = std::move(native_items);
+    live_items_ = std::move(live_items);
+    changed_.Notify();
+  }
+
+  base::WeakPtr<BrowserWindowInterface> owner_;
+  raw_ptr<ProfileBrowserCollection> browsers_ = nullptr;
+  raw_ptr<helium::HeliumSpaceService> service_ = nullptr;
+  std::unique_ptr<CommandSearchIndex> index_;
+  std::vector<CommandLocalMetadata> metadata_;
+  std::vector<ArciumOmniboxItem> native_items_;
+  std::vector<LiveItem> live_items_;
+  uint64_t revision_ = 1;
+  bool refresh_posted_ = false;
+  std::set<raw_ptr<TabStripModel, SetExperimental>> observed_models_;
+  base::CallbackListSubscription items_subscription_;
+  base::RepeatingClosureList changed_;
+  base::ScopedObservation<ProfileBrowserCollection, BrowserCollectionObserver>
+      collection_observation_{this};
+  base::WeakPtrFactory<Impl> weak_factory_{this};
+};
+
+CommandLocalCorpus::CommandLocalCorpus(Browser* browser)
+    : impl_(std::make_unique<Impl>(browser)) {}
+CommandLocalCorpus::~CommandLocalCorpus() = default;
+
+const CommandSearchIndex& CommandLocalCorpus::index() const {
+  return impl_->index();
+}
+
+std::optional<CommandLocalMetadata> CommandLocalCorpus::Get(
+    CommandRecordRef ref) const {
+  return impl_->Get(ref);
+}
+
+std::vector<ArciumOmniboxItem> CommandLocalCorpus::GetNativeItems() const {
+  return impl_->GetNativeItems();
+}
+
+std::vector<CommandLiveTarget> CommandLocalCorpus::FindLiveTargets(
+    const GURL& url) const {
+  return impl_->FindLiveTargets(url);
+}
+
+content::WebContents* CommandLocalCorpus::GetContents(
+    const CommandLiveTarget& target) const {
+  return impl_->GetContents(target);
+}
+
+std::optional<CommandRow> CommandLocalCorpus::GetLiveRow(
+    const CommandLiveTarget& target) const {
+  return impl_->GetLiveRow(target);
+}
+
+CommandInvocationSnapshot CommandLocalCorpus::CaptureInvocation(
+    CommandInvocationMode mode) const {
+  return impl_->CaptureInvocation(mode);
+}
+
+base::CallbackListSubscription CommandLocalCorpus::RegisterChanged(
+    base::RepeatingClosure callback) {
+  return impl_->RegisterChanged(std::move(callback));
+}
+
+}  // namespace arcium
