+      {model->GetIndexOfTab(companion)}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kKeyboardShortcut);
+  ASSERT_TRUE(model->ContainsSplit(initial_split));
+  ASSERT_TRUE(saved->GetSplit());
+  const PersistentNodes pins = space_->pins();
+  const CommandMenu actions = router_->ResolveActions(Pin(*id), {}, {});
+  for (const auto* action :
+       {command_action::kMoveToSpace, command_action::kMoveToFolder,
+        command_action::kCreateFolder, command_action::kConvertToTab,
+        command_action::kPromoteFavorite, command_action::kRemove}) {
+    EXPECT_FALSE(HasAction(actions, action)) << action;
+    EXPECT_FALSE(router_->Execute(Intent(Pin(*id), action)).success) << action;
+  }
+  EXPECT_TRUE(HasAction(actions, command_action::kReload));
+  EXPECT_TRUE(HasAction(actions, command_action::kClose));
+  EXPECT_TRUE(HasAction(actions, command_action::kCopyHome));
+  EXPECT_TRUE(HasAction(actions, command_action::kReturnHome));
+  EXPECT_TRUE(
+      router_->ResolveActions(Pin(*id), command_action::kMoveToSpace, {})
+          .entries.empty());
+  EXPECT_TRUE(
+      router_->ResolveActions(Pin(*id), command_action::kMoveToFolder, {})
+          .entries.empty());
+  EXPECT_FALSE(router_->Execute(retained_move).success);
+  EXPECT_EQ(pins, space_->pins());
+  EXPECT_EQ(saved, spaces_->GetLiveTabForPersistentItem(
+                       browser(), helium::PersistentRecordKind::kPin, *id));
+}
