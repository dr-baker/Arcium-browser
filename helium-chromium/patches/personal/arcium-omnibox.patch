+std::unique_ptr<CommandSession> CreateCommandSession(Browser* browser) {
+  CHECK(browser);
+  auto context = std::make_shared<ProductionContext>(browser);
+  auto registry = std::make_unique<CommandProviderRegistry>();
+  auto native = std::make_unique<NativeQueryProvider>(context);
+  const auto weak_native = native->GetWeakPtr();
+  CommandNativeActionCallbacks callbacks{
+      base::BindRepeating(
+          [](base::WeakPtr<NativeQueryProvider> owner,
+             const CommandNativeTarget& target) {
+            return owner ? owner->ResolveUrl(target) : std::optional<GURL>();
+          },
+          weak_native),
+      base::BindRepeating(
+          [](base::WeakPtr<NativeQueryProvider> owner,
+             const CommandNativeTarget& target,
+             WindowOpenDisposition disposition) {
+            return owner ? owner->Accept(target, disposition)
+                         : CommandExecutionResult{
+                               false, false,
+                               u"This result is no longer available"};
+          },
+          weak_native),
+      base::BindRepeating(
+          [](base::WeakPtr<NativeQueryProvider> owner,
+             const CommandNativeTarget& target) {
+            return owner && owner->CanOpenUrlCopy(target);
+          },
+          weak_native)};
+  // New integrations register here. Providers own descriptors, bounded async
+  // rows, cancellation, and any lazy actions they add to their opaque targets.
+  CHECK(registry->Register(std::move(native)));
+  CHECK(registry->Register(std::make_unique<LocalQueryProvider>(context)));
+  return CreateCommandSessionForProviders(
+      std::move(registry),
+      std::make_unique<RouterActionDelegate>(browser, std::move(callbacks)),
+      base::BindRepeating(
+          [](std::shared_ptr<ProductionContext> context,
+             CommandInvocationMode mode) {
+            return context->corpus.CaptureInvocation(mode);
+          },
+          context));
+}
