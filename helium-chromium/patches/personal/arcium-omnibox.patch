+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "chrome/browser/ui/omnibox/arcium_command_icon_cache.h"
+
+#include <algorithm>
+#include <deque>
+#include <map>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/bind_post_task.h"
+#include "skia/ext/image_operations.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/image/image_skia_operations.h"
+
+namespace arcium {
+
+class CommandIconCache::Impl {
+ public:
+  Impl(FetchCallback fetch, base::RepeatingClosure cancel)
+      : fetch_(std::move(fetch)), cancel_(std::move(cancel)) {}
+  ~Impl() { Cancel(); }
+
+  gfx::ImageSkia Get(const GURL& url,
+                     bool engine,
+                     base::RepeatingClosure refreshed) {
+    if (!url.is_valid() || url.spec().size() > kMaxUrlLength) {
+      return {};
+    }
+    const std::string key = (engine ? "icon:" : "page:") + url.spec();
+    if (const auto found = cache_.find(key); found != cache_.end()) {
+      std::erase(lru_, key);
+      lru_.push_back(key);
+      return found->second;
+    }
+    const size_t maximum = engine ? kMaxEngineRequests : kMaxPageRequests;
+    const size_t pending = std::ranges::count_if(
+        pending_,
+        [engine](const auto& request) { return request.second == engine; });
+    if (pending >= maximum || pending_.contains(key) || fetch_.is_null()) {
+      return {};
+    }
+    pending_.emplace(key, engine);
+    // Even an injected synchronous fetcher cannot reenter a row projection.
+    fetch_.Run(url, engine,
+               base::BindPostTaskToCurrentDefault(
+                   base::BindOnce(&Impl::Fetched, weak_factory_.GetWeakPtr(),
+                                  key, std::move(refreshed))));
+    return {};
+  }
+
+  void Cancel() {
+    weak_factory_.InvalidateWeakPtrs();
+    pending_.clear();
+    if (!cancel_.is_null()) {
+      cancel_.Run();
+    }
+  }
+  size_t pending() const { return pending_.size(); }
+  size_t cached() const { return cache_.size(); }
+
+ private:
+  void Fetched(std::string key,
+               base::RepeatingClosure refreshed,
+               gfx::ImageSkia image) {
+    if (!pending_.erase(key)) {
+      return;
+    }
+    if (!image.isNull()) {
+      image = gfx::ImageSkiaOperations::CreateResizedImage(
+          image, skia::ImageOperations::RESIZE_BEST, gfx::Size(16, 16));
+    }
+    while (cache_.size() >= kMaxCachedIcons) {
+      cache_.erase(lru_.front());
+      lru_.pop_front();
+    }
+    // Cache an empty response too; a missing favicon never repeats per
+    // keypress.
+    cache_.emplace(key, std::move(image));
+    lru_.push_back(key);
+    if (!refreshed.is_null()) {
+      refreshed.Run();
+    }
+  }
+
+  FetchCallback fetch_;
+  base::RepeatingClosure cancel_;
+  std::map<std::string, gfx::ImageSkia> cache_;
+  std::deque<std::string> lru_;
+  std::map<std::string, bool> pending_;
+  base::WeakPtrFactory<Impl> weak_factory_{this};
+};
+
+CommandIconCache::CommandIconCache(FetchCallback fetch,
+                                   base::RepeatingClosure cancel)
+    : impl_(std::make_unique<Impl>(std::move(fetch), std::move(cancel))) {}
+CommandIconCache::~CommandIconCache() = default;
+gfx::ImageSkia CommandIconCache::GetPageIcon(const GURL& url,
+                                             base::RepeatingClosure refreshed) {
+  return impl_->Get(url, false, std::move(refreshed));
+}
+gfx::ImageSkia CommandIconCache::GetEngineIcon(
+    const GURL& url,
+    base::RepeatingClosure refreshed) {
+  return impl_->Get(url, true, std::move(refreshed));
+}
+void CommandIconCache::Cancel() {
+  impl_->Cancel();
+}
+size_t CommandIconCache::pending_for_testing() const {
+  return impl_->pending();
+}
+size_t CommandIconCache::cached_for_testing() const {
+  return impl_->cached();
+}
+
+}  // namespace arcium
