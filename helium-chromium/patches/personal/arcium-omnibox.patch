+AutocompleteMatch MakeNativeMatch(const char* url, int relevance) {
+  AutocompleteMatch match(nullptr, relevance, false,
+                          AutocompleteMatchType::HISTORY_URL);
+  match.destination_url = GURL(url);
+  match.fill_into_edit = u"original edit";
+  return match;
+}
+
+AutocompleteMatch MakeNativePostMatch(std::u16string terms,
+                                      std::string mime,
+                                      std::string body) {
+  auto match = MakeNativeMatch("https://search.test/search", 1500);
+  match.type = AutocompleteMatchType::SEARCH_SUGGEST;
+  match.keyword = u"configured-engine";
+  match.fill_into_edit = terms;
+  match.contents = terms;
+  match.search_terms_args =
+      std::make_unique<TemplateURLRef::SearchTermsArgs>(std::move(terms));
+  match.post_content = std::make_unique<TemplateURLRef::PostContent>(
+      std::move(mime), std::move(body));
+  return match;
+}
