+class FaviconFetcher {
+ public:
+  explicit FaviconFetcher(Profile* profile)
+      : service_(FaviconServiceFactory::GetForProfile(
+            profile,
+            ServiceAccessType::EXPLICIT_ACCESS)) {}
+  void Fetch(const GURL& url,
+             bool engine,
+             base::OnceCallback<void(gfx::ImageSkia)> callback) {
+    if (!service_) {
+      std::move(callback).Run({});
+      return;
+    }
+    auto reply = base::BindOnce(
+        [](base::OnceCallback<void(gfx::ImageSkia)> callback,
+           const favicon_base::FaviconImageResult& result) {
+          std::move(callback).Run(result.image.IsEmpty()
+                                      ? gfx::ImageSkia()
+                                      : result.image.AsImageSkia());
+        },
+        std::move(callback));
+    if (engine) {
+      service_->GetFaviconImage(url, std::move(reply), &tracker_);
+    } else {
+      service_->GetFaviconImageForPageURL(url, std::move(reply), &tracker_);
+    }
+  }
+  void Cancel() { tracker_.TryCancelAll(); }
+
+ private:
+  raw_ptr<favicon::FaviconService> service_;
+  base::CancelableTaskTracker tracker_;
+};
