+TEST_F(ArciumCommandNativeResultLeaseTest,
+       PinnedMatchAndInputSurviveResultReplacementAndCancel) {
+  AutocompleteResult original;
+  original.AppendMatches({MakeNativeMatch("https://first.test/", 1500),
+                          MakeNativeMatch("https://selected.test/", 10)});
+  auto original_input = MakeInput(u"original query", "https://source.test/");
+  const CommandNativeTarget pinned_target{lease_.NewRevision(), 1};
+  size_t finalize_count = 0;
+  auto finalize = base::BindLambdaForTesting([&](AutocompleteMatch* match) {
+    ++finalize_count;
+    match->fill_into_edit = u"prepared navigation";
+  });
+  ASSERT_TRUE(
+      lease_.Resolve(pinned_target, original, original_input, finalize, true));
+  EXPECT_EQ(1u, lease_.retained_count_for_testing());
+  original.match_at(1)->destination_url = GURL("https://mutated.test/");
+  original_input.set_current_url(GURL("https://changed-source.test/"));
+
+  AutocompleteResult replacement;
+  replacement.AppendMatches(
+      {MakeNativeMatch("https://new-first.test/", 900),
+       MakeNativeMatch("https://new-second.test/", 2000)});
+  auto replacement_input = MakeInput(u"new query", "https://new-source.test/");
+  const CommandNativeTarget current_target{lease_.NewRevision(), 1};
+  const auto pinned = lease_.Resolve(pinned_target, replacement,
+                                     replacement_input, finalize, false);
+  ASSERT_TRUE(pinned);
+  EXPECT_EQ(GURL("https://selected.test/"), pinned->match.destination_url);
+  EXPECT_EQ(10, pinned->match.relevance);
+  EXPECT_EQ(u"prepared navigation", pinned->match.fill_into_edit);
+  EXPECT_EQ(u"original query", pinned->input.text());
+  EXPECT_EQ(GURL("https://source.test/"), pinned->input.current_url());
+  EXPECT_EQ(1u, finalize_count);
+  EXPECT_FALSE(lease_.Resolve({pinned_target.result_revision, 0}, replacement,
+                              replacement_input, finalize, false));
+  const auto current = lease_.Resolve(current_target, replacement,
+                                      replacement_input, finalize, false);
+  ASSERT_TRUE(current);
+  EXPECT_EQ(GURL("https://new-second.test/"), current->match.destination_url);
+  EXPECT_EQ(u"new query", current->input.text());
+  EXPECT_EQ(1u, lease_.retained_count_for_testing());
+
+  lease_.InvalidateCurrent();
+  EXPECT_FALSE(lease_.Resolve(current_target, replacement, replacement_input,
+                              finalize, false));
+  EXPECT_TRUE(lease_.Resolve(pinned_target, replacement, replacement_input,
+                             finalize, false));
+  EXPECT_EQ(2u, finalize_count);
+  lease_.Reset();
+  EXPECT_EQ(0u, lease_.retained_count_for_testing());
+  EXPECT_FALSE(lease_.Resolve(pinned_target, replacement, replacement_input,
+                              finalize, false));
+}
