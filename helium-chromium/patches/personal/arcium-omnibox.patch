+class ArciumCommandNativeResultLeaseTest : public testing::Test {
+ protected:
+  AutocompleteInput MakeInput(std::u16string text, const char* current_url) {
+    AutocompleteInput input(text, metrics::OmniboxEventProto::OTHER,
+                            scheme_classifier_);
+    input.set_current_url(GURL(current_url));
+    return input;
+  }
+
+  void PostConfirmation(uint64_t epoch,
+                        CommandNativeTarget target,
+                        const AutocompleteResult& result,
+                        const AutocompleteInput& input,
+                        std::vector<GURL>& accepted_urls) {
+    auto confirmation = base::BindLambdaForTesting(
+        [this, epoch, target, &result, &input, &accepted_urls]() mutable {
+          if (!lease_.IsAcceptanceCurrent(epoch)) {
+            return;
+          }
+          const auto selection =
+              lease_.Resolve(target, result, input, {}, false);
+          if (selection) {
+            accepted_urls.push_back(selection->match.destination_url);
+          }
+        });
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, std::move(confirmation));
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  TestSchemeClassifier scheme_classifier_;
+  CommandNativeResultLease lease_;
+};
