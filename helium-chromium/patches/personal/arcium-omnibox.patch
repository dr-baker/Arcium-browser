+struct PendingIconRequest {
+  GURL url;
+  bool engine;
+  base::OnceCallback<void(gfx::ImageSkia)> callback;
+};
+
+class ArciumCommandIconCacheTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    cache_ = std::make_unique<CommandIconCache>(
+        base::BindLambdaForTesting(
+            [this](const GURL& url, bool engine,
+                   base::OnceCallback<void(gfx::ImageSkia)> callback) {
+              requests_.push_back({url, engine, std::move(callback)});
+            }),
+        base::BindLambdaForTesting([this] { ++cancel_count_; }));
+  }
+
+  base::RepeatingClosure Refreshed() {
+    return base::BindLambdaForTesting([this] { ++refresh_count_; });
+  }
+
+  void Complete(size_t index) {
+    ASSERT_LT(index, requests_.size());
+    ASSERT_FALSE(requests_[index].callback.is_null());
+    std::move(requests_[index].callback).Run(gfx::ImageSkia());
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  std::vector<PendingIconRequest> requests_;
+  size_t cancel_count_ = 0;
+  size_t refresh_count_ = 0;
+  std::unique_ptr<CommandIconCache> cache_;
+};
+
+TEST_F(ArciumCommandIconCacheTest,
+       FetchesOnlyRequestedVisibleIconsAndCachesMisses) {
+  EXPECT_TRUE(requests_.empty());
+  EXPECT_EQ(0u, cache_->pending_for_testing());
+  EXPECT_EQ(0u, cache_->cached_for_testing());
+  cache_->GetPageIcon(GURL(), Refreshed());
+  EXPECT_TRUE(requests_.empty());
+
+  const GURL url("https://visible.test/");
+  EXPECT_TRUE(cache_->GetPageIcon(url, Refreshed()).isNull());
+  cache_->GetPageIcon(url, Refreshed());
+  ASSERT_EQ(1u, requests_.size());
+  EXPECT_EQ(url, requests_[0].url);
+  EXPECT_FALSE(requests_[0].engine);
+  cache_->GetEngineIcon(url, Refreshed());
+  ASSERT_EQ(2u, requests_.size());
+  EXPECT_TRUE(requests_[1].engine);
+  EXPECT_EQ(2u, cache_->pending_for_testing());
+
+  Complete(0);
+  EXPECT_EQ(0u, refresh_count_);
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(1u, refresh_count_);
+  EXPECT_EQ(1u, cache_->cached_for_testing());
+  for (size_t i = 0; i < 20; ++i) {
+    EXPECT_TRUE(cache_->GetPageIcon(url, Refreshed()).isNull());
+  }
+  EXPECT_EQ(2u, requests_.size());
+  Complete(1);
+  task_environment_.RunUntilIdle();
+  cache_->GetEngineIcon(url, Refreshed());
+  EXPECT_EQ(2u, requests_.size());
+  EXPECT_EQ(2u, cache_->cached_for_testing());
+  EXPECT_EQ(0u, cache_->pending_for_testing());
+}
+
+TEST_F(ArciumCommandIconCacheTest,
+       OversizedValidUrlsNeverFetchOrEnterTheCache) {
+  const std::string prefix = "https://visible.test/";
+  const GURL oversized(
+      prefix +
+      std::string(CommandIconCache::kMaxUrlLength + 1 - prefix.size(), 'a'));
+  ASSERT_TRUE(oversized.is_valid());
+  ASSERT_GT(oversized.spec().size(), CommandIconCache::kMaxUrlLength);
+  for (size_t i = 0; i < 3; ++i) {
+    EXPECT_TRUE(cache_->GetPageIcon(oversized, Refreshed()).isNull());
+    EXPECT_TRUE(cache_->GetEngineIcon(oversized, Refreshed()).isNull());
+  }
+  task_environment_.RunUntilIdle();
+  EXPECT_TRUE(requests_.empty());
+  EXPECT_EQ(0u, cache_->pending_for_testing());
+  EXPECT_EQ(0u, cache_->cached_for_testing());
+  EXPECT_EQ(0u, refresh_count_);
+
+  const std::string boundary_path(
+      CommandIconCache::kMaxUrlLength - prefix.size(), 'a');
+  const GURL boundary(prefix + boundary_path);
+  ASSERT_TRUE(boundary.is_valid());
+  ASSERT_EQ(CommandIconCache::kMaxUrlLength, boundary.spec().size());
+  cache_->GetPageIcon(boundary, Refreshed());
+  cache_->GetEngineIcon(boundary, Refreshed());
+  ASSERT_EQ(2u, requests_.size());
+  Complete(0);
+  Complete(1);
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(2u, cache_->cached_for_testing());
+  EXPECT_EQ(0u, cache_->pending_for_testing());
+}
+
+TEST_F(ArciumCommandIconCacheTest, LimitsPageAndEngineRequestsIndependently) {
+  for (size_t i = 0; i < CommandIconCache::kMaxPageRequests + 5; ++i) {
+    cache_->GetPageIcon(GURL("https://page.test/" + std::to_string(i)),
+                        Refreshed());
+  }
+  EXPECT_EQ(CommandIconCache::kMaxPageRequests, requests_.size());
+  for (size_t i = 0; i < CommandIconCache::kMaxEngineRequests + 5; ++i) {
+    cache_->GetEngineIcon(GURL("https://engine.test/" + std::to_string(i)),
+                          Refreshed());
+  }
+  EXPECT_EQ(
+      CommandIconCache::kMaxPageRequests + CommandIconCache::kMaxEngineRequests,
+      requests_.size());
+  EXPECT_EQ(9u, cache_->pending_for_testing());
+  EXPECT_EQ(8, std::count_if(requests_.begin(), requests_.end(),
+                             [](const PendingIconRequest& request) {
+                               return !request.engine;
+                             }));
+  EXPECT_EQ(1, std::count_if(requests_.begin(), requests_.end(),
+                             [](const PendingIconRequest& request) {
+                               return request.engine;
+                             }));
+
+  Complete(0);
+  EXPECT_EQ(9u, cache_->pending_for_testing());
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(8u, cache_->pending_for_testing());
+  cache_->GetPageIcon(GURL("https://page.test/8"), Refreshed());
+  EXPECT_EQ(10u, requests_.size());
+  EXPECT_EQ(9u, cache_->pending_for_testing());
+  cache_->GetEngineIcon(GURL("https://engine.test/1"), Refreshed());
+  EXPECT_EQ(10u, requests_.size());
+}
+
+TEST_F(ArciumCommandIconCacheTest, CacheAndPendingStorageStayBounded) {
+  for (size_t i = 0; i < CommandIconCache::kMaxCachedIcons + 16; ++i) {
+    const GURL url("https://cached.test/" + std::to_string(i));
+    if (i % 2 == 0) {
+      cache_->GetPageIcon(url, Refreshed());
+    } else {
+      cache_->GetEngineIcon(url, Refreshed());
+    }
+    EXPECT_LE(cache_->pending_for_testing(), CommandIconCache::kMaxCachedIcons);
+    EXPECT_LE(cache_->cached_for_testing(), CommandIconCache::kMaxCachedIcons);
+    ASSERT_EQ(i + 1, requests_.size());
+    Complete(i);
+    task_environment_.RunUntilIdle();
+    EXPECT_EQ(0u, cache_->pending_for_testing());
+    EXPECT_LE(cache_->cached_for_testing(), CommandIconCache::kMaxCachedIcons);
+  }
+  EXPECT_EQ(CommandIconCache::kMaxCachedIcons, cache_->cached_for_testing());
+  const size_t fetched = requests_.size();
+  cache_->GetEngineIcon(GURL("https://cached.test/79"), Refreshed());
+  EXPECT_EQ(fetched, requests_.size());
+  cache_->GetPageIcon(GURL("https://cached.test/0"), Refreshed());
+  EXPECT_EQ(fetched + 1, requests_.size());
+  EXPECT_EQ(CommandIconCache::kMaxCachedIcons, cache_->cached_for_testing());
+}
+
+TEST_F(ArciumCommandIconCacheTest, CacheHitsPreserveTheRecentlyUsedIcon) {
+  for (size_t i = 0; i < CommandIconCache::kMaxCachedIcons; ++i) {
+    cache_->GetPageIcon(GURL("https://cached.test/" + std::to_string(i)),
+                        Refreshed());
+    Complete(i);
+    task_environment_.RunUntilIdle();
+  }
+  cache_->GetPageIcon(GURL("https://cached.test/0"), Refreshed());
+  EXPECT_EQ(CommandIconCache::kMaxCachedIcons, requests_.size());
+  cache_->GetPageIcon(GURL("https://cached.test/64"), Refreshed());
+  Complete(CommandIconCache::kMaxCachedIcons);
+  task_environment_.RunUntilIdle();
+  cache_->GetPageIcon(GURL("https://cached.test/0"), Refreshed());
+  EXPECT_EQ(CommandIconCache::kMaxCachedIcons + 1, requests_.size());
+  cache_->GetPageIcon(GURL("https://cached.test/1"), Refreshed());
+  EXPECT_EQ(CommandIconCache::kMaxCachedIcons + 2, requests_.size());
+}
+
+TEST_F(ArciumCommandIconCacheTest,
+       CancelInvalidatesQueuedCompletionBeforeTheSameUrlIsRequestedAgain) {
+  const GURL url("https://visible.test/");
+  cache_->GetPageIcon(url, Refreshed());
+  Complete(0);
+  cache_->Cancel();
+  EXPECT_EQ(1u, cancel_count_);
+  EXPECT_EQ(0u, cache_->pending_for_testing());
+  cache_->GetPageIcon(url, Refreshed());
+  ASSERT_EQ(2u, requests_.size());
+
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(0u, refresh_count_);
+  EXPECT_EQ(0u, cache_->cached_for_testing());
+  EXPECT_EQ(1u, cache_->pending_for_testing());
+  Complete(1);
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(1u, refresh_count_);
+  EXPECT_EQ(1u, cache_->cached_for_testing());
+  EXPECT_EQ(0u, cache_->pending_for_testing());
+}
+
+TEST_F(ArciumCommandIconCacheTest, DestructionInvalidatesUnfinishedFetches) {
+  cache_->GetPageIcon(GURL("https://visible.test/"), Refreshed());
+  cache_.reset();
+  EXPECT_EQ(1u, cancel_count_);
+  Complete(0);
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(0u, refresh_count_);
+}
+
+TEST_F(ArciumCommandIconCacheTest,
+       SynchronousFetcherPostsRefreshAfterGetReturns) {
+  bool get_returned = false;
+  size_t fetched = 0;
+  CommandIconCache synchronous_cache(
+      base::BindLambdaForTesting(
+          [&](const GURL&, bool,
+              base::OnceCallback<void(gfx::ImageSkia)> callback) {
+            ++fetched;
+            std::move(callback).Run(gfx::ImageSkia());
+          }),
+      base::RepeatingClosure());
+  synchronous_cache.GetPageIcon(GURL("https://visible.test/"),
+                                base::BindLambdaForTesting([&] {
+                                  EXPECT_TRUE(get_returned);
+                                  ++refresh_count_;
+                                }));
+  EXPECT_EQ(1u, fetched);
+  EXPECT_EQ(0u, refresh_count_);
+  EXPECT_EQ(1u, synchronous_cache.pending_for_testing());
+  EXPECT_EQ(0u, synchronous_cache.cached_for_testing());
+  get_returned = true;
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(1u, refresh_count_);
+  EXPECT_EQ(0u, synchronous_cache.pending_for_testing());
+  EXPECT_EQ(1u, synchronous_cache.cached_for_testing());
+}
