+TEST(ArciumCommandNativeMatchTest,
+     SupportedProjectionPreservesOriginalOrdinalsOrderDefaultAndCap) {
+  ACMatches matches;
+  for (size_t i = 0; i < 14; ++i) {
+    auto match = MakeNativeMatch("https://result.test/",
+                                 i == 0 ? 10 : 1500 - static_cast<int>(i));
+    match.allowed_to_be_default_match = i != 2;
+    if (i == 1) {
+      match.type = AutocompleteMatchType::STARTER_PACK;
+    } else if (i == 3) {
+      match.takeover_action =
+          base::MakeRefCounted<FakeOmniboxAction>(OmniboxActionId::SITE_SEARCH);
+    }
+    matches.push_back(std::move(match));
+  }
+  AutocompleteResult result;
+  result.AppendMatches(matches);
+  ASSERT_EQ(result.match_at(0), result.default_match());
+  const auto revision = base::UnguessableToken::Create();
+  const auto rows = ProjectSupportedNativeCommandRows(result, revision, 100);
+  const std::vector<uint32_t> expected_ordinals = {0, 2, 4, 5, 6, 7, 8, 9};
+  ASSERT_EQ(expected_ordinals.size(), rows.size());
+  EXPECT_EQ(CommandSession::kMaxResults, rows.size());
+  for (size_t i = 0; i < rows.size(); ++i) {
+    EXPECT_EQ(revision, rows[i].result_revision);
+    EXPECT_EQ(expected_ordinals[i], rows[i].ordinal);
+    const auto* original = result.match_at(expected_ordinals[i]);
+    EXPECT_EQ(original->relevance, rows[i].relevance);
+    EXPECT_EQ(static_cast<int>(original->type), rows[i].match_type);
+    EXPECT_EQ(original->allowed_to_be_default_match, rows[i].allowed_default);
+    EXPECT_EQ(i == 0, rows[i].is_default);
+  }
+  const auto limited = ProjectSupportedNativeCommandRows(result, revision, 3);
+  ASSERT_EQ(3u, limited.size());
+  EXPECT_EQ(4u, limited.back().ordinal);
+  EXPECT_TRUE(ProjectSupportedNativeCommandRows(result, revision, 0).empty());
+}
