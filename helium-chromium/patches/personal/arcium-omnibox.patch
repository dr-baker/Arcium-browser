+
+class NativeQueryProvider final : public CommandQueryProvider,
+                                  public AutocompleteController::Observer,
+                                  public TemplateURLServiceObserver {
+ public:
+  explicit NativeQueryProvider(std::shared_ptr<ProductionContext> context)
+      : context_(std::move(context)),
+        engines_(TemplateURLServiceFactory::GetForProfile(
+            context_->browser()->profile())) {
+    if (engines_) {
+      engine_observation_.Observe(engines_);
+      UpdateEngine();
+      engines_->Load();
+    }
+    corpus_subscription_ = context_->corpus.RegisterChanged(base::BindRepeating(
+        &NativeQueryProvider::OnCorpusChanged, weak_factory_.GetWeakPtr()));
+  }
+  ~NativeQueryProvider() override {
+    Cancel();
+    if (controller_) {
+      controller_->RemoveObserver(this);
+    }
+    engine_observation_.Reset();
+  }
+  std::string_view id() const override { return kNativeCommandProvider; }
+  std::vector<CommandScopeDescriptor> GetScopes() const override {
+    gfx::ImageSkia web_icon;
+    if (context_->browser()) {
+      web_icon = context_->icons.GetEngineIcon(
+          engine_icon_url_, base::BindRepeating(&NativeQueryProvider::Publish,
+                                                weak_factory_.GetWeakPtr()));
+    }
+    if (web_icon.isNull()) {
+      web_icon = ScopeIcon(kWebScope);
+    }
+    return {
+        {kOmniScope, kNativeCommandProvider, u"Omni", ScopeIcon(kOmniScope),
+         kOmniTint, u"Search tabs, Pins, Favorites and the web", u"Search",
+         u"Search all browser results"},
+        {kWebScope, kNativeCommandProvider, engine_name_, web_icon, kOmniTint,
+         u"Search " + engine_name_ + u"…", u"Search " + engine_name_,
+         u"Search the web with " + engine_name_}};
+  }
+  void Start(CommandQuery query,
+             CommandProviderPublishCallback publish) override {
+    // Context/epoch exist before Start's synchronous observer notification.
+    query_ = std::move(query);
+    if (!context_->browser()) {
+      publish.Run({});
+      return;
+    }
+    if (query_.scope_id == kOmniScope && query_.text.empty()) {
+      // Empty Omni suggestions read the compact local snapshot. Native
+      // providers are created and started only after the user types.
+      publish.Run({});
+      return;
+    }
+    EnsureController(query_.scope_id);
+    publish_ = std::move(publish);
+    query_started_ = base::TimeTicks::Now();
+    const AutocompleteInput input = CreateInput();
+    controller_->Start(input);
+  }
+  void Cancel() override {
+    ++query_generation_;
+    publish_.Reset();
+    context_->icons.Cancel();
+    if (controller_) {
+      controller_->Stop(AutocompleteStopReason::kClobbered);
+    }
+    lease_.InvalidateCurrent();
+  }
+  void ResetRetainedTarget() override { lease_.Reset(); }
+  base::WeakPtr<NativeQueryProvider> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+  std::optional<GURL> ResolveUrl(const CommandNativeTarget& target) {
+    if (!context_->browser()) {
+      return std::nullopt;
+    }
+    auto selection = Resolve(target, true);
+    return selection ? std::optional(selection->match.destination_url)
+                     : std::nullopt;
+  }
+  bool CanOpenUrlCopy(const CommandNativeTarget& target) {
+    if (!context_->browser()) {
+      return false;
+    }
+    const auto selection = Resolve(target, true);
+    return selection && CanCommandNativeOpenUrlCopy(selection->match);
+  }
+  CommandExecutionResult Accept(const CommandNativeTarget& target,
+                                WindowOpenDisposition disposition) {
+    auto selection = Resolve(target, true);
+    if (!selection) {
+      return {false, false, u"This result is no longer available"};
+    }
+    if (selection->match.type == AutocompleteMatchType::OPEN_TAB) {
+      return {false, false, u"Choose the tab to switch to"};
+    }
+    return AcceptSelection(*selection, disposition, false);
+  }
+
+  void OnResultChanged(AutocompleteController* controller,
+                       bool default_match_changed) override {
+    // EVERY native notification changes authority, even within one query.
+    lease_.NewRevision();
+    Publish();
+  }
+  void OnTemplateURLServiceChanged() override {
+    UpdateEngine();
+    context_->icons.Cancel();
+    OnCorpusChanged();
+  }
+  void OnTemplateURLServiceShuttingDown() override {
+    engine_observation_.Reset();
+    engines_ = nullptr;
+  }
+
+ private:
+  void EnsureController(std::string_view scope_id) {
+    const bool web = scope_id == kWebScope;
+    if (controller_ && web == controller_is_web_) {
+      return;
+    }
+    if (controller_) {
+      controller_->RemoveObserver(this);
+      controller_->Stop(AutocompleteStopReason::kClobbered);
+    }
+    int types = AutocompleteClassifier::DefaultOmniboxProviders();
+    if (web) {
+      types &= AutocompleteProvider::TYPE_KEYWORD |
+               AutocompleteProvider::TYPE_SEARCH |
+               AutocompleteProvider::TYPE_ZERO_SUGGEST |
+               AutocompleteProvider::TYPE_ON_DEVICE_HEAD;
+    }
+    AutocompleteControllerConfig config{.provider_types = types};
+    config.unscoped_open_tab_suggestions = !web;
+    controller_ = std::make_shared<AutocompleteController>(
+        std::make_unique<CachedAutocompleteClient>(context_), config);
+    controller_is_web_ = web;
+    controller_->AddObserver(this);
+  }
+  std::shared_ptr<AutocompleteController> TakeController() {
+    ++query_generation_;
+    lease_.Reset();
+    publish_.Reset();
+    context_->icons.Cancel();
+    auto controller = std::move(controller_);
+    if (controller) {
+      controller->RemoveObserver(this);
+      controller->Stop(AutocompleteStopReason::kInteraction);
+    }
+    return controller;
+  }
+  AutocompleteInput CreateInput() const {
+    AutocompleteInput input = CreateCommandNativeInput(
+        query_.text,
+        query_.scope_id == kWebScope ? engine_keyword_ : std::u16string(),
+        ChromeAutocompleteSchemeClassifier(context_->browser()->profile()));
+    if (query_.invocation.source_tab) {
+      if (auto* contents =
+              context_->corpus.GetContents(*query_.invocation.source_tab)) {
+        input.set_current_url(contents->GetLastCommittedURL());
+        input.set_current_title(contents->GetTitle());
+      }
+    }
+    return input;
+  }
+  void UpdateEngine() {
+    const auto* engine =
+        engines_ ? engines_->GetDefaultSearchProvider() : nullptr;
+    engine_name_ =
+        engine ? engine->AdjustedShortNameForLocaleDirection() : u"Web";
+    engine_icon_url_ = engine ? engine->favicon_url() : GURL();
+    engine_keyword_ = engine ? engine->keyword() : std::u16string();
+  }
+  void OnCorpusChanged() {
+    if (publish_.is_null() || !controller_ || !context_->browser()) {
+      return;
+    }
+    // The saved snapshot/tab context changed, so ask the native owner to run
+    // its normal query again. Keystrokes never rebuild the saved projection.
+    const AutocompleteInput input = CreateInput();
+    controller_->Start(input);
+  }
+  std::optional<CommandNativeSelection> Resolve(
+      const CommandNativeTarget& target,
+      bool retain) {
+    if (!controller_) {
+      return lease_.Resolve(target, AutocompleteResult(), AutocompleteInput(),
+                            {}, retain);
+    }
+    return lease_.Resolve(
+        target, controller_->result(), controller_->input(),
+        base::BindRepeating(
+            [](AutocompleteController* controller, base::TimeTicks started,
+               AutocompleteMatch* match) {
+              controller->UpdateMatchDestinationURLWithAdditionalSearchboxStats(
+                  base::TimeTicks::Now() - started, match);
+            },
+            base::Unretained(controller_.get()), query_started_),
+        retain, query_.text, controller_);
+  }
+
+  CommandExecutionResult AcceptSelection(CommandNativeSelection selection,
+                                         WindowOpenDisposition disposition,
+                                         bool confirmed) {
+    Browser* browser = context_->browser();
+    if (!browser) {
+      return {false, false, u"This browser window is no longer available"};
+    }
+    auto* location_bar = browser->GetFeatures().location_bar();
+    auto* client = location_bar && location_bar->GetOmniboxController()
+                       ? location_bar->GetOmniboxController()->client()
+                       : nullptr;
+    if (!client || !IsCommandNativeMatchSupported(selection.match)) {
+      return {false, false, u"This result cannot be opened"};
+    }
+#if BUILDFLAG(ENABLE_EXTENSIONS)
+    if (!confirmed &&
+        base::FeatureList::IsEnabled(
+            extensions_features::kSearchEngineExplicitChoiceDialog) &&
+        AutocompleteMatch::IsSearchType(selection.match.type) &&
+        !selection.match.keyword.empty() &&
+        selection.match.destination_url.is_valid() &&
+        client->ShowConfirmationDialogIfDefaultSearchExtensionControlled(
+            selection.match.destination_url,
+            base::BindOnce(&NativeQueryProvider::OnExtensionConfirmed,
+                           weak_factory_.GetWeakPtr(),
+                           lease_.acceptance_epoch(), selection.target,
+                           disposition))) {
+      return {true, false, u"Confirm the search provider to continue"};
+    }
+#endif
+    auto owner = selection.controller_owner;
+    if (!owner) {
+      return {false, false, u"This result is no longer available"};
+    }
+    auto* provider_client = owner->autocomplete_provider_client();
+    const base::TimeTicks timestamp = base::TimeTicks::Now();
+    if (auto action = selection.match.takeover_action) {
+      if (!action->IsReadyToTrigger(selection.input, *provider_client)) {
+        return {false, false, u"This action is no longer available"};
+      }
+      auto controller = TakeController();
+      // Keep the provider client alive if owner execution destroys the session.
+      client->ExecuteAction(action.get(), disposition, timestamp,
+                            *provider_client);
+      return {true, true, {}};
+    }
+    if (!selection.match.destination_url.is_valid()) {
+      return {false, false, u"This result cannot be opened"};
+    }
+    const GURL alternate_url = AutocompleteResult::ComputeAlternateNavUrl(
+        selection.input, selection.match, provider_client);
+    AutocompleteMatch alternate_match =
+        VerbatimMatchForInput(owner->history_url_provider(), provider_client,
+                              selection.input, alternate_url, false);
+    auto controller = TakeController();
+    const auto transition = ui::PageTransitionFromInt(
+        selection.match.transition | ui::PAGE_TRANSITION_FROM_ADDRESS_BAR);
+    const bool entered_without_scheme =
+        selection.input.added_default_scheme_to_typed_url();
+    const bool entered_http =
+        selection.input.typed_url_had_http_scheme() &&
+        selection.match.type == AutocompleteMatchType::URL_WHAT_YOU_TYPED;
+    const std::u16string text = selection.user_text;
+    // Copy everything before owner navigation. Never read members afterwards.
+    client->OnAutocompleteAccept(
+        selection.match.destination_url, selection.match.post_content.get(),
+        disposition, transition, selection.match.type, timestamp,
+        entered_without_scheme, entered_http, text, selection.match,
+        alternate_match);
+    return {true, true, {}};
+  }
+  void OnExtensionConfirmed(
+      uint64_t generation,
+      CommandNativeTarget target,
+      WindowOpenDisposition disposition,
+      OmniboxClient::ExtensionControlledDialogResult result) {
+    if (!lease_.IsAcceptanceCurrent(generation) || !context_->browser()) {
+      return;
+    }
+    if (result == OmniboxClient::ExtensionControlledDialogResult::kAccept) {
+      auto selection = Resolve(target, true);
+      if (selection) {
+        AcceptSelection(*selection, disposition, true);
+      }
+    } else if (result ==
+               OmniboxClient::ExtensionControlledDialogResult::kReject) {
+      // The native owner rebuilds the query using the restored default engine.
+      OnCorpusChanged();
+    }
+  }
+
+  CommandRow Project(const AutocompleteMatch& match, uint32_t ordinal) {
+    CommandRow row;
+    row.provider_id = kNativeCommandProvider;
+    row.target = CommandNativeTarget{lease_.revision(), ordinal};
+    row.selection_key =
+        CommandNativeSelectionKey(match, lease_.revision(), ordinal);
+    row.title =
+        AutocompleteMatch::IsSearchType(match.type) || match.description.empty()
+            ? match.contents
+            : match.description;
+    row.detail = AutocompleteMatch::IsSearchType(match.type)
+                     ? engine_name_
+                     : base::UTF8ToUTF16(match.destination_url.spec());
+    row.category =
+        AutocompleteMatch::IsSearchType(match.type) ? u"Search" : u"Website";
+    row.primary_verb =
+        AutocompleteMatch::IsSearchType(match.type) ? u"Search" : u"Go";
+    row.has_actions = match.destination_url.is_valid();
+    row.tint = AutocompleteMatch::IsSearchType(match.type)
+                   ? kOmniTint
+                   : WebsiteTint(match.destination_url);
+    if (match.arcium_item && !match.arcium_item->IsCommand()) {
+      const auto& item = *match.arcium_item;
+      const bool pin = item.kind == ArciumOmniboxItem::Kind::kPin;
+      row.provider_id = kBuiltinCommandProvider;
+      row.target = CommandPersistentTarget{
+          pin ? CommandPersistentKind::kPin : CommandPersistentKind::kFavorite,
+          item.space_id, item.id};
+      row.selection_key = CommandPersistentSelectionKey(
+          std::get<CommandPersistentTarget>(row.target));
+      row.category = pin ? u"Pin" : u"Favorite";
+      row.tint = kSavedTint;
+      row.primary_verb = item.is_live ? u"Switch" : pin ? u"Restore" : u"Open";
+      row.primary_icon =
+          item.is_live ? CommandPrimaryIcon::kSwitch : CommandPrimaryIcon::kGo;
+      row.activity = pin            ? item.is_live ? CommandActivity::kCircleDot
+                                                   : CommandActivity::kCircle
+                     : item.is_live ? CommandActivity::kDot
+                                    : CommandActivity::kNone;
+    } else if (match.type == AutocompleteMatchType::OPEN_TAB) {
+      const auto tabs = context_->corpus.FindLiveTargets(match.destination_url);
+      row.category = u"Tab";
+      row.activity = CommandActivity::kDot;
+      row.primary_icon = CommandPrimaryIcon::kSwitch;
+      row.primary_verb = u"Switch";
+      if (tabs.size() == 1) {
+        if (auto live = context_->corpus.GetLiveRow(tabs.front())) {
+          row.provider_id = live->provider_id;
+          row.target = std::move(live->target);
+          row.selection_key = std::move(live->selection_key);
+          row.category = std::move(live->category);
+          row.activity = live->activity;
+          if (live->tint != SK_ColorTRANSPARENT) {
+            row.tint = live->tint;
+          }
+          row.icon = std::move(live->icon);
+        }
+      }
+      if (std::holds_alternative<CommandNativeTarget>(row.target)) {
+        row.primary_icon = CommandPrimaryIcon::kAction;
+        row.primary_verb = u"Choose tab";
+        row.primary_submenu_id = "tabs";
+      }
+    } else if (match.takeover_action) {
+      row.primary_icon = CommandPrimaryIcon::kAction;
+      row.primary_verb = u"Run";
+    }
+    const auto refreshed = base::BindRepeating(&NativeQueryProvider::Publish,
+                                               weak_factory_.GetWeakPtr());
+    if (row.icon.isNull()) {
+      row.icon =
+          AutocompleteMatch::IsSearchType(match.type)
+              ? context_->icons.GetEngineIcon(engine_icon_url_, refreshed)
+              : context_->icons.GetPageIcon(match.destination_url, refreshed);
+    }
+    if (row.icon.isNull() && AutocompleteMatch::IsSearchType(match.type)) {
+      row.icon =
+          gfx::CreateVectorIcon(vector_icons::kSearchIcon, 16, kOmniTint);
+    }
+    return row;
+  }
+  void Publish() {
+    if (publish_.is_null() || !controller_ || lease_.revision().is_empty()) {
+      return;
+    }
+    CommandProviderResults results;
+    const auto& native = controller_->result();
+    const auto* default_match = native.default_match();
+    auto native_rows = ProjectSupportedNativeCommandRows(
+        native, lease_.revision(), query_.limit);
+    const auto typed_ordinal =
+        query_.text.empty()
+            ? std::optional<uint32_t>()
+            : GetUnprojectedNativeDefaultOrdinal(native, native_rows);
+    if (typed_ordinal && native_rows.size() >= CommandSession::kMaxRows) {
+      native_rows.pop_back();
+    }
+    results.rows.reserve(native_rows.size() + 1);
+    for (const auto& native_row : native_rows) {
+      auto row =
+          Project(native.match_at(native_row.ordinal), native_row.ordinal);
+      row.is_default = native_row.is_default;
+      results.rows.push_back(std::move(row));
+    }
+    if (typed_ordinal) {
+      // The typed row accepts the actual native default; it does not recreate a
+      // search engine URL or discard the native transition/actions.
+      CommandRow typed = Project(*default_match, *typed_ordinal);
+      typed.kind = CommandRowKind::kTypedSearch;
+      typed.is_default = true;
+      typed.selection_key = "typed:" + typed.selection_key;
+      typed.title = query_.text;
+      typed.detail = AutocompleteMatch::IsSearchType(default_match->type)
+                         ? u"Search " + engine_name_
+                         : u"Open address";
+      if (std::holds_alternative<CommandNativeTarget>(typed.target) &&
+          typed.primary_submenu_id.empty()) {
+        typed.primary_verb =
+            AutocompleteMatch::IsSearchType(default_match->type) ? u"Search"
+                                                                 : u"Go";
+      }
+      typed.has_actions = default_match->destination_url.is_valid();
+      results.rows.push_back(std::move(typed));
+    }
+    results.done = controller_->done();
+    auto callback = publish_;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<NativeQueryProvider> owner, uint64_t generation,
+               uint64_t epoch, base::UnguessableToken revision,
+               CommandProviderPublishCallback callback,
+               CommandProviderResults results) {
+              if (!owner || generation != owner->query_generation_ ||
+                  epoch != owner->query_.epoch || owner->publish_.is_null() ||
+                  revision != owner->lease_.revision()) {
+                return;
+              }
+              callback.Run(std::move(results));
+            },
+            weak_factory_.GetWeakPtr(), query_generation_, query_.epoch,
+            lease_.revision(), std::move(callback), std::move(results)));
+  }
+
+  std::shared_ptr<ProductionContext> context_;
+  raw_ptr<TemplateURLService> engines_;
+  base::ScopedObservation<TemplateURLService, TemplateURLServiceObserver>
+      engine_observation_{this};
+  base::CallbackListSubscription corpus_subscription_;
+  std::shared_ptr<AutocompleteController> controller_;
+  bool controller_is_web_ = false;
+  CommandNativeResultLease lease_;
+  CommandQuery query_;
+  CommandProviderPublishCallback publish_;
+  base::TimeTicks query_started_;
+  uint64_t query_generation_ = 0;
+  std::u16string engine_name_ = u"Web";
+  std::u16string engine_keyword_;
+  GURL engine_icon_url_;
+  mutable base::WeakPtrFactory<NativeQueryProvider> weak_factory_{this};
+};
+
+class LocalQueryProvider final : public CommandQueryProvider {
+ public:
+  explicit LocalQueryProvider(std::shared_ptr<ProductionContext> context)
+      : context_(std::move(context)) {
+    corpus_subscription_ = context_->corpus.RegisterChanged(base::BindRepeating(
+        &LocalQueryProvider::Publish, weak_factory_.GetWeakPtr()));
+  }
+  std::string_view id() const override { return kBuiltinCommandProvider; }
+  bool SupportsScope(std::string_view scope_id) const override {
+    return scope_id == kOmniScope ||
+           CommandQueryProvider::SupportsScope(scope_id);
+  }
+  std::vector<CommandScopeDescriptor> GetScopes() const override {
+    return {
+        {kSavedScope, kBuiltinCommandProvider, u"Saved", ScopeIcon(kSavedScope),
+         kSavedTint, u"Search Pins, Favorites and folders",
+         u"Search saved items", u"Search saved Pins, Favorites and folders"},
+        {kYouTubeScope, kBuiltinCommandProvider, u"YouTube",
+         ScopeIcon(kYouTubeScope), kYouTubeTint, u"Search YouTube",
+         u"Search YouTube", u"Search YouTube"},
+        {kXScope, kBuiltinCommandProvider, u"X", ScopeIcon(kXScope), kXTint,
+         u"Search X", u"Search X", u"Search X posts and accounts"},
+        {kChatGPTScope, kBuiltinCommandProvider, u"ChatGPT",
+         ScopeIcon(kChatGPTScope), kChatGPTTint, u"Ask ChatGPT", u"Ask ChatGPT",
+         u"Open a prompt in ChatGPT"}};
+  }
+  void Start(CommandQuery query,
+             CommandProviderPublishCallback publish) override {
+    query_ = std::move(query);
+    publish_ = std::move(publish);
+    Publish();
+  }
+  void Cancel() override {
+    ++generation_;
+    publish_.Reset();
+    context_->icons.Cancel();
+  }
+
+ private:
+  void Publish() {
+    if (publish_.is_null()) {
+      return;
+    }
+    if (!context_->browser()) {
+      PostResults({}, context_->corpus.index().revision());
+      return;
+    }
+    const auto& index = context_->corpus.index();
+    if (query_.scope_id == kOmniScope && !query_.text.empty()) {
+      // Native autocomplete owns nonempty Omni order and default selection.
+      PostResults({}, index.revision());
+      return;
+    }
+    const auto search_url =
+        query_.text.empty()
+            ? std::optional<GURL>()
+            : BuildCommandSearchUrl(query_.scope_id, query_.text);
+    const size_t limit = std::min(query_.limit, CommandSession::kMaxRows);
+    const auto matches = index.Search(query_.text, query_.scope_id,
+                                      search_url && limit ? limit - 1 : limit);
+    CommandProviderResults results;
+    results.rows.reserve(matches.size() + 1);
+    for (const auto& match : matches) {
+      const auto* record = index.Get(match.record);
+      auto metadata = context_->corpus.Get(match.record);
+      if (!record || !metadata) {
+        continue;
+      }
+      CommandRow row;
+      row.provider_id = kBuiltinCommandProvider;
+      row.target = std::move(metadata->target);
+      row.selection_key = record->id;
+      row.title = record->title;
+      row.detail = record->context.empty() ? record->url : record->context;
+      row.category = record->category;
+      row.tint = record->primary_scope_id == kOmniScope
+                     ? WebsiteTint(GURL(base::UTF16ToUTF8(record->url)))
+                     : ScopeTint(record->primary_scope_id);
+      row.primary_verb = metadata->primary_verb;
+      row.primary_icon = metadata->primary_icon;
+      row.activity = metadata->activity;
+      row.has_actions = metadata->has_actions;
+      const auto* saved = std::get_if<CommandPersistentTarget>(&row.target);
+      if (saved && (saved->kind == CommandPersistentKind::kPinFolder ||
+                    saved->kind == CommandPersistentKind::kFavoriteFolder)) {
+        row.icon = gfx::CreateVectorIcon(vector_icons::kFolderFilledIcon, 16,
+                                         kSavedTint);
+      } else {
+        row.icon = context_->icons.GetPageIcon(
+            GURL(base::UTF16ToUTF8(record->url)),
+            base::BindRepeating(&LocalQueryProvider::Publish,
+                                weak_factory_.GetWeakPtr()));
+      }
+      results.rows.push_back(std::move(row));
+    }
+    if (search_url && limit) {
+      CommandRow typed;
+      typed.kind = CommandRowKind::kTypedSearch;
+      typed.provider_id = kBuiltinCommandProvider;
+      typed.target = CommandUrlTarget{*search_url};
+      typed.selection_key = "typed:" + query_.scope_id;
+      typed.title = query_.text;
+      const auto scopes = GetScopes();
+      for (const auto& scope : scopes) {
+        if (scope.id == query_.scope_id) {
+          typed.detail = scope.search_verb;
+          typed.icon = scope.icon;
+          typed.tint = scope.tint;
+          break;
+        }
+      }
+      typed.primary_verb =
+          query_.scope_id == kChatGPTScope ? u"Ask" : u"Search";
+      typed.has_actions = true;
+      typed.is_default = results.rows.empty();
+      results.rows.push_back(std::move(typed));
+    }
+    if (!results.rows.empty() && !results.rows.front().is_default) {
+      results.rows.front().is_default = true;
+    }
+    PostResults(std::move(results), index.revision());
+  }
+  void PostResults(CommandProviderResults results, uint64_t corpus_revision) {
+    auto callback = publish_;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<LocalQueryProvider> owner, uint64_t generation,
+               uint64_t epoch, uint64_t corpus_revision,
+               CommandProviderPublishCallback callback,
+               CommandProviderResults results) {
+              if (!owner || generation != owner->generation_ ||
+                  epoch != owner->query_.epoch || owner->publish_.is_null() ||
+                  corpus_revision !=
+                      owner->context_->corpus.index().revision()) {
+                return;
+              }
+              callback.Run(std::move(results));
+            },
+            weak_factory_.GetWeakPtr(), generation_, query_.epoch,
+            corpus_revision, std::move(callback), std::move(results)));
+  }
+  std::shared_ptr<ProductionContext> context_;
+  base::CallbackListSubscription corpus_subscription_;
+  CommandQuery query_;
+  CommandProviderPublishCallback publish_;
+  uint64_t generation_ = 0;
+  base::WeakPtrFactory<LocalQueryProvider> weak_factory_{this};
+};
+
+class RouterActionDelegate final : public CommandActionDelegate {
+ public:
+  RouterActionDelegate(Browser* browser, CommandNativeActionCallbacks callbacks)
+      : router_(browser, std::move(callbacks)) {}
+  void SetInvocation(const CommandInvocation& invocation) override {
+    router_.SetInvocation(invocation);
+  }
+  CommandMenu ResolveActions(const CommandTarget& target,
+                             std::string_view menu_id,
+                             std::u16string_view query) override {
+    return router_.ResolveActions(target, menu_id, query);
+  }
+  CommandExecutionResult Execute(const CommandIntent& intent) override {
+    return router_.Execute(intent);
+  }
+
+ private:
+  ArciumCommandActionRouter router_;
+};
