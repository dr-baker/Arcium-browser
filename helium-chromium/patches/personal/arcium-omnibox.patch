+#ifndef CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_NATIVE_RESULT_H_
+#define CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_NATIVE_RESULT_H_
+
+#include <memory>
+#include <optional>
+#include <span>
+
+#include "chrome/browser/ui/omnibox/arcium_command_session.h"
+#include "components/omnibox/browser/arcium_command_search.h"
+#include "components/omnibox/browser/autocomplete_input.h"
+#include "components/omnibox/browser/autocomplete_match.h"
+
+class AutocompleteController;
+class AutocompleteResult;
+class AutocompleteSchemeClassifier;
+
+namespace arcium {
+
+// This presenter has no keyword-chip mode. Suppress owner actions that require
+// that UI while preserving the order/default of all remaining native rows.
+bool IsCommandNativeMatchSupported(const AutocompleteMatch& match);
+bool CanCommandNativeOpenUrlCopy(const AutocompleteMatch& match);
+inline constexpr size_t kMaxNativeSelectionKeyBytes = 32 * 1024;
+std::string CommandNativeSelectionKey(const AutocompleteMatch& match,
+                                      base::UnguessableToken revision,
+                                      uint32_t ordinal);
+std::vector<NativeCommandRow> ProjectSupportedNativeCommandRows(
+    const AutocompleteResult& result,
+    base::UnguessableToken revision,
+    size_t limit = CommandSession::kMaxResults);
+// A typed fallback must never duplicate a displayed native default or relabel
+// a saved item/tab/action with the user's query text.
+std::optional<uint32_t> GetUnprojectedNativeDefaultOrdinal(
+    const AutocompleteResult& result,
+    std::span<const NativeCommandRow> displayed_rows);
+
+bool CommandNativePersistentItemsAllowed(bool feature_enabled,
+                                         bool preference_enabled,
+                                         bool off_the_record,
+                                         bool guest);
+
+// A configured-engine scope enters the owner's keyword mode. The original
+// user text is retained separately for presentation and acceptance observers.
+AutocompleteInput CreateCommandNativeInput(
+    std::u16string_view query,
+    std::u16string_view engine_keyword,
+    const AutocompleteSchemeClassifier& classifier);
+
+struct CommandNativeSelection {
+  // Declared first so the copied match dies before its provider/client owner.
+  std::shared_ptr<AutocompleteController> controller_owner;
+  CommandNativeTarget target;
+  AutocompleteMatch match;
+  AutocompleteInput input;
+  std::u16string user_text;
+};
+
+// The controller owns all current results. This lease retains at most one
+// selected menu match, so asynchronous result replacement cannot change the
+// meaning of its old ordinal. Cancel preserves that menu selection for Execute.
+class CommandNativeResultLease {
+ public:
+  using FinalizeMatchCallback =
+      base::RepeatingCallback<void(AutocompleteMatch*)>;
+
+  CommandNativeResultLease();
+  ~CommandNativeResultLease();
+  base::UnguessableToken NewRevision();
+  base::UnguessableToken revision() const { return revision_; }
+  std::optional<CommandNativeSelection> Resolve(
+      const CommandNativeTarget& target,
+      const AutocompleteResult& result,
+      const AutocompleteInput& input,
+      const FinalizeMatchCallback& finalize,
+      bool retain,
+      std::u16string_view user_text = {},
+      std::shared_ptr<AutocompleteController> controller_owner = {});
+  // Confirmation callbacks share query/invocation lifetime, while a selected
+  // menu match remains available for a fresh Execute after cancellation.
+  uint64_t acceptance_epoch() const { return acceptance_epoch_; }
+  bool IsAcceptanceCurrent(uint64_t epoch) const {
+    return epoch == acceptance_epoch_;
+  }
+  void InvalidateCurrent();
+  void Reset();
+  size_t retained_count_for_testing() const { return retained_ ? 1 : 0; }
+
+ private:
+  base::UnguessableToken revision_;
+  uint64_t acceptance_epoch_ = 0;
+  std::optional<CommandNativeSelection> retained_;
+};
+
+}  // namespace arcium
+
+#endif  // CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_NATIVE_RESULT_H_
