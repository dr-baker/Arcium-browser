+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_PROVIDERS_H_
+#define CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_PROVIDERS_H_
+
+#include <memory>
+#include <string_view>
+#include <vector>
+
+#include "chrome/browser/ui/omnibox/arcium_command_session.h"
+
+class Browser;
+
+namespace arcium {
+
+struct CommandQuery {
+  uint64_t epoch = 0;
+  CommandScopeId scope_id;
+  std::u16string text;
+  CommandInvocation invocation;
+  size_t limit = CommandSession::kMaxResults;
+};
+struct CommandProviderResults {
+  std::vector<CommandRow> rows;
+  bool done = true;
+};
+using CommandProviderPublishCallback =
+    base::RepeatingCallback<void(CommandProviderResults)>;
+
+// Registration owns integration lifetime. A query integration supplies its
+// descriptors, bounded publications and optional late actions in one place.
+// Start may publish synchronously; Cancel must stop its outstanding work.
+class CommandQueryProvider {
+ public:
+  virtual ~CommandQueryProvider() = default;
+  virtual std::string_view id() const = 0;
+  virtual std::vector<CommandScopeDescriptor> GetScopes() const = 0;
+  virtual bool SupportsScope(std::string_view scope_id) const;
+  virtual void Start(CommandQuery query,
+                     CommandProviderPublishCallback publish) = 0;
+  virtual void Cancel() = 0;
+  // Cancel preserves a selected menu target; a new invocation/query clears it.
+  virtual void ResetRetainedTarget();
+  virtual CommandMenu ResolveActions(const CommandProviderTarget& target,
+                                     std::string_view menu_id,
+                                     std::u16string_view query);
+  virtual CommandExecutionResult Execute(const CommandIntent& intent);
+};
+
+class CommandProviderRegistry {
+ public:
+  CommandProviderRegistry();
+  ~CommandProviderRegistry();
+  CommandProviderRegistry(const CommandProviderRegistry&) = delete;
+  CommandProviderRegistry& operator=(const CommandProviderRegistry&) = delete;
+
+  // Rejects duplicate provider or scope IDs; a rejected provider is destroyed.
+  bool Register(std::unique_ptr<CommandQueryProvider> provider);
+  CommandQueryProvider* FindProvider(std::string_view provider_id) const;
+  std::vector<CommandQueryProvider*> ProvidersForScope(
+      std::string_view scope_id) const;
+  std::vector<CommandScopeDescriptor> GetScopes() const;
+  void Cancel();
+  void ResetRetainedTargets();
+
+ private:
+  std::vector<std::unique_ptr<CommandQueryProvider>> providers_;
+};
+
+// The production action router implements this adapter. Tests inject it without
+// Browser, Profile, Views or visible native windows.
+class CommandActionDelegate {
+ public:
+  virtual ~CommandActionDelegate() = default;
+  virtual void SetInvocation(const CommandInvocation& invocation) = 0;
+  virtual CommandMenu ResolveActions(const CommandTarget& target,
+                                     std::string_view menu_id,
+                                     std::u16string_view query) = 0;
+  virtual CommandExecutionResult Execute(const CommandIntent& intent) = 0;
+};
+struct CommandInvocationSnapshot {
+  CommandInvocation invocation;
+  std::u16string text;
+  std::optional<CommandRow> current_tab;
+};
+using CommandCaptureInvocationCallback =
+    base::RepeatingCallback<CommandInvocationSnapshot(CommandInvocationMode)>;
+
+std::unique_ptr<CommandSession> CreateCommandSessionForProviders(
+    std::unique_ptr<CommandProviderRegistry> registry,
+    std::unique_ptr<CommandActionDelegate> actions,
+    CommandCaptureInvocationCallback capture);
+
+// This browser-owned factory contains the Profile/controller/URL integration.
+// Presenters receive only CommandSession and its immutable value publications.
+std::unique_ptr<CommandSession> CreateCommandSession(Browser* browser);
+
+}  // namespace arcium
+
+#endif  // CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_PROVIDERS_H_
