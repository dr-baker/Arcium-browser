+SkColor ScopeTint(std::string_view scope_id) {
+  if (scope_id == kSavedScope) {
+    return kSavedTint;
+  }
+  if (scope_id == kYouTubeScope) {
+    return kYouTubeTint;
+  }
+  if (scope_id == kXScope) {
+    return kXTint;
+  }
+  if (scope_id == kChatGPTScope) {
+    return kChatGPTTint;
+  }
+  return kOmniTint;
