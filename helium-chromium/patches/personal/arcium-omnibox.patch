+namespace arcium {
+namespace {
+std::vector<CommandRecord> Pins(size_t count) {
+  std::vector<CommandRecord> records;
+  records.reserve(count);
+  for (size_t i = 0; i < count; ++i) {
+    CommandRecord record;
+    record.id = "space:design/pin:" + base::NumberToString(i);
+    record.title = u"Interface reference " + base::NumberToString16(i);
+    record.url = u"https://example.test/design/" + base::NumberToString16(i);
+    record.context = i % 2 ? u"Design › Figma" : u"Research › Typography";
+    record.category = u"Pin";
+    record.primary_scope_id = "saved";
+    record.scope_ids = {"saved"};
+    record.source_relevance = static_cast<int>(i);
+    records.push_back(std::move(record));
+  }
+  return records;
+}
+TEST(CommandSearchIndexTest, Queries211PinsWithoutUnboundedResults) {
+  CommandSearchIndex index(Pins(211), 42);
+  const auto bytes = index.EstimateOwnedBytes();
+  ASSERT_EQ(index.size(), 211u);
+  EXPECT_LT(bytes, 512u * 1024u);
+  const auto started = base::TimeTicks::Now();
+  for (int i = 0; i < 1000; ++i) {
+    const auto results = index.Search(u"interface figma", "saved");
+    ASSERT_EQ(results.size(), 8u);
+    EXPECT_LE(results.capacity(), CommandSearchIndex::kMaxResults);
+    EXPECT_EQ(index.Get(results.front().record)->id, "space:design/pin:209");
+  }
+  // This is a generous regression guard, not the reported latency benchmark.
+  EXPECT_LT(base::TimeTicks::Now() - started, base::Seconds(5));
+  EXPECT_EQ(index.EstimateOwnedBytes(), bytes);
+  EXPECT_EQ(index.Search(u"interface", "saved", 1000).size(), 32u);
+  EXPECT_TRUE(index.Search(u"interface", "web").empty());
+}
+TEST(CommandSearchIndexTest, CarriesProviderFrecencyAndStableIdentity) {
+  auto records = Pins(3);
+  for (auto& record : records) {
+    record.title = u"Figma";
+  }
+  records[0].source_relevance = 10;
+  records[1].source_relevance = 1200;
+  records[2].source_relevance = 100;
+  CommandSearchIndex index(std::move(records), 1);
+  const auto matches = index.Search(u"FIGMA", "saved");
+  ASSERT_EQ(matches.size(), 3u);
+  EXPECT_EQ(matches[0].record.slot, 1u);
+  EXPECT_EQ(matches[0].source_relevance, 1200);
+  EXPECT_EQ(matches[1].record.slot, 2u);
+}
+TEST(CommandSearchIndexTest, OwnerRelevanceAndTextScoreBothAffectOrder) {
+  auto records = Pins(3);
+  records[0].title = u"Figma";
+  records[0].source_relevance = 100;
+  records[1].title = u"Figma team";
+  records[1].source_relevance = 150;
+  records[2].title = u"Figma reference";
+  records[2].source_relevance = 110;
+  CommandSearchIndex index(std::move(records), 1);
+  const auto matches = index.Search(u"figma", "saved");
+  ASSERT_EQ(matches.size(), 3u);
+  // Owner relevance can beat a stronger literal match, while the exact title
+  // still beats a small frecency advantage for the same query.
+  EXPECT_EQ(matches[0].record.slot, 1u);
+  EXPECT_EQ(matches[0].text_score, 80);
+  EXPECT_EQ(matches[1].record.slot, 0u);
+  EXPECT_EQ(matches[1].text_score, 100);
+  EXPECT_EQ(matches[2].record.slot, 2u);
+}
+TEST(CommandSearchIndexTest, CombinedRankDoesNotOverflowOwnerRelevance) {
+  auto records = Pins(2);
+  records[0].title = u"Figma";
+  records[0].source_relevance = std::numeric_limits<int>::max();
+  records[1].title = u"Figma";
+  records[1].source_relevance = std::numeric_limits<int>::max() - 1;
+  CommandSearchIndex index(std::move(records), 1);
+  const auto matches = index.Search(u"figma", "saved");
+  ASSERT_EQ(matches.size(), 2u);
+  EXPECT_EQ(matches.front().record.slot, 0u);
+}
+TEST(CommandSearchIndexTest, StaleRevisionCannotResolveRecord) {
+  CommandSearchIndex before(Pins(2), 1);
+  CommandSearchIndex after(Pins(2), 2);
+  const auto ref = before.Ref(0);
+  EXPECT_NE(before.Get(ref), nullptr);
+  EXPECT_EQ(after.Get(ref), nullptr);
+  EXPECT_TRUE(after.Search(u"reference", "saved", 0).empty());
+}
+TEST(CommandSearchIndexTest, UnicodeCaseAndAllQueryTermsMatchAcrossFields) {
+  auto records = Pins(1);
+  records[0].title = u"CAFÉ Straße";
+  records[0].context = u"Design › Résumé";
+  CommandSearchIndex index(std::move(records), 1);
+  EXPECT_EQ(index.Search(u"café STRASSE résumé", "saved").size(), 1u);
+  EXPECT_TRUE(index.Search(u"café missing", "saved").empty());
+}
+TEST(CommandSearchIndexTest, SameRevisionInAnotherSnapshotRejectsForeignRefs) {
+  CommandSearchIndex first(Pins(2), 1);
+  auto reversed = Pins(2);
+  std::reverse(reversed.begin(), reversed.end());
+  CommandSearchIndex second(std::move(reversed), 1);
+  EXPECT_EQ(second.Get(first.Ref(0)), nullptr);
+  EXPECT_NE(second.Get(second.Ref(0)), nullptr);
+}
+TEST(CommandSearchIndexTest, CanonicallyEquivalentUnicodeMatches) {
+  auto records = Pins(1);
+  records[0].title = u"CAFÉ Résumé";
+  CommandSearchIndex index(std::move(records), 1);
+  EXPECT_EQ(index.Search(u"cafe\u0301 re\u0301sume\u0301", "saved").size(), 1u);
+}
+TEST(CommandSearchIndexTest, QueryWorkHasExplicitBounds) {
+  auto records = Pins(2);
+  const std::u16string max_query(CommandSearchIndex::kMaxQueryLength, u'a');
+  records[1].title = max_query;
+  CommandSearchIndex index(std::move(records), 1);
+  EXPECT_TRUE(
+      index
+          .Search(std::u16string(CommandSearchIndex::kMaxQueryLength + 1, u'a'),
+                  "saved")
+          .empty());
+  EXPECT_EQ(index.Search(max_query, "saved").size(), 1u);
+  std::u16string terms;
+  for (int i = 0; i < 32; ++i) {
+    terms += u"reference ";
+  }
+  EXPECT_EQ(index.Search(terms, "saved").size(), 1u);
+  terms += u"reference";
+  EXPECT_TRUE(index.Search(terms, "saved").empty());
+}
+TEST(CommandSearchIndexTest, ResultCapacityStaysBoundedForEveryRequestedLimit) {
+  CommandSearchIndex index(Pins(1000), 1);
+  for (const size_t limit : {size_t{0}, size_t{1}, size_t{8}, size_t{32},
+                             std::numeric_limits<size_t>::max()}) {
+    const auto results = index.Search(u"reference", "saved", limit);
+    EXPECT_EQ(results.size(), std::min(limit, CommandSearchIndex::kMaxResults));
+    EXPECT_LE(results.capacity(), CommandSearchIndex::kMaxResults);
+  }
+}
+TEST(CommandSearchIndexTest, SavedVideoBelongsToBothScopesWithoutDuplication) {
+  auto records = Pins(1);
+  records[0].scope_ids.emplace_back("youtube");
+  CommandSearchIndex index(std::move(records), 1);
+  EXPECT_EQ(index.Search(u"reference", "omni").size(), 1u);
+  EXPECT_EQ(index.Search(u"reference", "saved").size(), 1u);
+  EXPECT_EQ(index.Search(u"reference", "youtube").size(), 1u);
+}
+TEST(CommandSearchIndexTest, MatchesDynamicSeventhScope) {
+  auto records = Pins(2);
+  records[0].primary_scope_id = "literature";
+  records[0].scope_ids = {"saved", "literature", "literature"};
+  records[1].primary_scope_id = "saved";
+  records[1].scope_ids = {"saved"};
+  CommandSearchIndex index(std::move(records), 1);
+  const auto matches = index.Search(u"reference", "literature");
+  ASSERT_EQ(matches.size(), 1u);
+  EXPECT_EQ(matches.front().record.slot, 0u);
+  EXPECT_EQ(index.Get(matches.front().record)->primary_scope_id, "literature");
+  EXPECT_EQ(index.Search(u"reference", "saved").size(), 2u);
+  EXPECT_EQ(index.Search(u"reference", "omni").size(), 2u);
+  EXPECT_TRUE(index.Search(u"reference", "unregistered").empty());
+}
+TEST(CommandSearchIndexTest, EmptyQueryMatchesOnlySuggestedRecordsInScope) {
+  auto records = Pins(3);
+  records[0].suggested = true;
+  records[0].scope_ids.emplace_back("youtube");
+  records[1].source_relevance = 9000;
+  records[2].suggested = true;
+  records[2].primary_scope_id = "youtube";
+  records[2].scope_ids = {"youtube"};
+  CommandSearchIndex index(std::move(records), 1);
+  const auto saved = index.Search(u"  ", "saved");
+  ASSERT_EQ(saved.size(), 1u);
+  EXPECT_EQ(saved.front().record.slot, 0u);
+  EXPECT_EQ(saved.front().text_score, 0);
+  const auto all = index.Search(u"", "omni");
+  ASSERT_EQ(all.size(), 2u);
+  EXPECT_EQ(all[0].record.slot, 2u);
+  EXPECT_EQ(all[1].record.slot, 0u);
+  EXPECT_EQ(index.Search(u"", "youtube").size(), 2u);
+}
+TEST(CommandSearchIndexTest, PrimaryScopeIsIncludedInMemberships) {
+  auto records = Pins(1);
+  records[0].primary_scope_id = "literature";
+  CommandSearchIndex index(std::move(records), 1);
+  EXPECT_EQ(index.Search(u"reference", "literature").size(), 1u);
+  EXPECT_EQ(index.Search(u"reference", "saved").size(), 1u);
+}
+TEST(CommandSearchIndexTest, DynamicScopeCapacityCountsTowardOwnedStorage) {
+  auto records = Pins(1);
+  records.reserve(32);
+  records[0].primary_scope_id = "saved";
+  records[0].primary_scope_id.reserve(256);
+  records[0].scope_ids = {"saved", "literature"};
+  records[0].scope_ids.reserve(64);
+  records[0].scope_ids[1].reserve(128);
+  CommandSearchIndex index(std::move(records), 1);
+  const auto* record = index.Get(index.Ref(0));
+  ASSERT_NE(record, nullptr);
+  EXPECT_GE(index.EstimateOwnedBytes(),
+            32 * sizeof(CommandRecord) + 64 * sizeof(std::string) +
+                record->primary_scope_id.capacity() + 1 +
+                record->scope_ids[1].capacity() + 1);
+}
+TEST(PersistentItemRelevanceTest, KeepsBookmarkTierAndQueryQualityPolicy) {
+  const auto now = base::Time::FromInternalValue(1000000000000);
+  EXPECT_EQ(PersistentItemRelevance(4000, 60, 0, 0, now), 4600);
+  EXPECT_EQ(PersistentItemRelevance(3000, 40, 10, now.ToInternalValue(), now),
+            3430);
+  EXPECT_EQ(PersistentItemRelevance(2000, 20, 0, 0, now), 2200);
+  // Even the full 30 points of usage and recency cannot outrank a title
+  // prefix's 200-point match-quality advantage in the same tier.
+  EXPECT_GT(PersistentItemRelevance(4000, 40, 0, 0, now),
+            PersistentItemRelevance(4000, 20, 10, now.ToInternalValue(), now));
+  EXPECT_GT(PersistentItemRelevance(4000, 60, 0, 0, now),
+            PersistentItemRelevance(4000, 40, 10, now.ToInternalValue(), now));
+}
+TEST(PersistentItemRelevanceTest, BoundsUsageAndRecencyWithoutNarrowingAge) {
+  const auto now = base::Time::FromInternalValue(1000000000000);
+  EXPECT_EQ(PersistentItemRelevance(2000, 0, -1, 0, now), 2000);
+  EXPECT_EQ(PersistentItemRelevance(2000, 0, 100, 0, now), 2020);
+  EXPECT_EQ(PersistentItemRelevance(2000, 0, 0, -1, now), 2000);
+  EXPECT_EQ(PersistentItemRelevance(2000, 0, 0,
+                                    std::numeric_limits<int64_t>::min(), now),
+            2000);
+  EXPECT_EQ(PersistentItemRelevance(2000, 0, 0, now.ToInternalValue(), now),
+            2010);
+  EXPECT_EQ(PersistentItemRelevance(
+                2000, 0, 0, (now - base::Days(3)).ToInternalValue(), now),
+            2007);
+  EXPECT_EQ(PersistentItemRelevance(
+                2000, 0, 0, (now - base::Days(10)).ToInternalValue(), now),
+            2000);
+  EXPECT_EQ(PersistentItemRelevance(
+                2000, 0, 0, (now + base::Days(30)).ToInternalValue(), now),
+            2010);
+  EXPECT_EQ(PersistentItemRelevance(2000, 0, 0,
+                                    std::numeric_limits<int64_t>::max(), now),
+            2010);
+  EXPECT_EQ(PersistentItemRelevance(2000, 0, 0, 1, base::Time::Max()), 2000);
+}
+TEST(CommandSearchIndexTest, PublishedNativeOrderAndDefaultArePreserved) {
+  AutocompleteResult result;
+  AutocompleteMatch first(nullptr, 200, false,
+                          AutocompleteMatchType::SEARCH_SUGGEST);
+  first.contents = u"semantic suggestion without literal query";
+  first.allowed_to_be_default_match = true;
+  AutocompleteMatch second(nullptr, 9000, false,
+                           AutocompleteMatchType::HISTORY_URL);
+  second.contents = u"exact literal match";
+  second.allowed_to_be_default_match = false;
+  result.AppendMatches({first, second});
+  const auto revision = base::UnguessableToken::Create();
+  const auto rows = ProjectNativeCommandRows(result, revision);
+  ASSERT_EQ(rows.size(), 2u);
+  EXPECT_EQ(rows[0].ordinal, 0u);
+  EXPECT_EQ(rows[0].relevance, 200);
+  EXPECT_EQ(rows[1].relevance, 9000);
+  EXPECT_TRUE(rows[0].allowed_default);
+  EXPECT_FALSE(rows[1].allowed_default);
+  EXPECT_EQ(rows[0].is_default, result.default_match() == result.match_at(0));
+  EXPECT_EQ(rows[0].result_revision, revision);
+  const auto next_revision = base::UnguessableToken::Create();
+  EXPECT_NE(ProjectNativeCommandRows(result, next_revision)[0].result_revision,
+            rows[0].result_revision);
+}
+
+// Explicitly opted-in, read-only benchmark. Never runs against a profile by
+// default, and emits only aggregate counts, storage budget and timings.
+TEST(CommandSearchIndexTest, ActualProfileCorpusBenchmark) {
+  const auto* command = base::CommandLine::ForCurrentProcess();
+  if (!command->HasSwitch("arcium-pins-preferences")) {
+    GTEST_SKIP();
+  }
+  std::string json;
+  ASSERT_TRUE(base::ReadFileToStringWithMaxSize(
+      command->GetSwitchValuePath("arcium-pins-preferences"), &json,
+      32 * 1024 * 1024));
+  auto parsed =
+      base::JSONReader::Read(json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  ASSERT_TRUE(parsed && parsed->is_dict());
+  const auto* spaces = parsed->GetDict().FindListByDottedPath("helium.spaces");
+  ASSERT_TRUE(spaces);
+  const auto* active_space =
+      parsed->GetDict().FindStringByDottedPath("helium.active_space_id");
+  const auto* usage =
+      parsed->GetDict().FindDictByDottedPath("helium.persistent_item_usage");
+  ASSERT_TRUE(!usage || usage->size() <= 256u);
+  const auto now = base::Time::Now();
+  auto relevance = [&](int tier_base, const std::string& usage_key) {
+    int count = 0;
+    int64_t last_used = 0;
+    if (const auto* entry = usage ? usage->FindDict(usage_key) : nullptr) {
+      const int stored_count = entry->FindInt("count").value_or(0);
+      const auto* timestamp = entry->FindString("last_used");
+      int64_t stored_time = 0;
+      // Mirror the owner: malformed usage contributes neither count nor time.
+      if (stored_count > 0 && timestamp &&
+          base::StringToInt64(*timestamp, &stored_time) && stored_time > 0) {
+        count = std::min(stored_count, 1000);
+        last_used = stored_time;
+      }
+    }
+    return PersistentItemRelevance(tier_base, 0, count, last_used, now);
+  };
+  auto qualified_id = [](std::string_view kind, const std::string& space,
+                         const std::string& id) {
+    auto field = [](const std::string& value) {
+      return base::NumberToString(value.size()) + ":" + value;
+    };
+    return std::string(kind) + ":" + field(space) + field(id);
+  };
+  std::vector<CommandRecord> records;
+  size_t pin_count = 0;
+  size_t folder_count = 0;
+  size_t visited = 0;
+  std::set<std::string> space_ids;
+  auto walk = [&](auto&& self, const base::ListValue& nodes,
+                  const std::string& space, const std::u16string& context,
+                  std::set<std::string>& ids, size_t depth) -> bool {
+    if (depth > 64 || nodes.size() > 10000) {
+      return false;
+    }
+    for (const auto& value : nodes) {
+      if (++visited > 10000 || !value.is_dict()) {
+        return false;
+      }
+      const auto& node = value.GetDict();
+      const auto* type = node.FindString("type");
+      const auto* id = node.FindString("id");
+      const auto* title = node.FindString("title");
+      if (!type || !id || id->empty() || !title || !ids.insert(*id).second) {
+        return false;
+      }
+      if (*type == "folder") {
+        ++folder_count;
+        const auto* children = node.FindList("children");
+        if (!children || !node.FindBool("collapsed").has_value()) {
+          return false;
+        }
+        CommandRecord record;
+        record.id = qualified_id("folder", space, *id);
+        record.title = base::UTF8ToUTF16(*title);
+        record.context = context;
+        record.category = u"Folder";
+        record.primary_scope_id = "saved";
+        record.scope_ids = {"saved"};
+        record.source_relevance = 4000;
+        records.push_back(std::move(record));
+        if (!self(
+                self, *children, space,
+                (context + u" › " + base::UTF8ToUTF16(*title)).substr(0, 2048),
+                ids, depth + 1)) {
+          return false;
+        }
+      } else if (*type == "link") {
+        const auto* url = node.FindString("url");
+        if (!url || records.size() >= 10000) {
+          return false;
+        }
+        CommandRecord record;
+        record.id = qualified_id("pin", space, *id);
+        record.title = base::UTF8ToUTF16(*title);
+        record.url = base::UTF8ToUTF16(*url);
+        record.context = context;
+        record.category = u"Pin";
+        record.primary_scope_id = "saved";
+        record.scope_ids = {"saved"};
+        record.source_relevance =
+            relevance(active_space && *active_space == space ? 4000 : 2000,
+                      "p:" + space + ":" + *id);
+        records.push_back(std::move(record));
+        ++pin_count;
+      } else {
+        return false;
+      }
+    }
+    return true;
+  };
+  ASSERT_LE(spaces->size(), 100u);
+  for (const auto& value : *spaces) {
+    ASSERT_TRUE(value.is_dict());
+    const auto& space = value.GetDict();
+    const auto* id = space.FindString("id");
+    const auto* pins = space.FindList("pins");
+    const auto* name = space.FindString("name");
+    ASSERT_TRUE(id && !id->empty() && pins && name &&
+                space_ids.insert(*id).second);
+    std::set<std::string> ids;
+    ASSERT_TRUE(walk(walk, *pins, *id, base::UTF8ToUTF16(*name), ids, 0));
+  }
+  ASSERT_EQ(pin_count, 211u);
+  ASSERT_EQ(folder_count, 21u);
+  ASSERT_EQ(records.size(), pin_count + folder_count);
+  ASSERT_EQ(records.size(), 232u);
+  std::vector<std::u16string> queries;
+  for (const auto& record : records) {
+    auto terms = base::SplitStringPiece(record.title, base::kWhitespaceUTF16,
+                                        base::TRIM_WHITESPACE,
+                                        base::SPLIT_WANT_NONEMPTY);
+    std::u16string query(terms.empty() ? std::u16string_view(record.url)
+                                       : terms.front());
+    if (query.size() > 12) {
+      query.resize(12);
+      if (query.back() >= 0xd800 && query.back() <= 0xdbff) {
+        query.pop_back();
+      }
+    }
+    if (!query.empty()) {
+      queries.push_back(std::move(query));
+    }
+  }
+  ASSERT_FALSE(queries.empty());
+  CommandSearchIndex index(std::move(records), 1);
+  const auto bytes = index.EstimateOwnedBytes();
+  ASSERT_LT(bytes, 1024u * 1024u);
+  constexpr size_t kBenchmarkQueries = 10000;
+  std::vector<int64_t> micros;
+  micros.reserve(kBenchmarkQueries);
+  for (size_t i = 0; i < kBenchmarkQueries; ++i) {
+    const auto started = base::TimeTicks::Now();
+    const auto matches = index.Search(queries[i % queries.size()], "saved");
+    micros.push_back((base::TimeTicks::Now() - started).InMicroseconds());
+    ASSERT_FALSE(matches.empty());
+    ASSERT_LE(matches.size(), 8u);
+    ASSERT_LE(matches.capacity(), 8u);
+    for (const auto& match : matches) {
+      ASSERT_NE(index.Get(match.record), nullptr);
+    }
+  }
+  std::sort(micros.begin(), micros.end());
+  EXPECT_EQ(index.EstimateOwnedBytes(), bytes);
+  EXPECT_LT(micros[kBenchmarkQueries * 95 / 100], 2000);
+  std::printf(
+      "Corpus: %zu pins, %zu folders, %zu total records; "
+      "owned index storage budget %zu bytes; %zu queries median %lld us, "
+      "p95 %lld us; max 8 results\n"
+      "Owned index storage excludes production metadata, icons, and service "
+      "allocations. This corpus includes folder records.\n",
+      pin_count, folder_count, index.size(), bytes, kBenchmarkQueries,
+      static_cast<long long>(micros[kBenchmarkQueries / 2]),
+      static_cast<long long>(micros[kBenchmarkQueries * 95 / 100]));
+}
+}  // namespace
+}  // namespace arcium
