+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "chrome/browser/ui/omnibox/arcium_command_native_result.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "components/omnibox/browser/actions/omnibox_action.h"
+#include "components/omnibox/browser/autocomplete_result.h"
+
+namespace arcium {
+
+bool IsCommandNativeMatchSupported(const AutocompleteMatch& match) {
+  if (AutocompleteMatch::IsFeaturedSearchType(match.type) ||
+      match.type == AutocompleteMatchType::NULL_RESULT_MESSAGE) {
+    return false;
+  }
+  if (match.takeover_action) {
+    switch (match.takeover_action->ActionId()) {
+      case OmniboxActionId::STARTER_PACK_BOOKMARKS:
+      case OmniboxActionId::STARTER_PACK_HISTORY:
+      case OmniboxActionId::STARTER_PACK_TABS:
+      case OmniboxActionId::STARTER_PACK_AI_MODE:
+      case OmniboxActionId::SITE_SEARCH:
+        return false;
+      default:
+        break;
+    }
+  }
+  return true;
+}
+
+bool CanCommandNativeOpenUrlCopy(const AutocompleteMatch& match) {
+  return match.destination_url.is_valid() && !match.post_content &&
+         match.extra_headers.empty() && !match.takeover_action;
+}
+
+std::string CommandNativeSelectionKey(const AutocompleteMatch& match,
+                                      base::UnguessableToken revision,
+                                      uint32_t ordinal) {
+  auto revision_key = [&] {
+    return "native-revision:" + revision.ToString() + ":" +
+           base::NumberToString(ordinal);
+  };
+  const std::u16string_view terms =
+      match.search_terms_args
+          ? std::u16string_view(match.search_terms_args->search_terms)
+      : AutocompleteMatch::IsSearchType(match.type)
+          ? std::u16string_view(match.fill_into_edit.empty()
+                                    ? match.contents
+                                    : match.fill_into_edit)
+          : std::u16string_view();
+  // Oversized metadata deliberately loses cross-publication reconciliation;
+  // truncating terms/body would make distinct intents share a visual key.
+  if (match.keyword.size() > kMaxNativeSelectionKeyBytes / 4 ||
+      terms.size() > kMaxNativeSelectionKeyBytes / 4) {
+    return revision_key();
+  }
+  std::string key = "native:";
+  auto append = [&](std::string_view field) {
+    const std::string length = base::NumberToString(field.size());
+    if (field.size() > kMaxNativeSelectionKeyBytes ||
+        key.size() + length.size() + 1 + field.size() >
+            kMaxNativeSelectionKeyBytes) {
+      return false;
+    }
+    key += length;
+    key += ":";
+    key.append(field);
+    return true;
+  };
+  if (!append(base::NumberToString(static_cast<int>(match.type))) ||
+      !append(match.destination_url.spec()) ||
+      !append(base::UTF16ToUTF8(match.keyword)) ||
+      !append(base::UTF16ToUTF8(terms)) ||
+      !append(match.post_content ? "1" : "0") ||
+      !append(match.post_content ? std::string_view(match.post_content->first)
+                                 : std::string_view()) ||
+      !append(match.post_content ? std::string_view(match.post_content->second)
+                                 : std::string_view()) ||
+      !append(match.takeover_action ? base::NumberToString(static_cast<int>(
+                                          match.takeover_action->ActionId()))
+                                    : std::string()) ||
+      !append(base::NumberToString(match.extra_headers.size()))) {
+    return revision_key();
+  }
+  for (const auto& [name, value] : match.extra_headers) {
+    if (!append(name) || !append(value)) {
+      return revision_key();
+    }
+  }
+  return key;
+}
+
+std::vector<NativeCommandRow> ProjectSupportedNativeCommandRows(
+    const AutocompleteResult& result,
+    base::UnguessableToken revision,
+    size_t limit) {
+  return ProjectNativeCommandRows(result, revision,
+                                  std::min(limit, CommandSession::kMaxResults),
+                                  &IsCommandNativeMatchSupported);
+}
+
+std::optional<uint32_t> GetUnprojectedNativeDefaultOrdinal(
+    const AutocompleteResult& result,
+    std::span<const NativeCommandRow> displayed_rows) {
+  const auto* match = result.default_match();
+  if (!match || !IsCommandNativeMatchSupported(*match) ||
+      !match->destination_url.is_valid() || match->arcium_item ||
+      match->type == AutocompleteMatchType::OPEN_TAB ||
+      match->takeover_action) {
+    return std::nullopt;
+  }
+  for (size_t ordinal = 0; ordinal < result.size(); ++ordinal) {
+    if (&result.match_at(ordinal) != match) {
+      continue;
+    }
+    if (std::ranges::any_of(displayed_rows, [ordinal](const auto& row) {
+          return row.ordinal == ordinal;
+        })) {
+      return std::nullopt;
+    }
+    return static_cast<uint32_t>(ordinal);
+  }
+  return std::nullopt;
+}
+
+bool CommandNativePersistentItemsAllowed(bool feature_enabled,
+                                         bool preference_enabled,
+                                         bool off_the_record,
+                                         bool guest) {
+  return feature_enabled && preference_enabled && !off_the_record && !guest;
+}
+
+AutocompleteInput CreateCommandNativeInput(
+    std::u16string_view query,
+    std::u16string_view engine_keyword,
+    const AutocompleteSchemeClassifier& classifier) {
+  const bool keyword = !engine_keyword.empty() && !query.empty();
+  const std::u16string text =
+      keyword ? std::u16string(engine_keyword) + u" " + std::u16string(query)
+              : std::u16string(query);
+  AutocompleteInput input(text, metrics::OmniboxEventProto::OTHER, classifier);
+  if (keyword) {
+    input.set_in_keyword_mode(true);
+    input.set_allow_exact_keyword_match(true);
+  }
+  return input;
+}
+
+CommandNativeResultLease::CommandNativeResultLease() = default;
+CommandNativeResultLease::~CommandNativeResultLease() = default;
+base::UnguessableToken CommandNativeResultLease::NewRevision() {
+  revision_ = base::UnguessableToken::Create();
+  return revision_;
+}
+std::optional<CommandNativeSelection> CommandNativeResultLease::Resolve(
+    const CommandNativeTarget& target,
+    const AutocompleteResult& result,
+    const AutocompleteInput& input,
+    const FinalizeMatchCallback& finalize,
+    bool retain,
+    std::u16string_view user_text,
+    std::shared_ptr<AutocompleteController> controller_owner) {
+  if (retained_ && retained_->target == target) {
+    return retained_;
+  }
+  if (target.result_revision.is_empty() ||
+      target.result_revision != revision_ || target.ordinal >= result.size()) {
+    return std::nullopt;
+  }
+  CommandNativeSelection selection{
+      std::move(controller_owner), target, result.match_at(target.ordinal),
+      input, user_text.empty() ? input.text() : std::u16string(user_text)};
+  if (!finalize.is_null()) {
+    finalize.Run(&selection.match);
+  }
+  if (retain) {
+    // Replacing the chosen target also cancels any pending confirmation for it.
+    ++acceptance_epoch_;
+    retained_.reset();
+    retained_.emplace(selection);
+  }
+  return selection;
+}
+void CommandNativeResultLease::InvalidateCurrent() {
+  ++acceptance_epoch_;
+  revision_ = {};
+}
+void CommandNativeResultLease::Reset() {
+  InvalidateCurrent();
+  retained_.reset();
+}
+
+}  // namespace arcium
