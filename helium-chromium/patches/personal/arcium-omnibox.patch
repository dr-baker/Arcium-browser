+TEST_F(ArciumCommandSessionTest,
+       EmptyOmniCombinesNativeAndLocalAndDeduplicatesQualifiedOwners) {
+  const CommandLiveTarget source{11, 12};
+  const CommandPersistentTarget current_pin{CommandPersistentKind::kPin,
+                                            "space-a", "shared-item"};
+  const CommandPersistentTarget other_space_pin{CommandPersistentKind::kPin,
+                                                "space-b", "shared-item"};
+  const CommandPersistentTarget favorite{CommandPersistentKind::kFavorite, "",
+                                         "shared-item"};
+  invocation_snapshot_.invocation.source_tab = source;
+  auto current = ProjectLiveCommandRow(source, current_pin, true);
+  current.kind = CommandRowKind::kCurrentTab;
+  invocation_snapshot_.current_tab = current;
+  session_->SetInvocation(CommandInvocationMode::kCurrentTab);
+  auto native = AddProvider(kNativeCommandProvider, {kOmniScope});
+  auto local = AddProvider(kBuiltinCommandProvider, {kSavedScope});
+  local->additional_supported_scopes.push_back(kOmniScope);
+  local->initial_results.rows = {
+      ProjectLiveCommandRow(source, current_pin, true),
+      ProjectLiveCommandRow({21, 22}, other_space_pin, true),
+      ProjectLiveCommandRow({31, 32}, favorite, true),
+      ProjectLiveCommandRow({41, 42}, current_pin, false)};
+  auto later_duplicate = ProjectLiveCommandRow({51, 52}, other_space_pin, true);
+  later_duplicate.selection_key = "late-alias";
+  later_duplicate.is_default = true;
+  local->initial_results.rows.push_back(std::move(later_duplicate));
+
+  Search(kOmniScope, u"");
+
+  ASSERT_EQ(2u, publications_.size());
+  EXPECT_TRUE(publications_[0]->rows.empty());
+  EXPECT_FALSE(publications_[0]->done);
+  ASSERT_TRUE(publications_[0]->current_tab);
+  EXPECT_EQ(current.target, publications_[0]->current_tab->target);
+  const auto& publication = *publications_[1];
+  EXPECT_TRUE(publication.done);
+  ASSERT_TRUE(publication.current_tab);
+  EXPECT_FALSE(publication.current_tab->is_default);
+  ASSERT_EQ(4u, publication.rows.size());
+  EXPECT_EQ(current.target, publication.rows[0].target);
+  EXPECT_EQ(CommandTarget(other_space_pin), publication.rows[1].target);
+  EXPECT_EQ(CommandPersistentSelectionKey(other_space_pin),
+            publication.rows[1].selection_key);
+  EXPECT_TRUE(publication.rows[1].is_default);
+  EXPECT_EQ(CommandTarget(favorite), publication.rows[2].target);
+  EXPECT_EQ(CommandTarget(CommandLiveTarget{41, 42}),
+            publication.rows[3].target);
+  EXPECT_EQ(1u, native->queries.size());
+  EXPECT_EQ(1u, local->queries.size());
