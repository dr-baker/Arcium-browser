+class BrandedScopeIcon final : public gfx::CanvasImageSource {
+ public:
+  enum class Kind { kYouTube, kX, kChat };
+  explicit BrandedScopeIcon(Kind kind)
+      : CanvasImageSource(gfx::Size(16, 16)), kind_(kind) {}
+  void Draw(gfx::Canvas* canvas) override {
+    cc::PaintFlags paint;
+    paint.setAntiAlias(true);
+    if (kind_ == Kind::kYouTube) {
+      paint.setColor(kYouTubeTint);
+      canvas->sk_canvas()->drawRoundRect(SkRect::MakeXYWH(0, 2, 16, 12), 3, 3,
+                                         paint);
+      SkPathBuilder path;
+      path.moveTo(6, 5);
+      path.lineTo(11, 8);
+      path.lineTo(6, 11);
+      path.close();
+      paint.setColor(SK_ColorWHITE);
+      canvas->sk_canvas()->drawPath(path.detach(), paint);
+    } else if (kind_ == Kind::kX) {
+      paint.setColor(SkColorSetRGB(0x76, 0x81, 0x8e));
+      paint.setStyle(cc::PaintFlags::kStroke_Style);
+      paint.setStrokeWidth(1.6f);
+      canvas->sk_canvas()->drawLine(3, 2, 13, 14, paint);
+      canvas->sk_canvas()->drawLine(13, 2, 3, 14, paint);
+    } else {
+      canvas->sk_canvas()->scale(16.f / 24.f, 16.f / 24.f);
+      paint.setColor(kChatGPTTint);
+      paint.setStyle(cc::PaintFlags::kStroke_Style);
+      paint.setStrokeWidth(1.6f);
+      paint.setStrokeCap(cc::PaintFlags::kRound_Cap);
+      paint.setStrokeJoin(cc::PaintFlags::kRound_Join);
+      SkPathBuilder path;
+      path.moveTo(4, 5)
+          .lineTo(20, 5)
+          .lineTo(20, 17)
+          .lineTo(9, 17)
+          .lineTo(4, 21)
+          .close();
+      path.moveTo(12, 7)
+          .lineTo(12.9f, 9.1f)
+          .lineTo(15, 10)
+          .lineTo(12.9f, 10.9f)
+          .lineTo(12, 13)
+          .lineTo(11.1f, 10.9f)
+          .lineTo(9, 10)
+          .lineTo(11.1f, 9.1f)
+          .close();
+      canvas->sk_canvas()->drawPath(path.detach(), paint);
+    }
+  }
+
+ private:
+  Kind kind_;
+};
