+class ArciumCommandNativeControllerLifetimeTest : public testing::Test {
+ protected:
+  std::shared_ptr<AutocompleteController> CreateController() {
+    auto client = std::make_unique<FakeAutocompleteProviderClient>();
+    omnibox::RegisterProfilePrefs(static_cast<PrefRegistrySimple*>(
+        client->GetPrefs()->DeprecatedGetPrefRegistry()));
+    return std::make_shared<AutocompleteController>(
+        std::move(client), AutocompleteControllerConfig{.provider_types = 0});
+  }
+
+  AutocompleteInput CreateInput() {
+    return AutocompleteInput(u"query", metrics::OmniboxEventProto::OTHER,
+                             scheme_classifier_);
+  }
+
+  base::test::SingleThreadTaskEnvironment task_environment_;
+  TestSchemeClassifier scheme_classifier_;
+  CommandNativeResultLease lease_;
+};
+
+TEST_F(ArciumCommandNativeControllerLifetimeTest,
+       RetainedAndReturnedSelectionKeepControllerAliveUntilConsumed) {
+  auto owner = CreateController();
+  std::weak_ptr<AutocompleteController> weak_owner = owner;
+  AutocompleteResult result;
+  result.AppendMatches({MakeNativeMatch("https://selected.test/", 10)});
+  auto input = CreateInput();
+  const CommandNativeTarget target{lease_.NewRevision(), 0};
+  auto selection =
+      lease_.Resolve(target, result, input, {}, true, u"query", owner);
+  ASSERT_TRUE(selection);
+  EXPECT_EQ(owner, selection->controller_owner);
+  owner.reset();
+  EXPECT_FALSE(weak_owner.expired());
+  EXPECT_EQ(1u, lease_.retained_count_for_testing());
+
+  lease_.InvalidateCurrent();
+  EXPECT_FALSE(weak_owner.expired());
+  lease_.Reset();
+  EXPECT_EQ(0u, lease_.retained_count_for_testing());
+  EXPECT_FALSE(weak_owner.expired());
+  selection.reset();
+  EXPECT_TRUE(weak_owner.expired());
+  task_environment_.RunUntilIdle();
+}
+
+TEST_F(ArciumCommandNativeControllerLifetimeTest,
+       ReplacingRetainedMatchDestroysItBeforeReleasingItsController) {
+  auto first_owner = CreateController();
+  std::weak_ptr<AutocompleteController> weak_first_owner = first_owner;
+  auto old_action_destructions = std::make_shared<size_t>(0);
+  AutocompleteResult original;
+  {
+    auto match = MakeNativeMatch("https://first.test/", 10);
+    match.actions.push_back(base::MakeRefCounted<FakeOmniboxAction>(
+        OmniboxActionId::ACTION_IN_SUGGEST,
+        base::BindLambdaForTesting(
+            [weak_first_owner, old_action_destructions]() mutable {
+              EXPECT_FALSE(weak_first_owner.expired());
+              ++*old_action_destructions;
+            })));
+    original.AppendMatches({match});
+  }
+  auto input = CreateInput();
+  const CommandNativeTarget first_target{lease_.NewRevision(), 0};
+  auto first_selection = lease_.Resolve(first_target, original, input, {}, true,
+                                        u"query", first_owner);
+  ASSERT_TRUE(first_selection);
+  first_selection.reset();
+  original.ClearMatches();
+  first_owner.reset();
+  EXPECT_FALSE(weak_first_owner.expired());
+  EXPECT_EQ(0u, *old_action_destructions);
+
+  auto second_owner = CreateController();
+  std::weak_ptr<AutocompleteController> weak_second_owner = second_owner;
+  AutocompleteResult replacement;
+  replacement.AppendMatches({MakeNativeMatch("https://second.test/", 1500)});
+  const CommandNativeTarget second_target{lease_.NewRevision(), 0};
+  auto second_selection = lease_.Resolve(second_target, replacement, input, {},
+                                         true, u"query", second_owner);
+  ASSERT_TRUE(second_selection);
+  EXPECT_EQ(1u, *old_action_destructions);
+  EXPECT_TRUE(weak_first_owner.expired());
+  EXPECT_FALSE(weak_second_owner.expired());
+  EXPECT_EQ(1u, lease_.retained_count_for_testing());
+  second_owner.reset();
+
+  lease_.Reset();
+  EXPECT_FALSE(weak_second_owner.expired());
+  second_selection.reset();
+  EXPECT_TRUE(weak_second_owner.expired());
+  task_environment_.RunUntilIdle();
+}
