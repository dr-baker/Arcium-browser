+class MouseRecordingWidget : public ThemeCopyingWidget {
+ public:
+  explicit MouseRecordingWidget(views::Widget* role_model)
+      : ThemeCopyingWidget(role_model) {}
+
+  void OnMouseEvent(ui::MouseEvent* event) override {
+    ++mouse_event_count;
+    last_type = event->type();
+    last_location = event->location();
+    last_root_location = event->root_location();
+  }
+
+  int mouse_event_count = 0;
+  ui::EventType last_type = ui::EventType::kUnknown;
+  gfx::Point last_location;
+  gfx::Point last_root_location;
+};
