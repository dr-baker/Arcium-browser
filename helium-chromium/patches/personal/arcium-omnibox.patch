@@ -0,0 +1,105 @@
+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#ifndef COMPONENTS_OMNIBOX_BROWSER_ARCIUM_COMMAND_SEARCH_H_
+#define COMPONENTS_OMNIBOX_BROWSER_ARCIUM_COMMAND_SEARCH_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/unguessable_token.h"
+
+class AutocompleteMatch;
+class AutocompleteResult;
+
+namespace arcium {
+
+// A search projection, not a second bookmark/history store. Production adapters
+// supply durable qualified IDs and their existing relevance/frecency signal.
+// Favicons and actions are deliberately absent: resolve them for visible rows.
+struct CommandRecord {
+  std::string id;
+  std::u16string title;
+  std::u16string url;
+  std::u16string context;
+  std::u16string category;
+  int source_relevance = 0;
+  bool suggested = false;
+  // Provider-owned scopes, e.g. a saved YouTube video. Primary scope drives
+  // presentation; membership drives filtering, without duplicating records.
+  std::string primary_scope_id;
+  std::vector<std::string> scope_ids;
+};
+
+// Slots are valid only for this immutable corpus revision. A view must never
+// retain a result ordinal across a replaced search generation.
+struct CommandRecordRef {
+  base::UnguessableToken snapshot;
+  uint64_t revision = 0;
+  uint32_t slot = 0;
+  friend bool operator==(const CommandRecordRef&,
+                         const CommandRecordRef&) = default;
+};
+struct CommandSearchResult {
+  CommandRecordRef record;
+  int text_score = 0;
+  int source_relevance = 0;
+};
+
+class CommandSearchIndex {
+ public:
+  static constexpr size_t kMaxResults = 32;
+  static constexpr size_t kMaxQueryLength = 2048;
+  static constexpr size_t kMaxQueryTerms = 32;
+  CommandSearchIndex(std::vector<CommandRecord> records, uint64_t revision);
+  CommandSearchIndex(const CommandSearchIndex&) = delete;
+  CommandSearchIndex& operator=(const CommandSearchIndex&) = delete;
+  ~CommandSearchIndex();
+
+  std::vector<CommandSearchResult> Search(std::u16string_view query,
+                                          std::string_view scope_id,
+                                          size_t limit = 8) const;
+  const CommandRecord* Get(CommandRecordRef ref) const;
+  CommandRecordRef Ref(size_t slot) const;
+  size_t size() const { return records_.size(); }
+  uint64_t revision() const { return revision_; }
+  // Conservative storage budget, including capacity and inline string space.
+  // No action or favicon cache. Use a process allocator for exact allocations.
+  size_t EstimateOwnedBytes() const;
+
+ private:
+  struct SearchText {
+    std::u16string title;
+    std::u16string url;
+    std::u16string context;
+  };
+  std::vector<CommandRecord> records_;
+  std::vector<SearchText> search_text_;
+  uint64_t revision_;
+  const base::UnguessableToken snapshot_ = base::UnguessableToken::Create();
+};
+
+// Published native results keep their owner's final ordering/default. This
+// projection copies no text, URLs, favicons or actions, and never applies the
+// local corpus matcher. The owner must mint a fresh revision token on EVERY
+// result notification, including asynchronous updates within the same query.
+struct NativeCommandRow {
+  base::UnguessableToken result_revision;
+  uint32_t ordinal;
+  int relevance;
+  int provider_type;
+  int match_type;
+  bool allowed_default;
+  bool is_default;
+};
+std::vector<NativeCommandRow> ProjectNativeCommandRows(
+    const AutocompleteResult& result,
+    base::UnguessableToken result_revision,
+    size_t limit = 8,
+    bool (*supported)(const AutocompleteMatch&) = nullptr);
+
+}  // namespace arcium
+#endif  // COMPONENTS_OMNIBOX_BROWSER_ARCIUM_COMMAND_SEARCH_H_
