+TEST_F(ArciumCommandSessionTest, SynchronousStartPublishesInitializedEpoch) {
+  auto first = AddProvider("first", {"scope"});
+  auto second = AddProvider("second", {"second-scope"});
+  second->additional_supported_scopes.push_back("scope");
+  first->initial_results = {{MakeRow("first", "first-result")}, true};
+  second->initial_results = {{MakeRow("second", "second-result")}, true};
+
+  Search("scope");
+
+  ASSERT_EQ(1u, first->queries.size());
+  ASSERT_EQ(1u, second->queries.size());
+  ASSERT_EQ(2u, publications_.size());
+  EXPECT_GT(publications_[0]->query_epoch, 0u);
+  EXPECT_EQ(first->queries[0].epoch, publications_[0]->query_epoch);
+  EXPECT_EQ(second->queries[0].epoch, publications_[0]->query_epoch);
+  EXPECT_EQ(CommandSession::kMaxResults, first->queries[0].limit);
+  EXPECT_FALSE(publications_[0]->done);
+  EXPECT_TRUE(publications_[1]->done);
+  ASSERT_EQ(2u, publications_[1]->rows.size());
+  EXPECT_EQ("first-result", publications_[1]->rows[0].selection_key);
+  EXPECT_EQ("second-result", publications_[1]->rows[1].selection_key);
+}
