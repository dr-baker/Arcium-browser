+
+SkColor WebsiteTint(const GURL& url) {
+  if (!url.is_valid()) {
+    return kOmniTint;
+  }
+  if (url.DomainIs("youtube.com") || url.DomainIs("youtu.be")) {
+    return kYouTubeTint;
+  }
+  if (url.DomainIs("x.com") || url.DomainIs("twitter.com")) {
+    return kXTint;
+  }
+  if (url.DomainIs("chatgpt.com") || url.DomainIs("chat.openai.com")) {
+    return kChatGPTTint;
+  }
+  return kOmniTint;
+}
