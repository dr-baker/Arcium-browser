+bool BrowserView::ShowArciumCommandBar(bool new_tab) {
+  if (!browser_->is_type_normal() || !toolbar_ || !GetWidget() ||
+      !GetActiveWebContents()) {
+    return false;
+  }
+  if (arcium_command_bar_widget_) {
+    if (arcium_command_bar_closing_) {
+      return true;
+    }
+    arcium_command_bar_location_->omnibox_view()->RevertAll();
+    arcium_command_bar_location_->GetOmniboxController()->StopAutocomplete(
+        true);
+    arcium_command_bar_new_tab_ = new_tab;
+    auto* dialog =
+        arcium_command_bar_widget_->widget_delegate()->AsDialogDelegate();
+    dialog->SetTitle(new_tab ? u"New tab" : u"Current tab");
+    arcium_command_bar_location_->FocusLocation(true, true);
+    if (new_tab) {
+      arcium_command_bar_location_->omnibox_view()->SetUserText(u"", true);
+    }
+    return true;
+  }
+  auto contents = std::make_unique<ArciumCommandBarView>(base::BindRepeating(
+      [](base::WeakPtr<BrowserView> view, bool new_tab) {
+        return view && view->ShowArciumCommandBar(new_tab);
+      },
+      weak_ptr_factory_.GetWeakPtr()));
+  auto bubble = std::make_unique<views::BubbleDialogDelegate>(
+      nullptr, views::BubbleBorder::NONE);
+  bubble->set_parent_window(GetWidget()->GetNativeView());
+  bubble->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  bubble->SetTitle(new_tab ? u"New tab" : u"Current tab");
+  bubble->SetShowTitle(false);
+  bubble->set_close_on_deactivate(true);
+  bubble->set_margins(gfx::Insets(8));
+  contents->SetLayoutManager(std::make_unique<views::FillLayout>());
+  const gfx::Rect bounds = GetBoundsInScreen();
+  const int width = std::clamp(bounds.width() - 80, 240, 640);
+  bubble->SetAnchorRect(
+      gfx::Rect(bounds.CenterPoint().x(),
+                bounds.y() + std::min(180, bounds.height() / 4), 0, 0));
+  // Widget creation lays out its contents synchronously. Attach the location
+  // bar only after the widget exists, so Init can precede its first layout.
+  contents->SetPreferredSize(gfx::Size(width, 48));
+  auto* contents_view = contents.get();
+  bubble->SetContentsView(std::move(contents));
+  arcium_command_bar_new_tab_ = new_tab;
+  arcium_command_bar_accepted_ = false;
+  arcium_command_bar_closing_ = false;
+  arcium_command_bar_delegate_ = std::move(bubble);
+  arcium_command_bar_widget_ = views::BubbleDialogDelegate::CreateBubble(
+      arcium_command_bar_delegate_.get(),
+      base::BindOnce(
+          [](base::WeakPtr<BrowserView> view,
+             views::Widget::ClosedReason reason) {
+            if (view) {
+              // Loss of focus can close the bubble during cross-window
+              // acceptance. The once callback schedules one teardown task.
+              view->arcium_command_bar_closing_ = true;
+              base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+                  FROM_HERE, base::BindOnce(
+                      &BrowserView::DestroyArciumCommandBar, view));
+            }
+          },
+          weak_ptr_factory_.GetWeakPtr()));
+  arcium_command_bar_widget_->AddObserver(this);
+  auto location = std::make_unique<LocationBarView>(
+      browser_.get(), browser_->profile(), browser_->command_controller(),
+      toolbar_, false);
+  location->SetPreferredSize(gfx::Size(width, 48));
+  arcium_command_bar_location_ =
+      contents_view->AddChildView(std::move(location));
+  arcium_command_bar_location_->SetArciumCommandBarDismissCallback(
+      base::BindRepeating(&BrowserView::CloseArciumCommandBar,
+                          weak_ptr_factory_.GetWeakPtr(), false));
+  arcium_command_bar_location_->Init();
+  arcium_command_bar_location_->Update(GetActiveWebContents());
+  arcium_command_bar_widget_->Show();
+  arcium_command_bar_location_->FocusLocation(true, true);
+  if (new_tab) {
+    arcium_command_bar_location_->omnibox_view()->RevertAll();
+    arcium_command_bar_location_->GetOmniboxController()->StopAutocomplete(
+        true);
+    arcium_command_bar_location_->omnibox_view()->SetUserText(u"", true);
+  }
+  return true;
+}
+
+bool BrowserView::IsArciumCommandBarNewTab() const {
+  return arcium_command_bar_widget_ && arcium_command_bar_new_tab_;
+}
+
+void BrowserView::CloseArciumCommandBar(bool accepted) {
+  if (!arcium_command_bar_widget_) {
+    return;
+  }
+  arcium_command_bar_accepted_ |= accepted;
+  if (arcium_command_bar_closing_) {
+    return;
+  }
+  arcium_command_bar_closing_ = true;
+  // Acceptance may activate another tab while the omnibox controller is on
+  // the stack. Close on the next task so its controller can finish first.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+          [](base::WeakPtr<views::Widget> widget) {
+            if (widget) {
+              widget->Close();
+            }
+          },
+          arcium_command_bar_widget_->GetWeakPtr()));
+}
+
+void BrowserView::DestroyArciumCommandBar() {
+  if (!arcium_command_bar_widget_) {
+    return;
+  }
+  arcium_command_bar_widget_->RemoveObserver(this);
+  auto widget = std::move(arcium_command_bar_widget_);
+  auto delegate = std::move(arcium_command_bar_delegate_);
+  arcium_command_bar_location_ = nullptr;
+  arcium_command_bar_new_tab_ = false;
+  arcium_command_bar_closing_ = false;
+  const bool restore_focus = !arcium_command_bar_accepted_ && GetWidget() &&
+                             GetWidget()->IsActive();
+  widget.reset();
+  delegate.reset();
+  if (restore_focus) {
+    RestoreFocus();
+  }
+}
