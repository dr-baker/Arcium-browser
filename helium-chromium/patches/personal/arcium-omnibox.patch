+std::string CommandPersistentSelectionKey(
+    const CommandPersistentTarget& target) {
+  auto field = [](const std::string& value) {
+    return base::NumberToString(value.size()) + ":" + value;
+  };
+  return "saved:" + base::NumberToString(static_cast<int>(target.kind)) + ":" +
+         field(target.space_id) + field(target.item_id);
+}
+
+CommandRow ProjectLiveCommandRow(
+    const CommandLiveTarget& target,
+    std::optional<CommandPersistentTarget> saved_target,
+    bool at_saved_home) {
+  CommandRow row;
+  row.provider_id = kBuiltinCommandProvider;
+  row.target = target;
+  row.selection_key = LiveIdentity(target);
+  row.category = u"Tab";
+  row.primary_verb = u"Switch";
+  row.primary_icon = CommandPrimaryIcon::kSwitch;
+  row.activity = CommandActivity::kDot;
+  row.has_actions = true;
+  if (saved_target &&
+      (saved_target->kind == CommandPersistentKind::kPin ||
+       saved_target->kind == CommandPersistentKind::kFavorite)) {
+    const bool pin = saved_target->kind == CommandPersistentKind::kPin;
+    row.category = pin ? u"Pin" : u"Favorite";
+    row.tint = SkColorSetRGB(0xb3, 0x91, 0x65);
+    row.activity = pin ? CommandActivity::kCircleDot : CommandActivity::kDot;
+    if (at_saved_home) {
+      row.target = *saved_target;
+      row.selection_key = CommandPersistentSelectionKey(*saved_target);
+    }
+  }
+  return row;
+}
