+  EXPECT_TRUE(actions_->executions.empty());
+  wrong_owner.target = CommandProviderTarget{"unregistered", "item"};
+  wrong_owner.provider_id = "unregistered";
+  EXPECT_FALSE(session_->Execute(wrong_owner).success);
+  EXPECT_TRUE(
