+  ASSERT_EQ(1u, provider->resolved_menu_ids.size());
+  EXPECT_EQ("provider-submenu", provider->resolved_menu_ids[0]);
+  EXPECT_EQ(u"filter", provider->resolved_queries[0]);
+  EXPECT_TRUE(actions_->resolved_targets.empty());
+  EXPECT_TRUE(session_->Execute(*menu.entries[0].intent).success);
+  ASSERT_EQ(1u, provider->executions.size());
+  EXPECT_EQ("provider-action-0", provider->executions[0].action_id);
+  EXPECT_TRUE(actions_->executions.empty());
