@@ -0,0 +1,293 @@
+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include <algorithm>
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/omnibox/arcium_command_providers.h"
+
+namespace arcium {
+namespace {
+
+class ProviderCommandSession final : public CommandSession {
+ public:
+  ProviderCommandSession(std::unique_ptr<CommandProviderRegistry> registry,
+                         std::unique_ptr<CommandActionDelegate> actions,
+                         CommandCaptureInvocationCallback capture)
+      : registry_(std::move(registry)),
+        actions_(std::move(actions)),
+        capture_(std::move(capture)) {
+    CHECK(registry_);
+    CHECK(actions_);
+  }
+  ~ProviderCommandSession() override { Cancel(); }
+
+  void SetInvocation(CommandInvocationMode mode) override {
+    Cancel();
+    registry_->ResetRetainedTargets();
+    invocation_ =
+        capture_.is_null() ? CommandInvocationSnapshot() : capture_.Run(mode);
+    invocation_.invocation.mode = mode;
+    actions_->SetInvocation(invocation_.invocation);
+  }
+
+  std::vector<CommandScopeDescriptor> GetScopes() const override {
+    return registry_->GetScopes();
+  }
+
+  void Search(CommandScopeId scope_id,
+              std::u16string query,
+              CommandPublishCallback publish) override {
+    Cancel();
+    registry_->ResetRetainedTargets();
+    scope_id_ = std::move(scope_id);
+    query_ = std::move(query);
+    publish_ = std::move(publish);
+    const uint64_t epoch = epoch_;
+    const auto selected = registry_->ProvidersForScope(scope_id_);
+    if (query_.size() > kMaxQueryLength || selected.empty()) {
+      Publish();
+      return;
+    }
+    active_.reserve(selected.size());
+    // All query state and callback slots exist before any Start() can publish.
+    for (auto* provider : selected) {
+      active_.push_back({provider, {}, false});
+    }
+    auto weak_this = weak_factory_.GetWeakPtr();
+    for (size_t slot = 0; slot < selected.size(); ++slot) {
+      if (!weak_this) {
+        return;
+      }
+      selected[slot]->Start(
+          {epoch, scope_id_, query_, invocation_.invocation, kMaxResults},
+          base::BindRepeating(&ProviderCommandSession::OnProviderResults,
+                              weak_factory_.GetWeakPtr(), epoch, slot));
+    }
+  }
+
+  void Cancel() override {
+    // Invalidate first: Cancel itself may cause a provider's final callback.
+    ++epoch_;
+    weak_factory_.InvalidateWeakPtrs();
+    publish_.Reset();
+    active_.clear();
+    registry_->Cancel();
+  }
+
+  CommandMenu ResolveActions(const CommandTarget& target,
+                             std::string_view menu_id,
+                             std::u16string_view query) override {
+    CommandMenu menu;
+    if (const auto* custom = std::get_if<CommandProviderTarget>(&target);
+        custom && custom->provider_id != kBuiltinCommandProvider) {
+      auto* provider = registry_->FindProvider(custom->provider_id);
+      if (!provider) {
+        return menu;
+      }
+      menu = provider->ResolveActions(*custom, menu_id, query);
+    } else {
+      menu = actions_->ResolveActions(target, menu_id, query);
+    }
+    if (menu.entries.size() > kMaxMenuEntries) {
+      menu.entries.resize(kMaxMenuEntries);
+    }
+    return menu;
+  }
+
+  CommandExecutionResult Execute(const CommandIntent& intent) override {
+    if (const auto* custom = std::get_if<CommandProviderTarget>(&intent.target);
+        custom && custom->provider_id != kBuiltinCommandProvider) {
+      if (custom->provider_id != intent.provider_id) {
+        return {false, false, u"This result is no longer available"};
+      }
+      auto* provider = registry_->FindProvider(custom->provider_id);
+      return provider
+                 ? provider->Execute(intent)
+                 : CommandExecutionResult{
+                       false, false, u"This result is no longer available"};
+    }
+    return actions_->Execute(intent);
+  }
+
+ private:
+  struct ActiveProvider {
+    CommandQueryProvider* provider;
+    std::vector<CommandRow> rows;
+    bool done;
+  };
+
+  void OnProviderResults(uint64_t epoch,
+                         size_t slot,
+                         CommandProviderResults results) {
+    if (epoch != epoch_ || slot >= active_.size()) {
+      return;
+    }
+    if (results.rows.size() > kMaxRows) {
+      results.rows.resize(kMaxRows);
+    }
+    active_[slot].rows = std::move(results.rows);
+    active_[slot].done = results.done;
+    Publish();
+  }
+
+  void Publish() {
+    if (publish_.is_null()) {
+      return;
+    }
+    auto publication = std::make_shared<CommandPublication>();
+    publication->query_epoch = epoch_;
+    publication->revision = base::UnguessableToken::Create();
+    publication->scope_id = scope_id_;
+    publication->query = query_;
+    publication->invocation_text = invocation_.text;
+    publication->scopes = registry_->GetScopes();
+    publication->current_tab = invocation_.current_tab;
+    publication->rows.reserve(kMaxRows);
+    bool typed_search = false;
+    // Preserve owner order/default. Nonempty Omni/Web have one native owner;
+    // empty Omni uses the compact local suggestions.
+    for (const auto& active : active_) {
+      publication->done &= active.done;
+      for (const auto& row : active.rows) {
+        // A native saved match and its exact live alias share one owner. Keep
+        // the first row's rank and preserve the owner's default flag.
+        if (std::holds_alternative<CommandPersistentTarget>(row.target) ||
+            std::holds_alternative<CommandLiveTarget>(row.target)) {
+          const auto duplicate = std::ranges::find_if(
+              publication->rows, [&](const auto& existing) {
+                return existing.target == row.target &&
+                       existing.primary_action_id == row.primary_action_id;
+              });
+          if (duplicate != publication->rows.end()) {
+            duplicate->is_default |= row.is_default;
+            continue;
+          }
+        }
+        if (publication->rows.size() >= kMaxRows) {
+          continue;
+        }
+        if (row.kind == CommandRowKind::kTypedSearch) {
+          if (typed_search) {
+            continue;
+          }
+          typed_search = true;
+        }
+        publication->rows.push_back(row);
+      }
+    }
+    auto callback = publish_;
+    callback.Run(std::move(publication));
+  }
+
+  std::unique_ptr<CommandProviderRegistry> registry_;
+  std::unique_ptr<CommandActionDelegate> actions_;
+  CommandCaptureInvocationCallback capture_;
+  CommandInvocationSnapshot invocation_;
+  CommandScopeId scope_id_;
+  std::u16string query_;
+  uint64_t epoch_ = 0;
+  CommandPublishCallback publish_;
+  std::vector<ActiveProvider> active_;
+  base::WeakPtrFactory<ProviderCommandSession> weak_factory_{this};
+};
+
+}  // namespace
+
+bool CommandQueryProvider::SupportsScope(std::string_view scope_id) const {
+  const auto scopes = GetScopes();
+  return std::ranges::any_of(
+      scopes, [&](const auto& scope) { return scope.id == scope_id; });
+}
+void CommandQueryProvider::ResetRetainedTarget() {}
+CommandMenu CommandQueryProvider::ResolveActions(
+    const CommandProviderTarget& target,
+    std::string_view menu_id,
+    std::u16string_view query) {
+  return {};
+}
+CommandExecutionResult CommandQueryProvider::Execute(
+    const CommandIntent& intent) {
+  return {false, false, u"This action is no longer available"};
+}
+CommandProviderRegistry::CommandProviderRegistry() = default;
+CommandProviderRegistry::~CommandProviderRegistry() = default;
+
+bool CommandProviderRegistry::Register(
+    std::unique_ptr<CommandQueryProvider> provider) {
+  if (!provider || provider->id().empty() || FindProvider(provider->id())) {
+    return false;
+  }
+  const auto existing = GetScopes();
+  const auto scopes = provider->GetScopes();
+  for (size_t i = 0; i < scopes.size(); ++i) {
+    if (scopes[i].id.empty() || scopes[i].provider_id != provider->id() ||
+        std::ranges::any_of(
+            existing,
+            [&](const auto& scope) { return scope.id == scopes[i].id; }) ||
+        std::any_of(scopes.begin(), scopes.begin() + i, [&](const auto& scope) {
+          return scope.id == scopes[i].id;
+        })) {
+      return false;
+    }
+  }
+  providers_.push_back(std::move(provider));
+  return true;
+}
+CommandQueryProvider* CommandProviderRegistry::FindProvider(
+    std::string_view provider_id) const {
+  for (const auto& provider : providers_) {
+    if (provider->id() == provider_id) {
+      return provider.get();
+    }
+  }
+  return nullptr;
+}
+std::vector<CommandQueryProvider*> CommandProviderRegistry::ProvidersForScope(
+    std::string_view scope_id) const {
+  const auto scopes = GetScopes();
+  if (!std::ranges::any_of(
+          scopes, [&](const auto& scope) { return scope.id == scope_id; })) {
+    return {};
+  }
+  std::vector<CommandQueryProvider*> matches;
+  for (const auto& provider : providers_) {
+    if (provider->SupportsScope(scope_id)) {
+      matches.push_back(provider.get());
+    }
+  }
+  return matches;
+}
+std::vector<CommandScopeDescriptor> CommandProviderRegistry::GetScopes() const {
+  std::vector<CommandScopeDescriptor> scopes;
+  for (const auto& provider : providers_) {
+    auto added = provider->GetScopes();
+    scopes.insert(scopes.end(), std::make_move_iterator(added.begin()),
+                  std::make_move_iterator(added.end()));
+  }
+  return scopes;
+}
+void CommandProviderRegistry::Cancel() {
+  for (const auto& provider : providers_) {
+    provider->Cancel();
+  }
+}
+
+void CommandProviderRegistry::ResetRetainedTargets() {
+  for (const auto& provider : providers_) {
+    provider->ResetRetainedTarget();
+  }
+}
+
+std::unique_ptr<CommandSession> CreateCommandSessionForProviders(
+    std::unique_ptr<CommandProviderRegistry> registry,
+    std::unique_ptr<CommandActionDelegate> actions,
+    CommandCaptureInvocationCallback capture) {
+  return std::make_unique<ProviderCommandSession>(
+      std::move(registry), std::move(actions), std::move(capture));
+}
+
+}  // namespace arcium
