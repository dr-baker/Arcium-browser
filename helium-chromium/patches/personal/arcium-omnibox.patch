+
+class Browser;
+
+namespace arcium {
+
+// Launches a site's search page. Web search is accepted from the retained
+// native AutocompleteMatch rather than reconstructed from a template here.
+std::optional<GURL> BuildCommandSearchUrl(std::string_view scope_id,
+                                          std::u16string_view query);
+
+// Builtin action IDs remain namespaced even when another provider supplies a
+// result or appends its own late actions.
+namespace command_action {
+inline constexpr char kOpenCurrent[] = "arcium.open-current";
+inline constexpr char kOpenNewTab[] = "arcium.open-new-tab";
+inline constexpr char kOpenBackgroundTab[] = "arcium.open-background-tab";
+inline constexpr char kOpenNewWindow[] = "arcium.open-new-window";
+inline constexpr char kOpenLittleArc[] = "arcium.open-little-arc";
+inline constexpr char kOpenSplit[] = "arcium.open-split";
+inline constexpr char kCopyUrl[] = "arcium.copy-url";
+inline constexpr char kReload[] = "arcium.reload";
+inline constexpr char kDuplicate[] = "arcium.duplicate";
+inline constexpr char kClose[] = "arcium.close";
+inline constexpr char kMuteSite[] = "arcium.mute-site";
+inline constexpr char kUnmuteSite[] = "arcium.unmute-site";
+inline constexpr char kPin[] = "arcium.pin";
+inline constexpr char kFavorite[] = "arcium.favorite";
+inline constexpr char kReturnHome[] = "arcium.return-home";
+inline constexpr char kReplaceHome[] = "arcium.replace-home";
+inline constexpr char kCopyCurrent[] = "arcium.copy-current";
+inline constexpr char kCopyHome[] = "arcium.copy-home";
+inline constexpr char kMoveToSpace[] = "arcium.move-to-space";
+inline constexpr char kMoveToFolder[] = "arcium.move-to-folder";
+inline constexpr char kCreateFolder[] = "arcium.create-folder";
+inline constexpr char kPromoteFavorite[] = "arcium.promote-favorite";
+inline constexpr char kConvertToTab[] = "arcium.convert-to-tab";
+inline constexpr char kRemove[] = "arcium.remove";
+inline constexpr char kRevealFolder[] = "arcium.reveal-folder";
+inline constexpr char kExpandFolder[] = "arcium.expand-folder";
+inline constexpr char kCollapseFolder[] = "arcium.collapse-folder";
+}  // namespace command_action
+
+// The native provider owns complete AutocompleteMatches. URL lookup and
+// acceptance both revalidate its current revision and ordinal. Acceptance calls
+// ChromeOmniboxClient::OnAutocompleteAccept, preserving the native navigation
+// transition, headers and observers.
+struct CommandNativeActionCallbacks {
+  base::RepeatingCallback<std::optional<GURL>(const CommandNativeTarget&)>
+      resolve_url;
+  base::RepeatingCallback<CommandExecutionResult(const CommandNativeTarget&,
+                                                 WindowOpenDisposition)>
+      accept;
+  // POST bodies, extra headers and takeover actions belong to native
+  // acceptance. A plain destination URL cannot reproduce those requests.
+  base::RepeatingCallback<bool(const CommandNativeTarget&)> can_open_url_copy;
+};
+
+// Browser-owned and UI-independent. Every operation resolves its qualified
+// target again; displaying an action does not grant permission to execute it.
+class ArciumCommandActionRouter {
+ public:
+  explicit ArciumCommandActionRouter(
+      Browser* browser,
+      CommandNativeActionCallbacks native_callbacks = {});
+  ~ArciumCommandActionRouter();
+
+  ArciumCommandActionRouter(const ArciumCommandActionRouter&) = delete;
+  ArciumCommandActionRouter& operator=(const ArciumCommandActionRouter&) =
+      delete;
+
+  void SetInvocation(CommandInvocation invocation);
+  CommandMenu ResolveActions(const CommandTarget& target,
+                             std::string_view menu_id,
+                             std::u16string_view query);
+  CommandExecutionResult Execute(const CommandIntent& intent);
+
+ private:
+  struct ResolvedTarget;
+  ResolvedTarget Resolve(const CommandTarget& target) const;
+  CommandMenu ResolveDestinations(const CommandTarget& target,
+                                  std::string_view menu_id,
+                                  std::u16string_view query);
+  CommandMenu ResolveTabs(const CommandTarget& target,
+                          std::u16string_view query);
+  CommandExecutionResult ExecuteActivate(const CommandIntent& intent,
+                                         const ResolvedTarget& target);
+  CommandExecutionResult ExecuteOpen(
+      const CommandIntent& intent,
+      const ResolvedTarget& target,
+      WindowOpenDisposition disposition,
+      ui::PageTransition transition = ui::PAGE_TRANSITION_LINK);
+  CommandExecutionResult ExecuteSplit(const ResolvedTarget& target);
+
+  raw_ptr<Browser> browser_;
+  CommandNativeActionCallbacks native_callbacks_;
+  CommandInvocation invocation_;
+};
+
+}  // namespace arcium
+
+#endif  // CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_ACTION_ROUTER_H_
