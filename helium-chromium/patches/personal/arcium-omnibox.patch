+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_SESSION_H_
+#define CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_SESSION_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <variant>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/unguessable_token.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/image/image_skia.h"
+#include "url/gurl.h"
+
+namespace arcium {
+
+// IDs are provider-owned strings. Registering a scope requires no enum change.
+using CommandScopeId = std::string;
+using CommandProviderId = std::string;
+inline constexpr char kOmniScope[] = "omni";
+inline constexpr char kWebScope[] = "web";
+inline constexpr char kSavedScope[] = "saved";
+inline constexpr char kYouTubeScope[] = "youtube";
+inline constexpr char kXScope[] = "x";
+inline constexpr char kChatGPTScope[] = "chatgpt";
+inline constexpr char kBuiltinCommandProvider[] = "arcium";
+inline constexpr char kNativeCommandProvider[] = "native";
+
+// Only the browser owner interprets these keys. The presenter never resolves a
+// Browser, Profile, persistent item, provider URL, or native result ordinal.
+enum class CommandPersistentKind {
+  kPin,
+  kFavorite,
+  kPinFolder,
+  kFavoriteFolder
+};
+struct CommandPersistentTarget {
+  CommandPersistentKind kind = CommandPersistentKind::kPin;
+  std::string space_id;
+  std::string item_id;
+  friend bool operator==(const CommandPersistentTarget&,
+                         const CommandPersistentTarget&) = default;
+};
+struct CommandLiveTarget {
+  int browser_session_id = 0;
+  int tab_session_id = 0;
+  friend bool operator==(const CommandLiveTarget&,
+                         const CommandLiveTarget&) = default;
+};
+struct CommandNativeTarget {
+  base::UnguessableToken result_revision;
+  uint32_t ordinal = 0;
+  friend bool operator==(const CommandNativeTarget&,
+                         const CommandNativeTarget&) = default;
+};
+struct CommandUrlTarget {
+  GURL url;
+  friend bool operator==(const CommandUrlTarget&,
+                         const CommandUrlTarget&) = default;
+};
+struct CommandProviderTarget {
+  CommandProviderId provider_id;
+  std::string opaque_id;
+  friend bool operator==(const CommandProviderTarget&,
+                         const CommandProviderTarget&) = default;
+};
+using CommandTarget = std::variant<CommandPersistentTarget,
+                                   CommandLiveTarget,
+                                   CommandNativeTarget,
+                                   CommandUrlTarget,
+                                   CommandProviderTarget>;
+
+// SetInvocation captures the active tab before asynchronous search starts.
+// The mode describes the requested navigation; Profile ownership stays private.
+enum class CommandInvocationMode { kCurrentTab, kNewTab };
+struct CommandInvocation {
+  CommandInvocationMode mode = CommandInvocationMode::kCurrentTab;
+  std::optional<CommandLiveTarget> source_tab;
+};
+
+struct CommandScopeDescriptor {
+  CommandScopeId id;
+  CommandProviderId provider_id;
+  std::u16string label;
+  gfx::ImageSkia icon;
+  SkColor tint = SK_ColorTRANSPARENT;
+  std::u16string placeholder;
+  std::u16string search_verb;
+  std::u16string accessibility_description;
+};
+
+enum class CommandDestinationKind { kSpace, kFolder };
+struct CommandDestination {
+  CommandDestinationKind kind = CommandDestinationKind::kSpace;
+  std::string space_id;
+  std::string folder_id;
+  std::u16string name;
+  friend bool operator==(const CommandDestination&,
+                         const CommandDestination&) = default;
+};
+
+// Action IDs belong to providers. Providers may add late actions without
+// extending a shared enum or putting executable objects in the search index.
+inline constexpr char kActivateCommandAction[] = "activate";
+struct CommandIntent {
+  CommandProviderId provider_id;
+  std::string action_id = kActivateCommandAction;
+  CommandTarget target;
+  std::optional<CommandDestination> destination;
+  std::u16string query;
+  int event_flags = 0;
+};
+struct CommandExecutionResult {
+  bool success = false;
+  bool dismiss = false;
+  std::u16string feedback;
+};
+
+struct CommandMenuEntry {
+  std::string id;
+  std::u16string label;
+  std::u16string detail;
+  gfx::ImageSkia icon;
+  bool enabled = true;
+  std::optional<CommandIntent> intent;
+  // A submenu requests another bounded menu for the same retained target.
+  std::string submenu_id;
+};
+struct CommandMenu {
+  std::string id;
+  std::u16string title;
+  std::vector<CommandMenuEntry> entries;
+  bool filterable = false;
+  std::u16string placeholder;
+};
+
+enum class CommandRowKind { kResult, kTypedSearch, kCurrentTab };
+enum class CommandPrimaryIcon { kGo, kSwitch, kAction };
+enum class CommandActivity { kNone, kDot, kCircle, kCircleDot };
+struct CommandRow {
+  CommandRowKind kind = CommandRowKind::kResult;
+  CommandProviderId provider_id;
+  CommandTarget target;
+  // Visual reconciliation only. Execution always uses the qualified target.
+  std::string selection_key;
+  std::u16string title;
+  std::u16string detail;
+  std::u16string category;
+  // Favicons are resolved only for this bounded visible publication.
+  gfx::ImageSkia icon;
+  SkColor tint = SK_ColorTRANSPARENT;
+  std::u16string primary_verb;
+  CommandPrimaryIcon primary_icon = CommandPrimaryIcon::kGo;
+  CommandActivity activity = CommandActivity::kNone;
+  bool is_default = false;
+  // Cheap structural hint. Capability and destination lookup happens late.
+  bool has_actions = false;
+  std::string primary_action_id = kActivateCommandAction;
+  // Providers may require an exact target choice before activation.
+  std::string primary_submenu_id;
+};
+
+// Each provider notification mints a fresh revision, including synchronous
+// Start() notifications and later updates within the same query. Consumers own
+// a const publication and retain its target while a contextual menu is open.
+struct CommandPublication {
+  uint64_t query_epoch = 0;
+  base::UnguessableToken revision;
+  CommandScopeId scope_id;
+  std::u16string query;
+  std::u16string invocation_text;
+  std::vector<CommandScopeDescriptor> scopes;
+  std::vector<CommandRow> rows;
+  std::optional<CommandRow> current_tab;
+  bool done = true;
+};
+using CommandPublishCallback =
+    base::RepeatingCallback<void(std::shared_ptr<const CommandPublication>)>;
+
+// The presenter consumes only this interface and the value objects above.
+class CommandSession {
+ public:
+  static constexpr size_t kMaxResults = 8;
+  static constexpr size_t kMaxRows = kMaxResults;
+  static constexpr size_t kMaxMenuEntries = 32;
+  static constexpr size_t kMaxQueryLength = 2048;
+  virtual ~CommandSession() = default;
+  virtual void SetInvocation(CommandInvocationMode mode) = 0;
+  virtual std::vector<CommandScopeDescriptor> GetScopes() const = 0;
+  virtual void Search(CommandScopeId scope_id,
+                      std::u16string query,
+                      CommandPublishCallback publish) = 0;
+  virtual void Cancel() = 0;
+  virtual CommandMenu ResolveActions(const CommandTarget& target,
+                                     std::string_view menu_id,
+                                     std::u16string_view query) = 0;
+  virtual CommandExecutionResult Execute(const CommandIntent& intent) = 0;
+};
+
+}  // namespace arcium
+
+#endif  // CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_SESSION_H_
