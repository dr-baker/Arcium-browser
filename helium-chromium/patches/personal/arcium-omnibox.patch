+
+LiveTarget FindLiveTarget(Profile* profile, const CommandLiveTarget& identity) {
+  LiveTarget result;
+  ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+      [profile, &identity, &result](BrowserWindowInterface* window) {
+        Browser* browser = window->GetBrowserForMigrationOnly();
+        if (!browser || browser->profile() != profile ||
+            browser->session_id().id() != identity.browser_session_id) {
+          return true;
+        }
+        TabStripModel* model = browser->tab_strip_model();
+        for (int index = 0; index < model->count(); ++index) {
+          content::WebContents* contents = model->GetWebContentsAt(index);
+          if (contents && sessions::SessionTabHelper::IdForTab(contents).id() ==
+                              identity.tab_session_id) {
+            result = {browser, model->GetTabAtIndex(index)};
+            return false;
+          }
+        }
+        return false;
+      });
+  return result;
+}
