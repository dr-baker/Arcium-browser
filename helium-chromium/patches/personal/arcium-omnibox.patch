+struct ArciumCommandActionRouter::ResolvedTarget {
+  bool valid = false;
+  bool url_copy_safe = true;
+  Browser* owner = nullptr;
+  tabs::TabInterface* tab = nullptr;
+  HeliumSpaceService* spaces = nullptr;
+  std::optional<CommandPersistentTarget> persistent;
+  GURL url;
+  GURL home_url;
+  bool collapsed = false;
+};
+
+ArciumCommandActionRouter::ArciumCommandActionRouter(
+    Browser* browser,
+    CommandNativeActionCallbacks native_callbacks)
+    : browser_(browser), native_callbacks_(std::move(native_callbacks)) {}
+
+ArciumCommandActionRouter::~ArciumCommandActionRouter() = default;
+
+void ArciumCommandActionRouter::SetInvocation(CommandInvocation invocation) {
+  invocation_ = std::move(invocation);
+}
+
+ArciumCommandActionRouter::ResolvedTarget ArciumCommandActionRouter::Resolve(
+    const CommandTarget& target) const {
+  ResolvedTarget result;
+  if (!browser_) {
+    return result;
+  }
+  Profile* profile = browser_->profile();
+  result.spaces = helium::HeliumSpaceServiceFactory::GetForProfile(profile);
+  if (const auto* native = std::get_if<CommandNativeTarget>(&target)) {
+    if (native_callbacks_.resolve_url) {
+      if (std::optional<GURL> url =
+              native_callbacks_.resolve_url.Run(*native)) {
+        result.url = std::move(*url);
+        result.valid = result.url.is_valid();
+      }
+    }
+    result.url_copy_safe = native_callbacks_.can_open_url_copy &&
+                           native_callbacks_.can_open_url_copy.Run(*native);
+    return result;
+  }
+  if (const auto* url = std::get_if<CommandUrlTarget>(&target)) {
+    result.url = url->url;
+    result.valid = result.url.is_valid() && !result.url.is_empty();
+    return result;
+  }
+  if (const auto* live = std::get_if<CommandLiveTarget>(&target)) {
+    const LiveTarget resolved = FindLiveTarget(profile, *live);
+    result.owner = resolved.browser;
+    result.tab = resolved.tab;
+    if (!result.tab) {
+      return result;
+    }
+    result.valid = true;
+    result.url = result.tab->GetContents()->GetLastCommittedURL();
+    if (result.spaces) {
+      const auto kind = result.spaces->GetPersistentItemKind(result.tab);
+      const auto id = result.spaces->GetPersistentItemId(result.tab);
+      if (kind && id) {
+        result.persistent = CommandPersistentTarget{
+            .kind = *kind == PersistentRecordKind::kPin
+                        ? CommandPersistentKind::kPin
+                        : CommandPersistentKind::kFavorite,
+            .space_id =
+                *kind == PersistentRecordKind::kPin
+                    ? std::string(result.spaces->GetExplicitSpaceIdForBrowser(
+                          result.owner))
+                    : std::string(),
+            .item_id = *id};
+        std::u16string home_title;
+        result.spaces->GetPersistentItemHome(result.tab, &result.home_url,
+                                             &home_title);
+      }
+    }
+    return result;
+  }
+  const auto* persistent = std::get_if<CommandPersistentTarget>(&target);
+  if (!persistent || !PersistentActionsEnabled(browser_, result.spaces) ||
+      persistent->item_id.empty() ||
+      (IsPin(persistent->kind) && persistent->space_id.empty()) ||
+      (!IsPin(persistent->kind) && !persistent->space_id.empty())) {
+    return result;
+  }
+  PersistentNodes favorites;
+  const PersistentNodes* nodes = nullptr;
+  if (IsPin(persistent->kind)) {
+    HeliumSpace* space = result.spaces->GetSpaceById(persistent->space_id);
+    if (!space) {
+      return result;
+    }
+    nodes = &space->pins();
+  } else {
+    favorites = result.spaces->GetFavoritesForBrowser(browser_);
+    nodes = &favorites;
+  }
+  if (IsFolder(persistent->kind)) {
+    const PersistentFolder* folder =
+        PersistentItemCodec::FindFolder(*nodes, persistent->item_id);
+    if (!folder) {
+      return result;
+    }
+    result.collapsed = folder->collapsed;
+  } else {
+    const PersistentLink* link =
+        PersistentItemCodec::FindLink(*nodes, persistent->item_id);
+    if (!link) {
+      return result;
+    }
+    result.url = link->url;
+    result.home_url = link->url;
+  }
+  result.persistent = *persistent;
+  result.valid = true;
+  const LiveTarget live =
+      FindPersistentTarget(profile, result.spaces, *persistent);
+  result.owner = live.browser;
+  result.tab = IsFolder(persistent->kind) ? nullptr : live.tab;
+  if (!IsPin(persistent->kind) && !result.tab) {
+    // Imported Favorites are visible through the invoking Space's Arc profile.
+    // Another recently activated window can have a different imported set.
+    // The durable record was validated above in this exact invocation context.
+    result.owner = browser_;
+  }
+  if (result.tab) {
+    result.url = result.tab->GetContents()->GetLastCommittedURL();
+  }
+  return result;
+}
+
+CommandMenu ArciumCommandActionRouter::ResolveActions(
+    const CommandTarget& target,
+    std::string_view menu_id,
+    std::u16string_view query) {
+  if (menu_id == "tabs") {
+    return ResolveTabs(target, query);
+  }
+  if (menu_id == command_action::kMoveToSpace ||
+      menu_id == command_action::kMoveToFolder) {
+    return ResolveDestinations(target, menu_id, query);
+  }
+  CommandMenu menu{.id = "actions",
+                   .title = u"Actions",
+                   .filterable = true,
+                   .placeholder = u"Find an action"};
+  if (!menu_id.empty() && menu_id != menu.id) {
+    return FilterActions(std::move(menu), query);
+  }
+  const ResolvedTarget resolved = Resolve(target);
+  if (!resolved.valid) {
+    return menu;
+  }
+  const bool persistent_enabled =
+      PersistentActionsEnabled(browser_, resolved.spaces);
+  if (resolved.persistent && IsFolder(resolved.persistent->kind)) {
+    if (persistent_enabled) {
+      AddAction(&menu, target, command_action::kRevealFolder, u"Reveal folder");
+      AddAction(&menu, target,
+                resolved.collapsed ? command_action::kExpandFolder
+                                   : command_action::kCollapseFolder,
+                resolved.collapsed ? u"Expand folder" : u"Collapse folder");
+    }
+    return FilterActions(std::move(menu), query);
+  }
+  if (resolved.url.is_valid() && !resolved.url.is_empty()) {
+    AddAction(&menu, target, command_action::kOpenCurrent,
+              u"Open in current tab");
+    AddAction(&menu, target, command_action::kOpenNewTab, u"Open in new tab");
+    AddAction(&menu, target, command_action::kOpenBackgroundTab,
+              u"Open in background tab");
+    AddAction(&menu, target, command_action::kOpenNewWindow,
+              u"Open in new window");
+    if (resolved.url_copy_safe &&
+        helium::CanOpenUrlInLittleArc(browser_->profile(), resolved.url)) {
+      AddAction(&menu, target, command_action::kOpenLittleArc,
+                u"Open in Little Arc");
+    }
+    if (resolved.url_copy_safe &&
+        invocation_.mode == CommandInvocationMode::kCurrentTab &&
+        invocation_.source_tab && resolved.url.SchemeIsHTTPOrHTTPS()) {
+      const LiveTarget source =
+          FindLiveTarget(browser_->profile(), *invocation_.source_tab);
+      if (source.browser == browser_ &&
+          CanOpenSplit(source.browser, source.tab, resolved.spaces) &&
+          source.tab != resolved.tab &&
+          (!resolved.tab || resolved.persistent ||
+           resolved.owner == source.browser)) {
+        AddAction(&menu, target, command_action::kOpenSplit, u"Open in Split");
+      }
+    }
+    if (!resolved.persistent) {
+      AddAction(&menu, target, command_action::kCopyUrl, u"Copy URL");
+    }
+  }
+  if (resolved.tab) {
+    AddAction(&menu, target, command_action::kReload, u"Reload");
+    const int index =
+        resolved.owner->tab_strip_model()->GetIndexOfTab(resolved.tab);
+    if (!resolved.persistent &&
+        IsOrdinaryTab(resolved.owner, resolved.tab, resolved.spaces) &&
+        chrome::CanDuplicateTabAt(resolved.owner, index)) {
+      AddAction(&menu, target, command_action::kDuplicate, u"Duplicate tab");
+    }
+    if (resolved.owner->tab_strip_model()->IsTabClosable(resolved.tab)) {
+      AddAction(&menu, target, command_action::kClose,
+                resolved.persistent ? u"Close live tab" : u"Close tab");
+    }
+    if (!resolved.tab->GetContents()->GetLastCommittedURL().is_empty()) {
+      const bool muted = IsSiteMuted(*resolved.owner->tab_strip_model(), index);
+      AddAction(&menu, target,
+                muted ? command_action::kUnmuteSite : command_action::kMuteSite,
+                muted ? u"Unmute site" : u"Mute site", kSiteMuteEntryId);
+    }
+    if (CanPersistTab(resolved.owner, resolved.tab, resolved.spaces)) {
+      AddAction(&menu, target, command_action::kPin, u"Pin tab");
+      AddAction(&menu, target, command_action::kFavorite, u"Add to Favorites");
+    }
+  }
+  if (resolved.persistent && persistent_enabled) {
+    const bool can_relocate = !resolved.tab || (!resolved.tab->IsSplit() &&
+                                                !resolved.tab->GetGroup());
+    if (resolved.home_url.is_valid() && !resolved.home_url.is_empty()) {
+      AddAction(&menu, target, command_action::kCopyHome, u"Copy home URL");
+    }
+    if (resolved.tab) {
+      if (resolved.home_url.SchemeIsHTTPOrHTTPS()) {
+        AddAction(&menu, target, command_action::kReturnHome,
+                  u"Return to home");
+      }
+      if (resolved.url.SchemeIsHTTPOrHTTPS()) {
+        AddAction(&menu, target, command_action::kReplaceHome,
+                  u"Replace home with current page");
+      }
+      if (resolved.url.is_valid() && !resolved.url.is_empty()) {
+        AddAction(&menu, target, command_action::kCopyCurrent,
+                  u"Copy current URL");
+      }
+    }
+    if (resolved.persistent->kind == CommandPersistentKind::kPin) {
+      if (can_relocate) {
+        AddSubmenu(&menu, command_action::kMoveToSpace, u"Move to Space");
+        AddSubmenu(&menu, command_action::kMoveToFolder, u"Move to folder");
+      }
+      if (resolved.tab && can_relocate) {
+        AddAction(&menu, target, command_action::kCreateFolder,
+                  u"Create folder around Pin");
+        AddAction(&menu, target, command_action::kPromoteFavorite,
+                  u"Promote to Favorite");
+        AddAction(&menu, target, command_action::kConvertToTab,
+                  u"Convert to ordinary tab");
+      } else if (!resolved.tab) {
+        AddAction(&menu, target, command_action::kRemove, u"Remove Pin");
+      }
+    } else if (can_relocate) {
+      AddAction(&menu, target, command_action::kRemove, u"Remove Favorite");
+    }
+  }
+  return FilterActions(std::move(menu), query);
+}
+
+CommandMenu ArciumCommandActionRouter::ResolveTabs(const CommandTarget& target,
+                                                   std::u16string_view query) {
+  CommandMenu menu{.id = "tabs",
+                   .title = u"Choose tab",
+                   .filterable = true,
+                   .placeholder = u"Search tabs"};
+  if (!std::holds_alternative<CommandNativeTarget>(target)) {
+    return menu;
+  }
+  const ResolvedTarget resolved = Resolve(target);
+  if (!resolved.valid) {
+    return menu;
+  }
+  Profile* profile = browser_->profile();
+  ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+      [profile, &menu, &resolved, query](BrowserWindowInterface* window) {
+        Browser* browser = window->GetBrowserForMigrationOnly();
+        if (!browser || browser->profile() != profile) {
+          return true;
+        }
+        const std::string_view space_id =
+            resolved.spaces
+                ? resolved.spaces->GetExplicitSpaceIdForBrowser(browser)
+                : std::string_view();
+        HeliumSpace* space =
+            resolved.spaces ? resolved.spaces->GetSpaceById(space_id) : nullptr;
+        const std::u16string detail = base::StrCat(
+            {space ? space->name() : u"", space ? u" / " : u"", u"Window ",
+             base::NumberToString16(browser->session_id().id())});
+        TabStripModel* model = browser->tab_strip_model();
+        for (int index = 0; index < model->count(); ++index) {
+          content::WebContents* contents = model->GetWebContentsAt(index);
+          if (!contents || contents->GetLastCommittedURL() != resolved.url ||
+              !MatchesDestination(contents->GetTitle(), detail, query) ||
+              menu.entries.size() >= CommandSession::kMaxMenuEntries) {
+            continue;
+          }
+          const CommandLiveTarget live{
+              .browser_session_id = browser->session_id().id(),
+              .tab_session_id =
+                  sessions::SessionTabHelper::IdForTab(contents).id()};
+          CommandMenuEntry entry;
+          entry.id = base::StrCat(
+              {"tab:", base::NumberToString(live.browser_session_id), ":",
+               base::NumberToString(live.tab_session_id)});
+          entry.label = contents->GetTitle().empty()
+                            ? base::UTF8ToUTF16(resolved.url.spec())
+                            : contents->GetTitle();
+          entry.detail = detail;
+          entry.icon = ActionIcon(kActivateCommandAction);
+          entry.intent = MakeIntent(live, kActivateCommandAction);
+          menu.entries.push_back(std::move(entry));
+        }
+        return true;
+      },
+      BrowserCollection::Order::kActivation);
+  return menu;
+}
+
+CommandMenu ArciumCommandActionRouter::ResolveDestinations(
+    const CommandTarget& target,
+    std::string_view menu_id,
+    std::u16string_view query) {
+  CommandMenu menu{.id = std::string(menu_id),
+                   .title = menu_id == command_action::kMoveToSpace
+                                ? u"Choose Space"
+                                : u"Choose folder",
+                   .filterable = true,
+                   .placeholder = menu_id == command_action::kMoveToSpace
+                                      ? u"Search Spaces"
+                                      : u"Search folders"};
+  const ResolvedTarget resolved = Resolve(target);
+  if (!resolved.valid || !resolved.persistent ||
+      resolved.persistent->kind != CommandPersistentKind::kPin ||
+      !PersistentActionsEnabled(browser_, resolved.spaces) ||
+      (resolved.tab && (resolved.tab->IsSplit() || resolved.tab->GetGroup()))) {
+    return menu;
+  }
+  HeliumSpace* source =
+      resolved.spaces->GetSpaceById(resolved.persistent->space_id);
+  if (!source) {
+    return menu;
+  }
+  if (menu_id == command_action::kMoveToSpace) {
+    for (const HeliumSpace* space : resolved.spaces->GetSpaces()) {
+      if (space->id() == source->id() ||
+          PersistentItemCodec::FindLink(space->pins(),
+                                        resolved.persistent->item_id) ||
+          PersistentItemCodec::FindFolder(space->pins(),
+                                          resolved.persistent->item_id)) {
+        continue;
+      }
+      AddDestination(&menu, target, menu_id,
+                     {.kind = CommandDestinationKind::kSpace,
+                      .space_id = space->id(),
+                      .name = space->name()},
+                     space->name(), query);
+    }
+    return menu;
+  }
+  std::string current_parent;
+  if (!FindParent(source->pins(), resolved.persistent->item_id, {},
+                  &current_parent)) {
+    return menu;
+  }
+  if (!current_parent.empty()) {
+    AddDestination(&menu, target, menu_id,
+                   {.kind = CommandDestinationKind::kFolder,
+                    .space_id = source->id(),
+                    .name = u"Root"},
+                   source->name(), query);
+  }
+  AppendFolderDestinations(source->pins(), target, source->id(), current_parent,
+                           source->name(), query, &menu);
+  return menu;
+}
+
+CommandExecutionResult ArciumCommandActionRouter::ExecuteActivate(
+    const CommandIntent& intent,
+    const ResolvedTarget& target) {
+  if (!target.valid) {
+    return Unavailable();
+  }
+  if (const auto* native = std::get_if<CommandNativeTarget>(&intent.target)) {
+    const auto accept = native_callbacks_.accept;
+    const CommandNativeTarget selection = *native;
+    const auto disposition =
+        InvocationDisposition(invocation_, intent.event_flags);
+    const auto owner = browser_->AsWeakPtr();
+    const auto source = invocation_.source_tab;
+    if (disposition == WindowOpenDisposition::CURRENT_TAB &&
+        !PrepareCurrentTab(owner, source)) {
+      return Unavailable();
+    }
+    return accept ? accept.Run(selection, disposition) : Unavailable();
+  }
+  if (target.tab) {
+    const auto owner = target.owner->AsWeakPtr();
+    const tabs::TabHandle tab = target.tab->GetHandle();
+    owner->tab_strip_model()->ActivateTabAt(
+        owner->tab_strip_model()->GetIndexOfTab(tab.Get()));
+    if (owner && tab.Get() &&
+        owner->tab_strip_model()->GetActiveTab() == tab.Get()) {
+      owner->window()->Show();
+      return Succeeded(u"Switched to tab", true);
+    }
+    return Unavailable();
+  }
+  if (target.persistent) {
+    if (IsFolder(target.persistent->kind)) {
+      CommandIntent reveal = intent;
+      reveal.action_id = command_action::kRevealFolder;
+      return Execute(reveal);
+    }
+    const helium::PersistentOmniboxItem item{
+        .kind = RecordKind(target.persistent->kind),
+        .id = target.persistent->item_id,
+        .space_id = target.persistent->space_id};
+    HeliumSpaceService* spaces = target.spaces;
+    Browser* source = browser_;
+    return spaces->ActivateOmniboxItem(source, item)
+               ? Succeeded(u"Opened saved item", true)
+               : Unavailable();
+  }
+  return ExecuteOpen(intent, target,
+                     InvocationDisposition(invocation_, intent.event_flags),
+                     ui::PAGE_TRANSITION_GENERATED);
+}
+
+CommandExecutionResult ArciumCommandActionRouter::ExecuteOpen(
+    const CommandIntent& intent,
+    const ResolvedTarget& target,
+    WindowOpenDisposition disposition,
+    ui::PageTransition transition) {
+  if (!target.url.is_valid() || target.url.is_empty()) {
+    return Unavailable();
+  }
+  const auto owner = browser_->AsWeakPtr();
+  const auto source = invocation_.source_tab;
+  const GURL url = target.url;
+  const auto accept = native_callbacks_.accept;
+  const auto* native_target = std::get_if<CommandNativeTarget>(&intent.target);
+  const std::optional<CommandNativeTarget> native =
+      native_target ? std::optional(*native_target) : std::nullopt;
+  if (disposition == WindowOpenDisposition::CURRENT_TAB &&
+      !PrepareCurrentTab(owner, source)) {
+    return Unavailable();
+  }
+  if (native) {
+    return accept ? accept.Run(*native, disposition) : Unavailable();
+  }
+  if (!owner) {
+    return Unavailable();
+  }
+  NavigateParams params(owner.get(), url, transition);
+  params.disposition = disposition;
+  params.user_gesture = true;
+  const auto navigation = Navigate(&params);
+  return params.navigated_or_inserted_contents || navigation
+             ? Succeeded(u"Opened page", true)
+             : Unavailable();
+}
+
+CommandExecutionResult ArciumCommandActionRouter::ExecuteSplit(
+    const ResolvedTarget& target) {
+  if (invocation_.mode != CommandInvocationMode::kCurrentTab ||
+      !invocation_.source_tab) {
+    return Unavailable();
+  }
+  const auto source = *invocation_.source_tab;
+  const auto owner = browser_->AsWeakPtr();
+  const GURL url = target.url;
+  HeliumSpaceService* spaces = target.spaces;
+  return OpenSplitCopy(owner, source, url, spaces);
+}
+
+CommandExecutionResult ArciumCommandActionRouter::Execute(
+    const CommandIntent& intent) {
+  // Other providers own their late actions. The session's registry delegates
+  // those actions before reaching this builtin router.
+  if (intent.provider_id != kBuiltinCommandProvider &&
+      intent.provider_id != kNativeCommandProvider) {
+    return Unavailable();
+  }
+  const ResolvedTarget target = Resolve(intent.target);
+  if (!target.valid) {
+    return Unavailable();
+  }
+  if (intent.action_id == kActivateCommandAction) {
+    if (target.persistent &&
+        !PersistentActionsEnabled(browser_, target.spaces)) {
+      return Unavailable();
+    }
+    return ExecuteActivate(intent, target);
+  }
+  // Rebuild only this target's inexpensive action list at execution. No
+  // destination enumeration or executable closure is stored in a search row.
+  const CommandMenu current_actions = ResolveActions(intent.target, {}, {});
+  if (!HasAction(current_actions, intent.action_id)) {
+    return Unavailable();
+  }
+  const std::string action = intent.action_id;
+  if ((action == command_action::kOpenLittleArc ||
+       action == command_action::kOpenSplit) &&
+      std::holds_alternative<CommandNativeTarget>(intent.target)) {
+    const auto can_copy = native_callbacks_.can_open_url_copy;
+    const auto native = std::get<CommandNativeTarget>(intent.target);
+    if (!can_copy || !can_copy.Run(native)) {
+      return Unavailable();
+    }
+  }
+  if (action == command_action::kOpenCurrent) {
+    return ExecuteOpen(intent, target, WindowOpenDisposition::CURRENT_TAB);
+  }
+  if (action == command_action::kOpenNewTab) {
+    return ExecuteOpen(intent, target,
+                       WindowOpenDisposition::NEW_FOREGROUND_TAB);
+  }
+  if (action == command_action::kOpenBackgroundTab) {
+    return ExecuteOpen(intent, target,
+                       WindowOpenDisposition::NEW_BACKGROUND_TAB);
+  }
+  if (action == command_action::kOpenNewWindow) {
+    return ExecuteOpen(intent, target, WindowOpenDisposition::NEW_WINDOW);
+  }
+  if (action == command_action::kOpenLittleArc) {
+    Profile* profile = browser_->profile();
+    const GURL url = target.url;
+    return helium::OpenUrlsInLittleArc(profile, {url})
+               ? Succeeded(u"Opened Little Arc", true)
+               : Unavailable();
+  }
+  if (action == command_action::kOpenSplit) {
+    return ExecuteSplit(target);
+  }
+  if (action == command_action::kCopyUrl ||
+      action == command_action::kCopyCurrent ||
+      action == command_action::kCopyHome) {
+    const GURL url =
+        action == command_action::kCopyHome ? target.home_url : target.url;
+    if (!url.is_valid() || url.is_empty()) {
+      return Unavailable();
+    }
+    ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+    writer.WriteText(base::UTF8ToUTF16(url.spec()));
+    return Succeeded(u"Copied URL");
+  }
+  if (action == command_action::kMoveToSpace ||
+      action == command_action::kMoveToFolder) {
+    if (!target.persistent ||
+        target.persistent->kind != CommandPersistentKind::kPin ||
+        !intent.destination) {
+      return Unavailable();
+    }
+    const CommandPersistentTarget identity = *target.persistent;
+    const CommandDestination destination = *intent.destination;
+    HeliumSpaceService* spaces = target.spaces;
+    Browser* context = browser_;
+    HeliumSpace* source = spaces->GetSpaceById(identity.space_id);
+    if (!source ||
+        !PersistentItemCodec::FindLink(source->pins(), identity.item_id)) {
+      return Unavailable();
+    }
+    if (action == command_action::kMoveToSpace) {
+      HeliumSpace* destination_space =
+          spaces->GetSpaceById(destination.space_id);
+      if (destination.kind != CommandDestinationKind::kSpace ||
+          !destination.folder_id.empty() || !destination_space ||
+          destination.space_id == identity.space_id ||
+          PersistentItemCodec::FindLink(destination_space->pins(),
+                                        identity.item_id) ||
+          PersistentItemCodec::FindFolder(destination_space->pins(),
+                                          identity.item_id)) {
+        return Unavailable();
+      }
+      return spaces->MovePinToSpace(context, identity.item_id,
+                                    identity.space_id, destination.space_id)
+                 ? Succeeded(u"Moved Pin to Space", true)
+                 : Unavailable();
+    }
+    std::string parent;
+    if (destination.kind != CommandDestinationKind::kFolder ||
+        destination.space_id != identity.space_id ||
+        (!destination.folder_id.empty() &&
+         !PersistentItemCodec::FindFolder(source->pins(),
+                                          destination.folder_id)) ||
+        !FindParent(source->pins(), identity.item_id, {}, &parent) ||
+        parent == destination.folder_id) {
+      return Unavailable();
+    }
+    // Validate against the current tree, including no-op and cycle rules.
+    PersistentNodes staged = source->pins();
+    if (!PersistentItemCodec::MoveNode(staged, identity.item_id,
+                                       destination.folder_id, {})) {
+      return Unavailable();
+    }
+    return spaces->MovePinInSpace(context, identity.space_id, identity.item_id,
+                                  destination.folder_id, {})
+               ? Succeeded(u"Moved Pin to folder", true)
+               : Unavailable();
+  }
+  if (action == command_action::kRevealFolder) {
+    const auto context = browser_->AsWeakPtr();
+    HeliumSpaceService* spaces = target.spaces;
+    const CommandPersistentTarget identity = *target.persistent;
+    return RevealFolder(context, spaces, identity);
+  }
+  if (action == command_action::kExpandFolder ||
+      action == command_action::kCollapseFolder) {
+    const CommandPersistentTarget identity = *target.persistent;
+    HeliumSpaceService* spaces = target.spaces;
+    Browser* context = browser_;
+    const bool changed =
+        IsPin(identity.kind)
+            ? spaces->TogglePinFolderCollapsedInSpace(
+                  context, identity.space_id, identity.item_id)
+            : spaces->ToggleFolderCollapsed(
+                  context, PersistentRecordKind::kFavorite, identity.item_id);
+    return changed ? Succeeded(action == command_action::kExpandFolder
+                                   ? u"Expanded folder"
+                                   : u"Collapsed folder")
+                   : Unavailable();
+  }
+  if (action == command_action::kRemove) {
+    const CommandPersistentTarget identity = *target.persistent;
+    HeliumSpaceService* spaces = target.spaces;
+    Browser* context = target.owner ? target.owner : browser_.get();
+    const bool removed =
+        IsPin(identity.kind)
+            ? spaces->RemovePersistentItemInSpace(context, identity.space_id,
+                                                  identity.item_id)
+            : spaces->RemovePersistentItem(
+                  context, PersistentRecordKind::kFavorite, identity.item_id);
+    return removed ? Succeeded(IsPin(identity.kind) ? u"Removed Pin"
+                                                    : u"Removed Favorite",
+                               true)
+                   : Unavailable();
+  }
+  if (!target.tab || !target.owner) {
+    return Unavailable();
+  }
+  tabs::TabInterface* tab = target.tab;
+  Browser* owner = target.owner;
+  TabStripModel* model = owner->tab_strip_model();
+  HeliumSpaceService* spaces = target.spaces;
+  const int index = model->GetIndexOfTab(tab);
+  if (index == TabStripModel::kNoTab) {
+    return Unavailable();
+  }
+  if (action == command_action::kReload) {
+    tab->GetContents()->GetController().Reload(content::ReloadType::NORMAL,
+                                               true);
+    return Succeeded(u"Reloading tab");
+  }
+  if (action == command_action::kDuplicate) {
+    return chrome::DuplicateTabAt(owner, index)
+               ? Succeeded(u"Duplicated tab", true)
+               : Unavailable();
+  }
+  if (action == command_action::kClose) {
+    if (target.persistent) {
+      const CommandPersistentTarget identity = *target.persistent;
+      return spaces->ClosePersistentItemInstance(
+                 owner, RecordKind(identity.kind), identity.item_id,
+                 identity.space_id)
+                 ? Succeeded(u"Closing live tab", true)
+                 : Unavailable();
+    }
+    // ExecuteContextMenuCommand can expand a single target to the selection
+    // and to other split members. Close exactly the resolved WebContents.
+    model->CloseWebContentsAt(index,
+                              TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB |
+                                  TabCloseTypes::CLOSE_USER_GESTURE);
+    return Succeeded(u"Closing tab", true);
+  }
+  if (action == command_action::kMuteSite ||
+      action == command_action::kUnmuteSite) {
+    return SetOneSiteMuted(tab->GetContents(),
+                           action == command_action::kMuteSite)
+               ? Succeeded(action == command_action::kMuteSite
+                               ? u"Muted site"
+                               : u"Unmuted site")
+               : Unavailable();
+  }
+  if (action == command_action::kPin) {
+    const std::string space_id(spaces->GetExplicitSpaceIdForBrowser(owner));
+    return spaces->ConvertTabToPinInSpace(owner, space_id, tab, {}, {})
+               ? Succeeded(u"Pinned tab")
+               : Unavailable();
+  }
+  if (action == command_action::kFavorite) {
+    return spaces->AddFavoriteFromTab(tab) ? Succeeded(u"Added to Favorites")
+                                           : Unavailable();
+  }
+  if (action == command_action::kCreateFolder) {
+    return spaces->CreatePinFolderForTab(tab)
+               ? Succeeded(u"Created folder around Pin")
+               : Unavailable();
+  }
+  if (action == command_action::kReplaceHome) {
+    return spaces->ReplacePersistentItemHome(tab)
+               ? Succeeded(u"Replaced home with current page")
+               : Unavailable();
+  }
+  if (!target.persistent) {
+    return Unavailable();
+  }
+  const CommandPersistentTarget identity = *target.persistent;
+  if (action == command_action::kReturnHome) {
+    return spaces->ReturnPersistentItemHome(owner, RecordKind(identity.kind),
+                                            identity.item_id, identity.space_id)
+               ? Succeeded(u"Returned to home")
+               : Unavailable();
+  }
+  if (action == command_action::kPromoteFavorite) {
+    return spaces->PromotePinToFavorite(owner, identity.space_id,
+                                        identity.item_id)
+               ? Succeeded(u"Promoted Pin to Favorite", true)
+               : Unavailable();
+  }
+  if (action == command_action::kConvertToTab) {
+    return spaces->ConvertPinToTabInSpace(owner, identity.space_id,
+                                          identity.item_id, std::nullopt)
+               ? Succeeded(u"Converted Pin to ordinary tab", true)
+               : Unavailable();
+  }
+  return Unavailable();
+}
