+TEST_F(ArciumCommandActionRouterTest,
+       ExistingSplitRejectsUnassociatedPinnedPanes) {
+  auto* source = AddOrdinaryTab("https://source.test/");
+  auto* other = AddOrdinaryTab("https://other.test/");
+  TabStripModel* model = browser()->tab_strip_model();
+  model->ActivateTabAt(model->GetIndexOfTab(source));
+  const auto ordinary_split = model->AddToNewSplit(
+      {model->GetIndexOfTab(other)}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kKeyboardShortcut);
+  ASSERT_TRUE(model->ContainsSplit(ordinary_split));
+  Capture(source);
+  const CommandUrlTarget destination{.url = GURL("https://destination.test/")};
+  ASSERT_TRUE(HasAction(router_->ResolveActions(destination, {}, {}),
+                        command_action::kOpenSplit));
+
+  // SetTabPinned is a product Pin request and rejects existing split members.
+  // Insert native pinned tabs to exercise the unsupported structural state.
+  const auto add_native_pinned = [&] {
+    const int index = model->InsertWebContentsAt(
+        model->count(),
+        content::WebContents::Create(
+            content::WebContents::CreateParams(profile())),
+        AddTabTypes::ADD_ACTIVE | AddTabTypes::ADD_PINNED);
+    return model->GetTabAtIndex(index);
+  };
+  auto* pinned_source = add_native_pinned();
+  auto* pinned_other = add_native_pinned();
+  model->ActivateTabAt(model->GetIndexOfTab(pinned_source));
+  const auto pinned_split = model->AddToNewSplit(
+      {model->GetIndexOfTab(pinned_other)}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kKeyboardShortcut);
+  ASSERT_TRUE(model->ContainsSplit(pinned_split));
+  ASSERT_EQ(pinned_source->GetSplit(), pinned_split);
+  ASSERT_EQ(pinned_other->GetSplit(), pinned_split);
+  ASSERT_TRUE(pinned_source->IsPinned());
+  ASSERT_TRUE(pinned_other->IsPinned());
+  ASSERT_FALSE(spaces_->IsPersistentItemTab(pinned_source));
+  ASSERT_FALSE(spaces_->IsPersistentItemTab(pinned_other));
+  Capture(pinned_source);
+  EXPECT_FALSE(HasAction(router_->ResolveActions(destination, {}, {}),
+                         command_action::kOpenSplit));
+  EXPECT_FALSE(router_->Execute(Intent(destination, command_action::kOpenSplit))
+                   .success);
+  EXPECT_EQ(4, model->count());
+  EXPECT_EQ(pinned_source->GetSplit(), pinned_split);
+  EXPECT_EQ(pinned_other->GetSplit(), pinned_split);
+}
