+TEST_F(ArciumCommandNativeResultLeaseTest,
+       ChangingSelectedTargetRejectsConfirmationWithinTheSameRevision) {
+  AutocompleteResult result;
+  result.AppendMatches({MakeNativeMatch("https://first.test/", 10),
+                        MakeNativeMatch("https://second.test/", 1500)});
+  auto input = MakeInput(u"query", "https://source.test/");
+  const auto revision = lease_.NewRevision();
+  const CommandNativeTarget first{revision, 0};
+  const CommandNativeTarget second{revision, 1};
+  ASSERT_TRUE(lease_.Resolve(first, result, input, {}, true));
+  const uint64_t first_epoch = lease_.acceptance_epoch();
+  std::vector<GURL> accepted_urls;
+  PostConfirmation(first_epoch, first, result, input, accepted_urls);
+
+  EXPECT_TRUE(lease_.Resolve(second, result, input, {}, true));
+  const uint64_t second_epoch = lease_.acceptance_epoch();
+  EXPECT_GT(second_epoch, first_epoch);
+  EXPECT_FALSE(lease_.IsAcceptanceCurrent(first_epoch));
+  EXPECT_EQ(1u, lease_.retained_count_for_testing());
+  EXPECT_TRUE(lease_.Resolve(second, result, input, {}, true));
+  EXPECT_EQ(second_epoch, lease_.acceptance_epoch());
+  PostConfirmation(second_epoch, second, result, input, accepted_urls);
+  task_environment_.RunUntilIdle();
+
+  ASSERT_EQ(1u, accepted_urls.size());
+  EXPECT_EQ(GURL("https://second.test/"), accepted_urls[0]);
+}
+
+TEST_F(ArciumCommandNativeResultLeaseTest,
+       ConsumptionClearsCurrentAndRetainedConfirmationAuthority) {
+  AutocompleteResult result;
+  result.AppendMatches({MakeNativeMatch("https://selected.test/", 10),
+                        MakeNativeMatch("https://current.test/", 1500)});
+  auto input = MakeInput(u"query", "https://source.test/");
+  const CommandNativeTarget retained{lease_.NewRevision(), 0};
+  ASSERT_TRUE(lease_.Resolve(retained, result, input, {}, true));
+  const CommandNativeTarget current{lease_.NewRevision(), 1};
+  ASSERT_TRUE(lease_.Resolve(current, result, input, {}, false));
+  const uint64_t pending_epoch = lease_.acceptance_epoch();
+  std::vector<GURL> accepted_urls;
+  PostConfirmation(pending_epoch, retained, result, input, accepted_urls);
+  PostConfirmation(pending_epoch, current, result, input, accepted_urls);
+
+  lease_.Reset();
+  EXPECT_FALSE(lease_.IsAcceptanceCurrent(pending_epoch));
+  EXPECT_EQ(0u, lease_.retained_count_for_testing());
+  EXPECT_TRUE(lease_.revision().is_empty());
+  const uint64_t consumed_epoch = lease_.acceptance_epoch();
+  PostConfirmation(consumed_epoch, retained, result, input, accepted_urls);
+  PostConfirmation(consumed_epoch, current, result, input, accepted_urls);
+  task_environment_.RunUntilIdle();
+
+  EXPECT_TRUE(accepted_urls.empty());
+  EXPECT_FALSE(lease_.Resolve(retained, result, input, {}, false));
+  EXPECT_FALSE(lease_.Resolve(current, result, input, {}, false));
+}
