+class FakeOmniboxAction final : public OmniboxAction {
+ public:
+  explicit FakeOmniboxAction(OmniboxActionId id,
+                             base::OnceClosure on_destroy = {})
+      : OmniboxAction(LabelStrings(u"Test action",
+                                   u"Test action",
+                                   u"action",
+                                   u"Test action"),
+                      GURL()),
+        id_(id),
+        on_destroy_(std::move(on_destroy)) {}
+
+  OmniboxActionId ActionId() const override { return id_; }
+
+ private:
+  ~FakeOmniboxAction() override {
+    if (!on_destroy_.is_null()) {
+      std::move(on_destroy_).Run();
+    }
+  }
+
+  const OmniboxActionId id_;
+  base::OnceClosure on_destroy_;
+};
