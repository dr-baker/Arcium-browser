+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_SPACE_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_SPACE_H_
+
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+class BrowserWindowInterface;
+class Profile;
+
+namespace helium {
+
+// User-facing browsing context within a Chromium Profile.
+class HeliumSpace {
+ public:
+  HeliumSpace(Profile* profile, std::string id, std::u16string name);
+  HeliumSpace(const HeliumSpace&) = delete;
+  HeliumSpace& operator=(const HeliumSpace&) = delete;
+  ~HeliumSpace();
+
+  Profile* profile() const { return profile_; }
+
+  const std::string& id() const { return id_; }
+  const std::u16string& name() const { return name_; }
+
+  void SetName(std::u16string name);
+
+  // Primary TYPE_NORMAL tabbed window for this Space, if any.
+  BrowserWindowInterface* GetPrimaryBrowser() const;
+
+  // Activate the primary window, or create one when missing.
+  BrowserWindowInterface* ActivateOrCreatePrimaryWindow();
+
+ private:
+  raw_ptr<Profile> profile_;
+  std::string id_;
+  std::u16string name_;
+};
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_SPACE_H_
Index: src/chrome/browser/ui/helium/helium_space_service.cc
===================================================================
--- src.orig/chrome/browser/ui/helium/helium_space_service.cc
+++ src/chrome/browser/ui/helium/helium_space_service.cc
@@ -0,0 +1,218 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_space_service.h"
+
+#include "base/strings/utf_string_conversions.h"
+#include "base/uuid.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_window/public/profile_browser_collection.h"
+#include "chrome/browser/ui/helium/helium_space.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+
+namespace helium {
+
+HeliumSpaceService::HeliumSpaceService(Profile* profile) : profile_(profile) {
+  auto* browser_collection = ProfileBrowserCollection::GetForProfile(profile_);
+  browser_collection_observation_.Observe(browser_collection);
+  LoadSpaces();
+  EnsureDefaultSpace();
+  // The service can be created while the first BrowserView is being assembled,
+  // after its creation notification. Adopt that window immediately as well as
+  // observing later windows.
+  OnBrowserCreated(browser_collection->FindTabbedBrowser());
+}
+
+HeliumSpaceService::~HeliumSpaceService() = default;
+
+void HeliumSpaceService::LoadSpaces() {
+  constexpr char kIdKey[] = "id";
+  constexpr char kNameKey[] = "name";
+  for (const base::Value& value :
+       profile_->GetPrefs()->GetList(kHeliumSpacesPref)) {
+    const base::DictValue* record = value.GetIfDict();
+    if (!record) {
+      continue;
+    }
+    const std::string* id = record->FindString(kIdKey);
+    const std::string* name = record->FindString(kNameKey);
+    if (!id || id->empty()) {
+      continue;
+    }
+    spaces_.push_back(std::make_unique<HeliumSpace>(
+        profile_, *id, name ? base::UTF8ToUTF16(*name) : u"Space"));
+  }
+}
+
+void HeliumSpaceService::EnsureDefaultSpace() {
+  if (!spaces_.empty()) {
+    if (profile_->GetPrefs()->GetString(kHeliumActiveSpaceIdPref).empty()) {
+      SetActiveSpace(spaces_.front()->id());
+    }
+    return;
+  }
+
+  PrefService* prefs = profile_->GetPrefs();
+  std::string id = prefs->GetString(prefs::kHeliumSpaceId);
+  if (id.empty()) {
+    id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  }
+  const std::string& legacy_name = prefs->GetString(prefs::kHeliumSpaceName);
+  GetOrCreateSpace(std::move(id), legacy_name.empty()
+                                      ? u"Space"
+                                      : base::UTF8ToUTF16(legacy_name));
+}
+
+HeliumSpace* HeliumSpaceService::GetDefaultSpace() {
+  EnsureDefaultSpace();
+  return spaces_.front().get();
+}
+
+const HeliumSpace* HeliumSpaceService::GetDefaultSpace() const {
+  return spaces_.empty() ? nullptr : spaces_.front().get();
+}
+
+HeliumSpace* HeliumSpaceService::GetActiveSpace() {
+  EnsureDefaultSpace();
+  const std::string& active_id =
+      profile_->GetPrefs()->GetString(kHeliumActiveSpaceIdPref);
+  if (HeliumSpace* active = GetSpaceById(active_id)) {
+    return active;
+  }
+  return spaces_.front().get();
+}
+
+HeliumSpace* HeliumSpaceService::GetSpaceById(std::string_view id) {
+  for (const auto& space : spaces_) {
+    if (space->id() == id) {
+      return space.get();
+    }
+  }
+  return nullptr;
+}
+
+HeliumSpace* HeliumSpaceService::GetOrCreateSpace(std::string id,
+                                                  std::u16string name) {
+  if (HeliumSpace* existing = GetSpaceById(id)) {
+    existing->SetName(std::move(name));
+    return existing;
+  }
+
+  base::DictValue record;
+  record.Set("id", id);
+  record.Set("name", base::UTF16ToUTF8(name.empty() ? u"Space" : name));
+  base::ListValue records =
+      profile_->GetPrefs()->GetList(kHeliumSpacesPref).Clone();
+  records.Append(std::move(record));
+  profile_->GetPrefs()->SetList(kHeliumSpacesPref, std::move(records));
+
+  spaces_.push_back(std::make_unique<HeliumSpace>(
+      profile_, std::move(id), name.empty() ? u"Space" : std::move(name)));
+  if (spaces_.size() == 1u) {
+    SetActiveSpace(spaces_.front()->id());
+  }
+  return spaces_.back().get();
+}
+
+void HeliumSpaceService::SetActiveSpace(std::string_view id) {
+  if (GetSpaceById(id)) {
+    profile_->GetPrefs()->SetString(kHeliumActiveSpaceIdPref, std::string(id));
+  }
+}
+
+void HeliumSpaceService::SetSpaceForBrowser(Browser* browser,
+                                            std::string_view id) {
+  if (!browser || browser->profile() != profile_ ||
+      browser->type() != Browser::TYPE_NORMAL || !GetSpaceById(id)) {
+    return;
+  }
+  const std::string space_id(id);
+  browser_space_ids_[browser] = space_id;
+  if (SessionService* sessions =
+          SessionServiceFactory::GetForProfile(profile_)) {
+    sessions->AddWindowExtraData(browser->session_id(),
+                                 kHeliumSpaceIdWindowExtraDataKey, space_id);
+  }
+}
+
+bool HeliumSpaceService::RestoreSpaceForBrowserFromSession(
+    Browser* browser,
+    const std::map<std::string, std::string>& extra_data) {
+  const auto found = extra_data.find(kHeliumSpaceIdWindowExtraDataKey);
+  if (found == extra_data.end() || !browser || browser->profile() != profile_ ||
+      browser->type() != Browser::TYPE_NORMAL || !GetSpaceById(found->second)) {
+    return false;
+  }
+  SetSpaceForBrowser(browser, found->second);
+  return true;
+}
+
+void HeliumSpaceService::AddSpaceToSessionExtraData(
+    Browser* browser,
+    std::map<std::string, std::string>* extra_data) const {
+  if (!extra_data) {
+    return;
+  }
+  const std::string_view space_id = GetSpaceIdForBrowser(browser);
+  if (space_id.empty()) {
+    extra_data->erase(kHeliumSpaceIdWindowExtraDataKey);
+    return;
+  }
+  extra_data->insert_or_assign(kHeliumSpaceIdWindowExtraDataKey,
+                               std::string(space_id));
+}
+
+std::string_view HeliumSpaceService::GetSpaceIdForBrowser(
+    Browser* browser) const {
+  auto found = browser_space_ids_.find(browser);
+  return found == browser_space_ids_.end() ? std::string_view()
+                                           : std::string_view(found->second);
+}
+
+std::vector<HeliumSpace*> HeliumSpaceService::GetSpaces() {
+  EnsureDefaultSpace();
+  std::vector<HeliumSpace*> result;
+  result.reserve(spaces_.size());
+  for (const auto& space : spaces_) {
+    result.push_back(space.get());
+  }
+  return result;
+}
+
+void HeliumSpaceService::OnBrowserCreated(BrowserWindowInterface* window) {
+  Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  if (!browser || browser->profile() != profile_ ||
+      browser->type() != Browser::TYPE_NORMAL ||
+      !GetSpaceIdForBrowser(browser).empty()) {
+    return;
+  }
+  if (HeliumSpace* active_space = GetActiveSpace()) {
+    SetSpaceForBrowser(browser, active_space->id());
+  }
+}
+
+void HeliumSpaceService::OnBrowserActivated(BrowserWindowInterface* window) {
+  OnBrowserCreated(window);
+  Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  if (!browser || browser->profile() != profile_ ||
+      browser->type() != Browser::TYPE_NORMAL) {
+    return;
+  }
+  const std::string_view space_id = GetSpaceIdForBrowser(browser);
+  if (!space_id.empty()) {
+    SetActiveSpace(space_id);
+  }
+}
+
+void HeliumSpaceService::OnBrowserClosed(BrowserWindowInterface* window) {
+  if (Browser* browser = window->GetBrowserForMigrationOnly()) {
+    browser_space_ids_.erase(browser);
