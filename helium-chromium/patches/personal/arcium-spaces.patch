+// Copyright 2026 The Arcium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/arcium/optional_navigation.h"
+
+#include "base/functional/bind.h"
+#include "content/public/common/referrer.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace arcium {
+namespace {
+
+class OptionalNavigationTest : public testing::Test {
+ protected:
+  void SetUp() override { SetOptionalNavigationHandler({}); }
+  void TearDown() override { SetOptionalNavigationHandler({}); }
+};
+
+content::OpenURLParams MakeParams(const GURL& url) {
+  return content::OpenURLParams(
+      url,
+      content::Referrer(GURL("https://source.test/page"),
+                        network::mojom::ReferrerPolicy::kStrictOrigin),
+      WindowOpenDisposition::CURRENT_TAB, ui::PAGE_TRANSITION_LINK,
+      /*is_renderer_initiated=*/true,
+      /*started_from_context_menu=*/true);
+}
+
+TEST_F(OptionalNavigationTest, FallsThroughWithoutHandler) {
+  EXPECT_FALSE(MaybeHandleOptionalNavigation(
+      /*profile=*/nullptr, MakeParams(GURL("https://example.test/"))));
+}
+
+TEST_F(OptionalNavigationTest, PreservesNavigationContext) {
+  bool called = false;
+  SetOptionalNavigationHandler(base::BindRepeating(
+      [](bool* called, Profile* profile, const content::OpenURLParams& params) {
+        *called = true;
+        EXPECT_EQ(nullptr, profile);
+        EXPECT_EQ(GURL("https://example.test/peek"), params.url);
+        EXPECT_EQ(GURL("https://source.test/page"), params.referrer.url);
+        EXPECT_EQ(
+            static_cast<int>(network::mojom::ReferrerPolicy::kStrictOrigin),
+            static_cast<int>(params.referrer.policy));
+        EXPECT_TRUE(params.initiator_origin.has_value());
+        if (params.initiator_origin) {
+          EXPECT_EQ(url::Origin::Create(GURL("https://source.test")),
+                    *params.initiator_origin);
+        }
+        EXPECT_TRUE(params.is_renderer_initiated);
+        EXPECT_TRUE(params.started_from_context_menu);
+        EXPECT_TRUE(params.user_gesture);
+        return true;
+      },
+      &called));
+
+  content::OpenURLParams params = MakeParams(GURL("https://example.test/peek"));
+  params.initiator_origin = url::Origin::Create(GURL("https://source.test"));
+  params.user_gesture = true;
+  EXPECT_TRUE(MaybeHandleOptionalNavigation(/*profile=*/nullptr, params));
+  EXPECT_TRUE(called);
+}
+
+TEST_F(OptionalNavigationTest, PreservesFallthroughFromInstalledHandler) {
+  SetOptionalNavigationHandler(base::BindRepeating(
+      [](Profile*, const content::OpenURLParams&) { return false; }));
+
+  EXPECT_FALSE(MaybeHandleOptionalNavigation(
+      /*profile=*/nullptr, MakeParams(GURL("https://example.test/"))));
+}
+
+}  // namespace
+}  // namespace arcium
