+
+namespace arcium {
+namespace {
+
+OptionalNavigationHandler& GetHandler() {
+  static base::NoDestructor<OptionalNavigationHandler> handler;
+  return *handler;
+}
+
+}  // namespace
+
+void SetOptionalNavigationHandler(OptionalNavigationHandler handler) {
+  GetHandler() = std::move(handler);
+}
+
+bool MaybeHandleOptionalNavigation(Profile* profile,
+                                   const content::OpenURLParams& params) {
+  OptionalNavigationHandler& handler = GetHandler();
+  return handler && handler.Run(profile, params);
+}
+
+}  // namespace arcium
