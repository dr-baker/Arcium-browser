+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/arcium/tab_provenance.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "content/public/browser/web_contents.h"
+
+namespace arcium {
+
+namespace {
+
+constexpr char kSourceKey[] = "arcium.provenance.source";
+constexpr char kCollectionIdKey[] = "arcium.provenance.collection_id";
+constexpr char kItemIdKey[] = "arcium.provenance.item_id";
+
+}  // namespace
+
+TabProvenance::TabProvenance(content::WebContents* web_contents,
+                             std::string source,
+                             std::string collection_id,
+                             std::string item_id)
+    : content::WebContentsUserData<TabProvenance>(*web_contents),
+      source_(std::move(source)),
+      collection_id_(std::move(collection_id)),
+      item_id_(std::move(item_id)) {
+  CHECK(!source_.empty());
+  CHECK(!collection_id_.empty());
+  CHECK(!item_id_.empty());
+}
+
+TabProvenance::~TabProvenance() = default;
+
+// static
+void TabProvenance::Set(content::WebContents* web_contents,
+                        std::string source,
+                        std::string collection_id,
+                        std::string item_id) {
+  CHECK(web_contents);
+  CreateForWebContents(web_contents, std::move(source),
+                       std::move(collection_id), std::move(item_id));
+  FromWebContents(web_contents)->Persist();
+}
+
+// static
+void TabProvenance::RestoreFromExtraData(
+    content::WebContents* web_contents,
+    const std::map<std::string, std::string>& extra_data) {
+  const auto source = extra_data.find(kSourceKey);
+  const auto collection_id = extra_data.find(kCollectionIdKey);
+  const auto item_id = extra_data.find(kItemIdKey);
+  if (source == extra_data.end() || collection_id == extra_data.end() ||
+      item_id == extra_data.end() || source->second.empty() ||
+      collection_id->second.empty() || item_id->second.empty()) {
+    return;
+  }
+  CreateForWebContents(web_contents, source->second, collection_id->second,
+                       item_id->second);
+}
+
+// static
+void TabProvenance::PopulateExtraData(
+    content::WebContents* web_contents,
+    std::map<std::string, std::string>* extra_data) {
+  CHECK(web_contents);
+  CHECK(extra_data);
+  const auto* provenance = FromWebContents(web_contents);
+  if (!provenance) {
+    return;
+  }
+  extra_data->insert_or_assign(kSourceKey, provenance->source());
+  extra_data->insert_or_assign(kCollectionIdKey, provenance->collection_id());
+  extra_data->insert_or_assign(kItemIdKey, provenance->item_id());
+}
+
+void TabProvenance::Persist() {
+  Profile* profile =
+      Profile::FromBrowserContext(GetWebContents().GetBrowserContext());
+  SessionService* session_service =
+      SessionServiceFactory::GetForProfile(profile);
+  if (!session_service) {
+    return;
+  }
+
+  const SessionID window_id =
+      sessions::SessionTabHelper::IdForWindowContainingTab(&GetWebContents());
+  const SessionID tab_id =
+      sessions::SessionTabHelper::IdForTab(&GetWebContents());
+  if (!window_id.is_valid() || !tab_id.is_valid()) {
+    return;
+  }
+
+  session_service->AddTabExtraData(window_id, tab_id, kSourceKey, source_);
+  session_service->AddTabExtraData(window_id, tab_id, kCollectionIdKey,
+                                   collection_id_);
+  session_service->AddTabExtraData(window_id, tab_id, kItemIdKey, item_id_);
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TabProvenance);
+
+}  // namespace arcium
