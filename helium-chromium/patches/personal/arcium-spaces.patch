+
+#ifndef CHROME_BROWSER_UI_ARCIUM_TAB_PROVENANCE_H_
+#define CHROME_BROWSER_UI_ARCIUM_TAB_PROVENANCE_H_
+
+#include <map>
+#include <string>
+
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace content {
+class WebContents;
+}
+
+namespace arcium {
+
+// Identifies a tab owned by an external data source. Feature patches use this
+// identity to reconcile their own tabs without disturbing user-created tabs.
+class TabProvenance : public content::WebContentsUserData<TabProvenance> {
+ public:
+  TabProvenance(const TabProvenance&) = delete;
+  TabProvenance& operator=(const TabProvenance&) = delete;
+  ~TabProvenance() override;
+
+  static void Set(content::WebContents* web_contents,
+                  std::string source,
+                  std::string collection_id,
+                  std::string item_id);
+  static void RestoreFromExtraData(
+      content::WebContents* web_contents,
+      const std::map<std::string, std::string>& extra_data);
+  static void PopulateExtraData(content::WebContents* web_contents,
+                                std::map<std::string, std::string>* extra_data);
+
+  const std::string& source() const { return source_; }
+  const std::string& collection_id() const { return collection_id_; }
+  const std::string& item_id() const { return item_id_; }
+
+ private:
+  friend class content::WebContentsUserData<TabProvenance>;
+  TabProvenance(content::WebContents* web_contents,
+                std::string source,
+                std::string collection_id,
+                std::string item_id);
+
+  void Persist();
+
+  const std::string source_;
+  const std::string collection_id_;
+  const std::string item_id_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace arcium
+
+#endif  // CHROME_BROWSER_UI_ARCIUM_TAB_PROVENANCE_H_
