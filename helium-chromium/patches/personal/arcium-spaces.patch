+
+namespace arcium {
+
+// Optional features can install a handler for navigation that a caller has
+// already decided may leave the normal browser path. An empty handler always
+// falls through to normal Chromium navigation.
+using OptionalNavigationHandler =
+    base::RepeatingCallback<bool(Profile*, const content::OpenURLParams&)>;
+
+void SetOptionalNavigationHandler(OptionalNavigationHandler handler);
+bool MaybeHandleOptionalNavigation(Profile* profile,
+                                   const content::OpenURLParams& params);
+
+}  // namespace arcium
