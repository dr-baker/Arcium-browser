+
+class Profile;
+class Browser;
+class BrowserWindowInterface;
+class ProfileBrowserCollection;
+
+namespace helium {
+
+inline constexpr char kHeliumSpacesPref[] = "helium.spaces";
+inline constexpr char kHeliumActiveSpaceIdPref[] = "helium.active_space_id";
+inline constexpr char kHeliumSpaceIdWindowExtraDataKey[] = "helium_space_id";
+
+class HeliumSpace;
+
+// Profile-scoped owner of ordered Helium Spaces. Profile identity stays an
+// implementation detail; Spaces are the user-facing browsing contexts.
+class HeliumSpaceService : public KeyedService,
+                           public BrowserCollectionObserver {
+ public:
+  explicit HeliumSpaceService(Profile* profile);
+  HeliumSpaceService(const HeliumSpaceService&) = delete;
+  HeliumSpaceService& operator=(const HeliumSpaceService&) = delete;
+  ~HeliumSpaceService() override;
+
+  // Always non-null after construction.
+  HeliumSpace* GetDefaultSpace();
+  const HeliumSpace* GetDefaultSpace() const;
+  HeliumSpace* GetActiveSpace();
+  HeliumSpace* GetSpaceById(std::string_view id);
+  HeliumSpace* GetOrCreateSpace(std::string id, std::u16string name);
+  void SetActiveSpace(std::string_view id);
+  void SetSpaceForBrowser(Browser* browser, std::string_view id);
+  bool RestoreSpaceForBrowserFromSession(
+      Browser* browser,
+      const std::map<std::string, std::string>& extra_data);
+  void AddSpaceToSessionExtraData(
+      Browser* browser,
+      std::map<std::string, std::string>* extra_data) const;
+  std::string_view GetSpaceIdForBrowser(Browser* browser) const;
+
+  std::vector<HeliumSpace*> GetSpaces();
+
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser) override;
+  void OnBrowserActivated(BrowserWindowInterface* browser) override;
+  void OnBrowserClosed(BrowserWindowInterface* browser) override;
+
+ private:
+  void LoadSpaces();
+  void EnsureDefaultSpace();
+
+  raw_ptr<Profile> profile_;
+  std::vector<std::unique_ptr<HeliumSpace>> spaces_;
+  std::map<Browser*, std::string> browser_space_ids_;
+  base::ScopedObservation<ProfileBrowserCollection, BrowserCollectionObserver>
+      browser_collection_observation_{this};
+};
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_SPACE_SERVICE_H_
