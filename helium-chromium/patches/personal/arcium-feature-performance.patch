+TEST(MRUTabPresentationMetricsTest, CoalescesWithoutMovingOriginalStart) {
+  base::HistogramTester histograms;
+  MRUTabPresentationMetrics metrics;
+  const auto start = base::TimeTicks::Now();
+  EXPECT_TRUE(metrics.Request(start, true, true));
+  EXPECT_FALSE(metrics.Request(start + base::Milliseconds(5), false, true));
+  metrics.Presented(start + base::Milliseconds(20));
+  histograms.ExpectTimeBucketCount("Arcium.MRU.Presentation.Open.Glass",
+                                   base::Milliseconds(20), 1);
+  histograms.ExpectBucketCount("Arcium.MRU.Presentation.Outcome.Glass", 0, 1);
+  histograms.ExpectBucketCount("Arcium.MRU.Presentation.Outcome.Glass", 1, 1);
+  histograms.ExpectTotalCount("Arcium.MRU.Presentation.Cycle.Glass", 0);
+  EXPECT_FALSE(base::StatisticsRecorder::FindHistogram(
+                   "Arcium.MRU.Presentation.Open.Glass")
+                   ->HasFlags(base::HistogramBase::kUmaTargetedHistogramFlag));
+}
+
+TEST(MRUTabPresentationMetricsTest, SeparatesModesAndRejectsInvalidFeedback) {
+  base::HistogramTester histograms;
+  MRUTabPresentationMetrics metrics;
+  const auto start = base::TimeTicks::Now();
+  EXPECT_TRUE(metrics.Request(start, true, false));
+  metrics.Presented(start + base::Milliseconds(10));
+  EXPECT_TRUE(metrics.Request(start, false, true));
+  metrics.Presented(start + base::Milliseconds(15));
+  EXPECT_TRUE(metrics.Request(start, false, false));
+  metrics.Presented(start + base::Milliseconds(25));
+  EXPECT_TRUE(metrics.Request(start, false, false));
+  metrics.Presented(start - base::Milliseconds(1));
+  histograms.ExpectTotalCount("Arcium.MRU.Presentation.Open.Opaque", 1);
+  histograms.ExpectTotalCount("Arcium.MRU.Presentation.Cycle.Glass", 1);
+  histograms.ExpectTotalCount("Arcium.MRU.Presentation.Cycle.Opaque", 1);
+  histograms.ExpectBucketCount("Arcium.MRU.Presentation.Outcome.Opaque", 3, 1);
+}
+
+TEST(MRUTabPresentationMetricsTest, CountsClosedRequestsWithoutLatency) {
+  base::HistogramTester histograms;
+  {
+    MRUTabPresentationMetrics metrics;
+    EXPECT_TRUE(metrics.Request(base::TimeTicks::Now(), true, true));
+  }
+  histograms.ExpectUniqueSample("Arcium.MRU.Presentation.Outcome.Glass", 2, 1);
+  histograms.ExpectTotalCount("Arcium.MRU.Presentation.Open.Glass", 0);
+}
