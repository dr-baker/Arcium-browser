+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_MRU_TAB_PERFORMANCE_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_MRU_TAB_PERFORMANCE_H_
+
+#include "base/time/time.h"
+
+// Local diagnostic metrics, never UMA uploads. One pending presentation per
+// overlay bounds callback overhead even when Ctrl+Tab repeats faster than
+// frames. Latency starts at the first unmeasured Update, not at the native key
+// event.
+class MRUTabPresentationMetrics {
+ public:
+  enum class Outcome {
+    kPresented = 0,
+    kCoalesced = 1,
+    kClosedBeforeFeedback = 2,
+    kInvalidTimestamp = 3,
+    kMaxValue = kInvalidTimestamp,
+  };
+
+  MRUTabPresentationMetrics() = default;
+  MRUTabPresentationMetrics(const MRUTabPresentationMetrics&) = delete;
+  MRUTabPresentationMetrics& operator=(const MRUTabPresentationMetrics&) =
+      delete;
+  ~MRUTabPresentationMetrics();
+
+  bool Request(base::TimeTicks started, bool opening, bool glass);
+  void Presented(base::TimeTicks timestamp);
+
+ private:
+  void RecordOutcome(Outcome outcome);
+
+  base::TimeTicks started_;
+  bool opening_ = false;
+  bool glass_ = false;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_MRU_TAB_PERFORMANCE_H_
