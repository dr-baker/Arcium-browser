@@ -0,0 +1,68 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/mru_tab_performance.h"
+
+#include "base/metrics/histogram_macros_local.h"
+#include "base/trace_event/trace_event.h"
+
+MRUTabPresentationMetrics::~MRUTabPresentationMetrics() {
+  if (!started_.is_null()) {
+    RecordOutcome(Outcome::kClosedBeforeFeedback);
+  }
+}
+
+bool MRUTabPresentationMetrics::Request(base::TimeTicks started,
+                                        bool opening,
+                                        bool glass) {
+  if (!started_.is_null()) {
+    RecordOutcome(Outcome::kCoalesced);
+    return false;
+  }
+  started_ = started;
+  opening_ = opening;
+  glass_ = glass;
+  return true;
+}
+
+void MRUTabPresentationMetrics::Presented(base::TimeTicks timestamp) {
+  if (started_.is_null()) {
+    return;
+  }
+  const auto started = started_;
+  started_ = {};
+  if (timestamp.is_null() || timestamp < started) {
+    RecordOutcome(Outcome::kInvalidTimestamp);
+    return;
+  }
+  const auto latency = timestamp - started;
+  RecordOutcome(Outcome::kPresented);
+  // Separate call sites keep static histogram pointers bound to fixed names.
+  if (opening_) {
+    if (glass_) {
+      LOCAL_HISTOGRAM_TIMES("Arcium.MRU.Presentation.Open.Glass", latency);
+    } else {
+      LOCAL_HISTOGRAM_TIMES("Arcium.MRU.Presentation.Open.Opaque", latency);
+    }
+  } else if (glass_) {
+    LOCAL_HISTOGRAM_TIMES("Arcium.MRU.Presentation.Cycle.Glass", latency);
+  } else {
+    LOCAL_HISTOGRAM_TIMES("Arcium.MRU.Presentation.Cycle.Opaque", latency);
+  }
+  TRACE_EVENT_INSTANT("ui", "Arcium.MRU.Presented", "latency_us",
+                      latency.InMicroseconds(), "opening", opening_, "glass",
+                      glass_);
+}
+
+void MRUTabPresentationMetrics::RecordOutcome(Outcome outcome) {
+  TRACE_EVENT_INSTANT("ui", "Arcium.MRU.PresentationOutcome", "outcome",
+                      static_cast<int>(outcome), "glass", glass_);
+  if (glass_) {
+    LOCAL_HISTOGRAM_ENUMERATION("Arcium.MRU.Presentation.Outcome.Glass",
+                                outcome);
+  } else {
+    LOCAL_HISTOGRAM_ENUMERATION("Arcium.MRU.Presentation.Outcome.Opaque",
+                                outcome);
+  }
+}
