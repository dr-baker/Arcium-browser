+#include "base/json/json_reader.h"
+#include "base/strings/strcat.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/arcium/tab_provenance.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_tabrestore.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/helium/helium_space.h"
+#include "chrome/browser/ui/helium/helium_space_service.h"
+#include "chrome/browser/ui/helium/helium_space_service_factory.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/sessions/core/serialized_navigation_entry.h"
+#include "components/sessions/core/session_types.h"
+#include "components/tab_groups/tab_group_color.h"
+#include "components/tab_groups/tab_group_visual_data.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace arcium {
+
+namespace {
+
+constexpr char kArcSource[] = "arc";
+
+struct ImportedTab {
+  std::string source_id;
+  std::string title;
+  GURL url;
+  std::string group_title;
+  bool group_collapsed = false;
+};
+
+struct ImportedSpace {
+  std::string id;
+  std::string name;
+  std::vector<ImportedTab> tabs;
+};
+
+struct Snapshot {
+  std::string source_profile;
+  std::vector<ImportedTab> favorites;
+  std::vector<ImportedSpace> spaces;
+};
+
+bool AppendNodes(const base::ListValue& nodes,
+                 const std::string& parent_path,
+                 std::vector<ImportedTab>* tabs) {
+  for (const base::Value& value : nodes) {
+    const base::DictValue* node = value.GetIfDict();
+    const std::string* type = node ? node->FindString("type") : nullptr;
+    const std::string* source_id =
+        node ? node->FindString("source_id") : nullptr;
+    const std::string* title = node ? node->FindString("title") : nullptr;
+    if (!type || !source_id || source_id->empty() || !title) {
+      return false;
+    }
+    if (*type == "tab") {
+      const std::string* url_value = node->FindString("url");
+      const GURL url(url_value ? *url_value : std::string());
+      if (!url.is_valid() || url.SchemeIs("arc")) {
+        return false;
+      }
+      tabs->push_back({
+          .source_id = *source_id,
+          .title = *title,
+          .url = url,
+          .group_title = parent_path,
+      });
+      continue;
+    }
+    if (*type != "folder") {
+      return false;
+    }
+    const base::ListValue* children = node->FindList("children");
+    const std::optional<bool> collapsed = node->FindBool("collapsed");
+    if (!children || !collapsed) {
+      return false;
+    }
+    const std::string folder_title = title->empty() ? "Folder" : *title;
+    const std::string path =
+        parent_path.empty() ? folder_title
+                            : base::StrCat({parent_path, " / ", folder_title});
+    const size_t first_child = tabs->size();
+    if (!AppendNodes(*children, path, tabs)) {
+      return false;
+    }
+    for (size_t i = first_child; i < tabs->size(); ++i) {
+      if ((*tabs)[i].group_title == path) {
+        (*tabs)[i].group_collapsed = *collapsed;
+      }
+    }
+  }
+  return true;
+}
+
+std::optional<Snapshot> ParseSnapshot(std::string_view snapshot_json) {
+  std::optional<base::Value> value =
+      base::JSONReader::Read(snapshot_json, base::JSON_PARSE_RFC);
+  const base::DictValue* root = value ? value->GetIfDict() : nullptr;
+  const std::optional<int> version =
+      root ? root->FindInt("version") : std::nullopt;
+  const std::string* source_profile =
+      root ? root->FindString("source_profile") : nullptr;
+  const base::ListValue* favorites =
+      root ? root->FindList("favorites") : nullptr;
+  const base::ListValue* spaces = root ? root->FindList("spaces") : nullptr;
+  if (version != 1 || !source_profile || source_profile->empty() ||
+      !favorites || !spaces) {
+    return std::nullopt;
+  }
+
+  Snapshot snapshot{.source_profile = *source_profile};
+  if (!AppendNodes(*favorites, "Favorites", &snapshot.favorites)) {
+    return std::nullopt;
+  }
+  for (const base::Value& value : *spaces) {
+    const base::DictValue* space = value.GetIfDict();
+    const std::string* id = space ? space->FindString("id") : nullptr;
+    const std::string* name = space ? space->FindString("name") : nullptr;
+    const std::string* profile =
+        space ? space->FindString("source_profile") : nullptr;
+    const base::ListValue* pins = space ? space->FindList("pins") : nullptr;
+    if (!id || id->empty() || !name || !profile ||
+        *profile != snapshot.source_profile || !pins) {
+      return std::nullopt;
+    }
+    ImportedSpace imported_space{.id = *id, .name = *name};
+    if (!AppendNodes(*pins, std::string(), &imported_space.tabs)) {
+      return std::nullopt;
+    }
+    snapshot.spaces.push_back(std::move(imported_space));
+  }
+  return snapshot;
+}
+
+Browser* GetOrCreateBrowser(helium::HeliumSpace* space,
+                            helium::HeliumSpaceService* service) {
+  if (BrowserWindowInterface* window = space->GetPrimaryBrowser()) {
+    return window->GetBrowserForMigrationOnly();
+  }
+  if (Browser::GetCreationStatusForProfile(space->profile()) !=
+          Browser::CreationStatus::kOk ||
+      space->profile()->ShutdownStarted()) {
+    return nullptr;
+  }
+  Browser::CreateParams params(Browser::TYPE_NORMAL, space->profile(), false);
+  params.should_trigger_session_restore = false;
+  Browser* browser = Browser::Create(params);
+  service->SetSpaceForBrowser(browser, space->id());
+  return browser;
+}
+
+void AddTabs(Browser* browser,
+             const std::string& source_profile,
+             const std::vector<ImportedTab>& tabs) {
+  std::map<std::string, std::vector<int>> group_indices;
+  std::map<std::string, bool> group_collapsed;
+  for (const ImportedTab& tab : tabs) {
+    sessions::SerializedNavigationEntry navigation;
+    navigation.set_index(0);
+    navigation.set_virtual_url(tab.url);
+    navigation.set_title(base::UTF8ToUTF16(tab.title));
+    content::WebContents* contents = chrome::AddRestoredTab(
+        browser, base::span_from_ref(navigation),
+        browser->tab_strip_model()->count(), 0, std::string(), std::nullopt,
+        false, false, base::TimeTicks(), base::Time(), nullptr,
+        sessions::SerializedUserAgentOverride(), {}, true, false);
+    TabProvenance::Set(contents, kArcSource, source_profile, tab.source_id);
+    if (!tab.group_title.empty()) {
+      group_indices[tab.group_title].push_back(
+          browser->tab_strip_model()->GetIndexOfWebContents(contents));
+      group_collapsed[tab.group_title] = tab.group_collapsed;
+    }
+  }
+  for (const auto& [title, indices] : group_indices) {
+    const tab_groups::TabGroupId group =
+        browser->tab_strip_model()->AddToNewGroup(indices);
+    browser->tab_strip_model()->ChangeTabGroupVisuals(
+        group, tab_groups::TabGroupVisualData(
+                   base::UTF8ToUTF16(title), tab_groups::TabGroupColorId::kGrey,
+                   group_collapsed[title]));
+  }
+}
+
+std::vector<content::WebContents*> ImportedContents(
+    Browser* browser,
+    const std::string& source_profile) {
+  std::vector<content::WebContents*> result;
+  for (int index = 0; index < browser->tab_strip_model()->count(); ++index) {
+    content::WebContents* contents =
+        browser->tab_strip_model()->GetWebContentsAt(index);
+    const TabProvenance* provenance = TabProvenance::FromWebContents(contents);
+    if (provenance && provenance->source() == kArcSource &&
+        provenance->collection_id() == source_profile) {
+      result.push_back(contents);
+    }
+  }
+  return result;
+}
+
+}  // namespace
+
+bool ImportArcSidebarSnapshot(Profile* profile,
+                              std::string_view snapshot_json) {
+  std::optional<Snapshot> snapshot = ParseSnapshot(snapshot_json);
+  helium::HeliumSpaceService* service =
+      profile ? helium::HeliumSpaceServiceFactory::GetForProfile(profile)
+              : nullptr;
+  if (!snapshot || !service) {
+    return false;
+  }
+
+  std::map<std::string, std::vector<ImportedTab>> tabs_by_space;
+  for (const ImportedSpace& imported : snapshot->spaces) {
+    tabs_by_space[imported.id] = imported.tabs;
+    service->GetOrCreateSpace(imported.id, base::UTF8ToUTF16(imported.name));
+  }
+  const std::string favorites_space_id = snapshot->spaces.empty()
+                                             ? service->GetDefaultSpace()->id()
+                                             : snapshot->spaces.front().id;
+  auto& favorites_destination = tabs_by_space[favorites_space_id];
+  favorites_destination.insert(favorites_destination.begin(),
+                               snapshot->favorites.begin(),
+                               snapshot->favorites.end());
+
+  for (helium::HeliumSpace* space : service->GetSpaces()) {
+    BrowserWindowInterface* existing_window = space->GetPrimaryBrowser();
+    Browser* browser = existing_window
+                           ? existing_window->GetBrowserForMigrationOnly()
+                           : nullptr;
+    std::vector<content::WebContents*> old_tabs =
+        browser ? ImportedContents(browser, snapshot->source_profile)
+                : std::vector<content::WebContents*>();
+    const auto replacement = tabs_by_space.find(space->id());
+    if (replacement != tabs_by_space.end() && !replacement->second.empty()) {
+      browser = browser ? browser : GetOrCreateBrowser(space, service);
+      if (!browser) {
+        return false;
+      }
+      AddTabs(browser, snapshot->source_profile, replacement->second);
+    }
+    if (browser && !old_tabs.empty()) {
+      browser->tab_strip_model()->CloseWebContentses(old_tabs, CLOSE_NONE,
+                                                     nullptr);
+    }
+  }
+  return true;
+}
+
+}  // namespace arcium
