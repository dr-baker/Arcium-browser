+
+#ifndef CHROME_UTILITY_IMPORTER_ARC_SIDEBAR_SNAPSHOT_H_
+#define CHROME_UTILITY_IMPORTER_ARC_SIDEBAR_SNAPSHOT_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/values.h"
+
+namespace arcium {
+
+// A navigable tab or a first-class folder in an Arc sidebar tree. Arc's
+// container and split-view nodes are represented by the ordering of their
+// children rather than by synthetic Helium folders.
+struct ArcSidebarNode {
+  enum class Type {
+    kTab,
+    kFolder,
+  };
+
+  Type type = Type::kTab;
+  std::string source_id;
+  std::string title;
+  std::string url;
+  bool collapsed = false;
+  std::vector<ArcSidebarNode> children;
+
+  base::DictValue ToDict() const;
+};
+
+struct ArcSidebarSpace {
+  std::string id;
+  std::string name;
+  std::string source_profile;
+  std::vector<ArcSidebarNode> pins;
+
+  base::DictValue ToDict() const;
+};
+
+// A versioned, profile-scoped snapshot suitable for JSON serialization across
+// the importer Mojo boundary. Favorites are always flat tab nodes; Space pins
+// retain their recursive folder structure, including empty folders.
+struct ArcSidebarSnapshot {
+  static constexpr int kCurrentVersion = 1;
+
+  int version = kCurrentVersion;
+  std::string source_profile;
+  std::vector<ArcSidebarNode> favorites;
+  std::vector<ArcSidebarSpace> spaces;
+
+  base::DictValue ToDict() const;
+};
+
+// Parses one Arc profile from a decoded StorableSidebar.json root. Returns a
+// snapshot even when that profile currently has no favorites or Spaces.
+// Returns nullopt when the root schema is missing or the requested profile is
+// empty.
+std::optional<ArcSidebarSnapshot> ParseArcSidebarSnapshot(
+    const base::DictValue& root,
+    std::string_view source_profile_directory);
+
+}  // namespace arcium
