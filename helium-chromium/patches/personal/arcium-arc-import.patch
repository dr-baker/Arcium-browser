+TEST(ArcSidebarSnapshotTest, PreservesProfileScopedOrderedTreesAndIds) {
+  std::optional<base::DictValue> root = ParseFixture();
+  ASSERT_TRUE(root);
+  std::optional<ArcSidebarSnapshot> snapshot =
+      ParseArcSidebarSnapshot(*root, kProfile);
+  ASSERT_TRUE(snapshot);
+
+  EXPECT_EQ(ArcSidebarSnapshot::kCurrentVersion, snapshot->version);
+  EXPECT_EQ(kProfile, snapshot->source_profile);
+
+  // Top Apps are profile-wide tabs. Structural wrappers are transparent and
+  // Arc-internal URLs are ignored.
+  ASSERT_EQ(2u, snapshot->favorites.size());
+  EXPECT_EQ(ArcSidebarNode::Type::kTab, snapshot->favorites[0].type);
+  EXPECT_EQ("favorite-one", snapshot->favorites[0].source_id);
+  EXPECT_EQ("Favorite", snapshot->favorites[0].title);
+  EXPECT_EQ("https://favorite.example/path", snapshot->favorites[0].url);
+  EXPECT_EQ("favorite-two", snapshot->favorites[1].source_id);
+  EXPECT_EQ("Second favorite", snapshot->favorites[1].title);
+
+  ASSERT_EQ(2u, snapshot->spaces.size());
+  const ArcSidebarSpace& work = snapshot->spaces[0];
+  EXPECT_EQ("space-one", work.id);
+  EXPECT_EQ("Work", work.name);
+  EXPECT_EQ(kProfile, work.source_profile);
+  ASSERT_EQ(4u, work.pins.size());
+
+  const ArcSidebarNode& outer = work.pins[0];
+  ASSERT_EQ(ArcSidebarNode::Type::kFolder, outer.type);
+  EXPECT_EQ("outer-folder", outer.source_id);
+  EXPECT_EQ("Outer", outer.title);
+  EXPECT_TRUE(outer.collapsed);
+  ASSERT_EQ(2u, outer.children.size());
+
+  const ArcSidebarNode& empty = outer.children[0];
+  EXPECT_EQ(ArcSidebarNode::Type::kFolder, empty.type);
+  EXPECT_EQ("empty-folder", empty.source_id);
+  EXPECT_TRUE(empty.collapsed);
+  EXPECT_TRUE(empty.children.empty());
+
+  const ArcSidebarNode& inner = outer.children[1];
+  ASSERT_EQ(ArcSidebarNode::Type::kFolder, inner.type);
+  EXPECT_EQ("inner-folder", inner.source_id);
+  EXPECT_EQ("Inner", inner.title);
+  ASSERT_EQ(1u, inner.children.size());
+  EXPECT_EQ("same-title-b", inner.children[0].source_id);
+  EXPECT_EQ("Duplicate", inner.children[0].title);
+
+  // A split is flattened because the target model has no split layout node.
+  // Its children stay at the split's original position and real folders below
+  // the split remain first-class nodes.
+  EXPECT_EQ("split-tab", work.pins[1].source_id);
+  ASSERT_EQ(ArcSidebarNode::Type::kFolder, work.pins[2].type);
+  EXPECT_EQ("split-folder", work.pins[2].source_id);
+  ASSERT_EQ(1u, work.pins[2].children.size());
+  EXPECT_EQ("split-folder-tab", work.pins[2].children[0].source_id);
+
+  // Duplicate titles do not collapse stable Arc identities.
+  EXPECT_EQ("same-title-a", work.pins[3].source_id);
+  EXPECT_EQ("Duplicate", work.pins[3].title);
+  EXPECT_NE(inner.children[0].source_id, work.pins[3].source_id);
+
+  const ArcSidebarSpace& personal = snapshot->spaces[1];
+  EXPECT_EQ("space-two", personal.id);
+  EXPECT_EQ("Personal", personal.name);
+  ASSERT_EQ(1u, personal.pins.size());
+  EXPECT_EQ("second-space-tab", personal.pins[0].source_id);
+}
+
+TEST(ArcSidebarSnapshotTest, EmitsExactVersionedTransportSchema) {
+  std::optional<base::DictValue> root = ParseFixture();
+  ASSERT_TRUE(root);
+  std::optional<ArcSidebarSnapshot> snapshot =
+      ParseArcSidebarSnapshot(*root, kProfile);
+  ASSERT_TRUE(snapshot);
+
+  base::DictValue encoded = snapshot->ToDict();
+  EXPECT_EQ(4u, encoded.size());
+  EXPECT_EQ(1, encoded.FindInt("version"));
+  EXPECT_EQ(kProfile, *encoded.FindString("source_profile"));
+
+  const base::ListValue* favorites = encoded.FindList("favorites");
+  ASSERT_NE(nullptr, favorites);
+  ASSERT_EQ(2u, favorites->size());
+  const base::DictValue& favorite = favorites->front().GetDict();
+  EXPECT_EQ(4u, favorite.size());
+  EXPECT_EQ("tab", *favorite.FindString("type"));
+  EXPECT_EQ("favorite-one", *favorite.FindString("source_id"));
+  EXPECT_EQ("Favorite", *favorite.FindString("title"));
+  EXPECT_EQ("https://favorite.example/path", *favorite.FindString("url"));
+
+  const base::ListValue* spaces = encoded.FindList("spaces");
+  ASSERT_NE(nullptr, spaces);
+  ASSERT_EQ(2u, spaces->size());
+  const base::DictValue& work = spaces->front().GetDict();
+  EXPECT_EQ(4u, work.size());
+  EXPECT_EQ("space-one", *work.FindString("id"));
+  EXPECT_EQ("Work", *work.FindString("name"));
+  EXPECT_EQ(kProfile, *work.FindString("source_profile"));
+
+  const base::ListValue* pins = work.FindList("pins");
+  ASSERT_NE(nullptr, pins);
+  const base::DictValue& folder = pins->front().GetDict();
+  EXPECT_EQ(5u, folder.size());
+  EXPECT_EQ("folder", *folder.FindString("type"));
+  EXPECT_EQ("outer-folder", *folder.FindString("source_id"));
+  EXPECT_EQ("Outer", *folder.FindString("title"));
+  EXPECT_TRUE(folder.FindBool("collapsed").value_or(false));
+  ASSERT_NE(nullptr, folder.FindList("children"));
+  EXPECT_FALSE(folder.contains("url"));
+}
+
+TEST(ArcSidebarSnapshotTest, SupportsDefaultProfileAndRejectsBadRoots) {
+  std::optional<base::DictValue> root = ParseFixture();
+  ASSERT_TRUE(root);
+
+  std::optional<ArcSidebarSnapshot> default_snapshot =
+      ParseArcSidebarSnapshot(*root, "Default");
+  ASSERT_TRUE(default_snapshot);
+  ASSERT_EQ(1u, default_snapshot->favorites.size());
+  EXPECT_EQ("other-favorite", default_snapshot->favorites[0].source_id);
+  ASSERT_EQ(1u, default_snapshot->spaces.size());
+  EXPECT_EQ("other-space", default_snapshot->spaces[0].id);
+
+  EXPECT_FALSE(ParseArcSidebarSnapshot(*root, ""));
+  EXPECT_FALSE(ParseArcSidebarSnapshot(base::DictValue(), kProfile));
+}
