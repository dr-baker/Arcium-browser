+  bool PerformRequest(Request request) {
+    if (request.generation != request_generation_) {
+      return false;
+    }
+    switch (request.kind) {
+      case RequestKind::kStart:
+        StartRequested(request.generation, request.motion,
+                       std::move(*request.motion_info));
+        return true;
+      case RequestKind::kReset:
+        ResetRequested(request.generation, request.motion,
+                       std::move(*request.motion_info));
+        return true;
+      case RequestKind::kCancel:
+        return OnCancel(GetParamsLookup());
+      case RequestKind::kClear:
+        return OnClear();
+    }
