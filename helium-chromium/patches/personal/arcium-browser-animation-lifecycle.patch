+      // Clear also resets transition values; retain that effect even if a later
+      // request replaces the queued motion operation.
+      pending_clear_ |= request.kind == RequestKind::kClear;
+      pending_request_ = std::move(request);
+      return static_cast<bool>(current_motion_);
+    }
+    return PerformRequest(std::move(request));
+  }
