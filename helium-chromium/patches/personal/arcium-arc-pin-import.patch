+void FlattenNodes(const std::vector<ImportedNode>& nodes,
+                  const std::string& parent_path,
+                  bool parent_collapsed,
+                  std::vector<ImportedTab>* tabs) {
+  for (const ImportedNode& node : nodes) {
+    if (node.type == ImportedNode::Type::kTab) {
+      tabs->push_back({
+          .source_id = node.source_id,
+          .title = node.title,
+          .url = node.url,
+          .group_title = parent_path,
+          .group_collapsed = parent_collapsed,
+      });
+      continue;
+    }
+    const std::string path =
+        parent_path.empty()
+            ? node.title
+            : base::StrCat({parent_path, " / ", node.title});
+    FlattenNodes(node.children, path, node.collapsed, tabs);
+  }
+}
+
+helium::PersistentNodes ToPersistentNodes(
+    const std::vector<ImportedNode>& nodes,
+    std::string_view source_profile,
+    std::string_view scope) {
+  helium::PersistentNodes result;
+  result.reserve(nodes.size());
+  for (const ImportedNode& node : nodes) {
+    const std::string id = base::StrCat(
+        {"arc:", source_profile, ":", scope, ":", node.source_id});
+    if (node.type == ImportedNode::Type::kTab) {
+      result.push_back(helium::PersistentNode{
+          .data = helium::PersistentLink{
+              .id = id,
+              .title = base::UTF8ToUTF16(node.title),
+              .url = node.url,
+          }});
+      continue;
+    }
+    result.push_back(helium::PersistentNode{
+        .data = helium::PersistentFolder{
+            .id = id,
+            .title = base::UTF8ToUTF16(node.title),
+            .collapsed = node.collapsed,
+            .children =
+                ToPersistentNodes(node.children, source_profile, scope),
+        }});
+  }
+  return result;
+}
