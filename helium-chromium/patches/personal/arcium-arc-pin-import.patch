+helium::PersistentNode Link(std::string id,
+                            std::u16string title,
+                            const char* url) {
+  return helium::PersistentNode{
+      .data = helium::PersistentLink{
+          .id = std::move(id), .title = std::move(title), .url = GURL(url)}};
+}
+
+helium::PersistentNode Folder(std::string id,
+                              std::u16string title,
+                              bool collapsed,
+                              helium::PersistentNodes children) {
+  return helium::PersistentNode{
+      .data = helium::PersistentFolder{.id = std::move(id),
+                                       .title = std::move(title),
+                                       .collapsed = collapsed,
+                                       .children = std::move(children)}};
+}
+
+IN_PROC_BROWSER_TEST_F(ArciumArcImportBrowserTest,
+                       ImportsNestedFoldersAsDormantPins) {
+  helium::HeliumSpaceService* service =
+      helium::HeliumSpaceServiceFactory::GetForProfile(browser()->profile());
+  ASSERT_TRUE(service);
+  const int original_tab_count = browser()->tab_strip_model()->count();
+
+  ASSERT_TRUE(ImportArcSidebarSnapshot(browser()->profile(), kSnapshot,
+                                       ArcSidebarDestination::kPins));
+  EXPECT_EQ(original_tab_count, browser()->tab_strip_model()->count());
+  ASSERT_EQ(2u, service->GetSpaces().size());
+
+  helium::HeliumSpace* space_a = service->GetSpaceById("space-a");
+  helium::HeliumSpace* space_b = service->GetSpaceById("space-b");
+  ASSERT_TRUE(space_a);
+  ASSERT_TRUE(space_b);
+  EXPECT_EQ("arc-profile", space_a->source_profile());
+  EXPECT_EQ("arc-profile", space_b->source_profile());
+
+  const helium::PersistentNodes expected_space_a = {
+      Link("arc:arc-profile:space-a:root", u"Root", "https://root.test/"),
+      Folder("arc:arc-profile:space-a:outer", u"Outer", true,
+             {Link("arc:arc-profile:space-a:outer-tab", u"Outer tab",
+                   "https://outer.test/"),
+              Folder("arc:arc-profile:space-a:inner", u"Inner", false,
+                     {Link("arc:arc-profile:space-a:inner-tab", u"Inner tab",
+                           "https://inner.test/")})})};
+  const helium::PersistentNodes expected_space_b = {
+      Link("arc:arc-profile:space-b:other-space", u"Other space",
+           "https://space-b.test/")};
+  const helium::PersistentNodes expected_favorites = {
+      Link("arc:arc-profile:favorite:favorite", u"Favorite",
+           "https://favorite.test/")};
+  EXPECT_EQ(expected_space_a, space_a->pins());
+  EXPECT_EQ(expected_space_b, space_b->pins());
+  EXPECT_EQ(expected_favorites, service->GetFavoritesForSpace(*space_a));
+  EXPECT_EQ(expected_favorites, service->GetFavoritesForSpace(*space_b));
+
+  ASSERT_TRUE(ImportArcSidebarSnapshot(browser()->profile(), kSnapshot,
+                                       ArcSidebarDestination::kPins));
+  EXPECT_EQ(original_tab_count, browser()->tab_strip_model()->count());
+  ASSERT_EQ(2u, service->GetSpaces().size());
+  space_a = service->GetSpaceById("space-a");
+  space_b = service->GetSpaceById("space-b");
+  ASSERT_TRUE(space_a);
+  ASSERT_TRUE(space_b);
+  EXPECT_EQ(expected_space_a, space_a->pins());
+  EXPECT_EQ(expected_space_b, space_b->pins());
+}
