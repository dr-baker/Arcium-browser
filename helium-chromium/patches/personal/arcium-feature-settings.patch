+TEST_F(PrefsUtilTest, ArciumFeatureSettingsAreAllowlistedAndWritable) {
+  const char* const prefs[] = {
+      ::prefs::kHeliumPeekEnabled,
+      ::prefs::kArciumOmniboxPersistentItemsEnabled,
+  };
+
+  for (const char* pref : prefs) {
+    EXPECT_TRUE(profile_->GetPrefs()->GetBoolean(pref)) << pref;
+    std::optional<api::settings_private::PrefObject> pref_object =
+        prefs_util_->GetPref(pref);
+    ASSERT_TRUE(pref_object.has_value()) << pref;
+    EXPECT_EQ(pref_object->type, api::settings_private::PrefType::kBoolean);
+    ASSERT_TRUE(pref_object->value) << pref;
+    EXPECT_TRUE(pref_object->value->GetBool()) << pref;
+
+    base::Value disabled(false);
+    EXPECT_EQ(prefs_util_->SetPref(pref, &disabled),
+              settings_private::SetPrefResult::SUCCESS)
+        << pref;
+    EXPECT_FALSE(profile_->GetPrefs()->GetBoolean(pref)) << pref;
+  }
+}
+
