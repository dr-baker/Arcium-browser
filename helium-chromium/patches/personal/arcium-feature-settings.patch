+
+TEST_F(HeliumSpaceServiceTest,
+       DisablingOmniboxItemsPreservesPersistentFavorites) {
+  tabs::TabInterface* favorite_tab =
+      AddOrdinaryTab("https://favorite-omnibox.test/");
+  ASSERT_TRUE(favorite_tab);
+  ASSERT_TRUE(service_->AddFavoriteFromTab(favorite_tab));
+
+  ChromeAutocompleteProviderClient client(
+      profile(), base::BindRepeating(
+                     [](content::WebContents* contents) { return contents; },
+                     favorite_tab->GetContents()));
+  const auto visible_items = client.GetArciumOmniboxItems();
+  ASSERT_EQ(1u, visible_items.size());
+  const std::string favorite_id = visible_items.front().id;
+
+  profile()->GetPrefs()->SetBoolean(prefs::kArciumOmniboxPersistentItemsEnabled,
+                                    false);
+  EXPECT_TRUE(client.GetArciumOmniboxItems().empty());
+
+  const auto stored_items = service_->GetOmniboxItemsForBrowser(browser());
+  ASSERT_EQ(1u, stored_items.size());
+  EXPECT_EQ(favorite_id, stored_items.front().id);
+  EXPECT_EQ(PersistentRecordKind::kFavorite, stored_items.front().kind);
+
+  profile()->GetPrefs()->SetBoolean(prefs::kArciumOmniboxPersistentItemsEnabled,
+                                    true);
+  const auto restored_items = client.GetArciumOmniboxItems();
+  ASSERT_EQ(1u, restored_items.size());
+  EXPECT_EQ(favorite_id, restored_items.front().id);
 }
 
