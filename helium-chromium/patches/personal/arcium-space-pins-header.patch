+++ src/chrome/browser/ui/views/helium/arcium_space_header_view.cc
@@ -0,0 +1,232 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/helium/arcium_space_header_view.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/numerics/safe_conversions.h"
+#include "cc/paint/paint_flags.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/helium/arcium_space_icon.h"
+#include "chrome/browser/ui/helium/helium_space.h"
+#include "chrome/browser/ui/helium/helium_space_service.h"
+#include "chrome/browser/ui/helium/helium_space_service_factory.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "chrome/browser/ui/views/helium/arcium_chrome_ui_scale.h"
+#include "chrome/browser/ui/views/tabs/common/sidebar_row_layout.h"
+#include "ui/accessibility/ax_enums.mojom.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/font.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/controls/focus_ring.h"
+#include "ui/views/controls/highlight_path_generator.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/style/typography.h"
+
+namespace {
+
+constexpr int kRowHeight = 30;
+constexpr int kChevronSize = 12;
+constexpr int kCornerRadius = 6;
+
+}  // namespace
+
+ArciumSpaceHeaderView::ArciumSpaceHeaderView(
+    Browser* browser,
+    tabs::VerticalTabStripStateController* state_controller,
+    base::RepeatingCallback<void(bool)> pins_visibility_changed)
+    : views::Button(base::BindRepeating(&ArciumSpaceHeaderView::OnPressed,
+                                        base::Unretained(this))),
+      browser_(browser),
+      pins_visibility_changed_(std::move(pins_visibility_changed)) {
+  name_ = AddChildView(std::make_unique<views::Label>(
+      std::u16string(), views::style::CONTEXT_LABEL,
+      views::style::STYLE_PRIMARY));
+  name_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  name_->SetAutoColorReadabilityEnabled(false);
+  name_->SetEnabledColor(kColorTabForegroundInactiveFrameActive);
+  name_->SetCanProcessEventsWithinSubtree(false);
+  // The sidebar paints through a transparent layer.
+  name_->SetSubpixelRenderingEnabled(false);
+  base_font_list_ =
+      name_->font_list().DeriveWithWeight(gfx::Font::Weight::SEMIBOLD);
+  name_->SetFontList(base_font_list_);
+  views::InstallRoundRectHighlightPathGenerator(this, gfx::Insets(),
+                                                kCornerRadius);
+  views::FocusRing::Install(this);
+
+  service_ =
+      helium::HeliumSpaceServiceFactory::GetForProfile(browser_->profile());
+  if (service_) {
+    items_changed_subscription_ =
+        service_->RegisterItemsChanged(base::BindRepeating(
+            &ArciumSpaceHeaderView::OnItemsChanged, base::Unretained(this)));
+  }
+  if (state_controller) {
+    compact_ = state_controller->GetCollapseState() ==
+               tabs::VerticalTabStripCollapseState::kCollapsed;
+    collapse_state_subscription_ =
+        state_controller->RegisterOnCollapseChanged(
+            base::BindRepeating(&ArciumSpaceHeaderView::OnCollapseStateChanged,
+                                base::Unretained(this)));
+  }
+  Update();
+}
+
+ArciumSpaceHeaderView::~ArciumSpaceHeaderView() = default;
+
+gfx::Size ArciumSpaceHeaderView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(0, std::max(arcium::ScaleChromeDip(this, kRowHeight),
+                               name_->GetPreferredSize().height()));
+}
+
+void ArciumSpaceHeaderView::Layout(PassKey) {
+  const arcium::SidebarRowMetrics metrics = arcium::GetSidebarRowMetrics(this);
+  const int left = metrics.container_padding + metrics.horizontal_inset +
+                   metrics.icon_slot_width + metrics.icon_title_gap;
+  const int right = metrics.container_padding + metrics.horizontal_inset +
+                    arcium::ScaleChromeDip(this, kChevronSize) +
+                    metrics.icon_title_gap;
+  name_->SetBounds(left, 0, std::max(0, width() - left - right), height());
+}
+
+void ArciumSpaceHeaderView::PaintButtonContents(gfx::Canvas* canvas) {
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  const arcium::SidebarRowMetrics metrics = arcium::GetSidebarRowMetrics(this);
+  // Without Pins there is nothing to fold: the header is just the Space's
+  // name, with no hover or chevron.
+  const bool hovered = has_pins_ && (GetState() == STATE_HOVERED ||
+                                     GetState() == STATE_PRESSED);
+  if (hovered) {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(colors->GetColor(ui::kColorSysStateHoverOnSubtle));
+    gfx::Rect background = GetLocalBounds();
+    background.Inset(gfx::Insets::VH(0, metrics.container_padding));
+    canvas->DrawRoundRect(background, kCornerRadius, flags);
+  }
+  const SkColor foreground =
+      colors->GetColor(kColorTabForegroundInactiveFrameActive);
+  helium::PaintSpaceIcon(
+      canvas, icon_,
+      arcium::CenterSidebarRowChild(
+          GetLocalBounds(), metrics.container_padding + metrics.horizontal_inset,
+          metrics.icon_slot_width,
+          gfx::Size(metrics.favicon_width, metrics.favicon_width)),
+      foreground);
+
+  if (!has_pins_) {
+    return;
+  }
+  // The chevron stays faintly visible so the header reads as a control; it
+  // strengthens on hover and while the Pins are folded.
+  const int chevron = arcium::ScaleChromeDip(this, kChevronSize);
+  helium::PaintSpaceIcon(
+      canvas,
+      helium::MakePhosphorIcon(collapsed_ ? "caret-right" : "caret-down"),
+      gfx::Rect(width() - metrics.container_padding -
+                    metrics.horizontal_inset - chevron,
+                (height() - chevron) / 2, chevron, chevron),
+      SkColorSetA(foreground,
+                  hovered || collapsed_ || HasFocus() ? 0xB0 : 0x50));
+}
+
+void ArciumSpaceHeaderView::StateChanged(ButtonState old_state) {
+  views::Button::StateChanged(old_state);
+  SchedulePaint();
+}
+
+void ArciumSpaceHeaderView::OnThemeChanged() {
+  views::Button::OnThemeChanged();
+  // Follow the Chrome UI scale like the Pin rows below.
+  const int base_size = base_font_list_.GetFontSize();
+  name_->SetFontList(base_font_list_.DeriveWithSizeDelta(
+      base::ClampRound(base_size * arcium::GetChromeUIScale(this)) -
+      base_size));
+  PreferredSizeChanged();
+}
+
+void ArciumSpaceHeaderView::OnFocus() {
+  views::Button::OnFocus();
+  SchedulePaint();
+}
+
+void ArciumSpaceHeaderView::OnBlur() {
+  views::Button::OnBlur();
+  SchedulePaint();
+}
+
+void ArciumSpaceHeaderView::OnPressed() {
+  if (!service_) {
+    return;
+  }
+  const std::string space_id(service_->GetSpaceIdForBrowser(browser_));
+  service_->SetSpacePinsCollapsed(space_id, !collapsed_);
+}
+
+void ArciumSpaceHeaderView::OnItemsChanged(
+    const helium::PersistentItemChange& change) {
+  if (service_ &&
+      change.AffectsPins(service_->GetSpaceIdForBrowser(browser_),
+                         browser_->session_id())) {
+    Update();
+  }
+}
+
+void ArciumSpaceHeaderView::OnCollapseStateChanged(
+    tabs::VerticalTabStripCollapseState state) {
+  compact_ = state == tabs::VerticalTabStripCollapseState::kCollapsed;
+  Update();
+}
+
+void ArciumSpaceHeaderView::Update() {
+  helium::HeliumSpace* space =
+      service_ ? service_->GetSpaceById(service_->GetSpaceIdForBrowser(browser_))
+               : nullptr;
+  if (space) {
+    name_->SetText(space->name());
+    icon_ = space->icon();
+    collapsed_ = space->pins_collapsed();
+    has_pins_ = !space->pins().empty();
+  }
+  SetVisible(space && !compact_);
+  SetEnabled(has_pins_);
+  if (has_pins_) {
+    SetTooltipText(collapsed_ ? u"Show Pins" : u"Hide Pins");
+    GetViewAccessibility().SetRole(ax::mojom::Role::kButton);
+    GetViewAccessibility().SetName(std::u16string(name_->GetText()) +
+                                   u" Pins");
+    if (collapsed_) {
+      GetViewAccessibility().SetIsCollapsed();
+    } else {
+      GetViewAccessibility().SetIsExpanded();
+    }
+  } else {
+    SetTooltipText(std::u16string());
+    GetViewAccessibility().SetRole(ax::mojom::Role::kHeading);
+    GetViewAccessibility().SetName(std::u16string(name_->GetText()));
+    GetViewAccessibility().RemoveExpandCollapseState();
+  }
+  SchedulePaint();
+
+  const bool pins_visible = compact_ || !collapsed_;
+  if (pins_visible != pins_visible_) {
+    pins_visible_ = pins_visible;
+    pins_visibility_changed_.Run(pins_visible_);
+  }
+}
+
+BEGIN_METADATA(ArciumSpaceHeaderView)
+END_METADATA
