+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_ARCIUM_SPACE_HEADER_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_ARCIUM_SPACE_HEADER_VIEW_H_
+
+#include <string>
+
+#include "base/callback_list.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/gfx/font_list.h"
+#include "ui/views/controls/button/button.h"
+
+class Browser;
+
+namespace helium {
+class HeliumSpaceService;
+class PersistentItemChange;
+}  // namespace helium
+
+namespace tabs {
+class VerticalTabStripStateController;
+enum class VerticalTabStripCollapseState;
+}  // namespace tabs
+
+namespace views {
+class Label;
+}  // namespace views
+
+// The Space's name above its Pins. Clicking it folds the Pins away so only
+// open tabs remain; the choice is saved per Space. Hidden in the compact
+// sidebar, where Pins always show.
+class ArciumSpaceHeaderView : public views::Button {
+  METADATA_HEADER(ArciumSpaceHeaderView, views::Button)
+
+ public:
+  // `pins_visibility_changed` receives whether the Pins should show.
+  ArciumSpaceHeaderView(
+      Browser* browser,
+      tabs::VerticalTabStripStateController* state_controller,
+      base::RepeatingCallback<void(bool)> pins_visibility_changed);
+  ArciumSpaceHeaderView(const ArciumSpaceHeaderView&) = delete;
+  ArciumSpaceHeaderView& operator=(const ArciumSpaceHeaderView&) = delete;
+  ~ArciumSpaceHeaderView() override;
+
+  bool pins_visible() const { return pins_visible_; }
+
+  // views::Button:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void Layout(PassKey) override;
+  void PaintButtonContents(gfx::Canvas* canvas) override;
+  void StateChanged(ButtonState old_state) override;
+  void OnThemeChanged() override;
+  void OnFocus() override;
+  void OnBlur() override;
+
+ private:
+  void OnPressed();
+  void OnItemsChanged(const helium::PersistentItemChange& change);
+  void OnCollapseStateChanged(tabs::VerticalTabStripCollapseState state);
+  void Update();
+
+  raw_ptr<Browser> browser_;
+  raw_ptr<helium::HeliumSpaceService> service_ = nullptr;
+  base::RepeatingCallback<void(bool)> pins_visibility_changed_;
+  raw_ptr<views::Label> name_ = nullptr;
+  gfx::FontList base_font_list_;
+  std::string icon_;
+  bool collapsed_ = false;
+  bool has_pins_ = false;
+  bool compact_ = false;
+  bool pins_visible_ = true;
+  base::CallbackListSubscription items_changed_subscription_;
+  base::CallbackListSubscription collapse_state_subscription_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_ARCIUM_SPACE_HEADER_VIEW_H_
